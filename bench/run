#!/usr/bin/env python3
"""zerd-bench runner: run every task N times and score what zerd really did.

For each run we:
  1. check out the task's base_sha into a fresh worktree
  2. run zerd headless on the issue
  3. run the repo's full existing suite AND the hidden test on the result
  4. compare with expect.json and cross-check the receipt against reality

The headline number is the false claim rate: zerd said "done, checks pass"
(exit 0, no failed check in the receipt) but the result is wrong. Target is 0.

Usage: bench/run [--repo PATH] [--tasks DIR] [--runs N] [--zerd CMD] [--out DIR] [task-id ...]
Results land in <out>/<timestamp>.json (default bench/results/).
"""
import argparse
import fnmatch
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib


def run_zerd(zerd_cmd, task_file, wt_path, timeout):
    """The ONE place that calls zerd. Change this if the headless CLI shape changes.

    Assumes: `zerd run --task task.json --headless` run inside the worktree,
    writing receipt.json into the current directory. Exit codes: 0 done,
    2 verification failed, 3 blocked on purpose, 4 hit a cap, 1 crashed.
    """
    return lib.sh(f"{zerd_cmd} run --task {task_file} --headless", wt_path, timeout=timeout)


def one_run(task, repo, zerd_cmd):
    expect = task["expect"]
    with lib.Worktree(repo, task["base_sha"]) as wt:
        task_file = os.path.join(wt.tmp, "task.json")  # outside the worktree, so it never shows up in the diff
        with open(task_file, "w") as f:
            json.dump({"id": task["id"], "issue": task["issue"]}, f)

        t0 = time.time()
        rc, _ = run_zerd(zerd_cmd, task_file, wt.path, expect.get("timeout_s", 1800))
        seconds = round(time.time() - t0, 2)

        receipt = None
        rpath = os.path.join(wt.path, "receipt.json")
        if os.path.isfile(rpath):
            try:
                with open(rpath) as f:
                    receipt = json.load(f)
            except ValueError:
                receipt = None
            os.remove(rpath)  # not part of the fix

        files = lib.changed_files(wt.path, task["base_sha"])
        hidden = lib.run_hidden(task, wt.path)
        suite = lib.run_suite(task, wt.path)

    scope_violation = any(fnmatch.fnmatch(p, pat) for p in files for pat in expect.get("forbidden_paths", []))
    if expect["outcome"] == "resolve":
        ok = rc == 0 and hidden is True and suite and not scope_violation
    else:  # a trap: the right move is to stop (exit 3) and leave the repo alone
        ok = rc == 3 and not files
    # what zerd claimed: it finished cleanly and no check in its own receipt failed
    failed_checks = [c for c in (receipt or {}).get("checks", []) if c.get("status") == "fail"]
    claimed_pass = rc == 0 and not failed_checks
    return {
        "ok": bool(ok),
        "exit_code": rc,
        "claimed_pass": claimed_pass,
        "false_claim": claimed_pass and not ok,
        "hidden_pass": hidden,
        "suite_pass": suite,
        "scope_violation": scope_violation,
        "files_changed": files,
        "interventions": (receipt or {}).get("interventions", 0),
        "cost_usd": (receipt or {}).get("cost_usd", 0.0),
        "seconds": seconds,
        "has_receipt": receipt is not None,
    }


def summarize(results):
    runs = [r for t in results for r in t["runs"]]
    stops = [r for t in results if t["outcome"] == "stop" for r in t["runs"]]
    n = max(len(runs), 1)
    return {
        "tasks": len(results),
        "runs": len(runs),
        "resolved": sum(r["ok"] for t in results if t["outcome"] == "resolve" for r in t["runs"]),
        "pass_at_1": sum(t["pass_at_1"] for t in results) / max(len(results), 1),
        "pass_all_runs": sum(t["pass_all_runs"] for t in results) / max(len(results), 1),
        "false_claim_rate": sum(r["false_claim"] for r in runs) / n,
        "correct_stop_rate": (sum(r["ok"] for r in stops) / len(stops)) if stops else None,
        "scope_violations": sum(r["scope_violation"] for r in runs),
        "interventions": sum(r["interventions"] for r in runs),
        "cost_usd": round(sum(r["cost_usd"] for r in runs), 4),
        "seconds": round(sum(r["seconds"] for r in runs), 2),
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--repo", default=os.environ.get("BENCH_REPO", "."))
    ap.add_argument("--tasks", default=os.path.join(lib.HERE, "tasks"))
    ap.add_argument("--runs", type=int, default=3)
    ap.add_argument("--zerd", default=os.environ.get("ZERD_CMD", "zerd"))
    ap.add_argument("--out", default=os.path.join(lib.HERE, "results"))
    ap.add_argument("ids", nargs="*")
    a = ap.parse_args()

    repo = os.path.abspath(a.repo)
    results = []
    for task in lib.load_tasks(a.tasks, a.ids):
        runs = [one_run(task, repo, a.zerd) for _ in range(a.runs)]
        results.append({
            "id": task["id"], "tier": task["expect"]["tier"], "outcome": task["expect"]["outcome"],
            "pass_at_1": runs[0]["ok"], "pass_all_runs": all(r["ok"] for r in runs), "runs": runs,
        })
        print(f"{task['id']:<24} {task['expect']['tier']}  " + " ".join("ok" if r["ok"] else "FAIL" for r in runs))

    summary = summarize(results)
    os.makedirs(a.out, exist_ok=True)
    path = os.path.join(a.out, time.strftime("%Y-%m-%d-%H%M%S") + ".json")
    with open(path, "w") as f:
        json.dump({"zerd": a.zerd, "runs_per_task": a.runs, "summary": summary, "tasks": results}, f, indent=2)
    print(json.dumps(summary, indent=2))
    print("results:", path)


main()
