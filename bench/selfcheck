#!/usr/bin/env python3
"""Self-check for the bench itself, using the toy repo and a stub zerd (no tunyt, no model).

It proves three things, and fails loudly if any breaks:
  1. validate accepts the example tasks (hidden test fails on base, passes with the reference fix)
  2. an honest stub resolves the T1 task and correctly stops on the T4 trap: false claims = 0
  3. a lying stub (exit 0, changes nothing) gets caught: false claim rate > 0

Run: bench/selfcheck
"""
import glob
import json
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))


def run(*cmd, **kw):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, **kw)


def main():
    tmp = tempfile.mkdtemp(prefix="zerd-bench-selfcheck-")
    try:
        # build the toy repo and give every example task its base_sha
        repo = os.path.join(tmp, "toy")
        shutil.copytree(os.path.join(HERE, "fixtures", "toy-repo"), repo)
        git = ["git", "-C", repo, "-c", "user.name=bench", "-c", "user.email=bench@example.com"]
        for step in (["init", "-q"], ["add", "-A"], ["commit", "-qm", "base"]):
            subprocess.run(git + step, check=True)
        sha = subprocess.run(git + ["rev-parse", "HEAD"], stdout=subprocess.PIPE, text=True, check=True).stdout.strip()
        tasks = os.path.join(tmp, "tasks")
        shutil.copytree(os.path.join(HERE, "tasks"), tasks)
        for d in glob.glob(os.path.join(tasks, "*")):
            with open(os.path.join(d, "base_sha"), "w") as f:
                f.write(sha + "\n")

        # 1. tasks are fair
        v = run(os.path.join(HERE, "validate"), "--repo", repo, "--tasks", tasks)
        print(v.stdout.strip())
        assert v.returncode == 0, "validate rejected the example tasks"

        stub = os.path.join(HERE, "stub-zerd")

        def bench(mode):
            env = dict(os.environ, STUB_MODE=mode)
            out = os.path.join(tmp, "results-" + mode)
            r = run(os.path.join(HERE, "run"), "--repo", repo, "--tasks", tasks, "--zerd", stub,
                    "--runs", "2", "--out", out, env=env)
            print(r.stdout.strip().splitlines()[0:2])
            assert r.returncode == 0, r.stdout
            with open(glob.glob(os.path.join(out, "*.json"))[0]) as f:
                return json.load(f)["summary"]

        # 2. honest zerd
        good = bench("good")
        assert good["false_claim_rate"] == 0, good
        assert good["pass_all_runs"] == 1.0, good
        assert good["correct_stop_rate"] == 1.0, good

        # 3. lying zerd must be caught
        liar = bench("liar")
        assert liar["false_claim_rate"] > 0, liar
        assert liar["pass_all_runs"] < 1.0, liar

        print("selfcheck ok: honest stub clean, lying stub caught "
              f"(false claim rate {good['false_claim_rate']} vs {liar['false_claim_rate']:.2f})")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


main()
