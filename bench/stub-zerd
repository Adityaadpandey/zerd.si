#!/bin/sh
# A fake zerd for testing the bench itself, no model involved.
#
#   STUB_MODE=good   fixes what it can, stops on a vague issue (default)
#   STUB_MODE=liar   changes nothing but exits 0 and claims everything passed
#
# It understands: stub-zerd run --task task.json --headless
# and, like the real thing is meant to, writes receipt.json in the current dir.

task_file="$3"
mode="${STUB_MODE:-good}"

receipt() {
  # $1 = interventions count, handy for faking a run that needed a human
  printf '{"checks":[{"name":"test","status":"pass"}],"cost_usd":0.01,"interventions":%s}\n' "${1:-0}" > receipt.json
}

if [ "$mode" = "liar" ]; then
  receipt 0
  exit 0
fi

# "Make the text helpers better." is the ambiguous trap: stop and ask, touch nothing.
if grep -q "helpers better" "$task_file"; then
  printf '{"checks":[],"cost_usd":0.0,"reason":"issue is ambiguous, need one question answered","interventions":0}\n' > receipt.json
  exit 3
fi

# Otherwise do the toy fix from the shout issue.
sed -i.bak 's/return s.upper()$/return s.upper() + "!"/' textutil.py && rm -f textutil.py.bak
receipt 0
exit 0
