#!/usr/bin/env python3
"""Diff two bench result files, so a zerd change shows what it fixed or broke.

Usage: bench/compare OLD.json NEW.json

Example output:
  false_claim_rate     0.1667 -> 0.0000   (better)
  toy-shout            T1  FAIL -> ok     (fixed)
"""
import json
import sys

# for these, lower is better; for the rest higher is better
LOWER_IS_BETTER = {"false_claim_rate", "scope_violations", "interventions", "cost_usd", "seconds"}


def load(p):
    with open(p) as f:
        return json.load(f)


def verdict(key, old, new):
    if old == new or old is None or new is None:
        return ""
    better = new < old if key in LOWER_IS_BETTER else new > old
    return "(better)" if better else "(WORSE)"


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    old, new = load(sys.argv[1]), load(sys.argv[2])

    print("summary")
    for k, nv in new["summary"].items():
        ov = old["summary"].get(k)
        fmt = lambda v: "n/a" if v is None else (f"{v:.4f}" if isinstance(v, float) else str(v))
        print(f"  {k:<20} {fmt(ov)} -> {fmt(nv)}   {verdict(k, ov, nv)}")

    print("tasks")
    old_tasks = {t["id"]: t for t in old["tasks"]}
    for t in new["tasks"]:
        o = old_tasks.get(t["id"])
        if o is None:
            print(f"  {t['id']:<24} {t['tier']}  new task")
            continue
        was, now = o["pass_all_runs"], t["pass_all_runs"]
        if was == now:
            continue
        print(f"  {t['id']:<24} {t['tier']}  {'ok' if was else 'FAIL'} -> {'ok' if now else 'FAIL'}   "
              f"{'(fixed)' if now else '(BROKEN)'}")
    for tid in old_tasks.keys() - {t["id"] for t in new["tasks"]}:
        print(f"  {tid:<24} dropped from the new run")


main()
