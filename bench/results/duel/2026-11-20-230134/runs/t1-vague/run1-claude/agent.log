n1042\t                  ticketIndex,\n1043\t                  fieldId,\n1044\t                  value,\n1045\t                )\n1046\t              }\n1047\t              onFieldsLoaded={handleTicketFieldsLoaded}\n1048\t            />\n1049\t          );\n1050\t        })}\n1051\t\n1052\t      {/* Question view — paginated or single-page */}\n1053\t      {totalPages > 0 && currentPageData ? (\n1054\t        <>\n1055\t          {/* Progress — only shown when paginated */}\n1056\t          {isPaginated && (\n1057\t            <ProgressBar current={currentPage} total={totalPages} />\n1058\t          )}\n1059\t\n1060\t          {/* Render all fields on the current page */}\n1061\t          <ListRowInKeyframes />\n1062\t          {currentPageData.items.map((item, i) => {\n1063\t            const fieldId = `${item.idPrefix}_${item.field.fieldId}`;\n1064\t            const showSectionLabel =\n1065\t              !!item.sectionLabel &&\n1066\t              (i === 0 ||\n1067\t                currentPageData.items[i - 1].sectionLabel !==\n1068\t                  item.sectionLabel);\n1069\t            return (\n1070\t              <div\n1071\t                key={fieldId}\n1072\t                className=\"flex flex-col gap-2\"\n1073\t                style={staggerStyle(i, reducedMotion)}\n1074\t              >\n1075\t                {showSectionLabel && (\n1076\t                  <p className=\"text-h6 font-semibold text-white/44 uppercase tracking-widest\">\n1077\t                    {item.sectionLabel}\n1078\t                  </p>\n1079\t                )}\n1080\t                <FieldRow\n1081\t                  id={fieldId}\n1082\t                  field={item.field}\n1083\t                  value={item.value}\n1084\t                  onChange={item.onChange}\n1085\t                  error={item.error}\n1086\t                />\n1087\t              </div>\n1088\t            );\n1089\t          })}\n1090\t\n1091\t          {/* Navigation — pagination controls or single submit */}\n1092\t          {isPaginated ? (\n1093\t            <div className=\"flex gap-3 mt-1\">\n1094\t              {!isFirstPage && (\n1095\t                <button\n1096\t                  type=\"button\"\n1097\t                  onClick={handleBack}\n1098\t                  className=\"\n1099\t                    h-12 px-5 rounded-[40px]\n1100\t                    bg-white/[0.06] border border-white/[0.12]\n1101\t                    flex items-center justify-center gap-2\n1102\t                    transition-all duration-200 ease-out\n1103\t                    active:opacity-70 active:scale-[0.97] hover:bg-white/[0.10]\n1104\t                    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n1105\t                  \"\n1106\t                >\n1107\t                  <svg\n1108\t                    className=\"size-4 text-white/72\"\n1109\t                    viewBox=\"0 0 16 16\"\n1110\t                    fill=\"none\"\n1111\t                    aria-hidden=\"true\"\n1112\t                  >\n1113\t                    <path\n1114\t                      d=\"M13 8H3M7 4L3 8l4 4\"\n1115\t                      stroke=\"currentColor\"\n1116\t                      strokeWidth=\"1.5\"\n1117\t                      strokeLinecap=\"round\"\n1118\t                      strokeLinejoin=\"round\"\n1119\t                    />\n1120\t                  </svg>\n1121\t                  <span className=\"text-h5 font-medium text-white/72 tracking-[-0.02em]\">\n1122\t                    Back\n1123\t                  </span>\n1124\t                </button>\n1125\t              )}\n1126\t\n1127\t              {isCurrentPageValid && !isSubmitting ? (\n1128\t                <button\n1129\t                  type=\"button\"\n1130\t                  onClick={handleNext}\n1131\t                  className=\"\n1132\t                    flex-1 h-12 rounded-[40px]\n1133\t                    bg-white border border-[rgba(255,255,255,0.04)]\n1134\t          