cketType\" tt\nrepositories/ticket/inventory-reconciliation.repository.ts-58-          LEFT JOIN live ON live.\"ticketTypeId\" = tt.\"ticketTypeId\"\nrepositories/ticket/inventory-reconciliation.repository.ts-59-        )\nrepositories/ticket/inventory-reconciliation.repository.ts-60-        UPDATE \"TicketType\" tt\nrepositories/ticket/inventory-reconciliation.repository.ts-61-        SET \"soldCount\" = target.new_sold,\nrepositories/ticket/inventory-reconciliation.repository.ts-62-            \"discountSoldCount\" = target.new_discount_sold\nrepositories/ticket/inventory-reconciliation.repository.ts-63-        FROM target\nrepositories/ticket/inventory-reconciliation.repository.ts-64-        WHERE tt.\"ticketTypeId\" = target.\"ticketTypeId\"\nrepositories/ticket/inventory-reconciliation.repository.ts-65-          AND (\nrepositories/ticket/inventory-reconciliation.repository.ts-66-            tt.\"soldCount\" IS DISTINCT FROM target.new_sold\nrepositories/ticket/inventory-reconciliation.repository.ts-67-            OR tt.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\nrepositories/ticket/inventory-reconciliation.repository.ts-68-          )\nrepositories/ticket/inventory-reconciliation.repository.ts-69-        RETURNING tt.\"eventId\"\nrepositories/ticket/inventory-reconciliation.repository.ts-70-      `;\nrepositories/ticket/inventory-reconciliation.repository.ts-71-\nrepositories/ticket/inventory-reconciliation.repository.ts-72-      // Bundle-level discount slots: TicketTypeGroup.discountSoldCount.\nrepositories/ticket/inventory-reconciliation.repository.ts-73-      // A single bundle-unit purchase produces one Ticket row per member\nrepositories/ticket/inventory-reconciliation.repository.ts-74-      // ticket type in the group, all sharing the same bookingId,\nrepositories/ticket/inventory-reconciliation.repository.ts-75-      // bundleGroupId, and (per Task 5) an identical quantity. Counting\nrepositories/ticket/inventory-reconciliation.rep