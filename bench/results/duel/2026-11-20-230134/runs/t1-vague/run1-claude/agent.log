{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-84cb967d-86ab-425a-a3c4-52fd85cb0ef2","type":"tool_result","content":"1\timport { BookingRepository } from \"../repositories/booking.repository\";\n2\timport { ListerRepository } from \"../repositories/lister.repository\";\n3\timport { UserRepository } from \"../repositories/user.repository\";\n4\timport { WaitlistRepository } from \"../repositories/waitlist.repository\";\n5\timport { BookingApprovalService } from \"./booking/booking-approval.service\";\n6\timport { BookingDiscountService } from \"./booking/booking-discount.service\";\n7\timport { BookingLifecycleService } from \"./booking/booking-lifecycle.service\";\n8\timport { BookingPricingService } from \"./booking/booking-pricing.service\";\n9\timport type { BookingDetails, CreateBookingDto } from \"./booking/types\";\n10\timport { DiscountService } from \"./discount.service\";\n11\t\n12\texport type { CreateBookingDto };\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// BookingService\n16\t// ---------------------------------------------------------------------------\n17\t\n18\t/**\n19\t * Booking Service\n20\t * Orchestrates booking creation, discount application, cancellation, and expiry.\n21\t *\n22\t * Thin facade delegating to focused sub-services under ./booking/*.\n23\t */\n24\texport class BookingService {\n25\t  private lifecycleService: BookingLifecycleService;\n26\t  private discountServiceFacade: BookingDiscountService;\n27\t  private approvalService: BookingApprovalService;\n28\t\n29\t  constructor(\n30\t    bookingRepository?: BookingRepository,\n31\t    discountService?: DiscountService,\n32\t    waitlistRepository?: WaitlistRepository,\n33\t    listerRepository?: ListerRepository,\n34\t    userRepository?: UserRepository,\n35\t  ) {\n36\t    const resolvedBookingRepository = bookingRepository ?? new BookingRepository();\n37\t    const resolvedDiscountService = discountService ?? new DiscountService();\n38\t    const resolvedWaitlistRepository = waitlistRepository ?? new WaitlistRepository();\n39\t    const resolvedListerRepository = listerRepository ?? new ListerRepository();\n40\t    const resolvedUserRepository = userRepository ?? new UserRepository();\n41\t\n42\t    const pricingService = new BookingPricingService();\n43\t\n44\t    this.lifecycleService = new BookingLifecycleService(\n45\t      resolvedBookingRepository,\n46\t      resolvedWaitlistRepository,\n47\t      resolvedUserRepository,\n48\t      pricingService,\n49\t    );\n50\t    this.discountServiceFacade = new BookingDiscountService(\n51\t      resolvedBookingRepository,\n52\t      resolvedDiscountService,\n53\t      this.lifecycleService,\n54\t    );\n55\t    this.approvalService = new BookingApprovalService(\n56\t      resolvedBookingRepository,\n57\t      resolvedListerRepository,\n58\t      resolvedUserRepository,\n59\t      pricingService,\n60\t      this.lifecycleService,\n61\t    );\n62\t  }\n63\t\n64\t  async create(\n65\t    userId: string,\n66\t    dto: CreateBookingDto,\n67\t    requestId: string,\n68\t  ): Promise<BookingDetails> {\n69\t    return this.lifecycleService.create(userId, dto, requestId);\n70\t  }\n71\t\n72\t  async getForOwner(\n73\t    userId: string,\n74\t    bookingId: string,\n75\t  ): Promise<BookingDetails> {\n76\t    return this.lifecycleService.getForOwner(userId, bookingId);\n77\t  }\n78\t\n79\t  async applyDiscount(\n80\t    userId: string,\n81\t    bookingId: string,\n82\t    code: string | null,\n83\t  ): Promise<BookingDetails> {\n84\t    return this.discountServiceFacade.applyDiscount(userId, bookingId, code);\n85\t  }\n86\t\n87\t  async cancel(userId: string, bookingId: string): Promise<unknown> {\n88\t    return this.lifecycleService.cancel(userId, bookingId);\n89\t  }\n90\t\n91\t  async expireIfDue(bookingId: string): Promise<unknown> {\n92\t    return this.lifecycleService.expireIfDue(bookingId);\n93\t  }\n94\t\n95\t  async requestApproval(\n96\t    userId: string,\n97\t    dto: CreateBookingDto,\n98\t    requestId: string,\n99\t  ): Promise<BookingDetails> {\n100\t    return this.approvalService.requestApproval(userId, dto, requestId);\n101\t  }\n102\t\n103\t  async resolveApprovalClaim(token: string) {\n104\t    return this.approvalService.resolveApprovalClaim(token);\n105\t  }\n106\t\n107\t  async getMyApprovedBookingForEvent(userId: string, eventId: string) {\n108\t    return this.approvalService.getMyApprovedBookingForEvent(userId, eventId);\n109\t  }\n110\t}\n111\t\n112\t// ---------------------------------------------------------------------------\n113\t// Singleton export\n114\t// ---------------------------------------------------------------------------\n115\t\n116\texport const bookingService = new BookingService();\n117\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"87704ca7-44a0-435f-9634-c9ba93858370","timestamp":"2026-11-20T17:39:31.443Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/services/booking.service.ts","content":"import { BookingRepository } from \"../repositories/booking.repository\";\nimport { ListerRepository } from \"../repositories/lister.repository\";\nimport { UserRepository } from \"../repositories/user.repository\";\nimport { WaitlistRepository } from \"../repositories/waitlist.repository\";\nimport { BookingApprovalService } from \"./booking/booking-approval.service\";\nimport { BookingDiscountService } from \"./booking/booking-discount.service\";\nimport { BookingLifecycleService } from \"./booking/booking-lifecycle.service\";\nimport { BookingPricingService } from \"./booking/booking-pricing.service\";\nimport type { BookingDetails, CreateBookingDto } from \"./booking/types\";\nimport { DiscountService } from \"./discount.service\";\n\nexport type { CreateBookingDto };\n\n// ---------------------------------------------------------------------------\n// BookingService\n// ---------------------------------------------------------------------------\n\n/**\n * Booking Service\n * Orchestrates booking creation, discount application, cancellation, and expiry.\n *\n * Thin facade delegating to focused sub-services under ./booking/*.\n */\nexport class BookingService {\n  private lifecycleService: BookingLifecycleService;\n  private discountServiceFacade: BookingDiscountService;\n  private approvalService: BookingApprovalService;\n\n  constructor(\n    bookingRepository?: BookingRepository,\n    discountService?: DiscountService,\n    waitlistRepository?: WaitlistRepository,\n    listerRepository?: ListerRepository,\n    userRepository?: UserRepository,\n  ) {\n    const resolvedBookingRepository = bookingRepository ?? new BookingRepository();\n    const resolvedDiscountService = discountService ?? new DiscountService();\n    const resolvedWaitlistRepository = waitlistRepository ?? new WaitlistRepository();\n    const resolvedListerRepository = listerRepository ?? new ListerRepository();\n    const resolvedUserRepository = userRepository ?? new UserRepository();\n\n    const pricingService = new BookingPricingService();\n\n    this.lifecycleService = new BookingLifecycleService(\n      resolvedBookingRepository,\n      resolvedWaitlistRepository,\n      resolvedUserRepository,\n      pricingService,\n    );\n    this.discountServiceFacade = new BookingDiscountService(\n      resolvedBookingRepository,\n      resolvedDiscountService,\n      this.lifecycleService,\n    );\n    this.approvalService = new BookingApprovalService(\n      resolvedBookingRepository,\n      resolvedListerRepository,\n      resolvedUserRepository,\n      pricingService,\n      this.lifecycleService,\n    );\n  }\n\n  async create(\n    userId: string,\n    dto: CreateBookingDto,\n    requestId: string,\n  ): Promise<BookingDetails> {\n    return this.lifecycleService.create(userId, dto, requestId);\n  }\n\n  async getForOwner(\n    userId: string,\n    bookingId: string,\n  ): Promise<BookingDetails> {\n    return this.lifecycleService.getForOwner(userId, bookingId);\n  }\n\n  async applyDiscount(\n    userId: string,\n    bookingId: string,\n    code: string | null,\n  ): Promise<BookingDetails> {\n    return this.discountServiceFacade.applyDiscount(userId, bookingId, code);\n  }\n\n  async cancel(userId: string, bookingId: string): Promise<unknown> {\n    return this.lifecycleService.cancel(userId, bookingId);\n  }\n\n  async expireIfDue(bookingId: string): Promise<unknown> {\n    return this.lifecycleService.expireIfDue(bookingId);\n  }\n\n  async requestApproval(\n    userId: string,\n    dto: CreateBookingDto,\n    requestId: string,\n  ): Promise<BookingDetails> {\n    return this.approvalService.requestApproval(userId, dto, requestId);\n  }\n\n  async resolveApprovalClaim(token: string) {\n    return this.approvalService.resolveApprovalClaim(token);\n  }\n\n  async getMyApprovedBookingForEvent(userId: string, eventId: string) {\n    return this.approvalService.getMyApprovedBookingForEvent(userId, eventId);\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Singleton export\n// ---------------------------------------------------------------------------\n\nexport const bookingService = new BookingService();\n","numLines":117,"startLine":1,"totalLines":117}},"tool_result_meta":[{"id":"call-84cb967d-86ab-425a-a3c4-52fd85cb0ef2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
