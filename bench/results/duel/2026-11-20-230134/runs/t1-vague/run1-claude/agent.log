{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-8567dd67-c957-4fca-903d-8df367526ef8","type":"tool_result","content":"300\t}\n301\t\n302\t// ─── AttendeesStep ────────────────────────────────────────────────────────────\n303\t\n304\texport default function AttendeesStep({\n305\t  eventId,\n306\t  onClose,\n307\t}: AttendeesStepProps) {\n308\t  const dispatch = useAppDispatch();\n309\t  const lines = useAppSelector((s) => s.booking.lines);\n310\t  const mode = useAppSelector((s) => s.booking.mode);\n311\t  // Set when the buyer already has a HELD booking for this event (e.g. they\n312\t  // went back from Review & Pay to change tickets) — passed through so the\n313\t  // server atomically supersedes the old hold instead of rejecting this\n314\t  // submission for already having an active booking.\n315\t  const existingBookingId = useAppSelector((s) => s.booking.bookingId);\n316\t  const selectedTeamTicketTypeId = useAppSelector(\n317\t    (s) => s.booking.selectedTeamTicketTypeId,\n318\t  );\n319\t  const isTeamMode = !!selectedTeamTicketTypeId;\n320\t  const reducedMotion = useReducedMotion();\n321\t\n322\t  // biome-ignore lint/correctness/useExhaustiveDependencies: fire once on mount\n323\t  useEffect(() => {\n324\t    try {\n325\t      activityTracker.track(\"checkout_step\", { eventId, step: 3 });\n326\t    } catch {}\n327\t  }, []);\n328\t\n329\t  const { data: ttData } = useGetTicketTypesQuery(eventId, {\n330\t    skip: !eventId,\n331\t  });\n332\t  const ticketTypes = ttData?.data ?? [];\n333\t\n334\t  const [commonValues, setCommonValues] = useState<Record<string, string>>({});\n335\t  const [commonErrors, setCommonErrors] = useState<Record<string, string>>({});\n336\t\n337\t  const [ticketValues, setTicketValues] = useState<\n338\t    Record<string, Record<string, Record<string, string>>>\n339\t  >({});\n340\t  const [ticketErrors, setTicketErrors] = useState<\n341\t    Record<string, Record<string, Record<string, string>>>\n342\t  >({});\n343\t\n344\t  const [soldOutError, setSoldOutError] = useState<string | null>(null);\n345\t  const [currentPage, setCurrentPage] = useState(0);\n346\t\n347\t  const [createBooking, { isLoading: isSubmittingBuy }] =\n348\t    useCreateBookingMutation();\n349\t  const [requestApproval, { isLoading: isSubmittingApproval }] =\n350\t    useRequestBookingApprovalMutation();\n351\t  const submitBooking = mode === \"approval\" ? requestApproval : createBooking;\n352\t  const isSubmitting = isSubmittingBuy || isSubmittingApproval;\n353\t  const [fetchBooking] = useLazyGetBookingQuery();\n354\t  const [cancelBooking] = useCancelBookingMutation();\n355\t  // Set while we're in the middle of resolving an ACTIVE_BOOKING_EXISTS\n356\t  // conflict — used to suppress duplicate error toasts and re-entry.\n357\t  const resumingRef = useRef(false);\n358\t\n359\t  const { city: userCity, state: userState } = useUserLocation();\n360\t\n361\t  const utmSource =\n362\t    typeof window !== \"undefined\"\n363\t      ? (new URLSearchParams(window.location.search).get(\"utm_source\") ??\n364\t        getUTMParams().utmSource ??\n365\t        undefined)\n366\t      : undefined;\n367\t\n368\t  const { needsAttendees } = useBookingFlowConfig(eventId);\n369\t  const autoStartedRef = useRef(false);\n370\t  const isCreatingBookingRef = useRef(false);\n371\t\n372\t  // ── Resume helper ────────────────────────────────────────────────────────\n373\t  // When the server throws ACTIVE_BOOKING_EXISTS:<id> (or\n374\t  // SUPERSEDE_TARGET_NOT_HELD:<id>) it means the caller has a HELD\n375\t  // booking they should pick up instead of opening a second one. We\n376\t  // fetch it, rehydrate the slice + sessionStorage, and jump past\n377\t  // attendees to the same step a successful create() would land on.\n378\t  //\n379\t  // If the held booking is no longer HELD (expired/cancelled/paid) we\n380\t  // cancel it server-side to release inventory, then return \"retry\" so\n381\t  // the caller can re-run create() with a clean slate.\n382\t  const tryResumeHeldBooking = useCallback(\n383\t    async (heldBookingId: string): Promise<\"resumed\" | \"retry\" | \"stuck\"> => {\n384\t      if (resumingRef.current) return \"stuck\";\n385\t      resumingRef.current = true;\n386\t      try {\n387\t        let existing: Awaited<ReturnType<typeof fetchBooking>>[\"data\"];\n388\t        try {\n389\t          existing = (await fetchBooking(heldBookingId)).data;\n390\t        } catch {\n391\t          return \"retry\";\n392\t        }\n393\t        if (!existing) return \"retry\";\n394\t\n395\t        const stillHeld =\n396\t          existing.status === \"HELD\" &&\n397\t          new Date(existing.holdExpiresAt).getTime() > Date.now();\n398\t\n399\t        if (!stillHeld) {\n400\t          // Stale — free the inventory and let the caller retry.\n401\t          try {\n402\t            await cancelBooking(heldBookingId).unwrap();\n403\t          } catch {}\n404\t          return \"retry\";\n405\t        }\n406\t\n407\t        // Rehydrate the in-progress state with the server's source of truth.\n408\t        dispatch(bookingActions.setBookingId(existing.bookingId));\n409\t        saveActiveBookingId(existing.bookingId);\n410\t        const rebuiltLines = existing.tickets.map((t) => ({\n411\t          ticketTypeId: t.ticketType.ticketTypeId,\n412\t          quantity: t.quantity,\n413\t          ticketFieldResponses: Array.from(\n414\t            { length: t.quantity },\n415\t            () => [] as FieldAnswer[],\n416\t          ),\n417\t        }));\n418\t        dispatch(bookingActions.setLines(rebuiltLines));\n419\t        setSoldOutError(null);\n420\t        // Same destination a successful create() would land on.\n421\t        dispatch(\n422\t          bookingActions.setStep(\n423\t            mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n424\t          ),\n425\t        );\n426\t        return \"resumed\";\n427\t      } finally {\n428\t        resumingRef.current = false;\n429\t      }\n430\t    },\n431\t    [fetchBooking, cancelBooking, dispatch, mode],\n432\t  );\n433\t\n434\t  // Event-level fields — skip for team events (collected on lobby)\n435\t  const { data: eventFieldsData } = useGetEventCustomFieldsQuery(eventId, {\n436\t    skip: !eventId || isTeamMode,\n437\t  });\n438\t\n439\t  // ── Field loaders ────────────────────────────────────────────────────────\n440\t\n441\t  const [commonFields, setCommonFields] = useState<CustomField[]>([]);\n442\t  const [ticketFieldsMap, setTicketFieldsMap] = useState<\n443\t    Record<\n444\t      string,\n445\t      {\n446\t        fields: CustomField[];\n447\t        typeName: string;\n448\t        quantity: number;\n449\t      }\n450\t    >\n451\t  >({});\n452\t\n453\t  const handleCommonFieldsLoaded = useCallback((fields: CustomField[]) => {\n454\t    setCommonFields(fields);\n455\t  }, []);\n456\t\n457\t  const handleTicketFieldsLoaded = useCallback(\n458\t    (\n459\t      fields: CustomField[],\n460\t      ticketTypeId: string,\n461\t      typeName: string,\n462\t      quantity: number,\n463\t    ) => {\n464\t      setTicketFieldsMap((prev) => {\n465\t        if (\n466\t          prev[ticketTypeId]?.fields.length === fields.length &&\n467\t          prev[ticketTypeId]?.quantity === quantity\n468\t        ) {\n469\t          return prev;\n470\t        }\n471\t        return {\n472\t          ...prev,\n473\t          [ticketTypeId]: { fields, typeName, quantity },\n474\t        };\n475\t      });\n476\t    },\n477\t    [],\n478\t  );\n479\t\n480\t  const handleCommonChange = useCallback((fieldId: string, value: string) => {\n481\t    setCommonValues((prev) => ({ ...prev, [fieldId]: value }));\n482\t    setCommonErrors((prev) => {\n483\t      const next = { ...prev };\n484\t      delete next[fieldId];\n485\t      return next;\n486\t    });\n487\t  }, []);\n488\t\n489\t  const handleTicketChange = useCallback(\n490\t    (\n491\t      ticketTypeId: string,\n492\t      ticketInde