{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-5c8cc350-2966-4c6b-bc7d-79435fa4becd","type":"tool_result","content":"180\t   * Cancel a booking owned by the authenticated user\n181\t   */\n182\t  cancel = asyncHandler(async (req: AuthenticatedRequest, res: Response) => {\n183\t    const userId = requireUser(req).userId;\n184\t    const id = req.params.id as string;\n185\t\n186\t    await this.bookingService.cancel(userId, id);\n187\t\n188\t    logger.info(\"Booking cancelled via API\", { bookingId: id, userId });\n189\t\n190\t    return res.status(204).send();\n191\t  }, \"Cancel Booking\");\n192\t\n193\t  /**\n194\t   * POST /api/v1/bookings/:id/confirm-free\n195\t   * Confirm a zero-total booking without payment\n196\t   */\n197\t  confirmFree = asyncHandler(\n198\t    async (req: AuthenticatedRequest, res: Response) => {\n199\t      const userId = requireUser(req).userId;\n200\t      const id = req.params.id as string;\n201\t\n202\t      const result = await this.paymentService.confirmFreeBooking(userId, id);\n203\t\n204\t      logger.info(\"Free booking confirmed via API\", { bookingId: id, userId });\n205\t\n206\t      return SuccessHandler.okWithData(res, \"Booking confirmed\", result);\n207\t    },\n208\t    \"Confirm Free Booking\",\n209\t  );\n210\t\n211\t  /**\n212\t   * POST /api/v1/bookings/:id/payment-order\n213\t   * Create a Razorpay payment order for a HELD booking\n214\t   */\n215\t  createPaymentOrder = asyncHandler(\n216\t    async (req: AuthenticatedRequest, res: Response) => {\n217\t      const userId = requireUser(req).userId;\n218\t      const id = req.params.id as string;\n219\t\n220\t      const order = await this.paymentService.createPaymentOrderForBooking(\n221\t        userId,\n222\t        id,\n223\t      );\n224\t\n225\t      logger.info(\"Payment order created for booking via API\", {\n226\t        bookingId: id,\n227\t        userId,\n228\t      });\n229\t\n230\t      return SuccessHandler.okWithData(res, \"Payment order created\", order);\n231\t    },\n232\t    \"Create Payment Order for Booking\",\n233\t  );\n234\t\n235\t  /**\n236\t   * POST /api/v1/bookings/:id/verify-payment\n237\t   * Verify Razorpay payment signature and confirm booking\n238\t   */\n239\t  verifyPayment = asyncHandler(\n240\t    async (req: AuthenticatedRequest, res: Response) => {\n241\t      const body = verifyBookingPaymentBody.parse(req.body);\n242\t      const userId = requireUser(req).userId;\n243\t      const id = req.params.id as string;\n244\t\n245\t      const booking = await this.paymentService.verifyBookingPayment(\n246\t        userId,\n247\t        id,\n248\t        body,\n249\t      );\n250\t\n251\t      logger.info(\"Booking payment verified via API\", {\n252\t        bookingId: id,\n253\t        userId,\n254\t      });\n255\t\n256\t      return SuccessHandler.okWithData(res, \"Payment verified\", booking);\n257\t    },\n258\t    \"Verify Booking Payment\",\n259\t  );\n260\t}\n261\t\n262\texport const bookingController = new BookingController();\n263\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"f6a6ee0d-75b1-408e-b5af-d20b122c8345","timestamp":"2026-11-20T17:39:40.940Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/controllers/booking.controller.ts","content":"   * Cancel a booking owned by the authenticated user\n   */\n  cancel = asyncHandler(async (req: AuthenticatedRequest, res: Response) => {\n    const userId = requireUser(req).userId;\n    const id = req.params.id as string;\n\n    await this.bookingService.cancel(userId, id);\n\n    logger.info(\"Booking cancelled via API\", { bookingId: id, userId });\n\n    return res.status(204).send();\n  }, \"Cancel Booking\");\n\n  /**\n   * POST /api/v1/bookings/:id/confirm-free\n   * Confirm a zero-total booking without payment\n   */\n  confirmFree = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const userId = requireUser(req).userId;\n      const id = req.params.id as string;\n\n      const result = await this.paymentService.confirmFreeBooking(userId, id);\n\n      logger.info(\"Free booking confirmed via API\", { bookingId: id, userId });\n\n      return SuccessHandler.okWithData(res, \"Booking confirmed\", result);\n    },\n    \"Confirm Free Booking\",\n  );\n\n  /**\n   * POST /api/v1/bookings/:id/payment-order\n   * Create a Razorpay payment order for a HELD booking\n   */\n  createPaymentOrder = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const userId = requireUser(req).userId;\n      const id = req.params.id as string;\n\n      const order = await this.paymentService.createPaymentOrderForBooking(\n        userId,\n        id,\n      );\n\n      logger.info(\"Payment order created for booking via API\", {\n        bookingId: id,\n        userId,\n      });\n\n      return SuccessHandler.okWithData(res, \"Payment order created\", order);\n    },\n    \"Create Payment Order for Booking\",\n  );\n\n  /**\n   * POST /api/v1/bookings/:id/verify-payment\n   * Verify Razorpay payment signature and confirm booking\n   */\n  verifyPayment = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const body = verifyBookingPaymentBody.parse(req.body);\n      const userId = requireUser(req).userId;\n      const id = req.params.id as string;\n\n      const booking = await this.paymentService.verifyBookingPayment(\n        userId,\n        id,\n        body,\n      );\n\n      logger.info(\"Booking payment verified via API\", {\n        bookingId: id,\n        userId,\n      });\n\n      return SuccessHandler.okWithData(res, \"Payment verified\", booking);\n    },\n    \"Verify Booking Payment\",\n  );\n}\n\nexport const bookingController = new BookingController();\n","numLines":84,"startLine":180,"totalLines":263}},"tool_result_meta":[{"id":"call-5c8cc350-2966-4c6b-bc7d-79435fa4becd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
