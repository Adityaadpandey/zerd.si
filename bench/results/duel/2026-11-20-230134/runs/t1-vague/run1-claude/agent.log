{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06629e7120b3e96a65","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport {\n3\t  BookingStatus,\n4\t  TicketPaymentStatus,\n5\t} from \"../../generated/prisma/enums\";\n6\timport type { TransactionClient } from \"../../generated/prisma/internal/prismaNamespace\";\n7\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n8\t\n9\texport class BookingLifecycleRepository {\n10\t  /**\n11\t   * Release a booking hold — reverses soldCount increments and marks\n12\t   * booking/tickets as EXPIRED or CANCELLED.\n13\t   *\n14\t   * Idempotent: returns null if the booking is not found or not in HELD state.\n15\t   */\n16\t  async releaseHoldTx(\n17\t    bookingId: string,\n18\t    reason: \"EXPIRED\" | \"CANCELLED\" | \"FAILED\",\n19\t  ): Promise<string | null> {\n20\t    return wrapDatabaseOperation(async () => {\n21\t      return await prisma.$transaction(async (tx) => {\n22\t        const newStatus =\n23\t          reason === \"EXPIRED\"\n24\t            ? BookingStatus.EXPIRED\n25\t            : reason === \"FAILED\"\n26\t              ? BookingStatus.FAILED\n27\t              : BookingStatus.CANCELLED;\n28\t\n29\t        const released = await this.releaseHoldInTx(tx, bookingId, newStatus);\n30\t        return released ? bookingId : null;\n31\t      });\n32\t    }, \"Release booking hold\");\n33\t  }\n34\t\n35\t  /**\n36\t   * Shared release logic used by both `releaseHoldTx` (expiry / user cancel)\n37\t   * and `BookingCreationRepository.createWithHoldSupersedingTx` (in-place\n38\t   * quantity edits). Atomically transitions the booking to `newStatus` (only\n39\t   * the first concurrent caller wins) then decrements the inventory + marks\n40\t   * tickets FAILED. Returns false if the booking wasn't found, wasn't owned\n41\t   * by `opts.userId` (when given), or wasn't in one of `opts.statusIn`\n42\t   * (defaults to the three hold-bearing statuses — HELD / PENDING_APPROVAL /\n43\t   * APPROVED_AWAITING_PAYMENT, preserving releaseHoldTx's existing behavior\n44\t   * for expiry + host-decline).\n45\t   *\n46\t   * Public (not private) so BookingCreationRepository can call it as part of\n47\t   * its own transaction when superseding a hold — see the facade's\n48\t   * constructor wiring.\n49\t   */\n50\t  async releaseHoldInTx(\n51\t    tx: TransactionClient,\n52\t    bookingId: string,\n53\t    newStatus: BookingStatus,\n54\t    opts?: { userId?: string; statusIn?: BookingStatus[] },\n55\t  ): Promise<boolean> {\n56\t    const statusIn = opts?.statusIn ?? [\n57\t      BookingStatus.HELD,\n58\t      BookingStatus.PENDING_APPROVAL,\n59\t      BookingStatus.APPROVED_AWAITING_PAYMENT,\n60\t    ];\n61\t\n62\t    // Atomic status transition: only the first concurrent caller wins.\n63\t    const transition = await tx.booking.updateMany({\n64\t      where: {\n65\t        bookingId,\n66\t        ...(opts?.userId ? { userId: opts.userId } : {}),\n67\t        status: { in: statusIn },\n68\t      },\n69\t      data: { status: newStatus },\n70\t    });\n71\t\n72\t    if (transition.count === 0) {\n73\t      // Missing booking, wrong owner, or already released by another worker.\n74\t      return false;\n75\t    }\n76\t\n77\t    // We own the release — load tickets for decrement + status update.\n78\t    const tickets = await tx.ticket.findMany({\n79\t      where: { bookingId },\n80\t      select: {\n81\t        ticketId: true,\n82\t        ticketTypeId: true,\n83\t        wasDiscounted: true,\n84\t        quantity: true,\n85\t        bundleGroupId: true,\n86\t        bundleWasDiscounted: true,\n87\t        teamId: true,\n88\t        userId: true,\n89\t        seatId: true,\n90\t      },\n91\t    });\n92\t\n93\t    // Aggregate counts per ticketType (skip RSVP tickets — null ticketTypeId).\n94\t    // Track total + discounted seats so we can decrement both counters.\n95\t    // Use ticket.quantity (not += 1) since each row now represents N seats.\n96\t    const aggByType = new Map<\n97\t      string,\n98\t      { totalQty: number; discountQty: number }\n99\t    >();\n100\t    const groupDiscountAgg = new Map<string, number>();\n101\t    for (const ticket of tickets) {\n102\t      if (!ticket.ticketTypeId) continue;\n103\t      const agg = aggByType.get(ticket.ticketTypeId) ?? {\n104\t        totalQty: 0,\n105\t        discountQty: 0,\n106\t      };\n107\t      agg.totalQty += ticket.quantity;\n108\t      if (ticket.wasDiscounted) agg.discountQty += ticket.quantity;\n109\t      aggByType.set(ticket.ticketTypeId, agg);\n110\t\n111\t      if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n112\t        // Every bundle member's ticket row for the same bundle purchase\n113\t        // carries the IDENTICAL quantity (the number of bundle-units\n114\t        // bought) — summing across members would multi-count by the\n115\t        // bundle's member count, so take the quantity once per group.\n116\t        groupDiscountAgg.set(\n117\t          ticket.bundleGroupId,\n118\t          Math.max(\n119\t            groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n120\t            ticket.quantity,\n121\t          ),\n122\t        );\n123\t      }\n124\t    }\n125\t\n126\t    for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n127\t      await tx.$executeRaw`\n128\t\t\t\t\t\tUPDATE \"TicketType\"\n129\t\t\t\t\t\tSET \"soldCount\" = \"soldCount\" - ${totalQty},\n130\t\t\t\t\t\t    \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n131\t\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n132\t\t\t\t\t\t  AND \"soldCount\" >= ${totalQty}\n133\t\t\t\t\t`;\n134\t    }\n135\t\n136\t    for (const [groupId, discountQty] of groupDiscountAgg) {\n137\t      await tx.$executeRaw`\n138\t\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n139\t\t\t\t\t\tSET \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n140\t\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n141\t\t\t\t\t`;\n142\t    }\n143\t\n144\t    const ticketIds = tickets.map((t) => t.ticketId);\n145\t    if (ticketIds.length > 0) {\n146\t      await tx.ticket.updateMany({\n147\t        where: { ticketId: { in: ticketIds } },\n148\t        data: { status: TicketPaymentStatus.FAILED },\n149\t      });\n150\t    }\n151\t\n152\t    // Reserved seating: give the physical seats back so other buyers can\n153\t    // select them again. Covers expiry, user cancellation, and supersede —\n154\t    // every release path in this codebase funnels through here.\n155\t    const releasedSeatIds = tickets\n156\t      .map((t) => t.seatId)\n157\t      .filter((id): id is string => id != null);\n158\t    if (releasedSeatIds.length > 0) {\n159\t      await tx.seat.updateMany({\n160\t        where: { seatId: { in: releasedSeatIds } },\n161\t        data: { status: \"AVAILABLE\", holdBookingId: null, holdExpiresAt: null },\n162\t      });\n163\t    }\n164\t\n165\t    // If a released ticket belonged to a CONFIRMED team's open-seat\n166\t    // reservation (§2 of the open-seats design), the buyer abandoned\n167\t    // checkout — undo the reservation: drop the awaiting `TeamMember` row\n168\t    // and give the seat back. Scoped narrowly to CONFIRMED teams because a\n169\t    // leader's original `createTeamBooking` PENDING tickets are created\n170\t    // while the team is still PENDING — those never hit this branch and\n171\t    // never had `currentSize` incremented for them in the first place.\n172\t    const teamTicketOwners = new Map<string, string>();\n173\t    for (const t of tickets) {\n174\t      if (t.teamId) teamTicketOwners.set(t.userId, t.teamId);\n175\t    }\n176\t    for (const [userId, teamId] of teamTicketOwners) {\n177\t      const team = await tx.team.findUnique({\n178\t        where: { teamId },\n179\t        select: { status: true },\n180\t      });\n181\t      if (team?.status !== \"CONFIRMED\") continue;\n182\t\n183\t      const removed = await tx.teamMember.deleteMany({\n184\t        where: { teamId, userId, ticketId: null },\n185\t      });\n186\t      if (removed.count > 0) {\n187\t        await tx.team.update({\n188\t          where: { teamId },\n189\t          data: { currentSize: { decrement: 1 } },\n190\t        });\n191\t      }\n192\t    }\n193\t\n194\t    return true;\n195\t  }\n196\t\n197\t  /**\n198\t   * Extend the hold window for a HELD or APPROVED_AWAITING_PAYMENT booking.\n199\t   * Used by the payment service when a Razorpay order is created so the\n200\t   * in-flight payment isn't expired before it can be verified.\n201\t   */\n202\t  async extendHold(bookingId: string, newExpiresAt: Date): Promise<void> {\n203\t    await wrapDatabaseOperation(async () => {\n204\t      await prisma.booking.updateMany({\n205\t        where: {\n206\t          bookingId,\n207\t          status: {\n208\t            in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n209\t          },\n210\t        },\n211\t        data: { holdExpiresAt: newExpiresAt },\n212\t      });\n213\t    }, \"Extend booking hold\");\n214\t  }\n215\t\n216\t  /**\n217\t   * Mark a booking and all its tickets as paid.\n218\t   * Returns the full booking including tickets and payment.\n219\t   */\n220\t  async markPaidTx(\n221\t    bookingId: string,\n222\t    cash?: { reason: string },\n223\t  ): Promise<boolean> {\n224\t    return wrapDatabaseOperation(async () => {\n225\t      return await prisma.$transaction(async (tx) => {\n226\t        // Atomic: only transitions from live hold states so concurrent callers\n227\t        // (verifyBookingPayment + webhook) don't double-fire side effects.\n228\t        // A cash sale is tagged in the SAME update, so \"paid in cash\" can never\n229\t        // be recorded for a booking that a UPI payment actually won.\n230\t        const transition = await tx.booking.updateMany({\n231\t          where: {\n232\t            bookingId,\n233\t            status: {\n234\t              in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n235\t            },\n236\t          },\n237\t          data: {\n238\t            status: BookingStatus.PAID,\n239\t            ...(cash\n240\t              ? {\n241\t                  paymentMode: \"CASH\" as const,\n242\t                  cashReason: cash.reason || null,\n243\t                }\n244\t              : {}),\n245\t          },\n246\t        });\n247\t\n248\t        if (transition.count === 0) return false;\n249\t\n250\t        await tx.ticket.updateMany({\n251\t          where: { bookingId },\n252\t          data: { status: TicketPaymentStatus.SUCCESS },\n253\t        });\n254\t\n255\t        return true;\n256\t      });\n257\t    }, \"Mark booking as paid\");\n258\t  }\n259\t\n260\t  /**\n261\t   * Forces a booking back to PAID when it lost the race against its own\n262\t   * hold-expiry sweep — Razorpay captured the payment a few seconds after\n263\t   * `releaseHoldInTx` already flipped it to EXPIRED/FAILED/CANCELLED and\n264\t   * marked its tickets FAILED (the 15-minute window from\n265\t   * `createPaymentOrderForBooking`'s `extendHold` can be tight for a slow\n266\t   * UPI collect approval). `markPaidTx` deliberately won't touch a booking\n267\t   * once it's left HELD/APPROVED_AWAITING_PAYMENT, so a captured payment that\n268\t   * loses this race needs an explicit override rather than silently getting\n269\t   * dropped. Re-adds exactly what `releaseHoldInTx` subtracted for this\n270\t   * booking's tickets — the inverse of that method. Does NOT cap the\n271\t   * soldCount add at TicketType.quantity: the seat was already sold and paid\n272\t   * for, so if the freed slot got resold to someone else in the race window,\n273\t   * that's a rare oversell for the host to handle manually, not a reason to\n274\t   * deny a paying buyer their ticket. Returns false if the booking isn't in\n275\t   * one of the released states (nothing to reconcile).\n276\t   */\n277\t  async forcePaidAfterRaceTx(bookingId: string): Promise<boolean> {\n278\t    return wrapDatabaseOperation(async () => {\n279\t      return await prisma.$transaction(async (tx) => {\n280\t        const transition = await tx.booking.updateMany({\n281\t          where: {\n282\t            bookingId,\n283\t            status: {\n284\t              in: [\n285\t                BookingStatus.EXPIRED,\n286\t                BookingStatus.FAILED,\n287\t                BookingStatus.CANCELLED,\n288\t              ],\n289\t            },\n290\t          },\n291\t          data: { status: BookingStatus.PAID },\n292\t        });\n293\t\n294\t        if (transition.count === 0) return false;\n295\t\n296\t        const tickets = await tx.ticket.findMany({\n297\t          where: { bookingId },\n298\t          select: {\n299\t            ticketTypeId: true,\n300\t            wasDiscounted: true,\n301\t            quantity: true,\n302\t            bundleGroupId: true,\n303\t            bundleWasDiscounted: true,\n304\t          },\n305\t        });\n306\t\n307\t        const aggByType = new Map<\n308\t          string,\n309\t          { totalQty: number; discountQty: number }\n310\t        >();\n311\t        const groupDiscountAgg = new Map<string, number>();\n312\t        for (const ticket of tickets) {\n313\t          if (!ticket.ticketTypeId) continue;\n314\t          const agg = aggByType.get(ticket.ticketTypeId) ?? {\n315\t            totalQty: 0,\n316\t            discountQty: 0,\n317\t          };\n318\t          agg.totalQty += ticket.quantity;\n319\t          if (ticket.wasDiscounted) agg.discountQty += ticket.quantity;\n320\t          aggByType.set(ticket.ticketTypeId, agg);\n321\t\n322\t          if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n323\t            groupDiscountAgg.set(\n324\t              ticket.bundleGroupId,\n325\t              Math.max(\n326\t                groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n327\t                ticket.quantity,\n328\t              ),\n329\t            );\n330\t          }\n331\t        }\n332\t\n333\t        for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n334\t          await tx.$executeRaw`\n335\t\t\t\t\t\t\tUPDATE \"TicketType\"\n336\t\t\t\t\t\t\tSET \"soldCount\" = \"soldCount\" + ${totalQty},\n337\t\t\t\t\t\t\t    \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n338\t\t\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n339\t\t\t\t\t\t`;\n340\t        }\n341\t\n342\t        for (const [groupId, discountQty] of groupDiscountAgg) {\n343\t          await tx.$executeRaw`\n344\t\t\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n345\t\t\t\t\t\t\tSET \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n346\t\t\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n347\t\t\t\t\t\t`;\n348\t        }\n349\t\n350\t        await tx.ticket.updateMany({\n351\t          where: { bookingId },\n352\t          data: { status: TicketPaymentStatus.SUCCESS },\n353\t        });\n354\t\n355\t        return true;\n356\t      });\n357\t    }, \"Force booking paid after expiry race\");\n358\t  }\n359\t\n360\t  /** True if any ticket type in this booking now has more sold than its quantity. */\n361\t  async hasOversoldTicketType(bookingId: string): Promise<boolean> {\n362\t    return wrapDatabaseOperation(async () => {\n363\t      const rows = await prisma.$queryRaw<{ one: number }[]>`\n364\t        SELECT 1 AS one FROM \"TicketType\" tt\n365\t        WHERE tt.\"ticketTypeId\" IN (SELECT \"ticketTypeId\" FROM \"Ticket\" WHERE \"bookingId\" = ${bookingId})\n366\t          AND tt.\"soldCount\" > tt.\"quantity\"\n367\t        LIMIT 1\n368\t      `;\n369\t      return rows.length > 0;\n370\t    }, \"Check oversold ticket types for booking\");\n371\t  }\n372\t\n373\t  /**\n374\t   * Cancel a confirmed free/RSVP booking (status PAID → CANCELLED).\n375\t   * Sets all child tickets to REFUNDED. Returns true if updated, false if\n376\t   * the booking was already in a terminal state (idempotent).\n377\t   */\n378\t  async cancelConfirmedFreeTx(bookingId: string): Promise<boolean> {\n379\t    return wrapDatabaseOperation(async () => {\n380\t      return await prisma.$transaction(async (tx) => {\n381\t        const result = await tx.booking.updateMany({\n382\t          where: { bookingId, status: BookingStatus.PAID },\n383\t          data: { status: BookingStatus.CANCELLED },\n384\t        });\n385\t        if (result.count === 0) return false;\n386\t        await tx.ticket.updateMany({\n387\t          where: { bookingId },\n388\t          data: { status: TicketPaymentStatus.REFUNDED },\n389\t        });\n390\t        return true;\n391\t      });\n392\t    }, \"Cancel confirmed free booking\");\n393\t  }\n394\t}\n395\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"9049ef47-aad1-48ea-ad16-9a03e5cef41e","timestamp":"2026-11-20T17:34:47.659Z","tool_result_meta":[{"id":"call_01a1fa06629e7120b3e96a65","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06640877fbb3d37052","type":"tool_result","content":"1\timport { config } from \"../../config/index\";\n2\timport logger from \"../../config/logger\";\n3\timport type { BookingRepository } from \"../../repositories/booking.repository\";\n4\timport type { ValidateDiscountCodeInput } from \"../../types/discount.types\";\n5\timport { distributeCoupon } from \"../../utils/coupon-pricing.util\";\n6\timport { ConflictError, ValidationError } from \"../../utils/errors.util\";\n7\timport { computeSeatPricing } from \"../../utils/fee-pricing.util\";\n8\timport { fromPaise, round2, toPaise } from \"../../utils/money.util\";\n9\timport type { DiscountService } from \"../discount.service\";\n10\timport type { BookingLifecycleService } from \"./booking-lifecycle.service\";\n11\timport type { BookingDetails } from \"./types\";\n12\t\n13\texport class BookingDiscountService {\n14\t  constructor(\n15\t    private readonly bookingRepository: BookingRepository,\n16\t    private readonly discountService: DiscountService,\n17\t    private readonly lifecycleService: BookingLifecycleService,\n18\t  ) {}\n19\t\n20\t  /**\n21\t   * Apply or clear a discount code on a HELD booking.\n22\t   *\n23\t   * - code === null  → clear any existing discount; re-run fee math at 0 coupon.\n24\t   * - code !== null  → validate via DiscountService, then distribute the discount\n25\t   *                    proportionally across lines and re-run full fee computation\n26\t   *                    (fixes the coupon-leakage bug: coupon now flows through\n27\t   *                    platformFee, gst, gatewayFee, not just booking.total).\n28\t   *\n29\t   * All fee snapshots on Booking AND Ticket rows are updated atomically.\n30\t   */\n31\t  async applyDiscount(\n32\t    userId: string,\n33\t    bookingId: string,\n34\t    code: string | null,\n35\t  ): Promise<BookingDetails> {\n36\t    const booking = await this.lifecycleService.getForOwner(userId, bookingId);\n37\t\n38\t    if (booking.status !== \"HELD\") {\n39\t      throw new ConflictError(\"Cannot modify a finalized booking\");\n40\t    }\n41\t\n42\t    // ------------------------------------------------------------------\n43\t    // Reconstruct per-line pricing data from stored Ticket snapshots.\n44\t    // Ticket.faceValue is the row-total (seatFace × qty), frozen at creation.\n45\t    // Ticket.ticketType is the live TicketType for the fee config.\n46\t    // ------------------------------------------------------------------\n47\t    const tickets = booking.tickets;\n48\t\n49\t    // couponBase = Σ Ticket.faceValue (pre-coupon subtotal, same as booking.subtotal)\n50\t    const couponBase = fromPaise(\n51\t      tickets.reduce((s, t) => s + toPaise(t.faceValue), 0),\n52\t    );\n53\t\n54\t    // Early-bird saving (already baked into faceValue vs full price)\n55\t    const earlyBirdSaving = fromPaise(\n56\t      tickets.reduce((s, t) => {\n57\t        if (!t.wasDiscounted || !t.ticketType) return s;\n58\t        const perSeatFaceP =\n59\t          t.quantity > 0 ? Math.round(toPaise(t.faceValue) / t.quantity) : 0;\n60\t        return s + (toPaise(t.ticketType.price) - perSeatFaceP) * t.quantity;\n61\t      }, 0),\n62\t    );\n63\t\n64\t    // Determine coupon discount amount\n65\t    let couponDiscount = 0;\n66\t    let discountCodeId: string | null = null;\n67\t\n68\t    if (code === null) {\n69\t      // Clear — discount = 0, reprice without coupon\n70\t      discountCodeId = null;\n71\t      couponDiscount = 0;\n72\t      logger.info(\"Booking discount cleared\", { bookingId, userId });\n73\t    } else {\n74\t      // Validate via DiscountService (DB lookup, error surfacing to buyer)\n75\t      const validateInput: ValidateDiscountCodeInput = {\n76\t        code,\n77\t        eventId: booking.event.eventId,\n78\t        orderAmount: couponBase,\n79\t      };\n80\t\n81\t      const result =\n82\t        await this.discountService.validateDiscountCode(validateInput);\n83\t\n84\t      if (!result.valid || !result.discount) {\n85\t        throw new ValidationError(result.error ?? \"Invalid discount code\");\n86\t      }\n87\t\n88\t      couponDiscount = result.discount.discountAmount;\n89\t      discountCodeId = result.discount.codeId;\n90\t    }\n91\t\n92\t    // ------------------------------------------------------------------\n93\t    // Distribute coupon across lines (proportional by seatFace × qty).\n94\t    // shares[i] = line-total coupon for ticket row i.\n95\t    // ------------------------------------------------------------------\n96\t    const pricingLines = tickets.map((t) => ({\n97\t      seatFace: t.quantity > 0 ? t.faceValue / t.quantity : 0,\n98\t      qty: t.quantity,\n99\t    }));\n100\t    const shares = distributeCoupon(pricingLines, couponDiscount);\n101\t\n102\t    // ------------------------------------------------------------------\n103\t    // Re-compute per-ticket fee snapshots with new netFace (post-coupon).\n104\t    // ------------------------------------------------------------------\n105\t    let newPlatformFeeP = 0;\n106\t    let newGatewayFeeP = 0;\n107\t    let newGstP = 0;\n108\t    let newTotalP = 0;\n109\t\n110\t    const ticketUpdates = tickets.map((t, i) => {\n111\t      const perSeatFace =\n112\t        t.quantity > 0 ? fromPaise(Math.round(toPaise(t.faceValue) / t.quantity)) : 0;\n113\t      const couponSharePerSeat = t.quantity > 0 ? shares[i] / t.quantity : 0;\n114\t      const netFace = round2(perSeatFace - couponSharePerSeat);\n115\t\n116\t      const tt = t.ticketType;\n117\t      const feeConfig = tt\n118\t        ? {\n119\t            platformfee: tt.platformfee,\n120\t            platformfeePerc: tt.platformfeePerc,\n121\t            gatewayFeePerc: tt.gatewayFeePerc,\n122\t            feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n123\t          }\n124\t        : {\n125\t            platformfee: 0,\n126\t            platformfeePerc: 0.025,\n127\t            gatewayFeePerc: 0.025,\n128\t            feeBornBy: \"HOST\" as const,\n129\t          };\n130\t\n131\t      const seat = computeSeatPricing(netFace, feeConfig, config.TUNYT_GST_ENABLED);\n132\t\n133\t      const rowPFP = toPaise(seat.platformFee) * t.quantity;\n134\t      const rowGFP = toPaise(seat.gatewayFee) * t.quantity;\n135\t      const rowGSTP = toPaise(seat.gst) * t.quantity;\n136\t      const rowTotalP = toPaise(seat.buyerPays) * t.quantity;\n137\t\n138\t      newPlatformFeeP += rowPFP;\n139\t      newGatewayFeeP += rowGFP;\n140\t      newGstP += rowGSTP;\n141\t      newTotalP += rowTotalP;\n142\t\n143\t      return {\n144\t        ticketId: t.ticketId,\n145\t        totalPrice: fromPaise(rowTotalP),\n146\t        platformFee: fromPaise(rowPFP),\n147\t        gatewayFee: fromPaise(rowGFP),\n148\t        gst: fromPaise(rowGSTP),\n149\t      };\n150\t    });\n151\t\n152\t    const newDiscountAmount = round2(earlyBirdSaving + couponDiscount);\n153\t    const newTotal = fromPaise(newTotalP);\n154\t\n155\t    // ------------------------------------------------------------------\n156\t    // Atomically persist Booking + Ticket snapshots.\n157\t    // ------------------------------------------------------------------\n158\t    await this.bookingRepository.repriceWithDiscount(bookingId, {\n159\t      discountCodeId,\n160\t      discountAmount: newDiscountAmount,\n161\t      platformFee: fromPaise(newPlatformFeeP),\n162\t      gatewayFee: fromPaise(newGatewayFeeP),\n163\t      gst: fromPaise(newGstP),\n164\t      total: newTotal,\n165\t      ticketUpdates,\n166\t    });\n167\t\n168\t    logger.info(\"Booking repriced with discount\", {\n169\t      bookingId,\n170\t      userId,\n171\t      code,\n172\t      couponDiscount,\n173\t      newDiscountAmount,\n174\t      newTotal,\n175\t    });\n176\t\n177\t    return this.lifecycleService.getForOwner(userId, bookingId);\n178\t  }\n179\t}\n180\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"3ea0bb76-ab76-44a9-a187-8d7ff9c34a08","timestamp":"2026-11-20T17:34:47.697Z","tool_result_meta":[{"id":"call_01a1fa06640877fbb3d37052","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0664ad7188907c9d5e","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n3\t\n4\texport class BookingPricingRepository {\n5\t  /**\n6\t   * Apply or clear a discount on a booking (legacy — updates total only).\n7\t   * Prefer `repriceWithDiscount` for full fee re-computation.\n8\t   */\n9\t  async updateDiscount(\n10\t    bookingId: string,\n11\t    patch: {\n12\t      discountCodeId: string | null;\n13\t      discountAmount: number;\n14\t      total: number;\n15\t    },\n16\t  ) {\n17\t    return wrapDatabaseOperation(async () => {\n18\t      return await prisma.booking.update({\n19\t        where: { bookingId },\n20\t        data: {\n21\t          discountCodeId: patch.discountCodeId,\n22\t          discountAmount: patch.discountAmount,\n23\t          total: patch.total,\n24\t        },\n25\t      });\n26\t    }, \"Update booking discount\");\n27\t  }\n28\t\n29\t  /**\n30\t   * Re-price a booking when a coupon is applied or cleared.\n31\t   *\n32\t   * Atomically updates all money fields on Booking (discountCodeId,\n33\t   * discountAmount, platformFee, gatewayFee, gst, total) AND the\n34\t   * per-ticket snapshots (totalPrice, platformFee, gatewayFee, gst).\n35\t   * The Ticket.faceValue is NOT changed — it always holds the pre-coupon\n36\t   * seatFace so analytics can reconstruct the original order price.\n37\t   */\n38\t  async repriceWithDiscount(\n39\t    bookingId: string,\n40\t    patch: {\n41\t      discountCodeId: string | null;\n42\t      discountAmount: number;\n43\t      platformFee: number;\n44\t      gatewayFee: number;\n45\t      gst: number;\n46\t      total: number;\n47\t      ticketUpdates: Array<{\n48\t        ticketId: string;\n49\t        totalPrice: number;\n50\t        platformFee: number;\n51\t        gatewayFee: number;\n52\t        gst: number;\n53\t      }>;\n54\t    },\n55\t  ) {\n56\t    return wrapDatabaseOperation(async () => {\n57\t      return await prisma.$transaction(async (tx) => {\n58\t        await tx.booking.update({\n59\t          where: { bookingId },\n60\t          data: {\n61\t            discountCodeId: patch.discountCodeId,\n62\t            discountAmount: patch.discountAmount,\n63\t            platformFee: patch.platformFee,\n64\t            gatewayFee: patch.gatewayFee,\n65\t            gst: patch.gst,\n66\t            total: patch.total,\n67\t          },\n68\t        });\n69\t\n70\t        for (const t of patch.ticketUpdates) {\n71\t          await tx.ticket.update({\n72\t            where: { ticketId: t.ticketId },\n73\t            data: {\n74\t              totalPrice: t.totalPrice,\n75\t              platformFee: t.platformFee,\n76\t              gatewayFee: t.gatewayFee,\n77\t              gst: t.gst,\n78\t            },\n79\t          });\n80\t        }\n81\t      });\n82\t    }, \"Reprice booking with discount\");\n83\t  }\n84\t}\n85\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"cad3ccb2-64cf-4c0a-b772-8980dd44c80c","timestamp":"2026-11-20T17:34:47.813Z","tool_result_meta":[{"id":"call_01a1fa0664ad7188907c9d5e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
