{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-aeb57534-af3c-43e6-9d8a-a3088742e07a","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport dynamic from \"next/dynamic\";\n4\timport { useCallback, useEffect, useRef, useState } from \"react\";\n5\timport { useReducedMotion } from \"@/hooks/useReducedMotion\";\n6\timport { useSheetDismiss } from \"@/hooks/useSheetDismiss\";\n7\timport { activityTracker } from \"@/lib/analytics/activity-tracker\";\n8\timport { clearActiveBookingId } from \"@/lib/booking/session-storage\";\n9\timport { loadRazorpay } from \"@/lib/razorpay/loader\";\n10\timport { addToast } from \"@/lib/redux\";\n11\timport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\n12\timport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n13\t// Main-path steps stay static. Every booking moves through these in order, so\n14\t// code-splitting them only adds a chunk-fetch latency penalty on the critical\n15\t// path (and risks blank-screen flashes on slow networks / cold dev compiles).\n16\timport ApprovalSubmittedStep from \"./steps/ApprovalSubmittedStep\";\n17\timport AttendeesStep from \"./steps/AttendeesStep\";\n18\timport ConfirmStep from \"./steps/ConfirmStep\";\n19\timport IdentifyStep from \"./steps/IdentifyStep\";\n20\timport PaymentStep from \"./steps/PaymentStep\";\n21\timport ReviewStep from \"./steps/ReviewStep\";\n22\timport SelectStep from \"./steps/SelectStep\";\n23\t\n24\t// TeamSetupStep is a real branch — only reached when the user is booking\n25\t// team tickets. Code-split it to keep its form deps out of the solo-booking\n26\t// initial bundle.\n27\tconst TeamSetupStep = dynamic(() => import(\"./steps/TeamSetupStep\"), {\n28\t  ssr: false,\n29\t  loading: () => null,\n30\t});\n31\t\n32\t// ─── useMountedWithExit ───────────────────────────────────────────────────────\n33\t// Keeps a sheet mounted for `exitDurationMs` after `isOpen` flips false so its\n34\t// exit keyframes can play instead of an instant unmount. `onAnimationEnd`\n35\t// (wired to the animating element) ends it early; the timeout is a fallback\n36\t// in case the animationend event doesn't fire.\n37\t\n38\tfunction useMountedWithExit(\n39\t  isOpen: boolean,\n40\t  reducedMotion: boolean,\n41\t  exitDurationMs = 220,\n42\t) {\n43\t  const [mounted, setMounted] = useState(isOpen);\n44\t  const [closing, setClosing] = useState(false);\n45\t  const fallbackRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n46\t  const wasOpenRef = useRef(isOpen);\n47\t  // Set right before an already-animated close (e.g. a swipe-to-dismiss that\n48\t  // finished its own off-screen slide) calls back into `isOpen=false`, so\n49\t  // this hook unmounts immediately instead of replaying its own exit\n50\t  // keyframes on top of a transform the drag already resolved — otherwise\n51\t  // the two animations fight over the same `transform` and the sheet visibly\n52\t  // snaps back into place before sliding out a second time.\n53\t  const skipExitRef = useRef(false);\n54\t\n55\t  useEffect(() => {\n56\t    const wasOpen = wasOpenRef.current;\n57\t    wasOpenRef.current = isOpen;\n58\t\n59\t    if (isOpen) {\n60\t      if (fallbackRef.current) {\n61\t        clearTimeout(fallbackRef.current);\n62\t        fallbackRef.current = null;\n63\t      }\n64\t      setMounted(true);\n65\t      setClosing(false);\n66\t      return;\n67\t    }\n68\t\n69\t    if (!wasOpen) return;\n70\t    if (reducedMotion || skipExitRef.current) {\n71\t      skipExitRef.current = false;\n72\t      setMounted(false);\n73\t      setClosing(false);\n74\t      return;\n75\t    }\n76\t    setClosing(true);\n77\t    fallbackRef.current = setTimeout(() => {\n78\t      setMounted(false);\n79\t      setClosing(false);\n80\t    }, exitDurationMs);\n81\t  }, [isOpen, reducedMotion, exitDurationMs]);\n82\t\n83\t  useEffect(\n84\t    () => () => {\n85\t      if (fallbackRef.current) clearTimeout(fallbackRef.current);\n86\t    },\n87\t    [],\n88\t  );\n89\t\n90\t  const onAnimationEnd = useCallback(() => {\n91\t    if (!closing) return;\n92\t    if (fallbackRef.current) {\n93\t      clearTimeout(fallbackRef.current);\n94\t      fallbackRef.current = null;\n95\t    }\n96\t    setMounted(false);\n97\t    setClosing(false);\n98\t  }, [closing]);\n99\t\n100\t  const skipNextExit = useCallback(() => {\n101\t    skipExitRef.current = true;\n102\t  }, []);\n103\t\n104\t  return { mounted, closing, onAnimationEnd, skipNextExit };\n105\t}\n106\t\n107\t// ─── BookingModal ─────────────────────────────────────────────────────────────\n108\t\n109\tinterface BookingModalProps {\n110\t  open: boolean;\n111\t  onClose: () => void;\n112\t  eventId: string;\n113\t}\n114\t\n115\texport default function BookingModal({\n116\t  open,\n117\t  onClose,\n118\t  eventId,\n119\t}: BookingModalProps) {\n120\t  const dispatch = useAppDispatch();\n121\t  const step = useAppSelector((s) => s.booking.step);\n122\t  const reducedMotion = useReducedMotion();\n123\t  const [showDiscard, setShowDiscard] = useState(false);\n124\t  const [entered, setEntered] = useState(reducedMotion);\n125\t  const sheetRef = useRef<HTMLDivElement>(null);\n126\t  const discardSheetRef = useRef<HTMLDivElement>(null);\n127\t\n128\t  useEffect(() => {\n129\t    if (reducedMotion) setEntered(true);\n130\t  }, [reducedMotion]);\n131\t\n132\t  // SelectStep set a page-level \"team join dialog\" flag — close ourselves\n133\t  // without the discard confirmation so the booking flow doesn't trap the\n134\t  // user when they decide to switch to joining an existing team.\n135\t  const teamJoinDialogOpen = useAppSelector((s) => s.ui.teamJoinDialogOpen);\n136\t\n137\t  // Close animations: don't unmount the instant `open`/`showDiscard` flips\n138\t  // false — play the reverse keyframes and only unmount once they finish.\n139\t  const modalExit = useMountedWithExit(open, reducedMotion);\n140\t  const discardExit = useMountedWithExit(showDiscard, reducedMotion);\n141\t\n142\t  // Close ourselves when the join-by-code dialog is requested from inside\n143\t  // the booking flow. Done after `modalExit` so we can use `skipNextExit`\n144\t  // to suppress the slide-down animation that would otherwise compete with\n145\t  // the join dialog's own entrance.\n146\t  useEffect(() => {\n147\t    if (!open) return;\n148\t    if (!teamJoinDialogOpen) return;\n149\t    clearActiveBookingId();\n150\t    dispatch(bookingActions.reset());\n151\t    modalExit.skipNextExit();\n152\t    onClose();\n153\t  }, [teamJoinDialogOpen, open, dispatch, onClose, modalExit]);\n154\t\n155\t  // Body scroll lock\n156\t  useEffect(() => {\n157\t    if (!open) return;\n158\t    const prev = document.body.style.overflow;\n159\t    document.body.style.overflow = \"hidden\";\n160\t    return () => {\n161\t      document.body.style.overflow = prev;\n162\t    };\n163\t  }, [open]);\n164\t\n165\t  // Start loading the Razorpay script as soon as the modal opens for paid flows\n166\t  // so it's ready by the time the user reaches the payment step. Skip free/RSVP\n167\t  // flows — they never reach Razorpay and loading it there would waste bandwidth.\n168\t  const bookingMode = useAppSelector((s) => s.booking.mode);\n169\t  useEffect(() => {\n170\t    if (!open) return;\n171\t    if (bookingMode === \"free\" || bookingMode === \"rsvp\") return;\n172\t    loadRazorpay().catch(() => {});\n173\t  }, [open, bookingMode]);\n174\t\n175\t  // Analytics: emit checkout_step on step changes (checkout_start fires from\n176\t  // the event page CTA that opens this modal — see EventPageClient onBuy)\n177\t  const prevStepRef = useRef(0);\n178\t  const STEP_NAMES: Record<number, string> = {\n179\t    1: \"identify\",\n180\t    2: \"select\",\n181\t    3: \"attendees\",\n182\t    4: \"review\",\n183\t    5: \"payment\",\n184\t    6: \"team_setup\",\n185\t    7: \"confirm\",\n186\t    8: \"approval_submitted\",\n187\t  };\n188\t  useEffect(() => {\n189\t    // Track each step transition\n190\t    if (open && step !== prevStepRef.current && step > 0) {\n191\t      const stepName = STEP_NAMES[step] ?? `step_${step}`;\n192\t      activityTracker.track(\"checkout_step\", {\n193\t        eventId,\n194\t        step,\n195\t        stepName,\n196\t      });\n197\t\n198\t      // Reached the payment step (5) then navigated back — a strong drop-off\n199\t      // signal distinct from a full checkout_abandon.\n200\t      if (prevStepRef.current === 5 && step < 5) {\n201\t        activityTracker.track(\"back_from_payment\", {\n202\t          eventId,\n203\t          toStep: step,\n204\t        });\n205\t      }\n206\t    }\n207\t    prevStepRef.current = step;\n208\t  }, [open, step, eventId]);\n209\t\n210\t  // Emit checkout_abandon on tab close / refresh if booking not yet paid\n211\t  useEffect(() => {\n212\t    if (!open) return;\n213\t\n214\t    const handler = () => {\n215\t      // Only skip once the booking is fully complete (step 7 = ConfirmStep, step 8 = ApprovalSubmitted).\n216\t      // Steps 1–6 (including payment step 5) are still in-progress and should be counted as abandoned.\n217\t      if (step >= 7) return;\n218\t      activityTracker.track(\"checkout_abandon\", {\n219\t        eventId,\n220\t        step,\n221\t        via: \"unload\",\n222\t      });\n223\t    };\n224\t\n225\t    window.addEventListener(\"beforeunload\", handler);\n226\t    return () => window.removeEventListener(\"beforeunload\", handler);\n227\t  }, [open, step, eventId]);\n228\t\n229\t  const handleClose = useCallback(() => {\n230\t    // Step 1 (identify) can have a real backend side effect in flight (an\n231\t    // OTP already sent to the user's email) even though it's the very first\n232\t    // step — worth confirming just like steps 2–4's in-progress selections.\n233\t    if (step === 1 || (step > 1 && step < 5)) {\n234\t      setShowDiscard(true);\n235\t      return;\n236\t    }\n237\t    clearActiveBookingId();\n238\t    dispatch(bookingActions.reset());\n239\t    onClose();\n240\t  }, [step, dispatch, onClose]);\n241\t\n242\t  // Swiping the sheet down is itself a deliberate, committed gesture (same\n243\t  // convention as iOS sheets) — it closes immediately, skipping the discard\n244\t  // confirmation that a backdrop tap or Escape still goes through. Blocked\n245\t  // by canSwipeClose below specifically on step 1 (see handleClose) — every\n246\t  // other step keeps the original \"swipe just closes it\" behavior.\n247\t  const swipeClose = useCallback(() => {\n248\t    activityTracker.track(\"checkout_abandon\", { eventId, step, via: \"swipe\" });\n249\t    // The drag already animated the sheet off-screen — don't replay the\n250\t    // modal's own slide-down/scale-down exit on top of that.\n251\t    modalExit.skipNextExit();\n252\t    clearActiveBookingId();\n253\t    dispatch(bookingActions.reset());\n254\t    onClose();\n255\t  }, [step, dispatch, onClose, eventId, modalExit.skipNextExit]);\n256\t\n257\t  const confirmDiscard = useCallback(() => {\n258\t    setShowDiscard(false);\n259\t    // Track in-modal abandon (user explicitly discarded)\n260\t    activityTracker.track(\"checkout_abandon\", {\n261\t      eventId,\n262\t      step,\n263\t      via: \"discard\",\n264\t    });\n265\t    dispatch(addToast({ message: \"Booking cancelled\", variant: \"info\" }));\n266\t    clearActiveBookingId();\n267\t    dispatch(bookingActions.reset());\n268\t    onClose();\n269\t  }, [dispatch, onClose, eventId, step]);\n270\t\n271\t  // Escape key\n272\t  useEffect(() => {\n273\t    if (!open) return;\n274\t    function onKeyDown(e: KeyboardEvent) {\n275\t      if (e.key === \"Escape\") handleClose();\n276\t    }\n277\t    window.addEventListener(\"keydown\", onKeyDown);\n278\t    return () => window.removeEventListener(\"keydown\", onKeyDown);\n279\t  }, [open, handleClose]);\n280\t\n281\t  // Only step 1 (identify) blocks a direct swipe-close — see handleClose.\n282\t  const canSwipeClose = useCallback(() => step !== 1, [step]);\n283\t\n284\t  // Swipe-to-dismiss on main sheet — closes directly, no discard confirmation\n285\t  // (see swipeClose above), except on steps that need one (see canSwipeClose).\n286\t  const mainDrag = useSheetDismiss({\n287\t    onDismiss: swipeClose,\n288\t    canDismiss: canSwipeClose,\n289\t    onBlocked: handleClose,\n290\t    threshold: 80,\n291\t    scrollRef: sheetRef,\n292\t    dragTargetRef: sheetRef,\n293\t    resetOnUpwardDrag: false,\n294\t    killAnimationOnStart: true,\n295\t    dismissMode: \"slide\",\n296\t  });\n297\t\n298\t  // Swipe-to-dismiss on discard sheet (straight discard)\n299\t  const discardDrag = useSheetDismiss({\n300\t    onDismiss: confirmDiscard,\n301\t    threshold: 64,\n302\t    dragTargetRef: discardSheetRef,\n303\t    resetOnUpwardDrag: false,\n304\t    killAnimationOnStart: true,\n305\t    trackDragY: true,\n306\t    dismissMode: \"slide\",\n307\t  });\n308\t\n309\t  // Stable handlers for stopPropagation / scrim dismiss to avoid recreating\n310\t  // them on every render.\n311\t  const stopPropagation = useCallback(\n312\t    (e: React.SyntheticEvent) => e.stopPropagation(),\n313\t    [],\n314\t  );\n315\t  const closeDiscard = useCallback(() => setShowDiscard(false), []);\n316\t  // Cross-fade only — no transform. A translateX slide here used to fight\n317\t  // the dialog's own height snap: steps vary a lot in content height\n318\t  // (IdentifyStep vs. a long SelectStep list vs. ConfirmStep) and that\n319\t  // resize is un-animated, so a moving element on top of it drew the eye\n320\t  // straight to the jump. A plain opacity ramp is far more forgiving of a\n321\t  // layout shift underneath it.\n322\t  //\n323\t  // Memoized so React only re-invokes it when reducedMotion actually\n324\t  // changes — an inline ref callback gets a new identity every render, and\n325\t  // React re-fires callback refs whenever that identity changes even\n326\t  // without the DOM node itself changing. Un-memoized, that replayed the\n327\t  // fade-in on the already-mounted step body on every unrelated re-render\n328\t  // (e.g. the outer sheet's own entrance finishing).\n329\t  const stepBodyRef = useCallback(\n330\t    (el: HTMLDivElement | null) => {\n331\t      if (!el || reducedMotion) return;\n332\t      el.style.opacity = \"0\";\n333\t      requestAnimationFrame(() => {\n334\t        requestAnimationFrame(() => {\n335\t          el.style.opacity = \"1\";\n336\t        });\n337\t      });\n338\t    },\n339\t    [reducedMotion],\n340\t  );\n341\t  const handleSheetAnimationEnd = useCallback(\n342\t    (e: React.AnimationEvent<HTMLDivElement>) => {\n343\t      modalExit.onAnimationEnd();\n344\t      if (\n345\t        e.animationName === \"modalSlideUp\" ||\n346\t        e.animationName === \"modalScaleUp\"\n347\t      ) {\n348\t        setEntered(true);\n349\t      }\n350\t    },\n351\t    [modalExit.onAnimationEnd],\n352\t  );\n353\t\n354\t  if (!modalExit.mounted) return null;\n355\t\n356\t  return (\n357\t    /* Backdrop */\n358\t    <div\n359\t      // z-[70], not z-50: PWAInstallBanner renders at z-[51] (to sit above\n360\t      // the z-50 nav bar) and can appear ~2.5s after page load. At z-50 this\n361\t      // backdrop sat BELOW that banner, so on iOS Safari a tap meant to\n362\t      // dismiss the modal could silently land on the banner instead — no\n363\t      // close, no discard confirmation, nothing.\n364\t      //\n365\t      // touch-action: manipulation tells the browser this is a single-tap\n366\t      // target — without it, mobile browsers can hold the tap for ~300ms\n367\t      // waiting to see if a second tap arrives (double-tap-to-zoom check)\n368\t      // before firing the click at all, which reads as \"closing the modal\n369\t      // takes forever.\"\n370\t      className=\"fixed inset-0 z-[70] bg-black/70 backdrop-blur-md flex items-end md:items-center justify-center cursor-pointer touch-manipulation\"\n371\t      onClick={handleClose}\n372\t      style={\n373\t        reducedMotion\n374\t          ? undefined\n375\t          : {\n376\t              animation: modalExit.closing\n377\t                ? \"modalFadeOut 0.15s ease-out both\"\n378\t                : \"modalFadeIn 0.15s ease-out both\",\n379\t            }\n380\t      }\n381\t    >\n382\t      <style>{`\n383\t        @keyframes modalFadeIn {\n384\t          from { opacity: 0; }\n385\t          to { opacity: 1; }\n386\t        }\n387\t        @keyframes modalFadeOut {\n388\t          from { opacity: 1; }\n389\t          to { opacity: 0; }\n390\t        }\n391\t        @keyframes modalSlideUp {\n392\t          from { transform: translateY(100%); }\n393\t          to { transform: translateY(0); }\n394\t        }\n395\t        @keyframes modalSlideDown {\n396\t          from { transform: translateY(0); }\n397\t          to { transform: translateY(100%); }\n398\t        }\n399\t        @keyframes modalScaleUp {\n400\t          from { opacity: 0; transform: scale(0.96) translateY(10px); }\n401\t          to { opacity: 1; transform: scale(1) translateY(0); }\n402\t        }\n403\t        @keyframes modalScaleDown {\n404\t          from { opacity: 1; transform: scale(1) translateY(0); }\n405\t          to { opacity: 0; transform: scale(0.96) translateY(10px); }\n406\t        }\n407\t        .animate-modal-entrance {\n408\t          animation: modalSlideUp 0.2s var(--ease-drawer) both;\n409\t        }\n410\t        .animate-modal-exit {\n411\t          animation: modalSlideDown 0.2s var(--ease-drawer) both;\n412\t        }\n413\t        @media (min-width: 768px) {\n414\t          .animate-modal-entrance {\n415\t            animation: modalScaleUp 0.15s var(--ease-drawer) both;\n416\t          }\n417\t          .animate-modal-exit {\n418\t            animation: modalScaleDown 0.15s var(--ease-drawer) both;\n419\t          }\n420\t        }\n421\t        /* Discard confirmation always slides from/to the bottom — no\n422\t           desktop scale variant, unlike the main sheet above. */\n423\t        .animate-discard-entrance {\n424\t          animation: modalSlideUp 0.2s var(--ease-drawer) both;\n425\t        }\n426\t        .animate-discard-exit {\n427\t          animation: modalSlideDown 0.2s var(--ease-drawer) both;\n428\t        }\n429\t      `}</style>\n430\t      {/* ── Sheet / Card ── */}\n431\t      {/* Mobile: bottom sheet, Desktop: centered card. Wrapped in its own\n432\t          relative box (rather than making the scrollable dialog itself the\n433\t          discard overlay's containing block) — an `absolute inset-0` child\n434\t          of a scrolled `overflow-y-auto` element scrolls away with the\n435\t          content, which hid the discard confirmation whenever the sheet\n436\t          body wasn't scrolled to the top. stopPropagation here (not just on\n437\t          the dialog below) — otherwise a tap on the discard sheet (a sibling\n438\t          of the dialog, not a descendant) bubbles straight to the backdrop's\n439\t          onClick and reopens the confirmation it was just trying to close. */}\n440\t      <div\n441\t        className=\"relative w-full md:max-w-[440px]\"\n442\t        onClick={stopPropagation}\n443\t      >\n444\t        <div\n445\t          role=\"dialog\"\n446\t          aria-modal=\"true\"\n447\t          aria-label=\"Book tickets\"\n448\t          className={`\n449\t          w-full\n450\t          min-h-[420px] max-h-[92vh] md:max-h-[88vh]\n451\t          overflow-y-auto overscroll-y-contain\n452\t          bg-[#121212]\n453\t          border border-white/[0.08] shadow-2xl\n454\t          rounded-t-[44px] md:rounded-[44px]\n455\t          flex flex-col\n456\t          relative\n457\t          will-change-transform\n458\t          ${reducedMotion ? \"\" : modalExit.closing ? \"animate-modal-exit\" : entered ? \"\" : \"animate-modal-entrance\"}\n459\t        `}\n460\t          ref={sheetRef}\n461\t          onClick={stopPropagation}\n462\t          onKeyDown={stopPropagation}\n463\t          onAnimationEnd={handleSheetAnimationEnd}\n464\t        >\n465\t          {/* Drag handle — mobile only; touch handlers live here so the sheet body can scroll */}\n466\t          <div\n467\t            aria-hidden=\"true\"\n468\t            onTouchStart={mainDrag.onTouchStart}\n469\t            onTouchMove={mainDrag.onTouchMove}\n470\t            onTouchEnd={mainDrag.onTouchEnd}\n471\t            className=\"md:hidden touch-none w-full pt-3 pb-1 flex items-center justify-center shrink-0 cursor-grab active:cursor-grabbing\"\n472\t          >\n473\t            <div className=\"h-1 w-10 rounded-full bg-white/[0.24]\" />\n474\t          </div>\n475\t\n476\t          {/* Step body — cross-fades between steps. See stepBodyRef above for\n477\t              why this isn't a directional slide. */}\n478\t          <div className=\"px-[27px] pb-8 pt-3 flex-1 flex flex-col\">\n479\t            <div\n480\t              key={step}\n481\t              className={`flex-1 flex flex-col transition-opacity duration-200 ${\n482\t                reducedMotion ? \"\" : \"ease-[var(--ease-emphasized)]\"\n483\t              }`}\n484\t              style={{ opacity: 1 }}\n485\t              ref={stepBodyRef}\n486\t            >\n487\t              {step === 1 && <IdentifyStep />}\n488\t              {step === 2 && <SelectStep eventId={eventId} />}\n489\t              {step === 3 && (\n490\t                <AttendeesStep eventId={eventId} onClose={onClose} />\n491\t              )}\n492\t              {step === 4 && <ReviewStep />}\n493\t              {step === 5 && <PaymentStep onDone={onClose} />}\n494\t              {step === 6 && (\n495\t                <TeamSetupStep eventId={eventId} onClose={onClose} />\n496\t              )}\n497\t              {step === 7 && <ConfirmStep onDone={onClose} />}\n498\t              {step === 8 && <ApprovalSubmittedStep onDone={onClose} />}\n499\t            </div>\n500\t          </div>\n501\t        </div>\n502\t\n503\t        {/* Discard confirmation — inline sheet, always slides from/to the\n504\t            bottom (mobile and desktop alike), never scales like the main\n505\t            sheet. Sibling of the scrollable dialog (not a child) so it isn't\n506\t            subject to the dialog's own scroll position. */}\n507\t        {discardExit.mounted && (\n508\t          <div className=\"absolute inset-0 z-10 rounded-t-[44px] md:rounded-[44px] overflow-hidden flex flex-col justify-end\">\n509\t            {/* scrim — touch-manipulation avoids the same tap-delay as the\n510\t                main backdrop above. */}\n511\t            <div\n512\t              className=\"absolute inset-0 bg-black/40 backdrop-blur-[6px] cursor-pointer touch-manipulation\"\n513\t              onClick={closeDiscard}\n514\t              style={\n515\t                reducedMotion\n516\t                  ? undefined\n517\t                  : {\n518\t                      animation: discardExit.closing\n519\t                        ? \"modalFadeOut 0.15s ease-out both\"\n520\t                        : \"modalFadeIn 0.15s ease-out both\",\n521\t                    }\n522\t              }\n523\t            />\n524\t            {/* sheet — draggable downward to confirm discard. No backdrop-blur\n525\t                here: at 86% opacity almost nothing behind it shows through a\n526\t                blur anyway, but backdrop-filter is one of the most expensive\n527\t                things a mobile GPU can composite — this sheet was mounting\n528\t                on top of the dialog's OWN blur-128px underneath it, so two\n529\t                full-radius blurs were live at once right when the user is\n530\t                waiting for it to appear. */}\n531\t            <div\n532\t              className={`relative z-10 flex flex-col gap-6 px-[27px] pt-7 pb-10 bg-[rgba(20,20,20,0.86)] border-t border-white/[0.06] touch-none will-change-transform ${\n533\t                reducedMotion\n534\t                  ? \"\"\n535\t                  : discardExit.closing\n536\t                    ? \"animate-discard-exit\"\n537\t                    : \"animate-discard-entrance\"\n538\t              }`}\n539\t              ref={discardSheetRef}\n540\t              onTouchStart={discardDrag.onTouchStart}\n541\t              onTouchMove={discardDrag.onTouchMove}\n542\t              onTouchEnd={discardDrag.onTouchEnd}\n543\t              onAnimationEnd={discardExit.onAnimationEnd}\n544\t            >\n545\t              {/* pull indicator — brightens as user drags */}\n546\t              <div\n547\t                className=\"mx-auto h-[3px] w-9 rounded-full transition-colors duration-100 ease-out\"\n548\t                style={{\n549\t                  backgroundColor: `rgba(255,255,255,${0.18 + Math.min(discardDrag.dragY / 64, 1) * 0.5})`,\n550\t                }}\n551\t              />\n552\t\n553\t              {/* text */}\n554\t              <div className=\"flex flex-col gap-2\">\n555\t                <p className=\"text-h3 font-semibold text-white tracking-[-0.04em]\">\n556\t                  Discard booking?\n557\t                </p>\n558\t                <p className=\"text-p1 font-normal text-white/40 tracking-[-0.02em] leading-relaxed\">\n559\t                  Your progress will be lost. You&apos;ll need to start the\n560\t                  booking again.\n561\t                </p>\n562\t              </div>\n563\t\n564\t              {/* divider */}\n565\t              <div className=\"h-px bg-white/[0.06]\" />\n566\t\n567\t              {/* actions */}\n568\t              <div className=\"flex flex-col gap-2\">\n569\t                <button\n570\t                  type=\"button\"\n571\t                  onClick={closeDiscard}\n572\t                  className=\"w-full h-12 rounded-2xl bg-white text-black font-semibold text-p1 tracking-[-0.02em] transition-[opacity,transform] duration-150 ease-out active:opacity-70 active:scale-[0.97]\"\n573\t                >\n574\t                  Keep booking\n575\t                </button>\n576\t                <button\n577\t                  type=\"button\"\n578\t                  onClick={confirmDiscard}\n579\t                  className=\"w-full h-12 rounded-2xl bg-transparent text-white/40 font-medium text-p1 tracking-[-0.02em] transition-[opacity,transform] duration-150 ease-out active:opacity-70 active:scale-[0.97]\"\n580\t                >\n581\t                  Discard\n582\t                </button>\n583\t              </div>\n584\t            </div>\n585\t          </div>\n586\t        )}\n587\t      </div>\n588\t    </div>\n589\t  );\n590\t}\n591\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"e1b7a4e7-6e59-49c9-aef3-57fe5fb8a18e","timestamp":"2026-11-20T17:34:25.768Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/components/booking/BookingModal.tsx","content":"\"use client\";\n\nimport dynamic from \"next/dynamic\";\nimport { useCallback, useEffect, useRef, useState } from \"react\";\nimport { useReducedMotion } from \"@/hooks/useReducedMotion\";\nimport { useSheetDismiss } from \"@/hooks/useSheetDismiss\";\nimport { activityTracker } from \"@/lib/analytics/activity-tracker\";\nimport { clearActiveBookingId } from \"@/lib/booking/session-storage\";\nimport { loadRazorpay } from \"@/lib/razorpay/loader\";\nimport { addToast } from \"@/lib/redux\";\nimport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\nimport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n// Main-path steps stay static. Every booking moves through these in order, so\n// code-splitting them only adds a chunk-fetch latency penalty on the critical\n// path (and risks blank-screen flashes on slow networks / cold dev compiles).\nimport ApprovalSubmittedStep from \"./steps/ApprovalSubmittedStep\";\nimport AttendeesStep from \"./steps/AttendeesStep\";\nimport ConfirmStep from \"./steps/ConfirmStep\";\nimport IdentifyStep from \"./steps/IdentifyStep\";\nimport PaymentStep from \"./steps/PaymentStep\";\nimport ReviewStep from \"./steps/ReviewStep\";\nimport SelectStep from \"./steps/SelectStep\";\n\n// TeamSetupStep is a real branch — only reached when the user is booking\n// team tickets. Code-split it to keep its form deps out of the solo-booking\n// initial bundle.\nconst TeamSetupStep = dynamic(() => import(\"./steps/TeamSetupStep\"), {\n  ssr: false,\n  loading: () => null,\n});\n\n// ─── useMountedWithExit ───────────────────────────────────────────────────────\n// Keeps a sheet mounted for `exitDurationMs` after `isOpen` flips false so its\n// exit keyframes can play instead of an instant unmount. `onAnimationEnd`\n// (wired to the animating element) ends it early; the timeout is a fallback\n// in case the animationend event doesn't fire.\n\nfunction useMountedWithExit(\n  isOpen: boolean,\n  reducedMotion: boolean,\n  exitDurationMs = 220,\n) {\n  const [mounted, setMounted] = useState(isOpen);\n  const [closing, setClosing] = useState(false);\n  const fallbackRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n  const wasOpenRef = useRef(isOpen);\n  // Set right before an already-animated close (e.g. a swipe-to-dismiss that\n  // finished its own off-screen slide) calls back into `isOpen=false`, so\n  // this hook unmounts immediately instead of replaying its own exit\n  // keyframes on top of a transform the drag already resolved — otherwise\n  // the two animations fight over the same `transform` and the sheet visibly\n  // snaps back into place before sliding out a second time.\n  const skipExitRef = useRef(false);\n\n  useEffect(() => {\n    const wasOpen = wasOpenRef.current;\n    wasOpenRef.current = isOpen;\n\n    if (isOpen) {\n      if (fallbackRef.current) {\n        clearTimeout(fallbackRef.current);\n        fallbackRef.current = null;\n      }\n      setMounted(true);\n      setClosing(false);\n      return;\n    }\n\n    if (!wasOpen) return;\n    if (reducedMotion || skipExitRef.current) {\n      skipExitRef.current = false;\n      setMounted(false);\n      setClosing(false);\n      return;\n    }\n    setClosing(true);\n    fallbackRef.current = setTimeout(() => {\n      setMounted(false);\n      setClosing(false);\n    }, exitDurationMs);\n  }, [isOpen, reducedMotion, exitDurationMs]);\n\n  useEffect(\n    () => () => {\n      if (fallbackRef.current) clearTimeout(fallbackRef.current);\n    },\n    [],\n  );\n\n  const onAnimationEnd = useCallback(() => {\n    if (!closing) return;\n    if (fallbackRef.current) {\n      clearTimeout(fallbackRef.current);\n      fallbackRef.current = null;\n    }\n    setMounted(false);\n    setClosing(false);\n  }, [closing]);\n\n  const skipNextExit = useCallback(() => {\n    skipExitRef.current = true;\n  }, []);\n\n  return { mounted, closing, onAnimationEnd, skipNextExit };\n}\n\n// ─── BookingModal ─────────────────────────────────────────────────────────────\n\ninterface BookingModalProps {\n  open: boolean;\n  onClose: () => void;\n  eventId: string;\n}\n\nexport default function BookingModal({\n  open,\n  onClose,\n  eventId,\n}: BookingModalProps) {\n  const dispatch = useAppDispatch();\n  const step = useAppSelector((s) => s.booking.step);\n  const reducedMotion = useReducedMotion();\n  const [showDiscard, setShowDiscard] = useState(false);\n  const [entered, setEntered] = useState(reducedMotion);\n  const sheetRef = useRef<HTMLDivElement>(null);\n  const discardSheetRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (reducedMotion) setEntered(true);\n  }, [reducedMotion]);\n\n  // SelectStep set a page-level \"team join dialog\" flag — close ourselves\n  // without the discard confirmation so the booking flow doesn't trap the\n  // user when they decide to switch to joining an existing team.\n  const teamJoinDialogOpen = useAppSelector((s) => s.ui.teamJoinDialogOpen);\n\n  // Close animations: don't unmount the instant `open`/`showDiscard` flips\n  // false — play the reverse keyframes and only unmount once they finish.\n  const modalExit = useMountedWithExit(open, reducedMotion);\n  const discardExit = useMountedWithExit(showDiscard, reducedMotion);\n\n  // Close ourselves when the join-by-code dialog is requested from inside\n  // the booking flow. Done after `modalExit` so we can use `skipNextExit`\n  // to suppress the slide-down animation that would otherwise compete with\n  // the join dialog's own entrance.\n  useEffect(() => {\n    if (!open) return;\n    if (!teamJoinDialogOpen) return;\n    clearActiveBookingId();\n    dispatch(bookingActions.reset());\n    modalExit.skipNextExit();\n    onClose();\n  }, [teamJoinDialogOpen, open, dispatch, onClose, modalExit]);\n\n  // Body scroll lock\n  useEffect(() => {\n    if (!open) return;\n    const prev = document.body.style.overflow;\n    document.body.style.overflow = \"hidden\";\n    return () => {\n      document.body.style.overflow = prev;\n    };\n  }, [open]);\n\n  // Start loading the Razorpay script as soon as the modal opens for paid flows\n  // so it's ready by the time the user reaches the payment step. Skip free/RSVP\n  // flows — they never reach Razorpay and loading it there would waste bandwidth.\n  const bookingMode = useAppSelector((s) => s.booking.mode);\n  useEffect(() => {\n    if (!open) return;\n    if (bookingMode === \"free\" || bookingMode === \"rsvp\") return;\n    loadRazorpay().catch(() => {});\n  }, [open, bookingMode]);\n\n  // Analytics: emit checkout_step on step changes (checkout_start fires from\n  // the event page CTA that opens this modal — see EventPageClient onBuy)\n  const prevStepRef = useRef(0);\n  const STEP_NAMES: Record<number, string> = {\n    1: \"identify\",\n    2: \"select\",\n    3: \"attendees\",\n    4: \"review\",\n    5: \"payment\",\n    6: \"team_setup\",\n    7: \"confirm\",\n    8: \"approval_submitted\",\n  };\n  useEffect(() => {\n    // Track each step transition\n    if (open && step !== prevStepRef.current && step > 0) {\n      const stepName = STEP_NAMES[step] ?? `step_${step}`;\n      activityTracker.track(\"checkout_step\", {\n        eventId,\n        step,\n        stepName,\n      });\n\n      // Reached the payment step (5) then navigated back — a strong drop-off\n      // signal distinct from a full checkout_abandon.\n      if (prevStepRef.current === 5 && step < 5) {\n        activityTracker.track(\"back_from_payment\", {\n          eventId,\n          toStep: step,\n        });\n      }\n    }\n    prevStepRef.current = step;\n  }, [open, step, eventId]);\n\n  // Emit checkout_abandon on tab close / refresh if booking not yet paid\n  useEffect(() => {\n    if (!open) return;\n\n    const handler = () => {\n      // Only skip once the booking is fully complete (step 7 = ConfirmStep, step 8 = ApprovalSubmitted).\n      // Steps 1–6 (including payment step 5) are still in-progress and should be counted as abandoned.\n      if (step >= 7) return;\n      activityTracker.track(\"checkout_abandon\", {\n        eventId,\n        step,\n        via: \"unload\",\n      });\n    };\n\n    window.addEventListener(\"beforeunload\", handler);\n    return () => window.removeEventListener(\"beforeunload\", handler);\n  }, [open, step, eventId]);\n\n  const handleClose = useCallback(() => {\n    // Step 1 (identify) can have a real backend side effect in flight (an\n    // OTP already sent to the user's email) even though it's the very first\n    // step — worth confirming just like steps 2–4's in-progress selections.\n    if (step === 1 || (step > 1 && step < 5)) {\n      setShowDiscard(true);\n      return;\n    }\n    clearActiveBookingId();\n    dispatch(bookingActions.reset());\n    onClose();\n  }, [step, dispatch, onClose]);\n\n  // Swiping the sheet down is itself a deliberate, committed gesture (same\n  // convention as iOS sheets) — it closes immediately, skipping the discard\n  // confirmation that a backdrop tap or Escape still goes through. Blocked\n  // by canSwipeClose below specifically on step 1 (see handleClose) — every\n  // other step keeps the original \"swipe just closes it\" behavior.\n  const swipeClose = useCallback(() => {\n    activityTracker.track(\"checkout_abandon\", { eventId, step, via: \"swipe\" });\n    // The drag already animated the sheet off-screen — don't replay the\n    // modal's own slide-down/scale-down exit on top of that.\n    modalExit.skipNextExit();\n    clearActiveBookingId();\n    dispatch(bookingActions.reset());\n    onClose();\n  }, [step, dispatch, onClose, eventId, modalExit.skipNextExit]);\n\n  const confirmDiscard = useCallback(() => {\n    setShowDiscard(false);\n    // Track in-modal abandon (user explicitly discarded)\n    activityTracker.track(\"checkout_abandon\", {\n      eventId,\n      step,\n      via: \"discard\",\n    });\n    dispatch(addToast({ message: \"Booking cancelled\", variant: \"info\" }));\n    clearActiveBookingId();\n    dispatch(bookingActions.reset());\n    onClose();\n  }, [dispatch, onClose, eventId, step]);\n\n  // Escape key\n  useEffect(() => {\n    if (!open) return;\n    function onKeyDown(e: KeyboardEvent) {\n      if (e.key === \"Escape\") handleClose();\n    }\n    window.addEventListener(\"keydown\", onKeyDown);\n    return () => window.removeEventListener(\"keydown\", onKeyDown);\n  }, [open, handleClose]);\n\n  // Only step 1 (identify) blocks a direct swipe-close — see handleClose.\n  const canSwipeClose = useCallback(() => step !== 1, [step]);\n\n  // Swipe-to-dismiss on main sheet — closes directly, no discard confirmation\n  // (see swipeClose above), except on steps that need one (see canSwipeClose).\n  const mainDrag = useSheetDismiss({\n    onDismiss: swipeClose,\n    canDismiss: canSwipeClose,\n    onBlocked: handleClose,\n    threshold: 80,\n    scrollRef: sheetRef,\n    dragTargetRef: sheetRef,\n    resetOnUpwardDrag: false,\n    killAnimationOnStart: true,\n    dismissMode: \"slide\",\n  });\n\n  // Swipe-to-dismiss on discard sheet (straight discard)\n  const discardDrag = useSheetDismiss({\n    onDismiss: confirmDiscard,\n    threshold: 64,\n    dragTargetRef: discardSheetRef,\n    resetOnUpwardDrag: false,\n    killAnimationOnStart: true,\n    trackDragY: true,\n    dismissMode: \"slide\",\n  });\n\n  // Stable handlers for stopPropagation / scrim dismiss to avoid recreating\n  // them on every render.\n  const stopPropagation = useCallback(\n    (e: React.SyntheticEvent) => e.stopPropagation(),\n    [],\n  );\n  const closeDiscard = useCallback(() => setShowDiscard(false), []);\n  // Cross-fade only — no transform. A translateX slide here used to fight\n  // the dialog's own height snap: steps vary a lot in content height\n  // (IdentifyStep vs. a long SelectStep list vs. ConfirmStep) and that\n  // resize is un-animated, so a moving element on top of it drew the eye\n  // straight to the jump. A plain opacity ramp is far more forgiving of a\n  // layout shift underneath it.\n  //\n  // Memoized so React only re-invokes it when reducedMotion actually\n  // changes — an inline ref callback gets a new identity every render, and\n  // React re-fires callback refs whenever that identity changes even\n  // without the DOM node itself changing. Un-memoized, that replayed the\n  // fade-in on the already-mounted step body on every unrelated re-render\n  // (e.g. the outer sheet's own entrance finishing).\n  const stepBodyRef = useCallback(\n    (el: HTMLDivElement | null) => {\n      if (!el || reducedMotion) return;\n      el.style.opacity = \"0\";\n      requestAnimationFrame(() => {\n        requestAnimationFrame(() => {\n          el.style.opacity = \"1\";\n        });\n      });\n    },\n    [reducedMotion],\n  );\n  const handleSheetAnimationEnd = useCallback(\n    (e: React.AnimationEvent<HTMLDivElement>) => {\n      modalExit.onAnimationEnd();\n      if (\n        e.animationName === \"modalSlideUp\" ||\n        e.animationName === \"modalScaleUp\"\n      ) {\n        setEntered(true);\n      }\n    },\n    [modalExit.onAnimationEnd],\n  );\n\n  if (!modalExit.mounted) return null;\n\n  return (\n    /* Backdrop */\n    <div\n      // z-[70], not z-50: PWAInstallBanner renders at z-[51] (to sit above\n      // the z-50 nav bar) and can appear ~2.5s after page load. At z-50 this\n      // backdrop sat BELOW that banner, so on iOS Safari a tap meant to\n      // dismiss the modal could silently land on the banner instead — no\n      // close, no discard confirmation, nothing.\n      //\n      // touch-action: manipulation tells the browser this is a single-tap\n      // target — without it, mobile browsers can hold the tap for ~300ms\n      // waiting to see if a second tap arrives (double-tap-to-zoom check)\n      // before firing the click at all, which reads as \"closing the modal\n      // takes forever.\"\n      className=\"fixed inset-0 z-[70] bg-black/70 backdrop-blur-md flex items-end md:items-center justify-center cursor-pointer touch-manipulation\"\n      onClick={handleClose}\n      style={\n        reducedMotion\n          ? undefined\n          : {\n              animation: modalExit.closing\n                ? \"modalFadeOut 0.15s ease-out both\"\n                : \"modalFadeIn 0.15s ease-out both\",\n            }\n      }\n    >\n      <style>{`\n        @keyframes modalFadeIn {\n          from { opacity: 0; }\n          to { opacity: 1; }\n        }\n        @keyframes modalFadeOut {\n          from { opacity: 1; }\n          to { opacity: 0; }\n        }\n        @keyframes modalSlideUp {\n          from { transform: translateY(100%); }\n          to { transform: translateY(0); }\n        }\n        @keyframes modalSlideDown {\n          from { transform: translateY(0); }\n          to { transform: translateY(100%); }\n        }\n        @keyframes modalScaleUp {\n          from { opacity: 0; transform: scale(0.96) translateY(10px); }\n          to { opacity: 1; transform: scale(1) translateY(0); }\n        }\n        @keyframes modalScaleDown {\n          from { opacity: 1; transform: scale(1) translateY(0); }\n          to { opacity: 0; transform: scale(0.96) translateY(10px); }\n        }\n        .animate-modal-entrance {\n          animation: modalSlideUp 0.2s var(--ease-drawer) both;\n        }\n        .animate-modal-exit {\n          animation: modalSlideDown 0.2s var(--ease-drawer) both;\n        }\n        @media (min-width: 768px) {\n          .animate-modal-entrance {\n            animation: modalScaleUp 0.15s var(--ease-drawer) both;\n          }\n          .animate-modal-exit {\n            animation: modalScaleDown 0.15s var(--ease-drawer) both;\n          }\n        }\n        /* Discard confirmation always slides from/to the bottom — no\n           desktop scale variant, unlike the main sheet above. */\n        .animate-discard-entrance {\n          animation: modalSlideUp 0.2s var(--ease-drawer) both;\n        }\n        .animate-discard-exit {\n          animation: modalSlideDown 0.2s var(--ease-drawer) both;\n        }\n      `}</style>\n      {/* ── Sheet / Card ── */}\n      {/* Mobile: bottom sheet, Desktop: centered card. Wrapped in its own\n          relative box (rather than making the scrollable dialog itself the\n          discard overlay's containing block) — an `absolute inset-0` child\n          of a scrolled `overflow-y-auto` element scrolls away with the\n          content, which hid the discard confirmation whenever the sheet\n          body wasn't scrolled to the top. stopPropagation here (not just on\n          the dialog below) — otherwise a tap on the discard sheet (a sibling\n          of the dialog, not a descendant) bubbles straight to the backdrop's\n          onClick and reopens the confirmation it was just trying to close. */}\n      <div\n        className=\"relative w-full md:max-w-[440px]\"\n        onClick={stopPropagation}\n      >\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label=\"Book tickets\"\n          className={`\n          w-full\n          min-h-[420px] max-h-[92vh] md:max-h-[88vh]\n          overflow-y-auto overscroll-y-contain\n          bg-[#121212]\n          border border-white/[0.08] shadow-2xl\n          rounded-t-[44px] md:rounded-[44px]\n          flex flex-col\n          relative\n          will-change-transform\n          ${reducedMotion ? \"\" : modalExit.closing ? \"animate-modal-exit\" : entered ? \"\" : \"animate-modal-entrance\"}\n        `}\n          ref={sheetRef}\n          onClick={stopPropagation}\n          onKeyDown={stopPropagation}\n          onAnimationEnd={handleSheetAnimationEnd}\n        >\n          {/* Drag handle — mobile only; touch handlers live here so the sheet body can scroll */}\n          <div\n            aria-hidden=\"true\"\n            onTouchStart={mainDrag.onTouchStart}\n            onTouchMove={mainDrag.onTouchMove}\n            onTouchEnd={mainDrag.onTouchEnd}\n            className=\"md:hidden touch-none w-full pt-3 pb-1 flex items-center justify-center shrink-0 cursor-grab active:cursor-grabbing\"\n          >\n            <div className=\"h-1 w-10 rounded-full bg-white/[0.24]\" />\n          </div>\n\n          {/* Step body — cross-fades between steps. See stepBodyRef above for\n              why this isn't a directional slide. */}\n          <div className=\"px-[27px] pb-8 pt-3 flex-1 flex flex-col\">\n            <div\n              key={step}\n              className={`flex-1 flex flex-col transition-opacity duration-200 ${\n                reducedMotion ? \"\" : \"ease-[var(--ease-emphasized)]\"\n              }`}\n              style={{ opacity: 1 }}\n              ref={stepBodyRef}\n            >\n              {step === 1 && <IdentifyStep />}\n              {step === 2 && <SelectStep eventId={eventId} />}\n              {step === 3 && (\n                <AttendeesStep eventId={eventId} onClose={onClose} />\n              )}\n              {step === 4 && <ReviewStep />}\n              {step === 5 && <PaymentStep onDone={onClose} />}\n              {step === 6 && (\n                <TeamSetupStep eventId={eventId} onClose={onClose} />\n              )}\n              {step === 7 && <ConfirmStep onDone={onClose} />}\n              {step === 8 && <ApprovalSubmittedStep onDone={onClose} />}\n            </div>\n          </div>\n        </div>\n\n        {/* Discard confirmation — inline sheet, always slides from/to the\n            bottom (mobile and desktop alike), never scales like the main\n            sheet. Sibling of the scrollable dialog (not a child) so it isn't\n            subject to the dialog's own scroll position. */}\n        {discardExit.mounted && (\n          <div className=\"absolute inset-0 z-10 rounded-t-[44px] md:rounded-[44px] overflow-hidden flex flex-col justify-end\">\n            {/* scrim — touch-manipulation avoids the same tap-delay as the\n                main backdrop above. */}\n            <div\n              className=\"absolute inset-0 bg-black/40 backdrop-blur-[6px] cursor-pointer touch-manipulation\"\n              onClick={closeDiscard}\n              style={\n                reducedMotion\n                  ? undefined\n                  : {\n                      animation: discardExit.closing\n                        ? \"modalFadeOut 0.15s ease-out both\"\n                        : \"modalFadeIn 0.15s ease-out both\",\n                    }\n              }\n            />\n            {/* sheet — draggable downward to confirm discard. No backdrop-blur\n                here: at 86% opacity almost nothing behind it shows through a\n                blur anyway, but backdrop-filter is one of the most expensive\n                things a mobile GPU can composite — this sheet was mounting\n                on top of the dialog's OWN blur-128px underneath it, so two\n                full-radius blurs were live at once right when the user is\n                waiting for it to appear. */}\n            <div\n              className={`relative z-10 flex flex-col gap-6 px-[27px] pt-7 pb-10 bg-[rgba(20,20,20,0.86)] border-t border-white/[0.06] touch-none will-change-transform ${\n                reducedMotion\n                  ? \"\"\n                  : discardExit.closing\n                    ? \"animate-discard-exit\"\n                    : \"animate-discard-entrance\"\n              }`}\n              ref={discardSheetRef}\n              onTouchStart={discardDrag.onTouchStart}\n              onTouchMove={discardDrag.onTouchMove}\n              onTouchEnd={discardDrag.onTouchEnd}\n              onAnimationEnd={discardExit.onAnimationEnd}\n            >\n              {/* pull indicator — brightens as user drags */}\n              <div\n                className=\"mx-auto h-[3px] w-9 rounded-full transition-colors duration-100 ease-out\"\n                style={{\n                  backgroundColor: `rgba(255,255,255,${0.18 + Math.min(discardDrag.dragY / 64, 1) * 0.5})`,\n                }}\n              />\n\n              {/* text */}\n              <div className=\"flex flex-col gap-2\">\n                <p className=\"text-h3 font-semibold text-white tracking-[-0.04em]\">\n                  Discard booking?\n                </p>\n                <p className=\"text-p1 font-normal text-white/40 tracking-[-0.02em] leading-relaxed\">\n                  Your progress will be lost. You&apos;ll need to start the\n                  booking again.\n                </p>\n              </div>\n\n              {/* divider */}\n              <div className=\"h-px bg-white/[0.06]\" />\n\n              {/* actions */}\n              <div className=\"flex flex-col gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={closeDiscard}\n                  className=\"w-full h-12 rounded-2xl bg-white text-black font-semibold text-p1 tracking-[-0.02em] transition-[opacity,transform] duration-150 ease-out active:opacity-70 active:scale-[0.97]\"\n                >\n                  Keep booking\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={confirmDiscard}\n                  className=\"w-full h-12 rounded-2xl bg-transparent text-white/40 font-medium text-p1 tracking-[-0.02em] transition-[opacity,transform] duration-150 ease-out active:opacity-70 active:scale-[0.97]\"\n                >\n                  Discard\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n","numLines":591,"startLine":1,"totalLines":591}},"tool_result_meta":[{"id":"call-aeb57534-af3c-43e6-9d8a-a3088742e07a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
