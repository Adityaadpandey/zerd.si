{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-f7bf5e17-90a8-4942-81b7-f359cb08f076","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { animate } from \"framer-motion\";\n4\timport { useRouter } from \"next/navigation\";\n5\timport { useEffect, useRef, useState } from \"react\";\n6\timport { usePushSubscription } from \"@/hooks/usePushSubscription\";\n7\timport { useReducedMotion } from \"@/hooks/useReducedMotion\";\n8\timport { clearActiveBookingId } from \"@/lib/booking/session-storage\";\n9\timport { DELIGHT_SPRING } from \"@/lib/motion/springs\";\n10\timport { useConfirmFreeBookingMutation } from \"@/lib/redux/api/bookingsApi\";\n11\timport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\n12\timport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n13\t\n14\tinterface ConfirmStepProps {\n15\t  onDone: () => void;\n16\t}\n17\t\n18\ttype Status = \"confirm\" | \"loading\" | \"error\";\n19\t\n20\t// ─── Icons ────────────────────────────────────────────────────────────────────\n21\t\n22\tfunction CalendarCheckIcon() {\n23\t  return (\n24\t    <svg\n25\t      width=\"28\"\n26\t      height=\"28\"\n27\t      viewBox=\"0 0 28 28\"\n28\t      fill=\"none\"\n29\t      aria-hidden=\"true\"\n30\t    >\n31\t      <rect\n32\t        x=\"3\"\n33\t        y=\"5\"\n34\t        width=\"22\"\n35\t        height=\"20\"\n36\t        rx=\"3\"\n37\t        stroke=\"white\"\n38\t        strokeWidth=\"1.5\"\n39\t        strokeOpacity=\"0.8\"\n40\t      />\n41\t      <path d=\"M3 11h22\" stroke=\"white\" strokeWidth=\"1.5\" strokeOpacity=\"0.8\" />\n42\t      <path\n43\t        d=\"M9 3v4M19 3v4\"\n44\t        stroke=\"white\"\n45\t        strokeWidth=\"1.5\"\n46\t        strokeLinecap=\"round\"\n47\t        strokeOpacity=\"0.8\"\n48\t      />\n49\t      <path\n50\t        d=\"M9.5 18l3 3 6-6\"\n51\t        stroke=\"white\"\n52\t        strokeWidth=\"1.5\"\n53\t        strokeLinecap=\"round\"\n54\t        strokeLinejoin=\"round\"\n55\t        strokeOpacity=\"0.8\"\n56\t      />\n57\t    </svg>\n58\t  );\n59\t}\n60\t\n61\tfunction TicketIcon() {\n62\t  return (\n63\t    <svg\n64\t      width=\"28\"\n65\t      height=\"28\"\n66\t      viewBox=\"0 0 28 28\"\n67\t      fill=\"none\"\n68\t      aria-hidden=\"true\"\n69\t    >\n70\t      <path\n71\t        d=\"M3 10a2 2 0 0 1 2-2h18a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4v-2Z\"\n72\t        stroke=\"white\"\n73\t        strokeWidth=\"1.5\"\n74\t        strokeOpacity=\"0.8\"\n75\t      />\n76\t      <path\n77\t        d=\"M16 8v12\"\n78\t        stroke=\"white\"\n79\t        strokeWidth=\"1.5\"\n80\t        strokeDasharray=\"2 2\"\n81\t        strokeOpacity=\"0.5\"\n82\t      />\n83\t    </svg>\n84\t  );\n85\t}\n86\t\n87\t// ─── ConfirmStep ──────────────────────────────────────────────────────────────\n88\t\n89\texport default function ConfirmStep({ onDone }: ConfirmStepProps) {\n90\t  const router = useRouter();\n91\t  const dispatch = useAppDispatch();\n92\t  const mode = useAppSelector((s) => s.booking.mode);\n93\t  const bookingId = useAppSelector((s) => s.booking.bookingId);\n94\t  const token = useAppSelector((s) => s.auth.token);\n95\t  const [status, setStatus] = useState<Status>(\"confirm\");\n96\t  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n97\t  const [confirmFreeBooking] = useConfirmFreeBookingMutation();\n98\t  const push = usePushSubscription();\n99\t  const reducedMotion = useReducedMotion();\n100\t  const iconRef = useRef<HTMLDivElement>(null);\n101\t\n102\t  const isRsvp = mode === \"rsvp\";\n103\t\n104\t  // Rare, first-time-per-booking celebratory moment — pop the header icon\n105\t  // in with the same delight spring used for likes/bookmarks/gallery opens\n106\t  // elsewhere in the app, instead of it appearing instantly.\n107\t  useEffect(() => {\n108\t    const el = iconRef.current;\n109\t    if (!el || reducedMotion) return;\n110\t    el.style.opacity = \"0\";\n111\t    el.style.transform = \"scale(0.9)\";\n112\t    const controls = animate(0, 1, {\n113\t      ...DELIGHT_SPRING,\n114\t      onUpdate: (v) => {\n115\t        el.style.opacity = String(v);\n116\t        el.style.transform = `scale(${0.9 + v * 0.1})`;\n117\t      },\n118\t    });\n119\t    return () => controls.stop();\n120\t  }, [reducedMotion]);\n121\t\n122\t  async function handleConfirm() {\n123\t    if (!bookingId) return;\n124\t    if (token) {\n125\t      void push.requestPermissionAndSubscribe(token).catch(() => {});\n126\t    }\n127\t    const id = bookingId;\n128\t    setStatus(\"loading\");\n129\t    setErrorMsg(null);\n130\t    try {\n131\t      await confirmFreeBooking(id).unwrap();\n132\t      clearActiveBookingId();\n133\t      dispatch(bookingActions.reset());\n134\t      onDone();\n135\t      router.push(`/booking/success?ticketId=${id}&mode=${mode}`);\n136\t    } catch (err: unknown) {\n137\t      const e = err as { data?: { message?: string } };\n138\t      setErrorMsg(\n139\t        e?.data?.message ??\n140\t          \"Couldn't confirm your registration — please try again.\",\n141\t      );\n142\t      setStatus(\"error\");\n143\t    }\n144\t  }\n145\t\n146\t  return (\n147\t    <div className=\"flex-1 flex flex-col\">\n148\t      {/* Header */}\n149\t      <div className=\"flex flex-col gap-3 pt-2\">\n150\t        <div className=\"flex items-center gap-3\">\n151\t          <div ref={iconRef}>\n152\t            {isRsvp ? <CalendarCheckIcon /> : <TicketIcon />}\n153\t          </div>\n154\t          <div className=\"flex flex-col gap-0.5\">\n155\t            <p className=\"text-[11px] font-medium text-white/50 uppercase tracking-widest\">\n156\t              {isRsvp ? \"Free Event\" : \"Free Tickets\"}\n157\t            </p>\n158\t            <p className=\"text-h3 font-semibold text-white tracking-[-0.04em] leading-[1.1]\">\n159\t              {isRsvp ? \"Reserve your spot\" : \"Grab your ticket\"}\n160\t            </p>\n161\t          </div>\n162\t        </div>\n163\t\n164\t        <p className=\"text-p1 text-white/40 tracking-[-0.02em] leading-relaxed\">\n165\t          {isRsvp\n166\t            ? \"One tap and you're in. No payment needed.\"\n167\t            : \"Claim your free ticket instantly. Your QR code will be waiting in the tickets section.\"}\n168\t        </p>\n169\t      </div>\n170\t\n171\t      {/* Spacer */}\n172\t      <div className=\"flex-1\" />\n173\t\n174\t      {/* Error */}\n175\t      {status === \"error\" && errorMsg && (\n176\t        <p className=\"text-p2 text-red-400 tracking-[-0.02em] mb-3\">\n177\t          {errorMsg}\n178\t        </p>\n179\t      )}\n180\t\n181\t      {/* Divider */}\n182\t      <div className=\"h-px bg-white/[0.06] mb-6\" />\n183\t\n184\t      {/* CTA */}\n185\t      <button\n186\t        type=\"button\"\n187\t        onClick={handleConfirm}\n188\t        disabled={status === \"loading\"}\n189\t        className=\"\n190\t          w-full h-12 rounded-2xl\n191\t          bg-white text-black\n192\t          font-semibold text-p1 tracking-[-0.02em]\n193\t          transition-[opacity,transform] duration-150 ease-out\n194\t          active:opacity-70 active:scale-[0.97]\n195\t          disabled:opacity-50\n196\t          flex items-center justify-center gap-2\n197\t        \"\n198\t      >\n199\t        {status === \"loading\" ? (\n200\t          <svg\n201\t            className=\"size-4 animate-spin\"\n202\t            viewBox=\"0 0 16 16\"\n203\t            fill=\"none\"\n204\t            aria-hidden=\"true\"\n205\t          >\n206\t            <circle\n207\t              cx=\"8\"\n208\t              cy=\"8\"\n209\t              r=\"6\"\n210\t              stroke=\"black\"\n211\t              strokeWidth=\"2\"\n212\t              strokeOpacity=\"0.3\"\n213\t            />\n214\t            <path\n215\t              d=\"M8 2a6 6 0 0 1 6 6\"\n216\t              stroke=\"black\"\n217\t              strokeWidth=\"2\"\n218\t              strokeLinecap=\"round\"\n219\t            />\n220\t          </svg>\n221\t        ) : isRsvp ? (\n222\t          \"Confirm RSVP\"\n223\t        ) : (\n224\t          \"Claim ticket\"\n225\t        )}\n226\t      </button>\n227\t    </div>\n228\t  );\n229\t}\n230\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"ad7fc753-9a94-43d4-b6cb-ff00110c709c","timestamp":"2026-11-20T17:34:48.409Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/components/booking/steps/ConfirmStep.tsx","content":"\"use client\";\n\nimport { animate } from \"framer-motion\";\nimport { useRouter } from \"next/navigation\";\nimport { useEffect, useRef, useState } from \"react\";\nimport { usePushSubscription } from \"@/hooks/usePushSubscription\";\nimport { useReducedMotion } from \"@/hooks/useReducedMotion\";\nimport { clearActiveBookingId } from \"@/lib/booking/session-storage\";\nimport { DELIGHT_SPRING } from \"@/lib/motion/springs\";\nimport { useConfirmFreeBookingMutation } from \"@/lib/redux/api/bookingsApi\";\nimport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\nimport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n\ninterface ConfirmStepProps {\n  onDone: () => void;\n}\n\ntype Status = \"confirm\" | \"loading\" | \"error\";\n\n// ─── Icons ────────────────────────────────────────────────────────────────────\n\nfunction CalendarCheckIcon() {\n  return (\n    <svg\n      width=\"28\"\n      height=\"28\"\n      viewBox=\"0 0 28 28\"\n      fill=\"none\"\n      aria-hidden=\"true\"\n    >\n      <rect\n        x=\"3\"\n        y=\"5\"\n        width=\"22\"\n        height=\"20\"\n        rx=\"3\"\n        stroke=\"white\"\n        strokeWidth=\"1.5\"\n        strokeOpacity=\"0.8\"\n      />\n      <path d=\"M3 11h22\" stroke=\"white\" strokeWidth=\"1.5\" strokeOpacity=\"0.8\" />\n      <path\n        d=\"M9 3v4M19 3v4\"\n        stroke=\"white\"\n        strokeWidth=\"1.5\"\n        strokeLinecap=\"round\"\n        strokeOpacity=\"0.8\"\n      />\n      <path\n        d=\"M9.5 18l3 3 6-6\"\n        stroke=\"white\"\n        strokeWidth=\"1.5\"\n        strokeLinecap=\"round\"\n        strokeLinejoin=\"round\"\n        strokeOpacity=\"0.8\"\n      />\n    </svg>\n  );\n}\n\nfunction TicketIcon() {\n  return (\n    <svg\n      width=\"28\"\n      height=\"28\"\n      viewBox=\"0 0 28 28\"\n      fill=\"none\"\n      aria-hidden=\"true\"\n    >\n      <path\n        d=\"M3 10a2 2 0 0 1 2-2h18a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4v-2Z\"\n        stroke=\"white\"\n        strokeWidth=\"1.5\"\n        strokeOpacity=\"0.8\"\n      />\n      <path\n        d=\"M16 8v12\"\n        stroke=\"white\"\n        strokeWidth=\"1.5\"\n        strokeDasharray=\"2 2\"\n        strokeOpacity=\"0.5\"\n      />\n    </svg>\n  );\n}\n\n// ─── ConfirmStep ──────────────────────────────────────────────────────────────\n\nexport default function ConfirmStep({ onDone }: ConfirmStepProps) {\n  const router = useRouter();\n  const dispatch = useAppDispatch();\n  const mode = useAppSelector((s) => s.booking.mode);\n  const bookingId = useAppSelector((s) => s.booking.bookingId);\n  const token = useAppSelector((s) => s.auth.token);\n  const [status, setStatus] = useState<Status>(\"confirm\");\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [confirmFreeBooking] = useConfirmFreeBookingMutation();\n  const push = usePushSubscription();\n  const reducedMotion = useReducedMotion();\n  const iconRef = useRef<HTMLDivElement>(null);\n\n  const isRsvp = mode === \"rsvp\";\n\n  // Rare, first-time-per-booking celebratory moment — pop the header icon\n  // in with the same delight spring used for likes/bookmarks/gallery opens\n  // elsewhere in the app, instead of it appearing instantly.\n  useEffect(() => {\n    const el = iconRef.current;\n    if (!el || reducedMotion) return;\n    el.style.opacity = \"0\";\n    el.style.transform = \"scale(0.9)\";\n    const controls = animate(0, 1, {\n      ...DELIGHT_SPRING,\n      onUpdate: (v) => {\n        el.style.opacity = String(v);\n        el.style.transform = `scale(${0.9 + v * 0.1})`;\n      },\n    });\n    return () => controls.stop();\n  }, [reducedMotion]);\n\n  async function handleConfirm() {\n    if (!bookingId) return;\n    if (token) {\n      void push.requestPermissionAndSubscribe(token).catch(() => {});\n    }\n    const id = bookingId;\n    setStatus(\"loading\");\n    setErrorMsg(null);\n    try {\n      await confirmFreeBooking(id).unwrap();\n      clearActiveBookingId();\n      dispatch(bookingActions.reset());\n      onDone();\n      router.push(`/booking/success?ticketId=${id}&mode=${mode}`);\n    } catch (err: unknown) {\n      const e = err as { data?: { message?: string } };\n      setErrorMsg(\n        e?.data?.message ??\n          \"Couldn't confirm your registration — please try again.\",\n      );\n      setStatus(\"error\");\n    }\n  }\n\n  return (\n    <div className=\"flex-1 flex flex-col\">\n      {/* Header */}\n      <div className=\"flex flex-col gap-3 pt-2\">\n        <div className=\"flex items-center gap-3\">\n          <div ref={iconRef}>\n            {isRsvp ? <CalendarCheckIcon /> : <TicketIcon />}\n          </div>\n          <div className=\"flex flex-col gap-0.5\">\n            <p className=\"text-[11px] font-medium text-white/50 uppercase tracking-widest\">\n              {isRsvp ? \"Free Event\" : \"Free Tickets\"}\n            </p>\n            <p className=\"text-h3 font-semibold text-white tracking-[-0.04em] leading-[1.1]\">\n              {isRsvp ? \"Reserve your spot\" : \"Grab your ticket\"}\n            </p>\n          </div>\n        </div>\n\n        <p className=\"text-p1 text-white/40 tracking-[-0.02em] leading-relaxed\">\n          {isRsvp\n            ? \"One tap and you're in. No payment needed.\"\n            : \"Claim your free ticket instantly. Your QR code will be waiting in the tickets section.\"}\n        </p>\n      </div>\n\n      {/* Spacer */}\n      <div className=\"flex-1\" />\n\n      {/* Error */}\n      {status === \"error\" && errorMsg && (\n        <p className=\"text-p2 text-red-400 tracking-[-0.02em] mb-3\">\n          {errorMsg}\n        </p>\n      )}\n\n      {/* Divider */}\n      <div className=\"h-px bg-white/[0.06] mb-6\" />\n\n      {/* CTA */}\n      <button\n        type=\"button\"\n        onClick={handleConfirm}\n        disabled={status === \"loading\"}\n        className=\"\n          w-full h-12 rounded-2xl\n          bg-white text-black\n          font-semibold text-p1 tracking-[-0.02em]\n          transition-[opacity,transform] duration-150 ease-out\n          active:opacity-70 active:scale-[0.97]\n          disabled:opacity-50\n          flex items-center justify-center gap-2\n        \"\n      >\n        {status === \"loading\" ? (\n          <svg\n            className=\"size-4 animate-spin\"\n            viewBox=\"0 0 16 16\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <circle\n              cx=\"8\"\n              cy=\"8\"\n              r=\"6\"\n              stroke=\"black\"\n              strokeWidth=\"2\"\n              strokeOpacity=\"0.3\"\n            />\n            <path\n              d=\"M8 2a6 6 0 0 1 6 6\"\n              stroke=\"black\"\n              strokeWidth=\"2\"\n              strokeLinecap=\"round\"\n            />\n          </svg>\n        ) : isRsvp ? (\n          \"Confirm RSVP\"\n        ) : (\n          \"Claim ticket\"\n        )}\n      </button>\n    </div>\n  );\n}\n","numLines":230,"startLine":1,"totalLines":230}},"tool_result_meta":[{"id":"call-f7bf5e17-90a8-4942-81b7-f359cb08f076","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
