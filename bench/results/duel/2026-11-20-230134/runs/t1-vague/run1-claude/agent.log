{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0f87d772af89afe24e","type":"tool_result","content":"=== booking expiry worker ===\nbooking-expiry.worker.ts\ncheckout-session-expiry.worker.ts\nmembership-expiry.worker.ts\nslot-expiry.worker.ts\nsplit-payment-expiry.worker.ts\nwaitlist-claim-expiry.worker.ts\n--- expiry worker body ---\nimport { type Job, Worker } from \"bullmq\";\nimport { redis } from \"../config/redis\";\nimport { getLogger } from \"../lib/logger\";\nimport { BookingRepository } from \"../repositories/booking.repository\";\nimport { bookingService } from \"../services/booking.service\";\nimport { PushService } from \"../services/push.service\";\n\nconst logger = getLogger(\"Booking Expiry Worker\", \"debug\");\n\nconst bookingRepository = new BookingRepository();\n\ninterface ExpireJobData {\n  bookingId: string;\n}\n\nexport const bookingExpiryWorker = new Worker(\n  \"booking-expiry\",\n  async (job: Job) => {\n    if (job.name === \"sweep\") {\n      const due = await bookingRepository.findExpiredHolds(100);\n      for (const b of due) {\n        try {\n          await bookingService.expireIfDue(b.bookingId);\n        } catch (err) {\n          logger.error(\"Expire booking failed in sweep\", {\n            bookingId: b.bookingId,\n            err: String(err),\n          });\n        }\n      }\n      logger.info(\"Booking expiry sweep complete\", { swept: due.length });\n      return { swept: due.length };\n    }\n\n    if (job.name === \"expire\") {\n      const { bookingId } = job.data as ExpireJobData;\n      const result = await bookingService.expireIfDue(bookingId);\n\n      // Send \"tickets released\" notification if booking was actually expired\n      if (result) {\n        try {\n          const booking = await bookingRepository.findUserAndEventById(bookingId);\n          if (booking?.userId && booking?.eventId) {\n            PushService.enqueue({\n              userId: booking.userId,\n              title: \"Your hold expired ⏳\",\n              body: \"Spots are going fast — grab them while you can.\",\n              url: `/events/${booking.eventId}`,\n              category: \"engagement\" as const,\n            });\n          }\n        } catch (err) {\n          logger.warn(\"Failed to send expiry notification\", {\n            bookingId,\n            err: String(err),\n          });\n        }\n      }\n\n      return { expired: bookingId };\n    }\n  },\n  {\n    connection: redis,\n    concurrency: 5,\n  },\n);\n\nbookingExpiryWorker.on(\"failed\", (job: Job | undefined, err: Error) => {\n  logger.error(\"Booking expiry job failed\", {\n    jobId: job?.id,\n    jobName: job?.name,\n    err: err.message,\n  });\n});","is_error":false}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"942926de-7739-47b9-b6c2-adde243c1b7a","timestamp":"2026-11-20T17:44:46.509Z","tool_result_meta":[{"id":"call_01a1fa0f87d772af89afe24e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0f8c12701b969821f6","type":"tool_result","content":"=== revenue.util netHostRevenue ===\n/**\n * Revenue utilities — canonical read-side helpers.\n *\n * Single source of truth for all analytics and payout reads.\n * Pure functions; take aggregated numbers as arguments (callers\n * are responsible for querying/summing from DB).\n *\n * Spec §4 Layer 1: net refunds via Refund table columns.\n * Coupon discounts are already baked into the stored hostNet / fee snapshots.\n *\n * Invariant: for any paid booking\n *   hostNet + platformFee + gst + gatewayFee == buyerPaid (±0.01)\n */\n\nimport { fromPaise, toPaise } from \"./money.util\";\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/**\n * Aggregated booking-level money fields for a cohort of PAID bookings.\n * These are sums of the snapshot columns, not recomputed from face values.\n */\nexport interface BookingAggregate {\n  /** Σ Ticket.hostNet (or derived: booking.total - platformFee - gst - gatewayFee) */\n  totalHostNet: number;\n  /** Σ Booking.platformFee (Tunyt's cut) */\n  totalPlatformFee: number;\n  /** Σ Booking.gst (GST on platform fee) */\n  totalGst: number;\n  /** Σ Booking.gatewayFee (Razorpay's cut) */\n  totalGatewayFee: number;\n}\n\n/**\n * Aggregated refund columns from the Refund table.\n * Only APPROVED/PROCESSED refunds should be included.\n */\nexport interface RefundAggregate {\n  /** Σ Refund.amount (total rupees returned to buyer) */\n  amount: number;\n  /** Σ Refund.platformFeeRefund (fee portion added back to host's share) */\n  platformFeeRefund: number;\n  /** Σ Refund.gatewayFeeRefund (fee portion added back to host's share) */\n  gatewayFeeRefund: number;\n}\n\n// ---------------------------------------------------------------------------\n// netHostRevenue\n// ---------------------------------------------------------------------------\n\n/**\n * Net revenue the host actually earned after refunds.\n *\n * Formula (spec §4):\n *   netRevenue = paidHostNet − Σ refund.amount\n *                            + Σ refund.platformFeeRefund\n *                            + Σ refund.gatewayFeeRefund\n *\n * Fee-refund add-backs: when Tunyt/Razorpay refund their fees back to the\n * host (as part of a partial refund) those amounts increase host's net.\n */\nexport function netHostRevenue(\n  booking: BookingAggregate,\n  refund: RefundAggregate,\n): number {\n  return fromPaise(\n    toPaise(booking.totalHostNet) -\n      toPaise(refund.amount) +\n      toPaise(refund.platformFeeRefund) +\n      toPaise(refund.gatewayFeeRefund),\n  );\n}\n\n// ---------------------------------------------------------------------------\n// platformEarnings\n// ---------------------------------------------------------------------------\n\n/**\n * Tunyt's net platform earnings after fee refunds.\n *\n * Uses platformFee snapshots, never totalPrice or subtotal.\n */\nexport function platformEarnings(\n  booking: BookingAggregate,\n  refund: RefundAggregate,\n): number {\n  return fromPaise(\n    toPaise(booking.totalPlatformFee) - toPaise(refund.platformFeeRefund),\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Convenience: hostNetFromBookingRow\n// ---------------------------------------------------------------------------\n\n/**\n * Derive per-booking hostNet from stored snapshot columns.\n * Useful when the Ticket.hostNet column is not yet present (pre-migration bookings).\n *\n * HOST mode: buyerPaid − platformFee − gst − gatewayFee\n * USER mode: buyerPaid − platformFee − gst − gatewayFee  (same formula; hostNet == netFace)\n */\nexport function hostNetFromBookingRow(booking: {\n  total: number;\n  platformFee: number;\n  gst: number;\n  gatewayFee: number;\n}): number {\n  return fromPaise(\n    toPaise(booking.total) -\n      toPaise(booking.platformFee) -\n      toPaise(booking.gst) -\n      toPaise(booking.gatewayFee),\n  );\n}","is_error":false}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"54cbe9ed-6a87-475a-9387-759dd44f63f5","timestamp":"2026-11-20T17:44:46.809Z","tool_result_meta":[{"id":"call_01a1fa0f8c12701b969821f6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
