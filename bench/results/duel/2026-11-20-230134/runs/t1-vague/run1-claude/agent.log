{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa1d8e8a70bda7238483","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n3\t\n4\texport class InventoryReconciliationRepository {\n5\t  /**\n6\t   * Re-derive `soldCount` and `discountSoldCount` for every TicketType from\n7\t   * the actual Ticket + Booking state.\n8\t   *\n9\t   * Truth: a seat counts toward inventory iff its booking is HELD or PAID\n10\t   * AND the ticket itself hasn't been individually refunded or FAILED — a\n11\t   * booking can stay PAID overall while one of its tickets was refunded (or\n12\t   * failed independently, e.g. a hold-expiry race that only hit one ticket\n13\t   * on a multi-ticket booking), and that seat must not keep counting as\n14\t   * sold. (HELD bookings whose hold has expired get released by\n15\t   * booking-expiry — which runs more frequently than this reconciler, so by\n16\t   * the time we fire those have already transitioned to EXPIRED.)\n17\t   *\n18\t   * Sums `t.quantity`, not row count — a single GA Ticket row can bundle\n19\t   * multiple seats under one QR (reserved-seating rows are always quantity 1,\n20\t   * but GA rows aren't), so COUNT(*) would undercount those.\n21\t   *\n22\t   * Side effect: returns the list of eventIds whose ticket types changed,\n23\t   * so the caller can drop their Redis caches.\n24\t   */\n25\t  async reconcileInventoryCounters(): Promise<{\n26\t    updatedTypes: number;\n27\t    affectedEventIds: string[];\n28\t  }> {\n29\t    return wrapDatabaseOperation(async () => {\n30\t      // Single round-trip: derive correct values, update only the rows that\n31\t      // drift, return their eventIds via RETURNING.\n32\t      const rows = await prisma.$queryRaw<Array<{ eventId: string }>>`\n33\t        WITH live_bookings AS MATERIALIZED (\n34\t          SELECT \"bookingId\"\n35\t          FROM \"Booking\"\n36\t          WHERE \"status\" IN ('HELD', 'PAID')\n37\t        ),\n38\t        live AS (\n39\t          SELECT\n40\t            t.\"ticketTypeId\",\n41\t            COALESCE(SUM(t.quantity), 0)                                  AS total,\n42\t            COALESCE(SUM(t.quantity) FILTER (WHERE t.\"wasDiscounted\"), 0) AS discounted\n43\t          FROM \"Ticket\" t\n44\t          JOIN live_bookings b ON b.\"bookingId\" = t.\"bookingId\"\n45\t          WHERE t.\"ticketTypeId\" IS NOT NULL\n46\t            AND t.\"status\" NOT IN ('REFUNDED', 'FAILED')\n47\t          GROUP BY t.\"ticketTypeId\"\n48\t        ),\n49\t        target AS (\n50\t          SELECT\n51\t            tt.\"ticketTypeId\",\n52\t            COALESCE(live.total, 0)::int AS new_sold,\n53\t            LEAST(\n54\t              COALESCE(live.discounted, 0),\n55\t              COALESCE(tt.\"discountQuantity\", COALESCE(live.discounted, 0))\n56\t            )::int AS new_discount_sold\n57\t          FROM \"TicketType\" tt\n58\t          LEFT JOIN live ON live.\"ticketTypeId\" = tt.\"ticketTypeId\"\n59\t        )\n60\t        UPDATE \"TicketType\" tt\n61\t        SET \"soldCount\" = target.new_sold,\n62\t            \"discountSoldCount\" = target.new_discount_sold\n63\t        FROM target\n64\t        WHERE tt.\"ticketTypeId\" = target.\"ticketTypeId\"\n65\t          AND (\n66\t            tt.\"soldCount\" IS DISTINCT FROM target.new_sold\n67\t            OR tt.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\n68\t          )\n69\t        RETURNING tt.\"eventId\"\n70\t      `;\n71\t\n72\t      // Bundle-level discount slots: TicketTypeGroup.discountSoldCount.\n73\t      // A single bundle-unit purchase produces one Ticket row per member\n74\t      // ticket type in the group, all sharing the same bookingId,\n75\t      // bundleGroupId, and (per Task 5) an identical quantity. Counting\n76\t      // those rows with COUNT(*) would multiply the true consumed count by\n77\t      // the group's member count, so instead: first collapse each\n78\t      // booking's member rows down to a single quantity via MAX (mirrors\n79\t      // the Math.max done in booking.repository.ts's reserveInventoryTx/\n80\t      // release path), then SUM across bookings to get the true total\n81\t      // consumed for the group.\n82\t      const groupRows = await prisma.$queryRaw<Array<{ eventId: string }>>`\n83\t        WITH live_bookings AS MATERIALIZED (\n84\t          SELECT \"bookingId\"\n85\t          FROM \"Booking\"\n86\t          WHERE \"status\" IN ('HELD', 'PAID')\n87\t        ),\n88\t        per_booking AS (\n89\t          SELECT\n90\t            t.\"bundleGroupId\",\n91\t            t.\"bookingId\",\n92\t            MAX(t.\"quantity\") AS booking_qty\n93\t          FROM \"Ticket\" t\n94\t          JOIN live_bookings b ON b.\"bookingId\" = t.\"bookingId\"\n95\t          WHERE t.\"bundleGroupId\" IS NOT NULL\n96\t            AND t.\"bundleWasDiscounted\"\n97\t          GROUP BY t.\"bundleGroupId\", t.\"bookingId\"\n98\t        ),\n99\t        live AS (\n100\t          SELECT\n101\t            \"bundleGroupId\",\n102\t            SUM(booking_qty)::int AS discounted\n103\t          FROM per_booking\n104\t          GROUP BY \"bundleGroupId\"\n105\t        ),\n106\t        target AS (\n107\t          SELECT\n108\t            g.\"groupId\",\n109\t            g.\"eventId\",\n110\t            LEAST(\n111\t              COALESCE(live.discounted, 0),\n112\t              COALESCE(g.\"discountQuantity\", COALESCE(live.discounted, 0))\n113\t            )::int AS new_discount_sold\n114\t          FROM \"TicketTypeGroup\" g\n115\t          LEFT JOIN live ON live.\"bundleGroupId\" = g.\"groupId\"\n116\t        )\n117\t        UPDATE \"TicketTypeGroup\" g\n118\t        SET \"discountSoldCount\" = target.new_discount_sold\n119\t        FROM target\n120\t        WHERE g.\"groupId\" = target.\"groupId\"\n121\t          AND g.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\n122\t        RETURNING target.\"eventId\"\n123\t      `;\n124\t\n125\t      const affectedEventIds = [\n126\t        ...new Set([\n127\t          ...rows.map((r) => r.eventId),\n128\t          ...groupRows.map((r) => r.eventId),\n129\t        ]),\n130\t      ];\n131\t      return {\n132\t        updatedTypes: rows.length + groupRows.length,\n133\t        affectedEventIds,\n134\t      };\n135\t    }, \"Reconcile inventory counters\");\n136\t  }\n137\t}\n138\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"304d5b14-8294-4cdc-80a6-d48bd97a5e21","timestamp":"2026-11-20T18:00:07.058Z","tool_result_meta":[{"id":"call_01a1fa1d8e8a70bda7238483","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
