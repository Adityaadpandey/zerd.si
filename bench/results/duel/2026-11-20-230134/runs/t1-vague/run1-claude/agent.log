{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa111cdc74f89c967f00","type":"tool_result","content":"1\timport type { PayoutBreakdown } from \"../types/dashboard.types\";\n2\timport {\n3\t\ttype BookingAggregate,\n4\t\tnetHostRevenue,\n5\t\tplatformEarnings,\n6\t\ttype RefundAggregate,\n7\t} from \"./revenue.util\";\n8\t\n9\t// Host money is paid one day after the event ends, e.g. a show ending\n10\t// Sat 23:00 pays out Sun 23:00. Refunds close 48h before the event, so nothing\n11\t// is clawed back from a host who has been paid.\n12\texport const PAYOUT_DELAY_HOURS = 24;\n13\t\n14\texport interface EventTimeFields {\n15\t\tdate: Date;\n16\t\ttime: Date | null;\n17\t\tendDate: Date | null;\n18\t\tendTime: Date | null;\n19\t}\n20\t\n21\t// Event.date/time are stored as separate columns: date carries the calendar\n22\t// day, time carries the clock reading (both are real UTC instants, so the\n23\t// event's timezoneOffsetMinutes is only for display). Merge day + clock.\n24\tfunction mergeDayAndClock(day: Date, clock: Date | null): Date {\n25\t\tconst merged = new Date(day);\n26\t\tif (clock) {\n27\t\t\tmerged.setUTCHours(\n28\t\t\t\tclock.getUTCHours(),\n29\t\t\t\tclock.getUTCMinutes(),\n30\t\t\t\tclock.getUTCSeconds(),\n31\t\t\t\tclock.getUTCMilliseconds(),\n32\t\t\t);\n33\t\t}\n34\t\treturn merged;\n35\t}\n36\t\n37\t/**\n38\t * The moment the event is over. Multi-day events use endDate (+ endTime when\n39\t * set); everything else ends at its start. The one place that answers this,\n40\t * so dashboard, AI brief and the payout worker never disagree.\n41\t */\n42\texport function eventEndInstant(event: EventTimeFields | null): Date | null {\n43\t\tif (!event?.date) return null;\n44\t\treturn event.endDate\n45\t\t\t? mergeDayAndClock(event.endDate, event.endTime)\n46\t\t\t: mergeDayAndClock(event.date, event.time);\n47\t}\n48\t\n49\t/**\n50\t * Payout date = event end + PAYOUT_DELAY_HOURS. Exported so callers that only\n51\t * need the date (e.g. the lister balance breakdown) don't have to pull a full\n52\t * booking/refund aggregate through computePayoutBreakdown.\n53\t */\n54\texport function expectedPayoutDateFromEventEnd(\n55\t\teventEnd: Date | null,\n56\t): string | null {\n57\t\tif (!eventEnd) return null;\n58\t\treturn new Date(eventEnd.getTime() + PAYOUT_DELAY_HOURS * 3_600_000).toISOString();\n59\t}\n60\t\n61\texport interface PayoutComputeInputs {\n62\t\tgross: number; // Σ netFace (post-coupon face) — for display + feesBornBy\n63\t\tplatformFee: number; // Σ Booking.platformFee snapshot\n64\t\tgst: number; // Σ Booking.gst snapshot\n65\t\tgatewayFee: number; // Σ Booking.gatewayFee snapshot\n66\t\ttotalCharged: number; // Σ Booking.total (actual buyer-paid)\n67\t\trefundAmount: number;\n68\t\trefundPlatformFeeRefund: number;\n69\t\trefundGatewayFeeRefund: number;\n70\t\teventEnd: Date | null; // from eventEndInstant()\n71\t}\n72\t\n73\t/**\n74\t * Canonical host-payout breakdown. Single source of truth shared by\n75\t * `DashboardService.getEventOverview` and the AI copilot brief so both report\n76\t * the same net payout, fees, and expected date. Pure — no I/O.\n77\t *\n78\t * All fee columns come from stored per-booking snapshots — they already reflect\n79\t * coupon reductions, early-bird pricing, and HOST/USER fee mode. Never\n80\t * re-derive from TicketType config.\n81\t */\n82\texport function computePayoutBreakdown(\n83\t\tinputs: PayoutComputeInputs,\n84\t): PayoutBreakdown {\n85\t\tconst {\n86\t\t\tgross,\n87\t\t\tplatformFee,\n88\t\t\tgst,\n89\t\t\tgatewayFee,\n90\t\t\ttotalCharged,\n91\t\t\trefundAmount,\n92\t\t\trefundPlatformFeeRefund,\n93\t\t\trefundGatewayFeeRefund,\n94\t\t\teventEnd,\n95\t\t} = inputs;\n96\t\n97\t\t// Σ hostNet = Σ (total − platformFee − gst − gatewayFee).\n98\t\t// Correct regardless of HOST/USER mode:\n99\t\t//   HOST: buyer paid netFace → hostNet = netFace − fees = total − fees\n100\t\t//   USER: buyer paid netFace + fees → hostNet = netFace = total − fees\n101\t\tconst bookingAggregate: BookingAggregate = {\n102\t\t\ttotalHostNet: totalCharged - platformFee - gst - gatewayFee,\n103\t\t\ttotalPlatformFee: platformFee,\n104\t\t\ttotalGst: gst,\n105\t\t\ttotalGatewayFee: gatewayFee,\n106\t\t};\n107\t\tconst refundAggregate: RefundAggregate = {\n108\t\t\tamount: refundAmount,\n109\t\t\tplatformFeeRefund: refundPlatformFeeRefund,\n110\t\t\tgatewayFeeRefund: refundGatewayFeeRefund,\n111\t\t};\n112\t\n113\t\t// netPayout via canonical helper — nets APPROVED/PROCESSING/COMPLETED\n114\t\t// refunds from the Refund table.\n115\t\tconst netPayoutAmt = netHostRevenue(bookingAggregate, refundAggregate);\n116\t\tconst platformFeeNet = platformEarnings(bookingAggregate, refundAggregate);\n117\t\n118\t\t// feesBornBy inference: compare buyer-paid total with post-coupon face.\n119\t\t// HOST: totalCharged ≈ gross (buyer paid face; Tunyt/gateway deducted from host)\n120\t\t// USER: totalCharged ≈ gross + platformFee + gst + gatewayFee (buyer paid fees too)\n121\t\tconst isHost = Math.abs(totalCharged - gross) < 1;\n122\t\tconst isUser =\n123\t\t\t!isHost &&\n124\t\t\tMath.abs(totalCharged - gross - platformFee - gst - gatewayFee) < 1;\n125\t\tconst feesBornBy: \"HOST\" | \"USER\" | \"MIXED\" = isHost\n126\t\t\t? \"HOST\"\n127\t\t\t: isUser\n128\t\t\t\t? \"USER\"\n129\t\t\t\t: \"MIXED\";\n130\t\n131\t\t// Platform percentage is configured against the ticket face, while the\n132\t\t// gateway percentage is charged against the final buyer-paid amount in USER\n133\t\t// mode. Using totalCharged for both understated the platform rate whenever\n134\t\t// buyers covered the fees (e.g. 273 / 10,899 = 2.5%, not 273 / 11,458).\n135\t\tconst platformFeeRate = gross > 0 ? platformFee / gross : 0;\n136\t\tconst gatewayFeeRate = totalCharged > 0 ? gatewayFee / totalCharged : 0;\n137\t\n138\t\tconst expectedPayoutDate = expectedPayoutDateFromEventEnd(eventEnd);\n139\t\n140\t\treturn {\n141\t\t\tgross,\n142\t\t\tgrossSales: totalCharged,\n143\t\t\tplatformFee: Math.round(platformFeeNet),\n144\t\t\tplatformFeeRate,\n145\t\t\tgatewayFee: Math.round(gatewayFee),\n146\t\t\tgatewayFeeRate,\n147\t\t\trefunded: Math.round(refundAmount),\n148\t\t\tnetPayout: Math.round(netPayoutAmt),\n149\t\t\texpectedPayoutDate,\n150\t\t\tfeesBornBy,\n151\t\t};\n152\t}\n153\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"d73c0a81-a542-47c9-b7e3-2306b67843d9","timestamp":"2026-11-20T17:46:36.737Z","tool_result_meta":[{"id":"call_01a1fa111cdc74f89c967f00","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa111e4f7583b3ab98c2","type":"tool_result","content":"  /**\n   * Calculate revenue split for an event.\n   *\n   * Basis: stored Booking snapshot columns (platformFee, gst, gatewayFee, total).\n   * Coupon is already baked in at booking time — do NOT recompute from TicketType\n   * config (which ignores discountAmount and uses stale fee config).\n   * Refunds are netted via the Refund table (spec §2 decision 9).\n   */\n  async calculateEventRevenue(eventId: string) {\n    return wrapDatabaseOperation(async () => {\n      const [bookingAgg, refundAgg, ticketsSoldAgg] = await Promise.all([\n        // Sum of stored snapshots for PAID bookings.\n        // hostNet = total − platformFee − gst − gatewayFee.\n        prisma.booking.aggregate({\n          _sum: { total: true, platformFee: true, gst: true, gatewayFee: true },\n          where: { eventId, status: \"PAID\", paymentMode: \"ONLINE\" },\n        }),\n        // Refund netting: APPROVED + PROCESSING + COMPLETED refunds.\n        prisma.refund.aggregate({\n          _sum: { amount: true, platformFeeRefund: true, gatewayFeeRefund: true },\n          where: {\n            eventId,\n            // FAILED included: an approved refund whose gateway attempt broke\n            // is still owed to the buyer, not money the host can be paid on.\n            status: { in: [\"APPROVED\", \"PROCESSING\", \"COMPLETED\", \"FAILED\"] },\n            // Online bookings only: orphaned tickets and cash-sale refunds were\n            // never part of the booking aggregate above.\n            ticket: { booking: { is: { paymentMode: \"ONLINE\" } } },\n          },\n        }),\n        prisma.ticket.aggregate({\n          _sum: { quantity: true },\n          where: { eventId, status: \"SUCCESS\" },\n        }),\n      ]);\n\n      const total = bookingAgg._sum.total ?? 0;\n      const totalPlatformFee = bookingAgg._sum.platformFee ?? 0;\n      const totalGst = bookingAgg._sum.gst ?? 0;\n      const totalGatewayFee = bookingAgg._sum.gatewayFee ?? 0;\n\n      // Build canonical aggregates for revenue.util (spec §4 Layer 1).\n      // totalHostNet = Σ (total − platformFee − gst − gatewayFee): universal for HOST + USER.\n      let bookingAggregate: BookingAggregate = {\n        totalHostNet: total - totalPlatformFee - totalGst - totalGatewayFee,\n        totalPlatformFee,\n        totalGst,\n        totalGatewayFee,\n      };\n      bookingAggregate = applyCashClawback(bookingAggregate, await sumCashFeesOwed({ eventId }));\n      const refundAggregate: RefundAggregate = {\n        amount: refundAgg._sum.amount ?? 0,\n        platformFeeRefund: refundAgg._sum.platformFeeRefund ?? 0,\n        gatewayFeeRefund: refundAgg._sum.gatewayFeeRefund ?? 0,\n      };\n\n      // Canonical helper calls — single source of truth (spec §4 Layer 2).\n      const listerRevenue = netHostRevenue(bookingAggregate, refundAggregate);\n      const netPlatformFee = platformEarnings(bookingAggregate, refundAggregate);\n\n      return {\n        eventId,\n        totalRevenue: bookingAggregate.totalHostNet, // host gross before refunds\n        platformFee: netPlatformFee,                 // net platform earnings (after fee refunds)\n        gatewayFee: totalGatewayFee,\n        listerRevenue,                               // host net after refunds\n        ticketsSold: Number(ticketsSoldAgg._sum.quantity ?? 0),\n      };\n    }, \"Calculate event revenue\");\n  }\n\n  /**\n   * Calculate revenue split for a lister.\n   *\n   * Basis: stored Ticket snapshot columns (totalPrice, platformFee, gst, gatewayFee).\n   * hostNet per seat = totalPrice − platformFee − gst − gatewayFee (spec §4 Layer 1).\n   * Coupon is baked into the fee snapshots at booking time — never recompute from\n   * TicketType config (which ignores discountAmount and may have stale rates).\n   * Refunds are netted from the Refund table (spec §2 decision 9).\n   */\n  async calculateListerRevenue(listerId: string) {\n    return wrapDatabaseOperation(async () => {\n      const [result, refundResult, eventCount] = await Promise.all([\n        // Stored Ticket snapshots — correct for coupon + early-bird + HOST/USER mode.","is_error":false}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"91e6c141-625a-48eb-875b-d3280e767a92","timestamp":"2026-11-20T17:46:36.999Z","tool_result_meta":[{"id":"call_01a1fa111e4f7583b3ab98c2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
