f<AuthResponse | null>(null);\n  const focusTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n\n  // Cleanup pending focus timers on unmount\n  useEffect(() => {\n    return () => {\n      if (focusTimerRef.current) clearTimeout(focusTimerRef.current);\n    };\n  }, []);\n\n  const [phoneLink, setPhoneLink] = useState(\"\");\n  const [phoneLinkLoading, setPhoneLinkLoading] = useState(false);\n  const [phoneLinkError, setPhoneLinkError] = useState(\"\");\n\n  const [completeProfile] = useCompleteProfileMutation();\n\n  // ── Advance to next step ───────────────────────────────────────────────────\n\n  const advance = useCallback(() => {\n    dispatch(bookingActions.setStep(3));\n  }, [dispatch]);\n\n  // ── Watch for Google-triggered auth ───────────────────────────────────────\n\n  useEffect(() => {\n    if (isAuthenticated && pendingGoogleAdvance.current) {\n      pendingGoogleAdvance.current = false;\n      advance();\n    }\n  }, [isAuthenticated, advance]);\n\n  // ── Resend timer countdown ────────────────────────────────────────────────\n\n  useEffect(() => {\n    if (resendTimer <= 0) return;\n    const t = setTimeout(() => setResendTimer((v) => v - 1), 1000);\n    return () => clearTimeout(t);\n  }, [resendTimer]);\n\n  // ── Derived ───────────────────────────────────────────────────────────────\n\n  const formValid =\n    name.trim().length > 0 && isValidPhone(phone) && isValidEmail(email.trim());\n  const otpComplete = otp.join(\"\").length === OTP_LENGTH;\n\n  // ── Submit details → send OTP to email ────────────────────────────────────\n\n  const handleSubmitDetails = async () => {\n    setFormError(\"\");\n    if (!name.trim()) {\n      setFormError(\"Please enter your full name\");\n      return;\n    }\n    if (!isValidPhone(phone)) {\n      setFormError(\"Enter a valid 10-digit phone number\");\n      return;\n    }\n    if (!isValidEmail(email.trim())) {\n      setFormError(\"Enter a valid email address\");\n      return;\n    }\n\n    setSendLoading(true);\n    try {\n      await ensureCsrfToken();\n      const res = await fetch(\"/api/auth/otp/request\", {\n        method: \"POST\",\n        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n        body: JSON.stringify({ identifier: email.trim() }),\n      });\n      const data = await res.json();\n      if (!res.ok) {\n        const msg = extractError(data as ErrorBody);\n        setFormError(msg);\n        dispatch(addToast({ message: msg, variant: \"error\" }));\n        return;\n      }\n      dispatch(setOtpIdentifier(email.trim()));\n      setResendTimer(RESEND_COOLDOWN);\n      setOtp(Array(OTP_LENGTH).fill(\"\"));\n      setUiState(\"OTP_SENT\");\n      if (focusTimerRef.current) clearTimeout(focusTimerRef.current);\n      focusTimerRef.current = setTimeout(\n        () => otpRefs.current[0]?.focus(),\n        300,\n      );\n    } catch {\n      const msg = \"Failed to send OTP. Try again.\";\n      setFormError(msg);\n      dispatch(addToast({ message: msg, variant: \"error\" }));\n    } finally {\n      setSendLoading(false);\n    }\n  };\n\n  // ── Verify OTP ────────────────────────────────────────────────────────────\n\n  const handleVerifyOtp = async () => {\n    setOtpError(\"\");\n    const code = otp.join(\"\");\n    if (code.length !== OTP_LENGTH) {\n      setOtpError(`Enter the ${OTP_LENGTH}-digit code`);\n      return;\n    }\n    setVerifyLoading(true);\n    try {\n      const res = await fetch(\"/api/auth/otp/verify\", {\n        method: \"POST\",\n        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n        body: JSON.stringify({ identifier: email.trim(), otp: code }),\n      });\n      const data = await res.json();\n      if (!res.ok) {\n        const otpMsg = extractError(data as ErrorBody);\n        setOtpError(otpMsg);\n        dispatch(addToast({ message: otpMsg, variant: \"error\" }));\n        setOtp(Array(OTP_LENGTH).fill(\"\"));\n        otpRefs.current[0]?.focus();\n        return;\n      }\n      const authData = data as AuthResponse;\n      // Explicitly write the CSRF cookie from the response body so it is\n      // guaranteed to be in document.cookie before the next CSRF-protected\n      // request, regardless of any browser Set-Cookie timing edge cases.\n      if (authData.csrfToken) {\n        setCsrfCookie(authData.csrfToken);\n      }\n      dispatch(setAuth({ token: authData.token, user: authData.user }));\n      // Stitch pre-auth anonymous browsing to the now-known userId\n      activityTracker.stitch(authData.user.userId);\n\n      // Persist name + phone for new / incomplete profiles in the background.\n      // Don't block the booking flow on this — the ticket hold and payment are\n      // the critical path; profile details can catch up.\n      if (!authData.user.profileComplete) {\n        completeProfile({\n          name: name.trim(),\n          phone: `+91${phone}`,\n        })\n          .unwrap()\n          .catch(() => {});\n      }\n      advance();\n    } catch {\n      const otpCatchMsg = \"Invalid OTP. Try again.\";\n      setOtpError(otpCatchMsg);\n      dispatch(addToast({ message: otpCatchMsg, variant: \"error\" }));\n      setOtp(Array(OTP_LENGTH).fill(\"\"));\n      otpRefs.current[0]?.focus();\n    } finally {\n      setVerifyLoading(false);\n    }\n  };\n\n  // ── Resend OTP ────────────────────────────────────────────────────────────\n\n  const handleResend = async () => {\n    if (resendTimer > 0) return;\n    setOtpError(\"\");\n    setSendLoading(true);\n    try {\n      await ensureCsrfToken();\n      const res = await fetch(\"/api/auth/otp/request\", {\n        method: \"POST\",\n        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n        body: JSON.stringify({ identifier: email.trim() }),\n      });\n      if (res.ok) {\n        setResendTimer(RESEND_COOLDOWN);\n        setOtp(Array(OTP_LENGTH).fill(\"\"));\n        if (focusTimerRef.current) clearTimeout(focusTimerRef.current);\n        focusTimerRef.current = setTimeout(\n          () => otpRefs.current[0]?.focus(),\n          100,\n        );\n      } else {\n        const data = await res.json().catch(() => ({}));\n        const msg = extractError(data as ErrorBody);\n        setOtpError(msg);\n        dispatch(addToast({ message: msg, variant: \"error\" }));\n      }\n    } catch {\n      const msg = \"Failed to resend OTP. Try again.\";\n      setOtpError(msg);\n      dispatch(addToast({ message: msg, variant: \"error\" }));\n    } finally {\n      setSendLoading(false);\n    }\n  };\n\n  // ── Phone link (post-Google-auth) ─────────────────────────────────────────\n\n  const handleCollectPhone = async () => {\n    setPhoneLinkError(\"\");\n    setPhoneLinkLoading(true);\n    try {\n      const res = await fetch(\"/api/auth/link-phone\", {\n        method: \"POST\",\n        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n        body: JSON.stringify({ phone: `+91${phoneLink}` }),\n      });\n      const data = await res.json();\n      if (!res.ok) {\n        const msg = extractError(data as ErrorBody);\n        setPhoneLinkError(msg);\n        dispatch(addToast({ message: msg, variant: \"error\" }));\n        return;\n      }\n      const pending = pendingGoogleAuth.current;\n      if (!pending) return;\n      const updatedUser = {\n        ...pending.user,\n        ...(data.user ?? {}),\n        phone: `+91${phoneLink}`,\n      };\n      pendingGoogleAuth.current = null;\n      dispatch(setAuth({ token: pending.token, user: updatedUser }));\n      // Stitch pre-auth anonymous browsing to the now-known userId\n      activityTracker.stitch(updatedUser.userId);\n      advance();\n    } catch {\n      const msg = \"Failed to save phone number. Try again.\";\n      setPhoneLinkError(msg);\n      dispatch(addToast({ message: msg, variant: \"error\" }));\n    } finally {\n      setPhoneLinkLoading(false);\n    }\n  };\n\n  // ── Google sign-in — pre-render invisible GIS overlay on script load ─────────\n\n  const gisInitedRef = useRef(false);\n  useEffect(() => {","numLines":260,"startLine":120,"totalLines":907}},"tool_result_meta":[{"id":"call-5d156cfe-f88d-44cd-b273-3868a0f9fbb0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
