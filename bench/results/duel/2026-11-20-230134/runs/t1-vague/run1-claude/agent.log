{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-5a7c2e94-ede0-4804-a618-1f13edcae641","type":"tool_result","content":"1\timport { createSlice, type PayloadAction } from \"@reduxjs/toolkit\";\n2\timport {\n3\t  type BookingLineDraft,\n4\t  type BookingMode,\n5\t  type BookingStep,\n6\t  createBookingLine,\n7\t  type FieldAnswer,\n8\t  getInitialBookingStep,\n9\t  setBookingLineQuantity,\n10\t} from \"@tunyt/shared\";\n11\t\n12\texport type { BookingMode, BookingStep } from \"@tunyt/shared\";\n13\t\n14\tinterface BookingDraftState {\n15\t  eventId: string | null;\n16\t  step: BookingStep;\n17\t  mode: BookingMode;\n18\t  lines: BookingLineDraft[];\n19\t  commonFieldResponses: FieldAnswer[];\n20\t  discountInput: string;\n21\t  bookingId: string | null;\n22\t  selectedTeamTicketTypeId: string | null;\n23\t}\n24\t\n25\tconst initialState: BookingDraftState = {\n26\t  eventId: null,\n27\t  step: 1,\n28\t  mode: \"paid\",\n29\t  lines: [],\n30\t  commonFieldResponses: [],\n31\t  discountInput: \"\",\n32\t  bookingId: null,\n33\t  selectedTeamTicketTypeId: null,\n34\t};\n35\t\n36\texport const bookingSlice = createSlice({\n37\t  name: \"booking\",\n38\t  initialState,\n39\t  reducers: {\n40\t    startBooking(\n41\t      state,\n42\t      action: PayloadAction<{\n43\t        eventId: string;\n44\t        isAuthenticated: boolean;\n45\t        mode?: BookingMode;\n46\t        autoSelectTicketTypeId?: string;\n47\t        // RSVP-style approval events (ticketingEnabled=false): skip the\n48\t        // ticket-selection step entirely since there is nothing to pick.\n49\t        skipTicketSelection?: boolean;\n50\t      }>,\n51\t    ) {\n52\t      const {\n53\t        eventId,\n54\t        isAuthenticated,\n55\t        mode = \"paid\",\n56\t        autoSelectTicketTypeId,\n57\t        skipTicketSelection,\n58\t      } = action.payload;\n59\t      Object.assign(state, initialState);\n60\t      state.eventId = eventId;\n61\t      state.mode = mode;\n62\t\n63\t      // For single free-ticket events, auto-select qty=1 so AttendeesStep\n64\t      // and ConfirmStep don't need to touch ticket selection.\n65\t      if (autoSelectTicketTypeId) {\n66\t        state.lines = [createBookingLine(autoSelectTicketTypeId, 1)];\n67\t      }\n68\t\n69\t      state.step = getInitialBookingStep({\n70\t        isAuthenticated,\n71\t        mode,\n72\t        autoSelectTicketTypeId,\n73\t        skipTicketSelection,\n74\t      });\n75\t    },\n76\t    setStep(state, action: PayloadAction<BookingStep>) {\n77\t      state.step = action.payload;\n78\t    },\n79\t    setTeamTicketTypeId(state, action: PayloadAction<string | null>) {\n80\t      state.selectedTeamTicketTypeId = action.payload;\n81\t    },\n82\t    setQuantity(\n83\t      state,\n84\t      action: PayloadAction<{ ticketTypeId: string; quantity: number }>,\n85\t    ) {\n86\t      const { ticketTypeId, quantity } = action.payload;\n87\t      state.lines = setBookingLineQuantity(state.lines, ticketTypeId, quantity);\n88\t    },\n89\t    setTicketFieldResponse(\n90\t      state,\n91\t      action: PayloadAction<{\n92\t        ticketTypeId: string;\n93\t        ticketIndex: number;\n94\t        fieldId: string;\n95\t        value: string;\n96\t      }>,\n97\t    ) {\n98\t      const { ticketTypeId, ticketIndex, fieldId, value } = action.payload;\n99\t      const line = state.lines.find((l) => l.ticketTypeId === ticketTypeId);\n100\t      if (!line) return;\n101\t      const answers = line.ticketFieldResponses[ticketIndex] ?? [];\n102\t      const i = answers.findIndex((a) => a.fieldId === fieldId);\n103\t      if (i >= 0) answers[i] = { fieldId, value };\n104\t      else answers.push({ fieldId, value });\n105\t      line.ticketFieldResponses[ticketIndex] = answers;\n106\t    },\n107\t    setCommonFieldResponse(state, action: PayloadAction<FieldAnswer>) {\n108\t      const i = state.commonFieldResponses.findIndex(\n109\t        (a) => a.fieldId === action.payload.fieldId,\n110\t      );\n111\t      if (i >= 0) state.commonFieldResponses[i] = action.payload;\n112\t      else state.commonFieldResponses.push(action.payload);\n113\t    },\n114\t    setDiscountInput(state, action: PayloadAction<string>) {\n115\t      state.discountInput = action.payload;\n116\t    },\n117\t    // Replace the in-progress lines wholesale — used when resuming an\n118\t    // existing HELD booking (the line composition comes from the server,\n119\t    // not from the user's in-flight step-2 selection).\n120\t    setLines(state, action: PayloadAction<BookingLineDraft[]>) {\n121\t      state.lines = action.payload;\n122\t    },\n123\t    setBookingId(state, action: PayloadAction<string | null>) {\n124\t      state.bookingId = action.payload;\n125\t    },\n126\t    reset() {\n127\t      return { ...initialState };\n128\t    },\n129\t  },\n130\t});\n131\t\n132\texport const bookingActions = bookingSlice.actions;\n133\texport default bookingSlice.reducer;\n134\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"24239796-12ef-4974-b7ab-18d7ab0a8675","timestamp":"2026-11-20T17:34:30.589Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/lib/redux/slices/bookingSlice.ts","content":"import { createSlice, type PayloadAction } from \"@reduxjs/toolkit\";\nimport {\n  type BookingLineDraft,\n  type BookingMode,\n  type BookingStep,\n  createBookingLine,\n  type FieldAnswer,\n  getInitialBookingStep,\n  setBookingLineQuantity,\n} from \"@tunyt/shared\";\n\nexport type { BookingMode, BookingStep } from \"@tunyt/shared\";\n\ninterface BookingDraftState {\n  eventId: string | null;\n  step: BookingStep;\n  mode: BookingMode;\n  lines: BookingLineDraft[];\n  commonFieldResponses: FieldAnswer[];\n  discountInput: string;\n  bookingId: string | null;\n  selectedTeamTicketTypeId: string | null;\n}\n\nconst initialState: BookingDraftState = {\n  eventId: null,\n  step: 1,\n  mode: \"paid\",\n  lines: [],\n  commonFieldResponses: [],\n  discountInput: \"\",\n  bookingId: null,\n  selectedTeamTicketTypeId: null,\n};\n\nexport const bookingSlice = createSlice({\n  name: \"booking\",\n  initialState,\n  reducers: {\n    startBooking(\n      state,\n      action: PayloadAction<{\n        eventId: string;\n        isAuthenticated: boolean;\n        mode?: BookingMode;\n        autoSelectTicketTypeId?: string;\n        // RSVP-style approval events (ticketingEnabled=false): skip the\n        // ticket-selection step entirely since there is nothing to pick.\n        skipTicketSelection?: boolean;\n      }>,\n    ) {\n      const {\n        eventId,\n        isAuthenticated,\n        mode = \"paid\",\n        autoSelectTicketTypeId,\n        skipTicketSelection,\n      } = action.payload;\n      Object.assign(state, initialState);\n      state.eventId = eventId;\n      state.mode = mode;\n\n      // For single free-ticket events, auto-select qty=1 so AttendeesStep\n      // and ConfirmStep don't need to touch ticket selection.\n      if (autoSelectTicketTypeId) {\n        state.lines = [createBookingLine(autoSelectTicketTypeId, 1)];\n      }\n\n      state.step = getInitialBookingStep({\n        isAuthenticated,\n        mode,\n        autoSelectTicketTypeId,\n        skipTicketSelection,\n      });\n    },\n    setStep(state, action: PayloadAction<BookingStep>) {\n      state.step = action.payload;\n    },\n    setTeamTicketTypeId(state, action: PayloadAction<string | null>) {\n      state.selectedTeamTicketTypeId = action.payload;\n    },\n    setQuantity(\n      state,\n      action: PayloadAction<{ ticketTypeId: string; quantity: number }>,\n    ) {\n      const { ticketTypeId, quantity } = action.payload;\n      state.lines = setBookingLineQuantity(state.lines, ticketTypeId, quantity);\n    },\n    setTicketFieldResponse(\n      state,\n      action: PayloadAction<{\n        ticketTypeId: string;\n        ticketIndex: number;\n        fieldId: string;\n        value: string;\n      }>,\n    ) {\n      const { ticketTypeId, ticketIndex, fieldId, value } = action.payload;\n      const line = state.lines.find((l) => l.ticketTypeId === ticketTypeId);\n      if (!line) return;\n      const answers = line.ticketFieldResponses[ticketIndex] ?? [];\n      const i = answers.findIndex((a) => a.fieldId === fieldId);\n      if (i >= 0) answers[i] = { fieldId, value };\n      else answers.push({ fieldId, value });\n      line.ticketFieldResponses[ticketIndex] = answers;\n    },\n    setCommonFieldResponse(state, action: PayloadAction<FieldAnswer>) {\n      const i = state.commonFieldResponses.findIndex(\n        (a) => a.fieldId === action.payload.fieldId,\n      );\n      if (i >= 0) state.commonFieldResponses[i] = action.payload;\n      else state.commonFieldResponses.push(action.payload);\n    },\n    setDiscountInput(state, action: PayloadAction<string>) {\n      state.discountInput = action.payload;\n    },\n    // Replace the in-progress lines wholesale — used when resuming an\n    // existing HELD booking (the line composition comes from the server,\n    // not from the user's in-flight step-2 selection).\n    setLines(state, action: PayloadAction<BookingLineDraft[]>) {\n      state.lines = action.payload;\n    },\n    setBookingId(state, action: PayloadAction<string | null>) {\n      state.bookingId = action.payload;\n    },\n    reset() {\n      return { ...initialState };\n    },\n  },\n});\n\nexport const bookingActions = bookingSlice.actions;\nexport default bookingSlice.reducer;\n","numLines":134,"startLine":1,"totalLines":134}},"tool_result_meta":[{"id":"call-5a7c2e94-ede0-4804-a618-1f13edcae641","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
