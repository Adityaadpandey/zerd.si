entRevenue(eventId: string) {\n346-    return wrapDatabaseOperation(async () => {\n347-      const [bookingAgg, refundAgg, ticketsSoldAgg] = await Promise.all([\n348-        // Sum of stored snapshots for PAID bookings.\n349-        // hostNet = total − platformFee − gst − gatewayFee.\n350-        prisma.booking.aggregate({\n351-          _sum: { total: true, platformFee: true, gst: true, gatewayFee: true },\n352-          where: { eventId, status: \"PAID\", paymentMode: \"ONLINE\" },\n353-        }),\n354-        // Refund netting: APPROVED + PROCESSING + COMPLETED refunds.\n355-        prisma.refund.aggregate({\n356-          _sum: { amount: true, platformFeeRefund: true, gatewayFeeRefund: true },\n357-          where: {","is_error":false}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"91963705-b189-4ca7-8f04-266acc2d72ab","timestamp":"2026-11-20T17:38:13.143Z","tool_result_meta":[{"id":"call_01a1fa09728673c895169a13","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
