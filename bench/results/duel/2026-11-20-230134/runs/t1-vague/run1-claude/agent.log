{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0d6e4e77798809925c","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport { BookingStatus } from \"../../generated/prisma/enums\";\n3\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n4\t\n5\texport class BookingApprovalRepository {\n6\t  /**\n7\t   * Approve a buyer-initiated approval request.\n8\t   *\n9\t   * Atomic transition PENDING_APPROVAL → APPROVED_AWAITING_PAYMENT, stamping\n10\t   * the host decision metadata, the claim token + expiry, and a fresh\n11\t   * holdExpiresAt that gives the buyer a payment window. Inventory was\n12\t   * already reserved at request time so no soldCount work happens here.\n13\t   *\n14\t   * Returns null if the booking isn't in PENDING_APPROVAL anymore (race or\n15\t   * already-decided), letting the caller respond idempotently.\n16\t   */\n17\t  async approveRequestTx(input: {\n18\t    bookingId: string;\n19\t    decidedBy: string;\n20\t    claimToken: string;\n21\t    claimExpiresAt: Date;\n22\t    paymentHoldExpiresAt: Date;\n23\t  }): Promise<string | null> {\n24\t    return wrapDatabaseOperation(async () => {\n25\t      const transition = await prisma.booking.updateMany({\n26\t        where: {\n27\t          bookingId: input.bookingId,\n28\t          status: BookingStatus.PENDING_APPROVAL,\n29\t        },\n30\t        data: {\n31\t          status: BookingStatus.APPROVED_AWAITING_PAYMENT,\n32\t          approvalDecidedAt: new Date(),\n33\t          approvalDecidedBy: input.decidedBy,\n34\t          approvalClaimToken: input.claimToken,\n35\t          approvalClaimExpiry: input.claimExpiresAt,\n36\t          holdExpiresAt: input.paymentHoldExpiresAt,\n37\t        },\n38\t      });\n39\t\n40\t      return transition.count === 0 ? null : input.bookingId;\n41\t    }, \"Approve booking request\");\n42\t  }\n43\t\n44\t  /**\n45\t   * Stamp decline metadata on an already-released approval-request booking.\n46\t   * Inventory release is handled separately via releaseHoldTx(\"CANCELLED\").\n47\t   */\n48\t  async stampDeclineMetadata(input: {\n49\t    bookingId: string;\n50\t    decidedBy: string;\n51\t    reason?: string;\n52\t  }): Promise<void> {\n53\t    return wrapDatabaseOperation(async () => {\n54\t      await prisma.booking.update({\n55\t        where: { bookingId: input.bookingId },\n56\t        data: {\n57\t          approvalDecidedAt: new Date(),\n58\t          approvalDecidedBy: input.decidedBy,\n59\t          ...(input.reason ? { approvalDeclineReason: input.reason } : {}),\n60\t        },\n61\t      });\n62\t    }, \"Stamp decline metadata\");\n63\t  }\n64\t\n65\t  /**\n66\t   * Look up an approved-awaiting-payment booking by its single-use claim\n67\t   * token. Used by the email-link landing flow on the web client.\n68\t   * Returns null when the token is unknown, expired, or already consumed\n69\t   * (i.e. booking left APPROVED_AWAITING_PAYMENT).\n70\t   */\n71\t  async findByApprovalClaimToken(token: string) {\n72\t    return wrapDatabaseOperation(async () => {\n73\t      const booking = await prisma.booking.findUnique({\n74\t        where: { approvalClaimToken: token },\n75\t        select: {\n76\t          bookingId: true,\n77\t          eventId: true,\n78\t          userId: true,\n79\t          status: true,\n80\t          approvalClaimExpiry: true,\n81\t          holdExpiresAt: true,\n82\t        },\n83\t      });\n84\t      if (!booking) return null;\n85\t      if (booking.status !== BookingStatus.APPROVED_AWAITING_PAYMENT) {\n86\t        return null;\n87\t      }\n88\t      if (\n89\t        booking.approvalClaimExpiry &&\n90\t        booking.approvalClaimExpiry < new Date()\n91\t      ) {\n92\t        return null;\n93\t      }\n94\t      return booking;\n95\t    }, \"Find booking by approval claim token\");\n96\t  }\n97\t\n98\t  /**\n99\t   * Return any live approval-flow booking (PENDING_APPROVAL or\n100\t   * APPROVED_AWAITING_PAYMENT) for a user+event whose hold has not expired.\n101\t   * Used to block duplicate approval requests.\n102\t   */\n103\t  async findActiveApprovalByUserAndEvent(userId: string, eventId: string) {\n104\t    return wrapDatabaseOperation(async () => {\n105\t      return await prisma.booking.findFirst({\n106\t        where: {\n107\t          userId,\n108\t          eventId,\n109\t          status: {\n110\t            in: [\n111\t              BookingStatus.PENDING_APPROVAL,\n112\t              BookingStatus.APPROVED_AWAITING_PAYMENT,\n113\t            ],\n114\t          },\n115\t          holdExpiresAt: { gt: new Date() },\n116\t        },\n117\t        select: { bookingId: true, status: true },\n118\t      });\n119\t    }, \"Find active approval booking by user and event\");\n120\t  }\n121\t\n122\t  /**\n123\t   * Return the most-recent APPROVED_AWAITING_PAYMENT booking for a user+event\n124\t   * whose hold has not yet expired. Used by the event page to surface a\n125\t   * \"Complete your booking\" banner without requiring the email-link token.\n126\t   */\n127\t  async findApprovedAwaitingPaymentByUserAndEvent(\n128\t    userId: string,\n129\t    eventId: string,\n130\t  ) {\n131\t    return wrapDatabaseOperation(async () => {\n132\t      return await prisma.booking.findFirst({\n133\t        where: {\n134\t          userId,\n135\t          eventId,\n136\t          status: BookingStatus.APPROVED_AWAITING_PAYMENT,\n137\t          holdExpiresAt: { gt: new Date() },\n138\t        },\n139\t        orderBy: { createdAt: \"desc\" },\n140\t        select: {\n141\t          bookingId: true,\n142\t          eventId: true,\n143\t          holdExpiresAt: true,\n144\t          total: true,\n145\t        },\n146\t      });\n147\t    }, \"Find approved-awaiting-payment booking by user and event\");\n148\t  }\n149\t}\n150\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd14770