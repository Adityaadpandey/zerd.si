\n459\t  };\n460\t\n461\t  const handleOtpKeyDown = (i: number, e: React.KeyboardEvent) => {\n462\t    if (e.key === \"Backspace\" && !otp[i] && i > 0)\n463\t      otpRefs.current[i - 1]?.focus();\n464\t  };\n465\t\n466\t  const handleOtpPaste = (e: React.ClipboardEvent) => {\n467\t    const pasted = e.clipboardData\n468\t      .getData(\"text\")\n469\t      .replace(/\\D/g, \"\")\n470\t      .slice(0, OTP_LENGTH);\n471\t    if (!pasted) return;\n472\t    e.preventDefault();\n473\t    const next = [...otp];\n474\t    for (let i = 0; i < pasted.length; i++) next[i] = pasted[i];\n475\t    setOtp(next);\n476\t    otpRefs.current[Math.min(pasted.length, OTP_LENGTH - 1)]?.focus();\n477\t  };\n478\t\n479\t  // ─────────────────────────────────────────────────────────────────────────\n480\t  // Render\n481\t  // ─────────────────────────────────────────────────────────────────────────\n482\t\n483\t  return (\n484\t    <>\n485\t      {/* Eagerly load GIS (after the page is interactive, so it doesn't block\n486\t          first paint) so the real Google button is already live by the time\n487\t          the user clicks it — lazily loading it on click meant the first\n488\t          click only primed the script and a second click was needed to\n489\t          actually open the Google sign-in flow. */}\n490\t      <Script\n491\t        src=\"https://accounts.google.com/gsi/client\"\n492\t        strategy=\"afterInteractive\"\n493\t        onLoad={() => setGisReady(true)}\n494\t      />\n495\t      <div className=\"flex flex-col gap-7\">\n496\t        {/* ── Progress stepper ── */}\n497\t        <BookingStepper currentStep=\"details\" />\n498\t\n499\t        {/* ══════════════════════════════════════════════════════════════════════ */}\n500\t        {/* STATE: IDLE — Details form */}\n501\t        {/* ══════════════════════════════════════════════════════════════════════ */}\n502\t        {uiState === \"IDLE\" && (\n503\t          <div className=\"flex flex-col gap-5\">\n504\t 