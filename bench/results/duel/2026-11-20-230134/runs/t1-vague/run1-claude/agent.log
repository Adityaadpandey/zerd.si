{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-aade9137-fce2-4dd0-a722-e0312a8681b3","type":"tool_result","content":"3280\t  // ── State ─────────────────────────────────────────────────────────────────────\n3281\t  const [step, setStep] = useState(1);\n3282\t  const [showAuthStep, setShowAuthStep] = useState(false);\n3283\t  const [venue, setVenue] = useState<VenueDetail | null>(null);\n3284\t  const [resource, setResource] = useState<ResourceDetail | null>(null);\n3285\t\n3286\t  // RTK Query fetches — served from cache seeded by VenueDetailPageClient so\n3287\t  // there is no network round-trip when the user navigates to booking.\n3288\t  const { data: venueData, isLoading: loadingMeta } =\n3289\t    useGetVenueByIdQuery(venueId);\n3290\t\n3291\t  const [selectedDate, setSelectedDate] = useState<Date>(() => {\n3292\t    // venueData may already be warm from the venue detail page's cache\n3293\t    // (same RTK Query key) — when it is, resolve the cross-midnight\n3294\t    // operating day right away instead of defaulting to calendar-today.\n3295\t    if (!venueData) return getEffectiveOperatingDate(new Date());\n3296\t    const v = venueData.data ?? venueData;\n3297\t    const res = (v.resources ?? []).find(\n3298\t      (r: ResourceDetail) => r.resourceId === resourceId,\n3299\t    ) as ResourceDetail | undefined;\n3300\t    return getEffectiveOperatingDate(new Date(), res?.operatingHours);\n3301\t  });\n3302\t  const [slots, setSlots] = useState<SlotItem[]>([]);\n3303\t  // Once the user manually picks a date we stop auto-advancing past empty days,\n3304\t  // so a deliberately-chosen empty day shows its empty state instead of jumping.\n3305\t  const userPickedDateRef = useRef(false);\n3306\t  // Guards the one-time selectedDate correction once operatingHours loads\n3307\t  // (see the \"Derive venue + resource\" effect below) so it never fires twice.\n3308\t  const operatingDayResolvedRef = useRef(false);\n3309\t  const [selectedSlots, setSelectedSlots] = useState<string[]>([]);\n3310\t  // Only meaningful when resource.durationPricing is set — tracks which\n3311\t  // duration tab (in minutes) is active in the duration-first picker.\n3312\t  const [selectedDurationTier, setSelectedDurationTier] = useState<\n3313\t    number | null\n3314\t  >(null);\n3315\t  // Ordered list of committed duration-tier blocks for a composed booking\n3316\t  // (e.g. a 60-min block + a 30-min block = a 90-min booking). selectedSlots\n3317\t  // is kept in lockstep as the flattened union of all blocks' cells — it\n3318\t  // remains the source of truth for date-range display and the hold/quote\n3319\t  // request's overall startTime/endTime.\n3320\t  const [selectedBlocks, setSelectedBlocks] = useState<SelectedBlock[]>([]);\n3321\t\n3322\t  const [playerCount, setPlayerCount] = useState(1);\n3323\t  const [selectedAddOns, setSelectedAddOns] = useState<string[]>([]);\n3324\t\n3325\t  const [quote, setQuote] = useState<PriceBreakdown | null>(null);\n3326\t  const [loadingQuote, setLoadingQuote] = useState(false);\n3327\t\n3328\t  const [discountCode, setDiscountCode] = useState(\"\");\n3329\t  const [discountError, setDiscountError] = useState(\"\");\n3330\t\n3331\t  const [holdLoading, setHoldLoading] = useState(false);\n3332\t  const [holdResult, setHoldResult] = useState<HoldResult | null>(null);\n3333\t  const [holdExpired, setHoldExpired] = useState(false);\n3334\t  const [_hasTriedPayment, setHasTriedPayment] = useState(false);\n3335\t  // Mirrors the event PaymentStep status machine so retry behaves the same:\n3336\t  // \"idle\" (initial / after dismiss), \"opening\" (order + SDK load), \"verifying\"\n3337\t  // (confirm-payment in flight), \"error\" (any failure → show retry button).\n3338\t  const [paymentStatus, setPaymentStatus] = useState<\n3339\t    \"idle\" | \"opening\" | \"verifying\" | \"error\"\n3340\t  >(\"idle\");\n3341\t  const [paymentErrorMsg, setPaymentErrorMsg] = useState(\"\");\n3342\t\n3343\t  const [splitEnabled, setSplitEnabled] = useState(false);\n3344\t  // Venue package redemption: the user's active package for this resource (if\n3345\t  // any) and whether the redemption toggle is on. `packagePurchaseId` is only\n3346\t  // sent to /slots/hold when the toggle is on AND the package actually covers\n3347\t  // part of the selected duration.\n3348\t  const [activePackage, setActivePackage] =\n3349\t    useState<ActivePackagePurchase | null>(null);\n3350\t  const [redemptionEnabled, setRedemptionEnabled] = useState(false);\n3351\t  const [paymentMethod, setPaymentMethod] = useState<\"ONLINE\" | \"PAY_AT_VENUE\">(\n3352\t    \"ONLINE\",\n3353\t  );\n3354\t  const [teammates, setTeammates] = useState<Teammate[]>([]);\n3355\t  const [waitingSplit, setWaitingSplit] = useState<{\n3356\t    splitPaymentId: string;\n3357\t    slotBookingId: string;\n3358\t  } | null>(null);\n3359\t\n3360\t  // Keep teammates in sync with playerCount / total\n3361\t  useEffect(() => {\n3362\t    if (!splitEnabled) return;\n3363\t    const nextCount = Math.max(0, playerCount - 1);\n3364\t    if (teammates.length !== nextCount) {\n3365\t      setTeammates((prev) =>\n3366\t        reconcileTeammates(prev, playerCount, quote?.total ?? 0),\n3367\t      );\n3368\t    }\n3369\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n3370\t  }, [playerCount, splitEnabled, quote?.total, teammates.length]);\n3371\t\n3372\t  // Auto-disable split when conditions no longer met\n3373\t  useEffect(() => {\n3374\t    if (!splitEnabled) return;\n3375\t    if (playerCount < 2 || (quote && quote.total === 0)) {\n3376\t      setSplitEnabled(false);\n3377\t      setTeammates([]);\n3378\t    }\n3379\t  }, [splitEnabled, playerCount, quote]);\n3380\t\n3381\t  const handleToggleSplit = useCallback(\n3382\t    (v: boolean) => {\n3383\t      setSplitEnabled(v);\n3384\t      if (v) {\n3385\t        const total = quote?.total ?? 0;\n3386\t        setTeammates((prev) => {\n3387\t          if (prev.length === playerCount - 1) return prev;\n3388\t          return Array.from({ length: Math.max(0, playerCount - 1) }, () => ({\n3389\t            id: makeTeammateId(),\n3390\t            name: \"\",\n3391\t            email: \"\",\n3392\t            phone: \"\",\n3393\t            amount:\n3394\t              playerCount > 0\n3395\t                ? Math.round((total / playerCount) * 100) / 100\n3396\t                : 0,\n3397\t          }));\n3398\t        });\n3399\t      } else {\n3400\t        setTeammates([]);\n3401\t      }\n3402\t    },\n3403\t    [playerCount, quote],\n3404\t  );\n3405\t\n3406\t  // ── Derive venue + resource from RTK Query cache ──────────────────────────────\n3407\t  // venueData is served instantly from the cache seeded by VenueDetailPageClient.\n3408\t  useEffect(() => {\n3409\t    if (!venueData) return;\n3410\t    const v = venueData.data ?? venueData;\n3411\t    setVenue({\n3412\t      venueId: v.venueId,\n3413\t      name: v.name,\n3414\t      city: v.city,\n3415\t      acceptsCashOnSite: v.acceptsCashOnSite ?? false,\n3416\t      isCurrentlyPaused: v.isCurrentlyPaused === true,\n3417\t      pauseReason: v.pauseReason ?? null,\n3418\t    });\n3419\t    const res2 = (v.resources ?? []).find(\n3420\t      (r: ResourceDetail) => r.resourceId === resourceId,\n3421\t    ) as ResourceDetail | undefined;\n3422\t    if (res2) {\n3423\t      setResource(res2);\n3424\t      setPlayerCount(res2.minPlayers);\n3425\t      const cheapest = getCheapestTier(res2.durationPricing ?? []);\n3426\t      setSelectedDurationTier(cheapest?.durationMinutes ?? null);\n3427\t      // Direct-navigation case: venueData wasn't warm at mount, so the\n3428\t      // selectedDate lazy initializer above couldn't see operatingHours yet.\n3429\t      // Resolve the cross-midnight operating day now, once, before any\n3430\t      // manual pick or auto-advance has touched selectedDate.\n3431\t      if (!userPickedDateRef.current && !operatingDayResolvedRef.current) {\n3432\t        operatingDayResolvedRef.current = true;\n3433\t        const effective = getEffectiveOperatingDate(\n3434\t          new Date(),\n3435\t          res2.operatingHours,\n3436\t        );\n3437\t        setSelectedDate((prev) =>\n3438\t          prev.getTime() === effective.getTime() ? prev : effective,\n3439\t        );\n3440\t      }\n3441\t    }\n3442\t  }, [venueData, resourceId]);\n3443\t\n3444\t  // ── Fetch the user's active package for this resource ─────────────────────────\n3445\t  // Best-effort, on mount (and once the auth token is available). Calls the\n3446\t  // backend directly with the in-memory Redux Bearer token — the same auth\n3447\t  // mechanism RTK Query (`tunaiApi`) uses — so no server proxy route is needed.\n3448\t  // On any failure (401 / network) we simply render nothing new: the redemption\n3449\t  // toggle only appears when an eligible active package for THIS resource is\n3450\t  // found. Eligibility mirrors the server's redemption guard in slot.service\n3451\t  // (ACTIVE, matching resourceId, unexpired, minutes remaining).\n3452\t  useEffect(() => {\n3453\t    if (!isAuthenticated || !authToken || !resourceId) return;\n3454\t    let cancelled = false;\n3455\t    (async () => {\n3456\t      try {\n3457\t        const res = await fetch(`${API_BASE}/packages/me`, {\n3458\t          headers: { Authorization: `Bearer ${authToken}` },\n3459\t        });\n3460\t        if (!res.ok) return;\n3461\t        const json = await res.json();\n3462\t        const list = (json?.data ?? json) as ActivePackagePurchase[];\n3463\t        if (!Array.isArray(list)) return;\n3464\t        const now = Date.now();\n3465\t        const match =\n3466\t          list.find(\n3467\t            (p) =>\n3468\t              p.resourceId === resourceId &&\n3469\t              p.status === \"ACTIVE\" &&\n3470\t              (p.remainingMinutes ?? 0) > 0 &&\n3471\t              (!p.expiresAt || new Date(p.expiresAt).getTime() > now),\n3472\t          ) ?? null;\n3473\t        if (!cancelled) setActivePackage(match);\n3474\t      } catch {\n3475\t        // Non-fatal — the toggle just won't render.\n3476\t      }\n3477\t    })();\n3478\t    return () => {\n3479\t      cancelled = true;\n3480\t    };\n3481\t  }, [isAuthenticated, authToken, resourceId]);\n3482\t\n3483\t  // ── Fetch slots ───────────────────────────────────────────────────────────────\n3484\t  // Skipped entirely in walkIn mode — the QR self-serve funnel books off-grid\n3485\t  // from \"now\" via the walk-in-options fetch below, not the grid, so there is\n3486\t  // no reason to pay for the grid round-trip (and its resolution would\n3487\t  // otherwise stomp the synthetic slot the walk-in bridge effect writes).\n3488\t  const dateStr = toYYYYMMDD(selectedDate);\n3489\t  const { data: slotsData, isLoading: loadingSlots } = useGetResourceSlotsQuery(\n3490\t    { resourceId, date: dateStr, walkIn },\n3491\t    { skip: !resourceId || !!walkIn },\n3492\t  );\n3493\t\n3494\t  // Sync fetched slots into local state\n3495\t  useEffect(() => {\n3496\t    if (!slotsData) return;\n3497\t    setSlots((slotsData.data ?? slotsData) as SlotItem[]);\n3498\t    setSelectedSlots([]);\n3499\t    setSelectedBlocks([]);\n3500\t  }, [slotsData]);\n3501\t\n3502\t  // ── Walk-in (off-grid) public options ──────────────────────────────────────\n3503\t  // QR self-serve walk-ins skip the grid entirely: Step 1 starts them \"now\"\n3504\t  // and offers whole-hour durations from the genuinely-unauthenticated\n3505\t  // `/api/slot-walk-in/options-public` proxy (customers haven't signed in\n3506\t  // yet at this point in the funnel) — distinct from the staff-gated\n3507\t  // `/api/slot-walk-in/options` the dashboard walk-in form uses.\n3508\t  const [walkInOptions, setWalkInOptions] = useState<{\n3509\t    earliestStart: string;\n3510\t    maxDurationMinutes: number;\n3511\t    availableDurations: number[];\n3512\t  } | null>(null);\n3513\t  const [loadingWalkInOptions, setLoadingWalkInOptions] = useState(false);\n3514\t  const [walkInDurationMinutes, setWalkInDurationMinutes] = useState<\n3515\t    number | null\n3516\t  >(null);\n3517\t\n3518\t  useEffect(() => {\n3519\t    if (!walkIn || !venueId || !resourceId) return;\n3520\t    let cancelled = false;\n3521\t    setLoadingWalkInOptions(true);\n3522\t    (async () => {\n3523\t      try {\n3524\t        const res = await fetch(\n3525\t          `/api/slot-walk-in/options-public?venueId=${encodeURIComponent(venueId)}&resourceId=${encodeURIComponent(resourceId)}`,\n3526\t        );\n3527\t        const json = await res.json();\n3528\t        if (cancelled) return;\n3529\t        if (!res.ok) {\n3530\t          setWalkInOptions(null);\n3531\t          return;\n3532\t        }\n3533\t        const data = (json?.data ?? json) as {\n3534\t          earliestStart: string;\n3535\t          maxDurationMinutes: number;\n3536\t          availableDurations: number[];\n3537\t        };\n3538\t        setWalkInOptions(Array.isArray(data?.availableDurations) ? data : null);\n3539\t      } catch {"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"b166e02c-7422-4d41-9019-71e109dcda05","timestamp":"2026-11-20T17:40:57.739Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/app/venues/[venueId]/book/[resourceId]/BookingFunnelClient.tsx","content":"  // ── State ─────────────────────────────────────────────────────────────────────\n  const [step, setStep] = useState(1);\n  const [showAuthStep, setShowAuthStep] = useState(false);\n  const [venue, setVenue] = useState<VenueDetail | null>(null);\n  const [resource, setResource] = useState<ResourceDetail | null>(null);\n\n  // RTK Query fetches — served from cache seeded by VenueDetailPageClient so\n  // there is no network round-trip when the user navigates to booking.\n  const { data: venueData, isLoading: loadingMeta } =\n    useGetVenueByIdQuery(venueId);\n\n  const [selectedDate, setSelectedDate] = useState<Date>(() => {\n    // venueData may already be warm from the venue detail page's cache\n    // (same RTK Query key) — when it is, resolve the cross-midnight\n    // operating day right away instead of defaulting to calendar-today.\n    if (!venueData) return getEffectiveOperatingDate(new Date());\n    const v = venueData.data ?? venueData;\n    const res = (v.resources ?? []).find(\n      (r: ResourceDetail) => r.resourceId === resourceId,\n    ) as ResourceDetail | undefined;\n    return getEffectiveOperatingDate(new Date(), res?.operatingHours);\n  });\n  const [slots, setSlots] = useState<SlotItem[]>([]);\n  // Once the user manually picks a date we stop auto-advancing past empty days,\n  // so a deliberately-chosen empty day shows its empty state instead of jumping.\n  const userPickedDateRef = useRef(false);\n  // Guards the one-time selectedDate correction once operatingHours loads\n  // (see the \"Derive venue + resource\" effect below) so it never fires twice.\n  const operatingDayResolvedRef = useRef(false);\n  const [selectedSlots, setSelectedSlots] = useState<string[]>([]);\n  // Only meaningful when resource.durationPricing is set — tracks which\n  // duration tab (in minutes) is active in the duration-first picker.\n  const [selectedDurationTier, setSelectedDurationTier] = useState<\n    number | null\n  >(null);\n  // Ordered list of committed duration-tier blocks for a composed booking\n  // (e.g. a 60-min block + a 30-min block = a 90-min booking). selectedSlots\n  // is kept in lockstep as the flattened union of all blocks' cells — it\n  // remains the source of truth for date-range display and the hold/quote\n  // request's overall startTime/endTime.\n  const [selectedBlocks, setSelectedBlocks] = useState<SelectedBlock[]>([]);\n\n  const [playerCount, setPlayerCount] = useState(1);\n  const [selectedAddOns, setSelectedAddOns] = useState<string[]>([]);\n\n  const [quote, setQuote] = useState<PriceBreakdown | null>(null);\n  const [loadingQuote, setLoadingQuote] = useState(false);\n\n  const [discountCode, setDiscountCode] = useState(\"\");\n  const [discountError, setDiscountError] = useState(\"\");\n\n  const [holdLoading, setHoldLoading] = useState(false);\n  const [holdResult, setHoldResult] = useState<HoldResult | null>(null);\n  const [holdExpired, setHoldExpired] = useState(false);\n  const [_hasTriedPayment, setHasTriedPayment] = useState(false);\n  // Mirrors the event PaymentStep status machine so retry behaves the same:\n  // \"idle\" (initial / after dismiss), \"opening\" (order + SDK load), \"verifying\"\n  // (confirm-payment in flight), \"error\" (any failure → show retry button).\n  const [paymentStatus, setPaymentStatus] = useState<\n    \"idle\" | \"opening\" | \"verifying\" | \"error\"\n  >(\"idle\");\n  const [paymentErrorMsg, setPaymentErrorMsg] = useState(\"\");\n\n  const [splitEnabled, setSplitEnabled] = useState(false);\n  // Venue package redemption: the user's active package for this resource (if\n  // any) and whether the redemption toggle is on. `packagePurchaseId` is only\n  // sent to /slots/hold when the toggle is on AND the package actually covers\n  // part of the selected duration.\n  const [activePackage, setActivePackage] =\n    useState<ActivePackagePurchase | null>(null);\n  const [redemptionEnabled, setRedemptionEnabled] = useState(false);\n  const [paymentMethod, setPaymentMethod] = useState<\"ONLINE\" | \"PAY_AT_VENUE\">(\n    \"ONLINE\",\n  );\n  const [teammates, setTeammates] = useState<Teammate[]>([]);\n  const [waitingSplit, setWaitingSplit] = useState<{\n    splitPaymentId: string;\n    slotBookingId: string;\n  } | null>(null);\n\n  // Keep teammates in sync with playerCount / total\n  useEffect(() => {\n    if (!splitEnabled) return;\n    const nextCount = Math.max(0, playerCount - 1);\n    if (teammates.length !== nextCount) {\n      setTeammates((prev) =>\n        reconcileTeammates(prev, playerCount, quote?.total ?? 0),\n      );\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [playerCount, splitEnabled, quote?.total, teammates.length]);\n\n  // Auto-disable split when conditions no longer met\n  useEffect(() => {\n    if (!splitEnabled) return;\n    if (playerCount < 2 || (quote && quote.total === 0)) {\n      setSplitEnabled(false);\n      setTeammates([]);\n    }\n  }, [splitEnabled, playerCount, quote]);\n\n  const handleToggleSplit = useCallback(\n    (v: boolean) => {\n      setSplitEnabled(v);\n      if (v) {\n        const total = quote?.total ?? 0;\n        setTeammates((prev) => {\n          if (prev.length === playerCount - 1) return prev;\n          return Array.from({ length: Math.max(0, playerCount - 1) }, () => ({\n            id: makeTeammateId(),\n            name: \"\",\n            email: \"\",\n            phone: \"\",\n            amount:\n              playerCount > 0\n                ? Math.round((total / playerCount) * 100) / 100\n                : 0,\n          }));\n        });\n      } else {\n        setTeammates([]);\n      }\n    },\n    [playerCount, quote],\n  );\n\n  // ── Derive venue + resource from RTK Query cache ──────────────────────────────\n  // venueData is served instantly from the cache seeded by VenueDetailPageClient.\n  useEffect(() => {\n    if (!venueData) return;\n    const v = venueData.data ?? venueData;\n    setVenue({\n      venueId: v.venueId,\n      name: v.name,\n      city: v.city,\n      acceptsCashOnSite: v.acceptsCashOnSite ?? false,\n      isCurrentlyPaused: v.isCurrentlyPaused === true,\n      pauseReason: v.pauseReason ?? null,\n    });\n    const res2 = (v.resources ?? []).find(\n      (r: ResourceDetail) => r.resourceId === resourceId,\n    ) as ResourceDetail | undefined;\n    if (res2) {\n      setResource(res2);\n      setPlayerCount(res2.minPlayers);\n      const cheapest = getCheapestTier(res2.durationPricing ?? []);\n      setSelectedDurationTier(cheapest?.durationMinutes ?? null);\n      // Direct-navigation case: venueData wasn't warm at mount, so the\n      // selectedDate lazy initializer above couldn't see operatingHours yet.\n      // Resolve the cross-midnight operating day now, once, before any\n      // manual pick or auto-advance has touched selectedDate.\n      if (!userPickedDateRef.current && !operatingDayResolvedRef.current) {\n        operatingDayResolvedRef.current = true;\n        const effective = getEffectiveOperatingDate(\n          new Date(),\n          res2.operatingHours,\n        );\n        setSelectedDate((prev) =>\n          prev.getTime() === effective.getTime() ? prev : effective,\n        );\n      }\n    }\n  }, [venueData, resourceId]);\n\n  // ── Fetch the user's active package for this resource ─────────────────────────\n  // Best-effort, on mount (and once the auth token is available). Calls the\n  // backend directly with the in-memory Redux Bearer token — the same auth\n  // mechanism RTK Query (`tunaiApi`) uses — so no server proxy route is needed.\n  // On any failure (401 / network) we simply render nothing new: the redemption\n  // toggle only appears when an eligible active package for THIS resource is\n  // found. Eligibility mirrors the server's redemption guard in slot.service\n  // (ACTIVE, matching resourceId, unexpired, minutes remaining).\n  useEffect(() => {\n    if (!isAuthenticated || !authToken || !resourceId) return;\n    let cancelled = false;\n    (async () => {\n      try {\n        const res = await fetch(`${API_BASE}/packages/me`, {\n          headers: { Authorization: `Bearer ${authToken}` },\n        });\n        if (!res.ok) return;\n        const json = await res.json();\n        const list = (json?.data ?? json) as ActivePackagePurchase[];\n        if (!Array.isArray(list)) return;\n        const now = Date.now();\n        const match =\n          list.find(\n            (p) =>\n              p.resourceId === resourceId &&\n              p.status === \"ACTIVE\" &&\n              (p.remainingMinutes ?? 0) > 0 &&\n              (!p.expiresAt || new Date(p.expiresAt).getTime() > now),\n          ) ?? null;\n        if (!cancelled) setActivePackage(match);\n      } catch {\n        // Non-fatal — the toggle just won't render.\n      }\n    })();\n    return () => {\n      cancelled = true;\n    };\n  }, [isAuthenticated, authToken, resourceId]);\n\n  // ── Fetch slots ───────────────────────────────────────────────────────────────\n  // Skipped entirely in walkIn mode — the QR self-serve funnel books off-grid\n  // from \"now\" via the walk-in-options fetch below, not the grid, so there is\n  // no reason to pay for the grid round-trip (and its resolution would\n  // otherwise stomp the synthetic slot the walk-in bridge effect writes).\n  const dateStr = toYYYYMMDD(selectedDate);\n  const { data: slotsData, isLoading: loadingSlots } = useGetResourceSlotsQuery(\n    { resourceId, date: dateStr, walkIn },\n    { skip: !resourceId || !!walkIn },\n  );\n\n  // Sync fetched slots into local state\n  useEffect(() => {\n    if (!slotsData) return;\n    setSlots((slotsData.data ?? slotsData) as SlotItem[]);\n    setSelectedSlots([]);\n    setSelectedBlocks([]);\n  }, [slotsData]);\n\n  // ── Walk-in (off-grid) public options ──────────────────────────────────────\n  // QR self-serve walk-ins skip the grid entirely: Step 1 starts them \"now\"\n  // and offers whole-hour durations from the genuinely-unauthenticated\n  // `/api/slot-walk-in/options-public` proxy (customers haven't signed in\n  // yet at this point in the funnel) — distinct from the staff-gated\n  // `/api/slot-walk-in/options` the dashboard walk-in form uses.\n  const [walkInOptions, setWalkInOptions] = useState<{\n    earliestStart: string;\n    maxDurationMinutes: number;\n    availableDurations: number[];\n  } | null>(null);\n  const [loadingWalkInOptions, setLoadingWalkInOptions] = useState(false);\n  const [walkInDurationMinutes, setWalkInDurationMinutes] = useState<\n    number | null\n  >(null);\n\n  useEffect(() => {\n    if (!walkIn || !venueId || !resourceId) return;\n    let cancelled = false;\n    setLoadingWalkInOptions(true);\n    (async () => {\n      try {\n        const res = await fetch(\n          `/api/slot-walk-in/options-public?venueId=${encodeURIComponent(venueId)}&resourceId=${encodeURIComponent(resourceId)}`,\n        );\n        const json = await res.json();\n        if (cancelled) return;\n        if (!res.ok) {\n          setWalkInOptions(null);\n          return;\n        }\n        const data = (json?.data ?? json) as {\n          earliestStart: string;\n          maxDurationMinutes: number;\n          availableDurations: number[];\n        };\n        setWalkInOptions(Array.isArray(data?.availableDurations) ? data : null);\n      } catch {","numLines":260,"startLine":3280,"totalLines":4802}},"tool_result_meta":[{"id":"call-aade9137-fce2-4dd0-a722-e0312a8681b3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
