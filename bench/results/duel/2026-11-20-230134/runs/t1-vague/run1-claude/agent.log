{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-35ca6541-b36c-4820-9c8b-0341bf5d86dc","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { createSeatBookingLine } from \"@tunyt/shared\";\n4\timport dynamic from \"next/dynamic\";\n5\timport { useRouter } from \"next/navigation\";\n6\timport { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n7\timport { createPortal } from \"react-dom\";\n8\timport { buildTicketTypeColorMap } from \"@/components/seating/types\";\n9\timport {\n10\t  addToast,\n11\t  extractTakenSeatIds,\n12\t  type PublicSeat,\n13\t  useAppDispatch,\n14\t  useAppSelector,\n15\t  useGetPublicEventSeatMapQuery,\n16\t  useReleaseSeatsMutation,\n17\t  useSelectSeatsMutation,\n18\t} from \"@/lib/redux\";\n19\timport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n20\timport { SeatCategoryBar } from \"./seat-selection/SeatCategoryBar\";\n21\timport { SeatSelectionHeader } from \"./seat-selection/SeatSelectionHeader\";\n22\timport {\n23\t  SelectionBar,\n24\t  type SelectionSeatLine,\n25\t} from \"./seat-selection/SelectionBar\";\n26\t\n27\tconst SeatMapCanvas = dynamic(\n28\t  () =>\n29\t    import(\"@/components/seating/SeatMapCanvas\").then((m) => m.SeatMapCanvas),\n30\t  {\n31\t    ssr: false,\n32\t    loading: () => (\n33\t      <div className=\"flex flex-1 items-center justify-center text-white/40 text-[13px]\">\n34\t        Loading seat map…\n35\t      </div>\n36\t    ),\n37\t  },\n38\t);\n39\t\n40\tconst POLL_MS = 5000;\n41\t\n42\tfunction formatINR(amount: number): string {\n43\t  return `₹${amount.toLocaleString(\"en-IN\")}`;\n44\t}\n45\t\n46\texport function SeatPickerOverlay({\n47\t  eventId,\n48\t  eventTitle,\n49\t  eventSubtitle,\n50\t  onClose,\n51\t}: {\n52\t  eventId: string;\n53\t  eventTitle: string;\n54\t  eventSubtitle: string;\n55\t  onClose: () => void;\n56\t}) {\n57\t  const dispatch = useAppDispatch();\n58\t  const router = useRouter();\n59\t  const isAuthenticated = useAppSelector((s) => s.auth.isAuthenticated);\n60\t\n61\t  const {\n62\t    data: publicMap,\n63\t    isLoading,\n64\t    isError,\n65\t  } = useGetPublicEventSeatMapQuery(eventId, { pollingInterval: POLL_MS });\n66\t  const [selectSeats] = useSelectSeatsMutation();\n67\t  const [releaseSeats] = useReleaseSeatsMutation();\n68\t\n69\t  const [selectedSeatIds, setSelectedSeatIds] = useState<string[]>([]);\n70\t  const [expiresAt, setExpiresAt] = useState<string | null>(null);\n71\t  const [highlightedTicketTypeId, setHighlightedTicketTypeId] = useState<\n72\t    string | null\n73\t  >(null);\n74\t  const [unavailableMessage, setUnavailableMessage] = useState<string | null>(\n75\t    null,\n76\t  );\n77\t  const [announcement, setAnnouncement] = useState(\"\");\n78\t  const proceededRef = useRef(false);\n79\t  const selectedRef = useRef<string[]>([]);\n80\t  selectedRef.current = selectedSeatIds;\n81\t\n82\t  // BookingModal's dialog card has both a backdrop-blur and a transform-based\n83\t  // entrance animation on it — either one alone establishes a containing\n84\t  // block for `position: fixed` descendants, so without a portal this\n85\t  // overlay's `fixed inset-0` sizes itself to that ~92vh modal card instead\n86\t  // of the real viewport (squeezed/cropped map, no room for the bottom bar).\n87\t  // Portaling to document.body escapes that entirely, same pattern as\n88\t  // GlassModal/VenueShareSheet/etc. elsewhere in this app.\n89\t  const [mounted, setMounted] = useState(false);\n90\t  useEffect(() => {\n91\t    setMounted(true);\n92\t  }, []);\n93\t\n94\t  // Best-effort release of anything still held if the buyer just closes the\n95\t  // picker instead of proceeding — otherwise those seats sit HELD until the\n96\t  // server-side hold TTL expires on its own.\n97\t  useEffect(() => {\n98\t    return () => {\n99\t      if (proceededRef.current) return;\n100\t      if (selectedRef.current.length > 0) {\n101\t        releaseSeats({ eventId, seatIds: selectedRef.current });\n102\t      }\n103\t    };\n104\t  }, [eventId, releaseSeats]);\n105\t\n106\t  const ticketTypeColors = useMemo(\n107\t    () => buildTicketTypeColorMap(publicMap?.ticketTypes ?? []),\n108\t    [publicMap?.ticketTypes],\n109\t  );\n110\t\n111\t  const seatById = useMemo(() => {\n112\t    const map = new Map<string, PublicSeat>();\n113\t    for (const s of publicMap?.seats ?? []) map.set(s.seatId, s);\n114\t    return map;\n115\t  }, [publicMap?.seats]);\n116\t\n117\t  const canvasData = useMemo(() => {\n118\t    if (!publicMap) return null;\n119\t    return {\n120\t      stage: publicMap.canvasJson?.stage ?? null,\n121\t      canvasWidth: publicMap.canvasJson?.canvasWidth ?? 1400,\n122\t      canvasHeight: publicMap.canvasJson?.canvasHeight ?? 1000,\n123\t      // `seats` (materialized Seat rows) is the source of truth for both\n124\t      // ticketTypeId and live status — canvasJson only carries the drawing\n125\t      // (x/y/labels) and its seatId is never backfilled post-publish, so it\n126\t      // can't be used to look up category here.\n127\t      seats: publicMap.seats.map((s) => ({\n128\t        tempId: s.seatId,\n129\t        seatId: s.seatId,\n130\t        rowLabel: s.rowLabel,\n131\t        seatNumber: s.seatNumber,\n132\t        x: s.x,\n133\t        y: s.y,\n134\t        ticketTypeId: s.ticketTypeId ?? null,\n135\t        status: s.status,\n136\t        accessible: s.isAccessible ?? false,\n137\t      })),\n138\t    };\n139\t  }, [publicMap]);\n140\t\n141\t  // ── Real-time edge case: a held-then-booked seat disappears from under a\n142\t  // buyer who still has it selected (someone else's hold beat ours, or our\n143\t  // own hold silently expired server-side ahead of the client countdown).\n144\t  // BOOKED is the only status the public feed can tell us was pulled away\n145\t  // from *us* specifically — a plain HELD is indistinguishable from our own\n146\t  // hold with no holder id on the public payload.\n147\t  const prevBookedRef = useRef<Set<string>>(new Set());\n148\t  useEffect(() => {\n149\t    if (!publicMap) return;\n150\t    const takenAway = publicMap.seats.filter(\n151\t      (s) =>\n152\t        s.status === \"BOOKED\" &&\n153\t        selectedRef.current.includes(s.seatId) &&\n154\t        !prevBookedRef.current.has(s.seatId),\n155\t    );\n156\t    prevBookedRef.current = new Set(\n157\t      publicMap.seats.filter((s) => s.status === \"BOOKED\").map((s) => s.seatId),\n158\t    );\n159\t    if (takenAway.length === 0) return;\n160\t\n161\t    const labels = takenAway.map((s) => `${s.rowLabel}${s.seatNumber}`);\n162\t    setSelectedSeatIds((prev) =>\n163\t      prev.filter((id) => !takenAway.some((s) => s.seatId === id)),\n164\t    );\n165\t    setUnavailableMessage(\n166\t      `${labels.join(\", \")} ${labels.length > 1 ? \"are\" : \"is\"} no longer available. Please choose another seat.`,\n167\t    );\n168\t  }, [publicMap]);\n169\t\n170\t  const handleSelectionChange = useCallback(\n171\t    (nextIds: string[]) => {\n172\t      if (!isAuthenticated) {\n173\t        dispatch(\n174\t          addToast({\n175\t            message: \"Sign in to select your seats\",\n176\t            variant: \"info\",\n177\t          }),\n178\t        );\n179\t        router.push(\"/auth\");\n180\t        return;\n181\t      }\n182\t\n183\t      const added = nextIds.filter((id) => !selectedSeatIds.includes(id));\n184\t      const removed = selectedSeatIds.filter((id) => !nextIds.includes(id));\n185\t\n186\t      if (removed.length > 0) {\n187\t        setSelectedSeatIds((prev) =>\n188\t          prev.filter((id) => !removed.includes(id)),\n189\t        );\n190\t        releaseSeats({ eventId, seatIds: removed });\n191\t        const seat = seatById.get(removed[0]);\n192\t        if (seat) {\n193\t          setAnnouncement(\n194\t            `Removed Row ${seat.rowLabel} Seat ${seat.seatNumber}`,\n195\t          );\n196\t        }\n197\t      }\n198\t\n199\t      if (added.length > 0) {\n200\t        // Optimistic — reverted below if the server says someone beat us to it.\n201\t        setSelectedSeatIds((prev) => [...prev, ...added]);\n202\t        const seat = seatById.get(added[0]);\n203\t        if (seat) {\n204\t          const tt = publicMap?.ticketTypes.find(\n205\t            (t) => t.ticketTypeId === seat.ticketTypeId,\n206\t          );\n207\t          setAnnouncement(\n208\t            `Selected Row ${seat.rowLabel} Seat ${seat.seatNumber}${tt ? `, ${tt.name}, ${formatINR(tt.discountedPrice ?? tt.price)}` : \"\"}`,\n209\t          );\n210\t        }\n211\t        selectSeats({ eventId, seatIds: added })\n212\t          .unwrap()\n213\t          .then((res) => {\n214\t            setExpiresAt(res.expiresAt);\n215\t          })\n216\t          .catch((err) => {\n217\t            const taken = extractTakenSeatIds(\n218\t              (err as { data?: unknown })?.data,\n219\t            );\n220\t            const stillBlocked = taken.length > 0 ? taken : added;\n221\t            setSelectedSeatIds((prev) =>\n222\t              prev.filter((id) => !stillBlocked.includes(id)),\n223\t            );\n224\t            dispatch(\n225\t              addToast({\n226\t                message: \"One of those seats was just taken — try another.\",\n227\t                variant: \"warning\",\n228\t              }),\n229\t            );\n230\t          });\n231\t      }\n232\t    },\n233\t    [\n234\t      isAuthenticated,\n235\t      selectedSeatIds,\n236\t      eventId,\n237\t      selectSeats,\n238\t      releaseSeats,\n239\t      dispatch,\n240\t      router,\n241\t      seatById,\n242\t      publicMap?.ticketTypes,\n243\t    ],\n244\t  );\n245\t\n246\t  const removeSeat = useCallback(\n247\t    (seatId: string) => {\n248\t      handleSelectionChange(selectedSeatIds.filter((id) => id !== seatId));\n249\t    },\n250\t    [handleSelectionChange, selectedSeatIds],\n251\t  );\n252\t\n253\t  const handleExpire = useCallback(() => {\n254\t    dispatch(\n255\t      addToast({\n256\t        message: \"Your seat hold expired — please pick again.\",\n257\t        variant: \"warning\",\n258\t      }),\n259\t    );\n260\t    setSelectedSeatIds([]);"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"cd94a4cd-79cb-42d0-a0ee-6f8405d6bfa3","timestamp":"2026-11-20T17:45:27.944Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/components/booking/SeatPickerOverlay.tsx","content":"\"use client\";\n\nimport { createSeatBookingLine } from \"@tunyt/shared\";\nimport dynamic from \"next/dynamic\";\nimport { useRouter } from \"next/navigation\";\nimport { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\nimport { createPortal } from \"react-dom\";\nimport { buildTicketTypeColorMap } from \"@/components/seating/types\";\nimport {\n  addToast,\n  extractTakenSeatIds,\n  type PublicSeat,\n  useAppDispatch,\n  useAppSelector,\n  useGetPublicEventSeatMapQuery,\n  useReleaseSeatsMutation,\n  useSelectSeatsMutation,\n} from \"@/lib/redux\";\nimport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\nimport { SeatCategoryBar } from \"./seat-selection/SeatCategoryBar\";\nimport { SeatSelectionHeader } from \"./seat-selection/SeatSelectionHeader\";\nimport {\n  SelectionBar,\n  type SelectionSeatLine,\n} from \"./seat-selection/SelectionBar\";\n\nconst SeatMapCanvas = dynamic(\n  () =>\n    import(\"@/components/seating/SeatMapCanvas\").then((m) => m.SeatMapCanvas),\n  {\n    ssr: false,\n    loading: () => (\n      <div className=\"flex flex-1 items-center justify-center text-white/40 text-[13px]\">\n        Loading seat map…\n      </div>\n    ),\n  },\n);\n\nconst POLL_MS = 5000;\n\nfunction formatINR(amount: number): string {\n  return `₹${amount.toLocaleString(\"en-IN\")}`;\n}\n\nexport function SeatPickerOverlay({\n  eventId,\n  eventTitle,\n  eventSubtitle,\n  onClose,\n}: {\n  eventId: string;\n  eventTitle: string;\n  eventSubtitle: string;\n  onClose: () => void;\n}) {\n  const dispatch = useAppDispatch();\n  const router = useRouter();\n  const isAuthenticated = useAppSelector((s) => s.auth.isAuthenticated);\n\n  const {\n    data: publicMap,\n    isLoading,\n    isError,\n  } = useGetPublicEventSeatMapQuery(eventId, { pollingInterval: POLL_MS });\n  const [selectSeats] = useSelectSeatsMutation();\n  const [releaseSeats] = useReleaseSeatsMutation();\n\n  const [selectedSeatIds, setSelectedSeatIds] = useState<string[]>([]);\n  const [expiresAt, setExpiresAt] = useState<string | null>(null);\n  const [highlightedTicketTypeId, setHighlightedTicketTypeId] = useState<\n    string | null\n  >(null);\n  const [unavailableMessage, setUnavailableMessage] = useState<string | null>(\n    null,\n  );\n  const [announcement, setAnnouncement] = useState(\"\");\n  const proceededRef = useRef(false);\n  const selectedRef = useRef<string[]>([]);\n  selectedRef.current = selectedSeatIds;\n\n  // BookingModal's dialog card has both a backdrop-blur and a transform-based\n  // entrance animation on it — either one alone establishes a containing\n  // block for `position: fixed` descendants, so without a portal this\n  // overlay's `fixed inset-0` sizes itself to that ~92vh modal card instead\n  // of the real viewport (squeezed/cropped map, no room for the bottom bar).\n  // Portaling to document.body escapes that entirely, same pattern as\n  // GlassModal/VenueShareSheet/etc. elsewhere in this app.\n  const [mounted, setMounted] = useState(false);\n  useEffect(() => {\n    setMounted(true);\n  }, []);\n\n  // Best-effort release of anything still held if the buyer just closes the\n  // picker instead of proceeding — otherwise those seats sit HELD until the\n  // server-side hold TTL expires on its own.\n  useEffect(() => {\n    return () => {\n      if (proceededRef.current) return;\n      if (selectedRef.current.length > 0) {\n        releaseSeats({ eventId, seatIds: selectedRef.current });\n      }\n    };\n  }, [eventId, releaseSeats]);\n\n  const ticketTypeColors = useMemo(\n    () => buildTicketTypeColorMap(publicMap?.ticketTypes ?? []),\n    [publicMap?.ticketTypes],\n  );\n\n  const seatById = useMemo(() => {\n    const map = new Map<string, PublicSeat>();\n    for (const s of publicMap?.seats ?? []) map.set(s.seatId, s);\n    return map;\n  }, [publicMap?.seats]);\n\n  const canvasData = useMemo(() => {\n    if (!publicMap) return null;\n    return {\n      stage: publicMap.canvasJson?.stage ?? null,\n      canvasWidth: publicMap.canvasJson?.canvasWidth ?? 1400,\n      canvasHeight: publicMap.canvasJson?.canvasHeight ?? 1000,\n      // `seats` (materialized Seat rows) is the source of truth for both\n      // ticketTypeId and live status — canvasJson only carries the drawing\n      // (x/y/labels) and its seatId is never backfilled post-publish, so it\n      // can't be used to look up category here.\n      seats: publicMap.seats.map((s) => ({\n        tempId: s.seatId,\n        seatId: s.seatId,\n        rowLabel: s.rowLabel,\n        seatNumber: s.seatNumber,\n        x: s.x,\n        y: s.y,\n        ticketTypeId: s.ticketTypeId ?? null,\n        status: s.status,\n        accessible: s.isAccessible ?? false,\n      })),\n    };\n  }, [publicMap]);\n\n  // ── Real-time edge case: a held-then-booked seat disappears from under a\n  // buyer who still has it selected (someone else's hold beat ours, or our\n  // own hold silently expired server-side ahead of the client countdown).\n  // BOOKED is the only status the public feed can tell us was pulled away\n  // from *us* specifically — a plain HELD is indistinguishable from our own\n  // hold with no holder id on the public payload.\n  const prevBookedRef = useRef<Set<string>>(new Set());\n  useEffect(() => {\n    if (!publicMap) return;\n    const takenAway = publicMap.seats.filter(\n      (s) =>\n        s.status === \"BOOKED\" &&\n        selectedRef.current.includes(s.seatId) &&\n        !prevBookedRef.current.has(s.seatId),\n    );\n    prevBookedRef.current = new Set(\n      publicMap.seats.filter((s) => s.status === \"BOOKED\").map((s) => s.seatId),\n    );\n    if (takenAway.length === 0) return;\n\n    const labels = takenAway.map((s) => `${s.rowLabel}${s.seatNumber}`);\n    setSelectedSeatIds((prev) =>\n      prev.filter((id) => !takenAway.some((s) => s.seatId === id)),\n    );\n    setUnavailableMessage(\n      `${labels.join(\", \")} ${labels.length > 1 ? \"are\" : \"is\"} no longer available. Please choose another seat.`,\n    );\n  }, [publicMap]);\n\n  const handleSelectionChange = useCallback(\n    (nextIds: string[]) => {\n      if (!isAuthenticated) {\n        dispatch(\n          addToast({\n            message: \"Sign in to select your seats\",\n            variant: \"info\",\n          }),\n        );\n        router.push(\"/auth\");\n        return;\n      }\n\n      const added = nextIds.filter((id) => !selectedSeatIds.includes(id));\n      const removed = selectedSeatIds.filter((id) => !nextIds.includes(id));\n\n      if (removed.length > 0) {\n        setSelectedSeatIds((prev) =>\n          prev.filter((id) => !removed.includes(id)),\n        );\n        releaseSeats({ eventId, seatIds: removed });\n        const seat = seatById.get(removed[0]);\n        if (seat) {\n          setAnnouncement(\n            `Removed Row ${seat.rowLabel} Seat ${seat.seatNumber}`,\n          );\n        }\n      }\n\n      if (added.length > 0) {\n        // Optimistic — reverted below if the server says someone beat us to it.\n        setSelectedSeatIds((prev) => [...prev, ...added]);\n        const seat = seatById.get(added[0]);\n        if (seat) {\n          const tt = publicMap?.ticketTypes.find(\n            (t) => t.ticketTypeId === seat.ticketTypeId,\n          );\n          setAnnouncement(\n            `Selected Row ${seat.rowLabel} Seat ${seat.seatNumber}${tt ? `, ${tt.name}, ${formatINR(tt.discountedPrice ?? tt.price)}` : \"\"}`,\n          );\n        }\n        selectSeats({ eventId, seatIds: added })\n          .unwrap()\n          .then((res) => {\n            setExpiresAt(res.expiresAt);\n          })\n          .catch((err) => {\n            const taken = extractTakenSeatIds(\n              (err as { data?: unknown })?.data,\n            );\n            const stillBlocked = taken.length > 0 ? taken : added;\n            setSelectedSeatIds((prev) =>\n              prev.filter((id) => !stillBlocked.includes(id)),\n            );\n            dispatch(\n              addToast({\n                message: \"One of those seats was just taken — try another.\",\n                variant: \"warning\",\n              }),\n            );\n          });\n      }\n    },\n    [\n      isAuthenticated,\n      selectedSeatIds,\n      eventId,\n      selectSeats,\n      releaseSeats,\n      dispatch,\n      router,\n      seatById,\n      publicMap?.ticketTypes,\n    ],\n  );\n\n  const removeSeat = useCallback(\n    (seatId: string) => {\n      handleSelectionChange(selectedSeatIds.filter((id) => id !== seatId));\n    },\n    [handleSelectionChange, selectedSeatIds],\n  );\n\n  const handleExpire = useCallback(() => {\n    dispatch(\n      addToast({\n        message: \"Your seat hold expired — please pick again.\",\n        variant: \"warning\",\n      }),\n    );\n    setSelectedSeatIds([]);","numLines":260,"startLine":1,"totalLines":375}},"tool_result_meta":[{"id":"call-35ca6541-b36c-4820-9c8b-0341bf5d86dc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
