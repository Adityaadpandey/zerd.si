_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"7cfa151b-ab82-47f9-b8a7-9b543bb01bb4","timestamp":"2026-11-20T17:35:23.546Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/components/booking/steps/AttendeesStep.tsx","content":"        return p.value.trim().length > 0;\n      }),\n    [allItems],\n  );\n\n  function handleNext() {\n    if (!isCurrentPageValid) return;\n    if (isLastPage) {\n      handleSubmit();\n    } else {\n      setCurrentPage((p) => Math.min(p + 1, totalPages - 1));\n    }\n  }\n\n  function handleBack() {\n    setCurrentPage((p) => Math.max(p - 1, 0));\n  }\n\n  const seedBookingCache = useCallback(\n    (booking: BookingResponse) => {\n      dispatch(\n        bookingsApi.util.upsertQueryData(\n          \"getBooking\",\n          booking.bookingId,\n          booking,\n        ),\n      );\n    },\n    [dispatch],\n  );\n\n  // Auto-skip when no custom fields needed — create the booking immediately.\n  // biome-ignore lint/correctness/useExhaustiveDependencies: intentional — only re-run when needsAttendees changes\n  useEffect(() => {\n    if (needsAttendees !== false) return;\n\n    if (isTeamMode) {\n      if (autoStartedRef.current) return;\n      autoStartedRef.current = true;\n      dispatch(bookingActions.setStep(6));\n      return;\n    }\n\n    if (eventId && eventFieldsData === undefined) return;\n    if (autoStartedRef.current) return;\n    if (isCreatingBookingRef.current) return;\n    if (isSubmitting) return;\n\n    autoStartedRef.current = true;\n    isCreatingBookingRef.current = true;\n\n    const submissionStartedAt = Date.now();\n\n    const items = lines.map((line) => ({\n      ticketTypeId: line.ticketTypeId,\n      quantity: line.quantity,\n      ticketFieldResponses: Array.from(\n        { length: line.quantity },\n        () => [] as FieldAnswer[],\n      ),\n    }));\n\n    (async () => {\n      try {\n        const booking = await submitBooking({\n          eventId,\n          items,\n          commonFieldResponses: [],\n          referrer: utmSource,\n          city: userCity ?? undefined,\n          state: userState ?? undefined,\n          supersedesBookingId: existingBookingId ?? undefined,\n        }).unwrap();\n\n        if (Date.now() - submissionStartedAt > 30000) {\n          console.warn(\n            \"[AttendeesStep] Discarding stale booking creation response\",\n          );\n          return;\n        }\n\n        dispatch(bookingActions.setBookingId(booking.bookingId));\n        seedBookingCache(booking);\n        saveActiveBookingId(booking.bookingId);\n        try {\n          activityTracker.track(\"booking_held\", {\n            eventId: booking.eventId,\n            bookingId: booking.bookingId,\n            total: booking.total,\n            itemCount: booking.tickets.length,\n          });\n        } catch {}\n        dispatch(\n          bookingActions.setStep(\n            mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n          ),\n        );\n      } catch (err: unknown) {\n        autoStartedRef.current = false;\n        const error = err as {\n          status?: number;\n          data?: { message?: string };\n        };\n        const serverMsg = error?.data?.message;\n        if (\n          error?.status === 409 &&\n          typeof serverMsg === \"string\" &&\n          serverMsg.startsWith(\"TICKET_SOLD_OUT\")\n        ) {\n          setSoldOutError(serverMsg);\n        } else if (\n          typeof serverMsg === \"string\" &&\n          (serverMsg.startsWith(\"ACTIVE_BOOKING_EXISTS\") ||\n            serverMsg.startsWith(\"SUPERSEDE_TARGET_NOT_HELD\"))\n        ) {\n          // The server already has a HELD booking for us. Pull the id\n          // from the sentinel, resume it, and — if it's no longer\n          // HELD — retry the create once with a clean slate so the\n          // user isn't stuck behind their own 10-minute hold.\n          const heldId =\n            typeof serverMsg === \"string\"\n              ? serverMsg.split(\":\")[1]?.trim()\n              : undefined;\n          if (heldId) {\n            const result = await tryResumeHeldBooking(heldId);\n            if (result === \"resumed\" || result === \"stuck\") return;\n            // result === \"retry\": fall through to retry below.\n          } else {\n            setSoldOutError(\n              \"You already have an in-progress booking. Please close and reopen booking to continue.\",\n            );\n            return;\n          }\n\n          // Retry the create once. The conflicting hold (if any) has\n          // been released, so this should land cleanly.\n          try {\n            const booking = await submitBooking({\n              eventId,\n              items,\n              commonFieldResponses: [],\n              referrer: utmSource,\n              city: userCity ?? undefined,\n              state: userState ?? undefined,\n              supersedesBookingId: undefined,\n            }).unwrap();\n            if (Date.now() - submissionStartedAt > 30000) {\n              console.warn(\"[AttendeesStep] Discarding stale retry response\");\n              return;\n            }\n            dispatch(bookingActions.setBookingId(booking.bookingId));\n            seedBookingCache(booking);\n            saveActiveBookingId(booking.bookingId);\n            try {\n              activityTracker.track(\"booking_held\", {\n                eventId: booking.eventId,\n                bookingId: booking.bookingId,\n                total: booking.total,\n                itemCount: booking.tickets.length,\n              });\n            } catch {}\n            dispatch(\n              bookingActions.setStep(\n                mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n              ),\n            );\n          } catch (retryErr: unknown) {\n            const rerr = retryErr as {\n              data?: { message?: string };\n            };\n            setSoldOutError(\n              rerr?.data?.message ??\n                \"We couldn't hold your tickets — please try again.\",\n            );\n          }\n        } else {\n          setSoldOutError(\n            serverMsg ?? \"We couldn't hold your tickets — please try again.\",\n          );\n        }\n      } finally {\n        isCreatingBookingRef.current = false;\n      }\n    })();\n  }, [needsAttendees]);\n\n  // Prefetch per-ticket custom fields in parallel as soon as the selection is\n  // known. The PerTicketSection components will subscribe to the same cache\n  // keys, so this removes the N+1 waterfall of mounting → fetch → render.\n  useEffect(() => {\n    if (isTeamMode || !eventId) return;\n    for (const line of lines) {\n      const tt = ticketTypes.find((t) => t.ticketTypeId === line.ticketTypeId);\n      if ((tt?._count?.CustomField ?? 0) > 0 && line.ticketTypeId) {\n        dispatch(\n          ticketsApi.endpoints.getCustomFields.initiate(line.ticketTypeId, {\n            subscribe: false,\n          }),\n        );\n      }\n    }\n  }, [lines, ticketTypes, isTeamMode, eventId, dispatch]);\n\n  async function handleSubmit() {\n    if (!isFormValid) return;\n    setSoldOutError(null);\n\n    const commonFieldResponses: FieldAnswer[] = Object.entries(\n      commonValues,\n    ).map(([fieldId, value]) => ({ fieldId, value }));\n\n    for (const ans of commonFieldResponses) {\n      dispatch(bookingActions.setCommonFieldResponse(ans));\n    }\n\n    if (isTeamMode) {\n      dispatch(bookingActions.setStep(6));\n      return;\n    }\n\n    const items = lines.map((line) => {\n      const ttFields = ticketValues[line.ticketTypeId] ?? {};\n      const ticketFieldResponses = Array.from(\n        { length: line.quantity },\n        (_, i) => {\n          const idxFields = ttFields[String(i)] ?? {};\n          return Object.entries(idxFields).map(([fieldId, value]) => ({\n            fieldId,\n            value,\n          }));\n        },\n      );\n      for (let i = 0; i < ticketFieldResponses.length; i++) {\n        for (const ans of ticketFieldResponses[i]) {\n          dispatch(\n            bookingActions.setTicketFieldResponse({\n              ticketTypeId: line.ticketTypeId,\n              ticketIndex: i,\n              fieldId: ans.fieldId,\n              value: ans.value,\n            }),\n          );\n        }\n      }\n      return {\n        ticketTypeId: line.ticketTypeId,\n        quantity: line.quantity,\n        ticketFieldResponses,\n      };\n    });\n\n    try {\n      const booking = await submitBooking({\n        eventId,\n        items,\n        commonFieldResponses,\n        referrer: utmSource,\n        city: userCity ?? undefined,\n        state: userState ?? undefined,\n        supersedesBookingId: existingBookingId ?? undefined,\n      }).unwrap();\n\n      dispatch(bookingActions.setBookingId(booking.bookingId));\n      saveActiveBookingId(booking.bookingId);\n      try {\n        activityTracker.track(\"booking_held\", {\n          eventId: booking.eventId,\n          bookingId: booking.bookingId,\n          total: booking.total,\n          itemCount: booking.tickets.length,\n        });\n      } catch {}\n      dispatch(\n        bookingActions.setStep(\n          mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n        ),\n      );\n    } catch (err: unknown) {\n      const error = err as { status?: number; data?: { message?: string } };\n      const serverMsg = error?.data?.message;\n      if (\n        error?.status === 409 &&\n        typeof serverMsg === \"string\" &&\n        serverMsg.startsWith(\"TICKET_SOLD_OUT\")\n      ) {\n        setSoldOutError(serverMsg);\n      } else if (\n        typeof serverMsg === \"string\" &&\n        (serverMsg.startsWith(\"ACTIVE_BOOKING_EXISTS\") ||\n          serverMsg.startsWith(\"SUPERSEDE_TARGET_NOT_HELD\"))\n      ) {\n        // A HELD booking for this event already exists server-side. Pull\n        // its id from the sentinel and resume it; if it's gone, retry\n        // this submit with a clean slate.\n        const heldId =\n          typeof serverMsg === \"string\"\n            ? serverMsg.split(\":\")[1]?.trim()\n            : undefined;\n        if (heldId) {\n          const result = await tryResumeHeldBooking(heldId);\n          if (result === \"resumed\" || result === \"stuck\") return;\n          // retry: re-submit with no supersedesBookingId; the conflicting\n          // hold has been cancelled, so a fresh booking will be created.\n          try {\n            const booking = await submitBooking({\n              eventId,\n              items,\n              commonFieldResponses,\n              referrer: utmSource,\n              city: userCity ?? undefined,\n              state: userState ?? undefined,\n              supersedesBookingId: undefined,\n            }).unwrap();\n            dispatch(bookingActions.setBookingId(booking.bookingId));\n            saveActiveBookingId(booking.bookingId);\n            try {\n              activityTracker.track(\"booking_held\", {\n                eventId: booking.eventId,\n                bookingId: booking.bookingId,\n                total: booking.total,\n                itemCount: booking.tickets.length,\n              });\n            } catch {}\n            dispatch(\n              bookingActions.setStep(\n                mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n              ),\n            );\n          } catch (retryErr: unknown) {\n            const rerr = retryErr as { data?: { message?: string } };\n            setSoldOutError(\n              rerr?.data?.message ??\n                \"We couldn't hold your tickets — please try again.\",\n            );\n          }\n        } else {\n          setSoldOutError(\n            \"You already have an in-progress booking. Please close and reopen booking to continue.\",\n          );\n        }\n      } else {\n        setSoldOutError(\n          serverMsg ?? \"We couldn't hold your tickets — please try again.\",\n        );\n      }\n    }\n  }\n\n  // Auto-skip spinner — or error state if booking creation failed\n  if (needsAttendees === undefined || needsAttendees === false) {\n    if (soldOutError) {\n      return (\n        <div className=\"flex flex-col items-center gap-5 py-10 px-2 text-center\">\n          <div className=\"size-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\">\n              <path\n                d=\"M11 7v5M11 15h.01\"\n                stroke=\"#f87171\"\n                strokeWidth=\"1.8\"\n                strokeLinecap=\"round\"\n              />\n              <circle\n                cx=\"11\"\n                cy=\"11\"\n                r=\"9\"\n                stroke=\"#f87171\"\n                strokeWidth=\"1.8\"\n              />\n            </svg>\n          </div>\n          <div className=\"flex flex-col gap-1.5\">\n            <p className=\"text-h5 font-semibold text-white tracking-[-0.02em]\">\n              Couldn&apos;t create booking\n            </p>\n            <p className=\"text-p2 text-white/52 tracking-[-0.02em] max-w-[260px]\">\n              {soldOutError}\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"h-10 px-6 rounded-full bg-white/[0.12] border border-white/[0.12] text-h5 font-semibold text-white tracking-[-0.02em] transition-[opacity,transform] duration-200 ease-out active:opacity-70 active:scale-[0.97]\"\n          >\n            Close\n          </button>\n        </div>\n      );\n    }\n    return (\n      <div\n        className=\"flex flex-col items-center gap-4 py-12\"\n        role=\"status\"\n        aria-busy=\"true\"\n      >\n        <div className=\"size-6 rounded-full border-2 border-[rgba(255,255,255,0.24)] border-t-white animate-spin\" />\n        <p className=\"text-p2 text-[rgba(255,255,255,0.64)]\">\n          Preparing your booking…\n        </p>\n      </div>\n    );","numLines":400,"startLine":600,"totalLines":1275}},"tool_result_meta":[{"id":"call-b8a20c77-eb9d-4795-ad30-83d411b6c750","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
