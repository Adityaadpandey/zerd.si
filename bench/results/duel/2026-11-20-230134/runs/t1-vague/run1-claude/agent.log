{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa064a3a731a8efb6bbe","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport PiAlertCircleSolid from \"@icons/solid/alerts/PiAlertCircleSolid\";\n4\timport PiArrowLeftStroke from \"@icons/stroke/arrows-&-chevrons/PiArrowLeftStroke\";\n5\timport PiEnvelopeDefaultStroke from \"@icons/stroke/communication/PiEnvelopeDefaultStroke\";\n6\timport PiCheckTickSingleStroke from \"@icons/stroke/general/PiCheckTickSingleStroke\";\n7\timport PiMinusDefaultStroke from \"@icons/stroke/maths/PiMinusDefaultStroke\";\n8\timport PiPlusDefaultStroke from \"@icons/stroke/maths/PiPlusDefaultStroke\";\n9\timport PiCurrencySignRupeesStroke from \"@icons/stroke/money-&-payments/PiCurrencySignRupeesStroke\";\n10\timport PiMapPinStroke from \"@icons/stroke/navigation/PiMapPinStroke\";\n11\timport PiCalendarDefaultStroke from \"@icons/stroke/time/PiCalendarDefaultStroke\";\n12\timport PiClockDefaultStroke from \"@icons/stroke/time/PiClockDefaultStroke\";\n13\timport PiUserTwoStroke from \"@icons/stroke/users/PiUserTwoStroke\";\n14\timport Image from \"next/image\";\n15\timport { useRouter } from \"next/navigation\";\n16\timport Script from \"next/script\";\n17\timport type { CSSProperties, ReactNode } from \"react\";\n18\timport { memo, useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n19\timport BookingSummary from \"@/components/booking/BookingSummary\";\n20\timport SplitEditor, {\n21\t  isTeammateRowValid,\n22\t  makeTeammateId,\n23\t  reconcileTeammates,\n24\t  type Teammate,\n25\t} from \"@/components/booking/SplitEditor\";\n26\timport WaitingForTeammates from \"@/components/booking/WaitingForTeammates\";\n27\timport { activityTracker } from \"@/lib/analytics/activity-tracker\";\n28\timport {\n29\t  type DurationTier,\n30\t  type DurationWindow,\n31\t  getCheapestTier,\n32\t  getContinuationWindow,\n33\t  getDurationWindows,\n34\t  sortTiersByDuration,\n35\t  windowMatchesSelection,\n36\t} from \"@/lib/booking/duration-slot-windows\";\n37\timport {\n38\t  getEffectiveOperatingDate,\n39\t  type OperatingHoursWeek,\n40\t} from \"@/lib/booking/venue-helpers\";\n41\timport { formatDurationLabel } from \"@/lib/booking/walkin-options\";\n42\timport { csrfHeaders, ensureCsrfToken, setCsrfCookie } from \"@/lib/csrf\";\n43\timport { loadRazorpay, openRazorpay } from \"@/lib/razorpay/loader\";\n44\timport { addToast, useAppDispatch, useAppSelector } from \"@/lib/redux\";\n45\timport { useCompleteProfileMutation } from \"@/lib/redux/api/userApi\";\n46\timport {\n47\t  useGetResourceSlotsQuery,\n48\t  useGetVenueByIdQuery,\n49\t} from \"@/lib/redux/api/venuesApi\";\n50\timport { setAuth, setOtpIdentifier } from \"@/lib/redux/slices/authSlice\";\n51\t\n52\t// ─── Types ────────────────────────────────────────────────────────────────────\n53\t\n54\tinterface SlotItem {\n55\t  startTime: string;\n56\t  endTime: string;\n57\t  status: string;\n58\t  filledCount: number;\n59\t}\n60\t\n61\tinterface ResourceDetail {\n62\t  resourceId: string;\n63\t  name: string;\n64\t  activityType: string;\n65\t  slotDurationMinutes: number;\n66\t  baseRatePerHour: number;\n67\t  minPlayers: number;\n68\t  maxPlayers: number;\n69\t  description?: string | null;\n70\t  images?: string[];\n71\t  amenities?: string[];\n72\t  addOns?: AddOn[];\n73\t  durationPricing?: DurationTier[];\n74\t  // Soft, reversible \"temporarily closed\" toggle. `isCurrentlyPaused` is\n75\t  // server-computed — used here only as a defense-in-depth UI guard; the\n76\t  // server is the actual enforcement point on hold/quote.\n77\t  isCurrentlyPaused?: boolean;\n78\t  pauseReason?: string | null;\n79\t  operatingHours?: OperatingHoursWeek | null;\n80\t}\n81\t\n82\tinterface VenueDetail {\n83\t  venueId: string;\n84\t  name: string;\n85\t  city: string;\n86\t  acceptsCashOnSite?: boolean;\n87\t  isCurrentlyPaused?: boolean;\n88\t  pauseReason?: string | null;\n89\t}\n90\t\n91\t/** One committed duration-tier block in a composed booking (see Step1). */\n92\tinterface SelectedBlock {\n93\t  durationMinutes: number;\n94\t  cellStartTimes: string[];\n95\t}\n96\t\n97\tinterface AddOn {\n98\t  addOnId: string;\n99\t  name: string;\n100\t  priceType: string;\n101\t  price: number;\n102\t}\n103\t\n104\tinterface PriceBreakdown {\n105\t  rawBase: number;\n106\t  base: number;\n107\t  todMultiplier: number;\n108\t  dowMultiplier: number;\n109\t  specialMult: number;\n110\t  memberMult: number;\n111\t  subtotal: number;\n112\t  addOnTotal: number;\n113\t  discountAmount: number;\n114\t  platformFee: number;\n115\t  gatewayFee: number;\n116\t  gst: number;\n117\t  feeBornBy: \"HOST\" | \"USER\";\n118\t  blocks?: Array<{ durationMinutes: number; price: number }>;\n119\t  // Cosmetic/display-only — present only when the resource has groupPricing\n120\t  // configured and the request's playerCount matched a tier. The charge\n121\t  // total already reflects the tier price; this is not recomputed here.\n122\t  groupTier?: { playerCount: number; pricePerHour: number };\n123\t  total: number;\n124\t  validUntil: string;\n125\t}\n126\t\n127\tinterface HoldResult {\n128\t  slotBookingId: string;\n129\t  holdExpiresAt: string;\n130\t  quote: PriceBreakdown;\n131\t}\n132\t\n133\t// ─── Helpers ──────────────────────────────────────────────────────────────────\n134\t\n135\tfunction formatTime(iso: string) {\n136\t  return new Date(iso).toLocaleTimeString(\"en-IN\", {\n137\t    hour: \"numeric\",\n138\t    minute: \"2-digit\",\n139\t    hour12: true,\n140\t    timeZone: \"Asia/Kolkata\",\n141\t  });\n142\t}\n143\t\n144\t// Compact \"12:00 - 12:45 PM\" range. The meridiem is shown once when both ends\n145\t// share it, or on each end when the slot straddles noon/midnight.\n146\tconst _rangeFmt = new Intl.DateTimeFormat(\"en-IN\", {\n147\t  hour: \"numeric\",\n148\t  minute: \"2-digit\",\n149\t  hour12: true,\n150\t  timeZone: \"Asia/Kolkata\",\n151\t});\n152\tfunction timeParts(iso: string) {\n153\t  const parts = _rangeFmt.formatToParts(new Date(iso));\n154\t  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? \"\";\n155\t  return {\n156\t    hm: `${get(\"hour\")}:${get(\"minute\")}`,\n157\t    ap: get(\"dayPeriod\").toUpperCase(),\n158\t  };\n159\t}\n160\tfunction formatTimeRange(startIso: string, endIso: string) {\n161\t  const a = timeParts(startIso);\n162\t  const b = timeParts(endIso);\n163\t  return a.ap === b.ap\n164\t    ? `${a.hm} - ${b.hm} ${b.ap}`\n165\t    : `${a.hm} ${a.ap} - ${b.hm} ${b.ap}`;\n166\t}\n167\t\n168\tfunction formatDate(iso: string) {\n169\t  return new Date(iso).toLocaleDateString(\"en-IN\", {\n170\t    weekday: \"short\",\n171\t    day: \"numeric\",\n172\t    month: \"short\",\n173\t    year: \"numeric\",\n174\t    timeZone: \"Asia/Kolkata\",\n175\t  });\n176\t}\n177\t\n178\tfunction toYYYYMMDD(d: Date): string {\n179\t  const y = d.getFullYear();\n180\t  const m = String(d.getMonth() + 1).padStart(2, \"0\");\n181\t  const day = String(d.getDate()).padStart(2, \"0\");\n182\t  return `${y}-${m}-${day}`;\n183\t}\n184\t\n185\tfunction formatCurrency(amount: number) {\n186\t  return `₹${amount.toLocaleString(\"en-IN\")}`;\n187\t}\n188\t\n189\t// Human-friendly minute count for the package redemption copy: \"1h 30m\",\n190\t// \"2h\", \"45 min\".\n191\tfunction formatMinutes(mins: number) {\n192\t  const m = Math.max(0, Math.round(mins));\n193\t  if (m < 60) return `${m} min`;\n194\t  const h = Math.floor(m / 60);\n195\t  const rem = m % 60;\n196\t  return rem === 0 ? `${h}h` : `${h}h ${rem}m`;\n197\t}\n198\t\n199\t// ─── Venue package redemption (client-side coverage math) ─────────────────────\n200\t// Mirrors the server's `applyPackageCoverage`\n201\t// (apps/server/src/utils/venue-package-pricing.util.ts) exactly. Duplicated\n202\t// rather than shared across the server/web boundary — the function is short,\n203\t// pure, and dependency-free, consistent with how `venue-pricing.ts` already\n204\t// mirrors server pricing logic client-side. Keep the two in sync if either\n205\t// changes. Coverage applies to `subtotal` only; add-ons are never covered.\n206\t// Platform/gateway/GST fees scale down by the same ratio the subtotal drops by.\n207\tconst API_BASE =\n208\t  process.env.NEXT_PUBLIC_API_URL ?? \"http://localhost:7001/api/v1\";\n209\t\n210\tinterface PackageCoverageResult {\n211\t  packageDiscountAmount: number;\n212\t  payableSubtotal: number;\n213\t  payablePlatformFee: number;\n214\t  payableGatewayFee: number;\n215\t  payableGst: number;\n216\t  payableTotal: number;\n217\t}\n218\t\n219\tfunction roundCurrency2(n: number): number {\n220\t  return Math.round(n * 100) / 100;\n221\t}\n222\t\n223\tfunction applyPackageCoverageClient(\n224\t  quote: Pick<\n225\t    PriceBreakdown,\n226\t    \"subtotal\" | \"addOnTotal\" | \"platformFee\" | \"gatewayFee\" | \"gst\"\n227\t  >,\n228\t  coveredMinutes: number,\n229\t  durationMinutes: number,\n230\t): PackageCoverageResult {\n231\t  if (coveredMinutes <= 0 || durationMinutes <= 0) {\n232\t    return {\n233\t      packageDiscountAmount: 0,\n234\t      payableSubtotal: quote.subtotal,\n235\t      payablePlatformFee: quote.platformFee,\n236\t      payableGatewayFee: quote.gatewayFee,\n237\t      payableGst: quote.gst,\n238\t      payableTotal: roundCurrency2(\n239\t        quote.subtotal +\n240\t          quote.addOnTotal +\n241\t          quote.platformFee +\n242\t          quote.gatewayFee +\n243\t          quote.gst,\n244\t      ),\n245\t    };\n246\t  }\n247\t\n248\t  const coverageRatio = Math.min(coveredMinutes / durationMinutes, 1);\n249\t  const packageDiscountAmount = roundCurrency2(quote.subtotal * coverageRatio);\n250\t  const payableSubtotal = roundCurrency2(\n251\t    quote.subtotal - packageDiscountAmount,\n252\t  );\n253\t  const payableRatio = 1 - coverageRatio;\n254\t  const payablePlatformFee = roundCurrency2(quote.platformFee * payableRatio);\n255\t  const payableGatewayFee = roundCurrency2(quote.gatewayFee * payableRatio);\n256\t  const payableGst = roundCurrency2(quote.gst * payableRatio);\n257\t  const payableTotal = roundCurrency2(\n258\t    payableSubtotal +\n259\t      quote.addOnTotal +\n260\t      payablePlatformFee +\n261\t      payableGatewayFee +\n262\t      payableGst,\n263\t  );\n264\t\n265\t  return {\n266\t    packageDiscountAmount,\n267\t    payableSubtotal,\n268\t    payablePlatformFee,\n269\t    payableGatewayFee,\n270\t    payableGst,\n271\t    payableTotal,\n272\t  };\n273\t}\n274\t\n275\tinterface WalkInDiscountResult {\n276\t  walkInDiscountAmount: number;\n277\t  payableSubtotal: number;\n278\t  payablePlatformFee: number;\n279\t  payableGatewayFee: number;\n280\t  payableGst: number;\n281\t  payableTotal: number;\n282\t}\n283\t\n284\t/**\n285\t * Client-side preview only, mirroring apps/server's\n286\t * utils/walkin-discount.util.ts — the server always recomputes this from\n287\t * its own clock at hold time and never trusts a client-sent percentage.\n288\t */\n289\tfunction computeWalkInDiscountPercentClient(elapsedMinutes: number): number {\n290\t  if (elapsedMinutes <= 0) return 0;\n291\t  const roundedMinutes = Math.floor(elapsedMinutes / 10) * 10;\n292\t  return Math.min((roundedMinutes / 60) * 100, 100);\n293\t}\n294\t\n295\tfunction applyWalkInDiscountClient(\n296\t  quote: Pick<\n297\t    PriceBreakdown,\n298\t    \"subtotal\" | \"addOnTotal\" | \"platformFee\" | \"gatewayFee\" | \"gst\"\n299\t  >,\n300\t  discountPercent: number,\n301\t  firstSlotDurationMinutes: number,\n302\t  totalDurationMinutes: number,\n303\t): WalkInDiscountResult {\n304\t  if (\n305\t    discountPercent <= 0 ||\n306\t    totalDurationMinutes <= 0 ||\n307\t    firstSlotDurationMinutes <= 0\n308\t  ) {\n309\t    return {\n310\t      walkInDiscountAmount: 0,\n311\t      payableSubtotal: quote.subtotal,\n312\t      payablePlatformFee: quote.platformFee,\n313\t      payableGatewayFee: quote.gatewayFee,\n314\t      payableGst: quote.gst,\n315\t      payableTotal: roundCurrency2(\n316\t        quote.subtotal +\n317\t          quote.addOnTotal +\n318\t          quote.platformFee +\n319\t          quote.gatewayFee +\n320\t          quote.gst,\n321\t      ),\n322\t    };\n323\t  }\n324\t\n325\t  const discountedMinutes = Math.min(\n326\t    (discountPercent / 100) * firstSlotDurationMinutes,\n327\t    totalDurationMinutes,\n328\t  );\n329\t  const ratio = discountedMinutes / totalDurationMinutes;\n330\t  const walkInDiscountAmount = roundCurrency2(quote.subtotal * ratio);\n331\t  const payableSubtotal = roundCurrency2(quote.subtotal - walkInDiscountAmount);\n332\t  const payableRatio = 1 - ratio;\n333\t  const payablePlatformFee = roundCurrency2(quote.platformFee * payableRatio);\n334\t  const payableGatewayFee = roundCurrency2(quote.gatewayFee * payableRatio);\n335\t  const payableGst = roundCurrency2(quote.gst * payableRatio);\n336\t  const payableTotal = roundCurrency2(\n337\t    payableSubtotal +\n338\t      quote.addOnTotal +\n339\t      payablePlatformFee +\n340\t      payableGatewayFee +\n341\t      payableGst,\n342\t  );\n343\t\n344\t  return {\n345\t    walkInDiscountAmount,\n346\t    payableSubtotal,\n347\t    payablePlatformFee,\n348\t    payableGatewayFee,\n349\t    payableGst,\n350\t    payableTotal,\n351\t  };\n352\t}\n353\t\n354\t/** The signed-in user's active package purchase for the current resource. */\n355\tinterface ActivePackagePurchase {\n356\t  purchaseId: string;\n357\t  resourceId: string | null;\n358\t  remainingMinutes: number | null;\n359\t  totalMinutes: number | null;\n360\t  status: string;\n361\t  expiresAt: string | null;\n362\t}\n363\t\n364\t// ─── Module-scoped static styles (memoized once) ──────────────────────────────\n365\t\n366\tconst DIVIDER_GRADIENT_RIGHT_24: CSSProperties = {\n367\t  background: \"linear-gradient(to right, transparent, rgba(255,255,255,0.24))\",\n368\t};\n369\tconst DIVIDER_GRADIENT_LEFT_24: CSSProperties = {\n370\t  background: \"linear-gradient(to left, t