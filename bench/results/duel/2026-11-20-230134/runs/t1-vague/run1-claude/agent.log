{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-7032f051-f893-454d-8d3d-a06d628998ba","type":"tool_result","content":"1\timport { config } from \"../../config/index\";\n2\timport logger from \"../../config/logger\";\n3\timport type { BookingRepository } from \"../../repositories/booking.repository\";\n4\timport type { ValidateDiscountCodeInput } from \"../../types/discount.types\";\n5\timport { distributeCoupon } from \"../../utils/coupon-pricing.util\";\n6\timport { ConflictError, ValidationError } from \"../../utils/errors.util\";\n7\timport { computeSeatPricing } from \"../../utils/fee-pricing.util\";\n8\timport { fromPaise, round2, toPaise } from \"../../utils/money.util\";\n9\timport type { DiscountService } from \"../discount.service\";\n10\timport type { BookingLifecycleService } from \"./booking-lifecycle.service\";\n11\timport type { BookingDetails } from \"./types\";\n12\t\n13\texport class BookingDiscountService {\n14\t  constructor(\n15\t    private readonly bookingRepository: BookingRepository,\n16\t    private readonly discountService: DiscountService,\n17\t    private readonly lifecycleService: BookingLifecycleService,\n18\t  ) {}\n19\t\n20\t  /**\n21\t   * Apply or clear a discount code on a HELD booking.\n22\t   *\n23\t   * - code === null  → clear any existing discount; re-run fee math at 0 coupon.\n24\t   * - code !== null  → validate via DiscountService, then distribute the discount\n25\t   *                    proportionally across lines and re-run full fee computation\n26\t   *                    (fixes the coupon-leakage bug: coupon now flows through\n27\t   *                    platformFee, gst, gatewayFee, not just booking.total).\n28\t   *\n29\t   * All fee snapshots on Booking AND Ticket rows are updated atomically.\n30\t   */\n31\t  async applyDiscount(\n32\t    userId: string,\n33\t    bookingId: string,\n34\t    code: string | null,\n35\t  ): Promise<BookingDetails> {\n36\t    const booking = await this.lifecycleService.getForOwner(userId, bookingId);\n37\t\n38\t    if (booking.status !== \"HELD\") {\n39\t      throw new ConflictError(\"Cannot modify a finalized booking\");\n40\t    }\n41\t\n42\t    // ------------------------------------------------------------------\n43\t    // Reconstruct per-line pricing data from stored Ticket snapshots.\n44\t    // Ticket.faceValue is the row-total (seatFace × qty), frozen at creation.\n45\t    // Ticket.ticketType is the live TicketType for the fee config.\n46\t    // ------------------------------------------------------------------\n47\t    const tickets = booking.tickets;\n48\t\n49\t    // couponBase = Σ Ticket.faceValue (pre-coupon subtotal, same as booking.subtotal)\n50\t    const couponBase = fromPaise(\n51\t      tickets.reduce((s, t) => s + toPaise(t.faceValue), 0),\n52\t    );\n53\t\n54\t    // Early-bird saving (already baked into faceValue vs full price)\n55\t    const earlyBirdSaving = fromPaise(\n56\t      tickets.reduce((s, t) => {\n57\t        if (!t.wasDiscounted || !t.ticketType) return s;\n58\t        const perSeatFaceP =\n59\t          t.quantity > 0 ? Math.round(toPaise(t.faceValue) / t.quantity) : 0;\n60\t        return s + (toPaise(t.ticketType.price) - perSeatFaceP) * t.quantity;\n61\t      }, 0),\n62\t    );\n63\t\n64\t    // Determine coupon discount amount\n65\t    let couponDiscount = 0;\n66\t    let discountCodeId: string | null = null;\n67\t\n68\t    if (code === null) {\n69\t      // Clear — discount = 0, reprice without coupon\n70\t      discountCodeId = null;\n71\t      couponDiscount = 0;\n72\t      logger.info(\"Booking discount cleared\", { bookingId, userId });\n73\t    } else {\n74\t      // Validate via DiscountService (DB lookup, error surfacing to buyer)\n75\t      const validateInput: ValidateDiscountCodeInput = {\n76\t        code,\n77\t        eventId: booking.event.eventId,\n78\t        orderAmount: couponBase,\n79\t      };\n80\t\n81\t      const result =\n82\t        await this.discountService.validateDiscountCode(validateInput);\n83\t\n84\t      if (!result.valid || !result.discount) {\n85\t        throw new ValidationError(result.error ?? \"Invalid discount code\");\n86\t      }\n87\t\n88\t      couponDiscount = result.discount.discountAmount;\n89\t      discountCodeId = result.discount.codeId;\n90\t    }\n91\t\n92\t    // ------------------------------------------------------------------\n93\t    // Distribute coupon across lines (proportional by seatFace × qty).\n94\t    // shares[i] = line-total coupon for ticket row i.\n95\t    // ------------------------------------------------------------------\n96\t    const pricingLines = tickets.map((t) => ({\n97\t      seatFace: t.quantity > 0 ? t.faceValue / t.quantity : 0,\n98\t      qty: t.quantity,\n99\t    }));\n100\t    const shares = distributeCoupon(pricingLines, couponDiscount);\n101\t\n102\t    // ------------------------------------------------------------------\n103\t    // Re-compute per-ticket fee snapshots with new netFace (post-coupon).\n104\t    // ------------------------------------------------------------------\n105\t    let newPlatformFeeP = 0;\n106\t    let newGatewayFeeP = 0;\n107\t    let newGstP = 0;\n108\t    let newTotalP = 0;\n109\t\n110\t    const ticketUpdates = tickets.map((t, i) => {\n111\t      const perSeatFace =\n112\t        t.quantity > 0 ? fromPaise(Math.round(toPaise(t.faceValue) / t.quantity)) : 0;\n113\t      const couponSharePerSeat = t.quantity > 0 ? shares[i] / t.quantity : 0;\n114\t      const netFace = round2(perSeatFace - couponSharePerSeat);\n115\t\n116\t      const tt = t.ticketType;\n117\t      const feeConfig = tt\n118\t        ? {\n119\t            platformfee: tt.platformfee,\n120\t            platformfeePerc: tt.platformfeePerc,\n121\t            gatewayFeePerc: tt.gatewayFeePerc,\n122\t            feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n123\t          }\n124\t        : {\n125\t            platformfee: 0,\n126\t            platformfeePerc: 0.025,\n127\t            gatewayFeePerc: 0.025,\n128\t            feeBornBy: \"HOST\" as const,\n129\t          };\n130\t\n131\t      const seat = computeSeatPricing(netFace, feeConfig, config.TUNYT_GST_ENABLED);\n132\t\n133\t      const rowPFP = toPaise(seat.platformFee) * t.quantity;\n134\t      const rowGFP = toPaise(seat.gatewayFee) * t.quantity;\n135\t      const rowGSTP = toPaise(seat.gst) * t.quantity;\n136\t      const rowTotalP = toPaise(seat.buyerPays) * t.quantity;\n137\t\n138\t      newPlatformFeeP += rowPFP;\n139\t      newGatewayFeeP += rowGFP;\n140\t      newGstP += rowGSTP;\n141\t      newTotalP += rowTotalP;\n142\t\n143\t      return {\n144\t        ticketId: t.ticketId,\n145\t        totalPrice: fromPaise(rowTotalP),\n146\t        platformFee: fromPaise(rowPFP),\n147\t        gatewayFee: fromPaise(rowGFP),\n148\t        gst: fromPaise(rowGSTP),\n149\t      };\n150\t    });\n151\t\n152\t    const newDiscountAmount = round2(earlyBirdSaving + couponDiscount);\n153\t    const newTotal = fromPaise(newTotalP);\n154\t\n155\t    // ------------------------------------------------------------------\n156\t    // Atomically persist Booking + Ticket snapshots.\n157\t    // ------------------------------------------------------------------\n158\t    await this.bookingRepository.repriceWithDiscount(bookingId, {\n159\t      discountCodeId,\n160\t      discountAmount: newDiscountAmount,\n161\t      platformFee: fromPaise(newPlatformFeeP),\n162\t      gatewayFee: fromPaise(newGatewayFeeP),\n163\t      gst: fromPaise(newGstP),\n164\t      total: newTotal,\n165\t      ticketUpdates,\n166\t    });\n167\t\n168\t    logger.info(\"Booking repriced with discount\", {\n169\t      bookingId,\n170\t      userId,\n171\t      code,\n172\t      couponDiscount,\n173\t      newDiscountAmount,\n174\t      newTotal,\n175\t    });\n176\t\n177\t    return this.lifecycleService.getForOwner(userId, bookingId);\n178\t  }\n179\t}\n180\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"e9ba8b90-8095-4ed3-9a67-5c95149cf55f","timestamp":"2026-11-20T17:41:27.404Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/services/booking/booking-discount.service.ts","content":"import { config } from \"../../config/index\";\nimport logger from \"../../config/logger\";\nimport type { BookingRepository } from \"../../repositories/booking.repository\";\nimport type { ValidateDiscountCodeInput } from \"../../types/discount.types\";\nimport { distributeCoupon } from \"../../utils/coupon-pricing.util\";\nimport { ConflictError, ValidationError } from \"../../utils/errors.util\";\nimport { computeSeatPricing } from \"../../utils/fee-pricing.util\";\nimport { fromPaise, round2, toPaise } from \"../../utils/money.util\";\nimport type { DiscountService } from \"../discount.service\";\nimport type { BookingLifecycleService } from \"./booking-lifecycle.service\";\nimport type { BookingDetails } from \"./types\";\n\nexport class BookingDiscountService {\n  constructor(\n    private readonly bookingRepository: BookingRepository,\n    private readonly discountService: DiscountService,\n    private readonly lifecycleService: BookingLifecycleService,\n  ) {}\n\n  /**\n   * Apply or clear a discount code on a HELD booking.\n   *\n   * - code === null  → clear any existing discount; re-run fee math at 0 coupon.\n   * - code !== null  → validate via DiscountService, then distribute the discount\n   *                    proportionally across lines and re-run full fee computation\n   *                    (fixes the coupon-leakage bug: coupon now flows through\n   *                    platformFee, gst, gatewayFee, not just booking.total).\n   *\n   * All fee snapshots on Booking AND Ticket rows are updated atomically.\n   */\n  async applyDiscount(\n    userId: string,\n    bookingId: string,\n    code: string | null,\n  ): Promise<BookingDetails> {\n    const booking = await this.lifecycleService.getForOwner(userId, bookingId);\n\n    if (booking.status !== \"HELD\") {\n      throw new ConflictError(\"Cannot modify a finalized booking\");\n    }\n\n    // ------------------------------------------------------------------\n    // Reconstruct per-line pricing data from stored Ticket snapshots.\n    // Ticket.faceValue is the row-total (seatFace × qty), frozen at creation.\n    // Ticket.ticketType is the live TicketType for the fee config.\n    // ------------------------------------------------------------------\n    const tickets = booking.tickets;\n\n    // couponBase = Σ Ticket.faceValue (pre-coupon subtotal, same as booking.subtotal)\n    const couponBase = fromPaise(\n      tickets.reduce((s, t) => s + toPaise(t.faceValue), 0),\n    );\n\n    // Early-bird saving (already baked into faceValue vs full price)\n    const earlyBirdSaving = fromPaise(\n      tickets.reduce((s, t) => {\n        if (!t.wasDiscounted || !t.ticketType) return s;\n        const perSeatFaceP =\n          t.quantity > 0 ? Math.round(toPaise(t.faceValue) / t.quantity) : 0;\n        return s + (toPaise(t.ticketType.price) - perSeatFaceP) * t.quantity;\n      }, 0),\n    );\n\n    // Determine coupon discount amount\n    let couponDiscount = 0;\n    let discountCodeId: string | null = null;\n\n    if (code === null) {\n      // Clear — discount = 0, reprice without coupon\n      discountCodeId = null;\n      couponDiscount = 0;\n      logger.info(\"Booking discount cleared\", { bookingId, userId });\n    } else {\n      // Validate via DiscountService (DB lookup, error surfacing to buyer)\n      const validateInput: ValidateDiscountCodeInput = {\n        code,\n        eventId: booking.event.eventId,\n        orderAmount: couponBase,\n      };\n\n      const result =\n        await this.discountService.validateDiscountCode(validateInput);\n\n      if (!result.valid || !result.discount) {\n        throw new ValidationError(result.error ?? \"Invalid discount code\");\n      }\n\n      couponDiscount = result.discount.discountAmount;\n      discountCodeId = result.discount.codeId;\n    }\n\n    // ------------------------------------------------------------------\n    // Distribute coupon across lines (proportional by seatFace × qty).\n    // shares[i] = line-total coupon for ticket row i.\n    // ------------------------------------------------------------------\n    const pricingLines = tickets.map((t) => ({\n      seatFace: t.quantity > 0 ? t.faceValue / t.quantity : 0,\n      qty: t.quantity,\n    }));\n    const shares = distributeCoupon(pricingLines, couponDiscount);\n\n    // ------------------------------------------------------------------\n    // Re-compute per-ticket fee snapshots with new netFace (post-coupon).\n    // ------------------------------------------------------------------\n    let newPlatformFeeP = 0;\n    let newGatewayFeeP = 0;\n    let newGstP = 0;\n    let newTotalP = 0;\n\n    const ticketUpdates = tickets.map((t, i) => {\n      const perSeatFace =\n        t.quantity > 0 ? fromPaise(Math.round(toPaise(t.faceValue) / t.quantity)) : 0;\n      const couponSharePerSeat = t.quantity > 0 ? shares[i] / t.quantity : 0;\n      const netFace = round2(perSeatFace - couponSharePerSeat);\n\n      const tt = t.ticketType;\n      const feeConfig = tt\n        ? {\n            platformfee: tt.platformfee,\n            platformfeePerc: tt.platformfeePerc,\n            gatewayFeePerc: tt.gatewayFeePerc,\n            feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n          }\n        : {\n            platformfee: 0,\n            platformfeePerc: 0.025,\n            gatewayFeePerc: 0.025,\n            feeBornBy: \"HOST\" as const,\n          };\n\n      const seat = computeSeatPricing(netFace, feeConfig, config.TUNYT_GST_ENABLED);\n\n      const rowPFP = toPaise(seat.platformFee) * t.quantity;\n      const rowGFP = toPaise(seat.gatewayFee) * t.quantity;\n      const rowGSTP = toPaise(seat.gst) * t.quantity;\n      const rowTotalP = toPaise(seat.buyerPays) * t.quantity;\n\n      newPlatformFeeP += rowPFP;\n      newGatewayFeeP += rowGFP;\n      newGstP += rowGSTP;\n      newTotalP += rowTotalP;\n\n      return {\n        ticketId: t.ticketId,\n        totalPrice: fromPaise(rowTotalP),\n        platformFee: fromPaise(rowPFP),\n        gatewayFee: fromPaise(rowGFP),\n        gst: fromPaise(rowGSTP),\n      };\n    });\n\n    const newDiscountAmount = round2(earlyBirdSaving + couponDiscount);\n    const newTotal = fromPaise(newTotalP);\n\n    // ------------------------------------------------------------------\n    // Atomically persist Booking + Ticket snapshots.\n    // ------------------------------------------------------------------\n    await this.bookingRepository.repriceWithDiscount(bookingId, {\n      discountCodeId,\n      discountAmount: newDiscountAmount,\n      platformFee: fromPaise(newPlatformFeeP),\n      gatewayFee: fromPaise(newGatewayFeeP),\n      gst: fromPaise(newGstP),\n      total: newTotal,\n      ticketUpdates,\n    });\n\n    logger.info(\"Booking repriced with discount\", {\n      bookingId,\n      userId,\n      code,\n      couponDiscount,\n      newDiscountAmount,\n      newTotal,\n    });\n\n    return this.lifecycleService.getForOwner(userId, bookingId);\n  }\n}\n","numLines":180,"startLine":1,"totalLines":180}},"tool_result_meta":[{"id":"call-7032f051-f893-454d-8d3d-a06d628998ba","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
