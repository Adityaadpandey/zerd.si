{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa07280670fab68b0514","type":"tool_result","content":"1\timport logger from \"../config/logger\";\n2\timport { DatabaseError, ServiceUnavailableError } from \"./errors.util\";\n3\t\n4\t/**\n5\t * Check if error is a Prisma/database error\n6\t */\n7\texport const isDatabaseError = (error: any): boolean => {\n8\t  return (\n9\t    error?.code?.startsWith(\"P\") || // Prisma error codes\n10\t    error?.message?.includes(\"prisma\") ||\n11\t    error?.message?.includes(\"database\") ||\n12\t    error?.message?.includes(\"Authentication failed\") ||\n13\t    error?.message?.includes(\"connection\") ||\n14\t    error?.name === \"PrismaClientKnownRequestError\" ||\n15\t    error?.name === \"PrismaClientUnknownRequestError\" ||\n16\t    error?.name === \"PrismaClientRustPanicError\" ||\n17\t    error?.name === \"PrismaClientInitializationError\" ||\n18\t    error?.name === \"PrismaClientValidationError\"\n19\t  );\n20\t};\n21\t\n22\t/**\n23\t * Wrap database operations to catch and sanitize errors\n24\t */\n25\texport const wrapDatabaseOperation = async <T>(\n26\t  operation: () => Promise<T>,\n27\t  operationName: string = \"Database operation\",\n28\t): Promise<T> => {\n29\t  try {\n30\t    return await operation();\n31\t  } catch (error: any) {\n32\t    // Log the actual error for debugging\n33\t    logger.error(`${operationName} failed`, {\n34\t      error: error.message,\n35\t      code: error.code,\n36\t      meta: error.meta,\n37\t      stack: error.stack,\n38\t    });\n39\t\n40\t    // Check for specific Prisma error codes\n41\t    if (error.code) {\n42\t      switch (error.code) {\n43\t        case \"P1001\": // Can't reach database server\n44\t        case \"P1002\": // Database server timeout\n45\t        case \"P1008\": // Operations timed out\n46\t        case \"P1017\": // Server closed connection\n47\t        case \"P2024\": // Timed out fetching a connection from the pool\n48\t        case \"P2037\": // Postgres refused: too many connections open\n49\t          throw new ServiceUnavailableError(\n50\t            \"Database is temporarily unavailable. Please try again later.\",\n51\t          );\n52\t\n53\t        case \"P2002\": {\n54\t          // Unique constraint violation\n55\t          const target = error.meta?.target || \"field\";\n56\t          throw new DatabaseError(`Duplicate ${target} already exists`);\n57\t        }\n58\t\n59\t        case \"P2003\": // Foreign key constraint violation\n60\t          throw new DatabaseError(\"Related record not found\");\n61\t\n62\t        case \"P2025\": // Record not found\n63\t          throw new DatabaseError(\"Record not found\");\n64\t\n65\t        default:\n66\t          // Generic database error - don't expose details\n67\t          throw new DatabaseError(\n68\t            \"A database error occurred. Please try again later.\",\n69\t          );\n70\t      }\n71\t    }\n72\t\n73\t    // If it's a database error but no specific code\n74\t    if (isDatabaseError(error)) {\n75\t      throw new ServiceUnavailableError(\n76\t        \"Service temporarily unavailable. Please try again later.\",\n77\t      );\n78\t    }\n79\t\n80\t    // Re-throw if it's not a database error\n81\t    throw error;\n82\t  }\n83\t};\n84\t\n85\t/**\n86\t * Sanitize database error message for client response\n87\t */\n88\texport const sanitizeDatabaseError = (error: any): string => {\n89\t  // Never expose actual database error messages to clients\n90\t  if (isDatabaseError(error)) {\n91\t    // Check for connection errors\n92\t    if (\n93\t      error.code === \"P1001\" ||\n94\t      error.code === \"P1002\" ||\n95\t      error.code === \"P1008\" ||\n96\t      error.code === \"P1017\" ||\n97\t      error.code === \"P2024\" ||\n98\t      error.code === \"P2037\" ||\n99\t      error.message?.includes(\"Authentication failed\") ||\n100\t      error.message?.includes(\"connection\")\n101\t    ) {\n102\t      return \"Service temporarily unavailable. Please try again later.\";\n103\t    }\n104\t\n105\t    // Generic database error\n106\t    return \"A database error occurred. Please try again later.\";\n107\t  }\n108\t\n109\t  // Return original message if not a database error\n110\t  return error.message || \"An error occurred\";\n111\t};\n112\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"efd9529a-bd7d-47fe-b165-3383e0459d1b","timestamp":"2026-11-20T17:35:36.746Z","tool_result_meta":[{"id":"call_01a1fa07280670fab68b0514","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0729b47198afd3764c","type":"tool_result","content":"1\timport type { Request, Response } from \"express\";\n2\timport { ZodError } from \"zod\";\n3\timport { config } from \"../config\";\n4\timport logger from \"../config/logger\";\n5\timport { isAppError } from \"./errors.util\";\n6\timport { formatZodError, getZodErrorMessage } from \"./format-zod-error.util\";\n7\t\n8\t/**\n9\t * Centralized error handler for controllers\n10\t * Automatically determines the appropriate error response based on error type\n11\t */\n12\texport const ErrorHandler = {\n13\t  /**\n14\t   * Handle any error and send appropriate response\n15\t   */\n16\t  handle(error: unknown, req: Request, res: Response, context?: string): Response {\n17\t    // Single errorId shared by the log line and the client response so the\n18\t    // client-visible ID is always greppable in prod logs.\n19\t    const errorId = crypto.randomUUID().slice(0, 8);\n20\t\n21\t    // Log the error with context\n22\t    ErrorHandler.logError(error, req, context, errorId);\n23\t\n24\t    // Handle Zod validation errors\n25\t    if (error instanceof ZodError) {\n26\t      const formattedErrors = formatZodError(error);\n27\t      return sendError(res, getZodErrorMessage(error), 400, formattedErrors, errorId);\n28\t    }\n29\t\n30\t    // Handle custom AppErrors\n31\t    if (isAppError(error)) {\n32\t      return sendError(res, error.message, error.statusCode, null, errorId);\n33\t    }\n34\t\n35\t    // Handle unexpected errors\n36\t    return ErrorHandler.handleUnexpectedError(error, res, errorId);\n37\t  },\n38\t\n39\t  /**\n40\t   * Handle unexpected errors (non-operational)\n41\t   */\n42\t  handleUnexpectedError(error: unknown, res: Response, errorId: string): Response {\n43\t    const message =\n44\t      error instanceof Error ? error.message : \"An unexpected error occurred\";\n45\t\n46\t    // Don't expose internal error details in production\n47\t    const clientMessage =\n48\t      config.NODE_ENV === \"production\" ? `Internal server error (ID: ${errorId})` : message;\n49\t\n50\t    return sendError(res, clientMessage, 500, null, errorId);\n51\t  },\n52\t\n53\t  /**\n54\t   * Log error with appropriate level and context\n55\t   */\n56\t  logError(error: unknown, req: Request, context?: string, errorId?: string): void {\n57\t    const errorInfo = {\n58\t      errorId,\n59\t      context,\n60\t      path: req.path,\n61\t      method: req.method,\n62\t      requestId: (req as any).requestId,\n63\t      body: ErrorHandler.sanitizeBody(req.body),\n64\t      query: req.query,\n65\t      params: req.params,\n66\t    };\n67\t\n68\t    if (error instanceof ZodError) {\n69\t      logger.warn(\"Validation error\", {\n70\t        ...errorInfo,\n71\t        errors: formatZodError(error),\n72\t      });\n73\t    } else if (isAppError(error) && error.isOperational) {\n74\t      logger.warn(\"Operational error\", {\n75\t        ...errorInfo,\n76\t        error: error.message,\n77\t        statusCode: error.statusCode,\n78\t      });\n79\t    } else {\n80\t      logger.error(\"Unexpected error\", {\n81\t        ...errorInfo,\n82\t        error: error instanceof Error ? error.message : String(error),\n83\t        stack: error instanceof Error ? error.stack : undefined,\n84\t      });\n85\t    }\n86\t  },\n87\t\n88\t  /**\n89\t   * Remove sensitive data from request body before logging\n90\t   */\n91\t  sanitizeBody(body: any): any {\n92\t    if (!body) return body;\n93\t\n94\t    const sensitiveFields = [\"password\", \"token\", \"otp\", \"secret\", \"apiKey\"];\n95\t    const sanitized = { ...body };\n96\t\n97\t    for (const field of sensitiveFields) {\n98\t      if (sanitized[field]) {\n99\t        sanitized[field] = \"[REDACTED]\";\n100\t      }\n101\t    }\n102\t\n103\t    return sanitized;\n104\t  },\n105\t};\n106\t\n107\t/**\n108\t * Async error wrapper for controller methods\n109\t * Automatically catches and handles errors\n110\t */\n111\texport function asyncHandler(\n112\t  fn: (req: Request, res: Response) => Promise<any>,\n113\t  context?: string,\n114\t) {\n115\t  return async (req: Request, res: Response): Promise<Response> => {\n116\t    try {\n117\t      return await fn(req, res);\n118\t    } catch (error) {\n119\t      return ErrorHandler.handle(error, req, res, context);\n120\t    }\n121\t  };\n122\t}\n123\t\n124\t/**\n125\t * Decorator for controller methods (TypeScript decorator)\n126\t * Usage: @HandleErrors('Operation description')\n127\t */\n128\texport function HandleErrors(context?: string) {\n129\t  return (\n130\t    _target: any,\n131\t    propertyKey: string,\n132\t    descriptor: PropertyDescriptor,\n133\t  ) => {\n134\t    const originalMethod = descriptor.value;\n135\t\n136\t    descriptor.value = async function (req: Request, res: Response) {\n137\t      try {\n138\t        return await originalMethod.apply(this, [req, res]);\n139\t      } catch (error) {\n140\t        return ErrorHandler.handle(error, req, res, context || propertyKey);\n141\t      }\n142\t    };\n143\t\n144\t    return descriptor;\n145\t  };\n146\t}\n147\t\n148\texport const sendError = (\n149\t  res: Response,\n150\t  message: string | object,\n151\t  statusCode = 400,\n152\t  errors: any[] | null = null,\n153\t  errorId: string = crypto.randomUUID().slice(0, 8),\n154\t) => {\n155\t  const req = res.req as Request;\n156\t  return res.status(statusCode).json({\n157\t    status: \"error\",\n158\t    errorId,\n159\t    message,\n160\t    ...(errors && { errors }),\n161\t    ...(req?.requestId && { requestId: req.requestId }),\n162\t  });\n163\t};\n164\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"0cd8d20e-99a9-42e6-9577-912416037c7e","timestamp":"2026-11-20T17:35:37.146Z","tool_result_meta":[{"id":"call_01a1fa0729b47198afd3764c","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa072a92716e8f5aea63","type":"tool_result","content":"1\timport crypto from \"node:crypto\";\n2\timport { config } from \"../../config\";\n3\timport { prisma } from \"../../config/db\";\n4\timport logger from \"../../config/logger\";\n5\timport { PUSH_COPY } from \"../../lib/push-copy\";\n6\timport { BookingRepository } from \"../../repositories/booking.repository\";\n7\timport { PaymentRepository } from \"../../repositories/payment.repository\";\n8\timport { RazorpayConfigRepository } from \"../../repositories/razorpay-config.repository\";\n9\timport { SlotBookingRepository } from \"../../repositories/slot-booking.repository\";\n10\timport { TicketRepository } from \"../../repositories/ticket.repository\";\n11\timport type { RazorpayWebhook } from \"../../types/payment.types\";\n12\timport { PAYMENT_ERROR_MESSAGES } from \"../../types/payment.types\";\n13\timport { decrypt } from \"../../utils/encryption.util\";\n14\timport { BadRequestError } from \"../../utils/errors.util\";\n15\timport { toPaise } from \"../../utils/money.util\";\n16\timport { runWebhookOnce } from \"../../utils/webhook-dedup.util\";\n17\timport { PushService } from \"../push.service\";\n18\timport { SlotBookingService } from \"../slot-booking.service\";\n19\timport { SlotInventoryService } from \"../slot-inventory.service\";\n20\timport { SlotSplitService } from \"../slot-split.service\";\n21\timport { BookingPaymentFinalizerService } from \"./booking-payment-finalizer.service\";\n22\t\n23\t// Events that carry a payment-link ID, on either the platform or a\n24\t// lister's own connected Razorpay account.\n25\tconst PAYMENT_LINK_EVENTS = new Set([\n26\t  \"payment_link.paid\",\n27\t  \"payment.captured\",\n28\t  \"order.paid\",\n29\t]);\n30\t\n31\texport class PaymentWebhookService {\n32\t  private paymentRepository: PaymentRepository;\n33\t  private ticketRepository: TicketRepository;\n34\t  private bookingRepository: BookingRepository;\n35\t  private slotBookingRepository: SlotBookingRepository;\n36\t  private razorpayConfigRepository: RazorpayConfigRepository;\n37\t  private splitService: SlotSplitService;\n38\t  private finalizer: BookingPaymentFinalizerService;\n39\t\n40\t  constructor(\n41\t    paymentRepository?: PaymentRepository,\n42\t    ticketRepository?: TicketRepository,\n43\t    finalizer?: BookingPaymentFinalizerService,\n44\t  ) {\n45\t    this.paymentRepository = paymentRepository ?? new PaymentRepository();\n46\t    this.ticketRepository = ticketRepository ?? new TicketRepository();\n47\t    this.bookingRepository = new BookingRepository();\n48\t    this.slotBookingRepository = new SlotBookingRepository();\n49\t    this.razorpayConfigRepository = new RazorpayConfigRepository();\n50\t    this.splitService = new SlotSplitService();\n51\t    this.finalizer = finalizer ?? new BookingPaymentFinalizerService();\n52\t  }\n53\t\n54\t  /**\n55\t   * Handle Razorpay webhook\n56\t   */\n57\t  async handleWebhook(\n58\t    webhookBody: RazorpayWebhook,\n59\t    signature: string,\n60\t    rawBody: string,\n61\t  ) {\n62\t    // Verify webhook signature against the raw request body (avoids JSON canonicalization bypass)\n63\t    if (!config.RAZORPAY_WEBHOOK_SECRET) {\n64\t      logger.error(\n65\t        \"RAZORPAY_WEBHOOK_SECRET is not configured — refusing to verify webhook signature\",\n66\t      );\n67\t      throw new BadRequestError(\n68\t        PAYMENT_ERROR_MESSAGES.WEBHOOK_VERIFICATION_FAILED,\n69\t      );\n70\t    }\n71\t    const expectedSignature = crypto\n72\t      .createHmac(\"sha256\", config.RAZORPAY_WEBHOOK_SECRET)\n73\t      .update(rawBody)\n74\t      .digest(\"hex\");\n75\t\n76\t    const expectedBuf = Buffer.from(expectedSignature);\n77\t    const signatureBuf = Buffer.from(signature);\n78\t    if (\n79\t      expectedBuf.length !== signatureBuf.length ||\n80\t      !crypto.timingSafeEqual(expectedBuf, signatureBuf)\n81\t    ) {\n82\t      logger.error(\"Webhook signature verification failed\");\n83\t      throw new BadRequestError(\n84\t        PAYMENT_ERROR_MESSAGES.WEBHOOK_VERIFICATION_FAILED,\n85\t      );\n86\t    }\n87\t\n88\t    const { event, payload } = webhookBody;\n89\t\n90\t    // Resolve identifiers from either shape Razorpay sends:\n91\t    //   payment_link.paid → payload.payment_link.entity\n92\t    //   payment.captured/order.paid → payload.payment.entity\n93\t    // Payment-link notes are copied to the payment on some Razorpay flows and\n94\t    // remain only on the payment_link entity on others, so inspect both.\n95\t    const paymentLinkEntity = payload.payment_link?.entity;\n96\t    const paymentLinkId =\n97\t      paymentLinkEntity?.id ?? payload.payment?.entity?.payment_link_id;\n98\t\n99\t    const payment = payload.payment?.entity;\n100\t    const paymentNotes = payment?.notes ?? paymentLinkEntity?.notes;\n101\t    const shareId =\n102\t      typeof paymentNotes?.shareId === \"string\"\n103\t        ? paymentNotes.shareId\n104\t        : undefined;\n105\t    const splitId =\n106\t      typeof paymentNotes?.splitId === \"string\"\n107\t        ? paymentNotes.splitId\n108\t        : undefined;\n109\t    let slotBookingId =\n110\t      typeof paymentNotes?.slotBookingId === \"string\"\n111\t        ? paymentNotes.slotBookingId\n112\t        : undefined;\n113\t\n114\t    // A slot-booking order stores its Razorpay order ID locally. Use it when\n115\t    // Razorpay omits the custom notes from a payment.captured payload.\n116\t    if (!slotBookingId && payment?.order_id && event === \"payment.captured\") {\n117\t      const slotBooking =\n118\t        await this.slotBookingRepository.findByRazorpayOrderId(\n119\t          payment.order_id,\n120\t        );\n121\t      slotBookingId = slotBooking?.slotBookingId;\n122\t    }\n123\t\n124\t    const isPaymentCollection =\n125\t      paymentNotes?.kind === \"walk_in_upi\" ||\n126\t      paymentNotes?.kind === \"walk_in_collect_payment\";\n127\t\n128\t    logger.info(\"Webhook received\", {\n129\t      event,\n130\t      paymentId: payment?.id,\n131\t      orderId: payment?.order_id,\n132\t      paymentLinkId,\n133\t      shareId,\n134\t      splitId,\n135\t      slotBookingId,\n136\t    });\n137\t\n138\t    // Idempotency: dedupe concurrent retries by Razorpay's event id. On failure\n139\t    // the row is removed again so the retry is not swallowed (see runWebhookOnce).\n140\t    const webhookEventId = (webhookBody as any).id as string | undefined;\n141\t    await runWebhookOnce(\n142\t      {\n143\t        claim: async () => {\n144\t          if (!webhookEventId) return true;\n145\t          try {\n146\t            await prisma.processedWebhookEvent.create({\n147\t              data: { eventId: webhookEventId, eventType: event },\n148\t            });\n149\t            return true;\n150\t          } catch (err: any) {\n151\t            if (err?.code === \"P2002\") {\n152\t              logger.info(\"Webhook duplicate: already processed, skipping\", {\n153\t                webhookEventId,\n154\t                event,\n155\t              });\n156\t              return false;\n157\t            }\n158\t            throw err;\n159\t          }\n160\t        },\n161\t        release: async () => {\n162\t          if (!webhookEventId) return;\n163\t          await prisma.processedWebhookEvent.deleteMany({\n164\t            where: { eventId: webhookEventId },\n165\t          });\n166\t        },\n167\t      },\n168\t      async () => {\n169\t        // Razorpay QR Codes: `qr_code.credited` fires when a customer pays\n170\t        // against a QR generated via `qrCode.create`. We persist the QR id on\n171\t        // the slot booking at creation, so this branch confirms the walk-in\n172\t        // booking end-to-end (status → CONFIRMED, slots → BOOKED).\n173\t        if (event === \"qr_code.credited\") {\n174\t          const qrCodeId =\n175\t            (webhookBody.payload as any)?.qr_code?.entity?.id ?? null;\n176\t          if (\n177\t            await this.tryConfirmSlotBookingFromWebhook(event, {\n178\t              qrCodeId,\n179\t              paymentId: payment?.id,\n180\t            })\n181\t          ) {\n182\t            return;\n183\t          }\n184\t          // Fall through to default processing if no slot booking matched\n185\t          // (could be a QR for a non-walk-in flow handled elsewhere later).\n186\t          // A door-sale QR: we saved a Payment row keyed by the QR id when the QR was\n187\t          // made, so feed this payment through the normal \"captured\" handling (amount\n188\t          // check, mark completed, finalize booking, email) with the QR id as order id.\n189\t          const creditedPayment = (webhookBody.payload as any)?.payment?.entity;\n190\t          if (\n191\t            qrCodeId &&\n192\t            creditedPayment &&\n193\t            (await this.paymentRepository.findByRazorpayOrderId(qrCodeId))\n194\t          ) {\n195\t            await this.handlePaymentCaptured({\n196\t              ...creditedPayment,\n197\t              order_id: qrCodeId,\n198\t            });\n199\t            return;\n200\t          }\n201\t        }\n202\t\n203\t        // Payment-link events (split payments + walk-in UPI) — try the walk-in\n204\t        // slot booking first (more specific match by link ID), then fall through\n205\t        // to the split-share path.\n206\t        if (paymentLinkId && PAYMENT_LINK_EVENTS.has(event)) {\n207\t          if (\n208\t            await this.tryConfirmSlotBookingFromWebhook(event, {\n209\t              paymentLinkId,\n210\t              paymentId: payment?.id,\n211\t            })\n212\t          ) {\n213\t            return;\n214\t          }\n215\t          await this.splitService.onSharePaid(paymentLinkId);\n216\t          return;\n217\t        }\n218\t\n219\t        // Razorpay's payment.captured payload may omit payment_link_id even when\n220\t        // the payment came from a payment link. Team split links carry shareId in\n221\t        // their notes, so use that authenticated fallback before treating the\n222\t        // event as a regular order payment.\n223\t        if (shareId && PAYMENT_LINK_EVENTS.has(event)) {\n224\t          await this.splitService.onSharePaidByShareId(shareId, splitId);\n225\t          return;\n226\t        }\n227\t\n228\t        // Slot-booking orders and walk-in collection links do not create a row in\n229\t        // the regular Payment table. Their payment.captured webhook can therefore\n230\t        // not go through handlePaymentCaptured: that method would try to update a\n231\t        // nonexistent Payment by order_id and turn a successful capture into a\n232\t        // 500. Resolve them from the signed Razorpay notes instead.\n233\t        if (slotBookingId && PAYMENT_LINK_EVENTS.has(event)) {\n234\t          if (\n235\t            await this.tryConfirmSlotBookingFromWebhook(event, {\n236\t              slotBookingId,\n237\t              paymentId: payment?.id,\n238\t              isPaymentCollection,\n239\t            })\n240\t          ) {\n241\t            return;\n242\t          }\n243\t        }\n244\t\n245\t        // Razorpay also sends payment.captured for a QR payment, often with no\n246\t        // order id. The qr_code.credited event above is the one we act on, so\n247\t        // skip this one instead of failing on a null order id.\n248\t        if (event === \"payment.captured\" && payment && !payment.order_id) {\n249\t          logger.info(\n250\t            \"Webhook: payment.captured without order id, handled via qr_code.credited\",\n251\t            { paymentId: payment.id },\n252\t          );\n253\t          return;\n254\t        }\n255\t\n256\t        // Regular order-based payments.\n257\t        if (payment) {\n258\t          await this.processWebhookEvent(event, payment);\n259\t        }\n260\t      },\n261\t    );\n262\t  }\n263\t\n264\t  /**\n265\t   * Match a QR-code or payment-link webhook event to a walk-in slot booking\n266\t   * and confirm it. Shared by the platform webhook and per-lister webhook\n267\t   * paths — a venue on its own connected Razorpay account must get the same\n268\t   * auto-confirm behavior as one on the platform account.\n269\t   * Returns true if a slot booking was matched and confirmed.\n270\t   */\n271\t  private async tryConfirmSlotBookingFromWebhook(\n272\t    event: string,\n273\t    ids: {\n274\t      qrCodeId?: string | null;\n275\t      paymentLinkId?: string | null;\n276\t      slotBookingId?: string | null;\n277\t      paymentId?: string | null;\n278\t      isPaymentCollection?: boolean;\n279\t    },\n280\t  ): Promise<boolean> {\n281\t    if (event === \"qr_code.credited\" && ids.qrCodeId) {\n282\t      const slotBooking =\n283\t        await this.slotBookingRepository.findByRazorpayQrCodeId(ids.qrCodeId);\n284\t      if (!slotBooking) {\n285\t        logger.warn(\"Webhook: qr_code.credited with no matching slot booking\", {\n286\t          qrCodeId: ids.qrCodeId,\n287\t        });\n288\t        return false;\n289\t      }\n290\t      logger.info(\"Webhook: walk-in UPI QR payment confirmed\", {\n291\t        slotBookingId: slotBooking.slotBookingId,\n292\t        qrCodeId: ids.qrCodeId,\n293\t      });\n294\t      await new SlotBookingService().confirmFromPayment(\n295\t        slotBooking.slotBookingId,\n296\t        ids.paymentId ?? ids.qrCodeId,\n297\t      );\n298\t      return true;\n299\t    }\n300\t\n301\t    if (ids.paymentLinkId && PAYMENT_LINK_EVENTS.has(event)) {\n302\t      const slotBooking =\n303\t        await this.slotBookingRepository.findByRazorpayPaymentLinkId(\n304\t          ids.paymentLinkId,\n305\t        );\n306\t      if (!slotBooking) return false;\n307\t\n308\t      if (\n309\t        slotBooking.status === \"CONFIRMED\" ||\n310\t        slotBooking.status === \"COMPLETED\"\n311\t      ) {\n312\t        // Not the original creation-confirm link — this one was minted to\n313\t        // collect an outstanding balance on an already-live walk-in\n314\t        // (pay-later collection, or a settle-triggered overtime charge).\n315\t        // confirmFromPayment would no-op here (status is already CONFIRMED\n316\t        // or, for a settled booking, COMPLETED — settle flips status\n317\t        // synchronously while the UPI payment for it confirms\n318\t        // asynchronously afterward); what actually needs to happen is\n319\t        // flipping paymentCollected.\n320\t        if (!slotBooking.paymentCollected) {\n321\t          await this.slotBookingRepository.updateStatus(\n322\t            slotBooking.slotBookingId,\n323\t            slotBooking.status,\n324\t            { paymentCollected: true, paidVia: \"UPI\", paidAt: new Date() },\n325\t          );\n326\t          logger.info(\"Webhook: walk-in payment collection confirmed\", {\n327\t            slotBookingId: slotBooking.slotBookingId,\n328\t            paymentLinkId: ids.paymentLinkId,\n329\t          });\n330\t        }\n331\t        return true;\n332\t      }\n333\t\n334\t      logger.info(\"Webhook: walk-in UPI payment confirmed\", {\n335\t        slotBookingId: slotBooking.slotBookingId,\n336\t        paymentLinkId: ids.paymentLinkId,\n337\t      });\n338\t      await new SlotBookingService().confirmFromPayment(\n339\t        slotBooking.slotBookingId,\n340\t        ids.paymentId ?? ids.paymentLinkId,\n341\t      );\n342\t      return true;\n343\t    }\n344\t\n345\t    // Payment.captured for a slot-booking order or a walk-in collection link\n346\t    // may contain only notes.slotBookingId. Resolve that form without touching\n347\t    // the regular Payment table.\n348\t    if (ids.slotBookingId && PAYMENT_LINK_EVENTS.has(event)) {\n349\t      const slotBooking = await this.slotBookingRepository.findById(\n350\t        ids.slotBookingId,\n351\t      );\n352\t      if (!slotBooking) return false;\n353\t\n354\t      if (\n355\t        slotBooking.status === \"CONFIRMED\" ||\n356\t        slotBooking.status === \"COMPLETED\"\n357\t      ) {\n358\t        if (ids.isPaymentCollection && !slotBooking.paymentCollected) {\n359\t          await this.slotBookingRepository.updateStatus(\n360\t            slotBooking.slotBookingId,\n361\t            slotBooking.status,\n362\t            { paymentCollected: true, paidVia: \"UPI\", paidAt: new Date() },\n363\t          );\n364\t          logger.info(\"Webhook: walk-in payment collection confirmed\", {\n365\t            slotBookingId: slotBooking.slotBookingId,\n366\t            paymentId: ids.paymentId,\n367\t          });\n368\t        }\n369\t        return true;\n370\t      }\n371\t\n372\t      // A capture can race cancellation/expiry. Do not let a late payment\n373\t      // resurrect a dead booking; leave it for the existing refund/ops path.\n374\t      if (slotBooking.status !== \"HELD\") {\n375\t        logger.error(\"Webhook: payment captured for non-held slot booking\", {\n376\t          slotBookingId: slotBooking.slotBookingId,\n377\t          status: slotBooking.status,\n378\t          paymentId: ids.paymentId,\n379\t        });\n380\t        return true;\n381\t      }\n382\t\n383\t      if (slotBooking.splitPaymentId) {\n384\t        if (!slotBooking.userId || !ids.paymentId) {\n385\t          logger.warn(\"Webhook: split booker payment missing payer details\", {\n386\t            slotBookingId: slotBooking.slotBookingId,\n387\t            splitPaymentId: slotBooking.splitPaymentId,\n388\t            paymentId: ids.paymentId,\n389\t          });\n390\t          return true;\n391\t        }\n392\t\n393\t        const { allPaid } = await this.splitService.markBookerSharePaid(\n394\t          slotBooking.splitPaymentId,\n395\t          slotBooking.userId,\n396\t          ids.paymentId,\n397\t        );\n398\t\n399\t        if (allPaid) {\n400\t          await this.slotBookingRepository.updateStatus(\n401\t            slotBooking.slotBookingId,\n402\t            \"CONFIRMED\",\n403\t          );\n404\t          await SlotInventoryService.confirmSlots(slotBooking.slotBookingId);\n405\t        } else {\n406\t          // The client verify route normally activates these links. Doing it\n407\t          // here too covers webhook-first delivery and keeps the split from\n408\t          // waiting for a client request that may never arrive.\n409\t          await this.splitService.activateTeammateLinks(\n410\t            slotBooking.splitPaymentId,\n411\t          );\n412\t        }\n413\t        return true;\n414\t      }\n415\t\n416\t      if (!ids.paymentId) {\n417\t        logger.warn(\"Webhook: slot booking payment ID missing\", {\n418\t          slotBookingId: slotBooking.slotBookingId,\n419\t        });\n420\t        return true;\n421\t      }\n422\t\n423\t      await new SlotBookingService().confirmFromPayment(\n424\t        slotBooking.slotBookingId,\n425\t        ids.paymentId,\n426\t      );\n427\t      return true;\n428\t    }\n429\t\n430\t    return false;\n431\t  }\n432\t\n433\t  /**\n434\t   * Handle a webhook from a lister's own Razorpay account.\n435\t   * Verifies HMAC-SHA256 using per-lister webhook secret, then processes event.\n436\t   * Returns false if signature is invalid or config is not found/active.\n437\t   */\n438\t  async handleListerWebhook(\n439\t    listerId: string,\n440\t    signature: string,\n441\t    body: unknown,\n442\t    rawBody: string,\n443\t  ): Promise<{ authorized: boolean }> {\n444\t    const listerConfig =\n445\t      await this.razorpayConfigRepository.findByListerId(listerId);\n446\t\n447\t    if (!listerConfig?.isActive || !listerConfig?.encryptedWebhookSecret) {\n448\t      logger.warn(\"Lister webhook: config not found or inactive\", { listerId });\n449\t      return { authorized: false };\n450\t    }\n451\t\n452\t    const webhookSecret = decrypt(listerConfig.encryptedWebhookSecret);\n453\t    const expectedSignature = crypto\n454\t      .createHmac(\"sha256\", webhookSecret)\n455\t      .update(rawBody)\n456\t      .digest(\"hex\");\n457\t\n458\t    const expectedBuf = Buffer.from(expectedSignature);\n459\t    const signatureBuf = Buffer.from(signature);\n460\t    if (\n461\t      expectedBuf.length !== signatureBuf.length ||\n462\t      !crypto.timingSafeEqual(expectedBuf, signatureBuf)\n463\t    ) {\n464\t      logger.warn(\"Lister webhook signature mismatch\", { listerId });\n465\t      return { authorized: false };\n466\t    }\n467\t\n468\t    const webhookBody = body as {\n469\t      id?: string;\n470\t      event: string;\n471\t      payload: {\n472\t        payment?: {\n473\t          entity: {\n474\t            id?: string;\n475\t            order_id?: string;\n476\t            payment_link_id?: string;\n477\t            notes?: Record<string, unknown>;\n478\t          };\n479\t        };\n480\t        payment_link?: {\n481\t          entity?: { id?: string; notes?: Record<string, unknown> };\n482\t        };\n483\t      };\n484\t    };\n485\t\n486\t    // Idempotency: deduplicate concurrent webhook retries using Razorpay's event ID.\n487\t    // prisma.processedWebhookEvent.create throws P2002 (unique constraint) if another instance\n488\t    // already inserted this eventId — guaranteeing exactly-once processing.\n489\t    const listerWebhookEventId = webhookBody.id;\n490\t    if (listerWebhookEventId) {\n491\t      try {\n492\t        await prisma.processedWebhookEvent.create({\n493\t          data: {\n494\t            eventId: listerWebhookEventId,\n495\t            eventType: webhookBody.event,\n496\t          },\n497\t        });\n498\t      } catch (err: any) {\n499\t        if (err?.code === \"P2002\") {\n500\t          logger.info(\"Lister webhook duplicate: already processed, skipping\", {\n501\t            webhookEventId: listerWebhookEventId,\n502\t            event: webhookBody.event,\n503\t            listerId,\n504\t          });\n505\t          return { authorized: true };\n506\t        }\n507\t        throw err;\n508\t      }\n509\t    }\n510\t\n511\t    const listerPaymentLinkEntity = webhookBody.payload?.payment_link?.entity;\n512\t    const listerPayment = webhookBody?.payload?.payment?.entity;\n513\t    const listerPaymentLinkId =\n514\t      listerPaymentLinkEntity?.id ?? listerPayment?.payment_link_id;\n515\t    const listerQrCodeId =\n516\t      (webhookBody.payload as any)?.qr_code?.entity?.id ?? null;\n517\t    const listerPaymentNotes =\n518\t      listerPayment?.notes ?? listerPaymentLinkEntity?.notes;\n519\t    const listerShareId =\n520\t      typeof listerPaymentNotes?.shareId === \"string\"\n521\t        ? listerPaymentNotes.shareId\n522\t        : undefined;\n523\t    const listerSplitId =\n524\t      typeof listerPaymentNotes?.splitId === \"string\"\n525\t        ? listerPaymentNotes.splitId\n526\t        : undefined;\n527\t    let listerSlotBookingId =\n528\t      typeof listerPaymentNotes?.slotBookingId === \"string\"\n529\t        ? listerPaymentNotes.slotBookingId\n530\t        : undefined;\n531\t    if (\n532\t      !listerSlotBookingId &&\n533\t      listerPayment?.order_id &&\n534\t      webhookBody.event === \"payment.captured\"\n535\t    ) {\n536\t      const slotBooking =\n537\t        await this.slotBookingRepository.findByRazorpayOrderId(\n538\t          listerPayment.order_id,\n539\t        );\n540\t      listerSlotBookingId = slotBooking?.slotBookingId;\n541\t    }\n542\t\n543\t    const listerIsPaymentCollection =\n544\t      listerPaymentNotes?.kind === \"walk_in_upi\" ||\n545\t      listerPaymentNotes?.kind === \"walk_in_collect_payment\";\n546\t\n547\t    const confirmed = await this.tryConfirmSlotBookingFromWebhook(\n548\t      webhookBody.event,\n549\t      {\n550\t        qrCodeId: listerQrCodeId,\n551\t        paymentLinkId: listerPaymentLinkId,\n552\t        slotBookingId: listerSlotBookingId,\n553\t        paymentId: listerPayment?.id,\n554\t        isPaymentCollection: listerIsPaymentCollection,\n555\t      },\n556\t    );\n557\t\n558\t    if (!confirmed) {\n559\t      if (listerPaymentLinkId && PAYMENT_LINK_EVENTS.has(webhookBody.event)) {\n560\t        await this.splitService.onSharePaid(listerPaymentLinkId);\n561\t      } else if (listerShareId && PAYMENT_LINK_EVENTS.has(webhookBody.event)) {\n562\t        await this.splitService.onSharePaidByShareId(\n563\t          listerShareId,\n564\t          listerSplitId,\n565\t        );\n566\t      } else if (listerPayment) {\n567\t        await this.processWebhookEvent(webhookBody.event, listerPayment);\n568\t      }\n569\t    }\n570\t\n571\t    logger.info(\"Lister webhook processed\", {\n572\t      listerId,\n573\t      event: webhookBody.event,\n574\t    });\n575\t\n576\t    return { authorized: true };\n577\t  }\n578\t\n579\t  /**\n580\t   * Process a Razorpay webhook event.\n581\t   * Called by both the platform webhook and per-lister webhook controllers.\n582\t   */\n583\t  async processWebhookEvent(event: string, payment: any): Promise<void> {\n584\t    switch (event) {\n585\t      case \"payment.captured\":\n586\t        await this.handlePaymentCaptured(payment);\n587\t        break;\n588\t      case \"payment.failed\":\n589\t        await this.handlePaymentFailed(payment);\n590\t        break;\n591\t      default:\n592\t        logger.info(\"Unhandled webhook event\", { event });\n593\t    }\n594\t  }\n595\t\n596\t  /**\n597\t   * Handle successful payment capture\n598\t   */\n599\t  async handlePaymentCaptured(payment: any) {\n600\t    // Look up the Payment row by razorpayOrderId\n601\t    const existingPayment = await this.paymentRepository.findByRazorpayOrderId(\n602\t      payment.order_id,\n603\t    );\n604\t\n605\t    // Idempotency: skip if already completed\n606\t    if (existingPayment?.status === \"COMPLETED\") {\n607\t      logger.info(\"Webhook: payment already completed, skipping\", {\n608\t        orderId: payment.order_id,\n609\t      });\n610\t      return;\n611\t    }\n612\t\n613\t    // --- Booking-based payment path ---\n614\t    const bookingId =\n615\t      existingPayment?.bookingId ??\n616\t      (payment.notes?.bookingId as string | undefined);\n617\t\n618\t    let bookingForCheck: Awaited<\n619\t      ReturnType<BookingRepository[\"findByIdWithDetails\"]>\n620\t    > | null = null;\n621\t\n622\t    if (bookingId) {\n623\t      bookingForCheck =\n624\t        await this.bookingRepository.findByIdWithDetails(bookingId);\n625\t\n626\t      // Reconcile the captured amount against the live booking total before\n627\t      // trusting this webhook. A HELD booking's total can move after this\n628\t      // order was created (coupon applied/removed via applyDiscount reprices\n629\t      // Booking+Ticket rows but never touches the existing Payment/order —\n630\t      // see createPaymentOrderForBooking's idempotency guard). A\n631\t      // payment.captured event for the OLD amount must not confirm a booking\n632\t      // now priced differently. Mirrors the guard in verifyBookingPayment.\n633\t      if (bookingForCheck.status !== \"PAID\") {\n634\t        const capturedAmount = (payment.amount as number) / 100;\n635\t        if (toPaise(capturedAmount) !== toPaise(bookingForCheck.total)) {\n636\t          logger.error(\n637\t            \"Webhook: booking payment amount mismatch — refusing to finalize\",\n638\t            {\n639\t              bookingId,\n640\t              orderId: payment.order_id,\n641\t              paymentId: payment.id,\n642\t              capturedAmount,\n643\t              bookingTotal: bookingForCheck.total,\n644\t            },\n645\t          );\n646\t          await this.paymentRepository.markAsFailed(payment.order_id, {\n647\t            failureReason: `Captured amount ₹${capturedAmount} does not match booking total ₹${bookingForCheck.total}`,\n648\t          });\n649\t          return;\n650\t        }\n651\t      }\n652\t    }\n653\t\n654\t    // Update payment record first\n655\t    await this.paymentRepository.updatePaymentVerification(payment.order_id, {\n656\t      razorpayPaymentId: payment.id,\n657\t      razorpaySignature: \"\", // Signature not available in webhook\n658\t      status: \"COMPLETED\",\n659\t      method: payment.method,\n660\t    });\n661\t\n662\t    if (bookingId && bookingForCheck) {\n663\t      try {\n664\t        if (bookingForCheck.status === \"PAID\") {\n665\t          // Two payments for one sale: staff already took cash, then the guest's\n666\t          // UPI payment landed too. There's no second ticket to refund, so mark\n667\t          // the Payment for a person to refund from the Razorpay dashboard.\n668\t          if (bookingForCheck.paymentMode === \"CASH\") {\n669\t            logger.error(\n670\t              \"Door sale: UPI payment captured after the sale was settled in cash, needs manual refund\",\n671\t              { bookingId, paymentId: payment.id, orderId: payment.order_id },\n672\t            );\n673\t            await this.paymentRepository.flagForReconciliation(\n674\t              payment.order_id,\n675\t              \"PAID_AFTER_CASH\",\n676\t            );\n677\t          }\n678\t          // Booking already PAID — but the team may still be PENDING if the\n679\t          // verify path failed midway. Re-run team confirmation idempotently.\n680\t          await this.finalizer.confirmTeamFromBookingResult(\n681\t            bookingId,\n682\t            bookingForCheck,\n683\t          );\n684\t          logger.info(\"Webhook: booking already PAID, ensured team confirmed\", {\n685\t            bookingId,\n686\t          });\n687\t          return;\n688\t        }\n689\t        const finalised = await this.finalizer.finalizePaidBooking(bookingId);\n690\t        await this.finalizer.confirmTeamFromBookingResult(bookingId, finalised);\n691\t      } catch (error) {\n692\t        logger.error(\"Webhook: failed to finalize booking payment\", {\n693\t          bookingId,\n694\t          paymentId: payment.id,\n695\t          error,\n696\t        });\n697\t        // The payment row is already COMPLETED, so a webhook retry would be skipped.\n698\t        // Mark it so a person repairs the booking instead of it silently stranding the buyer.\n699\t        await this.paymentRepository\n700\t          .flagForReconciliation(payment.order_id, \"FINALIZE_FAILED\")\n701\t          .catch(() => undefined);\n702\t      }\n703\t      return;\n704\t    }\n705\t\n706\t    // --- Legacy ticket-based payment path ---\n707\t    const ticketIdsStr = payment.notes?.ticketIds;\n708\t    if (!ticketIdsStr) {\n709\t      logger.warn(\n710\t        \"Webhook: payment captured but no ticketIds or bookingId in notes\",\n711\t        {\n712\t          orderId: payment.order_id,\n713\t        },\n714\t      );\n715\t      return;\n716\t    }\n717\t\n718\t    const ticketIds = ticketIdsStr.split(\",\");\n719\t\n720\t    // Update tickets to SUCCESS\n721\t    await this.ticketRepository.bulkUpdateTicketStatus(ticketIds, \"SUCCESS\");\n722\t    await this.ticketRepository.markSeatsBookedForTicketIds(ticketIds);\n723\t\n724\t    // TODO: legacy webhook ticket path does not add the buyer to the Google\n725\t    // Calendar event attendee list. If this path is ever used for Google Meet\n726\t    // events, add an attendee-add call here (mirroring finalizePaidBooking).\n727\t\n728\t    logger.info(\"Payment captured - tickets updated\", {\n729\t      paymentId: payment.id,\n730\t      ticketCount: ticketIds.length,\n731\t    });\n732\t  }\n733\t\n734\t  /**\n735\t   * Handle failed payment\n736\t   */\n737\t  private async handlePaymentFailed(payment: any) {\n738\t    const existingPayment = await this.paymentRepository.findByRazorpayOrderId(\n739\t      payment.order_id,\n740\t    );\n741\t\n742\t    // A concurrent payment.captured webhook already completed this order —\n743\t    // don't overwrite the COMPLETED status or release the booking.\n744\t    if (existingPayment?.status === \"COMPLETED\") {\n745\t      logger.info(\"Webhook: payment.failed skipped — order already captured\", {\n746\t        orderId: payment.order_id,\n747\t      });\n748\t      return;\n749\t    }\n750\t\n751\t    if (existingPayment) {\n752\t      await this.paymentRepository.updatePaymentVerification(payment.order_id, {\n753\t        razorpayPaymentId: payment.id,\n754\t        razorpaySignature: \"\",\n755\t        status: \"FAILED\",\n756\t        failureReason: payment.error_description || \"Payment failed\",\n757\t      });\n758\t    }\n759\t\n760\t    // --- Booking-based payment path ---\n761\t    const bookingId =\n762\t      existingPayment?.bookingId ??\n763\t      (payment.notes?.bookingId as string | undefined);\n764\t\n765\t    if (bookingId) {\n766\t      // Do NOT release the hold — the user can retry within the same Razorpay\n767\t      // order. Releasing here would cancel a booking mid-retry and lose the\n768\t      // user's money if a concurrent payment.captured is in flight.\n769\t      // The hold expires naturally via the BullMQ/sweep worker.\n770\t      const failedUserId = existingPayment?.userId;\n771\t      if (failedUserId) {\n772\t        PushService.enqueue({\n773\t          userId: failedUserId,\n774\t          ...PUSH_COPY.payment_failed(),\n775\t        });\n776\t      }\n777\t      logger.info(\"Webhook: payment failed — booking released\", {\n778\t        paymentId: payment.id,\n779\t        bookingId,\n780\t        reason: payment.error_description,\n781\t      });\n782\t      return;\n783\t    }\n784\t\n785\t    // --- Legacy ticket-based payment path ---\n786\t    const ticketIdsStr = payment.notes?.ticketIds;\n787\t    if (!ticketIdsStr) {\n788\t      logger.warn(\n789\t        \"Webhook: payment failed but no bookingId or ticketIds in notes\",\n790\t        { orderId: payment.order_id },\n791\t      );\n792\t      return;\n793\t    }\n794\t\n795\t    const ticketIds = ticketIdsStr.split(\",\");\n796\t    await this.ticketRepository.bulkUpdateTicketStatus(ticketIds, \"FAILED\");\n797\t\n798\t    logger.info(\"Webhook: payment failed — tickets marked FAILED\", {\n799\t      paymentId: payment.id,\n800\t      ticketCount: ticketIds.length,\n801\t      reason: payment.error_description,\n802\t    });\n803\t  }\n804\t}\n805\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"1e64e993-5379-4a14-83ca-a7185779b446","timestamp":"2026-11-20T17:35:37.302Z","tool_result_meta":[{"id":"call_01a1fa072a92716e8f5aea63","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
