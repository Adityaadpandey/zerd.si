{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-36e02035-8b33-4af7-a03f-3900c4698504","type":"tool_result","content":"1\timport logger from \"../config/logger\";\n2\timport { delTicketAvailabilityCache, delTicketTypeCache } from \"../lib/cache/ticket\";\n3\timport { ensureEventAccess } from \"../middleware/event-access.middleware\";\n4\timport { EventSeatMapRepository } from \"../repositories/event-seatmap.repository\";\n5\timport { TicketRepository } from \"../repositories/ticket.repository\";\n6\timport type {\n7\t  AssignSeatCategoryInput,\n8\t  UpdateEventSeatMapInput,\n9\t} from \"../types/event-seatmap.types\";\n10\timport {\n11\t  EVENT_SEAT_MAP_ERROR_MESSAGES,\n12\t  EVENT_SEAT_MAP_SUCCESS_MESSAGES,\n13\t} from \"../types/event-seatmap.types\";\n14\timport type { SeatingCanvasJson } from \"../types/seating-canvas.types\";\n15\timport { EMPTY_SEATING_CANVAS } from \"../types/seating-canvas.types\";\n16\timport {\n17\t  BadRequestError,\n18\t  ConflictError,\n19\t  ForbiddenError,\n20\t  NotFoundError,\n21\t} from \"../utils/errors.util\";\n22\t\n23\t/**\n24\t * Event Seat Map Service\n25\t * Business logic for the per-event seat map builder and publish flow.\n26\t * Post-publish editing is out of scope — PUT/assign both reject once\n27\t * publishedAt is set.\n28\t */\n29\texport class EventSeatMapService {\n30\t  private seatMapRepo: EventSeatMapRepository;\n31\t  private ticketRepo: TicketRepository;\n32\t\n33\t  constructor(\n34\t    seatMapRepo?: EventSeatMapRepository,\n35\t    ticketRepo?: TicketRepository,\n36\t  ) {\n37\t    this.seatMapRepo = seatMapRepo ?? new EventSeatMapRepository();\n38\t    this.ticketRepo = ticketRepo ?? new TicketRepository();\n39\t  }\n40\t\n41\t  /**\n42\t   * Resolves the event and checks the caller is its owner (lister) or an\n43\t   * admin. Mirrors EventSectionService.checkEventAccess /\n44\t   * ActivityService.verifyEventOwnership.\n45\t   */\n46\t  private async assertEventAccess(\n47\t    eventId: string,\n48\t    userId: string,\n49\t    userRole: string,\n50\t  ) {\n51\t    const event = await this.seatMapRepo.findEventForSeatMap(eventId);\n52\t    if (!event) {\n53\t      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.EVENT_NOT_FOUND);\n54\t    }\n55\t\n56\t    await ensureEventAccess(userId, eventId, \"MANAGER\", userRole);\n57\t\n58\t    return event;\n59\t  }\n60\t\n61\t  private async getSeatMapOrThrow(eventId: string) {\n62\t    const seatMap = await this.seatMapRepo.findByEventId(eventId);\n63\t    if (!seatMap) {\n64\t      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_FOUND);\n65\t    }\n66\t    return seatMap;\n67\t  }\n68\t\n69\t  private assertNotPublished(seatMap: { publishedAt: Date | null }) {\n70\t    if (seatMap.publishedAt) {\n71\t      throw new ConflictError(EVENT_SEAT_MAP_ERROR_MESSAGES.ALREADY_PUBLISHED);\n72\t    }\n73\t  }\n74\t\n75\t  async createSeatMap(\n76\t    eventId: string,\n77\t    userId: string,\n78\t    userRole: string,\n79\t    templateId: string | undefined,\n80\t  ) {\n81\t    const event = await this.assertEventAccess(eventId, userId, userRole);\n82\t\n83\t    if (event.seatingMode !== \"RESERVED\") {\n84\t      throw new BadRequestError(\n85\t        EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_RESERVED_SEATING,\n86\t      );\n87\t    }\n88\t\n89\t    const existing = await this.seatMapRepo.findByEventId(eventId);\n90\t    if (existing) {\n91\t      throw new ConflictError(EVENT_SEAT_MAP_ERROR_MESSAGES.ALREADY_EXISTS);\n92\t    }\n93\t\n94\t    let canvasJson: SeatingCanvasJson = EMPTY_SEATING_CANVAS;\n95\t    if (templateId) {\n96\t      const template = await this.seatMapRepo.findTemplateCanvasJson(templateId);\n97\t      if (!template) {\n98\t        throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.TEMPLATE_NOT_FOUND);\n99\t      }\n100\t      canvasJson = template.canvasJson as unknown as SeatingCanvasJson;\n101\t    }\n102\t\n103\t    const seatMap = await this.seatMapRepo.create(\n104\t      eventId,\n105\t      templateId ?? null,\n106\t      canvasJson,\n107\t    );\n108\t\n109\t    logger.info(\"Event seat map created\", {\n110\t      eventId,\n111\t      eventSeatMapId: seatMap.eventSeatMapId,\n112\t      templateId: templateId ?? null,\n113\t    });\n114\t\n115\t    return {\n116\t      seatMap,\n117\t      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.CREATED,\n118\t    };\n119\t  }\n120\t\n121\t  async getHostSeatMap(eventId: string, userId: string, userRole: string) {\n122\t    await this.assertEventAccess(eventId, userId, userRole);\n123\t\n124\t    const seatMap = await this.seatMapRepo.findByEventIdWithSeats(eventId);\n125\t    if (!seatMap) {\n126\t      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_FOUND);\n127\t    }\n128\t    return seatMap;\n129\t  }\n130\t\n131\t  async getPublicSeatMap(eventId: string) {\n132\t    const seatMap = await this.seatMapRepo.findPublicByEventId(eventId);\n133\t    if (!seatMap) {\n134\t      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_FOUND);\n135\t    }\n136\t    return seatMap;\n137\t  }\n138\t\n139\t  async updateCanvasJson(\n140\t    eventId: string,\n141\t    userId: string,\n142\t    userRole: string,\n143\t    data: UpdateEventSeatMapInput,\n144\t  ) {\n145\t    await this.assertEventAccess(eventId, userId, userRole);\n146\t\n147\t    const seatMap = await this.getSeatMapOrThrow(eventId);\n148\t    this.assertNotPublished(seatMap);\n149\t\n150\t    const updated = await this.seatMapRepo.updateCanvasJson(\n151\t      seatMap.eventSeatMapId,\n152\t      data.canvasJson,\n153\t    );\n154\t\n155\t    logger.info(\"Event seat map canvas updated\", {\n156\t      eventId,\n157\t      eventSeatMapId: seatMap.eventSeatMapId,\n158\t      seatCount: data.canvasJson.seats.length,\n159\t    });\n160\t\n161\t    return {\n162\t      seatMap: updated,\n163\t      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.UPDATED,\n164\t    };\n165\t  }\n166\t\n167\t  async assignSeats(\n168\t    eventId: string,\n169\t    userId: string,\n170\t    userRole: string,\n171\t    data: AssignSeatCategoryInput,\n172\t  ) {\n173\t    await this.assertEventAccess(eventId, userId, userRole);\n174\t\n175\t    const seatMap = await this.getSeatMapOrThrow(eventId);\n176\t    this.assertNotPublished(seatMap);\n177\t\n178\t    const ticketType = await this.ticketRepo.findTicketTypeById(\n179\t      data.ticketTypeId,\n180\t    );\n181\t    if (!ticketType) {\n182\t      throw new NotFoundError(\n183\t        EVENT_SEAT_MAP_ERROR_MESSAGES.TICKET_TYPE_NOT_FOUND,\n184\t      );\n185\t    }\n186\t    if (ticketType.eventId !== eventId) {\n187\t      throw new BadRequestError(\n188\t        EVENT_SEAT_MAP_ERROR_MESSAGES.TICKET_TYPE_WRONG_EVENT,\n189\t      );\n190\t    }\n191\t\n192\t    const canvasJson = seatMap.canvasJson as unknown as SeatingCanvasJson;\n193\t    const tempIdSet = new Set(data.seatTempIds);\n194\t    const updatedSeats = canvasJson.seats.map((seat) =>\n195\t      tempIdSet.has(seat.tempId)\n196\t        ? { ...seat, ticketTypeId: data.ticketTypeId }\n197\t        : seat,\n198\t    );\n199\t    const updatedCanvasJson: SeatingCanvasJson = {\n200\t      ...canvasJson,\n201\t      seats: updatedSeats,\n202\t    };\n203\t\n204\t    const updated = await this.seatMapRepo.updateCanvasJson(\n205\t      seatMap.eventSeatMapId,\n206\t      updatedCanvasJson,\n207\t    );\n208\t\n209\t    logger.info(\"Seats assigned to ticket type\", {\n210\t      eventId,\n211\t      eventSeatMapId: seatMap.eventSeatMapId,\n212\t      ticketTypeId: data.ticketTypeId,\n213\t      count: data.seatTempIds.length,\n214\t    });\n215\t\n216\t    return {\n217\t      seatMap: updated,\n218\t      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.ASSIGNED,\n219\t    };\n220\t  }\n221\t\n222\t  async publishSeatMap(eventId: string, userId: string, userRole: string) {\n223\t    await this.assertEventAccess(eventId, userId, userRole);\n224\t\n225\t    const seatMap = await this.getSeatMapOrThrow(eventId);\n226\t    this.assertNotPublished(seatMap);\n227\t\n228\t    const canvasJson = seatMap.canvasJson as unknown as SeatingCanvasJson;\n229\t    const seats = canvasJson.seats;\n230\t\n231\t    if (seats.length === 0) {\n232\t      throw new BadRequestError(\"Seat map has no seats to publish\");\n233\t    }\n234\t\n235\t    const unassigned = seats.filter((s) => !s.ticketTypeId);\n236\t    if (unassigned.length > 0) {\n237\t      throw new BadRequestError(\n238\t        EVENT_SEAT_MAP_ERROR_MESSAGES.UNASSIGNED_SEATS(unassigned.length),\n239\t      );\n240\t    }\n241\t\n242\t    const { seatMap: publishedSeatMap, quantityByTicketType } =\n243\t      await this.seatMapRepo.publish(\n244\t        seatMap.eventSeatMapId,\n245\t        seats.map((s) => ({\n246\t          rowLabel: s.rowLabel,\n247\t          seatNumber: s.seatNumber,\n248\t          x: s.x,\n249\t          y: s.y,\n250\t          rotation: s.rotation ?? 0,\n251\t          ticketTypeId: s.ticketTypeId as string,\n252\t          isAccessible: s.accessible ?? false,\n253\t        })),\n254\t      );\n255\t\n256\t    // Inventory changed (TicketType.quantity) — invalidate the same caches\n257\t    // booking.service invalidates after any inventory-affecting write.\n258\t    await delTicketTypeCache(eventId);\n259\t    await Promise.all(\n260\t      quantityByTicketType.map(({ ticketTypeId }) =>\n261\t        delTicketAvailabilityCache(ticketTypeId),\n262\t      ),\n263\t    );\n264\t\n265\t    logger.info(\"Event seat map published\", {\n266\t      eventId,\n267\t      eventSeatMapId: seatMap.eventSeatMapId,\n268\t      seatCount: seats.length,\n269\t      ticketTypeCount: quantityByTicketType.length,\n270\t    });\n271\t\n272\t    return {\n273\t      seatMap: publishedSeatMap,\n274\t      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.PUBLISHED,\n275\t    };\n276\t  }\n277\t}\n278\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"75960147-9036-46b9-8b60-40392482aeb2","timestamp":"2026-11-20T17:59:50.484Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/services/event-seatmap.service.ts","content":"import logger from \"../config/logger\";\nimport { delTicketAvailabilityCache, delTicketTypeCache } from \"../lib/cache/ticket\";\nimport { ensureEventAccess } from \"../middleware/event-access.middleware\";\nimport { EventSeatMapRepository } from \"../repositories/event-seatmap.repository\";\nimport { TicketRepository } from \"../repositories/ticket.repository\";\nimport type {\n  AssignSeatCategoryInput,\n  UpdateEventSeatMapInput,\n} from \"../types/event-seatmap.types\";\nimport {\n  EVENT_SEAT_MAP_ERROR_MESSAGES,\n  EVENT_SEAT_MAP_SUCCESS_MESSAGES,\n} from \"../types/event-seatmap.types\";\nimport type { SeatingCanvasJson } from \"../types/seating-canvas.types\";\nimport { EMPTY_SEATING_CANVAS } from \"../types/seating-canvas.types\";\nimport {\n  BadRequestError,\n  ConflictError,\n  ForbiddenError,\n  NotFoundError,\n} from \"../utils/errors.util\";\n\n/**\n * Event Seat Map Service\n * Business logic for the per-event seat map builder and publish flow.\n * Post-publish editing is out of scope — PUT/assign both reject once\n * publishedAt is set.\n */\nexport class EventSeatMapService {\n  private seatMapRepo: EventSeatMapRepository;\n  private ticketRepo: TicketRepository;\n\n  constructor(\n    seatMapRepo?: EventSeatMapRepository,\n    ticketRepo?: TicketRepository,\n  ) {\n    this.seatMapRepo = seatMapRepo ?? new EventSeatMapRepository();\n    this.ticketRepo = ticketRepo ?? new TicketRepository();\n  }\n\n  /**\n   * Resolves the event and checks the caller is its owner (lister) or an\n   * admin. Mirrors EventSectionService.checkEventAccess /\n   * ActivityService.verifyEventOwnership.\n   */\n  private async assertEventAccess(\n    eventId: string,\n    userId: string,\n    userRole: string,\n  ) {\n    const event = await this.seatMapRepo.findEventForSeatMap(eventId);\n    if (!event) {\n      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.EVENT_NOT_FOUND);\n    }\n\n    await ensureEventAccess(userId, eventId, \"MANAGER\", userRole);\n\n    return event;\n  }\n\n  private async getSeatMapOrThrow(eventId: string) {\n    const seatMap = await this.seatMapRepo.findByEventId(eventId);\n    if (!seatMap) {\n      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_FOUND);\n    }\n    return seatMap;\n  }\n\n  private assertNotPublished(seatMap: { publishedAt: Date | null }) {\n    if (seatMap.publishedAt) {\n      throw new ConflictError(EVENT_SEAT_MAP_ERROR_MESSAGES.ALREADY_PUBLISHED);\n    }\n  }\n\n  async createSeatMap(\n    eventId: string,\n    userId: string,\n    userRole: string,\n    templateId: string | undefined,\n  ) {\n    const event = await this.assertEventAccess(eventId, userId, userRole);\n\n    if (event.seatingMode !== \"RESERVED\") {\n      throw new BadRequestError(\n        EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_RESERVED_SEATING,\n      );\n    }\n\n    const existing = await this.seatMapRepo.findByEventId(eventId);\n    if (existing) {\n      throw new ConflictError(EVENT_SEAT_MAP_ERROR_MESSAGES.ALREADY_EXISTS);\n    }\n\n    let canvasJson: SeatingCanvasJson = EMPTY_SEATING_CANVAS;\n    if (templateId) {\n      const template = await this.seatMapRepo.findTemplateCanvasJson(templateId);\n      if (!template) {\n        throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.TEMPLATE_NOT_FOUND);\n      }\n      canvasJson = template.canvasJson as unknown as SeatingCanvasJson;\n    }\n\n    const seatMap = await this.seatMapRepo.create(\n      eventId,\n      templateId ?? null,\n      canvasJson,\n    );\n\n    logger.info(\"Event seat map created\", {\n      eventId,\n      eventSeatMapId: seatMap.eventSeatMapId,\n      templateId: templateId ?? null,\n    });\n\n    return {\n      seatMap,\n      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.CREATED,\n    };\n  }\n\n  async getHostSeatMap(eventId: string, userId: string, userRole: string) {\n    await this.assertEventAccess(eventId, userId, userRole);\n\n    const seatMap = await this.seatMapRepo.findByEventIdWithSeats(eventId);\n    if (!seatMap) {\n      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_FOUND);\n    }\n    return seatMap;\n  }\n\n  async getPublicSeatMap(eventId: string) {\n    const seatMap = await this.seatMapRepo.findPublicByEventId(eventId);\n    if (!seatMap) {\n      throw new NotFoundError(EVENT_SEAT_MAP_ERROR_MESSAGES.NOT_FOUND);\n    }\n    return seatMap;\n  }\n\n  async updateCanvasJson(\n    eventId: string,\n    userId: string,\n    userRole: string,\n    data: UpdateEventSeatMapInput,\n  ) {\n    await this.assertEventAccess(eventId, userId, userRole);\n\n    const seatMap = await this.getSeatMapOrThrow(eventId);\n    this.assertNotPublished(seatMap);\n\n    const updated = await this.seatMapRepo.updateCanvasJson(\n      seatMap.eventSeatMapId,\n      data.canvasJson,\n    );\n\n    logger.info(\"Event seat map canvas updated\", {\n      eventId,\n      eventSeatMapId: seatMap.eventSeatMapId,\n      seatCount: data.canvasJson.seats.length,\n    });\n\n    return {\n      seatMap: updated,\n      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.UPDATED,\n    };\n  }\n\n  async assignSeats(\n    eventId: string,\n    userId: string,\n    userRole: string,\n    data: AssignSeatCategoryInput,\n  ) {\n    await this.assertEventAccess(eventId, userId, userRole);\n\n    const seatMap = await this.getSeatMapOrThrow(eventId);\n    this.assertNotPublished(seatMap);\n\n    const ticketType = await this.ticketRepo.findTicketTypeById(\n      data.ticketTypeId,\n    );\n    if (!ticketType) {\n      throw new NotFoundError(\n        EVENT_SEAT_MAP_ERROR_MESSAGES.TICKET_TYPE_NOT_FOUND,\n      );\n    }\n    if (ticketType.eventId !== eventId) {\n      throw new BadRequestError(\n        EVENT_SEAT_MAP_ERROR_MESSAGES.TICKET_TYPE_WRONG_EVENT,\n      );\n    }\n\n    const canvasJson = seatMap.canvasJson as unknown as SeatingCanvasJson;\n    const tempIdSet = new Set(data.seatTempIds);\n    const updatedSeats = canvasJson.seats.map((seat) =>\n      tempIdSet.has(seat.tempId)\n        ? { ...seat, ticketTypeId: data.ticketTypeId }\n        : seat,\n    );\n    const updatedCanvasJson: SeatingCanvasJson = {\n      ...canvasJson,\n      seats: updatedSeats,\n    };\n\n    const updated = await this.seatMapRepo.updateCanvasJson(\n      seatMap.eventSeatMapId,\n      updatedCanvasJson,\n    );\n\n    logger.info(\"Seats assigned to ticket type\", {\n      eventId,\n      eventSeatMapId: seatMap.eventSeatMapId,\n      ticketTypeId: data.ticketTypeId,\n      count: data.seatTempIds.length,\n    });\n\n    return {\n      seatMap: updated,\n      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.ASSIGNED,\n    };\n  }\n\n  async publishSeatMap(eventId: string, userId: string, userRole: string) {\n    await this.assertEventAccess(eventId, userId, userRole);\n\n    const seatMap = await this.getSeatMapOrThrow(eventId);\n    this.assertNotPublished(seatMap);\n\n    const canvasJson = seatMap.canvasJson as unknown as SeatingCanvasJson;\n    const seats = canvasJson.seats;\n\n    if (seats.length === 0) {\n      throw new BadRequestError(\"Seat map has no seats to publish\");\n    }\n\n    const unassigned = seats.filter((s) => !s.ticketTypeId);\n    if (unassigned.length > 0) {\n      throw new BadRequestError(\n        EVENT_SEAT_MAP_ERROR_MESSAGES.UNASSIGNED_SEATS(unassigned.length),\n      );\n    }\n\n    const { seatMap: publishedSeatMap, quantityByTicketType } =\n      await this.seatMapRepo.publish(\n        seatMap.eventSeatMapId,\n        seats.map((s) => ({\n          rowLabel: s.rowLabel,\n          seatNumber: s.seatNumber,\n          x: s.x,\n          y: s.y,\n          rotation: s.rotation ?? 0,\n          ticketTypeId: s.ticketTypeId as string,\n          isAccessible: s.accessible ?? false,\n        })),\n      );\n\n    // Inventory changed (TicketType.quantity) — invalidate the same caches\n    // booking.service invalidates after any inventory-affecting write.\n    await delTicketTypeCache(eventId);\n    await Promise.all(\n      quantityByTicketType.map(({ ticketTypeId }) =>\n        delTicketAvailabilityCache(ticketTypeId),\n      ),\n    );\n\n    logger.info(\"Event seat map published\", {\n      eventId,\n      eventSeatMapId: seatMap.eventSeatMapId,\n      seatCount: seats.length,\n      ticketTypeCount: quantityByTicketType.length,\n    });\n\n    return {\n      seatMap: publishedSeatMap,\n      message: EVENT_SEAT_MAP_SUCCESS_MESSAGES.PUBLISHED,\n    };\n  }\n}\n","numLines":278,"startLine":1,"totalLines":278}},"tool_result_meta":[{"id":"call-36e02035-8b33-4af7-a03f-3900c4698504","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
