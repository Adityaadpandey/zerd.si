{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa07bbdf77c6b6cfb279","type":"tool_result","content":"1\timport { Router } from \"express\";\n2\timport { bookingController } from \"../../controllers/booking.controller\";\n3\timport { authMiddleware } from \"../../middleware/auth.middleware\";\n4\timport { approvalClaimLimiter } from \"../../middleware/rate-limit.middleware\";\n5\t\n6\tconst router = Router();\n7\t\n8\t/**\n9\t * GET /api/v1/bookings/approval-claim/:token\n10\t * PUBLIC — buyer lands here from the approval email. We resolve the opaque\n11\t * claim token to a bookingId so the web client can route to the event page\n12\t * and resume at the payment step. Mounted BEFORE the global auth middleware\n13\t * so the email link works for users who aren't logged in yet (the web app\n14\t * still requires login before they can hit /payment-order).\n15\t */\n16\trouter.get(\n17\t  \"/approval-claim/:token\",\n18\t  approvalClaimLimiter,\n19\t  bookingController.resolveApprovalClaim.bind(bookingController),\n20\t);\n21\t\n22\t// All routes below require authentication.\n23\trouter.use(authMiddleware);\n24\t\n25\t/**\n26\t * POST /api/v1/bookings\n27\t * Create a new booking in HELD status\n28\t */\n29\trouter.post(\"/\", bookingController.create.bind(bookingController));\n30\t\n31\t/**\n32\t * POST /api/v1/bookings/request-approval\n33\t * Buyer-initiated approval request (Booking in PENDING_APPROVAL, no payment).\n34\t */\n35\trouter.post(\n36\t  \"/request-approval\",\n37\t  bookingController.requestApproval.bind(bookingController),\n38\t);\n39\t\n40\t/**\n41\t * GET /api/v1/bookings/my-approved/:eventId\n42\t * Return the caller's most-recent APPROVED_AWAITING_PAYMENT booking for the\n43\t * given event (hold not yet expired), or null. Allows the event page to\n44\t * surface a \"Complete your booking\" CTA without the email-link claim token.\n45\t */\n46\trouter.get(\n47\t  \"/my-approved/:eventId\",\n48\t  bookingController.getMyApprovedBookingForEvent.bind(bookingController),\n49\t);\n50\t\n51\t/**\n52\t * GET /api/v1/bookings/:id\n53\t * Retrieve a booking owned by the authenticated user\n54\t */\n55\trouter.get(\"/:id\", bookingController.get.bind(bookingController));\n56\t\n57\t/**\n58\t * PATCH /api/v1/bookings/:id/discount\n59\t * Apply or remove a discount code on a booking\n60\t */\n61\trouter.patch(\n62\t  \"/:id/discount\",\n63\t  bookingController.applyDiscount.bind(bookingController),\n64\t);\n65\t\n66\t/**\n67\t * DELETE /api/v1/bookings/:id\n68\t * Cancel a booking\n69\t */\n70\trouter.delete(\"/:id\", bookingController.cancel.bind(bookingController));\n71\t\n72\t/**\n73\t * POST /api/v1/bookings/:id/confirm-free\n74\t * Confirm a zero-total (free/RSVP) booking without payment\n75\t */\n76\trouter.post(\n77\t  \"/:id/confirm-free\",\n78\t  bookingController.confirmFree.bind(bookingController),\n79\t);\n80\t\n81\t/**\n82\t * POST /api/v1/bookings/:id/payment-order\n83\t * Create a Razorpay payment order for a HELD booking\n84\t */\n85\trouter.post(\n86\t  \"/:id/payment-order\",\n87\t  bookingController.createPaymentOrder.bind(bookingController),\n88\t);\n89\t\n90\t/**\n91\t * POST /api/v1/bookings/:id/verify-payment\n92\t * Verify Razorpay payment signature and confirm booking\n93\t */\n94\trouter.post(\n95\t  \"/:id/verify-payment\",\n96\t  bookingController.verifyPayment.bind(bookingController),\n97\t);\n98\t\n99\texport { router as bookingRoutes };\n100\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"07a9484e-8432-4ca5-a41c-2fdfa8997b8d","timestamp":"2026-11-20T17:36:14.741Z","tool_result_meta":[{"id":"call_01a1fa07bbdf77c6b6cfb279","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
