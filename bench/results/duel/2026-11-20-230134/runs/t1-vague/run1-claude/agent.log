,\n            body: JSON.stringify({ idToken: response.credential }),\n          });\n          const data = await res.json();\n          if (!res.ok) {\n            const googleMsg = extractError(data as ErrorBody);\n            setGoogleError(googleMsg);\n            dispatch(addToast({ message: googleMsg, variant: \"error\" }));\n            return;\n          }\n          const authData = data as AuthResponse;\n          // Explicitly write the CSRF cookie from the response body so it is\n          // guaranteed to be in document.cookie before link-phone is called,\n          // regardless of any browser Set-Cookie timing edge cases.\n          if (authData.csrfToken) {\n            setCsrfCookie(authData.csrfToken);\n          }\n          if (authData.user.name) setName(authData.user.name);\n          if (authData.user.email) setEmail(authData.user.email);\n          if (!authData.user.phone) {\n            pendingGoogleAuth.current = authData;\n            setPhoneLink(\"\");\n            setPhoneLinkError(\"\");\n            setUiState(\"COLLECT_PHONE\");\n          } else {\n            setPhone(authData.user.phone.replace(/^\\+91/, \"\"));\n            pendingGoogleAdvance.current = true;\n            dispatch(setAuth({ token: authData.token, user: authData.user }));\n            // Stitch pre-auth anonymous browsing to the now-known userId\n            activityTracker.stitch(authData.user.userId);\n          }\n        } catch {\n          setGoogleError(\"Google authentication failed. Try again.\");\n          dispatch(\n            addToast({\n              message: \"Google authentication failed. Try again.\",\n              variant: \"error\",\n            }),\n          );\n        } finally {\n          setGoogleLoading(false);\n        }\n      },\n      cancel_on_tap_outside: true,\n    });\n    const overlay = document.getElementById(\"identify-google-btn-overlay\");\n    if (!overlay) return;\n    google.accounts.id.renderButton(overlay, {\n      theme: \"filled_black\",\n      size: \"large\",\n      width: overlay.clientWidth || 320,\n    });\n  }, [gisReady, dispatch]);\n\n  // ── OTP input helpers ──────────────────────────────────────────────────────\n\n  const handleOtpChange = (i: number, val: string) => {\n    if (!/^\\d*$/.test(val)) return;\n    const next = [...otp];\n    next[i] = val.slice(-1);\n    setOtp(next);\n    if (val && i < OTP_LENGTH - 1) otpRefs.current[i + 1]?.focus();\n  };\n\n  const handleOtpKeyDown = (i: number, e: React.KeyboardEvent) => {\n    if (e.key === \"Backspace\" && !otp[i] && i > 0)\n      otpRefs.current[i - 1]?.focus();\n  };\n\n  const handleOtpPaste = (e: React.ClipboardEvent) => {\n    const pasted = e.clipboardData\n      .getData(\"text\")\n      .replace(/\\D/g, \"\")\n      .slice(0, OTP_LENGTH);\n    if (!pasted) return;\n    e.preventDefault();\n    const next = [...otp];\n    for (let i = 0; i < pasted.length; i++) next[i] = pasted[i];\n    setOtp(next);\n    otpRefs.current[Math.min(pasted.length, OTP_LENGTH - 1)]?.focus();\n  };\n\n  // ─────────────────────────────────────────────────────────────────────────\n  // Render\n  // ─────────────────────────────────────────────────────────────────────────\n\n  return (\n    <>\n      {/* Eagerly load GIS (after the page is interactive, so it doesn't block\n          first paint) so the real Google button is already live by the time\n          the user clicks it — lazily loading it on click meant the first\n          click only primed the script and a second click was needed to\n          actually open the Google sign-in flow. */}\n      <Script\n        src=\"https://accounts.google.com/gsi/client\"\n        strategy=\"afterInteractive\"\n        onLoad={() => setGisReady(true)}\n      />\n      <div className=\"flex flex-col gap-7\">\n        {/* ── Progress stepper ── */}\n        <BookingStepper currentStep=\"details\" />\n\n        {/* ══════════════════════════════════════════════════════════════════════ */}\n        {/* STATE: IDLE — Details form */}\n        {/* ══════════════════════════════════════════════════════════════════════ */}\n        {uiState === \"IDLE\" && (\n          <div className=\"flex flex-col gap-5\">\n            {/* Login shortcut */}\n            <div className=\"flex flex-col gap-2\">\n              <p className=\"text-p4 text-white/64\">\n                Log in to{\" \"}\n                <span className=\"font-semibold\">Autofill Your Details</span>\n              </p>\n              <div className=\"relative\">\n                <div className=\"running-gradient-border rounded-[40px]\">\n                  <div\n                    className=\"\n                      w-full flex items-center justify-center gap-2 pointer-events-none\n                      h-12 px-4 rounded-[40px]","numLines":140,"startLine":376,"totalLines":907}},"tool_result_meta":[{"id":"call-204e97d4-e911-4f86-bea4-657d627e1982","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
