({\n86\t  overrideExisting: true,\n87\t  endpoints: (builder) => ({\n88\t    // ── Seating templates (host-owned reusable blueprints) ──────────────────\n89\t    createSeatingTemplate: builder.mutation<\n90\t      { templateId: string },\n91\t      { name: string; venueId?: string; canvasJson: SeatMapCanvasData }\n92\t    >({\n93\t      query: (body) => ({ url: \"/seating-templates\", method: \"POST\", body }),\n94\t      transformResponse: unwrap<{ templateId: string }>,\n95\t      invalidatesTags: [\"SeatingTemplate\"],\n96\t    }),\n97\t\n98\t    getSeatingTemplates: builder.query<\n99\t      SeatingTemplateSummary[],\n100\t      { venueId?: string; mine?: boolean }\n101\t    >({\n102\t      query: ({ venueId, mine }) => {\n103\t        const params = new URLSearchParams();\n104\t        if (venueId) params.set(\"venueId\", venueId);\n105\t        if (mine) params.set(\"mine\", \"true\");\n106\t        const qs = params.toString();\n107\t        return `/seating-templates${qs ? `?${qs}` : \"\"}`;\n108\t      },\n109\t      transformResponse: unwrap<SeatingTemplateSummary[]>,\n110\t      providesTags: [\"SeatingTemplate\"],\n111\t    }),\n112\t\n113\t    getSeatingTemplateById: builder.query<SeatingTemplateFull, string>({\n114\t      query: (templateId) => `/seating-templates/${templateId}`,\n115\t      transformResponse: unwrap<SeatingTemplateFull>,\n116\t      providesTags: (_r, _e, id) => [{ type: \"SeatingTemplate\", id }],\n117\t    }),\n118\t\n119\t    updateSeatingTemplate: builder.mutation<\n120\t      void,\n121\t      {\n122\t        templateId: string;\n123\t        body: {\n124\t          name?: string;\n125\t          canvasJson?: SeatMapCanvasData;\n126\t          thumbnailUrl?: string;\n127\t        };\n128\t      }\n129\t    >({\n130\t      query: ({ templateId, body }) => ({\n131\t        url: `/seating-templates/${templateId}`,\n132\t        method: \"PATCH\",\n133\t        body,\n134\t      }),\n135\t      invalidatesTags: (_r, _e, { templateId }) => [\n136\t        { type: \"SeatingTemplate\", id: templateId },\n137\t        \"SeatingTemplate\",\n138\t      ],\n139\t    }),\n140\t\n141\t    deleteSeatingTemplate: builder.mutation<void, string>({\n142\t      query: (templateId) => ({\n143\t        url: `/seating-templates/${templateId}`,\n144\t        method: \"DELETE\",\n145\t      }),\n146\t      invalidatesTags: [\"SeatingTemplate\"],\n147\t    }),\n148\t\n149\t    // ── Event seat map (host builder) ────────────────────────────────────────"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"d89a884e-6497-49c3-b81f-6787689093cb","timestamp":"2026-11-20T17:42:50.745Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/lib/redux/api/seatingApi.ts","content":"  isAccessible?: boolean;\n}\n\nexport interface EventSeatMapHost {\n  eventSeatMapId: string;\n  canvasJson: SeatMapCanvasData;\n  publishedAt: string | null;\n  seats: HostSeat[];\n}\n\nexport interface PublicSeat {\n  seatId: string;\n  ticketTypeId?: string | null;\n  rowLabel: string;\n  seatNumber: string;\n  x: number;\n  y: number;\n  status: \"AVAILABLE\" | \"HELD\" | \"BOOKED\" | \"BLOCKED\";\n  isAccessible?: boolean;\n}\n\nexport interface PublicTicketType {\n  ticketTypeId: string;\n  name: string;\n  price: number;\n  discountedPrice?: number | null;\n  color?: string | null;\n}\n\nexport interface PublicEventSeatMap {\n  canvasJson: SeatMapCanvasData;\n  seats: PublicSeat[];\n  ticketTypes: PublicTicketType[];\n}\n\nexport interface SelectSeatsResult {\n  seatIds: string[];\n  expiresAt: string;\n}\n\n/** Shape of the 409 body the select endpoint returns when someone else beat\n * the buyer to a seat — pulled out so callers don't have to know whether the\n * server wrapped it in the usual { data } envelope or not. */\nexport function extractTakenSeatIds(errorData: unknown): string[] {\n  if (!errorData || typeof errorData !== \"object\") return [];\n  const asRecord = errorData as Record<string, unknown>;\n  const direct = asRecord.takenSeatIds;\n  if (Array.isArray(direct)) return direct as string[];\n  const nested = (asRecord.data as Record<string, unknown> | undefined)\n    ?.takenSeatIds;\n  return Array.isArray(nested) ? (nested as string[]) : [];\n}\n\n// ─── Endpoints ────────────────────────────────────────────────────────────────\n\nexport const seatingApi = tunaiApi.injectEndpoints({\n  overrideExisting: true,\n  endpoints: (builder) => ({\n    // ── Seating templates (host-owned reusable blueprints) ──────────────────\n    createSeatingTemplate: builder.mutation<\n      { templateId: string },\n      { name: string; venueId?: string; canvasJson: SeatMapCanvasData }\n    >({\n      query: (body) => ({ url: \"/seating-templates\", method: \"POST\", body }),\n      transformResponse: unwrap<{ templateId: string }>,\n      invalidatesTags: [\"SeatingTemplate\"],\n    }),\n\n    getSeatingTemplates: builder.query<\n      SeatingTemplateSummary[],\n      { venueId?: string; mine?: boolean }\n    >({\n      query: ({ venueId, mine }) => {\n        const params = new URLSearchParams();\n        if (venueId) params.set(\"venueId\", venueId);\n        if (mine) params.set(\"mine\", \"true\");\n        const qs = params.toString();\n        return `/seating-templates${qs ? `?${qs}` : \"\"}`;\n      },\n      transformResponse: unwrap<SeatingTemplateSummary[]>,\n      providesTags: [\"SeatingTemplate\"],\n    }),\n\n    getSeatingTemplateById: builder.query<SeatingTemplateFull, string>({\n      query: (templateId) => `/seating-templates/${templateId}`,\n      transformResponse: unwrap<SeatingTemplateFull>,\n      providesTags: (_r, _e, id) => [{ type: \"SeatingTemplate\", id }],\n    }),\n\n    updateSeatingTemplate: builder.mutation<\n      void,\n      {\n        templateId: string;\n        body: {\n          name?: string;\n          canvasJson?: SeatMapCanvasData;\n          thumbnailUrl?: string;\n        };\n      }\n    >({\n      query: ({ templateId, body }) => ({\n        url: `/seating-templates/${templateId}`,\n        method: \"PATCH\",\n        body,\n      }),\n      invalidatesTags: (_r, _e, { templateId }) => [\n        { type: \"SeatingTemplate\", id: templateId },\n        \"SeatingTemplate\",\n      ],\n    }),\n\n    deleteSeatingTemplate: builder.mutation<void, string>({\n      query: (templateId) => ({\n        url: `/seating-templates/${templateId}`,\n        method: \"DELETE\",\n      }),\n      invalidatesTags: [\"SeatingTemplate\"],\n    }),\n\n    // ── Event seat map (host builder) ────────────────────────────────────────","numLines":120,"startLine":30,"totalLines":265}},"tool_result_meta":[{"id":"call-31b37596-984b-467d-a177-6690dde9df8d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
