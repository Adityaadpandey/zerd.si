{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-0be4c5d4-1303-41fd-b8e9-e0789841811d","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useEffect, useRef, useState } from \"react\";\n4\timport { DepletingRing } from \"./DepletingRing\";\n5\t\n6\tinterface HoldCountdownProps {\n7\t  expiresAt: string;\n8\t  onExpire: () => void;\n9\t  className?: string;\n10\t}\n11\t\n12\tfunction getRemainingSeconds(expiresAt: string): number {\n13\t  const diff = Math.floor((new Date(expiresAt).getTime() - Date.now()) / 1000);\n14\t  return Math.max(0, diff);\n15\t}\n16\t\n17\tfunction formatTime(seconds: number): string {\n18\t  const m = Math.floor(seconds / 60);\n19\t  const s = seconds % 60;\n20\t  return `${String(m).padStart(2, \"0\")}:${String(s).padStart(2, \"0\")}`;\n21\t}\n22\t\n23\texport default function HoldCountdown({\n24\t  expiresAt,\n25\t  onExpire,\n26\t  className,\n27\t}: HoldCountdownProps) {\n28\t  const totalSecondsRef = useRef(getRemainingSeconds(expiresAt));\n29\t  const [remaining, setRemaining] = useState(() =>\n30\t    getRemainingSeconds(expiresAt),\n31\t  );\n32\t  const expiredRef = useRef(false);\n33\t  // Read latest onExpire via a ref so an unstable parent callback doesn't\n34\t  // tear down and restart the interval on every parent render.\n35\t  const onExpireRef = useRef(onExpire);\n36\t  useEffect(() => {\n37\t    onExpireRef.current = onExpire;\n38\t  }, [onExpire]);\n39\t\n40\t  useEffect(() => {\n41\t    expiredRef.current = false;\n42\t    const initial = getRemainingSeconds(expiresAt);\n43\t    totalSecondsRef.current = initial;\n44\t    setRemaining(initial);\n45\t\n46\t    const id = setInterval(() => {\n47\t      const secs = getRemainingSeconds(expiresAt);\n48\t      setRemaining(secs);\n49\t\n50\t      if (secs <= 0 && !expiredRef.current) {\n51\t        expiredRef.current = true;\n52\t        onExpireRef.current();\n53\t        clearInterval(id);\n54\t      }\n55\t    }, 1000);\n56\t\n57\t    return () => clearInterval(id);\n58\t  }, [expiresAt]);\n59\t\n60\t  const isUrgent = remaining <= 60;\n61\t  const fractionRemaining =\n62\t    totalSecondsRef.current > 0\n63\t      ? Math.min(1, remaining / totalSecondsRef.current)\n64\t      : 0;\n65\t\n66\t  return (\n67\t    <div\n68\t      className={`inline-flex items-center gap-1 px-2 py-1 rounded-full bg-white/[0.12] border border-white/[0.12] backdrop-blur-[13.5px] ${className ?? \"\"}`}\n69\t    >\n70\t      <DepletingRing fractionRemaining={fractionRemaining} urgent={isUrgent} />\n71\t      <span\n72\t        aria-live=\"polite\"\n73\t        className={`text-p3 font-medium tabular-nums transition-colors duration-300 ease-out ${isUrgent ? \"text-red-400\" : \"text-white/64\"}`}\n74\t      >\n75\t        {formatTime(remaining)}\n76\t      </span>\n77\t    </div>\n78\t  );\n79\t}\n80\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"eaaa48c7-79f4-43b4-9269-aa54a8f09ac5","timestamp":"2026-11-20T17:35:39.379Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/components/booking/HoldCountdown.tsx","content":"\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { DepletingRing } from \"./DepletingRing\";\n\ninterface HoldCountdownProps {\n  expiresAt: string;\n  onExpire: () => void;\n  className?: string;\n}\n\nfunction getRemainingSeconds(expiresAt: string): number {\n  const diff = Math.floor((new Date(expiresAt).getTime() - Date.now()) / 1000);\n  return Math.max(0, diff);\n}\n\nfunction formatTime(seconds: number): string {\n  const m = Math.floor(seconds / 60);\n  const s = seconds % 60;\n  return `${String(m).padStart(2, \"0\")}:${String(s).padStart(2, \"0\")}`;\n}\n\nexport default function HoldCountdown({\n  expiresAt,\n  onExpire,\n  className,\n}: HoldCountdownProps) {\n  const totalSecondsRef = useRef(getRemainingSeconds(expiresAt));\n  const [remaining, setRemaining] = useState(() =>\n    getRemainingSeconds(expiresAt),\n  );\n  const expiredRef = useRef(false);\n  // Read latest onExpire via a ref so an unstable parent callback doesn't\n  // tear down and restart the interval on every parent render.\n  const onExpireRef = useRef(onExpire);\n  useEffect(() => {\n    onExpireRef.current = onExpire;\n  }, [onExpire]);\n\n  useEffect(() => {\n    expiredRef.current = false;\n    const initial = getRemainingSeconds(expiresAt);\n    totalSecondsRef.current = initial;\n    setRemaining(initial);\n\n    const id = setInterval(() => {\n      const secs = getRemainingSeconds(expiresAt);\n      setRemaining(secs);\n\n      if (secs <= 0 && !expiredRef.current) {\n        expiredRef.current = true;\n        onExpireRef.current();\n        clearInterval(id);\n      }\n    }, 1000);\n\n    return () => clearInterval(id);\n  }, [expiresAt]);\n\n  const isUrgent = remaining <= 60;\n  const fractionRemaining =\n    totalSecondsRef.current > 0\n      ? Math.min(1, remaining / totalSecondsRef.current)\n      : 0;\n\n  return (\n    <div\n      className={`inline-flex items-center gap-1 px-2 py-1 rounded-full bg-white/[0.12] border border-white/[0.12] backdrop-blur-[13.5px] ${className ?? \"\"}`}\n    >\n      <DepletingRing fractionRemaining={fractionRemaining} urgent={isUrgent} />\n      <span\n        aria-live=\"polite\"\n        className={`text-p3 font-medium tabular-nums transition-colors duration-300 ease-out ${isUrgent ? \"text-red-400\" : \"text-white/64\"}`}\n      >\n        {formatTime(remaining)}\n      </span>\n    </div>\n  );\n}\n","numLines":80,"startLine":1,"totalLines":80}},"tool_result_meta":[{"id":"call-0be4c5d4-1303-41fd-b8e9-e0789841811d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
