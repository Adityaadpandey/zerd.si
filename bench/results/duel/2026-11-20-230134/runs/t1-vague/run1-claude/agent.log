{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-1e818a15-e0e3-4118-8275-1f334a16d5d6","type":"tool_result","content":"import { expect, test } from \"@playwright/test\";\nimport {\n  aggregateBookingTotals,\n  type BookingLine,\n  bookingNet,\n  computePlatformFeeRupees,\n  computePricePreview,\n  formatBuyerHourlyRate,\n  type PayoutBreakdownData,\n  type ResourceFeeConfig,\n  scalePricePreview,\n  totalVenueAvailableBalance,\n  totalVenueEarned,\n  validatePayoutBreakdown,\n} from \"../src/lib/booking/venue-pricing\";\n\n// ─── Helpers ──────────────────────────────────────────────────────────────────\n\nfunction cfg(overrides?: Partial<ResourceFeeConfig>): ResourceFeeConfig {\n  return {\n    baseRatePerHour: 800,\n    platformfee: 0,\n    platformfeePerc: 0.025,\n    gatewayFeePerc: 0.025,\n    feeBornBy: \"HOST\",\n    ...overrides,\n  };\n}\n\n// ─── computePricePreview — HOST mode ──────────────────────────────────────────\n\ntest(\"HOST mode — buyer pays face, host absorbs both fees\", () => {\n  const r = computePricePreview(\n    cfg({ baseRatePerHour: 800, feeBornBy: \"HOST\" }),\n  );\n  expect(r.buyerPays).toBe(800);\n  expect(r.platformFee).toBe(20); // 2.5% of 800\n  expect(r.gatewayFee).toBe(20); // 2.5% of 800\n  expect(r.hostNet).toBe(760); // 800 - 20 - 20\n  expect(r.buyerCoversFees).toBe(false);\n});\n\ntest(\"HOST mode with different rates\", () => {\n  const r = computePricePreview(\n    cfg({\n      baseRatePerHour: 1500,\n      platformfeePerc: 0.05,\n      gatewayFeePerc: 0.03,\n      feeBornBy: \"HOST\",\n    }),\n  );\n  expect(r.buyerPays).toBe(1500);\n  expect(r.platformFee).toBe(75); // 5% of 1500\n  expect(r.gatewayFee).toBe(45); // 3% of 1500\n  expect(r.hostNet).toBe(1380); // 1500 - 75 - 45\n});\n\ntest(\"HOST mode with zero-percent fees\", () => {\n  const r = computePricePreview(\n    cfg({\n===\n{\n  \"name\": \"web\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build --webpack\",\n    \"start\": \"next start\",\n    \"lint\": \"biome check\",\n    \"format\": \"biome format --write\",\n    \"check-types\": \"pnpm typecheck\",\n    \"typecheck\": \"tsc --noEmit && tsc --noEmit -p src/sw/tsconfig.json\",\n    \"typecheck:fast\": \"tsc --noEmit --incremental && tsc --noEmit -p src/sw/tsconfig.json\",\n    \"typecheck:tests\": \"tsc --noEmit -p tsconfig.tests.json\",\n    \"test:unit\": \"playwright test -c playwright.unit.config.ts\",\n    \"test:e2e\": \"playwright test\",\n    \"test:e2e:ui\": \"playwright test --ui\"\n  },\n  \"dependencies\": {\n    \"@reduxjs/toolkit\": \"^2.11.2\",\n    \"@serwist/next\": \"^9.5.7\",\n    \"@tiptap/core\": \"^3.27.1\",\n    \"@tiptap/extension-placeholder\": \"^3.27.1\",\n    \"@tiptap/pm\": \"^3.27.1\",\n    \"@tiptap/react\": \"^3.27.1\",\n    \"@tiptap/starter-kit\": \"^3.27.1\",\n    \"@tunyt/shared\": \"workspace:*\",\n    \"@vercel/analytics\": \"^2.0.1\",\n    \"@vercel/speed-insights\": \"^2.0.0\",\n    \"cloudinary\": \"^2.9.0\",\n    \"framer-motion\": \"^12.42.0\",\n    \"gray-matter\": \"^4.0.3\",\n    \"html5-qrcode\": \"^2.3.8\",\n    \"jsqr\": \"^1.4.0\",\n    \"konva\": \"^10.3.2\",\n    \"leaflet\": \"^1.9.4\",\n    \"next\": \"16.2.3\",\n    \"next-mdx-remote\": \"^6.0.0\",\n    \"qrcode.react\": \"^4.2.0\",\n    \"react\": \"19.2.3\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"00d04f3f-2650-4302-aa28-c7bf1fc75a10","timestamp":"2026-11-20T17:46:20.042Z","tool_use_result":{"stdout":"import { expect, test } from \"@playwright/test\";\nimport {\n  aggregateBookingTotals,\n  type BookingLine,\n  bookingNet,\n  computePlatformFeeRupees,\n  computePricePreview,\n  formatBuyerHourlyRate,\n  type PayoutBreakdownData,\n  type ResourceFeeConfig,\n  scalePricePreview,\n  totalVenueAvailableBalance,\n  totalVenueEarned,\n  validatePayoutBreakdown,\n} from \"../src/lib/booking/venue-pricing\";\n\n// ─── Helpers ──────────────────────────────────────────────────────────────────\n\nfunction cfg(overrides?: Partial<ResourceFeeConfig>): ResourceFeeConfig {\n  return {\n    baseRatePerHour: 800,\n    platformfee: 0,\n    platformfeePerc: 0.025,\n    gatewayFeePerc: 0.025,\n    feeBornBy: \"HOST\",\n    ...overrides,\n  };\n}\n\n// ─── computePricePreview — HOST mode ──────────────────────────────────────────\n\ntest(\"HOST mode — buyer pays face, host absorbs both fees\", () => {\n  const r = computePricePreview(\n    cfg({ baseRatePerHour: 800, feeBornBy: \"HOST\" }),\n  );\n  expect(r.buyerPays).toBe(800);\n  expect(r.platformFee).toBe(20); // 2.5% of 800\n  expect(r.gatewayFee).toBe(20); // 2.5% of 800\n  expect(r.hostNet).toBe(760); // 800 - 20 - 20\n  expect(r.buyerCoversFees).toBe(false);\n});\n\ntest(\"HOST mode with different rates\", () => {\n  const r = computePricePreview(\n    cfg({\n      baseRatePerHour: 1500,\n      platformfeePerc: 0.05,\n      gatewayFeePerc: 0.03,\n      feeBornBy: \"HOST\",\n    }),\n  );\n  expect(r.buyerPays).toBe(1500);\n  expect(r.platformFee).toBe(75); // 5% of 1500\n  expect(r.gatewayFee).toBe(45); // 3% of 1500\n  expect(r.hostNet).toBe(1380); // 1500 - 75 - 45\n});\n\ntest(\"HOST mode with zero-percent fees\", () => {\n  const r = computePricePreview(\n    cfg({\n===\n{\n  \"name\": \"web\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build --webpack\",\n    \"start\": \"next start\",\n    \"lint\": \"biome check\",\n    \"format\": \"biome format --write\",\n    \"check-types\": \"pnpm typecheck\",\n    \"typecheck\": \"tsc --noEmit && tsc --noEmit -p src/sw/tsconfig.json\",\n    \"typecheck:fast\": \"tsc --noEmit --incremental && tsc --noEmit -p src/sw/tsconfig.json\",\n    \"typecheck:tests\": \"tsc --noEmit -p tsconfig.tests.json\",\n    \"test:unit\": \"playwright test -c playwright.unit.config.ts\",\n    \"test:e2e\": \"playwright test\",\n    \"test:e2e:ui\": \"playwright test --ui\"\n  },\n  \"dependencies\": {\n    \"@reduxjs/toolkit\": \"^2.11.2\",\n    \"@serwist/next\": \"^9.5.7\",\n    \"@tiptap/core\": \"^3.27.1\",\n    \"@tiptap/extension-placeholder\": \"^3.27.1\",\n    \"@tiptap/pm\": \"^3.27.1\",\n    \"@tiptap/react\": \"^3.27.1\",\n    \"@tiptap/starter-kit\": \"^3.27.1\",\n    \"@tunyt/shared\": \"workspace:*\",\n    \"@vercel/analytics\": \"^2.0.1\",\n    \"@vercel/speed-insights\": \"^2.0.0\",\n    \"cloudinary\": \"^2.9.0\",\n    \"framer-motion\": \"^12.42.0\",\n    \"gray-matter\": \"^4.0.3\",\n    \"html5-qrcode\": \"^2.3.8\",\n    \"jsqr\": \"^1.4.0\",\n    \"konva\": \"^10.3.2\",\n    \"leaflet\": \"^1.9.4\",\n    \"next\": \"16.2.3\",\n    \"next-mdx-remote\": \"^6.0.0\",\n    \"qrcode.react\": \"^4.2.0\",\n    \"react\": \"19.2.3\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call-1e818a15-e0e3-4118-8275-1f334a16d5d6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
