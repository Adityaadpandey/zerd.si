{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-4d2c15bb-808b-48d5-add5-6d2db5233b7b","type":"tool_result","content":"1\timport logger from \"../config/logger\";\n2\timport { redis } from \"../config/redis\";\n3\timport { EventSeatMapRepository } from \"../repositories/event-seatmap.repository\";\n4\timport { EVENT_SEAT_MAP_CONSTANTS } from \"../types/event-seatmap.types\";\n5\timport { ConflictError, NotFoundError } from \"../utils/errors.util\";\n6\t\n7\t/**\n8\t * Compare-and-delete: only releases the lock if the stored value still\n9\t * matches the caller's userId, so one buyer can never release a lock another\n10\t * buyer legitimately holds (e.g. a stale/duplicate release request racing a\n11\t * fresh acquisition by someone else).\n12\t */\n13\tconst RELEASE_IF_OWNER_SCRIPT = `\n14\tif redis.call(\"GET\", KEYS[1]) == ARGV[1] then\n15\t  return redis.call(\"DEL\", KEYS[1])\n16\telse\n17\t  return 0\n18\tend\n19\t`;\n20\t\n21\tfunction seatHoldKey(eventSeatMapId: string, seatId: string): string {\n22\t  return `seat:hold:${eventSeatMapId}:${seatId}`;\n23\t}\n24\t\n25\t/**\n26\t * Seat Lock Service\n27\t * Ephemeral Redis holds that let a buyer browse a seat map without two\n28\t * people proceeding to checkout on the same seat. NOT the source of truth\n29\t * for booking — the real commit-to-booking flow (owned by another work\n30\t * stream in booking.service.ts) re-checks these holds and creates the real\n31\t * HELD Seat rows tied to a Booking.\n32\t */\n33\texport class SeatLockService {\n34\t  private seatMapRepo: EventSeatMapRepository;\n35\t\n36\t  constructor(seatMapRepo?: EventSeatMapRepository) {\n37\t    this.seatMapRepo = seatMapRepo ?? new EventSeatMapRepository();\n38\t  }\n39\t\n40\t  private async resolveEventSeatMapId(eventId: string): Promise<string> {\n41\t    const seatMap = await this.seatMapRepo.findByEventId(eventId);\n42\t    if (!seatMap) {\n43\t      throw new NotFoundError(\"Seat map not found for this event\");\n44\t    }\n45\t    return seatMap.eventSeatMapId;\n46\t  }\n47\t\n48\t  private async releaseKeys(keys: string[], userId: string): Promise<void> {\n49\t    if (keys.length === 0) return;\n50\t    await Promise.all(\n51\t      keys.map((key) =>\n52\t        redis.eval(RELEASE_IF_OWNER_SCRIPT, 1, key, userId).catch(() => null),\n53\t      ),\n54\t    );\n55\t  }\n56\t\n57\t  async selectSeats(eventId: string, userId: string, seatIds: string[]) {\n58\t    const eventSeatMapId = await this.resolveEventSeatMapId(eventId);\n59\t\n60\t    // Postgres is authoritative for \"already committed\" — a seat already\n61\t    // BOOKED/BLOCKED must never be lockable even if its Redis key happens to\n62\t    // be free (e.g. a previous hold expired but the booking still exists).\n63\t    const seats = await this.seatMapRepo.findSeatsByIdsForEventSeatMap(\n64\t      eventSeatMapId,\n65\t      seatIds,\n66\t    );\n67\t    const seatById = new Map(seats.map((s) => [s.seatId, s]));\n68\t\n69\t    const notAvailable = seatIds.filter((id) => {\n70\t      const seat = seatById.get(id);\n71\t      return !seat || seat.status !== \"AVAILABLE\";\n72\t    });\n73\t    if (notAvailable.length > 0) {\n74\t      throw new ConflictError(\n75\t        `Seats not available: ${notAvailable.join(\", \")}`,\n76\t      );\n77\t    }\n78\t\n79\t    const ttlMs = EVENT_SEAT_MAP_CONSTANTS.SEAT_HOLD_TTL_MS;\n80\t    // Keys freshly claimed by THIS call via SET NX — rolled back on failure.\n81\t    // Keys already owned by this same caller before this call (idempotent\n82\t    // re-select, TTL refreshed) are intentionally NOT tracked here — they\n83\t    // must never be rolled back on a later conflict in this same batch.\n84\t    const freshlyAcquired: string[] = [];\n85\t    const takenByOthers: string[] = [];\n86\t\n87\t    for (const seatId of seatIds) {\n88\t      const key = seatHoldKey(eventSeatMapId, seatId);\n89\t      const ok = await redis.set(key, userId, \"PX\", ttlMs, \"NX\");\n90\t      if (ok === \"OK\") {\n91\t        freshlyAcquired.push(seatId);\n92\t        continue;\n93\t      }\n94\t\n95\t      const existingOwner = await redis.get(key);\n96\t      if (existingOwner === userId) {\n97\t        // Idempotent re-select: refresh TTL, no-op success.\n98\t        await redis.set(key, userId, \"PX\", ttlMs);\n99\t      } else {\n100\t        takenByOthers.push(seatId);\n101\t      }\n102\t    }\n103\t\n104\t    if (takenByOthers.length > 0) {\n105\t      await this.releaseKeys(\n106\t        freshlyAcquired.map((id) => seatHoldKey(eventSeatMapId, id)),\n107\t        userId,\n108\t      );\n109\t      throw new ConflictError(\n110\t        `Seats already held by another user: ${takenByOthers.join(\", \")}`,\n111\t      );\n112\t    }\n113\t\n114\t    const expiresAt = new Date(Date.now() + ttlMs);\n115\t\n116\t    logger.info(\"Seats held\", {\n117\t      eventId,\n118\t      eventSeatMapId,\n119\t      userId,\n120\t      seatIds,\n121\t    });\n122\t\n123\t    return { seatIds, expiresAt };\n124\t  }\n125\t\n126\t  async releaseSeats(eventId: string, userId: string, seatIds: string[]) {\n127\t    const eventSeatMapId = await this.resolveEventSeatMapId(eventId);\n128\t    const keys = seatIds.map((id) => seatHoldKey(eventSeatMapId, id));\n129\t    await this.releaseKeys(keys, userId);\n130\t\n131\t    logger.info(\"Seats released\", {\n132\t      eventId,\n133\t      eventSeatMapId,\n134\t      userId,\n135\t      seatIds,\n136\t    });\n137\t\n138\t    return { seatIds };\n139\t  }\n140\t}\n141\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"dad09648-3a05-4e0b-9074-b1cc887367fc","timestamp":"2026-11-20T17:47:56.607Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/services/seat-lock.service.ts","content":"import logger from \"../config/logger\";\nimport { redis } from \"../config/redis\";\nimport { EventSeatMapRepository } from \"../repositories/event-seatmap.repository\";\nimport { EVENT_SEAT_MAP_CONSTANTS } from \"../types/event-seatmap.types\";\nimport { ConflictError, NotFoundError } from \"../utils/errors.util\";\n\n/**\n * Compare-and-delete: only releases the lock if the stored value still\n * matches the caller's userId, so one buyer can never release a lock another\n * buyer legitimately holds (e.g. a stale/duplicate release request racing a\n * fresh acquisition by someone else).\n */\nconst RELEASE_IF_OWNER_SCRIPT = `\nif redis.call(\"GET\", KEYS[1]) == ARGV[1] then\n  return redis.call(\"DEL\", KEYS[1])\nelse\n  return 0\nend\n`;\n\nfunction seatHoldKey(eventSeatMapId: string, seatId: string): string {\n  return `seat:hold:${eventSeatMapId}:${seatId}`;\n}\n\n/**\n * Seat Lock Service\n * Ephemeral Redis holds that let a buyer browse a seat map without two\n * people proceeding to checkout on the same seat. NOT the source of truth\n * for booking — the real commit-to-booking flow (owned by another work\n * stream in booking.service.ts) re-checks these holds and creates the real\n * HELD Seat rows tied to a Booking.\n */\nexport class SeatLockService {\n  private seatMapRepo: EventSeatMapRepository;\n\n  constructor(seatMapRepo?: EventSeatMapRepository) {\n    this.seatMapRepo = seatMapRepo ?? new EventSeatMapRepository();\n  }\n\n  private async resolveEventSeatMapId(eventId: string): Promise<string> {\n    const seatMap = await this.seatMapRepo.findByEventId(eventId);\n    if (!seatMap) {\n      throw new NotFoundError(\"Seat map not found for this event\");\n    }\n    return seatMap.eventSeatMapId;\n  }\n\n  private async releaseKeys(keys: string[], userId: string): Promise<void> {\n    if (keys.length === 0) return;\n    await Promise.all(\n      keys.map((key) =>\n        redis.eval(RELEASE_IF_OWNER_SCRIPT, 1, key, userId).catch(() => null),\n      ),\n    );\n  }\n\n  async selectSeats(eventId: string, userId: string, seatIds: string[]) {\n    const eventSeatMapId = await this.resolveEventSeatMapId(eventId);\n\n    // Postgres is authoritative for \"already committed\" — a seat already\n    // BOOKED/BLOCKED must never be lockable even if its Redis key happens to\n    // be free (e.g. a previous hold expired but the booking still exists).\n    const seats = await this.seatMapRepo.findSeatsByIdsForEventSeatMap(\n      eventSeatMapId,\n      seatIds,\n    );\n    const seatById = new Map(seats.map((s) => [s.seatId, s]));\n\n    const notAvailable = seatIds.filter((id) => {\n      const seat = seatById.get(id);\n      return !seat || seat.status !== \"AVAILABLE\";\n    });\n    if (notAvailable.length > 0) {\n      throw new ConflictError(\n        `Seats not available: ${notAvailable.join(\", \")}`,\n      );\n    }\n\n    const ttlMs = EVENT_SEAT_MAP_CONSTANTS.SEAT_HOLD_TTL_MS;\n    // Keys freshly claimed by THIS call via SET NX — rolled back on failure.\n    // Keys already owned by this same caller before this call (idempotent\n    // re-select, TTL refreshed) are intentionally NOT tracked here — they\n    // must never be rolled back on a later conflict in this same batch.\n    const freshlyAcquired: string[] = [];\n    const takenByOthers: string[] = [];\n\n    for (const seatId of seatIds) {\n      const key = seatHoldKey(eventSeatMapId, seatId);\n      const ok = await redis.set(key, userId, \"PX\", ttlMs, \"NX\");\n      if (ok === \"OK\") {\n        freshlyAcquired.push(seatId);\n        continue;\n      }\n\n      const existingOwner = await redis.get(key);\n      if (existingOwner === userId) {\n        // Idempotent re-select: refresh TTL, no-op success.\n        await redis.set(key, userId, \"PX\", ttlMs);\n      } else {\n        takenByOthers.push(seatId);\n      }\n    }\n\n    if (takenByOthers.length > 0) {\n      await this.releaseKeys(\n        freshlyAcquired.map((id) => seatHoldKey(eventSeatMapId, id)),\n        userId,\n      );\n      throw new ConflictError(\n        `Seats already held by another user: ${takenByOthers.join(\", \")}`,\n      );\n    }\n\n    const expiresAt = new Date(Date.now() + ttlMs);\n\n    logger.info(\"Seats held\", {\n      eventId,\n      eventSeatMapId,\n      userId,\n      seatIds,\n    });\n\n    return { seatIds, expiresAt };\n  }\n\n  async releaseSeats(eventId: string, userId: string, seatIds: string[]) {\n    const eventSeatMapId = await this.resolveEventSeatMapId(eventId);\n    const keys = seatIds.map((id) => seatHoldKey(eventSeatMapId, id));\n    await this.releaseKeys(keys, userId);\n\n    logger.info(\"Seats released\", {\n      eventId,\n      eventSeatMapId,\n      userId,\n      seatIds,\n    });\n\n    return { seatIds };\n  }\n}\n","numLines":141,"startLine":1,"totalLines":141}},"tool_result_meta":[{"id":"call-4d2c15bb-808b-48d5-add5-6d2db5233b7b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
