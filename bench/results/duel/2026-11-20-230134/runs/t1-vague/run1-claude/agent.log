\t        () => [] as FieldAnswer[],\n659\t      ),\n660\t    }));\n661\t\n662\t    (async () => {\n663\t      try {\n664\t        const booking = await submitBooking({\n665\t          eventId,\n666\t          items,\n667\t          commonFieldResponses: [],\n668\t          referrer: utmSource,\n669\t          city: userCity ?? undefined,\n670\t          state: userState ?? undefined,\n671\t          supersedesBookingId: existingBookingId ?? undefined,\n672\t        }).unwrap();\n673\t\n674\t        if (Date.now() - submissionStartedAt > 30000) {\n675\t          console.warn(\n676\t            \"[AttendeesStep] Discarding stale booking creation response\",\n677\t          );\n678\t          return;\n679\t        }\n680\t\n681\t        dispatch(bookingActions.setBookingId(booking.bookingId));\n682\t        seedBookingCache(booking);\n683\t        saveActiveBookingId(booking.bookingId);\n684\t        try {\n685\t          activityTracker.track(\"booking_held\", {\n686\t            eventId: booking.eventId,\n687\t            bookingId: booking.bookingId,\n688\t            total: booking.total,\n689\t            itemCount: booking.tickets.length,\n690\t          });\n691\t        } catch {}\n692\t        dispatch(\n693\t          bookingActions.setStep(\n694\t            mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n695\t          ),\n696\t        );\n697\t      } catch (err: unknown) {\n698\t        autoStartedRef.current = false;\n699\t        const error = err as {\n700\t          status?: number;\n701\t          data?: { message?: string };\n702\t        };\n703\t        const serverMsg = error?.data?.message;\n704\t        if (\n705\t          error?.status === 409 &&\n706\t          typeof serverMsg === \"string\" &&\n707\t          serverMsg.startsWith(\"TICKET_SOLD_OUT\")\n708\t        ) {\n709\t          setSoldOutError(serverMsg);\n710\t        } else if (\n711\t          typeof serverMsg === \"string\" &&\n712\t          (serverMsg.startsWith(\"ACTIVE_BOOKING_EXISTS\") ||\n713\t            serverMsg.startsWith(\"SUPERSEDE_TARGET_NOT_HELD\"))\n714\t        ) {\n715\t          // The server already has a HELD booking for us. Pull the id\n716\t          // from the sentinel, resume it, and — if it's no longer\n717\t          // HELD — retry the create once with a clean slate so the\n718\t          // user isn't stuck behind their own 10-minute hold.\n719\t          const heldId =\n720\t            typeof serverMsg === \"string\"\n721\t              ? serverMsg.split(\":\")[1]?.trim()\n722\t              : undefined;\n723\t          if (heldId) {\n724\t            const result = await tryResumeHeldBooking(heldId);\n725\t            if (result === \"resumed\" || result === \"stuck\") return;\n726\t            // result === \"retry\": fall through to retry below.\n727\t          } else {\n728\t            setSoldOutError(\n729\t              \"You already have an in-progress booking. Please close and reopen booking to continue.\",\n730\t            );\n731\t            return;\n732\t          }\n733\t\n734\t          // Retry the create once. The conflicting hold (if any) has\n735\t          // been released, so this should land cleanly.\n736\t          try {\n737\t            const booking = await submitBooking({\n738\t              eventId,\n739\t              items,\n740\t              commonFieldResponses: [],\n741\t              referrer: utmSource,\n742\t              city: userCity ?? undefined,\n743\t              state: userState ?? undefined,\n744\t              supersedesBookingId: undefined,\n745\t            }).unwrap();\n746\t            if (Date.now() - submissionStartedAt > 30000) {\n747\t              console.warn(\"[AttendeesStep] Discarding stale retry response\");\n748\t              return;\n749\t            }\n750\t            dispatch(bookingActions.setBookingId(booking.bookingId));\n751\t            seedBookingCache(booking);\n752\t            saveActiveBookingId(booking.bookingId);\n753\t            try {\n754\t              activityTracker.track(\"booking_held\", {\n755\t                eventId: booking.eventId,\n756\t                bookingId: booking.bookingId,\n757\t                total: booking.total,\n758\t                itemCount: booking.tickets.length,\n759\t              });\n760\t            } catch {}\n761\t            dispatch(\n762\t              bookingActions.setStep(\n763\t                mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n764\t              ),\n765\t            );\n766\t          } catch (retryErr: unknown) {\n767\t            const rerr = retryErr as {\n768\t              data?: { message?: string };\n769\t            };\n770\t            setSoldOutError(\n771\t              rerr?.data?.message ??\n772\t                \"We couldn't hold your tickets — please try again.\",\n773\t            );\n774\t          }\n775\t        } else {\n776\t          setSoldOutError(\n777\t            serverMsg ?? \"We couldn't hold your tickets — please try again.\",\n778\t          );\n779\t        }\n780\t      } finally {\n781\t        isCreatingBookingRef.current = false;\n782\t      }\n783\t    })();\n784\t  }, [needsAttendees]);\n785\t\n786\t  // Prefetch per-ticket custom fields in parallel as soon as the selection is\n787\t  // known. The PerTicketSection components will subscribe to the same cache\n788\t  // keys, so this removes the N+1 waterfall of mounting → fetch → render.\n789\t  useEffect(() => {\n790\t    if (isTeamMode || !eventId) return;\n791\t    for (const line of lines) {\n792\t      const tt = ticketTypes.find((t) => t.ticketTypeId === line.ticketTypeId);\n793\t      if ((tt?._count?.CustomField ?? 0) > 0 && line.ticketTypeId) {\n794\t        dispatch(\n795\t          ticketsApi.endpoints.getCustomFields.initiate(line.ticketTypeId, {\n796\t            subscribe: false,\n797\t          }),\n798\t        );\n799\t      }\n800\t    }\n801\t  }, [lines, ticketTypes, isTeamMode, eventId, dispatch]);\n802\t\n803\t  async function handleSubmit() {\n804\t    if (!isFormValid) return;\n805\t    setSoldOutError(null);\n806\t\n807\t    const commonFieldResponses: FieldAnswer[] = Object.entries(\n808\t      commonValues,\n809\t    ).map(([fieldId, value]) => ({ fieldId, value }));\n810\t\n811\t    for (const ans of commonFieldResponses) {\n812\t      dispatch(bookingActions.setCommonFieldResponse(ans));\n813\t    }\n814\t\n815\t    if (isTeamMode) {\n816\t      dispatch(bookingActions.setStep(6));\n817\t      return;\n818\t    }\n819\t\n820\t    const items = lines.map((line) => {\n821\t      const ttFields = ticketValues[line.ticketTypeId] ?? {};\n822\t      const ticketFieldResponses = Array.from(\n823\t        { length: line.quantity },\n824\t        (_, i) => {\n825\t          const idxFields = ttFields[String(i)] ?? {};\n826\t          return Object.entries(idxFields).map(([fieldId, value]) => ({\n827\t            fieldId,\n828\t            value,\n829\t          }));\n830\t        },\n831\t      );\n832\t      for (let i = 0; i < ticketFieldResponses.length; i++) {\n833\t        for (const ans of ticketFieldResponses[i]) {\n834\t          dispatch(\n835\t            bookingActions.setTicketFieldResponse({\n836\t              ticketTypeId: line.ticketTypeId,\n837\t              ticketIndex: i,\n838\t              fieldId: ans.fieldId,\n839\t              value: ans.value,\n840\t            }),\n841\t          );\n842\t        }\n843\t      }\n844\t      return {\n845\t        ticketTypeId: line.ticketTypeId,\n846\t        quantity: line.quantity,\n847\t        ticketFieldResponses,\n848\t      };\n849\t    });\n850\t\n851\t    try {\n852\t      const booking = await submitBooking({\n853\t        eventId,\n854\t        items,\n855\t        commonFieldResponses,\n856\t        referrer: utmSource,\n857\t        city: userCity ?? undefined,\n858\t        state: userState ?? undefined,\n859\t        supersedesBookingId: existingBookingId ?? undefined,\n860\t      }).unwrap();\n861\t\n862\t      dispatch(bookingActions.setBookingId(booking.bookingId));\n863\t      saveActiveBookingId(booking.bookingId);\n864\t      try {\n865\t        activityTracker.track(\"booking_held\", {\n866\t          eventId: booking.eventId,\n867\t          bookingId: booking.bookingId,\n868\t          total: booking.total,\n869\t          itemCount: booking.tickets.length,\n870\t        });\n871\t      } catch {}\n872\t      dispatch(\n873\t        bookingActions.setStep(\n874\t          mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n875\t        ),\n876\t      );\n877\t    } catch (err: unknown) {\n878\t      const error = err as { status?: number; data?: { message?: string } };\n879\t      const serverMsg = error?.data?.message;\n880\t      if (\n881\t        error?.status === 409 &&\n882\t        typeof serverMsg === \"string\" &&\n883\t        serverMsg.startsWith(\"TICKET_SOLD_OUT\")\n884\t      ) {\n885\t        setSoldOutError(serverMsg);\n886\t      } else if (\n887\t        typeof serverMsg === \"string\" &&\n888\t        (serverMsg.startsWith(\"ACTIVE_BOOKING_EXISTS\") ||\n889\t          serverMsg.startsWith(\"SUPERSEDE_TARGET_NOT_HELD\"))\n890\t      ) {\n891\t        // A HELD booking for this event already exists server-side. Pull\n892\t        // its id from the sentinel and resume it; if it's gone, retry\n893\t        // this submit with a clean slate.\n894\t        const heldId =\n895\t          typeof serverMsg === \"string\"\n896\t            ? serverMsg.split(\":\")[1]?.trim()\n897\t            : undefined;\n898\t        if (heldId) {\n899\t          const result = await tryResumeHeldBooking(heldId);\n900\t          if (result === \"resumed\" || result === \"stuck\") return;\n901\t          // retry: re-submit with no supersedesBookingId; the conflicting\n902\t          // hold has been cancelled, so a fresh booking will be created.\n903\t          try {\n904\t            const booking = await submitBooking({\n905\t              eventId,\n906\t              items,\n907\t              commonFieldResponses,\n908\t              referrer: utmSource,\n909\t              city: userCity ?? undefined,\n910\t              state: userState ?? undefined,\n911\t              supersedesBookingId: undefined,\n912\t            }).unwrap();\n913\t            dispatch(bookingActions.setBookingId(booking.bookingId));\n914\t            saveActiveBookingId(booking.bookingId);\n915\t            try {\n916\t              activityTracker.track(\"booking_held\", {\n917\t                eventId: booking.eventId,\n918\t                bookingId: booking.bookingId,\n919\t                total: booking.total,\n920\t                itemCount: booking.tickets.length,\n921\t              });\n922\t            } catch {}\n923\t            dispatch(\n924\t              bookingActions.setStep(\n925\t                mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n926\t              ),\n927\t            );\n928\t          } catch (retryErr: unknown) {\n929\t            const rerr = retryErr as { data?: { message?: string } };\n930\t            setSoldOutError(\n931\t              rerr?.data?.message ??\n932\t                \"We couldn't hold your tickets — please try again.\",\n933\t            );\n934\t          }\n935\t        } else {\n936\t          setSoldOutError(\n937\t            \"You already have an in-progress booking. Please close and reopen booking to continue.\",\n938\t          );\n939\t        }\n940\t      } else {\n941\t        setSoldOutError(\n942\t          serverMsg ?? \"We couldn't hold your tickets — please try again.\",\n943\t        );\n944\t      }\n945\t    }\n946\t  }\n947\t\n948\t  // Auto-skip spinner — or error state if booking creation failed\n949\t  if (needsAttendees === undefined || needsAttendees === false) {\n950\t    if (soldOutError) {\n951\t      return (\n952\t        <div className=\"flex flex-col items-center gap-5 py-10 px-2 text-center\">\n953\t          <div className=\"size-1