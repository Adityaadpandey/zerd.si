{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-297e96fd-3e90-43cb-8d31-f01dbfe8372e","type":"tool_result","content":"4090\t  useEffect(() => {\n4091\t    if (typeof window === \"undefined\") return;\n4092\t    if (paymentMethod !== \"ONLINE\") return;\n4093\t    if (step < 3) return;\n4094\t    // Fire-and-forget; swallow errors here — the actual checkout call will\n4095\t    // surface a real error to the user if the script genuinely failed.\n4096\t    loadRazorpay().catch(() => {});\n4097\t  }, [step, paymentMethod]);\n4098\t\n4099\t  const handleHoldAndPay = async () => {\n4100\t    if (!resource || !venue || selectedSlots.length === 0) return;\n4101\t    setHoldLoading(true);\n4102\t    // Kick off the Razorpay script download in parallel with the /hold call.\n4103\t    // The hold itself is a prerequisite for the payment-order (needs a\n4104\t    // slotBookingId), but the script load is fully independent — start it\n4105\t    // now so it can overlap with both the hold POST and the order POST.\n4106\t    // Skip when paying at venue (no Razorpay needed).\n4107\t    const scriptPromise =\n4108\t      paymentMethod === \"ONLINE\"\n4109\t        ? loadRazorpay().catch((e) => {\n4110\t            // Reset memoized promise so subsequent retries can re-attempt;\n4111\t            // the actual openRazorpay call below will surface the error.\n4112\t            return Promise.reject(e);\n4113\t          })\n4114\t        : Promise.resolve();\n4115\t    // Prevent unhandled-rejection logs from the fire-and-forget promise; the\n4116\t    // real awaiter below will see and surface any real failure.\n4117\t    scriptPromise.catch(() => {});\n4118\t    try {\n4119\t      // Off-grid walk-in: build [now, now+duration] fresh at submit time —\n4120\t      // NOT from the Step-1-time synthetic slot in `slots`, since real time\n4121\t      // may have passed while the customer filled in players/payment. The\n4122\t      // server (slot.service) rounds `endTime` down to the occupancy line;\n4123\t      // the client sends the raw charged span and never rounds it itself.\n4124\t      const sortedSlots = [...selectedSlots].sort();\n4125\t      const slotsPayload =\n4126\t        walkIn && walkInDurationMinutes != null\n4127\t          ? [\n4128\t              {\n4129\t                startTime: new Date().toISOString(),\n4130\t                endTime: new Date(\n4131\t                  Date.now() + walkInDurationMinutes * 60_000,\n4132\t                ).toISOString(),\n4133\t              },\n4134\t            ]\n4135\t          : sortedSlots.map((startTime) => {\n4136\t              const slot = slots.find((s) => s.startTime === startTime);\n4137\t              return { startTime, endTime: slot?.endTime ?? \"\" };\n4138\t            });\n4139\t\n4140\t      const splitPayload =\n4141\t        splitEnabled && !redemptionActive\n4142\t          ? {\n4143\t              shares: teammates.map((t) => ({\n4144\t                payerName: t.name.trim(),\n4145\t                payerEmail: t.email.trim(),\n4146\t                payerPhone: t.phone.trim(),\n4147\t                amount: Math.round(t.amount * 100) / 100,\n4148\t              })),\n4149\t            }\n4150\t          : undefined;\n4151\t\n4152\t      const holdRes = await fetch(\"/api/slot/hold\", {\n4153\t        method: \"POST\",\n4154\t        headers: { \"Content-Type\": \"application/json\" },\n4155\t        body: JSON.stringify({\n4156\t          venueId,\n4157\t          resourceId,\n4158\t          slots: slotsPayload,\n4159\t          playerCount,\n4160\t          paymentMethod,\n4161\t          ...(splitPayload ? { split: splitPayload } : {}),\n4162\t          ...(redemptionActive && activePackage\n4163\t            ? { packagePurchaseId: activePackage.purchaseId }\n4164\t            : {}),\n4165\t          ...(selectedBlocks.length > 0\n4166\t            ? {\n4167\t                durationBlocks: selectedBlocks.map((b) => ({\n4168\t                  durationMinutes: b.durationMinutes,\n4169\t                })),\n4170\t              }\n4171\t            : {}),\n4172\t          ...(walkIn ? { walkIn: true } : {}),\n4173\t          ...(walkInDiscountActive ? { applyWalkInDiscount: true } : {}),\n4174\t        }),\n4175\t      });\n4176\t\n4177\t      const holdJson = await holdRes.json();\n4178\t      if (!holdRes.ok) {\n4179\t        // See fetchQuote — backend error bodies show up as either\n4180\t        // `{ message }` or `{ error: { message } }`; check both so a\n4181\t        // paused-resource/venue 400 surfaces its human-readable message\n4182\t        // as-is instead of the generic fallback.\n4183\t        dispatch(\n4184\t          addToast({\n4185\t            message:\n4186\t              holdJson?.error?.message ??\n4187\t              holdJson?.message ??\n4188\t              \"Failed to hold slots. Please try again.\",\n4189\t            variant: \"error\",\n4190\t          }),\n4191\t        );\n4192\t        setHoldLoading(false);\n4193\t        return;\n4194\t      }\n4195\t\n4196\t      const result = (holdJson?.data ?? holdJson) as HoldResult & {\n4197\t        paidAtVenue?: boolean;\n4198\t      };\n4199\t\n4200\t      // Auto-confirmed on the server → skip Razorpay entirely and route\n4201\t      // straight to the success page without flashing the Step4 hold/payment\n4202\t      // screen. Two cases land here:\n4203\t      //  1. Pay-at-venue (`paidAtVenue: true`) — cash on arrival.\n4204\t      //  2. Full package coverage (`quote.total === 0`). The server's fast-path\n4205\t      //     returns `paidAtVenue: payAtVenue`, so for an ONLINE booking fully\n4206\t      //     covered by a package the response has `paidAtVenue: false` even\n4207\t      //     though nothing is owed — hence the explicit `quote.total === 0`\n4208\t      //     check here (see slot.service holdSlots fast-path). Only append\n4209\t      //     `payAtVenue=1` for the genuine cash case.\n4210\t      if (result.paidAtVenue || result.quote?.total === 0) {\n4211\t        router.push(\n4212\t          `/venues/booking-success?slotBookingId=${result.slotBookingId}${\n4213\t            result.paidAtVenue ? \"&payAtVenue=1\" : \"\"\n4214\t          }`,\n4215\t        );\n4216\t        return;\n4217\t      }\n4218\t\n4219\t      setHoldResult(result);\n4220\t      try {\n4221\t        activityTracker.track(\"venue_booking_held\", {\n4222\t          venueId,\n4223\t          resourceId,\n4224\t          slotBookingId: result.slotBookingId,\n4225\t        });\n4226\t      } catch {}\n4227\t      setStep(4);\n4228\t      setHasTriedPayment(true);\n4229\t\n4230\t      const expiryMs = new Date(result.holdExpiresAt).getTime() - Date.now();\n4231\t      const expiryTimer = setTimeout(() => {\n4232\t        setHoldExpired(true);\n4233\t      }, expiryMs);\n4234\t\n4235\t      await startRazorpayPayment(result, expiryTimer);\n4236\t    } catch {\n4237\t      dispatch(\n4238\t        addToast({\n4239\t          message: \"Couldn't hold your slot — please try again.\",\n4240\t          variant: \"error\",\n4241\t        }),\n4242\t      );\n4243\t    } finally {\n4244\t      setHoldLoading(false);\n4245\t    }\n4246\t  };\n4247\t\n4248\t  // Open (or re-open after a retry) the Razorpay checkout for an already held\n4249\t  // booking. Re-fetches the payment order idempotently. Drives a status machine\n4250\t  // (idle → opening → verifying → error) exactly like the event PaymentStep so\n4251\t  // the \"Try again\" button appears for ANY payment failure (SDK load/open OR\n4252\t  // verification), not just the load failure we handled before.\n4253\t  const startRazorpayPayment = useCallback(\n4254\t    async (\n4255\t      result: HoldResult & { paidAtVenue?: boolean },\n4256\t      expiryTimer: ReturnType<typeof setTimeout>,\n4257\t    ) => {\n4258\t      if (razorpayOpenedRef.current) return;\n4259\t      razorpayOpenedRef.current = true;\n4260\t      setHasTriedPayment(true);\n4261\t      setPaymentErrorMsg(\"\");\n4262\t      setPaymentStatus(\"opening\");\n4263\t\n4264\t      try {\n4265\t        const scriptPromise =\n4266\t          paymentMethod === \"ONLINE\" ? loadRazorpay() : Promise.resolve();\n4267\t        const orderFetchPromise = fetch(\n4268\t          `/api/slot/${result.slotBookingId}/payment-order`,\n4269\t          { method: \"POST\" },\n4270\t        ).then(async (res) => ({ res, json: await res.json() }));\n4271\t\n4272\t        const [{ res: orderRes, json: orderJson }] = await Promise.all([\n4273\t          orderFetchPromise,\n4274\t          scriptPromise,\n4275\t        ]);\n4276\t\n4277\t        if (!orderRes.ok) {\n4278\t          clearTimeout(expiryTimer);\n4279\t          razorpayOpenedRef.current = false;\n4280\t          setPaymentStatus(\"error\");\n4281\t          const msg =\n4282\t            orderJson?.message ??\n4283\t            \"Failed to initialise payment. Please try again.\";\n4284\t          setPaymentErrorMsg(msg);\n4285\t          dispatch(addToast({ message: msg, variant: \"error\" }));\n4286\t          return;\n4287\t        }\n4288\t\n4289\t        const orderData = orderJson?.data ?? orderJson;\n4290\t\n4291\t        if (orderData.isFree) {\n4292\t          clearTimeout(expiryTimer);\n4293\t          router.push(\n4294\t            `/venues/booking-success?slotBookingId=${result.slotBookingId}`,\n4295\t          );\n4296\t          return;\n4297\t        }\n4298\t\n4299\t        try {\n4300\t          activityTracker.track(\"venue_payment_initiate\", {\n4301\t            venueId,\n4302\t            resourceId,\n4303\t            total: orderData.amount / 100,\n4304\t          });\n4305\t        } catch {}\n4306\t\n4307\t        await openRazorpay({\n4308\t          key:\n4309\t            orderData.keyId || (process.env.NEXT_PUBLIC_RAZORPAY_KEY_ID ?? \"\"),"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"57187750-f0b7-45df-88ff-4e7b8879ee31","timestamp":"2026-11-20T17:37:06.544Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/app/venues/[venueId]/book/[resourceId]/BookingFunnelClient.tsx","content":"  useEffect(() => {\n    if (typeof window === \"undefined\") return;\n    if (paymentMethod !== \"ONLINE\") return;\n    if (step < 3) return;\n    // Fire-and-forget; swallow errors here — the actual checkout call will\n    // surface a real error to the user if the script genuinely failed.\n    loadRazorpay().catch(() => {});\n  }, [step, paymentMethod]);\n\n  const handleHoldAndPay = async () => {\n    if (!resource || !venue || selectedSlots.length === 0) return;\n    setHoldLoading(true);\n    // Kick off the Razorpay script download in parallel with the /hold call.\n    // The hold itself is a prerequisite for the payment-order (needs a\n    // slotBookingId), but the script load is fully independent — start it\n    // now so it can overlap with both the hold POST and the order POST.\n    // Skip when paying at venue (no Razorpay needed).\n    const scriptPromise =\n      paymentMethod === \"ONLINE\"\n        ? loadRazorpay().catch((e) => {\n            // Reset memoized promise so subsequent retries can re-attempt;\n            // the actual openRazorpay call below will surface the error.\n            return Promise.reject(e);\n          })\n        : Promise.resolve();\n    // Prevent unhandled-rejection logs from the fire-and-forget promise; the\n    // real awaiter below will see and surface any real failure.\n    scriptPromise.catch(() => {});\n    try {\n      // Off-grid walk-in: build [now, now+duration] fresh at submit time —\n      // NOT from the Step-1-time synthetic slot in `slots`, since real time\n      // may have passed while the customer filled in players/payment. The\n      // server (slot.service) rounds `endTime` down to the occupancy line;\n      // the client sends the raw charged span and never rounds it itself.\n      const sortedSlots = [...selectedSlots].sort();\n      const slotsPayload =\n        walkIn && walkInDurationMinutes != null\n          ? [\n              {\n                startTime: new Date().toISOString(),\n                endTime: new Date(\n                  Date.now() + walkInDurationMinutes * 60_000,\n                ).toISOString(),\n              },\n            ]\n          : sortedSlots.map((startTime) => {\n              const slot = slots.find((s) => s.startTime === startTime);\n              return { startTime, endTime: slot?.endTime ?? \"\" };\n            });\n\n      const splitPayload =\n        splitEnabled && !redemptionActive\n          ? {\n              shares: teammates.map((t) => ({\n                payerName: t.name.trim(),\n                payerEmail: t.email.trim(),\n                payerPhone: t.phone.trim(),\n                amount: Math.round(t.amount * 100) / 100,\n              })),\n            }\n          : undefined;\n\n      const holdRes = await fetch(\"/api/slot/hold\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          venueId,\n          resourceId,\n          slots: slotsPayload,\n          playerCount,\n          paymentMethod,\n          ...(splitPayload ? { split: splitPayload } : {}),\n          ...(redemptionActive && activePackage\n            ? { packagePurchaseId: activePackage.purchaseId }\n            : {}),\n          ...(selectedBlocks.length > 0\n            ? {\n                durationBlocks: selectedBlocks.map((b) => ({\n                  durationMinutes: b.durationMinutes,\n                })),\n              }\n            : {}),\n          ...(walkIn ? { walkIn: true } : {}),\n          ...(walkInDiscountActive ? { applyWalkInDiscount: true } : {}),\n        }),\n      });\n\n      const holdJson = await holdRes.json();\n      if (!holdRes.ok) {\n        // See fetchQuote — backend error bodies show up as either\n        // `{ message }` or `{ error: { message } }`; check both so a\n        // paused-resource/venue 400 surfaces its human-readable message\n        // as-is instead of the generic fallback.\n        dispatch(\n          addToast({\n            message:\n              holdJson?.error?.message ??\n              holdJson?.message ??\n              \"Failed to hold slots. Please try again.\",\n            variant: \"error\",\n          }),\n        );\n        setHoldLoading(false);\n        return;\n      }\n\n      const result = (holdJson?.data ?? holdJson) as HoldResult & {\n        paidAtVenue?: boolean;\n      };\n\n      // Auto-confirmed on the server → skip Razorpay entirely and route\n      // straight to the success page without flashing the Step4 hold/payment\n      // screen. Two cases land here:\n      //  1. Pay-at-venue (`paidAtVenue: true`) — cash on arrival.\n      //  2. Full package coverage (`quote.total === 0`). The server's fast-path\n      //     returns `paidAtVenue: payAtVenue`, so for an ONLINE booking fully\n      //     covered by a package the response has `paidAtVenue: false` even\n      //     though nothing is owed — hence the explicit `quote.total === 0`\n      //     check here (see slot.service holdSlots fast-path). Only append\n      //     `payAtVenue=1` for the genuine cash case.\n      if (result.paidAtVenue || result.quote?.total === 0) {\n        router.push(\n          `/venues/booking-success?slotBookingId=${result.slotBookingId}${\n            result.paidAtVenue ? \"&payAtVenue=1\" : \"\"\n          }`,\n        );\n        return;\n      }\n\n      setHoldResult(result);\n      try {\n        activityTracker.track(\"venue_booking_held\", {\n          venueId,\n          resourceId,\n          slotBookingId: result.slotBookingId,\n        });\n      } catch {}\n      setStep(4);\n      setHasTriedPayment(true);\n\n      const expiryMs = new Date(result.holdExpiresAt).getTime() - Date.now();\n      const expiryTimer = setTimeout(() => {\n        setHoldExpired(true);\n      }, expiryMs);\n\n      await startRazorpayPayment(result, expiryTimer);\n    } catch {\n      dispatch(\n        addToast({\n          message: \"Couldn't hold your slot — please try again.\",\n          variant: \"error\",\n        }),\n      );\n    } finally {\n      setHoldLoading(false);\n    }\n  };\n\n  // Open (or re-open after a retry) the Razorpay checkout for an already held\n  // booking. Re-fetches the payment order idempotently. Drives a status machine\n  // (idle → opening → verifying → error) exactly like the event PaymentStep so\n  // the \"Try again\" button appears for ANY payment failure (SDK load/open OR\n  // verification), not just the load failure we handled before.\n  const startRazorpayPayment = useCallback(\n    async (\n      result: HoldResult & { paidAtVenue?: boolean },\n      expiryTimer: ReturnType<typeof setTimeout>,\n    ) => {\n      if (razorpayOpenedRef.current) return;\n      razorpayOpenedRef.current = true;\n      setHasTriedPayment(true);\n      setPaymentErrorMsg(\"\");\n      setPaymentStatus(\"opening\");\n\n      try {\n        const scriptPromise =\n          paymentMethod === \"ONLINE\" ? loadRazorpay() : Promise.resolve();\n        const orderFetchPromise = fetch(\n          `/api/slot/${result.slotBookingId}/payment-order`,\n          { method: \"POST\" },\n        ).then(async (res) => ({ res, json: await res.json() }));\n\n        const [{ res: orderRes, json: orderJson }] = await Promise.all([\n          orderFetchPromise,\n          scriptPromise,\n        ]);\n\n        if (!orderRes.ok) {\n          clearTimeout(expiryTimer);\n          razorpayOpenedRef.current = false;\n          setPaymentStatus(\"error\");\n          const msg =\n            orderJson?.message ??\n            \"Failed to initialise payment. Please try again.\";\n          setPaymentErrorMsg(msg);\n          dispatch(addToast({ message: msg, variant: \"error\" }));\n          return;\n        }\n\n        const orderData = orderJson?.data ?? orderJson;\n\n        if (orderData.isFree) {\n          clearTimeout(expiryTimer);\n          router.push(\n            `/venues/booking-success?slotBookingId=${result.slotBookingId}`,\n          );\n          return;\n        }\n\n        try {\n          activityTracker.track(\"venue_payment_initiate\", {\n            venueId,\n            resourceId,\n            total: orderData.amount / 100,\n          });\n        } catch {}\n\n        await openRazorpay({\n          key:\n            orderData.keyId || (process.env.NEXT_PUBLIC_RAZORPAY_KEY_ID ?? \"\"),","numLines":220,"startLine":4090,"totalLines":4802}},"tool_result_meta":[{"id":"call-297e96fd-3e90-43cb-8d31-f01dbfe8372e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
