{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa12ba3172d48ea3d5c9","type":"tool_result","content":"=== webhook-dedup util ===\n/**\n * Runs a webhook handler at most once per event id, but lets the provider's\n * retry through when the first attempt fails.\n *\n * Why: we save a \"processed\" row BEFORE doing the work, so two servers can't\n * handle the same event at once. If the work then throws (say the database\n * blinks), that row would still be there and Razorpay's retry would be skipped\n * as a duplicate. The payment would be lost for good. So on failure we remove\n * the row again and rethrow, and the retry gets a clean run.\n */\nexport async function runWebhookOnce(\n  ops: { claim: () => Promise<boolean>; release: () => Promise<void> },\n  work: () => Promise<void>,\n): Promise<void> {\n  const claimed = await ops.claim();\n  if (!claimed) return;\n\n  try {\n    await work();\n  } catch (err) {\n    // Best effort. If releasing also fails we still want the original error.\n    await ops.release().catch(() => undefined);\n    throw err;\n  }\n}","is_error":false}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"516fc8e0-aa49-445e-9f19-04b45500817c","timestamp":"2026-11-20T17:48:15.598Z","tool_result_meta":[{"id":"call_01a1fa12ba3172d48ea3d5c9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
