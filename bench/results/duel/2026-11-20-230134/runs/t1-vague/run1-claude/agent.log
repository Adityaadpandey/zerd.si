{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa2038fd7769ad0f690d","type":"tool_result","content":"=== SuccessHandler ===\nimport type { Request, Response } from \"express\";\n\ninterface SuccessOptions {\n  message: string;\n  data?: any;\n  statusCode?: number;\n  meta?: object;\n}\n\n/**\n * Centralized success handler for controllers\n */\nexport const SuccessHandler = {\n  /**\n   * Send a success response with data\n   */\n  ok(res: Response, options: SuccessOptions): Response {\n    return sendSuccess(\n      res,\n      options.message,\n      options.data ?? null,\n      options.statusCode ?? 200,\n      options.meta,\n    );\n  },\n\n  /**\n   * Send a 201 Created response\n   */\n  created(res: Response, message: string, data?: any): Response {\n    return SuccessHandler.ok(res, { message, data, statusCode: 201 });\n  },\n\n  /**\n   * Send a 200 OK response with data\n   */\n  okWithData(res: Response, message: string, data: any, meta?: object): Response {\n    return SuccessHandler.ok(res, { message, data, statusCode: 200, meta });\n  },\n\n  /**\n   * Send a 200 OK response without data\n   */\n  okWithoutData(res: Response, message: string): Response {\n    return SuccessHandler.ok(res, { message, statusCode: 200 });\n  },\n\n  /**\n   * Send a 204 No Content response\n   */\n  noContent(res: Response): Response {\n    return res.status(204).send();\n  },\n};\n\n/**\n * Common success messages for reuse\n */\nexport const SuccessMessages = {\n  // Auth\n  OTP_SENT: \"OTP sent successfully\",\n  OTP_VERIFIED: \"OTP verified successfully\",\n  LOGIN_SUCCESS: \"Login successful\",\n  LOGOUT_SUCCESS: \"Logout successful\",\n\n  // User\n  USER_CREATED: \"User created successfully\",\n  USER_UPDATED: \"User updated successfully\",\n  USER_DELETED: \"User deleted successfully\",\n  PROFILE_UPDATED: \"Profile updated successfully\",\n\n  // Generic\n  OPERATION_SUCCESS: \"Operation completed successfully\",\n  DATA_FETCHED: \"Data retrieved successfully\",\n  DATA_CREATED: \"Data created successfully\",\n  DATA_UPDATED: \"Data updated successfully\",\n  DATA_DELETED: \"Data deleted successfully\",\n} as const;\n\nexport const sendSuccess = (","is_error":false}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"34ba1f89-292c-4753-a855-cf44980183ab","timestamp":"2026-11-20T18:03:00.598Z","tool_result_meta":[{"id":"call_01a1fa2038fd7769ad0f690d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
