)} at venue` : \"\"}`\n                  : splitEnabled && splitBookerAmount !== undefined\n                    ? `Pay ${formatCurrency(splitBookerAmount)}`\n                    : `Hold & Pay${quote ? ` ${formatCurrency(quote.total)}` : \"\"}`}\n            </span>\n            <svg\n              className=\"size-4 text-black\"\n              viewBox=\"0 0 16 16\"\n              fill=\"none\"\n              aria-hidden=\"true\"\n            >\n              <path\n                d=\"M3 8h10M9 4l4 4-4 4\"\n                stroke=\"currentColor\"\n                strokeWidth=\"1.5\"\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n              />\n            </svg>\n          </>\n        )}\n      </button>\n    </div>\n  );\n}\n\n// ─── Step 4: Slots Held + Razorpay ────────────────────────────────────────────\n\nfunction Step4({\n  resource,\n  selectedDate,\n  selectedSlots,\n  allSlots,\n  holdResult,\n  holdExpired,\n  onRestart,\n  paymentStatus,\n  paymentErrorMsg,\n  onRetryPayment,\n  onBackToReview,\n}: {\n  resource: ResourceDetail;\n  selectedDate: Date;\n  selectedSlots: string[];\n  allSlots: SlotItem[];\n  holdResult: HoldResult;\n  holdExpired: boolean;\n  onRestart: () => void;\n  paymentStatus: \"idle\" | \"opening\" | \"verifying\" | \"error\";\n  paymentErrorMsg: string;\n  onRetryPayment: () => void;\n  onBackToReview: () => void;\n}) {\n  const sorted = [...selectedSlots].sort();\n  const first = allSlots.find((s) => s.startTime === sorted[0]);\n  const last = allSlots.find((s) => s.startTime === sorted[sorted.length - 1]);\n  const timeRange =\n    first && last\n      ? `${formatTime(first.startTime)} – ${formatTime(last.endTime)}`\n      : \"—\";\n\n  if (holdExpired) {\n    return (\n      <div className=\"flex flex-col gap-5\">\n        <div className=\"rounded-2xl bg-red-500/10 border border-red-500/30 px-4 py-8 flex flex-col items-center gap-4 text-center\">\n          <span className=\"text-red-400\">\n            <PiAlertCircleSolid className=\"size-12\" />\n          </span>\n          <div className=\"flex flex-col gap-1\">\n            <h3 className=\"text-h4 font-semibold text-white tracking-[-0.02em]\">\n              Hold expired\n            </h3>\n            <p className=\"text-p2 text-white/64\">\n              The slots were released. Please start over.","numLines":150,"startLine":2280,"totalLines":4802}},"tool_result_meta":[{"id":"call-a032c88f-2dd0-481b-99a1-988e6209370d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
