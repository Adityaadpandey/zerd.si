roceed = () => {\n    if (!publicMap || selectedSeatIds.length === 0) return;\n    const byTicketType = new Map<string, string[]>();\n    for (const seat of selectedSeats) {\n      const ticketTypeId = seat.ticketTypeId;\n      if (!ticketTypeId) continue;\n      const seatId = seat.seatId;\n      const list = byTicketType.get(ticketTypeId) ?? [];\n      list.push(seatId);\n      byTicketType.set(ticketTypeId, list);\n    }\n    const lines = Array.from(byTicketType.entries()).map(\n      ([ticketTypeId, seatIds]) => createSeatBookingLine(ticketTypeId, seatIds),\n    );\n    if (lines.length === 0) return;\n\n    proceededRef.current = true;\n    dispatch(bookingActions.setLines(lines));\n    dispatch(bookingActions.setStep(isAuthenticated ? 3 : 1));\n    onClose();\n  };\n\n  if (!mounted) return null;\n\n  return createPortal(\n    <div className=\"fixed inset-0 z-[80] flex flex-col overflow-hidden bg-[#07070C]\">\n      <SeatSelectionHeader\n        title={eventTitle}\n        subtitle={eventSubtitle}\n        onClose={onClose}\n        expiresAt={selectedSeatIds.length > 0 ? expiresAt : null}\n        onExpire={handleExpire}\n      />\n\n      {publicMap && (\n        <SeatCategoryBar\n          ticketTypes={publicMap.ticketTypes}\n          ticketTypeColors={ticketTypeColors}\n          highlightedId={highlightedTicketTypeId}\n          onToggleHighlight={handleToggleHighlight}\n        />\n      )}\n\n      <div className=\"flex flex-col md:flex-row flex-1 min-h-0 min-w-0\">\n        <div className=\"relative flex-1 min-h-0 min-w-0\">\n          {isLoading || !canvasData ? (\n            <div className=\"flex h-full items-center justify-center text-white/40 text-[13px]\">\n              {isError ? \"Couldn't load the seat map.\" : \"Loading seat map…\"}\n            </div>\n          ) : (\n            <SeatMapCanvas\n              mode=\"viewer\"\n              data={canvasData}\n              ticketTypeColors={ticketTypeColors}\n              selectedSeatIds