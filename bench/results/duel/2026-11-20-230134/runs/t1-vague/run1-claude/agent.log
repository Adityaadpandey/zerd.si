{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-0cc1ac4b-489b-4ed2-ac6d-1779f8a80aa0","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { getVisibleBookingSteps, shouldCollectAttendees } from \"@tunyt/shared\";\n4\timport {\n5\t  useGetEventCustomFieldsQuery,\n6\t  useGetTicketTypesQuery,\n7\t} from \"@/lib/redux/api/ticketsApi\";\n8\timport { useAppSelector } from \"@/lib/redux/hooks\";\n9\t\n10\t/**\n11\t * Computes which booking-wizard steps are visible for this event + user.\n12\t *\n13\t * Step IDs:\n14\t *   1 = Identify (skipped if already authenticated)\n15\t *   2 = Select tickets\n16\t *   3 = Attendee details (skipped if no event-level fields AND no selected\n17\t *       ticket type has any custom fields)\n18\t *   4 = Review & pay\n19\t *   5 = Payment\n20\t *\n21\t * Returns `needsAttendees: undefined` while custom-field queries are still\n22\t * loading, so callers can avoid flicker by waiting before acting.\n23\t */\n24\texport function useBookingFlowConfig(eventId: string) {\n25\t  const isAuthenticated = useAppSelector((s) => !!s.auth.token);\n26\t  const selectedLines = useAppSelector((s) => s.booking.lines);\n27\t  const selectedTeamTicketTypeId = useAppSelector(\n28\t    (s) => s.booking.selectedTeamTicketTypeId,\n29\t  );\n30\t\n31\t  // Team bookings: all fields collected on lobby, skip the query\n32\t  const isTeamBooking = !!selectedTeamTicketTypeId;\n33\t\n34\t  const {\n35\t    data: eventFields,\n36\t    isLoading: eventFieldsLoading,\n37\t    isUninitialized: eventFieldsUninitialized,\n38\t    isError: eventFieldsError,\n39\t  } = useGetEventCustomFieldsQuery(eventId, {\n40\t    skip: !eventId || isTeamBooking,\n41\t  });\n42\t  const {\n43\t    data: ticketTypesRes,\n44\t    isLoading: ttLoading,\n45\t    isUninitialized: ttUninitialized,\n46\t    isError: ttError,\n47\t  } = useGetTicketTypesQuery(eventId, { skip: !eventId });\n48\t\n49\t  const ticketTypes = ticketTypesRes?.data ?? [];\n50\t\n51\t  const hasEventFields = (eventFields?.length ?? 0) > 0;\n52\t  const selectedTicketTypesHaveFields = selectedLines.some((line) => {\n53\t    const tt = ticketTypes.find((t) => t.ticketTypeId === line.ticketTypeId);\n54\t    return (tt?._count?.CustomField ?? 0) > 0;\n55\t  });\n56\t  const loading =\n57\t    eventFieldsLoading ||\n58\t    ttLoading ||\n59\t    (!!eventId && (eventFieldsUninitialized || ttUninitialized));\n60\t\n61\t  const needsAttendees = shouldCollectAttendees({\n62\t    isTeamBooking,\n63\t    isLoading: loading,\n64\t    hasQueryError: eventFieldsError || ttError,\n65\t    hasEventFields,\n66\t    selectedTicketTypesHaveFields,\n67\t  });\n68\t\n69\t  const visibleSteps = getVisibleBookingSteps({\n70\t    isAuthenticated,\n71\t    needsAttendees,\n72\t  });\n73\t\n74\t  return { isAuthenticated, needsAttendees, visibleSteps };\n75\t}\n76\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"1f9dd966-3efb-4017-b094-29568c8ca0c9","timestamp":"2026-11-20T17:36:33.711Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/lib/booking/use-flow-config.ts","content":"\"use client\";\n\nimport { getVisibleBookingSteps, shouldCollectAttendees } from \"@tunyt/shared\";\nimport {\n  useGetEventCustomFieldsQuery,\n  useGetTicketTypesQuery,\n} from \"@/lib/redux/api/ticketsApi\";\nimport { useAppSelector } from \"@/lib/redux/hooks\";\n\n/**\n * Computes which booking-wizard steps are visible for this event + user.\n *\n * Step IDs:\n *   1 = Identify (skipped if already authenticated)\n *   2 = Select tickets\n *   3 = Attendee details (skipped if no event-level fields AND no selected\n *       ticket type has any custom fields)\n *   4 = Review & pay\n *   5 = Payment\n *\n * Returns `needsAttendees: undefined` while custom-field queries are still\n * loading, so callers can avoid flicker by waiting before acting.\n */\nexport function useBookingFlowConfig(eventId: string) {\n  const isAuthenticated = useAppSelector((s) => !!s.auth.token);\n  const selectedLines = useAppSelector((s) => s.booking.lines);\n  const selectedTeamTicketTypeId = useAppSelector(\n    (s) => s.booking.selectedTeamTicketTypeId,\n  );\n\n  // Team bookings: all fields collected on lobby, skip the query\n  const isTeamBooking = !!selectedTeamTicketTypeId;\n\n  const {\n    data: eventFields,\n    isLoading: eventFieldsLoading,\n    isUninitialized: eventFieldsUninitialized,\n    isError: eventFieldsError,\n  } = useGetEventCustomFieldsQuery(eventId, {\n    skip: !eventId || isTeamBooking,\n  });\n  const {\n    data: ticketTypesRes,\n    isLoading: ttLoading,\n    isUninitialized: ttUninitialized,\n    isError: ttError,\n  } = useGetTicketTypesQuery(eventId, { skip: !eventId });\n\n  const ticketTypes = ticketTypesRes?.data ?? [];\n\n  const hasEventFields = (eventFields?.length ?? 0) > 0;\n  const selectedTicketTypesHaveFields = selectedLines.some((line) => {\n    const tt = ticketTypes.find((t) => t.ticketTypeId === line.ticketTypeId);\n    return (tt?._count?.CustomField ?? 0) > 0;\n  });\n  const loading =\n    eventFieldsLoading ||\n    ttLoading ||\n    (!!eventId && (eventFieldsUninitialized || ttUninitialized));\n\n  const needsAttendees = shouldCollectAttendees({\n    isTeamBooking,\n    isLoading: loading,\n    hasQueryError: eventFieldsError || ttError,\n    hasEventFields,\n    selectedTicketTypesHaveFields,\n  });\n\n  const visibleSteps = getVisibleBookingSteps({\n    isAuthenticated,\n    needsAttendees,\n  });\n\n  return { isAuthenticated, needsAttendees, visibleSteps };\n}\n","numLines":76,"startLine":1,"totalLines":76}},"tool_result_meta":[{"id":"call-0cc1ac4b-489b-4ed2-ac6d-1779f8a80aa0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
