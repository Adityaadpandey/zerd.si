{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06437f76e1b9aaa5d0","type":"tool_result","content":"1\t/**\n2\t * Fee pricing — single source of truth for per-seat money math.\n3\t *\n4\t * All arithmetic runs in INTEGER PAISE (see money.util) so there is no\n5\t * floating-point drift and the invariant holds EXACTLY by construction:\n6\t *   hostNet + platformFee + gst + gatewayFee == buyerPays   (to the paise)\n7\t *\n8\t * The public API still takes/returns rupee `number`s (exact 2-dp values),\n9\t * so callers don't change — the precision win is internal.\n10\t *\n11\t * Two stacked fees on every ticket:\n12\t *  - Tunyt's platform fee (TicketType.platformfeePerc, default 2.5%)\n13\t *  - Razorpay's gateway fee (TicketType.gatewayFeePerc, default 2.5%)\n14\t *\n15\t * GST: 18% × platform fee. Controlled per-call via `gstEnabled` — the\n16\t * default is `true` to preserve existing behaviour. The runtime is\n17\t * expected to pass `config.TUNYT_GST_ENABLED` so it can be turned off\n18\t * platform-wide from one place. When off, the GST line is zero and the\n19\t * invariant still holds (hostNet = netFace − platformFee − gatewayFee).\n20\t *\n21\t * Hierarchy: if TicketType.platformfee (flat rupees) > 0, the flat amount\n22\t * REPLACES the percentage path entirely AND is always host-borne (deducted\n23\t * from host net, never charged to the buyer) regardless of feeBornBy.\n24\t *\n25\t * Modes (per TicketType.feeBornBy):\n26\t *  - HOST:  buyer pays netFace; host nets netFace − platformFee − gst − gatewayFee\n27\t *  - USER:  gateway fee gross-up so buyer absorbs it; host nets netFace exactly\n28\t *\n29\t * Input `netFace` is ALREADY post-all-discounts (early-bird + coupon share).\n30\t */\n31\t\n32\timport { fromPaise, paiseTimesRate, toPaise } from \"./money.util\";\n33\t\n34\t// Re-export so existing imports (`from \"../utils/fee-pricing.util\"`) keep working.\n35\texport { fromPaise, round2, toPaise } from \"./money.util\";\n36\t\n37\texport type FeeBornBy = \"HOST\" | \"USER\";\n38\t\n39\texport interface FeeInputs {\n40\t  platformfee: number; // flat rupees override (host-borne when > 0)\n41\t  platformfeePerc: number; // Tunyt % (e.g. 0.025)\n42\t  gatewayFeePerc: number; // Razorpay % (e.g. 0.025)\n43\t  feeBornBy: FeeBornBy;\n44\t}\n45\t\n46\texport interface PerSeatPricing {\n47\t  /** The net face price passed in (post-all-discounts). Stored as a snapshot. */\n48\t  faceValue: number;\n49\t  /** Tunyt's cut for this seat */\n50\t  platformFee: number;\n51\t  /** 18% GST on the platform fee only */\n52\t  gst: number;\n53\t  /** Razorpay's cut for this seat */\n54\t  gatewayFee: number;\n55\t  /** What the buyer is actually charged for this seat */\n56\t  buyerPays: number;\n57\t  /** What the host nets for this seat */\n58\t  hostNet: number;\n59\t  /** Snapshot of who bore the fees */\n60\t  feeBornBy: FeeBornBy;\n61\t}\n62\t\n63\t/**\n64\t * Compute per-seat pricing from an already-discounted netFace + fee config.\n65\t *\n66\t * `netFace` must be the face price after early-bird AND coupon deductions.\n67\t * At booking-creation time (no coupon yet) netFace == seatFace.\n68\t *\n69\t * Internally everything is integer paise; the returned numbers are exact\n70\t * 2-dp rupee values and the invariant is exact to the paise.\n71\t */\n72\texport function computeSeatPricing(\n73\t  netFace: number,\n74\t  fees: FeeInputs,\n75\t  gstEnabled: boolean = true,\n76\t): PerSeatPricing {\n77\t  const netFaceP = toPaise(netFace);\n78\t\n79\t  // ------------------------------------------------------------------\n80\t  // Flat platform fee path — always host-borne, regardless of feeBornBy.\n81\t  // Gateway is still computed off netFace.\n82\t  // ------------------------------------------------------------------\n83\t  if (fees.platformfee > 0) {\n84\t    const platformFeeP = toPaise(fees.platformfee);\n85\t    const gstP = gstEnabled ? paiseTimesRate(platformFeeP, 0.18) : 0;\n86\t    const gatewayFeeP = paiseTimesRate(netFaceP, fees.gatewayFeePerc);\n87\t    const hostNetP = netFaceP - platformFeeP - gstP - gatewayFeeP;\n88\t    return {\n89\t      faceValue: fromPaise(netFaceP),\n90\t      platformFee: fromPaise(platformFeeP),\n91\t      gst: fromPaise(gstP),\n92\t      gatewayFee: fromPaise(gatewayFeeP),\n93\t      buyerPays: fromPaise(netFaceP),\n94\t      hostNet: fromPaise(hostNetP),\n95\t      feeBornBy: \"HOST\",\n96\t    };\n97\t  }\n98\t\n99\t  // ------------------------------------------------------------------\n100\t  // Percentage platform fee path\n101\t  // ------------------------------------------------------------------\n102\t  const platformFeeP = paiseTimesRate(netFaceP, fees.platformfeePerc);\n103\t  const gstP = gstEnabled ? paiseTimesRate(platformFeeP, 0.18) : 0;\n104\t\n105\t  if (fees.feeBornBy === \"USER\") {\n106\t    // Gross-up so the buyer absorbs the gateway fee exactly.\n107\t    // base = what we must receive (netFace + our fees);\n108\t    // buyerPays = base / (1 − gatewayFeePerc); gateway = buyerPays − base.\n109\t    const baseP = netFaceP + platformFeeP + gstP;\n110\t    const buyerPaysP = Math.round(baseP / (1 - fees.gatewayFeePerc));\n111\t    const gatewayFeeP = buyerPaysP - baseP; // exact integer\n112\t    return {\n113\t      faceValue: fromPaise(netFaceP),\n114\t      platformFee: fromPaise(platformFeeP),\n115\t      gst: fromPaise(gstP),\n116\t      gatewayFee: fromPaise(gatewayFeeP),\n117\t      buyerPays: fromPaise(buyerPaysP),\n118\t      hostNet: fromPaise(netFaceP), // host receives exactly netFace\n119\t      feeBornBy: \"USER\",\n120\t    };\n121\t  }\n122\t\n123\t  // HOST mode — buyer pays netFace, fees deducted from host net.\n124\t  const gatewayFeeP = paiseTimesRate(netFaceP, fees.gatewayFeePerc);\n125\t  const hostNetP = netFaceP - platformFeeP - gstP - gatewayFeeP;\n126\t  return {\n127\t    faceValue: fromPaise(netFaceP),\n128\t    platformFee: fromPaise(platformFeeP),\n129\t    gst: fromPaise(gstP),\n130\t    gatewayFee: fromPaise(gatewayFeeP),\n131\t    buyerPays: fromPaise(netFaceP),\n132\t    hostNet: fromPaise(hostNetP),\n133\t    feeBornBy: \"HOST\",\n134\t  };\n135\t}\n136\t\n137\t/**\n138\t * Scale a single seat's pricing up to `count` seats — e.g. a team ticket\n139\t * priced per member, multiplied out to the whole team's total. Multiplies\n140\t * every money field in integer paise (never on the rupee float) so the\n141\t * result is exact, same discipline as computeSeatPricing itself.\n142\t */\n143\texport function scaleSeatPricing(\n144\t  seat: PerSeatPricing,\n145\t  count: number,\n146\t): PerSeatPricing {\n147\t  return {\n148\t    faceValue: fromPaise(toPaise(seat.faceValue) * count),\n149\t    platformFee: fromPaise(toPaise(seat.platformFee) * count),\n150\t    gst: fromPaise(toPaise(seat.gst) * count),\n151\t    gatewayFee: fromPaise(toPaise(seat.gatewayFee) * count),\n152\t    buyerPays: fromPaise(toPaise(seat.buyerPays) * count),\n153\t    hostNet: fromPaise(toPaise(seat.hostNet) * count),\n154\t    feeBornBy: seat.feeBornBy,\n155\t  };\n156\t}\n157\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"f9ec3b87-8ac0-4c77-86b5-2767a5221d8b","timestamp":"2026-11-20T17:34:38.477Z","tool_result_meta":[{"id":"call_01a1fa06437f76e1b9aaa5d0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa064415772c990b8829","type":"tool_result","content":"1\t/**\n2\t * Early-bird discount split.\n3\t *\n4\t * Given a ticket type's discount config and a requested quantity, compute how\n5\t * many seats receive the discounted price and how many fall through to full\n6\t * price.\n7\t *\n8\t * Discount applies to the first `discountQuantity` sales (across all bookings).\n9\t * Once `discountSoldCount` reaches `discountQuantity`, remaining seats pay\n10\t * full price.\n11\t *\n12\t * Race note: this is an estimate at booking-time. The repository layer must\n13\t * still atomically guard the actual increment against the database row to\n14\t * prevent overselling under concurrent bookings.\n15\t */\n16\texport interface DiscountConfig {\n17\t  discountedPrice: number | null | undefined;\n18\t  discountQuantity: number | null | undefined;\n19\t  discountSoldCount: number | null | undefined;\n20\t}\n21\t\n22\texport interface DiscountSplit {\n23\t  discountSlots: number;\n24\t  fullSlots: number;\n25\t}\n26\t\n27\texport function computeDiscountSplit(\n28\t  tt: DiscountConfig,\n29\t  requestedQty: number,\n30\t): DiscountSplit {\n31\t  if (\n32\t    tt.discountedPrice == null ||\n33\t    tt.discountQuantity == null ||\n34\t    requestedQty <= 0\n35\t  ) {\n36\t    return { discountSlots: 0, fullSlots: Math.max(0, requestedQty) };\n37\t  }\n38\t  const remaining = Math.max(\n39\t    0,\n40\t    tt.discountQuantity - (tt.discountSoldCount ?? 0),\n41\t  );\n42\t  const discountSlots = Math.min(requestedQty, remaining);\n43\t  return {\n44\t    discountSlots,\n45\t    fullSlots: requestedQty - discountSlots,\n46\t  };\n47\t}\n48\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"87a9fd5a-11df-40e5-b888-58d488f7b1d2","timestamp":"2026-11-20T17:34:38.561Z","tool_result_meta":[{"id":"call_01a1fa064415772c990b8829","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0644ac743caaabb1b8","type":"tool_result","content":"1\t/**\n2\t * Bundle pricing — pure functions, no DB access.\n3\t *\n4\t * A ticket group can have its own price (\"buy this bundle for ₹900\" instead\n5\t * of the sum of its members' own prices). Two concerns live here:\n6\t *\n7\t *  1. matchBundlePurchases — deciding, from a booking's actual item\n8\t *     composition alone, which groups were purchased as a bundle. This is\n9\t *     server-side and item-composition-only by design: a booking only gets\n10\t *     bundle pricing if it contains EVERY member of a priced group at the\n11\t *     EXACT same quantity. Partial subsets or mismatched quantities always\n12\t *     fall through to per-ticket-type pricing. Nothing about how the buyer\n13\t *     reached this state (the UI's synced group control vs individual taps)\n14\t *     is trusted — only what's actually being purchased.\n15\t *\n16\t *  2. splitAmountProportionally — a bundle purchase still creates one\n17\t *     ticket per member type (each with its own fee config, refund\n18\t *     tracking, etc.), so the bundle's total charged amount must be split\n19\t *     back into a per-member face value. The split is proportional to each\n20\t *     member's own list price, and is guaranteed to sum EXACTLY to the\n21\t *     input amount at 2-decimal (rupee/paise) precision via the\n22\t *     largest-remainder method — every member's share is floored first\n23\t *     (always non-negative), then leftover paise are handed out to the\n24\t *     members with the largest fractional remainder.\n25\t */\n26\t\n27\texport interface BundleMember {\n28\t  ticketTypeId: string;\n29\t  /** The member's own list price — used only as the proportional-split weight. */\n30\t  price: number;\n31\t}\n32\t\n33\texport interface BundleGroupConfig {\n34\t  groupId: string;\n35\t  /** null = no bundle price set; this group can never match as a bundle. */\n36\t  price: number | null;\n37\t  discountedPrice: number | null;\n38\t  discountQuantity: number | null;\n39\t  discountSoldCount: number | null;\n40\t  members: BundleMember[];\n41\t}\n42\t\n43\texport interface BookingItemInput {\n44\t  ticketTypeId: string;\n45\t  quantity: number;\n46\t}\n47\t\n48\t/**\n49\t * Safety ceiling for bundle pricing: a bundle must never cost more than\n50\t * buying all of its members individually.\n51\t */\n52\texport function clampBundlePrice(bundlePrice: number, memberPriceSum: number): number {\n53\t  return Math.min(bundlePrice, memberPriceSum);\n54\t}\n55\t\n56\texport interface MatchedBundle {\n57\t  groupId: string;\n58\t  quantity: number;\n59\t  members: BundleMember[];\n60\t}\n61\t\n62\texport function matchBundlePurchases(\n63\t  items: BookingItemInput[],\n64\t  groups: BundleGroupConfig[],\n65\t): MatchedBundle[] {\n66\t  const qtyByTicketTypeId = new Map(\n67\t    items.map((i) => [i.ticketTypeId, i.quantity]),\n68\t  );\n69\t  const matches: MatchedBundle[] = [];\n70\t\n71\t  for (const group of groups) {\n72\t    if (group.price == null || group.members.length < 2) continue;\n73\t\n74\t    const quantities = group.members.map((m) =>\n75\t      qtyByTicketTypeId.get(m.ticketTypeId),\n76\t    );\n77\t    const allPresent = quantities.every((q) => q != null);\n78\t    if (!allPresent) continue;\n79\t\n80\t    const first = quantities[0] as number;\n81\t    const allEqual = quantities.every((q) => q === first);\n82\t    if (!allEqual) continue;\n83\t\n84\t    matches.push({\n85\t      groupId: group.groupId,\n86\t      quantity: first,\n87\t      members: group.members,\n88\t    });\n89\t  }\n90\t\n91\t  return matches;\n92\t}\n93\t\n94\texport function splitAmountProportionally(\n95\t  members: BundleMember[],\n96\t  totalAmount: number,\n97\t): Map<string, number> {\n98\t  const result = new Map<string, number>();\n99\t  if (members.length === 0) return result;\n100\t\n101\t  const totalAmountP = Math.round(totalAmount * 100);\n102\t  const totalWeight = members.reduce((sum, m) => sum + m.price, 0);\n103\t\n104\t  // Largest-remainder method: floor every member's raw share first (always\n105\t  // non-negative), then hand out the leftover paise one at a time to the\n106\t  // members with the largest fractional remainder. This guarantees both an\n107\t  // exact sum AND that no member's share ever goes negative — unlike a\n108\t  // single \"last member absorbs the remainder\" approach, which can drive a\n109\t  // low-weight member's share below zero when several others round up.\n110\t  const rawShares = members.map((m) => {\n111\t    const rawP =\n112\t      totalWeight > 0\n113\t        ? (totalAmountP * m.price) / totalWeight\n114\t        : totalAmountP / members.length;\n115\t    const flooredP = Math.floor(rawP);\n116\t    return {\n117\t      ticketTypeId: m.ticketTypeId,\n118\t      flooredP,\n119\t      remainder: rawP - flooredP,\n120\t    };\n121\t  });\n122\t\n123\t  const flooredTotalP = rawShares.reduce((sum, s) => sum + s.flooredP, 0);\n124\t  let leftoverP = totalAmountP - flooredTotalP;\n125\t\n126\t  // Distribute leftover paise to the largest fractional remainders first;\n127\t  // ties broken by ticketTypeId for determinism.\n128\t  const byRemainderDesc = [...rawShares].sort(\n129\t    (a, b) =>\n130\t      b.remainder - a.remainder || a.ticketTypeId.localeCompare(b.ticketTypeId),\n131\t  );\n132\t  for (const share of byRemainderDesc) {\n133\t    if (leftoverP <= 0) break;\n134\t    share.flooredP += 1;\n135\t    leftoverP -= 1;\n136\t  }\n137\t\n138\t  for (const share of rawShares) {\n139\t    result.set(share.ticketTypeId, share.flooredP / 100);\n140\t  }\n141\t\n142\t  return result;\n143\t}\n144\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"97332a4d-7ef8-4176-951f-cbe011adae97","timestamp":"2026-11-20T17:34:38.738Z","tool_result_meta":[{"id":"call_01a1fa0644ac743caaabb1b8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
