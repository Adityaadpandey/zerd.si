{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa1e60bb7263b6569c02","type":"tool_result","content":"=== markSeatsBookedForTicketIds impl ===\n        data: { status },\n      });\n    }, \"Bulk update ticket status\");\n  }\n\n  /**\n   * Reserved seating: once payment succeeds for these tickets, permanently\n   * mark their linked seats as BOOKED (no-op for GA tickets — most/all of\n   * `ticketIds` typically have no seatId).\n   */\n  async markSeatsBookedForTicketIds(ticketIds: string[]) {\n    return wrapDatabaseOperation(async () => {\n      const seated = await prisma.ticket.findMany({\n        where: { ticketId: { in: ticketIds }, seatId: { not: null } },\n        select: { seatId: true },\n      });\n      const seatIds = seated\n        .map((t) => t.seatId)\n        .filter((id): id is string => id != null);\n      if (seatIds.length === 0) return { count: 0 };\n\n      return await prisma.seat.updateMany({\n        where: { seatId: { in: seatIds } },\n        data: { status: \"BOOKED\", holdExpiresAt: null },\n      });\n    }, \"Mark seats booked for tickets\");\n  }\n\n  /**\n   * Reassign ticket ownership in bulk (used when redistributing team tickets\n   * from the leader to each member after payment).\n   */\n  async bulkUpdateTicketOwners(\n    updates: { ticketId: string; userId: string }[],\n  ) {\n    return wrapDatabaseOperation(async () => {\n=== discount cache TTL ===\nlib/cache/discount.ts:10:export const getDiscountCache = async (code: string, eventId: string) => {\nlib/cache/discount.ts-11-  const key = buildCacheKey(CACHE_PREFIX.DISCOUNT, eventId, code);\nlib/cache/discount.ts-12-  return cacheGet(key);\nlib/cache/discount.ts-13-};\nlib/cache/discount.ts-14-\nlib/cache/discount.ts:15:export const setDiscountCache = async (\nlib/cache/discount.ts-16-  code: string,\nlib/cache/discount.ts-17-  eventId: string,\nlib/cache/discount.ts-18-  discountData: any,\nlib/cache/discount.ts-19-) => {\nlib/cache/discount.ts-