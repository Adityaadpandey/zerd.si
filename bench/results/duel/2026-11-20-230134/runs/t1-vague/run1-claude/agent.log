{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-0129be81-edd6-492b-84d7-a2e122fa4203","type":"tool_result","content":"760\t  };\n761\t\n762\t  // Invite-only (requiresApproval) overrides every other mode — the buyer's\n763\t  // first booking attempt creates a PENDING_APPROVAL request, regardless of\n764\t  // whether the event is RSVP / free / paid. The post-approval claim flow\n765\t  // (?approvalClaim=<token>) re-opens the booking modal in normal mode at\n766\t  // the payment step, so this branch is only the gate-stage flow.\n767\t  const isInviteOnlyEvent = !!event?.requiresApproval && !claimedAccess;\n768\t\n769\t  const bookingMode: \"rsvp\" | \"free\" | \"paid\" | \"approval\" = isInviteOnlyEvent\n770\t    ? \"approval\"\n771\t    : !event?.ticketingEnabled\n772\t      ? \"rsvp\"\n773\t      : allTicketsFree\n774\t        ? \"free\"\n775\t        : \"paid\";\n776\t\n777\t  // Single-ticket-type events (any pricing mode) get their one option\n778\t  // pre-selected with qty=1 so the buyer isn't forced to tap \"ADD\" on a\n779\t  // SelectStep with nothing left to choose. Team tickets are excluded —\n780\t  // they use a separate radio-select + team-setup flow, not a quantity.\n781\t  const soleTicketType =\n782\t    ticketTypes.length === 1 && ticketTypes[0].minTeamSize == null\n783\t      ? ticketTypes[0]\n784\t      : undefined;\n785\t  const autoSelectTicketTypeId = soleTicketType?.ticketTypeId;\n786\t\n787\t  // Approval mode skips SelectStep only when ticket data has finished\n788\t  // loading and there is genuinely nothing to pick (RSVP-style invite-only).\n789\t  // While ticketsLoading we default to NOT skipping so a slow ticket fetch\n790\t  // can't strand the buyer past a step with options they never saw.\n791\t  const skipTicketSelectionForApproval =\n792\t    bookingMode === \"approval\" && !ticketsLoading && ticketTypes.length === 0;\n793\t\n794\t  const eventStatus = event?.status;\n795\t  const isEventCancelled =\n796\t    eventStatus === \"CANCELLED\" || eventStatus === \"CANCELLATION_REQUESTED\";\n797\t  const isEventPostponed = eventStatus === \"POSTPONED\";\n798\t  const isSalesPaused = !!event?.salesPaused;\n799\t\n800\t  const isInviteOnly = isInviteOnlyEvent;\n801\t  const isWaitlistOpen =\n802\t    isSalesPaused &&\n803\t    !isInviteOnly &&\n804\t    !claimedAccess &&\n805\t    (!event?.waitlistUntil || new Date() < new Date(event.waitlistUntil));\n806\t\n807\t  const isBookingBlocked =\n808\t    isEventCancelled ||\n809\t    isEventPostponed ||\n810\t    isEventPast ||\n811\t    (!isWaitlistOpen && !!event?.ticketingEnabled && hasNoTickets);\n812\t\n813\t  // Auto-open the booking flow for high-intent entry points (QR scan,\n814\t  // ?book=1 campaign links) once the page data is ready.\n815\t  const autoOpenedRef = useRef(false);\n816\t  useEffect(() => {\n817\t    if (autoOpenedRef.current) return;\n818\t    if (\n819\t      !isHighIntentEntry ||\n820\t      previewMode ||\n821\t      isHydrating ||\n822\t      !eventId ||\n823\t      !event ||\n824\t      ticketsLoading ||\n825\t      isBookingBlocked ||\n826\t      bookingOpen\n827\t    ) {\n828\t      return;\n829\t    }\n830\t    autoOpenedRef.current = true;\n831\t    dispatch(\n832\t      bookingActions.startBooking({\n833\t        eventId,\n834\t        isAuthenticated,\n835\t        mode: bookingMode,\n836\t        autoSelectTicketTypeId,\n837\t        skipTicketSelection: skipTicketSelectionForApproval,\n838\t      }),\n839\t    );\n840\t    activityTracker.track(\"checkout_start\", {\n841\t      eventId,\n842\t      category: event?.eventCategory,\n843\t      title: event?.title,\n844\t    });\n845\t    setBookingOpen(true);\n846\t  }, [\n847\t    isHighIntentEntry,\n848\t    previewMode,\n849\t    isHydrating,\n850\t    eventId,\n851\t    isAuthenticated,\n852\t    bookingMode,\n853\t    autoSelectTicketTypeId,\n854\t    skipTicketSelectionForApproval,\n855\t    event,\n856\t    ticketsLoading,\n857\t    isBookingBlocked,\n858\t    bookingOpen,\n859\t    dispatch,\n860\t  ]);\n861\t\n862\t  // Sales-paused (not yet on sale) → let users join the pre-sale waitlist.\n863\t  // ?book=1 means the user has a claimed waitlist entry — bypass the gate.\n864\t\n865\t  const rsvpTicket =\n866\t    bookingMode === \"rsvp\"\n867\t      ? myTicketsData?.data?.items?.find((t) =>\n868\t          [\"CONFIRMED\", \"SUCCESS\", \"PENDING\"].includes(\n869\t            (t.status ?? \"CONFIRMED\").toUpperCase(),\n870\t          ),\n871\t        )\n872\t      : undefined;\n873\t  const hasRsvpd = !!rsvpTicket;\n874\t\n875\t  // Tickets the current user has for this specific event (any status) —\n876\t  // the query itself is already scoped to eventId server-side.\n877\t  const myTicketsForEvent = useMemo(() => {\n878\t    if (!isAuthenticated || !myTicketsData?.data?.items) return [];\n879\t    return myTicketsData.data.items;\n880\t  }, [isAuthenticated, myTicketsData?.data?.items]);\n881\t\n882\t  // Booking-list items only ever come back as \"SUCCESS\" or \"USED\" (the\n883\t  // latter once every ticket in the booking has been checked in) — see\n884\t  // ticket.service.ts getUserTickets/getUserTicketsForEvent. \"PAID\"/\n885\t  // \"CONFIRMED\" are kept for forward-compat with other ticket sources.\n886\t  const hasConfirmedTickets = myTicketsForEvent.some(\n887\t    (t) =>\n888\t      t.status &&\n889\t      [\"SUCCESS\", \"PAID\", \"CONFIRMED\", \"USED\"].includes(t.status.toUpperCase()),\n890\t  );\n891\t\n892\t  // The active team this user leads/belongs to for this event, if any.\n893\t  // Prefer the SSR-prefetched answer (initialMyTeam) — it's correct in the\n894\t  // very first HTML, so the CTA shows on every load regardless of client\n895\t  // fetch timing. Once the client /teams/me query resolves, prefer its\n896\t  // freshest result; fall back to the SSR snapshot while it loads or if the\n897\t  // visitor is anonymous.\n898\t  const rawMyTeam = myTeamsForEvent[0] ?? initialMyTeam ?? null;\n899\t  // If the host later turned team registration off, a leftover unfinished team\n900\t  // (INCOMPLETE/PENDING) would keep showing \"you're in a team\" and bounce taps\n901\t  // to the lobby. Only honour it while the event still sells team tickets;\n902\t  // CONFIRMED teams already hold tickets so they stay.\n903\t  const eventHasTeamTickets = ticketTypes.some((t) => t.minTeamSize != null);\n904\t  const myTeamForEvent =\n905\t    rawMyTeam && (eventHasTeamTickets || rawMyTeam.status === \"CONFIRMED\")\n906\t      ? rawMyTeam\n907\t      : null;\n908\t\n909\t  // bfcache restore: coming back to this event via browser back can restore\n910\t  // the page WITHOUT remounting — so the mount refetch (refetchOnMountOrArgChange)\n911\t  // and focus refetch never fire. Listen for pageshow with persisted=true and\n912\t  // re-check membership so the CTA reflects the user's real team state.\n913\t  useEffect(() => {\n914\t    if (previewMode || !isAuthenticated || isHydrating) return;\n915\t    const onPageShow = (e: PageTransitionEvent) => {\n916\t      if (e.persisted) refetchMyTeams();\n917\t    };\n918\t    window.addEventListener(\"pageshow\", onPageShow);\n919\t    return () => window.removeEventListener(\"pageshow\", onPageShow);\n920\t  }, [previewMode, isAuthenticated, isHydrating, refetchMyTeams]);\n921\t\n922\t  const ctaLabel = (() => {\n923\t    if (isEventCancelled) return \"Event Cancelled\";\n924\t    if (isEventPostponed) return \"Event Postponed\";\n925\t    if (isEventPast) return \"Event Ended\";\n926\t    // Waitlist active must take priority over sold out.\n927\t    if (isWaitlistOpen) return \"Join Waitlist\";\n928\t    if (event?.ticketingEnabled && hasNoTickets) return \"Sold Out\";\n929\t    if (isInviteOnly) return \"Request Access\";\n930\t    if (hasRsvpd) return \"Cancel RSVP\";\n931\t    return event?.ticketingEnabled ? \"Get Seated\" : \"RSVP · Free\";\n932\t  })();\n933\t\n934\t  const ctaBg = isEventCancelled\n935\t    ? \"#EF4444\"\n936\t    : isEventPostponed\n937\t      ? \"#F59E0B\"\n938\t      : hasRsvpd\n939\t        ? \"#EF4444\""}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"cfe30f88-427c-4bc1-9faf-4ec02db477ed","timestamp":"2026-11-20T17:38:22.464Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/app/(event-detail)/events/[eventId]/EventPageClient.tsx","content":"  };\n\n  // Invite-only (requiresApproval) overrides every other mode — the buyer's\n  // first booking attempt creates a PENDING_APPROVAL request, regardless of\n  // whether the event is RSVP / free / paid. The post-approval claim flow\n  // (?approvalClaim=<token>) re-opens the booking modal in normal mode at\n  // the payment step, so this branch is only the gate-stage flow.\n  const isInviteOnlyEvent = !!event?.requiresApproval && !claimedAccess;\n\n  const bookingMode: \"rsvp\" | \"free\" | \"paid\" | \"approval\" = isInviteOnlyEvent\n    ? \"approval\"\n    : !event?.ticketingEnabled\n      ? \"rsvp\"\n      : allTicketsFree\n        ? \"free\"\n        : \"paid\";\n\n  // Single-ticket-type events (any pricing mode) get their one option\n  // pre-selected with qty=1 so the buyer isn't forced to tap \"ADD\" on a\n  // SelectStep with nothing left to choose. Team tickets are excluded —\n  // they use a separate radio-select + team-setup flow, not a quantity.\n  const soleTicketType =\n    ticketTypes.length === 1 && ticketTypes[0].minTeamSize == null\n      ? ticketTypes[0]\n      : undefined;\n  const autoSelectTicketTypeId = soleTicketType?.ticketTypeId;\n\n  // Approval mode skips SelectStep only when ticket data has finished\n  // loading and there is genuinely nothing to pick (RSVP-style invite-only).\n  // While ticketsLoading we default to NOT skipping so a slow ticket fetch\n  // can't strand the buyer past a step with options they never saw.\n  const skipTicketSelectionForApproval =\n    bookingMode === \"approval\" && !ticketsLoading && ticketTypes.length === 0;\n\n  const eventStatus = event?.status;\n  const isEventCancelled =\n    eventStatus === \"CANCELLED\" || eventStatus === \"CANCELLATION_REQUESTED\";\n  const isEventPostponed = eventStatus === \"POSTPONED\";\n  const isSalesPaused = !!event?.salesPaused;\n\n  const isInviteOnly = isInviteOnlyEvent;\n  const isWaitlistOpen =\n    isSalesPaused &&\n    !isInviteOnly &&\n    !claimedAccess &&\n    (!event?.waitlistUntil || new Date() < new Date(event.waitlistUntil));\n\n  const isBookingBlocked =\n    isEventCancelled ||\n    isEventPostponed ||\n    isEventPast ||\n    (!isWaitlistOpen && !!event?.ticketingEnabled && hasNoTickets);\n\n  // Auto-open the booking flow for high-intent entry points (QR scan,\n  // ?book=1 campaign links) once the page data is ready.\n  const autoOpenedRef = useRef(false);\n  useEffect(() => {\n    if (autoOpenedRef.current) return;\n    if (\n      !isHighIntentEntry ||\n      previewMode ||\n      isHydrating ||\n      !eventId ||\n      !event ||\n      ticketsLoading ||\n      isBookingBlocked ||\n      bookingOpen\n    ) {\n      return;\n    }\n    autoOpenedRef.current = true;\n    dispatch(\n      bookingActions.startBooking({\n        eventId,\n        isAuthenticated,\n        mode: bookingMode,\n        autoSelectTicketTypeId,\n        skipTicketSelection: skipTicketSelectionForApproval,\n      }),\n    );\n    activityTracker.track(\"checkout_start\", {\n      eventId,\n      category: event?.eventCategory,\n      title: event?.title,\n    });\n    setBookingOpen(true);\n  }, [\n    isHighIntentEntry,\n    previewMode,\n    isHydrating,\n    eventId,\n    isAuthenticated,\n    bookingMode,\n    autoSelectTicketTypeId,\n    skipTicketSelectionForApproval,\n    event,\n    ticketsLoading,\n    isBookingBlocked,\n    bookingOpen,\n    dispatch,\n  ]);\n\n  // Sales-paused (not yet on sale) → let users join the pre-sale waitlist.\n  // ?book=1 means the user has a claimed waitlist entry — bypass the gate.\n\n  const rsvpTicket =\n    bookingMode === \"rsvp\"\n      ? myTicketsData?.data?.items?.find((t) =>\n          [\"CONFIRMED\", \"SUCCESS\", \"PENDING\"].includes(\n            (t.status ?? \"CONFIRMED\").toUpperCase(),\n          ),\n        )\n      : undefined;\n  const hasRsvpd = !!rsvpTicket;\n\n  // Tickets the current user has for this specific event (any status) —\n  // the query itself is already scoped to eventId server-side.\n  const myTicketsForEvent = useMemo(() => {\n    if (!isAuthenticated || !myTicketsData?.data?.items) return [];\n    return myTicketsData.data.items;\n  }, [isAuthenticated, myTicketsData?.data?.items]);\n\n  // Booking-list items only ever come back as \"SUCCESS\" or \"USED\" (the\n  // latter once every ticket in the booking has been checked in) — see\n  // ticket.service.ts getUserTickets/getUserTicketsForEvent. \"PAID\"/\n  // \"CONFIRMED\" are kept for forward-compat with other ticket sources.\n  const hasConfirmedTickets = myTicketsForEvent.some(\n    (t) =>\n      t.status &&\n      [\"SUCCESS\", \"PAID\", \"CONFIRMED\", \"USED\"].includes(t.status.toUpperCase()),\n  );\n\n  // The active team this user leads/belongs to for this event, if any.\n  // Prefer the SSR-prefetched answer (initialMyTeam) — it's correct in the\n  // very first HTML, so the CTA shows on every load regardless of client\n  // fetch timing. Once the client /teams/me query resolves, prefer its\n  // freshest result; fall back to the SSR snapshot while it loads or if the\n  // visitor is anonymous.\n  const rawMyTeam = myTeamsForEvent[0] ?? initialMyTeam ?? null;\n  // If the host later turned team registration off, a leftover unfinished team\n  // (INCOMPLETE/PENDING) would keep showing \"you're in a team\" and bounce taps\n  // to the lobby. Only honour it while the event still sells team tickets;\n  // CONFIRMED teams already hold tickets so they stay.\n  const eventHasTeamTickets = ticketTypes.some((t) => t.minTeamSize != null);\n  const myTeamForEvent =\n    rawMyTeam && (eventHasTeamTickets || rawMyTeam.status === \"CONFIRMED\")\n      ? rawMyTeam\n      : null;\n\n  // bfcache restore: coming back to this event via browser back can restore\n  // the page WITHOUT remounting — so the mount refetch (refetchOnMountOrArgChange)\n  // and focus refetch never fire. Listen for pageshow with persisted=true and\n  // re-check membership so the CTA reflects the user's real team state.\n  useEffect(() => {\n    if (previewMode || !isAuthenticated || isHydrating) return;\n    const onPageShow = (e: PageTransitionEvent) => {\n      if (e.persisted) refetchMyTeams();\n    };\n    window.addEventListener(\"pageshow\", onPageShow);\n    return () => window.removeEventListener(\"pageshow\", onPageShow);\n  }, [previewMode, isAuthenticated, isHydrating, refetchMyTeams]);\n\n  const ctaLabel = (() => {\n    if (isEventCancelled) return \"Event Cancelled\";\n    if (isEventPostponed) return \"Event Postponed\";\n    if (isEventPast) return \"Event Ended\";\n    // Waitlist active must take priority over sold out.\n    if (isWaitlistOpen) return \"Join Waitlist\";\n    if (event?.ticketingEnabled && hasNoTickets) return \"Sold Out\";\n    if (isInviteOnly) return \"Request Access\";\n    if (hasRsvpd) return \"Cancel RSVP\";\n    return event?.ticketingEnabled ? \"Get Seated\" : \"RSVP · Free\";\n  })();\n\n  const ctaBg = isEventCancelled\n    ? \"#EF4444\"\n    : isEventPostponed\n      ? \"#F59E0B\"\n      : hasRsvpd\n        ? \"#EF4444\"","numLines":180,"startLine":760,"totalLines":1930}},"tool_result_meta":[{"id":"call-0129be81-edd6-492b-84d7-a2e122fa4203","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
