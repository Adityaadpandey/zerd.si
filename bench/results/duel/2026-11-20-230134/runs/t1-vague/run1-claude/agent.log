{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-fd71fd5b-0b0a-48db-b5da-5f5588a45cc0","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport logger from \"../../config/logger\";\n3\timport {\n4\t  delTicketAvailabilityCache,\n5\t  delTicketTypeCache,\n6\t  delUserTicketsCache,\n7\t} from \"../../lib/cache/ticket\";\n8\timport { bookingExpiryQueue } from \"../../lib/queues\";\n9\timport type { BookingRepository } from \"../../repositories/booking.repository\";\n10\timport { CheckoutSessionRepository } from \"../../repositories/checkout-session.repository\";\n11\timport type { UserRepository } from \"../../repositories/user.repository\";\n12\timport type { WaitlistRepository } from \"../../repositories/waitlist.repository\";\n13\timport { ConflictError, ForbiddenError, ValidationError } from \"../../utils/errors.util\";\n14\timport { enqueuePartnerWebhook } from \"../partner-webhook.service\";\n15\timport { uploadService } from \"../upload.service\";\n16\timport type { BookingPricingService } from \"./booking-pricing.service\";\n17\timport type { BookingDetails, CreateBookingDto } from \"./types\";\n18\t\n19\tconst HOLD_DURATION_MS = 10 * 60 * 1000; // 10 minutes\n20\t\n21\texport class BookingLifecycleService {\n22\t  constructor(\n23\t    private readonly bookingRepository: BookingRepository,\n24\t    private readonly waitlistRepository: WaitlistRepository,\n25\t    private readonly userRepository: UserRepository,\n26\t    private readonly pricingService: BookingPricingService,\n27\t  ) {}\n28\t\n29\t  /**\n30\t   * Create a new booking in HELD status.\n31\t   *\n32\t   * Steps:\n33\t   *  1. Validate dto shape.\n34\t   *  2. Load & validate TicketTypes (scope + salesCutoff + required fields).\n35\t   *  3. Compute pricing.\n36\t   *  4. Persist via repository (atomic hold transaction).\n37\t   *  5. Return full booking detail.\n38\t   */\n39\t  async create(\n40\t    userId: string,\n41\t    dto: CreateBookingDto,\n42\t    requestId: string,\n43\t  ): Promise<BookingDetails> {\n44\t    // ------------------------------------------------------------------\n45\t    // 1. Validate dto\n46\t    // ------------------------------------------------------------------\n47\t    this.pricingService.validateDtoShape(dto);\n48\t    uploadService.assertOwnUploads(userId, [\n49\t      ...dto.commonFieldResponses,\n50\t      ...dto.items.flatMap((i) => i.ticketFieldResponses.flat()),\n51\t    ]);\n52\t\n53\t    // ------------------------------------------------------------------\n54\t    // 2. Check event exists, sales not paused, and ticketingEnabled (RSVP flow)\n55\t    // ------------------------------------------------------------------\n56\t    const event = await prisma.event.findUnique({\n57\t      where: { eventId: dto.eventId },\n58\t      select: {\n59\t        eventId: true,\n60\t        salesPaused: true,\n61\t        ticketingEnabled: true,\n62\t        requiresApproval: true,\n63\t        seatingMode: true,\n64\t\n65\t        waitlistUntil: true,\n66\t      },\n67\t    });\n68\t\n69\t    if (!event) {\n70\t      throw new ValidationError(\"Event not found\");\n71\t    }\n72\t    // Waitlist-claimed users bypass both the salesPaused and requiresApproval\n73\t    // gates — fetch once and reuse for both checks below.\n74\t    let claimedWaitlistId: string | null = null;\n75\t\n76\t    if (event.salesPaused || event.requiresApproval) {\n77\t      // Run user-email lookup and userId-based waitlist check in parallel.\n78\t      // The waitlist query uses OR [userId, email]; passing \"\" for email lets\n79\t      // the userId branch resolve without waiting for the user record first.\n80\t      // Only if userId misses (email-only waitlist entry) do we retry with email.\n81\t      const [userRecord, claimedByUserId] = await Promise.all([\n82\t        this.userRepository.findEmailByUserId(userId),\n83\t        this.waitlistRepository.findClaimedByUserIdOrEmail(\n84\t          dto.eventId,\n85\t          userId,\n86\t          \"\",\n87\t        ),\n88\t      ]);\n89\t\n90\t      // If the userId-only pass didn't match, retry with the real email address.\n91\t      const claimed =\n92\t        claimedByUserId ??\n93\t        (userRecord?.email\n94\t          ? await this.waitlistRepository.findClaimedByUserIdOrEmail(\n95\t              dto.eventId,\n96\t              userId,\n97\t              userRecord.email,\n98\t            )\n99\t          : null);\n100\t\n101\t      if (event.salesPaused && !claimed) {\n102\t        throw new ValidationError(\"Sales are currently paused for this event\");\n103\t      }\n104\t      if (event.requiresApproval && !claimed) {\n105\t        throw new ForbiddenError(\n106\t          \"This event requires approval. Request access first.\",\n107\t        );\n108\t      }\n109\t\n110\t      claimedWaitlistId = claimed?.waitlistId ?? null;\n111\t    }\n112\t\n113\t    // Ticketed events must have at least one item; RSVP events allow empty items\n114\t    if (event.ticketingEnabled && dto.items.length === 0) {\n115\t      throw new ValidationError(\"Booking must contain at least one item\");\n116\t    }\n117\t\n118\t    await this.pricingService.validateSeatSelections(\n119\t      dto.eventId,\n120\t      event.seatingMode,\n121\t      userId,\n122\t      dto.items,\n123\t    );\n124\t\n125\t    // Guard against hold-cycling: without this, a buyer could repeatedly\n126\t    // call create() for the same event to keep refreshing a fresh\n127\t    // HOLD_DURATION_MS window forever, holding scarce inventory without ever\n128\t    // paying. At most one active (non-expired) HELD booking is allowed per\n129\t    // user+event; callers that want to change quantities on their existing\n130\t    // hold must pass supersedesBookingId instead of opening a second one.\n131\t    // Scoped to HELD only — approval-flow statuses are governed by\n132\t    // requestApproval()'s own rules and aren't affected by this guard.\n133\t    if (!dto.supersedesBookingId) {\n134\t      const existingHeld = await prisma.booking.findFirst({\n135\t        where: {\n136\t          userId,\n137\t          eventId: dto.eventId,\n138\t          status: \"HELD\",\n139\t          holdExpiresAt: { gt: new Date() },\n140\t        },\n141\t        select: { bookingId: true },\n142\t      });\n143\t      if (existingHeld) {\n144\t        throw new ConflictError(\n145\t          `ACTIVE_BOOKING_EXISTS:${existingHeld.bookingId}`,\n146\t        );\n147\t      }\n148\t    }\n149\t\n150\t    // ------------------------------------------------------------------\n151\t    // 3-5. Validate ticket types + price the booking (shared helper).\n152\t    // ------------------------------------------------------------------\n153\t    const {\n154\t      subtotal,\n155\t      discountAmount,\n156\t      platformFee,\n157\t      gatewayFee,\n158\t      gst,\n159\t      total,\n160\t      feesBornBy,\n161\t      lines,\n162\t    } = await this.pricingService.validateAndPrice(dto);\n163\t\n164\t    // ------------------------------------------------------------------\n165\t    // 5. Persist with hold\n166\t    // ------------------------------------------------------------------\n167\t    const holdExpiresAt = new Date(Date.now() + HOLD_DURATION_MS);\n168\t\n169\t    const createArgs = {\n170\t      userId,\n171\t      eventId: dto.eventId,\n172\t      subtotal,\n173\t      platformFee,\n174\t      gatewayFee,\n175\t      gst,\n176\t      feesBornBy,\n177\t      total,\n178\t      holdExpiresAt,\n179\t      commonFieldResponses: dto.commonFieldResponses,\n180\t      lines,\n181\t      referrer: dto.referrer,\n182\t      city: dto.city,\n183\t      state: dto.state,\n184\t      userAgent: dto.userAgent,\n185\t      checkoutSessionId: dto.checkoutSessionId,\n186\t    };\n187\t\n188\t    const bookingId = dto.supersedesBookingId\n189\t      ? await this.bookingRepository.createWithHoldSupersedingTx(createArgs, {\n190\t          bookingId: dto.supersedesBookingId,\n191\t          userId,\n192\t        })\n193\t      : await this.bookingRepository.createWithHoldTx(createArgs);\n194\t\n195\t    // Inventory just changed (soldCount + discountSoldCount). Drop the\n196\t    // 10-minute Redis cache for this event's ticket types so the public\n197\t    // event page reflects the new claim counts on the next fetch.\n198\t    await delTicketTypeCache(dto.eventId);\n199\t\n200\t    // Also invalidate per-ticket-type availability cache (30s TTL) for every\n201\t    // item in this booking so oversell windows are closed immediately.\n202\t    await Promise.all(\n203\t      dto.items.map((item) => delTicketAvailabilityCache(item.ticketTypeId)),\n204\t    );\n205\t\n206\t    // Mark waitlist entry as CONVERTED so the claim cannot be reused.\n207\t    if (claimedWaitlistId) {\n208\t      await this.waitlistRepository.markConverted(claimedWaitlistId);\n209\t    }\n210\t\n211\t    logger.info(\"Booking held\", {\n212\t      bookingId,\n213\t      userId,\n214\t      eventId: dto.eventId,\n215\t      subtotal,\n216\t      discountAmount,\n217\t      platformFee,\n218\t      gatewayFee,\n219\t      gst,\n220\t      feesBornBy,\n221\t      total,\n222\t      holdExpiresAt,\n223\t      requestId,\n224\t    });\n225\t\n226\t    // Enqueue a delayed job to expire the hold. A failure here is non-fatal —\n227\t    // the 60s sweep worker catches abandoned holds regardless.\n228\t    try {\n229\t      await bookingExpiryQueue.add(\n230\t        \"expire\",\n231\t        { bookingId },\n232\t        { delay: HOLD_DURATION_MS, jobId: `expire-${bookingId}` },\n233\t      );\n234\t    } catch (err) {\n235\t      logger.error(\"Failed to enqueue booking expiry job\", {\n236\t        bookingId,\n237\t        err: String(err),\n238\t      });\n239\t    }\n240\t\n241\t    // Invalidate user tickets cache so the new booking appears immediately\n242\t    await delUserTicketsCache(userId).catch(() => {});\n243\t\n244\t    return this.getForOwner(userId, bookingId);\n245\t  }\n246\t\n247\t  /**\n248\t   * Load a booking and assert ownership.\n249\t   * Throws ForbiddenError if the booking belongs to a different user.\n250\t   */\n251\t  async getForOwner(\n252\t    userId: string,\n253\t    bookingId: string,\n254\t  ): Promise<BookingDetails> {\n255\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n256\t\n257\t    if (booking.userId !== userId) {\n258\t      throw new ForbiddenError(\"You do not have access to this booking\");\n259\t    }\n260\t\n261\t    return booking;\n262\t  }\n263\t\n264\t  /**\n265\t   * Cancel a booking (user-initiated).\n266\t   * - HELD bookings: reverses inventory hold.\n267\t   * - PAID RSVP bookings (ticketingEnabled === false): marks cancelled directly.\n268\t   *   Paid ticket bookings are not cancellable here — use the refund flow.\n269\t   */\n270\t  async cancel(userId: string, bookingId: string): Promise<unknown> {\n271\t    const booking = await this.getForOwner(userId, bookingId);\n272\t\n273\t    if (\n274\t      booking.status === \"HELD\" ||\n275\t      booking.status === \"PENDING_APPROVAL\" ||\n276\t      booking.status === \"APPROVED_AWAITING_PAYMENT\"\n277\t    ) {\n278\t      const result = await this.bookingRepository.releaseHoldTx(\n279\t        bookingId,\n280\t        \"CANCELLED\",\n281\t      );\n282\t      await delTicketTypeCache(booking.eventId);\n283\t      await delUserTicketsCache(userId).catch(() => {});\n284\t      logger.info(\"Booking cancelled\", { bookingId, userId });\n285\t      return result;\n286\t    }\n287\t\n288\t    if (booking.status === \"PAID\" && !booking.event.ticketingEnabled) {\n289\t      await this.bookingRepository.cancelConfirmedFreeTx(bookingId);\n290\t      await delUserTicketsCache(userId).catch(() => {});\n291\t      logger.info(\"RSVP booking cancelled\", { bookingId, userId });\n292\t      return { cancelled: true };\n293\t    }\n294\t\n295\t    throw new ConflictError(\"Booking is not cancellable\");\n296\t  }\n297\t\n298\t  /**\n299\t   * Expire a HELD booking whose hold window has elapsed.\n300\t   * Called by the expiry worker — does NOT check ownership.\n301\t   */\n302\t  async expireIfDue(bookingId: string): Promise<unknown> {\n303\t    // Load eventId and holdExpiresAt before releasing — booking remains\n304\t    // addressable in either status.\n305\t    const found = await prisma.booking.findUnique({\n306\t      where: { bookingId },\n307\t      select: { eventId: true, holdExpiresAt: true, checkoutSessionId: true },\n308\t    });\n309\t\n310\t    // If a Razorpay payment order was created near the deadline the service\n311\t    // layer extends holdExpiresAt. Skip expiry if the hold is still live.\n312\t    if (!found || found.holdExpiresAt.getTime() > Date.now()) {\n313\t      return null;\n314\t    }\n315\t\n316\t    const result = await this.bookingRepository.releaseHoldTx(\n317\t      bookingId,\n318\t      \"EXPIRED\",\n319\t    );\n320\t\n321\t    if (result) {\n322\t      if (found?.eventId) await delTicketTypeCache(found.eventId);\n323\t      logger.info(\"Booking expired\", { bookingId });\n324\t\n325\t      // A Host API buyer who never paid: tell the host's server so it can free the order.\n326\t      if (found.checkoutSessionId) {\n327\t        const session = await new CheckoutSessionRepository()\n328\t          .findById(found.checkoutSessionId)\n329\t          .catch(() => null);\n330\t        if (session) {\n331\t          await enqueuePartnerWebhook(session.listerId, session.mode, \"booking.expired\", {\n332\t            bookingId,\n333\t            sessionId: session.sessionId,\n334\t            eventId: session.eventId,\n335\t            clientReference: session.clientReference,\n336\t          });\n337\t        }\n338\t      }\n339\t    }\n340\t\n341\t    return result;\n342\t  }\n343\t}\n344\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"0abb37f2-42e9-469f-a6b8-0b586d82637d","timestamp":"2026-11-20T17:39:19.752Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/services/booking/booking-lifecycle.service.ts","content":"import { prisma } from \"../../config/db\";\nimport logger from \"../../config/logger\";\nimport {\n  delTicketAvailabilityCache,\n  delTicketTypeCache,\n  delUserTicketsCache,\n} from \"../../lib/cache/ticket\";\nimport { bookingExpiryQueue } from \"../../lib/queues\";\nimport type { BookingRepository } from \"../../repositories/booking.repository\";\nimport { CheckoutSessionRepository } from \"../../repositories/checkout-session.repository\";\nimport type { UserRepository } from \"../../repositories/user.repository\";\nimport type { WaitlistRepository } from \"../../repositories/waitlist.repository\";\nimport { ConflictError, ForbiddenError, ValidationError } from \"../../utils/errors.util\";\nimport { enqueuePartnerWebhook } from \"../partner-webhook.service\";\nimport { uploadService } from \"../upload.service\";\nimport type { BookingPricingService } from \"./booking-pricing.service\";\nimport type { BookingDetails, CreateBookingDto } from \"./types\";\n\nconst HOLD_DURATION_MS = 10 * 60 * 1000; // 10 minutes\n\nexport class BookingLifecycleService {\n  constructor(\n    private readonly bookingRepository: BookingRepository,\n    private readonly waitlistRepository: WaitlistRepository,\n    private readonly userRepository: UserRepository,\n    private readonly pricingService: BookingPricingService,\n  ) {}\n\n  /**\n   * Create a new booking in HELD status.\n   *\n   * Steps:\n   *  1. Validate dto shape.\n   *  2. Load & validate TicketTypes (scope + salesCutoff + required fields).\n   *  3. Compute pricing.\n   *  4. Persist via repository (atomic hold transaction).\n   *  5. Return full booking detail.\n   */\n  async create(\n    userId: string,\n    dto: CreateBookingDto,\n    requestId: string,\n  ): Promise<BookingDetails> {\n    // ------------------------------------------------------------------\n    // 1. Validate dto\n    // ------------------------------------------------------------------\n    this.pricingService.validateDtoShape(dto);\n    uploadService.assertOwnUploads(userId, [\n      ...dto.commonFieldResponses,\n      ...dto.items.flatMap((i) => i.ticketFieldResponses.flat()),\n    ]);\n\n    // ------------------------------------------------------------------\n    // 2. Check event exists, sales not paused, and ticketingEnabled (RSVP flow)\n    // ------------------------------------------------------------------\n    const event = await prisma.event.findUnique({\n      where: { eventId: dto.eventId },\n      select: {\n        eventId: true,\n        salesPaused: true,\n        ticketingEnabled: true,\n        requiresApproval: true,\n        seatingMode: true,\n\n        waitlistUntil: true,\n      },\n    });\n\n    if (!event) {\n      throw new ValidationError(\"Event not found\");\n    }\n    // Waitlist-claimed users bypass both the salesPaused and requiresApproval\n    // gates — fetch once and reuse for both checks below.\n    let claimedWaitlistId: string | null = null;\n\n    if (event.salesPaused || event.requiresApproval) {\n      // Run user-email lookup and userId-based waitlist check in parallel.\n      // The waitlist query uses OR [userId, email]; passing \"\" for email lets\n      // the userId branch resolve without waiting for the user record first.\n      // Only if userId misses (email-only waitlist entry) do we retry with email.\n      const [userRecord, claimedByUserId] = await Promise.all([\n        this.userRepository.findEmailByUserId(userId),\n        this.waitlistRepository.findClaimedByUserIdOrEmail(\n          dto.eventId,\n          userId,\n          \"\",\n        ),\n      ]);\n\n      // If the userId-only pass didn't match, retry with the real email address.\n      const claimed =\n        claimedByUserId ??\n        (userRecord?.email\n          ? await this.waitlistRepository.findClaimedByUserIdOrEmail(\n              dto.eventId,\n              userId,\n              userRecord.email,\n            )\n          : null);\n\n      if (event.salesPaused && !claimed) {\n        throw new ValidationError(\"Sales are currently paused for this event\");\n      }\n      if (event.requiresApproval && !claimed) {\n        throw new ForbiddenError(\n          \"This event requires approval. Request access first.\",\n        );\n      }\n\n      claimedWaitlistId = claimed?.waitlistId ?? null;\n    }\n\n    // Ticketed events must have at least one item; RSVP events allow empty items\n    if (event.ticketingEnabled && dto.items.length === 0) {\n      throw new ValidationError(\"Booking must contain at least one item\");\n    }\n\n    await this.pricingService.validateSeatSelections(\n      dto.eventId,\n      event.seatingMode,\n      userId,\n      dto.items,\n    );\n\n    // Guard against hold-cycling: without this, a buyer could repeatedly\n    // call create() for the same event to keep refreshing a fresh\n    // HOLD_DURATION_MS window forever, holding scarce inventory without ever\n    // paying. At most one active (non-expired) HELD booking is allowed per\n    // user+event; callers that want to change quantities on their existing\n    // hold must pass supersedesBookingId instead of opening a second one.\n    // Scoped to HELD only — approval-flow statuses are governed by\n    // requestApproval()'s own rules and aren't affected by this guard.\n    if (!dto.supersedesBookingId) {\n      const existingHeld = await prisma.booking.findFirst({\n        where: {\n          userId,\n          eventId: dto.eventId,\n          status: \"HELD\",\n          holdExpiresAt: { gt: new Date() },\n        },\n        select: { bookingId: true },\n      });\n      if (existingHeld) {\n        throw new ConflictError(\n          `ACTIVE_BOOKING_EXISTS:${existingHeld.bookingId}`,\n        );\n      }\n    }\n\n    // ------------------------------------------------------------------\n    // 3-5. Validate ticket types + price the booking (shared helper).\n    // ------------------------------------------------------------------\n    const {\n      subtotal,\n      discountAmount,\n      platformFee,\n      gatewayFee,\n      gst,\n      total,\n      feesBornBy,\n      lines,\n    } = await this.pricingService.validateAndPrice(dto);\n\n    // ------------------------------------------------------------------\n    // 5. Persist with hold\n    // ------------------------------------------------------------------\n    const holdExpiresAt = new Date(Date.now() + HOLD_DURATION_MS);\n\n    const createArgs = {\n      userId,\n      eventId: dto.eventId,\n      subtotal,\n      platformFee,\n      gatewayFee,\n      gst,\n      feesBornBy,\n      total,\n      holdExpiresAt,\n      commonFieldResponses: dto.commonFieldResponses,\n      lines,\n      referrer: dto.referrer,\n      city: dto.city,\n      state: dto.state,\n      userAgent: dto.userAgent,\n      checkoutSessionId: dto.checkoutSessionId,\n    };\n\n    const bookingId = dto.supersedesBookingId\n      ? await this.bookingRepository.createWithHoldSupersedingTx(createArgs, {\n          bookingId: dto.supersedesBookingId,\n          userId,\n        })\n      : await this.bookingRepository.createWithHoldTx(createArgs);\n\n    // Inventory just changed (soldCount + discountSoldCount). Drop the\n    // 10-minute Redis cache for this event's ticket types so the public\n    // event page reflects the new claim counts on the next fetch.\n    await delTicketTypeCache(dto.eventId);\n\n    // Also invalidate per-ticket-type availability cache (30s TTL) for every\n    // item in this booking so oversell windows are closed immediately.\n    await Promise.all(\n      dto.items.map((item) => delTicketAvailabilityCache(item.ticketTypeId)),\n    );\n\n    // Mark waitlist entry as CONVERTED so the claim cannot be reused.\n    if (claimedWaitlistId) {\n      await this.waitlistRepository.markConverted(claimedWaitlistId);\n    }\n\n    logger.info(\"Booking held\", {\n      bookingId,\n      userId,\n      eventId: dto.eventId,\n      subtotal,\n      discountAmount,\n      platformFee,\n      gatewayFee,\n      gst,\n      feesBornBy,\n      total,\n      holdExpiresAt,\n      requestId,\n    });\n\n    // Enqueue a delayed job to expire the hold. A failure here is non-fatal —\n    // the 60s sweep worker catches abandoned holds regardless.\n    try {\n      await bookingExpiryQueue.add(\n        \"expire\",\n        { bookingId },\n        { delay: HOLD_DURATION_MS, jobId: `expire-${bookingId}` },\n      );\n    } catch (err) {\n      logger.error(\"Failed to enqueue booking expiry job\", {\n        bookingId,\n        err: String(err),\n      });\n    }\n\n    // Invalidate user tickets cache so the new booking appears immediately\n    await delUserTicketsCache(userId).catch(() => {});\n\n    return this.getForOwner(userId, bookingId);\n  }\n\n  /**\n   * Load a booking and assert ownership.\n   * Throws ForbiddenError if the booking belongs to a different user.\n   */\n  async getForOwner(\n    userId: string,\n    bookingId: string,\n  ): Promise<BookingDetails> {\n    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n\n    if (booking.userId !== userId) {\n      throw new ForbiddenError(\"You do not have access to this booking\");\n    }\n\n    return booking;\n  }\n\n  /**\n   * Cancel a booking (user-initiated).\n   * - HELD bookings: reverses inventory hold.\n   * - PAID RSVP bookings (ticketingEnabled === false): marks cancelled directly.\n   *   Paid ticket bookings are not cancellable here — use the refund flow.\n   */\n  async cancel(userId: string, bookingId: string): Promise<unknown> {\n    const booking = await this.getForOwner(userId, bookingId);\n\n    if (\n      booking.status === \"HELD\" ||\n      booking.status === \"PENDING_APPROVAL\" ||\n      booking.status === \"APPROVED_AWAITING_PAYMENT\"\n    ) {\n      const result = await this.bookingRepository.releaseHoldTx(\n        bookingId,\n        \"CANCELLED\",\n      );\n      await delTicketTypeCache(booking.eventId);\n      await delUserTicketsCache(userId).catch(() => {});\n      logger.info(\"Booking cancelled\", { bookingId, userId });\n      return result;\n    }\n\n    if (booking.status === \"PAID\" && !booking.event.ticketingEnabled) {\n      await this.bookingRepository.cancelConfirmedFreeTx(bookingId);\n      await delUserTicketsCache(userId).catch(() => {});\n      logger.info(\"RSVP booking cancelled\", { bookingId, userId });\n      return { cancelled: true };\n    }\n\n    throw new ConflictError(\"Booking is not cancellable\");\n  }\n\n  /**\n   * Expire a HELD booking whose hold window has elapsed.\n   * Called by the expiry worker — does NOT check ownership.\n   */\n  async expireIfDue(bookingId: string): Promise<unknown> {\n    // Load eventId and holdExpiresAt before releasing — booking remains\n    // addressable in either status.\n    const found = await prisma.booking.findUnique({\n      where: { bookingId },\n      select: { eventId: true, holdExpiresAt: true, checkoutSessionId: true },\n    });\n\n    // If a Razorpay payment order was created near the deadline the service\n    // layer extends holdExpiresAt. Skip expiry if the hold is still live.\n    if (!found || found.holdExpiresAt.getTime() > Date.now()) {\n      return null;\n    }\n\n    const result = await this.bookingRepository.releaseHoldTx(\n      bookingId,\n      \"EXPIRED\",\n    );\n\n    if (result) {\n      if (found?.eventId) await delTicketTypeCache(found.eventId);\n      logger.info(\"Booking expired\", { bookingId });\n\n      // A Host API buyer who never paid: tell the host's server so it can free the order.\n      if (found.checkoutSessionId) {\n        const session = await new CheckoutSessionRepository()\n          .findById(found.checkoutSessionId)\n          .catch(() => null);\n        if (session) {\n          await enqueuePartnerWebhook(session.listerId, session.mode, \"booking.expired\", {\n            bookingId,\n            sessionId: session.sessionId,\n            eventId: session.eventId,\n            clientReference: session.clientReference,\n          });\n        }\n      }\n    }\n\n    return result;\n  }\n}\n","numLines":344,"startLine":1,"totalLines":344}},"tool_result_meta":[{"id":"call-fd71fd5b-0b0a-48db-b5da-5f5588a45cc0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
