 [ticketValues, setTicketValues] = useState<\n    Record<string, Record<string, Record<string, string>>>\n  >({});\n  const [ticketErrors, setTicketErrors] = useState<\n    Record<string, Record<string, Record<string, string>>>\n  >({});\n\n  const [soldOutError, setSoldOutError] = useState<string | null>(null);\n  const [currentPage, setCurrentPage] = useState(0);\n\n  const [createBooking, { isLoading: isSubmittingBuy }] =\n    useCreateBookingMutation();\n  const [requestApproval, { isLoading: isSubmittingApproval }] =\n    useRequestBookingApprovalMutation();\n  const submitBooking = mode === \"approval\" ? requestApproval : createBooking;\n  const isSubmitting = isSubmittingBuy || isSubmittingApproval;\n  const [fetchBooking] = useLazyGetBookingQuery();\n  const [cancelBooking] = useCancelBookingMutation();\n  // Set while we're in the middle of resolving an ACTIVE_BOOKING_EXISTS\n  // conflict — used to suppress duplicate error toasts and re-entry.\n  const resumingRef = useRef(false);\n\n  const { city: userCity, state: userState } = useUserLocation();\n\n  const utmSource =\n    typeof window !== \"undefined\"\n      ? (new URLSearchParams(window.location.search).get(\"utm_source\") ??\n        getUTMParams().utmSource ??\n        undefined)\n      : undefined;\n\n  const { needsAttendees } = useBookingFlowConfig(eventId);\n  const autoStartedRef = useRef(false);\n  const isCreatingBookingRef = useRef(false);\n\n  // ── Resume helper ────────────────────────────────────────────────────────\n  // When the server throws ACTIVE_BOOKING_EXISTS:<id> (or\n  // SUPERSEDE_TARGET_NOT_HELD:<id>) it means the caller has a HELD\n  // booking they should pick up instead of opening a second one. We\n  // fetch it, rehydrate the slice + sessionStorage, and jump past\n  // attendees to the same step a successful create() would land on.\n  //\n  // If the held booking is no longer HELD (expired/cancelled/paid) we\n  // cancel it server-side to release inventory, then return \"retry\" so\n  // the caller can re-run create() with a clean slate.\n  const tryResumeHeldBooking = useCallback(\n    async (heldBookingId: string): Promise<\"resumed\" | \"retry\" | \"stuck\"> => {\n      if (resumingRef.current) return \"stuck\";\n      resumingRef.current = true;\n      try {\n        let existing: Awaited<ReturnType<typeof fetchBooking>>[\"data\"];\n        try {\n          existing = (await fetchBooking(heldBookingId)).data;\n        } catch {\n          return \"retry\";\n        }\n        if (!existing) return \"retry\";\n\n        const stillHeld =\n          existing.status === \"HELD\" &&\n          new Date(existing.holdExpiresAt).getTime() > Date.now();\n\n        if (!stillHeld) {\n          // Stale — free the inventory and let the caller retry.\n          try {\n            await cancelBooking(heldBookingId).unwrap();\n          } catch {}\n          return \"retry\";\n        }\n\n        // Rehydrate the in-progress state with the server's source of truth.\n        dispatch(bookingActions.setBookingId(existing.bookingId));\n        saveActiveBookingId(existing.bookingId);\n        const rebuiltLines = existing.tickets.map((t) => ({\n          ticketTypeId: t.ticketType.ticketTypeId,\n          quantity: t.quantity,\n          ticketFieldResponses: Array.from(\n            { length: t.quantity },\n            () => [] as FieldAnswer[],\n          ),\n        }));\n        dispatch(bookingActions.setLines(rebuiltLines));\n        setSoldOutError(null);\n        // Same destination a successful create() would land on.\n        dispatch(\n          bookingActions.setStep(\n            mode === \"approval\" ? 8 : mode === \"paid\" ? 4 : 7,\n          ),\n        );\n        return \"resumed\";\n      } finally {\n        resumingRef.current = false;\n      }\n    },\n    [fetchBooking, cancelBooking, dispatch, mode],\n  );\n\n  // Event-level fields — skip for team events (collected on lobby)\n  const { data: eventFieldsData } = useGetEventCustomFieldsQuery(eventId, {\n    skip: !eventId || isTeamMode,\n  });\n\n  // ── Field loaders ────────────────────────────────────────────────────────\n\n  const [commonFields, setCommonFields] = useState<CustomField[]>([]);\n  const [ticketFieldsMap, setTicketFieldsMap] = useState<\n    Record<\n      string,\n      {\n        fields: CustomField[];\n        typeName: string;\n        quantity: number;\n      }\n    >\n  >({});\n\n  const handleCommonFieldsLoaded = useCallback((fields: CustomField[]) => {\n    setCommonFields(fields);\n  }, []);\n\n  const handleTicketFieldsLoaded = useCallback(\n    (\n      fields: CustomField[],\n      ticketTypeId: string,\n      typeName: string,\n      quantity: number,\n    ) => {\n      setTicketFieldsMap((prev) => {\n        if (\n          prev[ticketTypeId]?.fields.length === fields.length &&\n          prev[ticketTypeId]?.quantity === quantity\n        ) {\n          return prev;\n        }\n        return {\n          ...prev,\n          [ticketTypeId]: { fields, typeName, quantity },\n        };\n      });\n    },\n    [],\n  );\n\n  const handleCommonChange = useCallback((fieldId: string, value: string) => {\n    setCommonValues((prev) => ({ ...prev, [fieldId]: value }));\n    setCommonErrors((prev) => {\n      const next = { ...prev };\n      delete next[fieldId];\n      return next;\n    });\n  }, []);\n\n  const handleTicketChange = useCallback(\n    (\n      ticketTypeId: string,\n      ticketIndex: number,\n      fieldId: string,\n      value: string,\n    ) => {\n      setTicketValues((prev) => ({\n        ...prev,\n        [ticketTypeId]: {\n          ...prev[ticketTypeId],","numLines":200,"startLine":300,"totalLines":1275}},"tool_result_meta":[{"id":"call-8567dd67-c957-4fca-903d-8df367526ef8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
