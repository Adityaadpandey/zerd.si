{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-a8bf0278-ec90-4348-ac39-1cb55dc31866","type":"tool_result","content":"      if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n        // Every bundle member's ticket row for the same bundle purchase\n        // carries the IDENTICAL quantity (the number of bundle-units\n        // bought) — summing across members would multi-count by the\n        // bundle's member count, so take the quantity once per group.\n        groupDiscountAgg.set(\n          ticket.bundleGroupId,\n          Math.max(\n            groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n            ticket.quantity,\n          ),\n        );\n      }\n    }\n\n    for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n      await tx.$executeRaw`\n\t\t\t\t\tUPDATE \"TicketType\"\n\t\t\t\t\tSET \"soldCount\" = \"soldCount\" - ${totalQty},\n\t\t\t\t\t    \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n\t\t\t\t\t  AND \"soldCount\" >= ${totalQty}\n\t\t\t\t`;\n    }\n\n    for (const [groupId, discountQty] of groupDiscountAgg) {\n      await tx.$executeRaw`\n\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n\t\t\t\t\tSET \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n\t\t\t\t`;\n    }\n\n    const ticketIds = tickets.map((t) => t.ticketId);\n    if (ticketIds.length > 0) {\n      await tx.ticket.updateMany({\n        where: { ticketId: { in: ticketIds } },\n        data: { status: TicketPaymentStatus.FAILED },\n      });\n    }\n\n    // Reserved seating: give the physical seats back so other buyers can\n    // select them again. Covers expiry, user cancellation, and supersede —\n    // every release path in this codebase funnels through here.\n    const releasedSeatIds = tickets\n      .map((t) => t.seatId)\n      .filter((id): id is string => id != null);\n    if (releasedSeatIds.length > 0) {\n      await tx.seat.updateMany({\n        where: { seatId: { in: releasedSeatIds } },\n        data: { status: \"AVAILABLE\", holdBookingId: null, holdExpiresAt: null },\n      });\n    }\n\n    // If a released ticket belonged to a CONFIRMED team's open-seat\n    // reservation (§2 of the open-seats design), the buyer abandoned\n    // checkout — undo the reservation: drop the awaiting `TeamMember` row\n    // and give the seat back. Scoped narrowly to CONFIRMED teams because a\n    // leader's original `createTeamBooking` PENDING tickets are created\n    // while the team is still PENDING — those never hit this branch and\n    // never had `currentSize` incremented for them in the first place.\n    const teamTicketOwners = new Map<string, string>();\n    for (const t of tickets) {\n      if (t.teamId) teamTicketOwners.set(t.userId, t.teamId);\n    }\n    for (const [userId, teamId] of teamTicketOwners) {\n      const team = await tx.team.findUnique({\n        where: { teamId },\n        select: { status: true },\n      });\n      if (team?.status !== \"CONFIRMED\") continue;\n\n      const removed = await tx.teamMember.deleteMany({\n        where: { teamId, userId, ticketId: null },\n      });\n      if (removed.count > 0) {\n        await tx.team.update({\n          where: { teamId },\n          data: { currentSize: { decrement: 1 } },\n        });\n      }\n    }\n\n    return true;\n  }\n\n  /**\n   * Extend the hold window for a HELD or APPROVED_AWAITING_PAYMENT booking.\n   * Used by the payment service when a Razorpay order is created so the\n   * in-flight payment isn't expired before it can be verified.","is_error":false}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"eac475eb-70cd-43f7-8720-7ac1f27c7faa","timestamp":"2026-11-20T17:54:26.465Z","tool_use_result":{"stdout":"      if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n        // Every bundle member's ticket row for the same