okingId,\n51\t      userId,\n52\t      requestId: req.requestId,\n53\t    });\n54\t\n55\t    return SuccessHandler.created(res, \"Booking created\", booking);\n56\t  }, \"Create Booking\");\n57\t\n58\t  /**\n59\t   * POST /api/v1/bookings/request-approval\n60\t   * Buyer-initiated approval request for an event with requiresApproval=true.\n61\t   * Creates a Booking in PENDING_APPROVAL with snapshotted pricing + custom-\n62\t   * field answers; no Razorpay order is created until the host approves.\n63\t   */\n64\t  requestApproval = asyncHandler(\n65\t    async (req: AuthenticatedRequest, res: Response) => {\n66\t      const body = requestApprovalBody.parse(req.body);\n67\t      const userId = requireUser(req).userId;\n68\t      const userAgent =\n69\t        (req.headers[\"user-agent\"] as string | undefined) || undefined;\n70\t\n71\t      const booking = await this.bookingService.requestApproval(\n72\t        userId,\n73\t        { ...body, userAgent },\n74\t        req.requestId ?? \"\",\n75\t      );\n76\t\n77\t      logger.info(\"Approval request created via API\", {\n78\t        bookingId: booking?.bookingId,\n79\t        userId,\n80\t        requestId: req.requestId,\n81\t      });\n82\t\n83\t      return SuccessHandler.created(res, \"Approval request submitted\", booking);\n84\t    },\n85\t    \"Request Approval Booking\",\n86\t  );\n87\t\n88\t  /**\n89\t   * GET /api/v1/bookings/approval-claim/:token\n90\t   * Public — resolves an approval-claim token (from the buyer's approval\n91\t   * email) to a bookingId so the web client can resume at the payment step.\n92\t   */\n93\t  resolveApprovalClaim = asyncHandler(\n94\t    async (req: AuthenticatedRequest, res: Response) => {\n95\t      const { token } = approvalClaimParams.parse(req.params);\n96\t      const result = await this.bookingService.resolveApprovalClaim(token);\n97\t\n98\t      if (!result) {\n99\t        return SuccessHandler.okWithData(res, \"Approval claim resolved\", {\n100\t          valid: false,\n101\t        } as const);\n102\t      }\n103\t\n104\t      return SuccessHandler.okWithData(res, \"Approval claim resolved\", {\n105\t        valid: true,\n106\t        bookingId: result.bookingId,\n107\t        eventId: result.eventId,\n108\t        holdExpiresAt: result.holdExpiresAt,\n109\t      } as const);\n110\t    },\n111\t    \"Resolve Approval Claim\",\n112\t  );\n113\t\n114\t  /**\n115\t   * GET /api/v1/bookings/my-approved/:eventId\n116\t   * Return the most-recent APPROVED_AWAITING_PAYMENT booking for the\n117\t   * authenticated user + event whose hold has not expired, or null.\n118\t   */\n119\t  getMyApprovedBookingForEvent = asyncHandler(\n120\t    async (req: AuthenticatedRequest, res: Response) => {\n121\t      const userId = requireUser(req).userId;\n122\t      const eventId = req.params.eventId as string;\n123\t\n124\t      const booking = await this.bookingService.getMyApprovedBookingForEvent(\n125\t        userId,\n126\t        eventId,\n127\t      );\n128\t\n129\t      return SuccessHandler.okWithData(\n130\t        res,\n131\t        SuccessMessages.DATA_FETCHED,\n132\t        booking,\n133\t      );\n134\t    },\n135\t    \"Get My Approved Booking For Event\",\n136\t  );\n137\t\n138\t  /**\n139\t   * GET /api/v1/bookings/:id\n140\t   * Retrieve a booking owned by the authenticated user\n141\t   */\n142\t  get = asyncHandler(async (req: AuthenticatedRequest, res: Response) => {\n143\t    const userId = requireUser(req).userId;\n144\t    const id = req.params.id as string;\n145\t\n146\t    const booking = await this.bookingService.getForOwner(userId, id);\n147\t\n148\t    return SuccessHandler.okWithData(\n149\t      res,\n150\t      SuccessMessages.DATA_FETCHED,\n151\t      booking,\n152\t    );\n153\t  }, \"Get Booking\");\n154\t\n155\t  /**\n156\t   * PATCH /api/v1/bookings/:id/discount\n157\t   * Apply or remove a discount code on a booking\n158\t   */\n159\t  applyDiscount = asyncHandler(\n160\t    async (req: AuthenticatedRequest, res: Response) => {\n161\t      const { code } = applyDiscountBody.parse(req.body);\n162\t      const userId = requireUser(req).userId;\n163\t      const id = req.params.id as string;\n164\t\n165\t      const booking = await this.bookingService.applyDiscount(userId, id, code);\n166\t\n167\t      logger.info(\"Discount applied to booking via API\", {\n168\t        bookingId: id,\n169\t        userId,\n170\t        code,\n171\t      });\n172\t\n173\t      return SuccessHandler.okWithData(res, \"Discount applied\", booking);\n174\t    },\n175\t    \"Apply Discount to Booking\",\n176\t  );\n177\t\n178\t  /**\n179\t   * DELETE /api/v1/bookings/:id\n180\t   * Cancel a booking owned by the authenticated user"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"874e4bff-05f0-4aaf-87e3-d3dcb42e08b6","timestamp":"2026-11-20T17:57:01.771Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/server/src/controllers/booking.controller.ts","content":"import type { Response } from \"express\";\nimport logger from \"../config/logger\";\nimport { BookingService } from \"../services/booking.service\";\nimport { PaymentService } from \"../services/payment.service\";\nimport type { AuthenticatedRequest } from \"../types\";\nimport {\n  applyDiscountBody,\n  approvalClaimParams,\n  createBookingBody,\n  requestApprovalBody,\n  verifyBookingPaymentBody,\n} from \"../types/booking.type\";\nimport { requireUser } from \"../utils/auth-request.util\";\nimport { asyncHandler } from \"../utils/error-handler.util\";\nimport { SuccessHandler, SuccessMessages } from \"../utils/success-handler.util\";\n\n/**\n * Booking Controller\n * Handles HTTP requests for the booking flow\n */\nexport class BookingController {\n  private bookingService: BookingService;\n  private paymentService: PaymentService;\n\n  constructor(\n    bookingService?: BookingService,\n    paymentService?: PaymentService,\n  ) {\n    this.bookingService = bookingService ?? new BookingService();\n    this.paymentService = paymentService ?? new PaymentService();\n  }\n\n  /**\n   * POST /api/v1/bookings\n   * Create a new booking in HELD status\n   */\n  create = asyncHandler(async (req: AuthenticatedRequest, res: Response) => {\n    const body = createBookingBody.parse(req.body);\n    const userId = requireUser(req).userId;\n    const userAgent =\n      (req.headers[\"user-agent\"] as string | undefined) || undefined;\n\n    const booking = await this.bookingService.create(\n      userId,\n      { ...body, userAgent },\n      req.requestId ?? \"\",\n    );\n\n    logger.info(\"Booking created via API\", {\n      bookingId: booking?.bookingId,\n      userId,\n      requestId: req.requestId,\n    });\n\n    return SuccessHandler.created(res, \"Booking created\", booking);\n  }, \"Create Booking\");\n\n  /**\n   * POST /api/v1/bookings/request-approval\n   * Buyer-initiated approval request for an event with requiresApproval=true.\n   * Creates a Booking in PENDING_APPROVAL with snapshotted pricing + custom-\n   * field answers; no Razorpay order is created until the host approves.\n   */\n  requestApproval = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const body = requestApprovalBody.parse(req.body);\n      const userId = requireUser(req).userId;\n      const userAgent =\n        (req.headers[\"user-agent\"] as string | undefined) || undefined;\n\n      const booking = await this.bookingService.requestApproval(\n        userId,\n        { ...body, userAgent },\n        req.requestId ?? \"\",\n      );\n\n      logger.info(\"Approval request created via API\", {\n        bookingId: booking?.bookingId,\n        userId,\n        requestId: req.requestId,\n      });\n\n      return SuccessHandler.created(res, \"Approval request submitted\", booking);\n    },\n    \"Request Approval Booking\",\n  );\n\n  /**\n   * GET /api/v1/bookings/approval-claim/:token\n   * Public — resolves an approval-claim token (from the buyer's approval\n   * email) to a bookingId so the web client can resume at the payment step.\n   */\n  resolveApprovalClaim = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const { token } = approvalClaimParams.parse(req.params);\n      const result = await this.bookingService.resolveApprovalClaim(token);\n\n      if (!result) {\n        return SuccessHandler.okWithData(res, \"Approval claim resolved\", {\n          valid: false,\n        } as const);\n      }\n\n      return SuccessHandler.okWithData(res, \"Approval claim resolved\", {\n        valid: true,\n        bookingId: result.bookingId,\n        eventId: result.eventId,\n        holdExpiresAt: result.holdExpiresAt,\n      } as const);\n    },\n    \"Resolve Approval Claim\",\n  );\n\n  /**\n   * GET /api/v1/bookings/my-approved/:eventId\n   * Return the most-recent APPROVED_AWAITING_PAYMENT booking for the\n   * authenticated user + event whose hold has not expired, or null.\n   */\n  getMyApprovedBookingForEvent = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const userId = requireUser(req).userId;\n      const eventId = req.params.eventId as string;\n\n      const booking = await this.bookingService.getMyApprovedBookingForEvent(\n        userId,\n        eventId,\n      );\n\n      return SuccessHandler.okWithData(\n        res,\n        SuccessMessages.DATA_FETCHED,\n        booking,\n      );\n    },\n    \"Get My Approved Booking For Event\",\n  );\n\n  /**\n   * GET /api/v1/bookings/:id\n   * Retrieve a booking owned by the authenticated user\n   */\n  get = asyncHandler(async (req: AuthenticatedRequest, res: Response) => {\n    const userId = requireUser(req).userId;\n    const id = req.params.id as string;\n\n    const booking = await this.bookingService.getForOwner(userId, id);\n\n    return SuccessHandler.okWithData(\n      res,\n      SuccessMessages.DATA_FETCHED,\n      booking,\n    );\n  }, \"Get Booking\");\n\n  /**\n   * PATCH /api/v1/bookings/:id/discount\n   * Apply or remove a discount code on a booking\n   */\n  applyDiscount = asyncHandler(\n    async (req: AuthenticatedRequest, res: Response) => {\n      const { code } = applyDiscountBody.parse(req.body);\n      const userId = requireUser(req).userId;\n      const id = req.params.id as string;\n\n      const booking = await this.bookingService.applyDiscount(userId, id, code);\n\n      logger.info(\"Discount applied to booking via API\", {\n        bookingId: id,\n        userId,\n        code,\n      });\n\n      return SuccessHandler.okWithData(res, \"Discount applied\", booking);\n    },\n    \"Apply Discount to Booking\",\n  );\n\n  /**\n   * DELETE /api/v1/bookings/:id\n   * Cancel a booking owned by the authenticated user","numLines":180,"startLine":1,"totalLines":263}},"tool_result_meta":[{"id":"call-8cbb5480-3bb6-499e-a501-44bc61d5ef87","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
