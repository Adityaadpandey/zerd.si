{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06b95a7149864485f0","type":"tool_result","content":"1\timport type { Payments } from \"razorpay/dist/types/payments\";\n2\timport { config } from \"../../config\";\n3\timport logger from \"../../config/logger\";\n4\timport {\n5\t  getListerKeySecret,\n6\t  getRazorpayInstance,\n7\t} from \"../../lib/razorpay-factory\";\n8\timport { BookingRepository } from \"../../repositories/booking.repository\";\n9\timport { EventRepository } from \"../../repositories/event.repository\";\n10\timport { PaymentRepository } from \"../../repositories/payment.repository\";\n11\timport { RazorpayConfigRepository } from \"../../repositories/razorpay-config.repository\";\n12\timport {\n13\t  PAYMENT_CONSTANTS,\n14\t  PAYMENT_ERROR_MESSAGES,\n15\t} from \"../../types/payment.types\";\n16\timport { razorpayCircuitBreaker } from \"../../utils/circuit-breaker.util\";\n17\timport { decrypt } from \"../../utils/encryption.util\";\n18\timport {\n19\t  BadRequestError,\n20\t  ConflictError,\n21\t  ForbiddenError,\n22\t  NotFoundError,\n23\t  ValidationError,\n24\t} from \"../../utils/errors.util\";\n25\timport { toPaise } from \"../../utils/money.util\";\n26\timport { BookingPaymentFinalizerService } from \"./booking-payment-finalizer.service\";\n27\timport { verifyPaymentSignature } from \"./payment-signature.util\";\n28\t\n29\t/**\n30\t * Booking-flow payment methods (Razorpay order creation + verification for\n31\t * the Booking model — separate from the legacy ticket-based flow).\n32\t */\n33\texport class BookingPaymentService {\n34\t  private paymentRepository: PaymentRepository;\n35\t  private eventRepository: EventRepository;\n36\t  private bookingRepository: BookingRepository;\n37\t  private razorpayConfigRepository: RazorpayConfigRepository;\n38\t  private finalizer: BookingPaymentFinalizerService;\n39\t\n40\t  constructor(\n41\t    paymentRepository?: PaymentRepository,\n42\t    eventRepository?: EventRepository,\n43\t    finalizer?: BookingPaymentFinalizerService,\n44\t  ) {\n45\t    this.paymentRepository = paymentRepository ?? new PaymentRepository();\n46\t    this.eventRepository = eventRepository ?? new EventRepository();\n47\t    this.bookingRepository = new BookingRepository();\n48\t    this.razorpayConfigRepository = new RazorpayConfigRepository();\n49\t    this.finalizer = finalizer ?? new BookingPaymentFinalizerService();\n50\t  }\n51\t\n52\t  /**\n53\t   * Confirm a zero-total (free/RSVP) booking without touching Razorpay.\n54\t   * Throws BadRequestError if the booking has a non-zero total.\n55\t   */\n56\t  async confirmFreeBooking(userId: string, bookingId: string) {\n57\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n58\t\n59\t    if (booking.userId !== userId) {\n60\t      throw new ForbiddenError(\"Not your booking\");\n61\t    }\n62\t\n63\t    if (\n64\t      booking.status !== \"HELD\" &&\n65\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n66\t    ) {\n67\t      throw new ConflictError(\"Booking is not in HELD state\");\n68\t    }\n69\t\n70\t    if (booking.holdExpiresAt.getTime() < Date.now()) {\n71\t      throw new ConflictError(\"Hold expired\");\n72\t    }\n73\t\n74\t    if (booking.total !== 0) {\n75\t      throw new BadRequestError(\"Booking is not free\");\n76\t    }\n77\t\n78\t    await this.finalizer.finalizePaidBooking(bookingId);\n79\t\n80\t    logger.info(\"Free booking confirmed\", { bookingId, userId });\n81\t\n82\t    return { confirmed: true };\n83\t  }\n84\t\n85\t  async createPaymentOrderForBooking(\n86\t    userId: string,\n87\t    bookingId: string,\n88\t  ): Promise<{\n89\t    razorpayOrderId: string;\n90\t    keyId: string;\n91\t    amount: number;\n92\t    isFree?: boolean;\n93\t  }> {\n94\t    // Load booking with payment and event\n95\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n96\t\n97\t    // Ownership check\n98\t    if (booking.userId !== userId) {\n99\t      throw new ForbiddenError(\"Not your booking\");\n100\t    }\n101\t\n102\t    // Status check\n103\t    if (\n104\t      booking.status !== \"HELD\" &&\n105\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n106\t    ) {\n107\t      throw new ConflictError(\"Booking is not in HELD state\");\n108\t    }\n109\t\n110\t    // Hold expiry check\n111\t    if (booking.holdExpiresAt.getTime() < Date.now()) {\n112\t      throw new ConflictError(\"Hold expired\");\n113\t    }\n114\t\n115\t    // Free / RSVP booking — skip Razorpay, confirm immediately\n116\t    if (booking.total === 0) {\n117\t      await this.finalizer.finalizePaidBooking(bookingId);\n118\t      logger.info(\"Free booking confirmed without Razorpay\", {\n119\t        bookingId,\n120\t        userId,\n121\t      });\n122\t      return {\n123\t        razorpayOrderId: \"\",\n124\t        keyId: \"\",\n125\t        amount: 0,\n126\t        isFree: true,\n127\t      };\n128\t    }\n129\t\n130\t    // Idempotency: if a PENDING order already exists AND its amount still\n131\t    // matches the live booking total, return it as-is. If the booking was\n132\t    // repriced since the order was created (coupon applied/removed via\n133\t    // applyDiscount, which reprices Booking+Ticket rows but never touches\n134\t    // Payment — booking.repository.ts repriceWithDiscount), the old Razorpay\n135\t    // order is stale: reusing it would let the buyer pay the OLD amount while\n136\t    // the booking confirms at the NEW (possibly higher) total. Fall through\n137\t    // and mint a fresh order instead.\n138\t    if (\n139\t      booking.payment?.razorpayOrderId &&\n140\t      booking.payment.status === \"PENDING\" &&\n141\t      toPaise(booking.payment.amount) === toPaise(booking.total)\n142\t    ) {\n143\t      // Determine keyId: use listerRazorpayConfigId if present, else platform key\n144\t      let keyId = config.RAZORPAY_KEY_ID;\n145\t      if (booking.payment.listerRazorpayConfigId) {\n146\t        try {\n147\t          const listerConfig = await this.razorpayConfigRepository.findById(\n148\t            booking.payment.listerRazorpayConfigId,\n149\t          );\n150\t          if (listerConfig?.encryptedKeyId) {\n151\t            keyId = decrypt(listerConfig.encryptedKeyId);\n152\t          }\n153\t        } catch {\n154\t          // fall back to platform key\n155\t        }\n156\t      }\n157\t\n158\t      // Extend the hold even on retry — the original 15-min window may have\n159\t      // shrunk if the user dismissed and reopened payment near expiry.\n160\t      await this.bookingRepository.extendHold(\n161\t        bookingId,\n162\t        new Date(Date.now() + 15 * 60 * 1000),\n163\t      );\n164\t\n165\t      return {\n166\t        razorpayOrderId: booking.payment.razorpayOrderId,\n167\t        keyId,\n168\t        amount: Math.round(booking.total * 100), // paise\n169\t      };\n170\t    }\n171\t\n172\t    // Get event's listerId to route to correct Razorpay account\n173\t    const event = await this.eventRepository.findByIdMinimal(\n174\t      booking.event.eventId,\n175\t    );\n176\t    if (!event) {\n177\t      throw new NotFoundError(\"Event not found\");\n178\t    }\n179\t\n180\t    const {\n181\t      instance: razorpayInstance,\n182\t      configId,\n183\t      razorpayKeyId,\n184\t    } = await getRazorpayInstance(event.listerId);\n185\t\n186\t    // Create Razorpay order\n187\t    let razorpayOrder: { id: string };\n188\t    try {\n189\t      razorpayOrder = await razorpayCircuitBreaker.execute(() =>\n190\t        razorpayInstance.orders.create({\n191\t          amount: Math.round(booking.total * 100), // paise\n192\t          currency: PAYMENT_CONSTANTS.DEFAULT_CURRENCY,\n193\t          receipt: bookingId,\n194\t          notes: {\n195\t            bookingId,\n196\t            userId,\n197\t          },\n198\t        }),\n199\t      );\n200\t    } catch (error) {\n201\t      logger.error(\"Razorpay order creation failed for booking\", {\n202\t        error,\n203\t        bookingId,\n204\t        userId,\n205\t      });\n206\t      throw new BadRequestError(\n207\t        PAYMENT_ERROR_MESSAGES.RAZORPAY_ORDER_CREATION_FAILED,\n208\t      );\n209\t    }\n210\t\n211\t    // Upsert the Payment row keyed on bookingId\n212\t    await this.paymentRepository.upsertForBooking({\n213\t      userId,\n214\t      eventId: booking.event.eventId,\n215\t      bookingId,\n216\t      razorpayOrderId: razorpayOrder.id,\n217\t      amount: booking.total,\n218\t      platformFee: booking.platformFee,\n219\t      // HOST: lister nets face − platformFee − gatewayFee\n220\t      // USER: lister nets full face (buyer paid fees)\n221\t      // MIXED: conservatively deduct all fees\n222\t      listerRevenue:\n223\t        booking.feesBornBy === \"USER\"\n224\t          ? booking.subtotal\n225\t          : booking.subtotal - booking.platformFee - booking.gatewayFee,\n226\t      receiptId: bookingId,\n227\t      currency: PAYMENT_CONSTANTS.DEFAULT_CURRENCY,\n228\t      listerRazorpayConfigId: configId ?? undefined,\n229\t    });\n230\t\n231\t    // Extend the hold window so an in-flight Razorpay payment isn't expired\n232\t    // before verifyBookingPayment can run. 15 minutes covers even slow 3DS\n233\t    // flows; the booking expiry worker checks holdExpiresAt before expiring.\n234\t    await this.bookingRepository.extendHold(\n235\t      bookingId,\n236\t      new Date(Date.now() + 15 * 60 * 1000),\n237\t    );\n238\t\n239\t    logger.info(\"Razorpay order created for booking\", {\n240\t      orderId: razorpayOrder.id,\n241\t      bookingId,\n242\t      userId,\n243\t      amount: booking.total,\n244\t    });\n245\t\n246\t    return {\n247\t      razorpayOrderId: razorpayOrder.id,\n248\t      keyId: razorpayKeyId,\n249\t      amount: Math.round(booking.total * 100), // paise\n250\t    };\n251\t  }\n252\t\n253\t  /**\n254\t   * Verify Razorpay payment signature and confirm a booking.\n255\t   */\n256\t  async verifyBookingPayment(\n257\t    userId: string,\n258\t    bookingId: string,\n259\t    signed: {\n260\t      razorpay_order_id: string;\n261\t      razorpay_payment_id: string;\n262\t      razorpay_signature: string;\n263\t    },\n264\t  ): Promise<unknown> {\n265\t    const { razorpay_order_id, razorpay_payment_id, razorpay_signature } =\n266\t      signed;\n267\t\n268\t    // Load booking + payment\n269\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n270\t\n271\t    // Ownership check\n272\t    if (booking.userId !== userId) {\n273\t      throw new ForbiddenError(\"Not your booking\");\n274\t    }\n275\t\n276\t    // Status check. The Razorpay webhook (handlePaymentCaptured) can race\n277\t    // this client-initiated verify call and finalize the booking first —\n278\t    // Razorpay fires the webhook independently of the checkout success\n279\t    // callback, and the webhook is often faster. If that happened, the\n280\t    // booking is already correctly PAID for *this* order; treat it as an\n281\t    // idempotent success instead of erroring, mirroring the webhook's own\n282\t    // already-PAID short-circuit (handlePaymentCaptured above). Only do this\n283\t    // when the completed payment matches the order this call is verifying —\n284\t    // otherwise fall through to the ConflictError below.\n285\t    if (\n286\t      booking.status === \"PAID\" &&\n287\t      booking.payment?.razorpayOrderId === razorpay_order_id\n288\t    ) {\n289\t      await this.finalizer.confirmTeamFromBookingResult(bookingId, booking);\n290\t      return booking;\n291\t    }\n292\t\n293\t    if (\n294\t      booking.status !== \"HELD\" &&\n295\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n296\t    ) {\n297\t      throw new ConflictError(\"Booking is not in HELD state\");\n298\t    }\n299\t\n300\t    // Hold expiry check\n301\t    if (booking.holdExpiresAt.getTime() < Date.now()) {\n302\t      throw new ConflictError(\"Hold expired\");\n303\t    }\n304\t\n305\t    // The signed order must be THIS booking's own order. Without it, one captured payment\n306\t    // (say a Rs 500 order for booking A) could be replayed against booking B of the same\n307\t    // total, and both would finalise for a single payment.\n308\t    if (booking.payment?.razorpayOrderId !== razorpay_order_id) {\n309\t      logger.error(\"Booking payment order does not belong to this booking\", {\n310\t        bookingId,\n311\t        userId,\n312\t        orderId: razorpay_order_id,\n313\t      });\n314\t      throw new ValidationError(\"Payment does not belong to this booking\");\n315\t    }\n316\t\n317\t    // Determine which key secret to use\n318\t    let keySecret = config.RAZORPAY_KEY_SECRET;\n319\t    if (booking.payment?.listerRazorpayConfigId) {\n320\t      keySecret = await getListerKeySecret(\n321\t        booking.payment.listerRazorpayConfigId,\n322\t      );\n323\t    }\n324\t\n325\t    // Verify Razorpay signature\n326\t    const isValid = verifyPaymentSignature(\n327\t      razorpay_order_id,\n328\t      razorpay_payment_id,\n329\t      razorpay_signature,\n330\t      keySecret,\n331\t    );\n332\t\n333\t    if (!isValid) {\n334\t      logger.error(\"Booking payment signature verification failed\", {\n335\t        orderId: razorpay_order_id,\n336\t        bookingId,\n337\t        userId,\n338\t      });\n339\t      throw new ValidationError(\"Signature mismatch\");\n340\t    }\n341\t\n342\t    // Reconcile the actually-captured amount against the live booking total.\n343\t    // A HELD booking's total can move after the Razorpay order was created\n344\t    // (coupon applied/removed via applyDiscount reprices Booking+Ticket rows\n345\t    // but never touches the existing Payment/order — see\n346\t    // createPaymentOrderForBooking's idempotency guard for the other half of\n347\t    // this fix). Verifying only the HMAC signature proves the payment belongs\n348\t    // to this order, not that its amount still matches what's owed now.\n349\t    const { instance: razorpayInstance } = await getRazorpayInstance(\n350\t      booking.event.listerId,\n351\t    );\n352\t\n353\t    let razorpayPayment: Payments.RazorpayPayment;\n354\t    try {\n355\t      razorpayPayment = await razorpayCircuitBreaker.execute(() =>\n356\t        razorpayInstance.payments.fetch(razorpay_payment_id),\n357\t      );\n358\t    } catch (error) {\n359\t      logger.error(\"Failed to fetch Razorpay payment for booking verification\", {\n360\t        error,\n361\t        bookingId,\n362\t        paymentId: razorpay_payment_id,\n363\t      });\n364\t      throw new BadRequestError(\n365\t        PAYMENT_ERROR_MESSAGES.RAZORPAY_PAYMENT_VERIFICATION_FAILED,\n366\t      );\n367\t    }\n368\t\n369\t    if (razorpayPayment.status !== \"captured\") {\n370\t      throw new BadRequestError(PAYMENT_ERROR_MESSAGES.PAYMENT_FAILED);\n371\t    }\n372\t\n373\t    const capturedAmount = (razorpayPayment.amount as number) / 100;\n374\t    if (toPaise(capturedAmount) !== toPaise(booking.total)) {\n375\t      logger.error(\"Booking payment amount mismatch — refusing to finalize\", {\n376\t        bookingId,\n377\t        orderId: razorpay_order_id,\n378\t        paymentId: razorpay_payment_id,\n379\t        capturedAmount,\n380\t        bookingTotal: booking.total,\n381\t      });\n382\t      await this.paymentRepository.markAsFailed(razorpay_order_id, {\n383\t        failureReason: `Captured amount ₹${capturedAmount} does not match booking total ₹${booking.total}`,\n384\t      });\n385\t      throw new ConflictError(\n386\t        \"Payment amount does not match the current booking total — the price may have changed since checkout started. Please retry payment.\",\n387\t      );\n388\t    }\n389\t\n390\t    // Update Payment row with Razorpay payment details\n391\t    await this.paymentRepository.updatePaymentVerification(razorpay_order_id, {\n392\t      razorpayPaymentId: razorpay_payment_id,\n393\t      razorpaySignature: razorpay_signature,\n394\t      status: \"COMPLETED\",\n395\t    });\n396\t\n397\t    // Finalize the booking (atomic tickets → SUCCESS + booking → PAID + discount + email)\n398\t    const result = await this.finalizer.finalizePaidBooking(bookingId);\n399\t\n400\t    // Team confirmation: if any tickets in this booking belong to a team,\n401\t    // mirror the team-confirmation logic from the ticket-based verify path.\n402\t    await this.finalizer.confirmTeamFromBookingResult(bookingId, result);\n403\t\n404\t    return result;\n405\t  }\n406\t}\n407\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"120bbd5b-e6f7-44f2-b40c-8a96c13fc945","timestamp":"2026-11-20T17:35:08.229Z","tool_result_meta":[{"id":"call_01a1fa06b95a7149864485f0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-2cfba1f1-d390-4683-a7de-85532c812ac8","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport PiArrowRightStroke from \"@icons/stroke/arrows-&-chevrons/PiArrowRightStroke\";\n4\timport PiPencilEditStroke from \"@icons/stroke/general/PiPencilEditStroke\";\n5\timport PiPlusDefaultStroke from \"@icons/stroke/maths/PiPlusDefaultStroke\";\n6\timport PiMapPinStroke from \"@icons/stroke/navigation/PiMapPinStroke\";\n7\timport PiClockDefaultStroke from \"@icons/stroke/time/PiClockDefaultStroke\";\n8\timport { buildCreateBookingRequest, getApiErrorMessage } from \"@tunyt/shared\";\n9\timport Image from \"next/image\";\n10\timport { useRouter } from \"next/navigation\";\n11\timport { memo, useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n12\timport BookingSummary from \"@/components/booking/BookingSummary\";\n13\timport HoldCountdown from \"@/components/booking/HoldCountdown\";\n14\timport { Avatar } from \"@/components/ui/Avatar\";\n15\timport { useUserLocation } from \"@/hooks/useUserLocation\";\n16\timport { getUTMParams } from \"@/lib/analytics/activity-tracker\";\n17\timport {\n18\t  clearActiveBookingId,\n19\t  saveActiveBookingId,\n20\t} from \"@/lib/booking/session-storage\";\n21\timport { useBookingFlowConfig } from \"@/lib/booking/use-flow-config\";\n22\timport { loadRazorpay } from \"@/lib/razorpay/loader\";\n23\timport { addToast } from \"@/lib/redux\";\n24\timport {\n25\t  bookingsApi,\n26\t  useApplyBookingDiscountMutation,\n27\t  useConfirmFreeBookingMutation,\n28\t  useCreateBookingMutation,\n29\t  useGetBookingQuery,\n30\t} from \"@/lib/redux/api/bookingsApi\";\n31\timport { useGetEventByIdQuery } from \"@/lib/redux/api/eventsApi\";\n32\timport { useGetTicketTypesQuery } from \"@/lib/redux/api/ticketsApi\";\n33\timport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\n34\timport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n35\timport { BookingStepper } from \"../BookingStepper\";\n36\t\n37\t// ─── Helpers ──────────────────────────────────────────────────────────────────\n38\t\n39\t// PERF: Hoist formatter outside the component so it isn't re-created on\n40\t// every render or invocation — Intl.NumberFormat construction is expensive.\n41\t// Always show paise (2 dp) so the displayed amount matches what is actually\n42\t// charged — e.g. ₹10.90 must read \"₹10.90\", never get rounded up to \"₹11\".\n43\tconst inrFormatter = new Intl.NumberFormat(\"en-IN\", {\n44\t  style: \"currency\",\n45\t  currency: \"INR\",\n46\t  minimumFractionDigits: 2,\n47\t  maximumFractionDigits: 2,\n48\t});\n49\t\n50\tfunction formatINR(amount: number): string {\n51\t  return inrFormatter.format(amount);\n52\t}\n53\t\n54\tfunction formatEventDate(dateStr: string): string {\n55\t  try {\n56\t    const date = new Date(dateStr);\n57\t    const day = date.getDate();\n58\t    const suffix =\n59\t      day === 1 || day === 21 || day === 31\n60\t        ? \"st\"\n61\t        : day === 2 || day === 22\n62\t          ? \"nd\"\n63\t          : day === 3 || day === 23\n64\t            ? \"rd\"\n65\t            : \"th\";\n66\t    const month = date.toLocaleDateString(\"en-IN\", { month: \"short\" });\n67\t    const weekday = date.toLocaleDateString(\"en-IN\", { weekday: \"short\" });\n68\t    return `${day}${suffix} ${month} · ${weekday}`;\n69\t  } catch {\n70\t    return dateStr;\n71\t  }\n72\t}\n73\t\n74\t// ─── Step Breadcrumb ──────────────────────────────────────────────────────────\n75\t\n76\t// ─── Skeleton ─────────────────────────────────────────────────────────────────\n77\t\n78\tconst ReviewSkeleton = memo(function ReviewSkeleton() {\n79\t  return (\n80\t    <div className=\"flex flex-col gap-4 animate-pulse\" aria-busy=\"true\">\n81\t      <div className=\"h-3 w-48 rounded-full bg-white/[0.08] mx-auto\" />\n82\t      <div className=\"h-24 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n83\t      <div className=\"h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n84\t      <div className=\"h-16 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n85\t      <div className=\"h-11 rounded-3xl bg-white/[0.06] border border-white/[0.08]\" />\n86\t      <div className=\"h-28 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n87\t      <div className=\"h-12 rounded-[40px] bg-white/[0.06]\" />\n88\t    </div>\n89\t  );\n90\t});\n91\t\n92\t// ─── ReviewStep ───────────────────────────────────────────────────────────────\n93\t\n94\texport default function ReviewStep() {\n95\t  const router = useRouter();\n96\t  const dispatch = useAppDispatch();\n97\t  const bookingId = useAppSelector((s) => s.booking.bookingId);\n98\t  const reduxEventId = useAppSelector((s) => s.booking.eventId);\n99\t  const discountInput = useAppSelector((s) => s.booking.discountInput);\n100\t  const user = useAppSelector((s) => s.auth.user);\n101\t\n102\t  // Prefetch the Razorpay script while the user reviews so it is already\n103\t  // loaded by the time they click \"Pay\". Errors are intentionally swallowed —\n104\t  // PaymentStep will retry the load as its own first action.\n105\t  useEffect(() => {\n106\t    loadRazorpay().catch(() => {});\n107\t  }, []);\n108\t\n109\t  const {\n110\t    data: booking,\n111\t    isLoading,\n112\t    refetch,\n113\t  } = useGetBookingQuery(bookingId ?? \"\", {\n114\t    skip: !bookingId,\n115\t  });\n116\t\n117\t  // PERF: Run event query in parallel with booking query when eventId is\n118\t  // already known via Redux (set upstream when the booking flow was opened).\n119\t  // Falls back to the booking response's eventId if Redux is empty (deep-link /\n120\t  // refresh case). Either source is sufficient — we just take the earliest.\n121\t  const resolvedEventId = reduxEventId ?? booking?.event?.eventId ?? \"\";\n122\t  const { data: eventData } = useGetEventByIdQuery(resolvedEventId, {\n123\t    skip: !resolvedEventId,\n124\t  });\n125\t  const event = eventData?.data;\n126\t\n127\t  // AttendeesStep (3) auto-skips itself and bounces straight back to Review\n128\t  // whenever the event doesn't need attendee-level custom fields — so a\n129\t  // hardcoded setStep(3) here would send the user into a step that instantly\n130\t  // forwards them right back, making Back look broken. Route to whatever\n131\t  // step is actually visible immediately before Review instead.\n132\t  const { visibleSteps } = useBookingFlowConfig(resolvedEventId);\n133\t  const reviewIndex = visibleSteps.indexOf(4);\n134\t  const backStep = reviewIndex > 0 ? visibleSteps[reviewIndex - 1] : 3;\n135\t\n136\t  const [applyDiscount, { isLoading: isApplying }] =\n137\t    useApplyBookingDiscountMutation();\n138\t  const [confirmFree] = useConfirmFreeBookingMutation();\n139\t  const [discountError, setDiscountError] = useState<string | null>(null);\n140\t  const [localExpired, setLocalExpired] = useState(false);\n141\t  const [pending, setPending] = useState(false);\n142\t\n143\t  // PERF: refetch identity changes on every render of useGetBookingQuery,\n144\t  // so referencing it directly in a useEffect/useCallback dep array would\n145\t  // re-create handlers (and risk re-firing effects) every render. Stash it\n146\t  // in a ref so handleExpire stays stable for the component lifetime.\n147\t  const refetchRef = useRef(refetch);\n148\t  refetchRef.current = refetch;\n149\t\n150\t  const handleExpire = useCallback(() => {\n151\t    setLocalExpired(true);\n152\t    refetchRef.current();\n153\t  }, []);\n154\t\n155\t  const handleApplyDiscount = useCallback(async () => {\n156\t    if (!bookingId || !discountInput.trim()) return;\n157\t    setDiscountError(null);\n158\t    try {\n159\t      await applyDiscount({\n160\t        id: bookingId,\n161\t        code: discountInput.trim(),\n162\t      }).unwrap();\n163\t    } catch (err: unknown) {\n164\t      setDiscountError(\n165\t        getApiErrorMessage(\n166\t          err,\n167\t          \"Failed to apply discount code. Please try again.\",\n168\t        ),\n169\t      );\n170\t    }\n171\t  }, [bookingId, discountInput, applyDiscount]);\n172\t\n173\t  const handleRemoveDiscount = useCallback(async () => {\n174\t    if (!bookingId) return;\n175\t    setDiscountError(null);\n176\t    try {\n177\t      await applyDiscount({ id: bookingId, code: null }).unwrap();\n178\t      dispatch(bookingActions.setDiscountInput(\"\"));\n179\t    } catch (err: unknown) {\n180\t      setDiscountError(getApiErrorMessage(err, \"Failed to remove discount.\"));\n181\t    }\n182\t  }, [bookingId, applyDiscount, dispatch]);\n183\t\n184\t  // PERF: Memoize line-item aggregation. The only input is booking.tickets —\n185\t  // re-computing on every render (countdown tick, discount input keystroke)\n186\t  // is wasted work when the ticket list hasn't changed.\n187\t  const lineItems = useMemo(() => {\n188\t    if (!booking?.tickets) return [];\n189\t    const map = new Map<\n190\t      string,\n191\t      {\n192\t        name: string;\n193\t        totalPriceSum: number;\n194\t        faceValueSum: number;\n195\t        qty: number;\n196\t        ticketTypeId: string | null;\n197\t      }\n198\t    >();\n199\t    for (const ticket of booking.tickets) {\n200\t      // RSVP ticket — no ticket type, quantity is implicitly fixed at 1\n201\t      if (!ticket.ticketType) {\n202\t        const key = \"__rsvp__\";\n203\t        const existing = map.get(key);\n204\t        const qty = ticket.quantity ?? 1;\n205\t        if (existing) existing.qty += qty;\n206\t        else\n207\t          map.set(key, {\n208\t            name: \"Free Entry\",\n209\t            totalPriceSum: 0,\n210\t            faceValueSum: 0,\n211\t            qty,\n212\t            ticketTypeId: null,\n213\t          });\n214\t        continue;\n215\t      }\n216\t      const id = ticket.ticketType.ticketTypeId;\n217\t      const existing = map.get(id);\n218\t      const qty = ticket.quantity ?? 1;\n219\t      // Prefer the amount actually charged/recorded on this Ticket row —\n220\t      // for a bundle purchase this legitimately differs from the ticket\n221\t      // type's own standalone price/discountedPrice. Summed per ticket\n222\t      // type then averaged below so itemized rows always add up to the\n223\t      // booking's real subtotal, even when a ticket type's rows span an\n224\t      // early-bird boundary or a bundle split (each a separate row with\n225\t      // its own totalPrice/faceValue).\n226\t      const rowTotalPrice = ticket.totalPrice;\n227\t      const rowFaceValue = ticket.faceValue;\n228\t      if (existing) {\n229\t        existing.qty += qty;\n230\t        existing.totalPriceSum += rowTotalPrice;\n231\t        existing.faceValueSum += rowFaceValue;\n232\t      } else {\n233\t        map.set(id, {\n234\t          name: ticket.ticketType.name,\n235\t          totalPriceSum: rowTotalPrice,\n236\t          faceValueSum: rowFaceValue,\n237\t          qty,\n238\t          ticketTypeId: id,\n239\t        });\n240\t      }\n241\t    }\n242\t    return Array.from(map.values()).map((v) => ({\n243\t      name: v.name,\n244\t      ticketTypeId: v.ticketTypeId,\n245\t      qty: v.qty,\n246\t      unitPrice: Math.round((v.totalPriceSum / v.qty) * 100) / 100,\n247\t      originalPrice: Math.round((v.faceValueSum / v.qty) * 100) / 100,\n248\t    }));\n249\t  }, [booking?.tickets]);\n250\t\n251\t  // ── Inline quantity editing ──────────────────────────────────────────────\n252\t  // Re-issues the HELD booking with an updated line quantity instead of\n253\t  // kicking the buyer back to SelectStep. Only safe to do inline when the\n254\t  // changed ticket type has no per-attendee custom fields to (re-)collect on\n255\t  // increment — decrementing never needs new data, it just drops the\n256\t  // trailing seat's (already-empty) field-response slot. Team tickets always\n257\t  // fall back to SelectStep since \"quantity\" isn't a meaningful concept for\n258\t  // them (they use the team radio-select + team-setup flow instead).\n259\t  const maxQty = 20;\n260\t  const [updatingTicketTypeId, setUpdatingTicketTypeId] = useState<\n261\t    string | null\n262\t  >(null);\n263\t  const lines = useAppSelector((s) => s.booking.lines);\n264\t  const commonFieldResponses = useAppSelector(\n265\t    (s) => s.booking.commonFieldResponses,\n266\t  );\n267\t  const { city: userCity, state: userState } = useUserLocation();\n268\t  const [createBooking] = useCreateBookingMutation();\n269\t  const { data: ticketTypesData } = useGetTicketTypesQuery(resolvedEventId, {\n270\t    skip: !resolvedEventId,\n271\t  });\n272\t  const ticketTypesById = new Map(\n273\t    (ticketTypesData?.data ?? []).map((tt) => [tt.ticketTypeId, tt]),\n274\t  );\n275\t\n276\t  const reissueQuantity = useCallback(\n277\t    async (ticketTypeId: string, newQuantity: number) => {\n278\t      const newLines = lines.map((l) =>\n279\t        l.ticketTypeId === ticketTypeId\n280\t          ? {\n281\t              ...l,\n282\t              quantity: newQuantity,\n283\t              ticketFieldResponses: Array.from(\n284\t                { length: newQuantity },\n285\t                (_, i) => l.ticketFieldResponses[i] ?? [],\n286\t              ),\n287\t            }\n288\t          : l,\n289\t      );\n290\t      const utmSource =\n291\t        typeof window !== \"undefined\"\n292\t          ? (new URLSearchParams(window.location.search).get(\"utm_source\") ??\n293\t            getUTMParams().utmSource ??\n294\t            undefined)\n295\t          : undefined;\n296\t      setUpdatingTicketTypeId(ticketTypeId);\n297\t      try {\n298\t        const newBooking = await createBooking(\n299\t          buildCreateBookingRequest({\n300\t            eventId: resolvedEventId,\n301\t            lines: newLines,\n302\t            commonFieldResponses,\n303\t            referrer: utmSource,\n304\t            city: userCity ?? undefined,\n305\t            state: userState ?? undefined,\n306\t            // Atomically releases the current HELD booking server-side in the\n307\t            // same transaction that creates the new one — never two\n308\t            // concurrent active holds, and never a lost hold if this fails.\n309\t            supersedesBookingId: bookingId ?? undefined,\n310\t          }),\n311\t        ).unwrap();\n312\t        dispatch(\n313\t          bookingsApi.util.upsertQueryData(\n314\t            \"getBooking\",\n315\t            newBooking.bookingId,\n316\t            newBooking,\n317\t          ),\n318\t        );\n319\t        dispatch(\n320\t          bookingActions.setQuantity({ ticketTypeId, quantity: newQuantity }),\n321\t        );\n322\t        dispatch(bookingActions.setBookingId(newBooking.bookingId));\n323\t        saveActiveBookingId(newBooking.bookingId);\n324\t      } catch (err: unknown) {\n325\t        const error = err as { data?: { message?: string } };\n326\t        const serverMsg = error?.data?.message;\n327\t        if (\n328\t          typeof serverMsg === \"string\" &&\n329\t          serverMsg.startsWith(\"SUPERSEDE_TARGET_NOT_HELD\")\n330\t        ) {\n331\t          // Our known bookingId is no longer supersedable (expired / paid /\n332\t          // cancelled elsewhere) — resync from the server instead of\n333\t          // silently retrying, which could otherwise open an unrelated\n334\t          // extra hold.\n335\t          dispatch(\n336\t            addToast({\n337\t              message:\n338\t                \"Your hold expired or changed elsewhere. Refreshing booking status.\",\n339\t              variant: \"warning\",\n340\t            }),\n341\t          );\n342\t          refetch();\n343\t        } else {\n344\t          dispatch(\n345\t            addToast({\n346\t              message:\n347\t                serverMsg ?? \"Could not update ticket count. Please try again.\",\n348\t              variant: \"error\",\n349\t            }),\n350\t          );\n351\t        }\n352\t      } finally {\n353\t        setUpdatingTicketTypeId(null);\n354\t      }\n355\t    },\n356\t    [\n357\t      lines,\n358\t      commonFieldResponses,\n359\t      resolvedEventId,\n360\t      userCity,\n361\t      userState,\n362\t      refetch,\n363\t      bookingId,\n364\t      createBooking,\n365\t      dispatch,\n366\t    ],\n367\t  );\n368\t\n369\t  const handleDecrementLine = useCallback(\n370\t    (ticketTypeId: string | null) => {\n371\t      if (!ticketTypeId || updatingTicketTypeId) return;\n372\t      const currentQty =\n373\t        lines.find((l) => l.ticketTypeId === ticketTypeId)?.quantity ?? 0;\n374\t      if (currentQty <= 1) return;\n375\t      reissueQuantity(ticketTypeId, currentQty - 1);\n376\t    },\n377\t    [lines, updatingTicketTypeId, reissueQuantity],\n378\t  );\n379\t\n380\t  const handleIncrementLine = useCallback(\n381\t    (ticketTypeId: string | null) => {\n382\t      if (!ticketTypeId || updatingTicketTypeId) return;\n383\t      const currentQty =\n384\t        lines.find((l) => l.ticketTypeId === ticketTypeId)?.quantity ?? 0;\n385\t      if (currentQty >= maxQty) {\n386\t        dispatch(\n387\t          addToast({\n388\t            message: `Maximum ${maxQty} tickets per order`,\n389\t            variant: \"warning\",\n390\t          }),\n391\t        );\n392\t        return;\n393\t      }\n394\t      const tt = ticketTypesById.get(ticketTypeId);\n395\t      const needsReselect =\n396\t        !tt || tt.minTeamSize != null || (tt._count?.CustomField ?? 0) > 0;\n397\t      if (needsReselect) {\n398\t        dispatch(bookingActions.setStep(2));\n399\t        return;\n400\t      }\n401\t      reissueQuantity(ticketTypeId, currentQty + 1);\n402\t    },\n403\t    [lines, updatingTicketTypeId, ticketTypesById, reissueQuantity, dispatch],\n404\t  );\n405\t\n406\t  if (isLoading) return <ReviewSkeleton />;\n407\t  if (!booking) return null;\n408\t\n409\t  const isExpired = booking.status === \"EXPIRED\" || localExpired;\n410\t\n411\t  if (isExpired) {\n412\t    return (\n413\t      <div className=\"flex flex-col gap-4\">\n414\t        <div className=\"rounded-xl bg-red-500/10 border border-red-500/30 px-4 py-6 flex flex-col items-center gap-4 text-center\">\n415\t          <svg\n416\t            className=\"size-12 text-red-400\"\n417\t            viewBox=\"0 0 48 48\"\n418\t            fill=\"none\"\n419\t            aria-hidden=\"true\"\n420\t          >\n421\t            <circle\n422\t              cx=\"24\"\n423\t              cy=\"24\"\n424\t              r=\"20\"\n425\t              stroke=\"currentColor\"\n426\t              strokeWidth=\"2.5\"\n427\t            />\n428\t            <path\n429\t              d=\"M24 14v10l6 6\"\n430\t              stroke=\"currentColor\"\n431\t              strokeWidth=\"2.5\"\n432\t              strokeLinecap=\"round\"\n433\t              strokeLinejoin=\"round\"\n434\t            />\n435\t          </svg>\n436\t          <div>\n437\t            <h3 className=\"text-h4 font-semibold text-white tracking-[-0.02em]\">\n438\t              Your hold has expired\n439\t            </h3>\n440\t            <p className=\"text-p2 text-white/64 mt-1\">\n441\t              The tickets were released. Please start over to try again.\n442\t            </p>\n443\t          </div>\n444\t          <button\n445\t            type=\"button\"\n446\t            onClick={() => {\n447\t              clearActiveBookingId();\n448\t              dispatch(bookingActions.reset());\n449\t              dispatch(bookingActions.setStep(2));\n450\t            }}\n451\t            className=\"h-12 px-6 rounded-[40px] bg-white text-black text-h4 font-semibold tracking-[-0.02em] active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out\"\n452\t          >\n453\t            Start over\n454\t          </button>\n455\t        </div>\n456\t      </div>\n457\t    );\n458\t  }\n459\t\n460\t  // lineItems is already memoized above\n461\t  const holdActive = booking.holdExpiresAt && !isExpired;\n462\t  const thumbnail =\n463\t    event?.bannerSquare ??\n464\t    event?.banner_square ??\n465\t    event?.thumbnail ??\n466\t    event?.bannerHorizontal ??\n467\t    event?.banner_horizontal ??\n468\t    null;\n469\t\n470\t  return (\n471\t    <div className=\"flex flex-col gap-4\">\n472\t      {/* Step breadcrumb */}\n473\t      <BookingStepper\n474\t        currentStep=\"review\"\n475\t        onBack={() => dispatch(bookingActions.setStep(backStep))}\n476\t      />\n477\t\n478\t      {/* ── Event info ─────────────────────────────────────────────────────── */}\n479\t      <div className=\"flex items-start gap-3\">\n480\t        {/* Square thumbnail */}\n481\t        {thumbnail ? (\n482\t          <Image\n483\t            src={thumbnail}\n484\t            alt={booking.event.title}\n485\t            width={112}\n486\t            height={112}\n487\t            className=\"w-[112px] h-[112px] rounded-2xl object-cover shrink-0\"\n488\t          />\n489\t        ) : (\n490\t          <div className=\"w-[112px] h-[112px] rounded-2xl bg-white/[0.08] shrink-0 flex items-center justify-center\">\n491\t            <svg\n492\t              className=\"size-6 text-white/24\"\n493\t              viewBox=\"0 0 24 24\"\n494\t              fill=\"none\"\n495\t              aria-hidden=\"true\"\n496\t            >\n497\t              <rect\n498\t                x=\"3\"\n499\t                y=\"5\"\n500\t                width=\"18\"\n501\t                height=\"14\"\n502\t                rx=\"2\"\n503\t                stroke=\"currentColor\"\n504\t                strokeWidth=\"1.5\"\n505\t              />\n506\t              <path d=\"M3 10h18\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n507\t            </svg>\n508\t          </div>\n509\t        )}\n510\t\n511\t        {/* Info column */}\n512\t        <div className=\"flex flex-col gap-2 min-w-0 flex-1 pt-0.5\">\n513\t          {/* Title row with optional hold timer */}\n514\t          <div className=\"flex items-start justify-between gap-2\">\n515\t            <p className=\"text-h3 font-semibold text-white tracking-[-0.04em] leading-[1.1] min-w-0 flex-1\">\n516\t              {booking.event.title}\n517\t            </p>\n518\t            {holdActive && (\n519\t              <HoldCountdown\n520\t                expiresAt={booking.holdExpiresAt}\n521\t                onExpire={handleExpire}\n522\t                className=\"shrink-0 mt-0.5\"\n523\t              />\n524\t            )}\n525\t          </div>\n526\t\n527\t          {/* Date */}\n528\t          <div className=\"flex items-center gap-1\">\n529\t            <PiClockDefaultStroke\n530\t              className=\"size-3 shrink-0\"\n531\t              style={{ color: \"rgba(255,255,255,0.64)\" }}\n532\t            />\n533\t            <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em]\">\n534\t              {formatEventDate(booking.event.date)}\n535\t            </p>\n536\t          </div>\n537\t\n538\t          {/* Location */}\n539\t          {booking.event.location && (\n540\t            <div className=\"flex items-center gap-1\">\n541\t              <PiMapPinStroke\n542\t                className=\"size-3 shrink-0\"\n543\t                style={{ color: \"rgba(255,255,255,0.64)\" }}\n544\t              />\n545\t              <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em] truncate\">\n546\t                {booking.event.location}\n547\t              </p>\n548\t            </div>\n549\t          )}\n550\t\n551\t          {/* Lister with avatar */}\n552\t          {event?.lister && (\n553\t            <div className=\"flex items-center gap-1.5\">\n554\t              <Avatar\n555\t                src={event.lister.companyLogo || event.lister.avatar}\n556\t                name={event.lister.companyName}\n557\t                size={20}\n558\t                textClassName=\"text-[9px] font-semibold text-white leading-none\"\n559\t              />\n560\t              <p className=\"text-p2 font-semibold text-white/84 tracking-[-0.02em] truncate\">\n561\t                {event.lister.companyName}\n562\t              </p>\n563\t            </div>\n564\t          )}\n565\t        </div>\n566\t      </div>\n567\t\n568\t      {/* ── Ticket rows ────────────────────────────────────────────────────── */}\n569\t      <div className=\"flex flex-col gap-2\">\n570\t        {lineItems.map((item) => {\n571\t          const isDiscounted = item.unitPrice < item.originalPrice;\n572\t          const discountReason = item.ticketTypeId\n573\t            ? ticketTypesById.get(item.ticketTypeId)?.discountReason\n574\t            : null;\n575\t          return (\n576\t            <div\n577\t              key={item.name}\n578\t              className=\"flex items-center justify-between bg-white/[0.08] rounded-2xl pl-3 pr-2 py-2\"\n579\t            >\n580\t              {/* Left: name + price */}\n581\t              <div className=\"flex flex-col gap-1 min-w-0 flex-1\">\n582\t                <p className=\"text-h4 font-medium text-white tracking-[-0.02em] leading-[1.1] truncate\">\n583\t                  {item.name}\n584\t                </p>\n585\t                <div className=\"flex items-center gap-2\">\n586\t                  <span\n587\t                    className={`text-h5 font-semibold tracking-[-0.02em] leading-[1.1] ${isDiscounted ? \"text-[#a4e2b4]\" : \"text-white/64\"}`}\n588\t                  >\n589\t                    {item.unitPrice === 0 ? \"FREE\" : formatINR(item.unitPrice)}\n590\t                  </span>\n591\t                  {isDiscounted && item.originalPrice > 0 && (\n592\t                    <span className=\"text-h6 font-semibold text-white/52 line-through tracking-[-0.02em]\">\n593\t                      {formatINR(item.originalPrice)}\n594\t                    </span>\n595\t                  )}\n596\t                </div>\n597\t                {isDiscounted && discountReason && (\n598\t                  <p className=\"text-p4 text-white/40 tracking-[-0.02em] truncate\">\n599\t                    {discountReason}\n600\t                  </p>\n601\t                )}\n602\t              </div>\n603\t\n604\t              {/* Right: qty stepper */}\n605\t              <div className=\"bg-white/[0.08] rounded-xl px-3 py-1 flex items-center gap-2 shrink-0\">\n606\t                <button\n607\t                  type=\"button\"\n608\t                  onClick={() => handleDecrementLine(item.ticketTypeId)}\n609\t                  disabled={\n610\t                    !item.ticketTypeId ||\n611\t                    item.qty <= 1 ||\n612\t                    Boolean(updatingTicketTypeId)\n613\t                  }\n614\t                  aria-label=\"Decrease tickets\"\n615\t                  className=\"text-h4 font-semibold text-white w-4 flex items-center justify-center active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out disabled:opacity-30 disabled:cursor-not-allowed\"\n616\t                >\n617\t                  −\n618\t                </button>\n619\t                <div className=\"bg-white/[0.2] rounded-lg px-3 py-2 min-w-[38px] flex items-center justify-center\">\n620\t                  {updatingTicketTypeId === item.ticketTypeId ? (\n621\t                    <span\n622\t                      className=\"inline-block size-3 rounded-full border-2 border-white/30 border-t-white animate-spin\"\n623\t                      role=\"status\"\n624\t                      aria-label=\"Updating quantity\"\n625\t                    />\n626\t                  ) : (\n627\t                    <span className=\"text-h6 font-semibold text-white tabular-nums\">\n628\t                      {String(item.qty).padStart(2, \"0\")}\n629\t                    </span>\n630\t                  )}\n631\t                </div>\n632\t                <button\n633\t                  type=\"button\"\n634\t                  onClick={() => handleIncrementLine(item.ticketTypeId)}\n635\t                  disabled={!item.ticketTypeId || Boolean(updatingTicketTypeId)}\n636\t                  aria-label=\"Increase tickets\"\n637\t                  className=\"text-h4 font-semibold text-white w-4 flex items-center justify-center active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out disabled:opacity-30 disabled:cursor-not-allowed\"\n638\t                >\n639\t                  +\n640\t                </button>\n641\t              </div>\n642\t            </div>\n643\t          );\n644\t        })}\n645\t\n646\t        {/* Add Tickets */}\n647\t        <button\n648\t          type=\"button\"\n649\t          onClick={() => dispatch(bookingActions.setStep(2))}\n650\t          className=\"\n651\t            w-full flex items-center justify-center gap-2\n652\t            min-h-11 p-4 rounded-3xl\n653\t            border border-white/[0.16]\n654\t            text-h5 font-medium text-white/84 tracking-[-0.02em]\n655\t            transition-[opacity,transform] duration-200 ease-out\n656\t            active:opacity-70 active:scale-[0.97]\n657\t            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n658\t          \"\n659\t        >\n660\t          <PiPlusDefaultStroke className=\"size-3\" />\n661\t          Add Tickets\n662\t        </button>\n663\t      </div>\n664\t\n665\t      {/* ── User profile card ───────────────────────────────────────────────── */}\n666\t      <div className=\"flex items-center gap-3 bg-white/[0.08] rounded-2xl p-3\">\n667\t        <Avatar\n668\t          src={user?.avatar}\n669\t          name={user?.name}\n670\t          size={44}\n671\t          border=\"1px solid rgba(255,255,255,0.16)\"\n672\t          textClassName=\"text-h5 font-semibold text-white\"\n673\t        />\n674\t\n675\t        <div className=\"flex flex-col gap-1 min-w-0 flex-1\">\n676\t          {user?.name && (\n677\t            <p className=\"text-h5 font-medium text-white tracking-[-0.02em] leading-[1.1] truncate\">\n678\t              {user.name}\n679\t            </p>\n680\t          )}\n681\t          {user?.phone && (\n682\t            <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em] truncate\">\n683\t              {user.phone}\n684\t            </p>\n685\t          )}\n686\t          {user?.email && (\n687\t            <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em] truncate\">\n688\t              {user.email}\n689\t            </p>\n690\t          )}\n691\t        </div>\n692\t\n693\t        <button\n694\t          type=\"button\"\n695\t          onClick={() => dispatch(bookingActions.setStep(3))}\n696\t          aria-label=\"Edit details\"\n697\t          className=\"\n698\t            size-8 rounded-lg shrink-0\n699\t            bg-white/[0.12] border border-white/[0.12]\n700\t            flex items-center justify-center\n701\t            active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out\n702\t            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n703\t          \"\n704\t        >\n705\t          <PiPencilEditStroke\n706\t            className=\"size-3\"\n707\t            style={{ color: \"rgba(255,255,255,0.64)\" }}\n708\t          />\n709\t        </button>\n710\t      </div>\n711\t\n712\t      {/* ── Coupon code ─────────────────────────────────────────────────────── */}\n713\t      <div>\n714\t        {booking.discountCode ? (\n715\t          <div className=\"flex flex-col gap-1 border border-white/[0.2] rounded-2xl px-4 py-3\">\n716\t            <div className=\"flex items-center justify-between gap-3\">\n717\t              <div className=\"flex items-center gap-2\">\n718\t                <svg\n719\t                  className=\"size-4 text-green-400 shrink-0\"\n720\t                  viewBox=\"0 0 16 16\"\n721\t                  fill=\"none\"\n722\t                  aria-hidden=\"true\"\n723\t                >\n724\t                  <path\n725\t                    d=\"M9.5 2H14v4.5l-6 6a1.414 1.414 0 01-2 0L2 8.5a1.414 1.414 0 010-2l6-4.5z\"\n726\t                    stroke=\"currentColor\"\n727\t                    strokeWidth=\"1.4\"\n728\t                    strokeLinejoin=\"round\"\n729\t                  />\n730\t                  <circle cx=\"11.5\" cy=\"4.5\" r=\"0.75\" fill=\"currentColor\" />\n731\t                </svg>\n732\t                <span className=\"text-h5 font-semibold text-green-400 tracking-wider uppercase\">\n733\t                  {booking.discountCode.code}\n734\t                </span>\n735\t              </div>\n736\t              <button\n737\t                type=\"button\"\n738\t                onClick={handleRemoveDiscount}\n739\t                disabled={isApplying}\n740\t                className=\"text-h6 font-medium text-white/64 min-h-[36px] px-2 active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out disabled:opacity-40\"\n741\t              >\n742\t                Remove\n743\t              </button>\n744\t            </div>\n745\t            {booking.discountCode.description && (\n746\t              <p className=\"text-p3 text-white/52 tracking-[-0.02em] pl-6\">\n747\t                {booking.discountCode.description}\n748\t              </p>\n749\t            )}\n750\t          </div>\n751\t        ) : (\n752\t          <div className=\"flex items-center border border-white/[0.2] rounded-xl h-11 overflow-hidden\">\n753\t            <input\n754\t              type=\"text\"\n755\t              value={discountInput}\n756\t              onChange={(e) =>\n757\t                dispatch(bookingActions.setDiscountInput(e.target.value))\n758\t              }\n759\t              placeholder=\"Coupon Code\"\n760\t              aria-label=\"Discount code\"\n761\t              className=\"\n762\t                flex-1 h-full bg-transparent px-3\n763\t                text-h5 font-medium text-white placeholder:text-white/64\n764\t                focus:outline-none\n765\t              \"\n766\t              onKeyDown={(e) => {\n767\t                if (e.key === \"Enter\") handleApplyDiscount();\n768\t              }}\n769\t            />\n770\t            <button\n771\t              type=\"button\"\n772\t              onClick={handleApplyDiscount}\n773\t              disabled={isApplying || !discountInput.trim()}\n774\t              className=\"\n775\t                h-[35px] px-4 mx-1 shrink-0\n776\t                bg-white/[0.16] rounded-lg\n777\t                text-h6 font-semibold text-white/56\n778\t                disabled:opacity-40 disabled:cursor-not-allowed\n779\t                active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out\n780\t                focus-visible:outline-none\n781\t              \"\n782\t            >\n783\t              {isApplying ? \"…\" : \"Apply\"}\n784\t            </button>\n785\t          </div>\n786\t        )}\n787\t\n788\t        {discountError && (\n789\t          <p className=\"text-p3 text-red-400 mt-2 px-1\">{discountError}</p>\n790\t        )}\n791\t      </div>\n792\t\n793\t      {/* ── Price breakdown — shared with the venue booking funnel. The\n794\t          component handles Subtotal / Discount / combined Platform fee\n795\t          (with tooltip) / GST (USER only) / Total. */}\n796\t      <BookingSummary\n797\t        subtotal={booking.subtotal}\n798\t        subtotalLabel=\"Tickets\"\n799\t        discountAmount={booking.discountAmount}\n800\t        platformFee={booking.platformFee}\n801\t        gatewayFee={booking.gatewayFee}\n802\t        gst={booking.gst}\n803\t        feeBornBy={booking.feesBornBy}\n804\t        total={booking.total}\n805\t        bare\n806\t      />\n807\t\n808\t      {/* ── Pay / Confirm CTA ───────────────────────────────────────────────── */}\n809\t      <button\n810\t        type=\"button\"\n811\t        disabled={isExpired || isApplying || pending}\n812\t        onClick={async () => {\n813\t          if (!bookingId) return;\n814\t          setPending(true);\n815\t          try {\n816\t            if (booking.total === 0) {\n817\t              // Free booking — confirm directly, no payment service involved\n818\t              await confirmFree(bookingId).unwrap();\n819\t              clearActiveBookingId();\n820\t              dispatch(bookingActions.reset());\n821\t              router.push(`/booking/success?ticketId=${bookingId}`);\n822\t            } else {\n823\t              dispatch(bookingActions.setStep(5));\n824\t            }\n825\t          } catch {\n826\t            dispatch(\n827\t              addToast({\n828\t                message: \"Could not confirm booking. Please try again.\",\n829\t                variant: \"error\",\n830\t              }),\n831\t            );\n832\t          } finally {\n833\t            setPending(false);\n834\t          }\n835\t        }}\n836\t        className=\"\n837\t          w-full h-12 rounded-[40px]\n838\t          bg-white border border-[rgba(255,255,255,0.04)]\n839\t          flex items-center justify-center gap-3\n840\t          disabled:opacity-60 disabled:cursor-not-allowed\n841\t          transition-[opacity,transform] duration-100 ease-out\n842\t          active:opacity-70 active:scale-[0.97]\n843\t          focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n844\t        \"\n845\t      >\n846\t        {pending ? (\n847\t          <span className=\"inline-block size-4 rounded-full border-2 border-black/30 border-t-black animate-spin\" />\n848\t        ) : booking.total === 0 ? (\n849\t          <>\n850\t            <span className=\"text-h4 font-semibold text-black tracking-[-0.02em]\">\n851\t              Confirm for Free\n852\t            </span>\n853\t            <PiArrowRightStroke\n854\t              size={16}\n855\t              style={{ color: \"#000000\" }}\n856\t              aria-hidden=\"true\"\n857\t            />\n858\t          </>\n859\t        ) : (\n860\t          <>\n861\t            <span className=\"text-h4 font-semibold text-black tracking-[-0.02em]\">\n862\t              Pay {formatINR(booking.total)}\n863\t            </span>\n864\t            <PiArrowRightStroke\n865\t              size={16}\n866\t              style={{ color: \"#000000\" }}\n867\t              aria-hidden=\"true\"\n868\t            />\n869\t          </>\n870\t        )}\n871\t      </button>\n872\t    </div>\n873\t  );\n874\t}\n875\t"}]},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"b285dc3b-5f47-4dad-99c0-1777ac11d4bc","timestamp":"2026-11-20T17:35:08.458Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-vxwz51zo/tunyt/apps/web/src/components/booking/steps/ReviewStep.tsx","content":"\"use client\";\n\nimport PiArrowRightStroke from \"@icons/stroke/arrows-&-chevrons/PiArrowRightStroke\";\nimport PiPencilEditStroke from \"@icons/stroke/general/PiPencilEditStroke\";\nimport PiPlusDefaultStroke from \"@icons/stroke/maths/PiPlusDefaultStroke\";\nimport PiMapPinStroke from \"@icons/stroke/navigation/PiMapPinStroke\";\nimport PiClockDefaultStroke from \"@icons/stroke/time/PiClockDefaultStroke\";\nimport { buildCreateBookingRequest, getApiErrorMessage } from \"@tunyt/shared\";\nimport Image from \"next/image\";\nimport { useRouter } from \"next/navigation\";\nimport { memo, useCallback, useEffect, useMemo, useRef, useState } from \"react\";\nimport BookingSummary from \"@/components/booking/BookingSummary\";\nimport HoldCountdown from \"@/components/booking/HoldCountdown\";\nimport { Avatar } from \"@/components/ui/Avatar\";\nimport { useUserLocation } from \"@/hooks/useUserLocation\";\nimport { getUTMParams } from \"@/lib/analytics/activity-tracker\";\nimport {\n  clearActiveBookingId,\n  saveActiveBookingId,\n} from \"@/lib/booking/session-storage\";\nimport { useBookingFlowConfig } from \"@/lib/booking/use-flow-config\";\nimport { loadRazorpay } from \"@/lib/razorpay/loader\";\nimport { addToast } from \"@/lib/redux\";\nimport {\n  bookingsApi,\n  useApplyBookingDiscountMutation,\n  useConfirmFreeBookingMutation,\n  useCreateBookingMutation,\n  useGetBookingQuery,\n} from \"@/lib/redux/api/bookingsApi\";\nimport { useGetEventByIdQuery } from \"@/lib/redux/api/eventsApi\";\nimport { useGetTicketTypesQuery } from \"@/lib/redux/api/ticketsApi\";\nimport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\nimport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\nimport { BookingStepper } from \"../BookingStepper\";\n\n// ─── Helpers ──────────────────────────────────────────────────────────────────\n\n// PERF: Hoist formatter outside the component so it isn't re-created on\n// every render or invocation — Intl.NumberFormat construction is expensive.\n// Always show paise (2 dp) so the displayed amount matches what is actually\n// charged — e.g. ₹10.90 must read \"₹10.90\", never get rounded up to \"₹11\".\nconst inrFormatter = new Intl.NumberFormat(\"en-IN\", {\n  style: \"currency\",\n  currency: \"INR\",\n  minimumFractionDigits: 2,\n  maximumFractionDigits: 2,\n});\n\nfunction formatINR(amount: number): string {\n  return inrFormatter.format(amount);\n}\n\nfunction formatEventDate(dateStr: string): string {\n  try {\n    const date = new Date(dateStr);\n    const day = date.getDate();\n    const suffix =\n      day === 1 || day === 21 || day === 31\n        ? \"st\"\n        : day === 2 || day === 22\n          ? \"nd\"\n          : day === 3 || day === 23\n            ? \"rd\"\n            : \"th\";\n    const month = date.toLocaleDateString(\"en-IN\", { month: \"short\" });\n    const weekday = date.toLocaleDateString(\"en-IN\", { weekday: \"short\" });\n    return `${day}${suffix} ${month} · ${weekday}`;\n  } catch {\n    return dateStr;\n  }\n}\n\n// ─── Step Breadcrumb ──────────────────────────────────────────────────────────\n\n// ─── Skeleton ─────────────────────────────────────────────────────────────────\n\nconst ReviewSkeleton = memo(function ReviewSkeleton() {\n  return (\n    <div className=\"flex flex-col gap-4 animate-pulse\" aria-busy=\"true\">\n      <div className=\"h-3 w-48 rounded-full bg-white/[0.08] mx-auto\" />\n      <div className=\"h-24 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n      <div className=\"h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n      <div className=\"h-16 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n      <div className=\"h-11 rounded-3xl bg-white/[0.06] border border-white/[0.08]\" />\n      <div className=\"h-28 rounded-2xl bg-white/[0.06] border border-white/[0.08]\" />\n      <div className=\"h-12 rounded-[40px] bg-white/[0.06]\" />\n    </div>\n  );\n});\n\n// ─── ReviewStep ───────────────────────────────────────────────────────────────\n\nexport default function ReviewStep() {\n  const router = useRouter();\n  const dispatch = useAppDispatch();\n  const bookingId = useAppSelector((s) => s.booking.bookingId);\n  const reduxEventId = useAppSelector((s) => s.booking.eventId);\n  const discountInput = useAppSelector((s) => s.booking.discountInput);\n  const user = useAppSelector((s) => s.auth.user);\n\n  // Prefetch the Razorpay script while the user reviews so it is already\n  // loaded by the time they click \"Pay\". Errors are intentionally swallowed —\n  // PaymentStep will retry the load as its own first action.\n  useEffect(() => {\n    loadRazorpay().catch(() => {});\n  }, []);\n\n  const {\n    data: booking,\n    isLoading,\n    refetch,\n  } = useGetBookingQuery(bookingId ?? \"\", {\n    skip: !bookingId,\n  });\n\n  // PERF: Run event query in parallel with booking query when eventId is\n  // already known via Redux (set upstream when the booking flow was opened).\n  // Falls back to the booking response's eventId if Redux is empty (deep-link /\n  // refresh case). Either source is sufficient — we just take the earliest.\n  const resolvedEventId = reduxEventId ?? booking?.event?.eventId ?? \"\";\n  const { data: eventData } = useGetEventByIdQuery(resolvedEventId, {\n    skip: !resolvedEventId,\n  });\n  const event = eventData?.data;\n\n  // AttendeesStep (3) auto-skips itself and bounces straight back to Review\n  // whenever the event doesn't need attendee-level custom fields — so a\n  // hardcoded setStep(3) here would send the user into a step that instantly\n  // forwards them right back, making Back look broken. Route to whatever\n  // step is actually visible immediately before Review instead.\n  const { visibleSteps } = useBookingFlowConfig(resolvedEventId);\n  const reviewIndex = visibleSteps.indexOf(4);\n  const backStep = reviewIndex > 0 ? visibleSteps[reviewIndex - 1] : 3;\n\n  const [applyDiscount, { isLoading: isApplying }] =\n    useApplyBookingDiscountMutation();\n  const [confirmFree] = useConfirmFreeBookingMutation();\n  const [discountError, setDiscountError] = useState<string | null>(null);\n  const [localExpired, setLocalExpired] = useState(false);\n  const [pending, setPending] = useState(false);\n\n  // PERF: refetch identity changes on every render of useGetBookingQuery,\n  // so referencing it directly in a useEffect/useCallback dep array would\n  // re-create handlers (and risk re-firing effects) every render. Stash it\n  // in a ref so handleExpire stays stable for the component lifetime.\n  const refetchRef = useRef(refetch);\n  refetchRef.current = refetch;\n\n  const handleExpire = useCallback(() => {\n    setLocalExpired(true);\n    refetchRef.current();\n  }, []);\n\n  const handleApplyDiscount = useCallback(async () => {\n    if (!bookingId || !discountInput.trim()) return;\n    setDiscountError(null);\n    try {\n      await applyDiscount({\n        id: bookingId,\n        code: discountInput.trim(),\n      }).unwrap();\n    } catch (err: unknown) {\n      setDiscountError(\n        getApiErrorMessage(\n          err,\n          \"Failed to apply discount code. Please try again.\",\n        ),\n      );\n    }\n  }, [bookingId, discountInput, applyDiscount]);\n\n  const handleRemoveDiscount = useCallback(async () => {\n    if (!bookingId) return;\n    setDiscountError(null);\n    try {\n      await applyDiscount({ id: bookingId, code: null }).unwrap();\n      dispatch(bookingActions.setDiscountInput(\"\"));\n    } catch (err: unknown) {\n      setDiscountError(getApiErrorMessage(err, \"Failed to remove discount.\"));\n    }\n  }, [bookingId, applyDiscount, dispatch]);\n\n  // PERF: Memoize line-item aggregation. The only input is booking.tickets —\n  // re-computing on every render (countdown tick, discount input keystroke)\n  // is wasted work when the ticket list hasn't changed.\n  const lineItems = useMemo(() => {\n    if (!booking?.tickets) return [];\n    const map = new Map<\n      string,\n      {\n        name: string;\n        totalPriceSum: number;\n        faceValueSum: number;\n        qty: number;\n        ticketTypeId: string | null;\n      }\n    >();\n    for (const ticket of booking.tickets) {\n      // RSVP ticket — no ticket type, quantity is implicitly fixed at 1\n      if (!ticket.ticketType) {\n        const key = \"__rsvp__\";\n        const existing = map.get(key);\n        const qty = ticket.quantity ?? 1;\n        if (existing) existing.qty += qty;\n        else\n          map.set(key, {\n            name: \"Free Entry\",\n            totalPriceSum: 0,\n            faceValueSum: 0,\n            qty,\n            ticketTypeId: null,\n          });\n        continue;\n      }\n      const id = ticket.ticketType.ticketTypeId;\n      const existing = map.get(id);\n      const qty = ticket.quantity ?? 1;\n      // Prefer the amount actually charged/recorded on this Ticket row —\n      // for a bundle purchase this legitimately differs from the ticket\n      // type's own standalone price/discountedPrice. Summed per ticket\n      // type then averaged below so itemized rows always add up to the\n      // booking's real subtotal, even when a ticket type's rows span an\n      // early-bird boundary or a bundle split (each a separate row with\n      // its own totalPrice/faceValue).\n      const rowTotalPrice = ticket.totalPrice;\n      const rowFaceValue = ticket.faceValue;\n      if (existing) {\n        existing.qty += qty;\n        existing.totalPriceSum += rowTotalPrice;\n        existing.faceValueSum += rowFaceValue;\n      } else {\n        map.set(id, {\n          name: ticket.ticketType.name,\n          totalPriceSum: rowTotalPrice,\n          faceValueSum: rowFaceValue,\n          qty,\n          ticketTypeId: id,\n        });\n      }\n    }\n    return Array.from(map.values()).map((v) => ({\n      name: v.name,\n      ticketTypeId: v.ticketTypeId,\n      qty: v.qty,\n      unitPrice: Math.round((v.totalPriceSum / v.qty) * 100) / 100,\n      originalPrice: Math.round((v.faceValueSum / v.qty) * 100) / 100,\n    }));\n  }, [booking?.tickets]);\n\n  // ── Inline quantity editing ──────────────────────────────────────────────\n  // Re-issues the HELD booking with an updated line quantity instead of\n  // kicking the buyer back to SelectStep. Only safe to do inline when the\n  // changed ticket type has no per-attendee custom fields to (re-)collect on\n  // increment — decrementing never needs new data, it just drops the\n  // trailing seat's (already-empty) field-response slot. Team tickets always\n  // fall back to SelectStep since \"quantity\" isn't a meaningful concept for\n  // them (they use the team radio-select + team-setup flow instead).\n  const maxQty = 20;\n  const [updatingTicketTypeId, setUpdatingTicketTypeId] = useState<\n    string | null\n  >(null);\n  const lines = useAppSelector((s) => s.booking.lines);\n  const commonFieldResponses = useAppSelector(\n    (s) => s.booking.commonFieldResponses,\n  );\n  const { city: userCity, state: userState } = useUserLocation();\n  const [createBooking] = useCreateBookingMutation();\n  const { data: ticketTypesData } = useGetTicketTypesQuery(resolvedEventId, {\n    skip: !resolvedEventId,\n  });\n  const ticketTypesById = new Map(\n    (ticketTypesData?.data ?? []).map((tt) => [tt.ticketTypeId, tt]),\n  );\n\n  const reissueQuantity = useCallback(\n    async (ticketTypeId: string, newQuantity: number) => {\n      const newLines = lines.map((l) =>\n        l.ticketTypeId === ticketTypeId\n          ? {\n              ...l,\n              quantity: newQuantity,\n              ticketFieldResponses: Array.from(\n                { length: newQuantity },\n                (_, i) => l.ticketFieldResponses[i] ?? [],\n              ),\n            }\n          : l,\n      );\n      const utmSource =\n        typeof window !== \"undefined\"\n          ? (new URLSearchParams(window.location.search).get(\"utm_source\") ??\n            getUTMParams().utmSource ??\n            undefined)\n          : undefined;\n      setUpdatingTicketTypeId(ticketTypeId);\n      try {\n        const newBooking = await createBooking(\n          buildCreateBookingRequest({\n            eventId: resolvedEventId,\n            lines: newLines,\n            commonFieldResponses,\n            referrer: utmSource,\n            city: userCity ?? undefined,\n            state: userState ?? undefined,\n            // Atomically releases the current HELD booking server-side in the\n            // same transaction that creates the new one — never two\n            // concurrent active holds, and never a lost hold if this fails.\n            supersedesBookingId: bookingId ?? undefined,\n          }),\n        ).unwrap();\n        dispatch(\n          bookingsApi.util.upsertQueryData(\n            \"getBooking\",\n            newBooking.bookingId,\n            newBooking,\n          ),\n        );\n        dispatch(\n          bookingActions.setQuantity({ ticketTypeId, quantity: newQuantity }),\n        );\n        dispatch(bookingActions.setBookingId(newBooking.bookingId));\n        saveActiveBookingId(newBooking.bookingId);\n      } catch (err: unknown) {\n        const error = err as { data?: { message?: string } };\n        const serverMsg = error?.data?.message;\n        if (\n          typeof serverMsg === \"string\" &&\n          serverMsg.startsWith(\"SUPERSEDE_TARGET_NOT_HELD\")\n        ) {\n          // Our known bookingId is no longer supersedable (expired / paid /\n          // cancelled elsewhere) — resync from the server instead of\n          // silently retrying, which could otherwise open an unrelated\n          // extra hold.\n          dispatch(\n            addToast({\n              message:\n                \"Your hold expired or changed elsewhere. Refreshing booking status.\",\n              variant: \"warning\",\n            }),\n          );\n          refetch();\n        } else {\n          dispatch(\n            addToast({\n              message:\n                serverMsg ?? \"Could not update ticket count. Please try again.\",\n              variant: \"error\",\n            }),\n          );\n        }\n      } finally {\n        setUpdatingTicketTypeId(null);\n      }\n    },\n    [\n      lines,\n      commonFieldResponses,\n      resolvedEventId,\n      userCity,\n      userState,\n      refetch,\n      bookingId,\n      createBooking,\n      dispatch,\n    ],\n  );\n\n  const handleDecrementLine = useCallback(\n    (ticketTypeId: string | null) => {\n      if (!ticketTypeId || updatingTicketTypeId) return;\n      const currentQty =\n        lines.find((l) => l.ticketTypeId === ticketTypeId)?.quantity ?? 0;\n      if (currentQty <= 1) return;\n      reissueQuantity(ticketTypeId, currentQty - 1);\n    },\n    [lines, updatingTicketTypeId, reissueQuantity],\n  );\n\n  const handleIncrementLine = useCallback(\n    (ticketTypeId: string | null) => {\n      if (!ticketTypeId || updatingTicketTypeId) return;\n      const currentQty =\n        lines.find((l) => l.ticketTypeId === ticketTypeId)?.quantity ?? 0;\n      if (currentQty >= maxQty) {\n        dispatch(\n          addToast({\n            message: `Maximum ${maxQty} tickets per order`,\n            variant: \"warning\",\n          }),\n        );\n        return;\n      }\n      const tt = ticketTypesById.get(ticketTypeId);\n      const needsReselect =\n        !tt || tt.minTeamSize != null || (tt._count?.CustomField ?? 0) > 0;\n      if (needsReselect) {\n        dispatch(bookingActions.setStep(2));\n        return;\n      }\n      reissueQuantity(ticketTypeId, currentQty + 1);\n    },\n    [lines, updatingTicketTypeId, ticketTypesById, reissueQuantity, dispatch],\n  );\n\n  if (isLoading) return <ReviewSkeleton />;\n  if (!booking) return null;\n\n  const isExpired = booking.status === \"EXPIRED\" || localExpired;\n\n  if (isExpired) {\n    return (\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"rounded-xl bg-red-500/10 border border-red-500/30 px-4 py-6 flex flex-col items-center gap-4 text-center\">\n          <svg\n            className=\"size-12 text-red-400\"\n            viewBox=\"0 0 48 48\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <circle\n              cx=\"24\"\n              cy=\"24\"\n              r=\"20\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            <path\n              d=\"M24 14v10l6 6\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            />\n          </svg>\n          <div>\n            <h3 className=\"text-h4 font-semibold text-white tracking-[-0.02em]\">\n              Your hold has expired\n            </h3>\n            <p className=\"text-p2 text-white/64 mt-1\">\n              The tickets were released. Please start over to try again.\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => {\n              clearActiveBookingId();\n              dispatch(bookingActions.reset());\n              dispatch(bookingActions.setStep(2));\n            }}\n            className=\"h-12 px-6 rounded-[40px] bg-white text-black text-h4 font-semibold tracking-[-0.02em] active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out\"\n          >\n            Start over\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // lineItems is already memoized above\n  const holdActive = booking.holdExpiresAt && !isExpired;\n  const thumbnail =\n    event?.bannerSquare ??\n    event?.banner_square ??\n    event?.thumbnail ??\n    event?.bannerHorizontal ??\n    event?.banner_horizontal ??\n    null;\n\n  return (\n    <div className=\"flex flex-col gap-4\">\n      {/* Step breadcrumb */}\n      <BookingStepper\n        currentStep=\"review\"\n        onBack={() => dispatch(bookingActions.setStep(backStep))}\n      />\n\n      {/* ── Event info ─────────────────────────────────────────────────────── */}\n      <div className=\"flex items-start gap-3\">\n        {/* Square thumbnail */}\n        {thumbnail ? (\n          <Image\n            src={thumbnail}\n            alt={booking.event.title}\n            width={112}\n            height={112}\n            className=\"w-[112px] h-[112px] rounded-2xl object-cover shrink-0\"\n          />\n        ) : (\n          <div className=\"w-[112px] h-[112px] rounded-2xl bg-white/[0.08] shrink-0 flex items-center justify-center\">\n            <svg\n              className=\"size-6 text-white/24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              aria-hidden=\"true\"\n            >\n              <rect\n                x=\"3\"\n                y=\"5\"\n                width=\"18\"\n                height=\"14\"\n                rx=\"2\"\n                stroke=\"currentColor\"\n                strokeWidth=\"1.5\"\n              />\n              <path d=\"M3 10h18\" stroke=\"currentColor\" strokeWidth=\"1.5\" />\n            </svg>\n          </div>\n        )}\n\n        {/* Info column */}\n        <div className=\"flex flex-col gap-2 min-w-0 flex-1 pt-0.5\">\n          {/* Title row with optional hold timer */}\n          <div className=\"flex items-start justify-between gap-2\">\n            <p className=\"text-h3 font-semibold text-white tracking-[-0.04em] leading-[1.1] min-w-0 flex-1\">\n              {booking.event.title}\n            </p>\n            {holdActive && (\n              <HoldCountdown\n                expiresAt={booking.holdExpiresAt}\n                onExpire={handleExpire}\n                className=\"shrink-0 mt-0.5\"\n              />\n            )}\n          </div>\n\n          {/* Date */}\n          <div className=\"flex items-center gap-1\">\n            <PiClockDefaultStroke\n              className=\"size-3 shrink-0\"\n              style={{ color: \"rgba(255,255,255,0.64)\" }}\n            />\n            <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em]\">\n              {formatEventDate(booking.event.date)}\n            </p>\n          </div>\n\n          {/* Location */}\n          {booking.event.location && (\n            <div className=\"flex items-center gap-1\">\n              <PiMapPinStroke\n                className=\"size-3 shrink-0\"\n                style={{ color: \"rgba(255,255,255,0.64)\" }}\n              />\n              <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em] truncate\">\n                {booking.event.location}\n              </p>\n            </div>\n          )}\n\n          {/* Lister with avatar */}\n          {event?.lister && (\n            <div className=\"flex items-center gap-1.5\">\n              <Avatar\n                src={event.lister.companyLogo || event.lister.avatar}\n                name={event.lister.companyName}\n                size={20}\n                textClassName=\"text-[9px] font-semibold text-white leading-none\"\n              />\n              <p className=\"text-p2 font-semibold text-white/84 tracking-[-0.02em] truncate\">\n                {event.lister.companyName}\n              </p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* ── Ticket rows ────────────────────────────────────────────────────── */}\n      <div className=\"flex flex-col gap-2\">\n        {lineItems.map((item) => {\n          const isDiscounted = item.unitPrice < item.originalPrice;\n          const discountReason = item.ticketTypeId\n            ? ticketTypesById.get(item.ticketTypeId)?.discountReason\n            : null;\n          return (\n            <div\n              key={item.name}\n              className=\"flex items-center justify-between bg-white/[0.08] rounded-2xl pl-3 pr-2 py-2\"\n            >\n              {/* Left: name + price */}\n              <div className=\"flex flex-col gap-1 min-w-0 flex-1\">\n                <p className=\"text-h4 font-medium text-white tracking-[-0.02em] leading-[1.1] truncate\">\n                  {item.name}\n                </p>\n                <div className=\"flex items-center gap-2\">\n                  <span\n                    className={`text-h5 font-semibold tracking-[-0.02em] leading-[1.1] ${isDiscounted ? \"text-[#a4e2b4]\" : \"text-white/64\"}`}\n                  >\n                    {item.unitPrice === 0 ? \"FREE\" : formatINR(item.unitPrice)}\n                  </span>\n                  {isDiscounted && item.originalPrice > 0 && (\n                    <span className=\"text-h6 font-semibold text-white/52 line-through tracking-[-0.02em]\">\n                      {formatINR(item.originalPrice)}\n                    </span>\n                  )}\n                </div>\n                {isDiscounted && discountReason && (\n                  <p className=\"text-p4 text-white/40 tracking-[-0.02em] truncate\">\n                    {discountReason}\n                  </p>\n                )}\n              </div>\n\n              {/* Right: qty stepper */}\n              <div className=\"bg-white/[0.08] rounded-xl px-3 py-1 flex items-center gap-2 shrink-0\">\n                <button\n                  type=\"button\"\n                  onClick={() => handleDecrementLine(item.ticketTypeId)}\n                  disabled={\n                    !item.ticketTypeId ||\n                    item.qty <= 1 ||\n                    Boolean(updatingTicketTypeId)\n                  }\n                  aria-label=\"Decrease tickets\"\n                  className=\"text-h4 font-semibold text-white w-4 flex items-center justify-center active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out disabled:opacity-30 disabled:cursor-not-allowed\"\n                >\n                  −\n                </button>\n                <div className=\"bg-white/[0.2] rounded-lg px-3 py-2 min-w-[38px] flex items-center justify-center\">\n                  {updatingTicketTypeId === item.ticketTypeId ? (\n                    <span\n                      className=\"inline-block size-3 rounded-full border-2 border-white/30 border-t-white animate-spin\"\n                      role=\"status\"\n                      aria-label=\"Updating quantity\"\n                    />\n                  ) : (\n                    <span className=\"text-h6 font-semibold text-white tabular-nums\">\n                      {String(item.qty).padStart(2, \"0\")}\n                    </span>\n                  )}\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => handleIncrementLine(item.ticketTypeId)}\n                  disabled={!item.ticketTypeId || Boolean(updatingTicketTypeId)}\n                  aria-label=\"Increase tickets\"\n                  className=\"text-h4 font-semibold text-white w-4 flex items-center justify-center active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out disabled:opacity-30 disabled:cursor-not-allowed\"\n                >\n                  +\n                </button>\n              </div>\n            </div>\n          );\n        })}\n\n        {/* Add Tickets */}\n        <button\n          type=\"button\"\n          onClick={() => dispatch(bookingActions.setStep(2))}\n          className=\"\n            w-full flex items-center justify-center gap-2\n            min-h-11 p-4 rounded-3xl\n            border border-white/[0.16]\n            text-h5 font-medium text-white/84 tracking-[-0.02em]\n            transition-[opacity,transform] duration-200 ease-out\n            active:opacity-70 active:scale-[0.97]\n            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n          \"\n        >\n          <PiPlusDefaultStroke className=\"size-3\" />\n          Add Tickets\n        </button>\n      </div>\n\n      {/* ── User profile card ───────────────────────────────────────────────── */}\n      <div className=\"flex items-center gap-3 bg-white/[0.08] rounded-2xl p-3\">\n        <Avatar\n          src={user?.avatar}\n          name={user?.name}\n          size={44}\n          border=\"1px solid rgba(255,255,255,0.16)\"\n          textClassName=\"text-h5 font-semibold text-white\"\n        />\n\n        <div className=\"flex flex-col gap-1 min-w-0 flex-1\">\n          {user?.name && (\n            <p className=\"text-h5 font-medium text-white tracking-[-0.02em] leading-[1.1] truncate\">\n              {user.name}\n            </p>\n          )}\n          {user?.phone && (\n            <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em] truncate\">\n              {user.phone}\n            </p>\n          )}\n          {user?.email && (\n            <p className=\"text-p2 font-medium text-white/64 tracking-[-0.02em] truncate\">\n              {user.email}\n            </p>\n          )}\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={() => dispatch(bookingActions.setStep(3))}\n          aria-label=\"Edit details\"\n          className=\"\n            size-8 rounded-lg shrink-0\n            bg-white/[0.12] border border-white/[0.12]\n            flex items-center justify-center\n            active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out\n            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n          \"\n        >\n          <PiPencilEditStroke\n            className=\"size-3\"\n            style={{ color: \"rgba(255,255,255,0.64)\" }}\n          />\n        </button>\n      </div>\n\n      {/* ── Coupon code ─────────────────────────────────────────────────────── */}\n      <div>\n        {booking.discountCode ? (\n          <div className=\"flex flex-col gap-1 border border-white/[0.2] rounded-2xl px-4 py-3\">\n            <div className=\"flex items-center justify-between gap-3\">\n              <div className=\"flex items-center gap-2\">\n                <svg\n                  className=\"size-4 text-green-400 shrink-0\"\n                  viewBox=\"0 0 16 16\"\n                  fill=\"none\"\n                  aria-hidden=\"true\"\n                >\n                  <path\n                    d=\"M9.5 2H14v4.5l-6 6a1.414 1.414 0 01-2 0L2 8.5a1.414 1.414 0 010-2l6-4.5z\"\n                    stroke=\"currentColor\"\n                    strokeWidth=\"1.4\"\n                    strokeLinejoin=\"round\"\n                  />\n                  <circle cx=\"11.5\" cy=\"4.5\" r=\"0.75\" fill=\"currentColor\" />\n                </svg>\n                <span className=\"text-h5 font-semibold text-green-400 tracking-wider uppercase\">\n                  {booking.discountCode.code}\n                </span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handleRemoveDiscount}\n                disabled={isApplying}\n                className=\"text-h6 font-medium text-white/64 min-h-[36px] px-2 active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out disabled:opacity-40\"\n              >\n                Remove\n              </button>\n            </div>\n            {booking.discountCode.description && (\n              <p className=\"text-p3 text-white/52 tracking-[-0.02em] pl-6\">\n                {booking.discountCode.description}\n              </p>\n            )}\n          </div>\n        ) : (\n          <div className=\"flex items-center border border-white/[0.2] rounded-xl h-11 overflow-hidden\">\n            <input\n              type=\"text\"\n              value={discountInput}\n              onChange={(e) =>\n                dispatch(bookingActions.setDiscountInput(e.target.value))\n              }\n              placeholder=\"Coupon Code\"\n              aria-label=\"Discount code\"\n              className=\"\n                flex-1 h-full bg-transparent px-3\n                text-h5 font-medium text-white placeholder:text-white/64\n                focus:outline-none\n              \"\n              onKeyDown={(e) => {\n                if (e.key === \"Enter\") handleApplyDiscount();\n              }}\n            />\n            <button\n              type=\"button\"\n              onClick={handleApplyDiscount}\n              disabled={isApplying || !discountInput.trim()}\n              className=\"\n                h-[35px] px-4 mx-1 shrink-0\n                bg-white/[0.16] rounded-lg\n                text-h6 font-semibold text-white/56\n                disabled:opacity-40 disabled:cursor-not-allowed\n                active:opacity-70 active:scale-[0.97] transition-[opacity,transform] duration-100 ease-out\n                focus-visible:outline-none\n              \"\n            >\n              {isApplying ? \"…\" : \"Apply\"}\n            </button>\n          </div>\n        )}\n\n        {discountError && (\n          <p className=\"text-p3 text-red-400 mt-2 px-1\">{discountError}</p>\n        )}\n      </div>\n\n      {/* ── Price breakdown — shared with the venue booking funnel. The\n          component handles Subtotal / Discount / combined Platform fee\n          (with tooltip) / GST (USER only) / Total. */}\n      <BookingSummary\n        subtotal={booking.subtotal}\n        subtotalLabel=\"Tickets\"\n        discountAmount={booking.discountAmount}\n        platformFee={booking.platformFee}\n        gatewayFee={booking.gatewayFee}\n        gst={booking.gst}\n        feeBornBy={booking.feesBornBy}\n        total={booking.total}\n        bare\n      />\n\n      {/* ── Pay / Confirm CTA ───────────────────────────────────────────────── */}\n      <button\n        type=\"button\"\n        disabled={isExpired || isApplying || pending}\n        onClick={async () => {\n          if (!bookingId) return;\n          setPending(true);\n          try {\n            if (booking.total === 0) {\n              // Free booking — confirm directly, no payment service involved\n              await confirmFree(bookingId).unwrap();\n              clearActiveBookingId();\n              dispatch(bookingActions.reset());\n              router.push(`/booking/success?ticketId=${bookingId}`);\n            } else {\n              dispatch(bookingActions.setStep(5));\n            }\n          } catch {\n            dispatch(\n              addToast({\n                message: \"Could not confirm booking. Please try again.\",\n                variant: \"error\",\n              }),\n            );\n          } finally {\n            setPending(false);\n          }\n        }}\n        className=\"\n          w-full h-12 rounded-[40px]\n          bg-white border border-[rgba(255,255,255,0.04)]\n          flex items-center justify-center gap-3\n          disabled:opacity-60 disabled:cursor-not-allowed\n          transition-[opacity,transform] duration-100 ease-out\n          active:opacity-70 active:scale-[0.97]\n          focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\n        \"\n      >\n        {pending ? (\n          <span className=\"inline-block size-4 rounded-full border-2 border-black/30 border-t-black animate-spin\" />\n        ) : booking.total === 0 ? (\n          <>\n            <span className=\"text-h4 font-semibold text-black tracking-[-0.02em]\">\n              Confirm for Free\n            </span>\n            <PiArrowRightStroke\n              size={16}\n              style={{ color: \"#000000\" }}\n              aria-hidden=\"true\"\n            />\n          </>\n        ) : (\n          <>\n            <span className=\"text-h4 font-semibold text-black tracking-[-0.02em]\">\n              Pay {formatINR(booking.total)}\n            </span>\n            <PiArrowRightStroke\n              size={16}\n              style={{ color: \"#000000\" }}\n              aria-hidden=\"true\"\n            />\n          </>\n        )}\n      </button>\n    </div>\n  );\n}\n","numLines":875,"startLine":1,"totalLines":875}},"tool_result_meta":[{"id":"call-2cfba1f1-d390-4683-a7de-85532c812ac8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06ba0f7498b4183218","type":"tool_result","content":"1\timport { config } from \"../../config\";\n2\timport logger from \"../../config/logger\";\n3\timport { redis } from \"../../config/redis\";\n4\timport { PUSH_COPY } from \"../../lib/push-copy\";\n5\timport { teamQueue } from \"../../lib/queues\";\n6\timport { BookingRepository } from \"../../repositories/booking.repository\";\n7\timport { CheckoutSessionRepository } from \"../../repositories/checkout-session.repository\";\n8\timport { DashboardRepository } from \"../../repositories/Dashboard.repository\";\n9\timport { EventRepository } from \"../../repositories/event.repository\";\n10\timport { ListerRepository } from \"../../repositories/lister.repository\";\n11\timport { ListerSubscriptionRepository } from \"../../repositories/lister-subscription.repository\";\n12\timport { NotificationPrefsRepository } from \"../../repositories/NotificationPrefs.repository\";\n13\timport { PaymentRepository } from \"../../repositories/payment.repository\";\n14\timport { TeamRepository } from \"../../repositories/team.repository\";\n15\timport { UserRepository } from \"../../repositories/user.repository\";\n16\timport { BadRequestError, ConflictError } from \"../../utils/errors.util\";\n17\timport { AnalyticsService } from \"../analytics.service\";\n18\timport { DiscountService } from \"../discount.service\";\n19\timport { EmailService } from \"../email.service\";\n20\timport { MeetingIntegrationService } from \"../meeting-integration.service\";\n21\timport { enqueuePartnerWebhook } from \"../partner-webhook.service\";\n22\timport { PushService } from \"../push.service\";\n23\t\n24\t/**\n25\t * Finalizes a booking after payment is confirmed and handles the\n26\t * team-confirmation side effects. Shared between the client-side\n27\t * verify-payment path and the Razorpay webhook path — both call these\n28\t * so the booking/team flips to paid/confirmed whichever signal arrives first.\n29\t */\n30\texport class BookingPaymentFinalizerService {\n31\t  private bookingRepository: BookingRepository;\n32\t  private eventRepository: EventRepository;\n33\t  private userRepository: UserRepository;\n34\t  private teamRepository: TeamRepository;\n35\t  private analyticsService: AnalyticsService;\n36\t  private emailService: EmailService;\n37\t  private listerRepository: ListerRepository;\n38\t  private notificationPrefsRepository: NotificationPrefsRepository;\n39\t  private discountService: DiscountService;\n40\t  private meetingIntegrationService: MeetingIntegrationService;\n41\t  private dashboardRepository: DashboardRepository;\n42\t  private listerSubscriptionRepository: ListerSubscriptionRepository;\n43\t  private checkoutSessionRepository = new CheckoutSessionRepository();\n44\t  private paymentRepository = new PaymentRepository();\n45\t\n46\t  constructor(\n47\t    bookingRepository?: BookingRepository,\n48\t    eventRepository?: EventRepository,\n49\t    userRepository?: UserRepository,\n50\t    teamRepository?: TeamRepository,\n51\t    analyticsService?: AnalyticsService,\n52\t    emailService?: EmailService,\n53\t    listerRepository?: ListerRepository,\n54\t    notificationPrefsRepository?: NotificationPrefsRepository,\n55\t  ) {\n56\t    this.bookingRepository = bookingRepository ?? new BookingRepository();\n57\t    this.eventRepository = eventRepository ?? new EventRepository();\n58\t    this.userRepository = userRepository ?? new UserRepository();\n59\t    this.teamRepository = teamRepository ?? new TeamRepository();\n60\t    this.analyticsService = analyticsService ?? new AnalyticsService();\n61\t    this.emailService = emailService ?? new EmailService();\n62\t    this.listerRepository = listerRepository ?? new ListerRepository();\n63\t    this.notificationPrefsRepository =\n64\t      notificationPrefsRepository ?? new NotificationPrefsRepository();\n65\t    this.discountService = new DiscountService();\n66\t    this.meetingIntegrationService = new MeetingIntegrationService();\n67\t    this.dashboardRepository = new DashboardRepository();\n68\t    this.listerSubscriptionRepository = new ListerSubscriptionRepository();\n69\t  }\n70\t\n71\t  /**\n72\t   * Apply team-confirmation logic after a booking is finalised. Idempotent —\n73\t   * shared between the client-side verify path and the Razorpay webhook path,\n74\t   * so the team flips to CONFIRMED whichever finalization signal arrives first.\n75\t   */\n76\t  async confirmTeamFromBookingResult(\n77\t    bookingId: string,\n78\t    result: Awaited<ReturnType<BookingRepository[\"findByIdWithDetails\"]>>,\n79\t  ) {\n80\t    const teamId = result.tickets[0]?.teamId ?? null;\n81\t    if (!teamId) return;\n82\t\n83\t    try {\n84\t      const team = await this.teamRepository.findById(teamId);\n85\t      if (!team) return;\n86\t\n87\t      if (team.status === \"CONFIRMED\") {\n88\t        // Either a duplicate webhook delivery for an already-settled team, or\n89\t        // a §2 open-seat purchase finalizing: someone paid for a spare seat\n90\t        // on a team that was confirmed before they joined, so there's a\n91\t        // `TeamMember` row with `ticketId: null` awaiting this ticket. Link\n92\t        // it and stop — no team-status change, no re-running the whole-team\n93\t        // auto-confirm block below (it doesn't apply, the team was already\n94\t        // confirmed before this purchase started).\n95\t        const ticketUserId = result.tickets[0]?.userId;\n96\t        const awaitingMember = ticketUserId\n97\t          ? team.members.find((m) => m.userId === ticketUserId && !m.ticketId)\n98\t          : undefined;\n99\t        if (awaitingMember && result.tickets[0]) {\n100\t          await this.teamRepository.linkMemberTicket(\n101\t            awaitingMember.memberId,\n102\t            result.tickets[0].ticketId,\n103\t          );\n104\t          logger.info(\"Open-seat purchase finalized on confirmed team\", {\n105\t            teamId,\n106\t            bookingId,\n107\t            memberId: awaitingMember.memberId,\n108\t          });\n109\t        }\n110\t        return;\n111\t      }\n112\t\n113\t      const paidSeatCount = result.tickets.length;\n114\t      // Tickets created by prepareTeamForPayment are already owned by the\n115\t      // correct member (team.service.ts sets userId: member.userId at\n116\t      // creation) — match on that instead of zipping by array position.\n117\t      // Positional zipping breaks (undefined ticketId → crash) whenever a\n118\t      // member joins the team between prepare-payment and payment completion,\n119\t      // since team.members grows past the ticket count captured at prep time.\n120\t      const ticketByUserId = new Map(\n121\t        result.tickets.map((t) => [t.userId, t.ticketId]),\n122\t      );\n123\t      const memberTickets = team.members\n124\t        .filter((m) => ticketByUserId.has(m.userId))\n125\t        .map((m) => ({\n126\t          memberId: m.memberId,\n127\t          ticketId: ticketByUserId.get(m.userId) as string,\n128\t        }));\n129\t      const allSeatsFilledNow = memberTickets.length >= paidSeatCount;\n130\t\n131\t      if (allSeatsFilledNow) {\n132\t        await this.teamRepository.confirmTeamWithTickets(teamId, memberTickets);\n133\t        await Promise.all(\n134\t          team.members.map((member) =>\n135\t            teamQueue.add(\"team-confirmed\", {\n136\t              email: member.user.email,\n137\t              teamName: team.teamName,\n138\t              eventTitle: team.event.title,\n139\t              eventDate: team.event.date,\n140\t            }),\n141\t          ),\n142\t        );\n143\t        logger.info(\"Team confirmed after booking payment\", {\n144\t          teamId,\n145\t          bookingId,\n146\t          memberCount: team.members.length,\n147\t        });\n148\t      } else {\n149\t        const leaderMember = team.members.find((m) => m.isLeader);\n150\t        if (leaderMember && !leaderMember.ticketId) {\n151\t          // Must match by userId, not position — this function also runs\n152\t          // for a plain solo purchase that merely carries this team's\n153\t          // teamId tag (e.g. a join-code request paying for their own\n154\t          // single seat), where result.tickets contains only the payer's\n155\t          // own ticket. Grabbing \"the last ticket\" unconditionally used to\n156\t          // link a stranger's paid-for-themselves ticket onto the leader's\n157\t          // TeamMember row whenever the leader didn't have one linked yet.\n158\t          const leaderTicket = result.tickets.find(\n159\t            (t) => t.userId === leaderMember.userId,\n160\t          );\n161\t          if (leaderTicket) {\n162\t            await this.teamRepository.linkMemberTicket(\n163\t              leaderMember.memberId,\n164\t              leaderTicket.ticketId,\n165\t            );\n166\t          }\n167\t        }\n168\t        logger.info(\"Team booking paid, awaiting members via join code\", {\n169\t          teamId,\n170\t          bookingId,\n171\t          paidSeats: paidSeatCount,\n172\t          currentMembers: team.members.length,\n173\t        });\n174\t      }\n175\t    } catch (teamErr) {\n176\t      logger.warn(\"Team confirmation step failed after booking payment\", {\n177\t        teamId,\n178\t        bookingId,\n179\t        error: teamErr,\n180\t      });\n181\t    }\n182\t  }\n183\t\n184\t  private async sendBookingConfirmationEmail(\n185\t    bookingDetails: Awaited<\n186\t      ReturnType<BookingRepository[\"findByIdWithDetails\"]>\n187\t    >,\n188\t    resend = false,\n189\t  ): Promise<boolean> {\n190\t    const user = await this.userRepository.findById(bookingDetails.userId);\n191\t    if (!user?.email) return false;\n192\t\n193\t    return this.emailService.sendEmail({\n194\t      toEmail: user.email,\n195\t      // Keyed on the booking, not the Razorpay paymentId: cash sales have no\n196\t      // paymentId, so they all shared one job id and only the first was sent.\n197\t      // A resend gets a fresh key, otherwise the queue drops it as a duplicate.\n198\t      dedupeKey: resend\n199\t        ? `${bookingDetails.bookingId}__${Date.now()}`\n200\t        : bookingDetails.bookingId,\n201\t      name: user.name ?? undefined,\n202\t      payload: {\n203\t        type: \"payment-confirmation\",\n204\t        content: {\n205\t          userName: user.name ?? \"Guest\",\n206\t          eventName: bookingDetails.event.title,\n207\t          eventDate: bookingDetails.event.date.toISOString(),\n208\t          eventVenue: bookingDetails.event.location ?? \"\",\n209\t          ticketCount: bookingDetails.tickets.reduce(\n210\t            (sum, t) => sum + t.quantity,\n211\t            0,\n212\t          ),\n213\t          amount: bookingDetails.total,\n214\t          currency: \"INR\",\n215\t          paymentId: bookingDetails.payment?.razorpayPaymentId ?? \"\",\n216\t          orderId: bookingDetails.payment?.razorpayOrderId ?? \"\",\n217\t          paymentMethod:\n218\t            bookingDetails.paymentMode === \"CASH\"\n219\t              ? \"Cash\"\n220\t              : (bookingDetails.payment?.method ?? \"Razorpay\"),\n221\t          bookingDate: bookingDetails.createdAt.toISOString(),\n222\t          tickets: bookingDetails.tickets.map((t) => ({\n223\t            ticketId: t.ticketId,\n224\t            ticketType: t.ticketType?.name ?? \"Standard\",\n225\t            quantity: t.quantity,\n226\t            price: t.totalPrice || 0,\n227\t            qrCode: bookingDetails.qrCode ?? null,\n228\t          })),\n229\t        },\n230\t      },\n231\t    });\n232\t  }\n233\t\n234\t  /**\n235\t   * Door sales: staff tap \"resend\" when the guest says the email never came.\n236\t   * Safe to call any number of times, it only sends the same confirmation again.\n237\t   */\n238\t  async resendConfirmationEmail(bookingId: string): Promise<void> {\n239\t    const details = await this.bookingRepository.findByIdWithDetails(bookingId);\n240\t    if (details.status !== \"PAID\") {\n241\t      throw new ConflictError(\"Only a paid booking can be re-sent\");\n242\t    }\n243\t    const sent = await this.sendBookingConfirmationEmail(details, true);\n244\t    if (!sent)\n245\t      throw new BadRequestError(\"Could not send the email, please try again\");\n246\t  }\n247\t\n248\t  /**\n249\t   * Shared helper: atomically finalise a booking that has been paid.\n250\t   * Idempotent — safe to call multiple times (e.g. verify + webhook).\n251\t   * Returns the fully-loaded booking.\n252\t   */\n253\t  async finalizePaidBooking(\n254\t    bookingId: string,\n255\t    opts?: { cash?: { reason: string } },\n256\t  ) {\n257\t    // Atomic status transition — returns false if another caller already paid\n258\t    const transitioned = await this.bookingRepository.markPaidTx(\n259\t      bookingId,\n260\t      opts?.cash,\n261\t    );\n262\t\n263\t    // Cash must never use the force-paid recovery below. That path exists for\n264\t    // money Razorpay really captured. With cash nothing was captured, so if the\n265\t    // booking already left HELD (expired, or UPI won) we stop and tell staff.\n266\t    if (!transitioned && opts?.cash) {\n267\t      throw new ConflictError(\n268\t        \"This sale is already settled or has expired. Start a new sale.\",\n269\t      );\n270\t    }\n271\t\n272\t    if (!transitioned) {\n273\t      const current =\n274\t        await this.bookingRepository.findByIdWithDetails(bookingId);\n275\t\n276\t      if (current.status === \"PAID\") {\n277\t        // verifyBookingPayment and the webhook raced; the other caller owns\n278\t        // side effects. Return current state so the caller can still proceed.\n279\t        logger.info(\"finalizePaidBooking: already paid by concurrent caller\", {\n280\t          bookingId,\n281\t        });\n282\t        return current;\n283\t      }\n284\t\n285\t      // The booking left HELD via some path OTHER than a concurrent payment\n286\t      // finalize — almost always the hold-expiry sweep winning a race against\n287\t      // a slow-to-capture payment (createPaymentOrderForBooking's extendHold\n288\t      // window can be tight for a slow UPI collect approval). Whoever called\n289\t      // finalizePaidBooking only does so after Razorpay has already confirmed\n290\t      // the payment captured, so the captured money has to win over an\n291\t      // internal hold timer — silently treating this as \"someone else handled\n292\t      // it\" strands the buyer with no ticket and no refund, forever, since\n293\t      // the payment row is about to be marked COMPLETED and no retry will\n294\t      // ever fire again. Force it through and log loudly so this is never\n295\t      // silent.\n296\t      logger.error(\n297\t        \"finalizePaidBooking: booking left HELD via an expiry/cancel race with a captured payment — forcing to PAID\",\n298\t        { bookingId, statusFound: current.status },\n299\t      );\n300\t      const forced =\n301\t        await this.bookingRepository.forcePaidAfterRaceTx(bookingId);\n302\t      if (!forced) {\n303\t        logger.error(\n304\t          \"finalizePaidBooking: could not force booking to PAID — needs manual repair\",\n305\t          { bookingId, statusFound: current.status },\n306\t        );\n307\t        return current;\n308\t      }\n309\t\n310\t      // The paid seat won, but the freed slot may have been resold in the gap. Don't undo\n311\t      // the sale; mark the payment so ops sees it and can refund one buyer by hand.\n312\t      try {\n313\t        if (await this.bookingRepository.hasOversoldTicketType(bookingId)) {\n314\t          const orderId = current.payment?.razorpayOrderId;\n315\t          logger.error(\n316\t            \"finalizePaidBooking: late capture pushed a ticket type past its quantity, needs manual review\",\n317\t            { bookingId, orderId },\n318\t          );\n319\t          if (orderId)\n320\t            await this.paymentRepository.flagForReconciliation(\n321\t              orderId,\n322\t              \"OVERSOLD_AFTER_LATE_CAPTURE\",\n323\t            );\n324\t        }\n325\t      } catch (error) {\n326\t        logger.warn(\"Could not check oversell after late capture\", {\n327\t          bookingId,\n328\t          error,\n329\t        });\n330\t      }\n331\t    }\n332\t\n333\t    // Load full details (includes discountCodeId not returned by markPaidTx)\n334\t    const bookingDetails =\n335\t      await this.bookingRepository.findByIdWithDetails(bookingId);\n336\t\n337\t    // If a discount code was applied, increment its usage counter\n338\t    if (bookingDetails.discountCodeId) {\n339\t      try {\n340\t        await this.discountService.applyDiscountCode(\n341\t          bookingDetails.discountCodeId,\n342\t          bookingDetails.total,\n343\t        );\n344\t      } catch (error) {\n345\t        // Log but don't fail the payment — discount increment is best-effort\n346\t        logger.warn(\n347\t          \"Failed to increment discount usage after booking payment\",\n348\t          {\n349\t            bookingId,\n350\t            discountCodeId: bookingDetails.discountCodeId,\n351\t            error,\n352\t          },\n353\t        );\n354\t      }\n355\t    }\n356\t\n357\t    // Host API bookings point back at their checkout session; flip it to PAID.\n358\t    // Best-effort: the booking is already paid, a missed flip must not undo it.\n359\t    if (bookingDetails.checkoutSessionId) {\n360\t      try {\n361\t        const flipped = await this.checkoutSessionRepository.markPaid(\n362\t          bookingDetails.checkoutSessionId,\n363\t        );\n364\t        // verify-payment and the Razorpay webhook both land here; only the first flip notifies.\n365\t        if (flipped.count > 0) {\n366\t          const session = await this.checkoutSessionRepository.findById(\n367\t            bookingDetails.checkoutSessionId,\n368\t          );\n369\t          if (session) {\n370\t            await enqueuePartnerWebhook(\n371\t              session.listerId,\n372\t              session.mode,\n373\t              \"booking.confirmed\",\n374\t              {\n375\t                bookingId,\n376\t                sessionId: session.sessionId,\n377\t                eventId: session.eventId,\n378\t                clientReference: session.clientReference,\n379\t                amountPaise: session.amountPaise,\n380\t                currency: \"INR\",\n381\t              },\n382\t            );\n383\t          }\n384\t        }\n385\t      } catch (error) {\n386\t        logger.warn(\"Failed to mark checkout session paid\", {\n387\t          bookingId,\n388\t          checkoutSessionId: bookingDetails.checkoutSessionId,\n389\t          error,\n390\t        });\n391\t      }\n392\t    }\n393\t\n394\t    // Update analytics + subscription quota + bust dashboard caches so the\n395\t    // lister dashboard reflects this booking immediately. Mirrors what the\n396\t    // ticket-based verifyPayment path does — without these, team payments\n397\t    // would not appear in the dashboard until cache TTL (60s) expires.\n398\t    const eventId = bookingDetails.event.eventId;\n399\t    const totalQuantity = bookingDetails.tickets.reduce(\n400\t      (sum, t) => sum + (t.quantity ?? 0),\n401\t      0,\n402\t    );\n403\t    try {\n404\t      await this.analyticsService.updateAfterTicketPurchase(\n405\t        eventId,\n406\t        totalQuantity,\n407\t        bookingDetails.total,\n408\t        {\n409\t          userId: bookingDetails.userId,\n410\t          paymentId: bookingDetails.payment?.razorpayPaymentId ?? undefined,\n411\t          bookingId,\n412\t        },\n413\t      );\n414\t    } catch (analyticsError) {\n415\t      logger.error(\"Analytics update failed after booking payment\", {\n416\t        error: analyticsError,\n417\t        bookingId,\n418\t        eventId,\n419\t      });\n420\t    }\n421\t\n422\t    const event = await this.eventRepository.findByIdMinimal(eventId);\n423\t    if (event?.listerId) {\n424\t      try {\n425\t        await this.listerSubscriptionRepository.incrementTicketsUsed(\n426\t          event.listerId,\n427\t          totalQuantity,\n428\t        );\n429\t      } catch (subErr) {\n430\t        logger.warn(\n431\t          \"Subscription quota increment failed after booking payment\",\n432\t          {\n433\t            error: subErr,\n434\t            bookingId,\n435\t            listerId: event.listerId,\n436\t          },\n437\t        );\n438\t      }\n439\t      try {\n440\t        await this.dashboardRepository.invalidateOnBooking(\n441\t          event.listerId,\n442\t          eventId,\n443\t        );\n444\t      } catch (cacheErr) {\n445\t        logger.warn(\n446\t          \"Dashboard cache invalidation failed after booking payment\",\n447\t          {\n448\t            error: cacheErr,\n449\t            bookingId,\n450\t          },\n451\t        );\n452\t      }\n453\t    }\n454\t\n455\t    // Send booking confirmation email (best-effort — don't fail the payment)\n456\t    this.sendBookingConfirmationEmail(bookingDetails).catch((err) =>\n457\t      logger.warn(\"Failed to send booking confirmation email\", {\n458\t        bookingId,\n459\t        err,\n460\t      }),\n461\t    );\n462\t\n463\t    // Send push notification (fire-and-forget)\n464\t    PushService.enqueue({\n465\t      userId: bookingDetails.userId,\n466\t      ...PUSH_COPY.booking_paid(bookingDetails.event.title, bookingId),\n467\t    });\n468\t\n469\t    // Notify host of new booking (fire-and-forget)\n470\t    const listerId = bookingDetails.event.listerId;\n471\t    if (listerId) {\n472\t      this.notifyHostOfNewBooking(\n473\t        listerId,\n474\t        bookingDetails.event.title,\n475\t        bookingDetails.userId,\n476\t        totalQuantity,\n477\t        bookingDetails.total,\n478\t        eventId,\n479\t      ).catch((err) =>\n480\t        logger.warn(\"Failed to send host booking notification\", {\n481\t          bookingId,\n482\t          err,\n483\t        }),\n484\t      );\n485\t    }\n486\t\n487\t    // Add buyer to Google Calendar event's guest list so Google Meet grants\n488\t    // direct access. Fire-and-forget — payment must not fail if this fails.\n489\t    const ev = bookingDetails.event;\n490\t    if (\n491\t      ev.meetingProvider === \"GOOGLE_MEET\" &&\n492\t      ev.externalMeetingId &&\n493\t      ev.listerId\n494\t    ) {\n495\t      const buyer = await this.userRepository.findById(bookingDetails.userId);\n496\t      if (buyer?.email) {\n497\t        this.meetingIntegrationService\n498\t          .addAttendeeToCachedMeeting(\n499\t            ev.listerId,\n500\t            ev.externalMeetingId,\n501\t            buyer.email,\n502\t          )\n503\t          .catch((err) =>\n504\t            logger.warn(\"Meeting attendee enqueue failed (booking path)\", {\n505\t              bookingId,\n506\t              err,\n507\t            }),\n508\t          );\n509\t      }\n510\t    }\n511\t\n512\t    logger.info(\"Booking finalised as paid\", {\n513\t      bookingId,\n514\t      userId: bookingDetails.userId,\n515\t      total: bookingDetails.total,\n516\t    });\n517\t\n518\t    return bookingDetails;\n519\t  }\n520\t\n521\t  /**\n522\t   * Notify host of a new booking. Fire-and-forget.\n523\t   * Rate-limited per event: push at most once per 5 min, email at most once per hour.\n524\t   * Prevents notification spam on popular events with many rapid bookings.\n525\t   */\n526\t  private async notifyHostOfNewBooking(\n527\t    listerId: string,\n528\t    eventTitle: string,\n529\t    buyerUserId: string,\n530\t    ticketCount: number,\n531\t    amount: number,\n532\t    eventId: string,\n533\t  ) {\n534\t    const pushKey = `cache:host-booking-notify:${eventId}:push`;\n535\t    const emailKey = `cache:host-booking-notify:${eventId}:email`;\n536\t\n537\t    const [pushSent, emailSent] = await Promise.all([\n538\t      redis.get(pushKey),\n539\t      redis.get(emailKey),\n540\t    ]);\n541\t\n542\t    // Both channels are in cooldown — skip everything\n543\t    if (pushSent && emailSent) return;\n544\t\n545\t    // Fetch lister and buyer only when at least one channel will fire\n546\t    const [lister, buyer] = await Promise.all([\n547\t      this.listerRepository.findById(listerId),\n548\t      this.userRepository.findById(buyerUserId),\n549\t    ]);\n550\t    if (!lister?.userId) return;\n551\t\n552\t    const buyerName = buyer?.name || \"A guest\";\n553\t    const listerName = lister.companyName || \"Organizer\";\n554\t\n555\t    if (!pushSent) {\n556\t      PushService.enqueue({\n557\t        userId: lister.userId,\n558\t        ...PUSH_COPY.host_new_booking(\n559\t          buyerName,\n560\t          ticketCount,\n561\t          eventTitle,\n562\t          eventId,\n563\t        ),\n564\t      });\n565\t      await redis.set(pushKey, \"1\", \"EX\", 5 * 60); // 5-minute cooldown\n566\t    }\n567\t\n568\t    if (!emailSent) {\n569\t      // Check lister notification preferences before sending email\n570\t      let shouldSendEmail = true;\n571\t      try {\n572\t        const prefs = await this.notificationPrefsRepository.findOrCreate(\n573\t          lister.userId,\n574\t        );\n575\t        shouldSendEmail = prefs.newBookingEmail;\n576\t      } catch {\n577\t        // Default to sending if prefs lookup fails\n578\t      }\n579\t\n580\t      if (shouldSendEmail && lister.contactEmail) {\n581\t        this.emailService\n582\t          .sendEmail({\n583\t            toEmail: lister.contactEmail,\n584\t            payload: {\n585\t              type: \"new-booking-notification\",\n586\t              content: {\n587\t                listerName,\n588\t                eventName: eventTitle,\n589\t                buyerName,\n590\t                ticketCount,\n591\t                amount,\n592\t                bookingTime: new Date().toISOString(),\n593\t                dashboardUrl: `${config.WEB_BASE_URL}/dashboard/events/${eventId}/audience`,\n594\t              },\n595\t            },\n596\t          })\n597\t          .catch((err) =>\n598\t            logger.warn(\"Failed to send new booking email to host\", {\n599\t              listerId,\n600\t              eventId,\n601\t              err,\n602\t            }),\n603\t          );\n604\t      }\n605\t      await redis.set(emailKey, \"1\", \"EX\", 60 * 60); // 1-hour cooldown\n606\t    }\n607\t  }\n608\t}\n609\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"03cca8e9-328c-4e50-bb40-68a798ff4df2","timestamp":"2026-11-20T17:35:08.525Z","tool_result_meta":[{"id":"call_01a1fa06ba0f7498b4183218","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
