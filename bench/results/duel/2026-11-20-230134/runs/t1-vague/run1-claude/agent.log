{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06923b703898a1a74d","type":"tool_result","content":"1\t/**\n2\t * Coupon pricing — pure helpers, no Prisma, no side effects.\n3\t *\n4\t * Implements spec §3.0 exactly:\n5\t *   1. Eligibility gate (inactive / not-started / expired / maxUses / minOrderAmt)\n6\t *      → discount = 0 with a reason code; no exception thrown (pricing path)\n7\t *   2. Raw discount by type (PERCENTAGE via discountPct, FLAT via discountAmt)\n8\t *   3. maxDiscount cap\n9\t *   4. Clamp to couponBase (order never goes below 0)\n10\t *\n11\t * `distributeCoupon` splits the order-level discount proportionally across\n12\t * booking lines (by seatFace × qty weight) with a last-line residual guard\n13\t * so Σ shares == discount exactly.\n14\t */\n15\t\n16\timport { fromPaise, toPaise } from \"./money.util\";\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Types\n20\t// ---------------------------------------------------------------------------\n21\t\n22\t/** Minimal coupon data needed for discount computation. */\n23\texport interface CouponInput {\n24\t  isActive: boolean;\n25\t  validFrom: Date | null | undefined;\n26\t  validTo: Date | null | undefined;\n27\t  maxUses: number | null | undefined;\n28\t  usesCount: number;\n29\t  minOrderAmt: number | null | undefined;\n30\t  discountType: \"PERCENTAGE\" | \"FLAT\";\n31\t  /** 0–100 for PERCENTAGE coupons */\n32\t  discountPct: number | null | undefined;\n33\t  /** rupees for FLAT coupons */\n34\t  discountAmt: number | null | undefined;\n35\t  maxDiscount: number | null | undefined;\n36\t}\n37\t\n38\texport type CouponFailReason =\n39\t  | \"INACTIVE\"\n40\t  | \"NOT_STARTED\"\n41\t  | \"EXPIRED\"\n42\t  | \"MAX_USES\"\n43\t  | \"MIN_ORDER_AMT\";\n44\t\n45\texport interface CouponResult {\n46\t  /** Always >= 0. 0 when eligibility check fails. */\n47\t  discount: number;\n48\t  /** Present when discount == 0 due to an eligibility failure. */\n49\t  reason?: CouponFailReason;\n50\t}\n51\t\n52\t/** A single line in a booking (one ticket-type group). */\n53\texport interface CouponPricingLine {\n54\t  /** Per-seat face price (post-early-bird, pre-coupon). */\n55\t  seatFace: number;\n56\t  qty: number;\n57\t}\n58\t\n59\t// ---------------------------------------------------------------------------\n60\t// computeCouponDiscount\n61\t// ---------------------------------------------------------------------------\n62\t\n63\t/**\n64\t * Compute the order-level coupon discount.\n65\t *\n66\t * @param couponBase  Σ (seatFace × qty) across all lines — the post-early-bird subtotal.\n67\t * @param coupon      Coupon data from DB (or a test fixture).\n68\t * @returns           `{ discount }` always; `{ discount: 0, reason }` on eligibility failure.\n69\t */\n70\texport function computeCouponDiscount(\n71\t  couponBase: number,\n72\t  coupon: CouponInput,\n73\t): CouponResult {\n74\t  // 1. Eligibility gate\n75\t  if (!coupon.isActive) return { discount: 0, reason: \"INACTIVE\" };\n76\t\n77\t  const now = new Date();\n78\t  if (coupon.validFrom != null && now < coupon.validFrom) {\n79\t    return { discount: 0, reason: \"NOT_STARTED\" };\n80\t  }\n81\t  if (coupon.validTo != null && now > coupon.validTo) {\n82\t    return { discount: 0, reason: \"EXPIRED\" };\n83\t  }\n84\t  if (coupon.maxUses != null && coupon.usesCount >= coupon.maxUses) {\n85\t    return { discount: 0, reason: \"MAX_USES\" };\n86\t  }\n87\t  if (coupon.minOrderAmt != null && couponBase < coupon.minOrderAmt) {\n88\t    return { discount: 0, reason: \"MIN_ORDER_AMT\" };\n89\t  }\n90\t\n91\t  // 2. Raw discount (in integer paise — no float drift)\n92\t  const couponBaseP = toPaise(couponBase);\n93\t  const rawDiscountP =\n94\t    coupon.discountType === \"PERCENTAGE\"\n95\t      ? Math.round(couponBaseP * ((coupon.discountPct ?? 0) / 100))\n96\t      : toPaise(coupon.discountAmt ?? 0);\n97\t\n98\t  // 3. maxDiscount cap, then clamp to couponBase\n99\t  const cappedP =\n100\t    coupon.maxDiscount != null\n101\t      ? Math.min(rawDiscountP, toPaise(coupon.maxDiscount))\n102\t      : rawDiscountP;\n103\t  const discountP = Math.min(cappedP, couponBaseP); // never negative\n104\t\n105\t  return { discount: fromPaise(discountP) };\n106\t}\n107\t\n108\t// ---------------------------------------------------------------------------\n109\t// distributeCoupon\n110\t// ---------------------------------------------------------------------------\n111\t\n112\t/**\n113\t * Distribute an order-level coupon discount proportionally across booking lines.\n114\t *\n115\t * Output: `shares[i]` is the **line-total** coupon for line i (not per-seat).\n116\t * Caller: `couponSharePerSeat = shares[i] / lines[i].qty`\n117\t *         `netFace = round2(lines[i].seatFace - couponSharePerSeat)`\n118\t *\n119\t * Residual guard: the last line absorbs any ±0.01 rounding delta so\n120\t * `Σ shares == discount` exactly.\n121\t *\n122\t * @param lines     Booking lines with seatFace + qty.\n123\t * @param discount  Total order-level discount to distribute (from computeCouponDiscount).\n124\t */\n125\texport function distributeCoupon(\n126\t  lines: CouponPricingLine[],\n127\t  discount: number,\n128\t): number[] {\n129\t  if (discount === 0 || lines.length === 0) {\n130\t    return lines.map(() => 0);\n131\t  }\n132\t\n133\t  // Work entirely in integer paise so Σ shares == discount EXACTLY.\n134\t  const discountP = toPaise(discount);\n135\t  const lineBaseP = lines.map((l) => toPaise(l.seatFace) * l.qty);\n136\t  const totalBaseP = lineBaseP.reduce((s, b) => s + b, 0);\n137\t  if (totalBaseP === 0) {\n138\t    return lines.map(() => 0);\n139\t  }\n140\t\n141\t  const sharesP: number[] = [];\n142\t  let distributedP = 0;\n143\t\n144\t  for (let i = 0; i < lines.length; i++) {\n145\t    if (i === lines.length - 1) {\n146\t      // Last line: residual guard so Σ shares == discount exactly.\n147\t      sharesP.push(discountP - distributedP);\n148\t    } else {\n149\t      const shareP = Math.round((lineBaseP[i] * discountP) / totalBaseP);\n150\t      sharesP.push(shareP);\n151\t      distributedP += shareP;\n152\t    }\n153\t  }\n154\t\n155\t  return sharesP.map(fromPaise);\n156\t}\n157\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"185bab56-e630-40a6-bee2-fdabbafa442e","timestamp":"2026-11-20T17:34:59.212Z","tool_result_meta":[{"id":"call_01a1fa06923b703898a1a74d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
