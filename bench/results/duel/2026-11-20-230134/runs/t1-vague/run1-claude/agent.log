\", {\n      eventId,\n      category: event?.eventCategory,\n      title: event?.title,\n    });\n    setBookingOpen(true);\n  };\n\n  // Resume an approved (APPROVED_AWAITING_PAYMENT) booking directly at the\n  // payment step — same flow as the email-link claim, but triggered from the\n  // event page when the user already has an approved booking.\n  const handleCompleteApprovedBooking = () => {\n    if (previewMode || !myApprovedBooking || isBookingBlocked) return;\n    dispatch(\n      bookingActions.startBooking({\n        eventId,\n        isAuthenticated,\n        mode: bookingMode,\n        autoSelectTicketTypeId,\n      }),\n    );\n    dispatch(bookingActions.setBookingId(myApprovedBooking.bookingId));\n    dispatch(bookingActions.setStep(5));\n    setBookingOpen(true);\n  };\n\n  const handleLike = async () => {\n    if (previewMode || isHydrating) return;\n    if (!viewerSocialStatsReady) {\n      // Ignore the tap rather than guess: acting now would send \"like\" for an\n      // event the viewer may already like. Nudge the request so the next tap\n      // lands, and only refetch when nothing is already in flight.\n      if (!isFetchingSocialStats) refetchSocialStats();\n      return;\n    }\n    if (!isAuthenticated) {\n      router.push(\"/auth\");\n      return;\n    }\n    setLikePulse((n) => n + 1);\n    const next = !liked;\n    setLikedOverride(next);\n    try {\n      if (next) await likeEvent(eventId).unwrap();\n      else await unlikeEvent(eventId).unwrap();\n    } catch {\n      setLikedOverride(!next);\n    }\n  };\n\n  const handleBookmark = async () => {\n    if (previewMode || isHydrating) return;\n    if (!viewerSocialStatsReady) {\n      if (!isFetchingSocialStats) refetchSocialStats();\n      return;\n    }\n    if (!isAuthenticated) {\n      router.push(\"/auth\");\n      return;","numLines":80,"startLine":940,"totalLines":1930}},"tool_result_meta":[{"id":"call-2e642770-c423-43a3-b4ae-d4b4baeb2002","permission_decision":{"decision":