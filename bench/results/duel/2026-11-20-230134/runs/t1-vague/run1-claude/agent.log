{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa0c51df70d3a92c4970","type":"tool_result","content":"1\t/**\n2\t * Custom error classes for consistent error handling across the application\n3\t */\n4\t\n5\texport class AppError extends Error {\n6\t  public readonly statusCode: number;\n7\t  public readonly isOperational: boolean;\n8\t\n9\t  constructor(\n10\t    message: string,\n11\t    statusCode: number = 500,\n12\t    isOperational: boolean = true,\n13\t  ) {\n14\t    super(message);\n15\t    this.statusCode = statusCode;\n16\t    this.isOperational = isOperational;\n17\t\n18\t    // Maintains proper stack trace for where our error was thrown\n19\t    Error.captureStackTrace(this, this.constructor);\n20\t\n21\t    // Set the prototype explicitly to maintain instanceof checks\n22\t    Object.setPrototypeOf(this, AppError.prototype);\n23\t  }\n24\t}\n25\t\n26\texport class ValidationError extends AppError {\n27\t  constructor(message: string = \"Validation failed\") {\n28\t    super(message, 400);\n29\t    Object.setPrototypeOf(this, ValidationError.prototype);\n30\t  }\n31\t}\n32\t\n33\texport class NotFoundError extends AppError {\n34\t  constructor(message: string = \"Resource not found\") {\n35\t    super(message, 404);\n36\t    Object.setPrototypeOf(this, NotFoundError.prototype);\n37\t  }\n38\t}\n39\t\n40\texport class UnauthorizedError extends AppError {\n41\t  constructor(message: string = \"Unauthorized access\") {\n42\t    super(message, 401);\n43\t    Object.setPrototypeOf(this, UnauthorizedError.prototype);\n44\t  }\n45\t}\n46\t\n47\texport class ForbiddenError extends AppError {\n48\t  constructor(message: string = \"Access forbidden\") {\n49\t    super(message, 403);\n50\t    Object.setPrototypeOf(this, ForbiddenError.prototype);\n51\t  }\n52\t}\n53\t\n54\texport class ConflictError extends AppError {\n55\t  constructor(message: string = \"Resource conflict\") {\n56\t    super(message, 409);\n57\t    Object.setPrototypeOf(this, ConflictError.prototype);\n58\t  }\n59\t}\n60\t\n61\texport class BadRequestError extends AppError {\n62\t  constructor(message: string = \"Bad request\") {\n63\t    super(message, 400);\n64\t    Object.setPrototypeOf(this, BadRequestError.prototype);\n65\t  }\n66\t}\n67\t\n68\texport class TooManyRequestsError extends AppError {\n69\t  constructor(message: string = \"Too many requests\") {\n70\t    super(message, 429);\n71\t    Object.setPrototypeOf(this, TooManyRequestsError.prototype);\n72\t  }\n73\t}\n74\t\n75\texport class ServiceUnavailableError extends AppError {\n76\t  constructor(message: string = \"Service temporarily unavailable\") {\n77\t    super(message, 503);\n78\t    Object.setPrototypeOf(this, ServiceUnavailableError.prototype);\n79\t  }\n80\t}\n81\t\n82\texport class DatabaseError extends AppError {\n83\t  constructor(message: string = \"Database operation failed\") {\n84\t    super(message, 500, false); // Not operational - indicates system issue\n85\t    Object.setPrototypeOf(this, DatabaseError.prototype);\n86\t  }\n87\t}\n88\t\n89\texport class ExternalServiceError extends AppError {\n90\t  constructor(\n91\t    message: string = \"External service error\",\n92\t    statusCode: number = 502,\n93\t  ) {\n94\t    super(message, statusCode);\n95\t    Object.setPrototypeOf(this, ExternalServiceError.prototype);\n96\t  }\n97\t}\n98\t\n99\texport class TimeoutError extends AppError {\n100\t  constructor(message: string = \"Request timed out\") {\n101\t    super(message, 408);\n102\t    Object.setPrototypeOf(this, TimeoutError.prototype);\n103\t  }\n104\t}\n105\t\n106\t/**\n107\t * Type guard to check if error is an AppError\n108\t */\n109\texport const isAppError = (error: any): error is AppError => {\n110\t  return error instanceof AppError;\n111\t};\n112\t\n113\t/**\n114\t * Type guard to check if error is operational\n115\t */\n116\texport const isOperationalError = (error: any): boolean => {\n117\t  if (isAppError(error)) {\n118\t    return error.isOperational;\n119\t  }\n120\t  return false;\n121\t};\n122\t\n123\texport class SlotConflictError extends AppError {\n124\t  constructor(message: string = \"Slot is no longer available\") {\n125\t    super(message, 409);\n126\t    Object.setPrototypeOf(this, SlotConflictError.prototype);\n127\t  }\n128\t}\n129\t\n130\texport class SlotLockedError extends AppError {\n131\t  constructor(message: string = \"Slot is held by another user\") {\n132\t    super(message, 409);\n133\t    Object.setPrototypeOf(this, SlotLockedError.prototype);\n134\t  }\n135\t}\n136\t\n137\texport class InvalidSlotRangeError extends AppError {\n138\t  constructor(message: string = \"Invalid slot selection\") {\n139\t    super(message, 400);\n140\t    Object.setPrototypeOf(this, InvalidSlotRangeError.prototype);\n141\t  }\n142\t}\n143\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"29544f01-420e-4083-bd3a-3664d18824e7","timestamp":"2026-11-20T17:41:15.705Z","tool_result_meta":[{"id":"call_01a1fa0c51df70d3a92c4970","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
