{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa075aac77f39a0c309d","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport logger from \"../../config/logger\";\n3\timport { DEFAULT_WEB_BASE_URL } from \"../../constants/public-urls\";\n4\timport { delTicketTypeCache } from \"../../lib/cache/ticket\";\n5\timport type { BookingRepository } from \"../../repositories/booking.repository\";\n6\timport type { ListerRepository } from \"../../repositories/lister.repository\";\n7\timport type { UserRepository } from \"../../repositories/user.repository\";\n8\timport { emailCircuitBreaker } from \"../../utils/circuit-breaker.util\";\n9\timport { ConflictError, ValidationError } from \"../../utils/errors.util\";\n10\timport { emailService } from \"../email.service\";\n11\timport { uploadService } from \"../upload.service\";\n12\timport type { BookingLifecycleService } from \"./booking-lifecycle.service\";\n13\timport type { BookingPricingService } from \"./booking-pricing.service\";\n14\timport type { BookingDetails, CreateBookingDto } from \"./types\";\n15\t\n16\t// Approval-request inventory hold: kept generous so the seat doesn't slip\n17\t// out from under the buyer while the host is deciding. Hosts (or the\n18\t// claim-expiry sweeper) release the hold via decline if they sit on it.\n19\tconst APPROVAL_REQUEST_HOLD_MS = 30 * 24 * 60 * 60 * 1000; // 30 days\n20\t\n21\texport class BookingApprovalService {\n22\t  constructor(\n23\t    private readonly bookingRepository: BookingRepository,\n24\t    private readonly listerRepository: ListerRepository,\n25\t    private readonly userRepository: UserRepository,\n26\t    private readonly pricingService: BookingPricingService,\n27\t    private readonly lifecycleService: BookingLifecycleService,\n28\t  ) {}\n29\t\n30\t  /**\n31\t   * Buyer-initiated approval request for an event with requiresApproval=true.\n32\t   *\n33\t   * Behaves like `create` (validates ticket types, prices the booking,\n34\t   * holds inventory atomically, persists custom-field answers) except:\n35\t   *  - Booking is persisted in PENDING_APPROVAL status with no payment record.\n36\t   *  - Inventory hold uses a long window so the seat can't be sold while the\n37\t   *    host is deciding; the standard 10-minute expiry job is NOT enqueued.\n38\t   *  - The host receives a notification email asking them to approve/decline\n39\t   *    via the existing Guests dashboard (PENDING_APPROVAL bookings surface\n40\t   *    there alongside invited guests).\n41\t   */\n42\t  async requestApproval(\n43\t    userId: string,\n44\t    dto: CreateBookingDto,\n45\t    requestId: string,\n46\t  ): Promise<BookingDetails> {\n47\t    this.pricingService.validateDtoShape(dto);\n48\t    uploadService.assertOwnUploads(userId, [\n49\t      ...dto.commonFieldResponses,\n50\t      ...dto.items.flatMap((i) => i.ticketFieldResponses.flat()),\n51\t    ]);\n52\t\n53\t    const event = await prisma.event.findUnique({\n54\t      where: { eventId: dto.eventId },\n55\t      select: {\n56\t        eventId: true,\n57\t        listerId: true,\n58\t        title: true,\n59\t        date: true,\n60\t        salesPaused: true,\n61\t\n62\t        waitlistUntil: true,\n63\t        ticketingEnabled: true,\n64\t        requiresApproval: true,\n65\t      },\n66\t    });\n67\t\n68\t    if (!event) throw new ValidationError(\"Event not found\");\n69\t    if (!event.requiresApproval) {\n70\t      throw new ValidationError(\"This event does not require approval\");\n71\t    }\n72\t\n73\t    if (event.salesPaused) {\n74\t      throw new ValidationError(\"Sales are currently paused for this event\");\n75\t    }\n76\t    if (event.ticketingEnabled && dto.items.length === 0) {\n77\t      throw new ValidationError(\n78\t        \"Approval request must include at least one ticket\",\n79\t      );\n80\t    }\n81\t\n82\t    // Block duplicate approval requests — buyer already has a live pending or\n83\t    // approved-awaiting-payment booking for this event.\n84\t    const existing =\n85\t      await this.bookingRepository.findActiveApprovalByUserAndEvent(\n86\t        userId,\n87\t        dto.eventId,\n88\t      );\n89\t    if (existing) {\n90\t      throw new ConflictError(\n91\t        existing.status === \"APPROVED_AWAITING_PAYMENT\"\n92\t          ? \"Your request was already approved — please complete your payment.\"\n93\t          : \"You already have a pending approval request for this event.\",\n94\t      );\n95\t    }\n96\t\n97\t    // Re-use the same validation+pricing pipeline so the snapshotted prices\n98\t    // on the booking match what the buyer will see at the payment step.\n99\t    const {\n100\t      subtotal,\n101\t      platformFee,\n102\t      gatewayFee,\n103\t      gst,\n104\t      total,\n105\t      feesBornBy,\n106\t      lines,\n107\t    } = await this.pricingService.validateAndPrice(dto);\n108\t\n109\t    const requestedAt = new Date();\n110\t    const holdExpiresAt = new Date(\n111\t      requestedAt.getTime() + APPROVAL_REQUEST_HOLD_MS,\n112\t    );\n113\t\n114\t    const bookingId = await this.bookingRepository.createWithHoldTx({\n115\t      userId,\n116\t      eventId: dto.eventId,\n117\t      subtotal,\n118\t      platformFee,\n119\t      gatewayFee,\n120\t      gst,\n121\t      feesBornBy,\n122\t      total,\n123\t      holdExpiresAt,\n124\t      commonFieldResponses: dto.commonFieldResponses,\n125\t      lines,\n126\t      referrer: dto.referrer,\n127\t      city: dto.city,\n128\t      state: dto.state,\n129\t      userAgent: dto.userAgent,\n130\t      approvalRequest: { requestedAt },\n131\t    });\n132\t\n133\t    await delTicketTypeCache(dto.eventId);\n134\t\n135\t    logger.info(\"Approval request created\", {\n136\t      bookingId,\n137\t      userId,\n138\t      eventId: dto.eventId,\n139\t      requestId,\n140\t    });\n141\t\n142\t    // Notify the host (best-effort; email failure does not invalidate the\n143\t    // request — host can still see it in the Guests dashboard).\n144\t    try {\n145\t      await this.notifyHostOfApprovalRequest({\n146\t        eventId: event.eventId,\n147\t        eventTitle: event.title ?? \"your event\",\n148\t        eventDate: event.date,\n149\t        listerId: event.listerId,\n150\t        bookingId,\n151\t      });\n152\t    } catch (err) {\n153\t      logger.error(\"Failed to notify host of approval request\", {\n154\t        bookingId,\n155\t        err: String(err),\n156\t      });\n157\t    }\n158\t\n159\t    return this.lifecycleService.getForOwner(userId, bookingId);\n160\t  }\n161\t\n162\t  /**\n163\t   * Validate an approval-claim token from the buyer's email link and return\n164\t   * the bookingId so the web client can resume at the payment step.\n165\t   *\n166\t   * Returns null if the token is unknown, expired, or the booking has left\n167\t   * APPROVED_AWAITING_PAYMENT (already paid, declined, or hold expired).\n168\t   */\n169\t  async resolveApprovalClaim(token: string) {\n170\t    const found = await this.bookingRepository.findByApprovalClaimToken(token);\n171\t    if (!found) return null;\n172\t    return {\n173\t      bookingId: found.bookingId,\n174\t      eventId: found.eventId,\n175\t      userId: found.userId,\n176\t      holdExpiresAt: found.holdExpiresAt,\n177\t    };\n178\t  }\n179\t\n180\t  /**\n181\t   * Return the most-recent APPROVED_AWAITING_PAYMENT booking owned by `userId`\n182\t   * for `eventId` whose hold has not expired — or null if none.\n183\t   * Used by the event page to surface a \"Complete your booking\" CTA without\n184\t   * requiring the email-link claim token.\n185\t   */\n186\t  async getMyApprovedBookingForEvent(userId: string, eventId: string) {\n187\t    return this.bookingRepository.findApprovedAwaitingPaymentByUserAndEvent(\n188\t      userId,\n189\t      eventId,\n190\t    );\n191\t  }\n192\t\n193\t  private async notifyHostOfApprovalRequest(input: {\n194\t    eventId: string;\n195\t    eventTitle: string;\n196\t    eventDate: Date | null;\n197\t    listerId: string;\n198\t    bookingId: string;\n199\t  }) {\n200\t    const lister = await this.listerRepository.findById(input.listerId);\n201\t    if (!lister?.userId) return;\n202\t\n203\t    const hostUser = await this.userRepository.findEmailAndNameByUserId(\n204\t      lister.userId,\n205\t    );\n206\t    if (!hostUser?.email) return;\n207\t    const hostEmail = hostUser.email;\n208\t\n209\t    const webBase = process.env.WEB_BASE_URL ?? DEFAULT_WEB_BASE_URL;\n210\t\n211\t    await emailCircuitBreaker.execute(async () => {\n212\t      await emailService.sendEmail({\n213\t        toEmail: hostEmail,\n214\t        name: hostUser.name ?? \"there\",\n215\t        payload: {\n216\t          type: \"guest-notification\",\n217\t          content: {\n218\t            userName: hostUser.name ?? \"there\",\n219\t            eventName: input.eventTitle,\n220\t            eventDate: input.eventDate?.toISOString() ?? \"\",\n221\t            message: `You have a new approval request for ${input.eventTitle}. Review and approve or decline from your dashboard.`,\n222\t            ctaText: \"Review request\",\n223\t            ctaUrl: `${webBase}/dashboard/events/${input.eventId}/audience`,\n224\t          },\n225\t        },\n226\t      });\n227\t    });\n228\t  }\n229\t}\n230\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"9e8512d0-dd64-421e-af48-701e89e031cf","timestamp":"2026-11-20T17:35:49.678Z","tool_result_meta":[{"id":"call_01a1fa075aac77f39a0c309d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
{"type":"assistant","message":{"id":"msg_edd3e5f2-14a5-4b95-b1c5-b2b36d5f2496","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"model":"MiniMaxAI/MiniMax-M3","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"e4f9bb81-c07d-4e17-be87-bf1a5e451f59","timestamp":"2026-11-20T17:35:49.966Z","thinking_duration_ms":3604,"thinking_display":"updates"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa075c3f773cb3962e4b","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport { BookingStatus } from \"../../generated/prisma/enums\";\n3\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n4\timport { NotFoundError } from \"../../utils/errors.util\";\n5\t\n6\texport class BookingQueryRepository {\n7\t  /**\n8\t   * Find a booking by ID with full detail includes.\n9\t   * Throws NotFoundError if missing.\n10\t   */\n11\t  async findByIdWithDetails(bookingId: string) {\n12\t    const booking = await wrapDatabaseOperation(async () => {\n13\t      return prisma.booking.findUnique({\n14\t        where: { bookingId },\n15\t        include: {\n16\t          tickets: {\n17\t            include: {\n18\t              ticketType: true,\n19\t              AttendeeFieldResponse: true,\n20\t            },\n21\t          },\n22\t          discountCode: true,\n23\t          payment: true,\n24\t          event: {\n25\t            select: {\n26\t              eventId: true,\n27\t              listerId: true,\n28\t              title: true,\n29\t              date: true,\n30\t              time: true,\n31\t              location: true,\n32\t              venueDetails: true,\n33\t              postEventLink: true,\n34\t              postEventTitle: true,\n35\t              postEventMessage: true,\n36\t              eventType: true,\n37\t              ticketingEnabled: true,\n38\t              meetingProvider: true,\n39\t              externalMeetingId: true,\n40\t              gmeetLink: true,\n41\t              zoomLink: true,\n42\t              banner_horizontal: true,\n43\t              banner_vertical: true,\n44\t              banner_square: true,\n45\t              thumbnail: true,\n46\t              lister: {\n47\t                select: { companyName: true, companyLogo: true, avatar: true },\n48\t              },\n49\t            },\n50\t          },\n51\t        },\n52\t      });\n53\t    }, \"Find booking by ID with details\");\n54\t\n55\t    if (!booking) {\n56\t      throw new NotFoundError(\"Booking not found\");\n57\t    }\n58\t\n59\t    return booking;\n60\t  }\n61\t\n62\t  /**\n63\t   * Find booking OG data by ID (public — no sensitive fields)\n64\t   */\n65\t  async findOGDataById(bookingId: string) {\n66\t    return wrapDatabaseOperation(async () => {\n67\t      return await prisma.booking.findUnique({\n68\t        where: { bookingId },\n69\t        select: {\n70\t          tickets: {\n71\t            select: {\n72\t              ticketType: {\n73\t                select: { name: true },\n74\t              },\n75\t            },\n76\t            take: 1,\n77\t          },\n78\t          event: {\n79\t            select: {\n80\t              eventId: true,\n81\t              title: true,\n82\t              date: true,\n83\t              banner_horizontal: true,\n84\t              banner_vertical: true,\n85\t              banner_square: true,\n86\t              thumbnail: true,\n87\t            },\n88\t          },\n89\t        },\n90\t      });\n91\t    }, \"Find booking OG data by ID\");\n92\t  }\n93\t\n94\t  /**\n95\t   * Find confirmed (PAID) bookings for a user, one booking per purchase.\n96\t   * Used for the \"my tickets\" list view — callers get booking-level QR codes.\n97\t   * HELD (unpaid) bookings are excluded; they are never surfaced to the user\n98\t   * until payment completes.\n99\t   */\n100\t  async findByUserIdPaginated(userId: string, page = 1, limit = 20) {\n101\t    return wrapDatabaseOperation(async () => {\n102\t      const skip = (page - 1) * limit;\n103\t      const where = {\n104\t        userId,\n105\t        status: BookingStatus.PAID,\n106\t      };\n107\t\n108\t      const [bookings, total] = await Promise.all([\n109\t        prisma.booking.findMany({\n110\t          where,\n111\t          orderBy: { createdAt: \"desc\" },\n112\t          skip,\n113\t          take: limit,\n114\t          select: {\n115\t            bookingId: true,\n116\t            qrCode: true,\n117\t            status: true,\n118\t            total: true,\n119\t            createdAt: true,\n120\t            tickets: {\n121\t              // List view only consumes aggregates (sum of quantities, every-checkedIn,\n122\t              // all-refunded) plus the primary ticket type.\n123\t              select: {\n124\t                quantity: true,\n125\t                checkedIn: true,\n126\t                status: true,\n127\t                ticketType: {\n128\t                  select: { name: true, price: true },\n129\t                },\n130\t              },\n131\t            },\n132\t            event: {\n133\t              select: {\n134\t                eventId: true,\n135\t                title: true,\n136\t                date: true,\n137\t                location: true,\n138\t                // List view only renders a small square image — drop the\n139\t                // horizontal + vertical banners which the card never shows.\n140\t                banner_square: true,\n141\t                thumbnail: true,\n142\t                lister: {\n143\t                  select: { companyName: true, companyLogo: true, avatar: true },\n144\t                },\n145\t              },\n146\t            },\n147\t          },\n148\t        }),\n149\t        prisma.booking.count({ where }),\n150\t      ]);\n151\t\n152\t      return {\n153\t        items: bookings,\n154\t        total,\n155\t        page,\n156\t        limit,\n157\t        totalPages: Math.ceil(total / limit),\n158\t      };\n159\t    }, \"Find bookings by user ID paginated\");\n160\t  }\n161\t\n162\t  /**\n163\t   * Same shape as findByUserIdPaginated but scoped to one event — for\n164\t   * \"does this user already have a ticket for this event\" lookups that\n165\t   * don't need the full cross-event paginated list. A user has at most a\n166\t   * handful of bookings per event, so no pagination needed (take is a\n167\t   * defensive cap, not a real limit).\n168\t   */\n169\t  async findByUserIdAndEventId(userId: string, eventId: string) {\n170\t    return wrapDatabaseOperation(async () => {\n171\t      const where = { userId, eventId, status: BookingStatus.PAID };\n172\t\n173\t      const bookings = await prisma.booking.findMany({\n174\t        where,\n175\t        orderBy: { createdAt: \"desc\" },\n176\t        take: 20,\n177\t        select: {\n178\t          bookingId: true,\n179\t          qrCode: true,\n180\t          status: true,\n181\t          total: true,\n182\t          createdAt: true,\n183\t          tickets: {\n184\t            select: {\n185\t              quantity: true,\n186\t              checkedIn: true,\n187\t              status: true,\n188\t              ticketType: {\n189\t                select: { name: true, price: true },\n190\t              },\n191\t            },\n192\t          },\n193\t          event: {\n194\t            select: {\n195\t              eventId: true,\n196\t              title: true,\n197\t              date: true,\n198\t              location: true,\n199\t              banner_square: true,\n200\t              thumbnail: true,\n201\t              lister: {\n202\t                select: { companyName: true, companyLogo: true, avatar: true },\n203\t              },\n204\t            },\n205\t          },\n206\t        },\n207\t      });\n208\t\n209\t      return bookings;\n210\t    }, \"Find bookings by user ID and event ID\");\n211\t  }\n212\t\n213\t  /**\n214\t   * The booking that belongs to a checkout session, if there is one.\n215\t   *\n216\t   * A session's own `bookingId` column can be empty even though the booking\n217\t   * was already created — `bookings.create` persists the row first and only\n218\t   * then does work that can throw (cache invalidation), and the session is\n219\t   * updated afterwards. This lookup is the durable truth: the booking row\n220\t   * stores its `checkoutSessionId`, so the link survives every failure point.\n221\t   */\n222\t  async findByCheckoutSessionId(checkoutSessionId: string) {\n223\t    return wrapDatabaseOperation(async () => {\n224\t      return await prisma.booking.findFirst({\n225\t        where: { checkoutSessionId },\n226\t        orderBy: { createdAt: \"desc\" },\n227\t        select: { bookingId: true, userId: true, status: true },\n228\t      });\n229\t    }, \"Find booking by checkout session ID\");\n230\t  }\n231\t\n232\t  /**\n233\t   * Lightweight booking status lookup — used by team payment retry to verify\n234\t   * the existing booking is still in HELD state before reusing it.\n235\t   */\n236\t  async findUserAndEventById(\n237\t    bookingId: string,\n238\t  ): Promise<{ userId: string; eventId: string } | null> {\n239\t    return wrapDatabaseOperation(async () => {\n240\t      return await prisma.booking.findUnique({\n241\t        where: { bookingId },\n242\t        select: { userId: true, eventId: true },\n243\t      });\n244\t    }, \"Find booking user and event by ID\");\n245\t  }\n246\t\n247\t  async findStatusById(\n248\t    bookingId: string,\n249\t  ): Promise<{ status: string; total: number } | null> {\n250\t    return wrapDatabaseOperation(async () => {\n251\t      return await prisma.booking.findUnique({\n252\t        where: { bookingId },\n253\t        select: { status: true, total: true },\n254\t      });\n255\t    }, \"Find booking status by ID\");\n256\t  }\n257\t\n258\t  /**\n259\t   * Find expired HELD bookings (for the expiry worker).\n260\t   * Returns up to `limit` bookings ordered by holdExpiresAt ascending.\n261\t   */\n262\t  async findExpiredHolds(limit = 100): Promise<Array<{ bookingId: string }>> {\n263\t    return wrapDatabaseOperation(async () => {\n264\t      return await prisma.booking.findMany({\n265\t        where: {\n266\t          status: {\n267\t            in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n268\t          },\n269\t          holdExpiresAt: { lt: new Date() },\n270\t        },\n271\t        orderBy: { holdExpiresAt: \"asc\" },\n272\t        take: Math.min(limit, 1000),\n273\t        select: { bookingId: true },\n274\t      });\n275\t    }, \"Find expired holds\");\n276\t  }\n277\t}\n278\t"}]},"parent_tool_use_id":"call-7804811d-daa0-4a1c-876c-2bdfd4a643ad","agent_id":"a6f93236d4c734935","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"9baf0f19-847b-4dcb-9c97-0c4a1fc76dbd","timestamp":"2026-11-20T17:35:50.136Z","tool_result_meta":[{"id":"call_01a1fa075c3f773cb3962e4b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit server booking service"}
