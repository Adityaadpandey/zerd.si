{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a1fa06598f7038b0a97668","type":"tool_result","content":"2550\t            <span className=\"text-h4 font-semibold text-white/80 tracking-[-0.02em]\">\n2551\t              Back to review\n2552\t            </span>\n2553\t          </button>\n2554\t        </div>\n2555\t      )}\n2556\t\n2557\t      <p className=\"text-caption text-white/32 max-w-[280px] leading-[1.5]\">\n2558\t        Complete payment before the timer runs out to confirm your booking.\n2559\t      </p>\n2560\t    </div>\n2561\t  );\n2562\t}\n2563\t\n2564\t// ─── SlotAuthStep ─────────────────────────────────────────────────────────────\n2565\t\n2566\tconst OTP_LENGTH_SLOT = 4;\n2567\tconst RESEND_COOLDOWN_SLOT = 90;\n2568\tconst GOOGLE_CLIENT_ID_SLOT = process.env.NEXT_PUBLIC_GOOGLE_CLIENT_ID ?? \"\";\n2569\t\n2570\tfunction extractAuthError(body: {\n2571\t  error?: { message?: string };\n2572\t  message?: string;\n2573\t}) {\n2574\t  return (\n2575\t    body?.error?.message ??\n2576\t    body?.message ??\n2577\t    \"Authentication failed. Please try again.\"\n2578\t  );\n2579\t}\n2580\t\n2581\t// Isolated so the once-a-second tick only re-renders this small label —\n2582\t// not the whole auth step (name/phone/email form, OTP boxes, Google button).\n2583\tfunction ResendTimer({\n2584\t  availableAt,\n2585\t  onExpire,\n2586\t}: {\n2587\t  availableAt: number;\n2588\t  onExpire: () => void;\n2589\t}) {\n2590\t  const [remaining, setRemaining] = useState(() =>\n2591\t    Math.max(0, Math.ceil((availableAt - Date.now()) / 1000)),\n2592\t  );\n2593\t  const expiredRef = useRef(false);\n2594\t  // Read latest onExpire via a ref so an unstable parent callback doesn't\n2595\t  // tear down and restart the interval on every parent render.\n2596\t  const onExpireRef = useRef(onExpire);\n2597\t  useEffect(() => {\n2598\t    onExpireRef.current = onExpire;\n2599\t  }, [onExpire]);\n2600\t\n2601\t  useEffect(() => {\n2602\t    expiredRef.current = false;\n2603\t    setRemaining(Math.max(0, Math.ceil((availableAt - Date.now()) / 1000)));\n2604\t\n2605\t    const id = setInterval(() => {\n2606\t      const secs = Math.max(0, Math.ceil((availableAt - Date.now()) / 1000));\n2607\t      setRemaining(secs);\n2608\t\n2609\t      if (secs <= 0 && !expiredRef.current) {\n2610\t        expiredRef.current = true;\n2611\t        onExpireRef.current();\n2612\t        clearInterval(id);\n2613\t      }\n2614\t    }, 1000);\n2615\t\n2616\t    return () => clearInterval(id);\n2617\t  }, [availableAt]);\n2618\t\n2619\t  if (remaining <= 0) return null;\n2620\t\n2621\t  return (\n2622\t    <span className=\"text-p3 font-medium text-white/64\">\n2623\t      Resend in {remaining}s\n2624\t    </span>\n2625\t  );\n2626\t}\n2627\t\n2628\tfunction SlotAuthStep({ onAuthenticated }: { onAuthenticated: () => void }) {\n2629\t  const dispatch = useAppDispatch();\n2630\t  const isAuthenticated = useAppSelector((s) => s.auth.isAuthenticated);\n2631\t  const [completeProfile] = useCompleteProfileMutation();\n2632\t\n2633\t  type SlotAuthUIState = \"IDLE\" | \"OTP_SENT\";\n2634\t  const [uiState, setUiState] = useState<SlotAuthUIState>(\"IDLE\");\n2635\t  const [name, setName] = useState(\"\");\n2636\t  const [phone, setPhone] = useState(\"\");\n2637\t  const [email, setEmail] = useState(\"\");\n2638\t  const [otp, setOtp] = useState<string[]>(Array(OTP_LENGTH_SLOT).fill(\"\"));\n2639\t  const [resendAvailableAt, setResendAvailableAt] = useState<number | null>(\n2640\t    null,\n2641\t  );\n2642\t  const [sendLoading, setSendLoading] = useState(false);\n2643\t  const [verifyLoading, setVerifyLoading] = useState(false);\n2644\t  const [googleLoading, setGoogleLoading] = useState(false);\n2645\t  const [gisReady, setGisReady] = useState(false);\n2646\t  const [formError, setFormError] = useState(\"\");\n2647\t  const [otpError, setOtpError] = useState(\"\");\n2648\t  const [googleError, setGoogleError] = useState(\"\");\n2649\t  const otpRefs = useRef<(HTMLInputElement | null)[]>([]);\n2650\t  const pendingGoogleAdvance = useRef(false);\n2651\t\n2652\t  const isValidEmail = (s: string) => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(s);\n2653\t  const isValidPhone = (s: string) => /^[0-9]{10}$/.test(s);\n2654\t\n2655\t  const formValid =\n2656\t    name.trim().length > 0 && isValidPhone(phone) && isValidEmail(email.trim());\n2657\t  const otpComplete = otp.join(\"\").length === OTP_LENGTH_SLOT;\n2658\t\n2659\t  // Seed the CSRF cookie on mount so OTP endpoints accept requests.\n2660\t  useEffect(() => {\n2661\t    ensureCsrfToken();\n2662\t  }, []);\n2663\t\n2664\t  // Watch for Google-triggered auth\n2665\t  useEffect(() => {\n2666\t    if (isAuthenticated && pendingGoogleAdvance.current) {\n2667\t      pendingGoogleAdvance.current = false;\n2668\t      onAuthenticated();\n2669\t    }\n2670\t  }, [isAuthenticated, onAuthenticated]);\n2671\t\n2672\t  // GIS init\n2673\t  const gisInitedRef = useRef(false);\n2674\t  useEffect(() => {\n2675\t    if (!gisReady || !GOOGLE_CLIENT_ID_SLOT) return;\n2676\t    if (gisInitedRef.current) return;\n2677\t    gisInitedRef.current = true;\n2678\t    // @ts-expect-error — google is loaded via GIS script at runtime\n2679\t    const google = window.google;\n2680\t    google.accounts.id.initialize({\n2681\t      client_id: GOOGLE_CLIENT_ID_SLOT,\n2682\t      callback: async (response: { credential: string }) => {\n2683\t        setGoogleLoading(true);\n2684\t        setGoogleError(\"\");\n2685\t        try {\n2686\t          const res = await fetch(\"/api/auth/google\", {\n2687\t            method: \"POST\",\n2688\t            headers: { \"Content-Type\": \"application/json\" },\n2689\t            body: JSON.stringify({ idToken: response.credential }),\n2690\t          });\n2691\t          const data = await res.json();\n2692\t          if (!res.ok) {\n2693\t            setGoogleError(extractAuthError(data));\n2694\t            return;\n2695\t          }\n2696\t          if (data.user?.name) setName(data.user.name);\n2697\t          if (data.user?.email) setEmail(data.user.email);\n2698\t          if (data.user?.phone) setPhone(data.user.phone.replace(/^\\+91/, \"\"));\n2699\t          pendingGoogleAdvance.current = true;\n2700\t          dispatch(setAuth({ token: data.token, user: data.user }));\n2701\t          // Stitch pre-auth anonymous browsing to the now-known userId\n2702\t          if (data.user?.userId) activityTracker.stitch(data.user.userId);\n2703\t        } catch {\n2704\t          setGoogleError(\"Google authentication failed. Try again.\");\n2705\t        } finally {\n2706\t          setGoogleLoading(false);\n2707\t        }\n2708\t      },\n2709\t      cancel_on_tap_outside: true,\n2710\t    });\n2711\t    const overlay = document.getElementById(\"slot-google-btn-overlay\");\n2712\t    if (!overlay) return;\n2713\t    google.accounts.id.renderButton(overlay, {\n2714\t      theme: \"filled_black\",\n2715\t      size: \"large\",\n2716\t      width: overlay.clientWidth || 320,\n2717\t    });\n2718\t  }, [gisReady, dispatch]);\n2719\t\n2720\t  const handleSubmitDetails = async () => {\n2721\t    setFormError(\"\");\n2722\t    if (!name.trim()) {\n2723\t      setFormError(\"Please enter your full name\");\n2724\t      return;\n2725\t    }\n2726\t    if (!isValidPhone(phone)) {\n2727\t      setFormError(\"Enter a valid 10-digit phone number\");\n2728\t      return;\n2729\t    }\n2730\t    if (!isValidEmail(email.trim())) {\n2731\t      setFormError(\"Enter a valid email address\");\n2732\t      return;\n2733\t    }\n2734\t    setSendLoading(true);\n2735\t    try {\n2736\t      await ensureCsrfToken();\n2737\t      const res = await fetch(\"/api/auth/otp/request\", {\n2738\t        method: \"POST\",\n2739\t        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n2740\t        body: JSON.stringify({ identifier: email.trim() }),\n2741\t      });\n2742\t      const data = await res.json();\n2743\t      if (!res.ok) {\n2744\t        setFormError(extractAuthError(data));\n2745\t        return;\n2746\t      }\n2747\t      dispatch(setOtpIdentifier(email.trim()));\n2748\t      setResendAvailableAt(Date.now() + RESEND_COOLDOWN_SLOT * 1000);\n2749\t      setOtp(Array(OTP_LENGTH_SLOT).fill(\"\"));\n2750\t      setUiState(\"OTP_SENT\");\n2751\t      setTimeout(() => otpRefs.current[0]?.focus(), 300);\n2752\t    } catch {\n2753\t      setFormError(\"Failed to send OTP. Try again.\");\n2754\t    } finally {\n2755\t      setSendLoading(false);\n2756\t    }\n2757\t  };\n2758\t\n2759\t  const handleVerifyOtp = async () => {\n2760\t    setOtpError(\"\");\n2761\t    const code = otp.join(\"\");\n2762\t    if (code.length !== OTP_LENGTH_SLOT) {\n2763\t      setOtpError(`Enter the ${OTP_LENGTH_SLOT}-digit code`);\n2764\t      return;\n2765\t    }\n2766\t    setVerifyLoading(true);\n2767\t    try {\n2768\t      const res = await fetch(\"/api/auth/otp/verify\", {\n2769\t        method: \"POST\",\n2770\t        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n2771\t        body: JSON.stringify({ identifier: email.trim(), otp: code }),\n2772\t      });\n2773\t      const data = await res.json();\n2774\t      if (!res.ok) {\n2775\t        setOtpError(extractAuthError(data));\n2776\t        setOtp(Array(OTP_LENGTH_SLOT).fill(\"\"));\n2777\t        otpRefs.current[0]?.focus();\n2778\t        return;\n2779\t      }\n2780\t      // Explicitly write the CSRF cookie from the response body so it is\n2781\t      // guaranteed to be in document.cookie before the next CSRF-protected\n2782\t      // request, regardless of any browser Set-Cookie timing edge cases.\n2783\t      if (data.csrfToken) {\n2784\t        setCsrfCookie(data.csrfToken);\n2785\t      }\n2786\t      dispatch(setAuth({ token: data.token, user: data.user }));\n2787\t      // Stitch pre-auth anonymous browsing to the now-known userId\n2788\t      if (data.user?.userId) activityTracker.stitch(data.user.userId);\n2789\t      if (!data.user.profileComplete) {\n2790\t        try {\n2791\t          await completeProfile({\n2792\t            name: name.trim(),\n2793\t            phone: `+91${phone}`,\n2794\t          }).unwrap();\n2795\t        } catch {\n2796\t          // non-fatal\n2797\t        }\n2798\t      }\n2799\t      onAuthenticated();\n2800\t    } catch {\n2801\t      setOtpError(\"Invalid OTP. Try again.\");\n2802\t      setOtp(Array(OTP_LENGTH_SLOT).fill(\"\"));\n2803\t      otpRefs.current[0]?.focus();\n2804\t    } finally {\n2805\t      setVerifyLoading(false);\n2806\t    }\n2807\t  };\n2808\t\n2809\t  const handleResend = async () => {\n2810\t    if (resendAvailableAt && Date.now() < resendAvailableAt) return;\n2811\t    setOtpError(\"\");\n2812\t    setSendLoading(true);\n2813\t    try {\n2814\t      await ensureCsrfToken();\n2815\t      const res = await fetch(\"/api/auth/otp/request\", {\n2816\t        method: \"POST\",\n2817\t        headers: csrfHeaders({ \"Content-Type\": \"application/json\" }),\n2818\t        body: JSON.stringify({ identifier: email.trim() }),\n2819\t      });\n2820\t      if (res.ok) {\n2821\t        setResendAvailableAt(Date.now() + RESEND_COOLDOWN_SLOT * 1000);\n2822\t        setOtp(Array(OTP_LENGTH_SLOT).fill(\"\"));\n2823\t        setTimeout(() => otpRefs.current[0]?.focus(), 100);\n2824\t      } else {\n2825\t        const data = await res.json().catch(() => ({}));\n2826\t        setOtpError(extractAuthError(data));\n2827\t      }\n2828\t    } catch {\n2829\t      setOtpError(\"Failed to resend OTP. Try again.\");\n2830\t    } finally {\n2831\t      setSendLoading(false);\n2832\t    }\n2833\t  };\n2834\t\n2835\t  const handleOtpChange = (i: number, val: string) => {\n2836\t    if (!/^\\d*$/.test(val)) return;\n2837\t    const next = [...otp];\n2838\t    next[i] = val.slice(-1);\n2839\t    setOtp(next);\n2840\t    if (val && i < OTP_LENGTH_SLOT - 1) otpRefs.current[i + 1]?.focus();\n2841\t  };\n2842\t\n2843\t  const handleOtpKeyDown = (i: number, e: React.KeyboardEvent) => {\n2844\t    if (e.key === \"Backspace\" && !otp[i] && i > 0)\n2845\t      otpRefs.current[i - 1]?.focus();\n2846\t  };\n2847\t\n2848\t  const handleOtpPaste = (e: React.ClipboardEvent) => {\n2849\t    const pasted = e.clipboardData\n2850\t      .getData(\"text\")\n2851\t      .replace(/\\D/g, \"\")\n2852\t      .slice(0, OTP_LENGTH_SLOT);\n2853\t    if (!pasted) return;\n2854\t    e.preventDefault();\n2855\t    const next = [...otp];\n2856\t    for (let i = 0; i < pasted.length; i++) next[i] = pasted[i];\n2857\t    setOtp(next);\n2858\t    otpRefs.current[Math.min(pasted.length, OTP_LENGTH_SLOT - 1)]?.focus();\n2859\t  };\n2860\t\n2861\t  return (\n2862\t    <div className=\"flex flex-col gap-6\">\n2863\t      <Script\n2864\t        src=\"https://accounts.google.com/gsi/client\"\n2865\t        strategy=\"afterInteractive\"\n2866\t        onLoad={() => setGisReady(true)}\n2867\t      />\n2868\t\n2869\t      {/* Header */}\n2870\t      <div className=\"flex flex-col gap-1\">\n2871\t        <p className=\"text-h4 font-semibold text-white tracking-[-0.02em]\">\n2872\t          Sign in to continue\n2873\t        </p>\n2874\t        <p className=\"text-p2 text-white/48 tracking-[-0.02em]\">\n2875\t          We'll send an OTP to confirm your booking\n2876\t        </p>\n2877\t      </div>\n2878\t\n2879\t      {/* IDLE — details form */}\n2880\t      {uiState === \"IDLE\" && (\n2881\t        <div className=\"flex flex-col gap-5\">\n2882\t          <div className=\"flex flex-col gap-2\">\n2883\t            <p className=\"text-p4 text-white/64\">\n2884\t              Continue with{\" \"}\n2885\t              <span className=\"font-semibold\">Email OTP or Google</span>\n2886\t            </p>\n2887\t            <div className=\"flex gap-3 items-stretch\">\n2888\t              <button\n2889\t                type=\"button\"\n2890\t                onClick={() =>\n2891\t                  document.getElementById(\"slot-auth-email\")?.focus()\n2892\t                }\n2893\t                className=\"flex-1 flex items-center justify-center gap-2 h-[40px] px-3 rounded-xl bg-white/[0.08] border border-white/[0.04] text-h6 font-semibold text-white/84 tracking-[-0.24px] transition-opacity duration-200 ease-out active:opacity-70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\"\n2894\t              >\n2895\t                <PiEnvelopeDefaultStroke className=\"size-3 shrink-0\" />\n2896\t                Continue with Email\n2897\t              </button>\n2898\t              <div className=\"relative\">\n2899\t                <div\n2900\t                  className=\"flex items-center justify-center gap-2 pointer-events-none h-[40px] px-3 rounded-xl bg-white/[0.08] border border-white/[0.04] text-h6 font-semibold text-white/84 tracking-[-0.24px]\"\n2901\t                  style={{ opacity: googleLoading ? 0.6 : 1 }}\n2902\t                >\n2903\t                  {googleLoading ? (\n2904\t                    <div className=\"size-4 rounded-full border-2 border-white/20 border-t-white animate-spin\" />\n2905\t                  ) : (\n2906\t                    <svg\n2907\t                      width=\"16\"\n2908\t                      height=\"16\"\n2909\t                      viewBox=\"0 0 18 18\"\n2910\t                      fill=\"none\"\n2911\t                      aria-hidden=\"true\"\n2912\t                    >\n2913\t                      <path\n2914\t                        d=\"M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 01-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z\"\n2915\t                        fill=\"#4285F4\"\n2916\t                      />\n2917\t                      <path\n2918\t                        d=\"M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 009 18Z\"\n2919\t                        fill=\"#34A853\"\n2920\t                      />\n2921\t                      <path\n2922\t                        d=\"M3.964 10.71A5.41 5.41 0 013.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 000 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z\"\n2923\t                        fill=\"#FBBC05\"\n2924\t                      />\n2925\t                      <path\n2926\t                        d=\"M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 00.957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58Z\"\n2927\t                        fill=\"#EA4335\"\n2928\t                      />\n2929\t                    </svg>\n2930\t                  )}\n2931\t                  Auto fill with Google\n2932\t                </div>\n2933\t                <div\n2934\t                  id=\"slot-google-btn-overlay\"\n2935\t                  className=\"absolute inset-0 overflow-hidden\"\n2936\t                  style={{\n2937\t                    opacity: googleLoading ? 0 : 0.002,\n2938\t                    pointerEvents: googleLoading ? \"none\" : \"auto\",\n2939\t                  }}\n2940\t                />\n2941\t              </div>\n2942\t            </div>\n2943\t          </div>\n2944\t\n2945\t          <div className=\"flex flex-col gap-4\">\n2946\t            <div className=\"flex flex-col gap-2\">\n2947\t              <label\n2948\t                htmlFor=\"slot-auth-name\"\n2949\t                className=\"text-h6 font-medium text-white/64 tracking-[-0.24px] px-0.5\"\n2950\t              >\n2951\t                Full Name*\n2952\t              </label>\n2953\t              <input\n2954\t                id=\"slot-auth-name\"\n2955\t                type=\"text\"\n2956\t                autoComplete=\"name\"\n2957\t                value={name}\n2958\t                onChange={(e) => {\n2959\t                  setName(e.target.value);\n2960\t                  setFormError(\"\");\n2961\t                }}\n2962\t                placeholder=\"Your full name\"\n2963\t                className=\"h-[52px] px-4 w-full bg-white/[0.08] border border-white/[0.04] rounded-2xl text-h5 font-medium text-white placeholder:text-white/[0.32] focus:outline-none focus:border-white/[0.16] transition-colors duration-200 ease-out\"\n2964\t              />\n2965\t            </div>\n2966\t\n2967\t            <div className=\"flex flex-col gap-2\">\n2968\t              <label\n2969\t                htmlFor=\"slot-auth-phone\"\n2970\t                className=\"text-h6 font-medium text-white/64 tracking-[-0.24px] px-0.5\"\n2971\t              >\n2972\t                Mobile Number*\n2973\t              </label>\n2974\t              <div className=\"flex gap-2 items-start\">\n2975\t                <div className=\"h-[52px] px-3 rounded-2xl bg-white/[0.08] border border-white/[0.04] flex items-center shrink-0\">\n2976\t                  <span className=\"text-h5 font-medium text-white/64\">+91</span>\n2977\t                </div>\n2978\t                <input\n2979\t                  id=\"slot-auth-phone\"\n2980\t                  type=\"tel\"\n2981\t                  inputMode=\"numeric\"\n2982\t                  maxLength={10}\n2983\t                  value={phone}\n2984\t                  onChange={(e) => {\n2985\t                    setPhone(e.target.value.replace(/\\D/g, \"\"));\n2986\t                    setFormError(\"\");\n2987\t                  }}\n2988\t                  placeholder=\"10-digit number\"\n2989\t                  className=\"flex-1 h-[52px] px-4 min-w-0 bg-white/[0.08] border border-white/[0.04] rounded-2xl text-h5 font-medium text-white placeholder:text-white/[0.32] focus:outline-none focus:border-white/[0.16] transition-colors duration-200 ease-out\"\n2990\t                />\n2991\t              </div>\n2992\t            </div>\n2993\t\n2994\t            <div className=\"flex flex-col gap-2\">\n2995\t              <label\n2996\t                htmlFor=\"slot-auth-email\"\n2997\t                className=\"text-h6 font-medium text-white/64 tracking-[-0.24px] px-0.5\"\n2998\t              >\n2999\t                Email*\n3000\t              </label>\n3001\t              <input\n3002\t                id=\"slot-auth-email\"\n3003\t                type=\"email\"\n3004\t                inputMode=\"email\"\n3005\t                autoComplete=\"email\"\n3006\t                value={email}\n3007\t                onChange={(e) => {\n3008\t                  setEmail(e.target.value);\n3009\t                  setFormError(\"\");\n3010\t                }}\n3011\t                onKeyDown={(e) =>\n3012\t                  e.key === \"Enter\" && formValid && handleSubmitDetails()\n3013\t                }\n3014\t                placeholder=\"you@email.com\"\n3015\t                className=\"h-[52px] px-4 w-full bg-white/[0.08] border border-white/[0.04] rounded-2xl text-h5 font-medium text-white placeholder:text-white/[0.32] focus:outline-none focus:border-white/[0.16] transition-colors duration-200 ease-out\"\n3016\t              />\n3017\t              <p className=\"text-p4 font-medium text-white/40 px-0.5\">\n3018\t                OTP will be sent to this email\n3019\t              </p>\n3020\t            </div>\n3021\t          </div>\n3022\t\n3023\t          {(formError || googleError) && (\n3024\t            <p className=\"text-p3 text-red-400 font-medium\">\n3025\t              {formError || googleError}\n3026\t            </p>\n3027\t          )}\n3028\t\n3029\t          <button\n3030\t            type=\"button\"\n3031\t            disabled={sendLoading || !formValid}\n3032\t            onClick={handleSubmitDetails}\n3033\t            className=\"w-full h-14 rounded-[40px] bg-white border border-[rgba(255,255,255,0.04)] flex items-center justify-center gap-3 transition-opacity duration-100 ease-out active:opacity-70 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\"\n3034\t          >\n3035\t            {sendLoading ? (\n3036\t              <div className=\"size-4 rounded-full border-2 border-black/20 border-t-black animate-spin\" />\n3037\t            ) : (\n3038\t              <span className=\"text-h4 font-semibold text-black tracking-[-0.02em]\">\n3039\t                {formValid ? \"Send OTP\" : \"Fill in Details\"}\n3040\t              </span>\n3041\t            )}\n3042\t          </button>\n3043\t        </div>\n3044\t      )}\n3045\t\n3046\t      {/* OTP_SENT — verification */}\n3047\t      {uiState === \"OTP_SENT\" && (\n3048\t        <div className=\"flex flex-col gap-6\">\n3049\t          <div className=\"flex flex-col gap-1\">\n3050\t            <h2 className=\"text-h4 font-semibold text-white tracking-[-0.02em] leading-[1.1]\">\n3051\t              Verify your email\n3052\t            </h2>\n3053\t            <div className=\"flex items-center justify-between gap-4\">\n3054\t              <p className=\"text-p3 text-white/64 min-w-0 truncate\">\n3055\t                Code sent to{\" \"}\n3056\t                <span className=\"text-white font-medium\">{email}</span>\n3057\t              </p>\n3058\t              <button\n3059\t                type=\"button\"\n3060\t                onClick={() => {\n3061\t                  setUiState(\"IDLE\");\n3062\t                  setOtp(Array(OTP_LENGTH_SLOT).fill(\"\"));\n3063\t                  setOtpError(\"\");\n3064\t                }}\n3065\t                className=\"text-p3 font-medium text-white/64 underline underline-offset-2 hover:text-white transition-colors duration-200 ease-out shrink-0\"\n3066\t              >\n3067\t                Change\n3068\t              </button>\n3069\t            </div>\n3070\t          </div>\n3071\t\n3072\t          <div className=\"flex flex-col gap-3\">\n3073\t            <label\n3074\t              htmlFor=\"slot-otp-0\"\n3075\t              className=\"text-p3 font-medium text-white/64\"\n3076\t            >\n3077\t              Enter OTP\n3078\t            </label>\n3079\t            <div className=\"flex gap-3 justify-center\" onPaste={handleOtpPaste}>\n3080\t              {otp.map((digit, i) => (\n3081\t                <input\n3082\t                  key={`slot-otp-${i}`}\n3083\t                  id={i === 0 ? \"slot-otp-0\" : undefined}\n3084\t                  ref={(el) => {\n3085\t                    otpRefs.current[i] = el;\n3086\t                  }}\n3087\t                  type=\"text\"\n3088\t                  inputMode=\"numeric\"\n3089\t                  maxLength={1}\n3090\t                  value={digit}\n3091\t                  autoFocus={i === 0}\n3092\t                  onChange={(e) => handleOtpChange(i, e.target.value)}\n3093\t                  onKeyDown={(e) => handleOtpKeyDown(i, e)}\n3094\t                  className=\"w-14 h-14 text-center shrink-0 text-h3 font-semibold text-white rounded-xl focus:outline-none caret-white transition-all duration-150 ease-out\"\n3095\t                  style={{\n3096\t                    background: digit\n3097\t                      ? \"rgba(255,255,255,0.18)\"\n3098\t                      : \"rgba(255,255,255,0.10)\",\n3099\t                    border: digit\n3100\t                      ? \"1.5px solid rgba(255,255,255,0.36)\"\n3101\t                      : \"1.5px solid rgba(255,255,255,0.14)\",\n3102\t                  }}\n3103\t                />\n3104\t              ))}\n3105\t            </div>\n3106\t\n3107\t            {otpError && (\n3108\t              <p className=\"text-p3 text-red-400 font-medium\">{otpError}</p>\n3109\t            )}\n3110\t\n3111\t            <div className=\"flex justify-end\">\n3112\t              {resendAvailableAt && Date.now() < resendAvailableAt ? (\n3113\t                <ResendTimer\n3114\t                  availableAt={resendAvailableAt}\n3115\t                  onExpire={() => setResendAvailableAt(null)}\n3116\t                />\n3117\t              ) : (\n3118\t                <button\n3119\t                  type=\"button\"\n3120\t                  onClick={handleResend}\n3121\t                  className=\"text-p3 font-medium text-white/64 underline underline-offset-2 hover:text-white transition-colors duration-200 ease-out\"\n3122\t                >\n3123\t                  Resend OTP\n3124\t                </button>\n3125\t              )}\n3126\t            </div>\n3127\t          </div>\n3128\t\n3129\t          <button\n3130\t            type=\"button\"\n3131\t            disabled={verifyLoading || !otpComplete}\n3132\t            onClick={handleVerifyOtp}\n3133\t            className=\"w-full h-14 rounded-[40px] bg-white border border-[rgba(255,255,255,0.04)] flex items-center justify-center gap-3 transition-opacity duration-200 ease-out active:opacity-70 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40\"\n3134\t          >\n3135\t            {verifyLoading ? (\n3136\t              <div className=\"size-4 rounded-full border-2 border-black/20 border-t-black animate-spin\" />\n3137\t            ) : (\n3138\t              <span className=\"text-h4 font-semibold text-black tracking-[-0.02em]\">\n3139\t                Verify & Continue\n3140\t              </span>\n3141\t            )}\n3142\t          </button>\n3143\t        </div>\n3144\t      )}\n3145\t    </div>\n3146\t  );\n3147\t}\n3148\t\n3149\t// ─── Loading skeleton ─────────────────────────────────────────────────────────\n3150\t// Shown while the venue/resource meta is still resolving. Mirrors the funnel's\n3151\t// header + step-breadcrumb + date-strip + slot-grid so the transition into the\n3152\t// real content is seamless — and, critically, so the guard below never flashes\n3153\t// \"Resource not found\" during the one-render gap before the derive effect runs.\n3154\t\n3155\tconst SKELETON_SLOT_COUNT = 9;\n3156\t\n3157\tfunction SkeletonInterior() {\n3158\t  return (\n3159\t    <div\n3160\t      role=\"status\"\n3161\t      aria-busy=\"true\"\n3162\t      aria-label=\"Loading booking\"\n3163\t      className=\"animate-pulse\"\n3164\t    >\n3165\t      {/* Header — mirrors CompactHeader */}\n3166\t      <div className=\"flex items-center gap-3 pl-5 pr-14 py-4 shrink-0\">\n3167\t        <div className=\"size-8 rounded-full bg-white/[0.08] shrink-0\" />\n3168\t        <div className=\"flex-1 min-w-0\">\n3169\t          <div className=\"h-4 w-2/5 rounded-md bg-white/[0.10]\" />\n3170\t        </div>\n3171\t        <div className=\"h-6 w-16 rounded-full bg-white/[0.08] shrink-0\" />\n3172\t      </div>\n3173\t\n3174\t      {/* Step breadcrumb */}\n3175\t      <div className=\"px-[27px] pb-3\">\n3176\t        <div className=\"flex items-center gap-2\">\n3177\t          {Array.from({ length: 4 }).map((_, i) => (\n3178\t            <div\n3179\t              key={i}\n3180\t              className=\"h-1.5 flex-1 rounded-full bg-white/[0.08]\"\n3181\t            />\n3182\t          ))}\n3183\t        </div>\n3184\t      </div>\n3185\t\n3186\t      {/* Step content */}\n3187\t      <div className=\"px-[27px] pb-10 pt-1 flex flex-col gap-5\">\n3188\t        {/* Date strip */}\n3189\t        <div className=\"flex gap-2 overflow-hidden\">\n3190\t          {Array.from({ length: 5 }).map((_, i) => (\n3191\t            <div\n3192\t              key={i}\n3193\t              className=\"h-16 w-14 rounded-2xl bg-white/[0.06] shrink-0\"\n3194\t            />\n3195\t          ))}\n3196\t        </div>\n3197\t\n3198\t        {/* Section label */}\n3199\t        <div className=\"h-3 w-24 rounded bg-white/[0.08]\" />\n3200\t\n3201\t        {/* Slot grid */}\n3202\t        <div className=\"grid grid-cols-3 gap-2.5\">\n3203\t          {Array.from({ length: SKELETON_SLOT_COUNT }).map((_, i) => (\n3204\t            <div\n3205\t              key={i}\n3206\t              className=\"h-12 rounded-xl bg-white/[0.06] border border-white/[0.06]\"\n3207\t            />\n3208\t          ))}\n3209\t        </div>\n3210\t      </div>\n3211\t    </div>\n3212\t  );\n3213\t}\n3214\t\n3215\tfunction BookingFunnelSkeleton({ inModal }: { inModal?: boolean }) {\n3216\t  if (inModal) return <SkeletonInterior />;\n3217\t\n3218\t  return (\n3219\t    <div className=\"min-h-screen bg-black text-white overflow-x-hidden\">\n3220\t      {/* Decorative blurred background — matches the loaded funnel shell */}\n3221\t      <div\n3222\t        aria-hidden=\"true\"\n3223\t        className=\"fixed inset-0 overflow-hidden pointer-events-none\"\n3224\t      >\n3225\t        <div className=\"absolute inset-0\" style={BG_OVERLAY_GRADIENT} />\n3226\t        <div className=\"absolute top-[-20%] left-[-10%] w-[60vw] h-[60vw] rounded-full bg-[#1a3a6e]/20 blur-[120px]\" />\n3227\t        <div className=\"absolute bottom-[-10%] right-[-10%] w-[40vw] h-[40vw] rounded-full bg-[#3a1a6e]/15 blur-[100px]\" />\n3228\t      </div>\n3229\t\n3230\t      <div className=\"relative z-10 min-h-screen flex flex-col pt-4 md:items-center md:justify-center md:py-12 md:px-4\">\n3231\t        <div\n3232\t          className=\"\n3233\t            w-full md:max-w-[480px]\n3234\t            flex-1 md:flex-none\n3235\t            max-h-[calc(100vh-16px)] md:max-h-[88vh]\n3236\t            overflow-y-auto overscroll-y-contain\n3237\t            bg-[rgba(20,20,20,0.78)] backdrop-blur-[128px]\n3238\t            border border-[rgba(255,255,255,0.06)]\n3239\t            rounded-t-[44px] md:rounded-[44px]\n3240\t            flex flex-col\n3241\t          \"\n3242\t        >\n3243\t          <div\n3244\t            aria-hidden=\"true\"\n3245\t            className=\"md:hidden mx-auto mt-3 mb-0 h-1 w-10 rounded-full bg-white/[0.24] shrink-0\"\n3246\t          />\n3247\t          <SkeletonInterior />\n3248\t        </div>\n3249\t      </div>\n3250\t    </div>\n3251\t  );\n3252\t}\n3253\t\n3254\t// ─── Main Booking Funnel ──────────────────────────────────────────────────────\n3255\t\n3256\texport default function BookingFunnelClient({\n3257\t  venueId,\n3258\t  resourceId,\n3259\t  inModal,\n3260\t  onClose,\n3261\t  walkIn,\n3262\t}: {\n3263\t  venueId: string;\n3264\t  resourceId: string;\n3265\t  /** When true, render only the sheet interior (no full-page chrome / background).\n3266\t   *  Use together with a modal wrapper that owns the backdrop + sheet shell. */\n3267\t  inModal?: boolean;\n3268\t  /** Called when the user wants to dismiss from step 1 / auth. Required in modal mode. */\n3269\t  onClose?: () => void;\n3270\t  /** True when this funnel was opened via a venue's walk-in QR scan — skips\n3271\t   *  the minNoticeMinutes lead-time restriction on the server. */\n3272\t  walkIn?: boolean;\n3273\t}) {\n3274\t  const router = useRouter();\n3275\t  const dispatch = useAppDispatch();\n3276\t  const user = useAppSelector((s) => s.auth.user);\n3277\t  const isAuthenticated = useAppSelector((s) => s.auth.isAuthenticated);\n3278\t  const authToken = useAppSelector((s) => s.auth.token);\n3279\t\n3280\t  // ── State ─────────────────────────────────────────────────────────────────────\n3281\t  const [step, setStep] = useState(1);\n3282\t  const [showAuthStep, setShowAuthStep] = useState(false);\n3283\t  const [venue, setVenue] = useState<VenueDetail | null>(null);\n3284\t  const [resource, setResource] = useState<ResourceDetail | null>(null);\n3285\t\n3286\t  // RTK Query fetches — served from cache seeded by VenueDetailPageClient so\n3287\t  // there is no network round-trip when the user navigates to booking.\n3288\t  const { data: venueData, isLoading: loadingMeta } =\n3289\t    useGetVenueByIdQuery(venueId);\n3290\t\n3291\t  const [selectedDate, setSelectedDate] = useState<Date>(() => {\n3292\t    // venueData may already be warm from the venue detail page's cache\n3293\t    // (same RTK Query key) — when it is, resolve the cross-midnight\n3294\t    // operating day right away instead of defaulting to calendar-today.\n3295\t    if (!venueData) return getEffectiveOperatingDate(new Date());\n3296\t    const v = venueData.data ?? venueData;\n3297\t    const res = (v.resources ?? []).find(\n3298\t      (r: ResourceDetail) => r.resourceId === resourceId,\n3299\t    ) as ResourceDetail | undefined;"}]},"parent_tool_use_id":"call-5470d650-ae5a-4bd0-a18f-ce45e4335c88","agent_id":"abc27421403752d9d","session_id":"8db18de0-e6fa-4cab-a756-dd1477016fa1","uuid":"a167eeed-212a-4807-9554-657e61d6e228","timestamp":"2026-11-20T17:34:44.901Z","tool_result_meta":[{"id":"call_01a1fa06598f7038b0a97668","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Audit web booking funnel for bugs"}
