+/** The three stages a buyer sees in the checkout breadcrumb.
+ *
+ * `review` covers both the review screen (step 4) and the payment screen
+ * (step 5) — they are one stage to the buyer, "review and pay" — so the
+ * breadcrumb must not list them as two separate steps. */
+export type BookingStageId = "tickets" | "details" | "review";
+
+/** Turns the visible step list into the breadcrumb stages for it.
+ *
+ * The breadcrumb has to follow the real flow: an event with no attendee
+ * fields has no "details" stage, and a flow that starts at the ticket
+ * screen has no "identify" stage either. Deriving the stages from
+ * `visibleSteps` keeps the breadcrumb honest about what the buyer will
+ * actually go through.
+ *
+ * Example: visibleSteps [2, 4, 5] (signed in, no attendee fields) gives
+ * ["tickets", "review"] — no "details" stage, because there isn't one.
+ */
+export function getBookingStages(visibleSteps: BookingStep[]): BookingStageId[] {
+	const stages: BookingStageId[] = [];
+	if (visibleSteps.includes(2)) stages.push("tickets");
+	if (visibleSteps.includes(3)) stages.push("details");
+	// Steps 4 and 5 are the same stage to the buyer.
+	if (visibleSteps.includes(4) || visibleSteps.includes(5)) stages.push("review");
+	return stages;
+}
+
 export function isRequiredFieldAnswered(value: string | undefined | null): boolean {
 	return !!value?.trim();
 }
