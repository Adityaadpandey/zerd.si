{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-b1408b30-8021-4015-ad09-0f9a15842aa0","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport { config } from \"../../config/index\";\n3\timport { redis } from \"../../config/redis\";\n4\timport {\n5\t  type BundleGroupConfig,\n6\t  clampBundlePrice,\n7\t  matchBundlePurchases,\n8\t  splitAmountProportionally,\n9\t} from \"../../utils/bundle-pricing.util\";\n10\timport { computeDiscountSplit } from \"../../utils/discount-pricing.util\";\n11\timport { ConflictError, NotFoundError, ValidationError } from \"../../utils/errors.util\";\n12\timport { computeSeatPricing } from \"../../utils/fee-pricing.util\";\n13\timport { fromPaise, round2, toPaise } from \"../../utils/money.util\";\n14\timport type { CreateBookingDto } from \"./types\";\n15\t\n16\texport class BookingPricingService {\n17\t  validateDtoShape(dto: CreateBookingDto) {\n18\t    for (const item of dto.items) {\n19\t      if (item.quantity < 1 || item.quantity > 20) {\n20\t        throw new ValidationError(\n21\t          `Quantity for ticket type ${item.ticketTypeId} must be between 1 and 20`,\n22\t        );\n23\t      }\n24\t      if (item.ticketFieldResponses.length !== item.quantity) {\n25\t        throw new ValidationError(\n26\t          `ticketFieldResponses length must equal quantity for ticket type ${item.ticketTypeId}`,\n27\t        );\n28\t      }\n29\t      if (item.seatIds && item.seatIds.length !== item.quantity) {\n30\t        throw new ValidationError(\n31\t          `seatIds length must equal quantity for ticket type ${item.ticketTypeId}`,\n32\t        );\n33\t      }\n34\t      if (item.seatIds && new Set(item.seatIds).size !== item.seatIds.length) {\n35\t        throw new ValidationError(\n36\t          `Duplicate seatIds for ticket type ${item.ticketTypeId}`,\n37\t        );\n38\t      }\n39\t    }\n40\t  }\n41\t\n42\t  async validateAndPrice(dto: CreateBookingDto) {\n43\t    const requestedIds = dto.items.map((i) => i.ticketTypeId);\n44\t\n45\t    const ticketTypes =\n46\t      requestedIds.length > 0\n47\t        ? await prisma.ticketType.findMany({\n48\t            where: {\n49\t              ticketTypeId: { in: requestedIds },\n50\t              eventId: dto.eventId,\n51\t            },\n52\t            select: {\n53\t              ticketTypeId: true,\n54\t              name: true,\n55\t              salesCutoff: true,\n56\t              price: true,\n57\t              discountedPrice: true,\n58\t              discountQuantity: true,\n59\t              discountSoldCount: true,\n60\t              platformfee: true,\n61\t              platformfeePerc: true,\n62\t              gatewayFeePerc: true,\n63\t              feeBornBy: true,\n64\t              groupId: true,\n65\t              CustomField: {\n66\t                select: { fieldId: true, required: true },\n67\t              },\n68\t            },\n69\t          })\n70\t        : [];\n71\t\n72\t    if (ticketTypes.length !== requestedIds.length) {\n73\t      throw new ValidationError(\n74\t        \"One or more ticket types do not belong to this event\",\n75\t      );\n76\t    }\n77\t\n78\t    const ticketTypeMap = new Map(\n79\t      ticketTypes.map((tt) => [tt.ticketTypeId, tt]),\n80\t    );\n81\t\n82\t    const now = new Date();\n83\t\n84\t    // ------------------------------------------------------------------\n85\t    // Bundle detection — server-side, from item composition alone. A group\n86\t    // only prices as a bundle when dto.items contains EVERY member at the\n87\t    // EXACT same quantity (see bundle-pricing.util.ts for the full rule).\n88\t    // ------------------------------------------------------------------\n89\t    const touchedGroupIds = [\n90\t      ...new Set(\n91\t        ticketTypes\n92\t          .map((tt) => tt.groupId)\n93\t          .filter((id): id is string => id != null),\n94\t      ),\n95\t    ];\n96\t\n97\t    const groupRows =\n98\t      touchedGroupIds.length > 0\n99\t        ? await prisma.ticketTypeGroup.findMany({\n100\t            where: { groupId: { in: touchedGroupIds }, eventId: dto.eventId },\n101\t            select: {\n102\t              groupId: true,\n103\t              price: true,\n104\t              discountedPrice: true,\n105\t              discountQuantity: true,\n106\t              discountSoldCount: true,\n107\t              ticketTypes: { select: { ticketTypeId: true, price: true } },\n108\t            },\n109\t          })\n110\t        : [];\n111\t\n112\t    const bundleGroups: BundleGroupConfig[] = groupRows.map((g) => ({\n113\t      groupId: g.groupId,\n114\t      price: g.price,\n115\t      discountedPrice: g.discountedPrice,\n116\t      discountQuantity: g.discountQuantity,\n117\t      discountSoldCount: g.discountSoldCount,\n118\t      members: g.ticketTypes.map((m) => ({\n119\t        ticketTypeId: m.ticketTypeId,\n120\t        price: m.price,\n121\t      })),\n122\t    }));\n123\t\n124\t    const matchedBundles = matchBundlePurchases(\n125\t      dto.items.map((i) => ({\n126\t        ticketTypeId: i.ticketTypeId,\n127\t        quantity: i.quantity,\n128\t      })),\n129\t      bundleGroups,\n130\t    );\n131\t    const bundledTicketTypeIds = new Set(\n132\t      matchedBundles.flatMap((b) => b.members.map((m) => m.ticketTypeId)),\n133\t    );\n134\t\n135\t    for (const item of dto.items) {\n136\t      const tt = ticketTypeMap.get(item.ticketTypeId);\n137\t      if (!tt) {\n138\t        throw new NotFoundError(`Ticket type ${item.ticketTypeId} not found`);\n139\t      }\n140\t\n141\t      if (tt.salesCutoff && tt.salesCutoff < now) {\n142\t        throw new ValidationError(\n143\t          `Sales for ticket type \"${tt.name}\" have ended`,\n144\t        );\n145\t      }\n146\t\n147\t      const requiredFields = tt.CustomField.filter((cf) => cf.required);\n148\t      for (let seatIdx = 0; seatIdx < item.quantity; seatIdx++) {\n149\t        const responses = item.ticketFieldResponses[seatIdx];\n150\t        const respondedFieldIds = new Set(responses.map((r) => r.fieldId));\n151\t        for (const field of requiredFields) {\n152\t          if (!respondedFieldIds.has(field.fieldId)) {\n153\t            throw new ValidationError(\n154\t              `Missing required field ${field.fieldId} for ticket type \"${tt.name}\" (seat ${seatIdx + 1})`,\n155\t            );\n156\t          }\n157\t        }\n158\t      }\n159\t    }\n160\t\n161\t    // Required common (event-wide) custom fields — answered once per\n162\t    // booking via dto.commonFieldResponses, not per-seat like the\n163\t    // ticket-type-scoped fields validated above.\n164\t    const commonRequiredFields = await prisma.customField.findMany({\n165\t      where: {\n166\t        eventId: dto.eventId,\n167\t        required: true,\n168\t        ticketTypes: { none: {} },\n169\t      },\n170\t      select: { fieldId: true },\n171\t    });\n172\t    if (commonRequiredFields.length > 0) {\n173\t      const respondedCommonFieldIds = new Set(\n174\t        dto.commonFieldResponses.map((r) => r.fieldId),\n175\t      );\n176\t      for (const field of commonRequiredFields) {\n177\t        if (!respondedCommonFieldIds.has(field.fieldId)) {\n178\t          throw new ValidationError(\n179\t            `Missing required field ${field.fieldId}`,\n180\t          );\n181\t        }\n182\t      }\n183\t    }\n184\t\n185\t    // ------------------------------------------------------------------\n186\t    // Step 1: Build pre-coupon lines with early-bird split.\n187\t    //         Track earlyBirdSaving so discountAmount is accurate.\n188\t    // ------------------------------------------------------------------\n189\t    type PricingLine = {\n190\t      ticketTypeId: string;\n191\t      qty: number;\n192\t      seatFace: number; // per-seat price after early-bird, before coupon\n193\t      wasDiscounted: boolean;\n194\t      bundleGroupId: string | null;\n195\t      bundleWasDiscounted: boolean;\n196\t      feeConfig: Parameters<typeof computeSeatPricing>[1];\n197\t      responses: Array<Array<{ fieldId: string; value: string }>>;\n198\t      // Reserved-seating events only — parallel to `responses`, sliced the\n199\t      // same way across the early-bird boundary.\n200\t      seatIds?: string[];\n201\t    };\n202\t    const priceLines: PricingLine[] = [];\n203\t    let subtotalP = 0; // Σ seatFace × qty (paise; post-early-bird, pre-coupon)\n204\t    let earlyBirdSavingP = 0;\n205\t\n206\t    const itemByTicketTypeId = new Map(\n207\t      dto.items.map((item) => [item.ticketTypeId, item]),\n208\t    );\n209\t\n210\t    for (const bundle of matchedBundles) {\n211\t      const group = bundleGroups.find((g) => g.groupId === bundle.groupId);\n212\t      if (!group) {\n213\t        throw new NotFoundError(`Bundle group ${bundle.groupId} not found`);\n214\t      }\n215\t      // matchBundlePurchases only ever matches groups with a non-null price\n216\t      // (see bundle-pricing.util.ts) — this just narrows the type for below.\n217\t      if (group.price == null) {\n218\t        throw new NotFoundError(\n219\t          `Bundle group ${bundle.groupId} has no price set`,\n220\t        );\n221\t      }\n222\t      // Safety ceiling: a bundle must never cost more than buying its\n223\t      // members individually. Clamp both the full and discounted bundle\n224\t      // price to the sum of members' own list prices, evaluated at\n225\t      // booking time — this self-corrects if a member's price changes\n226\t      // after the group was configured, rather than trusting a\n227\t      // potentially-stale value from group creation time.\n228\t      const memberPriceSum = bundle.members.reduce((sum, m) => {\n229\t        const memberTt = ticketTypeMap.get(m.ticketTypeId);\n230\t        if (!memberTt) {\n231\t          throw new NotFoundError(`Ticket type ${m.ticketTypeId} not found`);\n232\t        }\n233\t        return sum + memberTt.price;\n234\t      }, 0);\n235\t      const { discountSlots, fullSlots } = computeDiscountSplit(\n236\t        {\n237\t          discountedPrice: group.discountedPrice,\n238\t          discountQuantity: group.discountQuantity,\n239\t          discountSoldCount: group.discountSoldCount,\n240\t        },\n241\t        bundle.quantity,\n242\t      );\n243\t\n244\t      const pushBundleSlot = (\n245\t        slotQty: number,\n246\t        bundleUnitPrice: number,\n247\t        wasDiscounted: boolean,\n248\t        responseOffset: number,\n249\t      ) => {\n250\t        if (slotQty <= 0) return;\n251\t        const split = splitAmountProportionally(bundle.members, bundleUnitPrice);\n252\t        for (const member of bundle.members) {\n253\t          const tt = ticketTypeMap.get(member.ticketTypeId);\n254\t          if (!tt) {\n255\t            throw new NotFoundError(\n256\t              `Ticket type ${member.ticketTypeId} not found`,\n257\t            );\n258\t          }\n259\t          const seatFace = split.get(member.ticketTypeId);\n260\t          if (seatFace === undefined) {\n261\t            throw new NotFoundError(\n262\t              `Split amount missing for ticket type ${member.ticketTypeId}`,\n263\t            );\n264\t          }\n265\t          const feeConfig = {\n266\t            platformfee: tt.platformfee,\n267\t            platformfeePerc: tt.platformfeePerc,\n268\t            gatewayFeePerc: tt.gatewayFeePerc,\n269\t            feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n270\t          };\n271\t          const item = itemByTicketTypeId.get(member.ticketTypeId);\n272\t          if (!item) {\n273\t            throw new NotFoundError(\n274\t              `Booking item for ticket type ${member.ticketTypeId} not found`,\n275\t            );\n276\t          }\n277\t          priceLines.push({\n278\t            ticketTypeId: member.ticketTypeId,\n279\t            qty: slotQty,\n280\t            seatFace,\n281\t            wasDiscounted: false, // this seat did NOT use its own type's discount slot\n282\t            bundleGroupId: bundle.groupId,\n283\t            bundleWasDiscounted: wasDiscounted,\n284\t            feeConfig,\n285\t            responses: item.ticketFieldResponses.slice(\n286\t              responseOffset,\n287\t              responseOffset + slotQty,\n288\t            ),\n289\t          });\n290\t          subtotalP += toPaise(seatFace) * slotQty;\n291\t        }\n292\t      };\n293\t\n294\t      if (discountSlots > 0) {\n295\t        const bundlePrice = clampBundlePrice(group.price, memberPriceSum);\n296\t        const discountedBundlePrice =\n297\t          group.discountedPrice != null\n298\t            ? clampBundlePrice(group.discountedPrice, memberPriceSum)\n299\t            : bundlePrice;\n300\t        if (group.discountedPrice != null) {\n301\t          const fullSplit = splitAmountProportionally(bundle.members, bundlePrice);\n302\t          const discSplit = splitAmountProportionally(\n303\t            bundle.members,\n304\t            clampBundlePrice(group.discountedPrice, memberPriceSum),\n305\t          );\n306\t          for (const member of bundle.members) {\n307\t            const fullShare = fullSplit.get(member.ticketTypeId);\n308\t            const discShare = discSplit.get(member.ticketTypeId);\n309\t            if (fullShare === undefined || discShare === undefined) {\n310\t              throw new NotFoundError(\n311\t                `Split amount missing for ticket type ${member.ticketTypeId}`,\n312\t              );\n313\t            }\n314\t            earlyBirdSavingP +=\n315\t              (toPaise(fullShare) - toPaise(discShare)) * discountSlots;\n316\t          }\n317\t        }\n318\t        pushBundleSlot(discountSlots, discountedBundlePrice, true, 0);\n319\t      }\n320\t      if (fullSlots > 0) {\n321\t        pushBundleSlot(\n322\t          fullSlots,\n323\t          clampBundlePrice(group.price, memberPriceSum),\n324\t          false,\n325\t          discountSlots,\n326\t        );\n327\t      }\n328\t    }\n329\t\n330\t    for (const item of dto.items) {\n331\t      if (bundledTicketTypeIds.has(item.ticketTypeId)) {\n332\t        if (item.seatIds && item.seatIds.length > 0) {\n333\t          throw new ValidationError(\n334\t            `Ticket type ${item.ticketTypeId} is part of a bundle — reserved seating does not support bundled ticket types`,\n335\t          );\n336\t        }\n337\t        continue;\n338\t      }\n339\t      const tt = ticketTypeMap.get(item.ticketTypeId);\n340\t      if (!tt) {\n341\t        throw new NotFoundError(`Ticket type ${item.ticketTypeId} not found`);\n342\t      }\n343\t      if (item.seatIds && item.seatIds.length > 0 && tt.groupId != null) {\n344\t        throw new ValidationError(\n345\t          `Ticket type ${item.ticketTypeId} belongs to a bundle group — reserved seating does not support bundled ticket types`,\n346\t        );\n347\t      }\n348\t      const { discountSlots, fullSlots } = computeDiscountSplit(\n349\t        tt,\n350\t        item.quantity,\n351\t      );\n352\t      const feeConfig = {\n353\t        platformfee: tt.platformfee,\n354\t        platformfeePerc: tt.platformfeePerc,\n355\t        gatewayFeePerc: tt.gatewayFeePerc,\n356\t        feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n357\t      };\n358\t\n359\t      if (discountSlots > 0) {\n360\t        const face = tt.discountedPrice ?? tt.price;\n361\t        if (tt.discountedPrice != null) {\n362\t          earlyBirdSavingP +=\n363\t            (toPaise(tt.price) - toPaise(tt.discountedPrice)) * discountSlots;\n364\t        }\n365\t        priceLines.push({\n366\t          ticketTypeId: tt.ticketTypeId,\n367\t          qty: discountSlots,\n368\t          seatFace: face,\n369\t          wasDiscounted: true,\n370\t          bundleGroupId: null,\n371\t          bundleWasDiscounted: false,\n372\t          feeConfig,\n373\t          responses: item.ticketFieldResponses.slice(0, discountSlots),\n374\t          seatIds: item.seatIds?.slice(0, discountSlots),\n375\t        });\n376\t        subtotalP += toPaise(face) * discountSlots;\n377\t      }\n378\t\n379\t      if (fullSlots > 0) {\n380\t        priceLines.push({\n381\t          ticketTypeId: tt.ticketTypeId,\n382\t          qty: fullSlots,\n383\t          seatFace: tt.price,\n384\t          wasDiscounted: false,\n385\t          bundleGroupId: null,\n386\t          bundleWasDiscounted: false,\n387\t          feeConfig,\n388\t          responses: item.ticketFieldResponses.slice(discountSlots),\n389\t          seatIds: item.seatIds?.slice(discountSlots),\n390\t        });\n391\t        subtotalP += toPaise(tt.price) * fullSlots;\n392\t      }\n393\t    }\n394\t    const subtotal = fromPaise(subtotalP);\n395\t    const earlyBirdSaving = fromPaise(earlyBirdSavingP);\n396\t\n397\t    // ------------------------------------------------------------------\n398\t    // Step 2: No coupon at booking-creation time.\n399\t    //         Coupon is applied separately via applyDiscount (PATCH).\n400\t    //         All couponShares are 0; netFace == seatFace for every line.\n401\t    // ------------------------------------------------------------------\n402\t    const couponDiscount = 0;\n403\t    const couponShares = priceLines.map(() => 0); // line-total shares\n404\t\n405\t    // ------------------------------------------------------------------\n406\t    // Step 3: Per-line fee computation using new formulas (with GST).\n407\t    // ------------------------------------------------------------------\n408\t    // Accumulate in integer paise so booking totals are exact (no float drift).\n409\t    let platformFeeP = 0;\n410\t    let gatewayFeeP = 0;\n411\t    let gstP = 0;\n412\t    let totalP = 0;\n413\t    const feeModes = new Set<\"HOST\" | \"USER\">();\n414\t    const lines: Array<{\n415\t      ticketTypeId: string;\n416\t      quantity: number;\n417\t      unitPrice: number;\n418\t      faceValue: number; // per-seat pre-coupon seatFace (stored for audit/reprice)\n419\t      platformFee: number;\n420\t      gatewayFee: number;\n421\t      gst: number;\n422\t      feeBornBy: \"HOST\" | \"USER\";\n423\t      wasDiscounted: boolean;\n424\t      bundleGroupId: string | null;\n425\t      bundleWasDiscounted: boolean;\n426\t      ticketFieldResponses: Array<Array<{ fieldId: string; value: string }>>;\n427\t      seatIds?: string[];\n428\t    }> = [];\n429\t\n430\t    for (let i = 0; i < priceLines.length; i++) {\n431\t      const line = priceLines[i];\n432\t      const couponSharePerSeat =\n433\t        line.qty > 0 ? couponShares[i] / line.qty : 0;\n434\t      const netFace = round2(line.seatFace - couponSharePerSeat);\n435\t\n436\t      const seat = computeSeatPricing(netFace, line.feeConfig, config.TUNYT_GST_ENABLED);\n437\t      feeModes.add(seat.feeBornBy);\n438\t\n439\t      platformFeeP += toPaise(seat.platformFee) * line.qty;\n440\t      gatewayFeeP += toPaise(seat.gatewayFee) * line.qty;\n441\t      gstP += toPaise(seat.gst) * line.qty;\n442\t      totalP += toPaise(seat.buyerPays) * line.qty;\n443\t\n444\t      lines.push({\n445\t        ticketTypeId: line.ticketTypeId,\n446\t        quantity: line.qty,\n447\t        unitPrice: seat.buyerPays,\n448\t        faceValue: line.seatFace, // pre-coupon — stays immutable for reprice\n449\t        platformFee: seat.platformFee,\n450\t        gatewayFee: seat.gatewayFee,\n451\t        gst: seat.gst,\n452\t        feeBornBy: seat.feeBornBy,\n453\t        wasDiscounted: line.wasDiscounted,\n454\t        bundleGroupId: line.bundleGroupId,\n455\t        bundleWasDiscounted: line.bundleWasDiscounted,\n456\t        ticketFieldResponses: line.responses,\n457\t        seatIds: line.seatIds,\n458\t      });\n459\t    }\n460\t\n461\t    const discountAmount = round2(earlyBirdSaving + couponDiscount);\n462\t    const feesBornBy: \"HOST\" | \"USER\" | \"MIXED\" =\n463\t      feeModes.size > 1 ? \"MIXED\" : feeModes.has(\"USER\") ? \"USER\" : \"HOST\";\n464\t\n465\t    return {\n466\t      subtotal,\n467\t      discountAmount,\n468\t      platformFee: fromPaise(platformFeeP),\n469\t      gatewayFee: fromPaise(gatewayFeeP),\n470\t      gst: fromPaise(gstP),\n471\t      total: fromPaise(totalP),\n472\t      feesBornBy,\n473\t      lines,\n474\t    };\n475\t  }\n476\t\n477\t  /**\n478\t   * Reserved-seating events only: checks every requested seatId is real,\n479\t   * belongs to this event's published seat map, matches the ticket type it\n480\t   * was requested under, is currently AVAILABLE, and that the caller still\n481\t   * holds their interactive selection lock on it.\n482\t   *\n483\t   * The interactive-lock check (Redis) is a UX safety net, not the source of\n484\t   * truth — it turns a stale selection into a clear \"reselect your seats\"\n485\t   * error instead of a generic conflict. The DB-level AVAILABLE -> HELD flip\n486\t   * done later inside the create transaction (see\n487\t   * BookingRepository.insertBookingWithTicketsTx) is what actually prevents\n488\t   * two buyers from booking the same seat.\n489\t   */\n490\t  async validateSeatSelections(\n491\t    eventId: string,\n492\t    seatingMode: string,\n493\t    userId: string,\n494\t    items: CreateBookingDto[\"items\"],\n495\t  ): Promise<void> {\n496\t    const anySeatIds = items.some((i) => i.seatIds && i.seatIds.length > 0);\n497\t\n498\t    if (seatingMode !== \"RESERVED\") {\n499\t      if (anySeatIds) {\n500\t        throw new ValidationError(\n501\t          \"This event does not use reserved seating — seatIds are not accepted\",\n502\t        );\n503\t      }\n504\t      return;\n505\t    }\n506\t\n507\t    if (items.length === 0) return;\n508\t\n509\t    if (items.some((i) => !i.seatIds || i.seatIds.length === 0)) {\n510\t      throw new ValidationError(\n511\t        \"seatIds are required for every item on a reserved-seating event\",\n512\t      );\n513\t    }\n514\t\n515\t    const seatMap = await prisma.eventSeatMap.findUnique({\n516\t      where: { eventId },\n517\t      select: { eventSeatMapId: true, publishedAt: true },\n518\t    });\n519\t    if (!seatMap || !seatMap.publishedAt) {\n520\t      throw new ValidationError(\"Seat map is not published for this event\");\n521\t    }\n522\t\n523\t    const allSeatIds = items.flatMap((i) => i.seatIds ?? []);\n524\t    const seats = await prisma.seat.findMany({\n525\t      where: { seatId: { in: allSeatIds } },\n526\t      select: {\n527\t        seatId: true,\n528\t        eventSeatMapId: true,\n529\t        ticketTypeId: true,\n530\t        status: true,\n531\t      },\n532\t    });\n533\t    const seatById = new Map(seats.map((s) => [s.seatId, s]));\n534\t\n535\t    for (const item of items) {\n536\t      for (const seatId of item.seatIds ?? []) {\n537\t        const seat = seatById.get(seatId);\n538\t        if (!seat || seat.eventSeatMapId !== seatMap.eventSeatMapId) {\n539\t          throw new ValidationError(\n540\t            `Seat ${seatId} does not belong to this event`,\n541\t          );\n542\t        }\n543\t        if (seat.ticketTypeId !== item.ticketTypeId) {\n544\t          throw new ValidationError(\n545\t            `Seat ${seatId} is not assigned to ticket type ${item.ticketTypeId}`,\n546\t          );\n547\t        }\n548\t        if (seat.status !== \"AVAILABLE\") {\n549\t          throw new ConflictError(`SEAT_NO_LONGER_AVAILABLE:${seatId}`);\n550\t        }\n551\t      }\n552\t    }\n553\t\n554\t    const lockKeys = allSeatIds.map(\n555\t      (id) => `seat:hold:${seatMap.eventSeatMapId}:${id}`,\n556\t    );\n557\t    const lockValues = lockKeys.length > 0 ? await redis.mget(...lockKeys) : [];\n558\t    const expiredSeatIds = allSeatIds.filter(\n559\t      (_, idx) => lockValues[idx] !== userId,\n560\t    );\n561\t    if (expiredSeatIds.length > 0) {\n562\t      throw new ConflictError(\n563\t        `SEAT_SELECTION_EXPIRED:${expiredSeatIds.join(\",\")}`,\n564\t      );\n565\t    }\n566\t  }\n567\t}\n568\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"624d8ac9-9e0b-4f46-8ef7-77ddf8123332","timestamp":"2026-11-20T19:07:36.272Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/services/booking/booking-pricing.service.ts","content":"import { prisma } from \"../../config/db\";\nimport { config } from \"../../config/index\";\nimport { redis } from \"../../config/redis\";\nimport {\n  type BundleGroupConfig,\n  clampBundlePrice,\n  matchBundlePurchases,\n  splitAmountProportionally,\n} from \"../../utils/bundle-pricing.util\";\nimport { computeDiscountSplit } from \"../../utils/discount-pricing.util\";\nimport { ConflictError, NotFoundError, ValidationError } from \"../../utils/errors.util\";\nimport { computeSeatPricing } from \"../../utils/fee-pricing.util\";\nimport { fromPaise, round2, toPaise } from \"../../utils/money.util\";\nimport type { CreateBookingDto } from \"./types\";\n\nexport class BookingPricingService {\n  validateDtoShape(dto: CreateBookingDto) {\n    for (const item of dto.items) {\n      if (item.quantity < 1 || item.quantity > 20) {\n        throw new ValidationError(\n          `Quantity for ticket type ${item.ticketTypeId} must be between 1 and 20`,\n        );\n      }\n      if (item.ticketFieldResponses.length !== item.quantity) {\n        throw new ValidationError(\n          `ticketFieldResponses length must equal quantity for ticket type ${item.ticketTypeId}`,\n        );\n      }\n      if (item.seatIds && item.seatIds.length !== item.quantity) {\n        throw new ValidationError(\n          `seatIds length must equal quantity for ticket type ${item.ticketTypeId}`,\n        );\n      }\n      if (item.seatIds && new Set(item.seatIds).size !== item.seatIds.length) {\n        throw new ValidationError(\n          `Duplicate seatIds for ticket type ${item.ticketTypeId}`,\n        );\n      }\n    }\n  }\n\n  async validateAndPrice(dto: CreateBookingDto) {\n    const requestedIds = dto.items.map((i) => i.ticketTypeId);\n\n    const ticketTypes =\n      requestedIds.length > 0\n        ? await prisma.ticketType.findMany({\n            where: {\n              ticketTypeId: { in: requestedIds },\n              eventId: dto.eventId,\n            },\n            select: {\n              ticketTypeId: true,\n              name: true,\n              salesCutoff: true,\n              price: true,\n              discountedPrice: true,\n              discountQuantity: true,\n              discountSoldCount: true,\n              platformfee: true,\n              platformfeePerc: true,\n              gatewayFeePerc: true,\n              feeBornBy: true,\n              groupId: true,\n              CustomField: {\n                select: { fieldId: true, required: true },\n              },\n            },\n          })\n        : [];\n\n    if (ticketTypes.length !== requestedIds.length) {\n      throw new ValidationError(\n        \"One or more ticket types do not belong to this event\",\n      );\n    }\n\n    const ticketTypeMap = new Map(\n      ticketTypes.map((tt) => [tt.ticketTypeId, tt]),\n    );\n\n    const now = new Date();\n\n    // ------------------------------------------------------------------\n    // Bundle detection — server-side, from item composition alone. A group\n    // only prices as a bundle when dto.items contains EVERY member at the\n    // EXACT same quantity (see bundle-pricing.util.ts for the full rule).\n    // ------------------------------------------------------------------\n    const touchedGroupIds = [\n      ...new Set(\n        ticketTypes\n          .map((tt) => tt.groupId)\n          .filter((id): id is string => id != null),\n      ),\n    ];\n\n    const groupRows =\n      touchedGroupIds.length > 0\n        ? await prisma.ticketTypeGroup.findMany({\n            where: { groupId: { in: touchedGroupIds }, eventId: dto.eventId },\n            select: {\n              groupId: true,\n              price: true,\n              discountedPrice: true,\n              discountQuantity: true,\n              discountSoldCount: true,\n              ticketTypes: { select: { ticketTypeId: true, price: true } },\n            },\n          })\n        : [];\n\n    const bundleGroups: BundleGroupConfig[] = groupRows.map((g) => ({\n      groupId: g.groupId,\n      price: g.price,\n      discountedPrice: g.discountedPrice,\n      discountQuantity: g.discountQuantity,\n      discountSoldCount: g.discountSoldCount,\n      members: g.ticketTypes.map((m) => ({\n        ticketTypeId: m.ticketTypeId,\n        price: m.price,\n      })),\n    }));\n\n    const matchedBundles = matchBundlePurchases(\n      dto.items.map((i) => ({\n        ticketTypeId: i.ticketTypeId,\n        quantity: i.quantity,\n      })),\n      bundleGroups,\n    );\n    const bundledTicketTypeIds = new Set(\n      matchedBundles.flatMap((b) => b.members.map((m) => m.ticketTypeId)),\n    );\n\n    for (const item of dto.items) {\n      const tt = ticketTypeMap.get(item.ticketTypeId);\n      if (!tt) {\n        throw new NotFoundError(`Ticket type ${item.ticketTypeId} not found`);\n      }\n\n      if (tt.salesCutoff && tt.salesCutoff < now) {\n        throw new ValidationError(\n          `Sales for ticket type \"${tt.name}\" have ended`,\n        );\n      }\n\n      const requiredFields = tt.CustomField.filter((cf) => cf.required);\n      for (let seatIdx = 0; seatIdx < item.quantity; seatIdx++) {\n        const responses = item.ticketFieldResponses[seatIdx];\n        const respondedFieldIds = new Set(responses.map((r) => r.fieldId));\n        for (const field of requiredFields) {\n          if (!respondedFieldIds.has(field.fieldId)) {\n            throw new ValidationError(\n              `Missing required field ${field.fieldId} for ticket type \"${tt.name}\" (seat ${seatIdx + 1})`,\n            );\n          }\n        }\n      }\n    }\n\n    // Required common (event-wide) custom fields — answered once per\n    // booking via dto.commonFieldResponses, not per-seat like the\n    // ticket-type-scoped fields validated above.\n    const commonRequiredFields = await prisma.customField.findMany({\n      where: {\n        eventId: dto.eventId,\n        required: true,\n        ticketTypes: { none: {} },\n      },\n      select: { fieldId: true },\n    });\n    if (commonRequiredFields.length > 0) {\n      const respondedCommonFieldIds = new Set(\n        dto.commonFieldResponses.map((r) => r.fieldId),\n      );\n      for (const field of commonRequiredFields) {\n        if (!respondedCommonFieldIds.has(field.fieldId)) {\n          throw new ValidationError(\n            `Missing required field ${field.fieldId}`,\n          );\n        }\n      }\n    }\n\n    // ------------------------------------------------------------------\n    // Step 1: Build pre-coupon lines with early-bird split.\n    //         Track earlyBirdSaving so discountAmount is accurate.\n    // ------------------------------------------------------------------\n    type PricingLine = {\n      ticketTypeId: string;\n      qty: number;\n      seatFace: number; // per-seat price after early-bird, before coupon\n      wasDiscounted: boolean;\n      bundleGroupId: string | null;\n      bundleWasDiscounted: boolean;\n      feeConfig: Parameters<typeof computeSeatPricing>[1];\n      responses: Array<Array<{ fieldId: string; value: string }>>;\n      // Reserved-seating events only — parallel to `responses`, sliced the\n      // same way across the early-bird boundary.\n      seatIds?: string[];\n    };\n    const priceLines: PricingLine[] = [];\n    let subtotalP = 0; // Σ seatFace × qty (paise; post-early-bird, pre-coupon)\n    let earlyBirdSavingP = 0;\n\n    const itemByTicketTypeId = new Map(\n      dto.items.map((item) => [item.ticketTypeId, item]),\n    );\n\n    for (const bundle of matchedBundles) {\n      const group = bundleGroups.find((g) => g.groupId === bundle.groupId);\n      if (!group) {\n        throw new NotFoundError(`Bundle group ${bundle.groupId} not found`);\n      }\n      // matchBundlePurchases only ever matches groups with a non-null price\n      // (see bundle-pricing.util.ts) — this just narrows the type for below.\n      if (group.price == null) {\n        throw new NotFoundError(\n          `Bundle group ${bundle.groupId} has no price set`,\n        );\n      }\n      // Safety ceiling: a bundle must never cost more than buying its\n      // members individually. Clamp both the full and discounted bundle\n      // price to the sum of members' own list prices, evaluated at\n      // booking time — this self-corrects if a member's price changes\n      // after the group was configured, rather than trusting a\n      // potentially-stale value from group creation time.\n      const memberPriceSum = bundle.members.reduce((sum, m) => {\n        const memberTt = ticketTypeMap.get(m.ticketTypeId);\n        if (!memberTt) {\n          throw new NotFoundError(`Ticket type ${m.ticketTypeId} not found`);\n        }\n        return sum + memberTt.price;\n      }, 0);\n      const { discountSlots, fullSlots } = computeDiscountSplit(\n        {\n          discountedPrice: group.discountedPrice,\n          discountQuantity: group.discountQuantity,\n          discountSoldCount: group.discountSoldCount,\n        },\n        bundle.quantity,\n      );\n\n      const pushBundleSlot = (\n        slotQty: number,\n        bundleUnitPrice: number,\n        wasDiscounted: boolean,\n        responseOffset: number,\n      ) => {\n        if (slotQty <= 0) return;\n        const split = splitAmountProportionally(bundle.members, bundleUnitPrice);\n        for (const member of bundle.members) {\n          const tt = ticketTypeMap.get(member.ticketTypeId);\n          if (!tt) {\n            throw new NotFoundError(\n              `Ticket type ${member.ticketTypeId} not found`,\n            );\n          }\n          const seatFace = split.get(member.ticketTypeId);\n          if (seatFace === undefined) {\n            throw new NotFoundError(\n              `Split amount missing for ticket type ${member.ticketTypeId}`,\n            );\n          }\n          const feeConfig = {\n            platformfee: tt.platformfee,\n            platformfeePerc: tt.platformfeePerc,\n            gatewayFeePerc: tt.gatewayFeePerc,\n            feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n          };\n          const item = itemByTicketTypeId.get(member.ticketTypeId);\n          if (!item) {\n            throw new NotFoundError(\n              `Booking item for ticket type ${member.ticketTypeId} not found`,\n            );\n          }\n          priceLines.push({\n            ticketTypeId: member.ticketTypeId,\n            qty: slotQty,\n            seatFace,\n            wasDiscounted: false, // this seat did NOT use its own type's discount slot\n            bundleGroupId: bundle.groupId,\n            bundleWasDiscounted: wasDiscounted,\n            feeConfig,\n            responses: item.ticketFieldResponses.slice(\n              responseOffset,\n              responseOffset + slotQty,\n            ),\n          });\n          subtotalP += toPaise(seatFace) * slotQty;\n        }\n      };\n\n      if (discountSlots > 0) {\n        const bundlePrice = clampBundlePrice(group.price, memberPriceSum);\n        const discountedBundlePrice =\n          group.discountedPrice != null\n            ? clampBundlePrice(group.discountedPrice, memberPriceSum)\n            : bundlePrice;\n        if (group.discountedPrice != null) {\n          const fullSplit = splitAmountProportionally(bundle.members, bundlePrice);\n          const discSplit = splitAmountProportionally(\n            bundle.members,\n            clampBundlePrice(group.discountedPrice, memberPriceSum),\n          );\n          for (const member of bundle.members) {\n            const fullShare = fullSplit.get(member.ticketTypeId);\n            const discShare = discSplit.get(member.ticketTypeId);\n            if (fullShare === undefined || discShare === undefined) {\n              throw new NotFoundError(\n                `Split amount missing for ticket type ${member.ticketTypeId}`,\n              );\n            }\n            earlyBirdSavingP +=\n              (toPaise(fullShare) - toPaise(discShare)) * discountSlots;\n          }\n        }\n        pushBundleSlot(discountSlots, discountedBundlePrice, true, 0);\n      }\n      if (fullSlots > 0) {\n        pushBundleSlot(\n          fullSlots,\n          clampBundlePrice(group.price, memberPriceSum),\n          false,\n          discountSlots,\n        );\n      }\n    }\n\n    for (const item of dto.items) {\n      if (bundledTicketTypeIds.has(item.ticketTypeId)) {\n        if (item.seatIds && item.seatIds.length > 0) {\n          throw new ValidationError(\n            `Ticket type ${item.ticketTypeId} is part of a bundle — reserved seating does not support bundled ticket types`,\n          );\n        }\n        continue;\n      }\n      const tt = ticketTypeMap.get(item.ticketTypeId);\n      if (!tt) {\n        throw new NotFoundError(`Ticket type ${item.ticketTypeId} not found`);\n      }\n      if (item.seatIds && item.seatIds.length > 0 && tt.groupId != null) {\n        throw new ValidationError(\n          `Ticket type ${item.ticketTypeId} belongs to a bundle group — reserved seating does not support bundled ticket types`,\n        );\n      }\n      const { discountSlots, fullSlots } = computeDiscountSplit(\n        tt,\n        item.quantity,\n      );\n      const feeConfig = {\n        platformfee: tt.platformfee,\n        platformfeePerc: tt.platformfeePerc,\n        gatewayFeePerc: tt.gatewayFeePerc,\n        feeBornBy: tt.feeBornBy as \"HOST\" | \"USER\",\n      };\n\n      if (discountSlots > 0) {\n        const face = tt.discountedPrice ?? tt.price;\n        if (tt.discountedPrice != null) {\n          earlyBirdSavingP +=\n            (toPaise(tt.price) - toPaise(tt.discountedPrice)) * discountSlots;\n        }\n        priceLines.push({\n          ticketTypeId: tt.ticketTypeId,\n          qty: discountSlots,\n          seatFace: face,\n          wasDiscounted: true,\n          bundleGroupId: null,\n          bundleWasDiscounted: false,\n          feeConfig,\n          responses: item.ticketFieldResponses.slice(0, discountSlots),\n          seatIds: item.seatIds?.slice(0, discountSlots),\n        });\n        subtotalP += toPaise(face) * discountSlots;\n      }\n\n      if (fullSlots > 0) {\n        priceLines.push({\n          ticketTypeId: tt.ticketTypeId,\n          qty: fullSlots,\n          seatFace: tt.price,\n          wasDiscounted: false,\n          bundleGroupId: null,\n          bundleWasDiscounted: false,\n          feeConfig,\n          responses: item.ticketFieldResponses.slice(discountSlots),\n          seatIds: item.seatIds?.slice(discountSlots),\n        });\n        subtotalP += toPaise(tt.price) * fullSlots;\n      }\n    }\n    const subtotal = fromPaise(subtotalP);\n    const earlyBirdSaving = fromPaise(earlyBirdSavingP);\n\n    // ------------------------------------------------------------------\n    // Step 2: No coupon at booking-creation time.\n    //         Coupon is applied separately via applyDiscount (PATCH).\n    //         All couponShares are 0; netFace == seatFace for every line.\n    // ------------------------------------------------------------------\n    const couponDiscount = 0;\n    const couponShares = priceLines.map(() => 0); // line-total shares\n\n    // ------------------------------------------------------------------\n    // Step 3: Per-line fee computation using new formulas (with GST).\n    // ------------------------------------------------------------------\n    // Accumulate in integer paise so booking totals are exact (no float drift).\n    let platformFeeP = 0;\n    let gatewayFeeP = 0;\n    let gstP = 0;\n    let totalP = 0;\n    const feeModes = new Set<\"HOST\" | \"USER\">();\n    const lines: Array<{\n      ticketTypeId: string;\n      quantity: number;\n      unitPrice: number;\n      faceValue: number; // per-seat pre-coupon seatFace (stored for audit/reprice)\n      platformFee: number;\n      gatewayFee: number;\n      gst: number;\n      feeBornBy: \"HOST\" | \"USER\";\n      wasDiscounted: boolean;\n      bundleGroupId: string | null;\n      bundleWasDiscounted: boolean;\n      ticketFieldResponses: Array<Array<{ fieldId: string; value: string }>>;\n      seatIds?: string[];\n    }> = [];\n\n    for (let i = 0; i < priceLines.length; i++) {\n      const line = priceLines[i];\n      const couponSharePerSeat =\n        line.qty > 0 ? couponShares[i] / line.qty : 0;\n      const netFace = round2(line.seatFace - couponSharePerSeat);\n\n      const seat = computeSeatPricing(netFace, line.feeConfig, config.TUNYT_GST_ENABLED);\n      feeModes.add(seat.feeBornBy);\n\n      platformFeeP += toPaise(seat.platformFee) * line.qty;\n      gatewayFeeP += toPaise(seat.gatewayFee) * line.qty;\n      gstP += toPaise(seat.gst) * line.qty;\n      totalP += toPaise(seat.buyerPays) * line.qty;\n\n      lines.push({\n        ticketTypeId: line.ticketTypeId,\n        quantity: line.qty,\n        unitPrice: seat.buyerPays,\n        faceValue: line.seatFace, // pre-coupon — stays immutable for reprice\n        platformFee: seat.platformFee,\n        gatewayFee: seat.gatewayFee,\n        gst: seat.gst,\n        feeBornBy: seat.feeBornBy,\n        wasDiscounted: line.wasDiscounted,\n        bundleGroupId: line.bundleGroupId,\n        bundleWasDiscounted: line.bundleWasDiscounted,\n        ticketFieldResponses: line.responses,\n        seatIds: line.seatIds,\n      });\n    }\n\n    const discountAmount = round2(earlyBirdSaving + couponDiscount);\n    const feesBornBy: \"HOST\" | \"USER\" | \"MIXED\" =\n      feeModes.size > 1 ? \"MIXED\" : feeModes.has(\"USER\") ? \"USER\" : \"HOST\";\n\n    return {\n      subtotal,\n      discountAmount,\n      platformFee: fromPaise(platformFeeP),\n      gatewayFee: fromPaise(gatewayFeeP),\n      gst: fromPaise(gstP),\n      total: fromPaise(totalP),\n      feesBornBy,\n      lines,\n    };\n  }\n\n  /**\n   * Reserved-seating events only: checks every requested seatId is real,\n   * belongs to this event's published seat map, matches the ticket type it\n   * was requested under, is currently AVAILABLE, and that the caller still\n   * holds their interactive selection lock on it.\n   *\n   * The interactive-lock check (Redis) is a UX safety net, not the source of\n   * truth — it turns a stale selection into a clear \"reselect your seats\"\n   * error instead of a generic conflict. The DB-level AVAILABLE -> HELD flip\n   * done later inside the create transaction (see\n   * BookingRepository.insertBookingWithTicketsTx) is what actually prevents\n   * two buyers from booking the same seat.\n   */\n  async validateSeatSelections(\n    eventId: string,\n    seatingMode: string,\n    userId: string,\n    items: CreateBookingDto[\"items\"],\n  ): Promise<void> {\n    const anySeatIds = items.some((i) => i.seatIds && i.seatIds.length > 0);\n\n    if (seatingMode !== \"RESERVED\") {\n      if (anySeatIds) {\n        throw new ValidationError(\n          \"This event does not use reserved seating — seatIds are not accepted\",\n        );\n      }\n      return;\n    }\n\n    if (items.length === 0) return;\n\n    if (items.some((i) => !i.seatIds || i.seatIds.length === 0)) {\n      throw new ValidationError(\n        \"seatIds are required for every item on a reserved-seating event\",\n      );\n    }\n\n    const seatMap = await prisma.eventSeatMap.findUnique({\n      where: { eventId },\n      select: { eventSeatMapId: true, publishedAt: true },\n    });\n    if (!seatMap || !seatMap.publishedAt) {\n      throw new ValidationError(\"Seat map is not published for this event\");\n    }\n\n    const allSeatIds = items.flatMap((i) => i.seatIds ?? []);\n    const seats = await prisma.seat.findMany({\n      where: { seatId: { in: allSeatIds } },\n      select: {\n        seatId: true,\n        eventSeatMapId: true,\n        ticketTypeId: true,\n        status: true,\n      },\n    });\n    const seatById = new Map(seats.map((s) => [s.seatId, s]));\n\n    for (const item of items) {\n      for (const seatId of item.seatIds ?? []) {\n        const seat = seatById.get(seatId);\n        if (!seat || seat.eventSeatMapId !== seatMap.eventSeatMapId) {\n          throw new ValidationError(\n            `Seat ${seatId} does not belong to this event`,\n          );\n        }\n        if (seat.ticketTypeId !== item.ticketTypeId) {\n          throw new ValidationError(\n            `Seat ${seatId} is not assigned to ticket type ${item.ticketTypeId}`,\n          );\n        }\n        if (seat.status !== \"AVAILABLE\") {\n          throw new ConflictError(`SEAT_NO_LONGER_AVAILABLE:${seatId}`);\n        }\n      }\n    }\n\n    const lockKeys = allSeatIds.map(\n      (id) => `seat:hold:${seatMap.eventSeatMapId}:${id}`,\n    );\n    const lockValues = lockKeys.length > 0 ? await redis.mget(...lockKeys) : [];\n    const expiredSeatIds = allSeatIds.filter(\n      (_, idx) => lockValues[idx] !== userId,\n    );\n    if (expiredSeatIds.length > 0) {\n      throw new ConflictError(\n        `SEAT_SELECTION_EXPIRED:${expiredSeatIds.join(\",\")}`,\n      );\n    }\n  }\n}\n","numLines":568,"startLine":1,"totalLines":568}},"tool_result_meta":[{"id":"call-b1408b30-8021-4015-ad09-0f9a15842aa0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-0795af61-9509-4304-bb37-ab8040ea8c17","type":"tool_result","content":"1\timport type { EventCustomField, TicketType } from \"./types\";\n2\t\n3\texport type FieldAnswer = { fieldId: string; value: string };\n4\texport type BookingMode = \"rsvp\" | \"free\" | \"paid\" | \"approval\";\n5\texport type BookingStep = 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9;\n6\texport type BookingStepName =\n7\t\t| \"identify\"\n8\t\t| \"select\"\n9\t\t| \"attendees\"\n10\t\t| \"review\"\n11\t\t| \"payment\"\n12\t\t| \"team_setup\"\n13\t\t| \"confirm\"\n14\t\t| \"approval_submitted\"\n15\t\t| \"payment_success\";\n16\texport type BookingStatus =\n17\t\t| \"HELD\"\n18\t\t| \"PAID\"\n19\t\t| \"EXPIRED\"\n20\t\t| \"CANCELLED\"\n21\t\t| \"FAILED\"\n22\t\t| \"PENDING_APPROVAL\"\n23\t\t| \"APPROVED_AWAITING_PAYMENT\";\n24\t\n25\texport interface BookingLineDraft {\n26\t\tticketTypeId: string;\n27\t\tquantity: number;\n28\t\tticketFieldResponses: FieldAnswer[][];\n29\t\t// Reserved-seating events only. When present, length always matches\n30\t\t// quantity — one physical seat per unit of this line. Populated by the\n31\t\t// seat picker (never by the quantity stepper), and passed straight\n32\t\t// through to POST /bookings so the server can bind each ticket to its\n33\t\t// exact seat instead of just decrementing GA inventory.\n34\t\tseatIds?: string[];\n35\t}\n36\t\n37\texport interface CreateBookingRequest {\n38\t\teventId: string;\n39\t\titems: BookingLineDraft[];\n40\t\tcommonFieldResponses: FieldAnswer[];\n41\t\treferrer?: string;\n42\t\tcity?: string;\n43\t\tstate?: string;\n44\t\tsupersedesBookingId?: string;\n45\t}\n46\t\n47\texport interface BookingResponse {\n48\t\tbookingId: string;\n49\t\tuserId: string;\n50\t\teventId: string;\n51\t\tstatus: BookingStatus;\n52\t\tsubtotal: number;\n53\t\tdiscountAmount: number;\n54\t\tplatformFee: number;\n55\t\tgatewayFee?: number;\n56\t\tgst?: number;\n57\t\tfeesBornBy?: \"HOST\" | \"USER\" | \"MIXED\";\n58\t\ttotal: number;\n59\t\tholdExpiresAt: string;\n60\t\ttickets: Array<{\n61\t\t\tticketId: string;\n62\t\t\tquantity: number;\n63\t\t\tqrCode?: string;\n64\t\t\tstatus: string;\n65\t\t\ttotalPrice: number;\n66\t\t\tfaceValue: number;\n67\t\t\tticketType: {\n68\t\t\t\tticketTypeId: string;\n69\t\t\t\tname: string;\n70\t\t\t\tprice: number;\n71\t\t\t\tdiscountedPrice?: number | null;\n72\t\t\t\tdiscountReason?: string | null;\n73\t\t\t};\n74\t\t}>;\n75\t\tevent: {\n76\t\t\teventId: string;\n77\t\t\ttitle: string;\n78\t\t\tdate: string;\n79\t\t\tlocation?: string | null;\n80\t\t};\n81\t\tpayment?: { razorpayOrderId?: string | null; status: string } | null;\n82\t\tdiscountCode?: {\n83\t\t\tcodeId: string;\n84\t\t\tcode: string;\n85\t\t\tdescription?: string | null;\n86\t\t} | null;\n87\t}\n88\t\n89\texport const BOOKING_STEP_NAMES: Record<BookingStep, BookingStepName> = {\n90\t\t1: \"identify\",\n91\t\t2: \"select\",\n92\t\t3: \"attendees\",\n93\t\t4: \"review\",\n94\t\t5: \"payment\",\n95\t\t6: \"team_setup\",\n96\t\t7: \"confirm\",\n97\t\t8: \"approval_submitted\",\n98\t\t9: \"payment_success\",\n99\t};\n100\t\n101\texport function getInitialBookingStep(input: {\n102\t\tisAuthenticated: boolean;\n103\t\tmode?: BookingMode;\n104\t\tautoSelectTicketTypeId?: string;\n105\t\tskipTicketSelection?: boolean;\n106\t}): BookingStep {\n107\t\tconst { isAuthenticated, mode = \"paid\", autoSelectTicketTypeId, skipTicketSelection } = input;\n108\t\tif (mode === \"rsvp\" || (mode === \"free\" && autoSelectTicketTypeId)) {\n109\t\t\treturn isAuthenticated ? 3 : 1;\n110\t\t}\n111\t\tif (mode === \"approval\" && (autoSelectTicketTypeId || skipTicketSelection)) {\n112\t\t\treturn isAuthenticated ? 3 : 1;\n113\t\t}\n114\t\treturn 2;\n115\t}\n116\t\n117\texport function createBookingLine(ticketTypeId: string, quantity: number): BookingLineDraft {\n118\t\treturn {\n119\t\t\tticketTypeId,\n120\t\t\tquantity,\n121\t\t\tticketFieldResponses: Array.from({ length: quantity }, () => []),\n122\t\t};\n123\t}\n124\t\n125\t/** Same shape as createBookingLine, but for reserved-seating picks — quantity\n126\t * is derived from how many seats were selected for this ticket type. */\n127\texport function createSeatBookingLine(ticketTypeId: string, seatIds: string[]): BookingLineDraft {\n128\t\treturn { ...createBookingLine(ticketTypeId, seatIds.length), seatIds };\n129\t}\n130\t\n131\texport function resizeTicketFieldResponses(\n132\t\tprevious: FieldAnswer[][],\n133\t\tquantity: number,\n134\t): FieldAnswer[][] {\n135\t\treturn Array.from({ length: quantity }, (_, index) => previous[index] ?? []);\n136\t}\n137\t\n138\texport function setBookingLineQuantity(\n139\t\tlines: BookingLineDraft[],\n140\t\tticketTypeId: string,\n141\t\tquantity: number,\n142\t): BookingLineDraft[] {\n143\t\tif (quantity <= 0) return lines.filter((line) => line.ticketTypeId !== ticketTypeId);\n144\t\tconst existing = lines.find((line) => line.ticketTypeId === ticketTypeId);\n145\t\tif (!existing) return [...lines, createBookingLine(ticketTypeId, quantity)];\n146\t\treturn lines.map((line) =>\n147\t\t\tline.ticketTypeId === ticketTypeId\n148\t\t\t\t? {\n149\t\t\t\t\t\t...line,\n150\t\t\t\t\t\tquantity,\n151\t\t\t\t\t\tticketFieldResponses: resizeTicketFieldResponses(line.ticketFieldResponses, quantity),\n152\t\t\t\t\t}\n153\t\t\t\t: line,\n154\t\t);\n155\t}\n156\t\n157\texport function getSelectedQuantity(lines: BookingLineDraft[], ticketTypeId: string): number {\n158\t\treturn lines.find((line) => line.ticketTypeId === ticketTypeId)?.quantity ?? 0;\n159\t}\n160\t\n161\texport function hasSelectedTickets(lines: BookingLineDraft[]): boolean {\n162\t\treturn lines.some((line) => line.quantity > 0);\n163\t}\n164\t\n165\texport function isDiscountAvailable(input: {\n166\t\tdiscountQuantity?: number | null;\n167\t\tdiscountSoldCount?: number;\n168\t}): boolean {\n169\t\treturn input.discountQuantity != null && (input.discountSoldCount ?? 0) < input.discountQuantity;\n170\t}\n171\t\n172\texport function hasTicketDiscount(input: {\n173\t\tprice: number;\n174\t\tdiscountedPrice?: number | null;\n175\t\tdiscountQuantity?: number | null;\n176\t\tdiscountSoldCount?: number;\n177\t}): boolean {\n178\t\treturn (\n179\t\t\tinput.discountedPrice != null &&\n180\t\t\tinput.discountedPrice < input.price &&\n181\t\t\tisDiscountAvailable(input)\n182\t\t);\n183\t}\n184\t\n185\texport function effectiveTicketPrice(input: {\n186\t\tprice: number;\n187\t\tdiscountedPrice?: number | null;\n188\t\tdiscountQuantity?: number | null;\n189\t\tdiscountSoldCount?: number;\n190\t}): number {\n191\t\treturn hasTicketDiscount(input) ? (input.discountedPrice as number) : input.price;\n192\t}\n193\t\n194\texport function formatINR(value: number): string {\n195\t\treturn `₹${value.toLocaleString(\"en-IN\")}`;\n196\t}\n197\t\n198\texport function isTeamTicketType(ticketType?: Pick<TicketType, \"minTeamSize\"> | null): boolean {\n199\t\treturn ticketType?.minTeamSize != null;\n200\t}\n201\t\n202\texport function clampTeamQuantity(\n203\t\tquantity: number,\n204\t\tminTeamSize: number,\n205\t\tmaxTeamSize: number,\n206\t): number {\n207\t\treturn Math.min(Math.max(quantity, minTeamSize), maxTeamSize);\n208\t}\n209\t\n210\texport function validateTeamName(name: string): string {\n211\t\tconst trimmed = name.trim();\n212\t\tif (trimmed.length < 3 || trimmed.length > 100) {\n213\t\t\treturn \"Team name must be 3–100 characters.\";\n214\t\t}\n215\t\treturn \"\";\n216\t}\n217\t\n218\texport function shouldCollectAttendees(input: {\n219\t\tisTeamBooking?: boolean;\n220\t\thasEventFields?: boolean;\n221\t\tselectedTicketTypesHaveFields?: boolean;\n222\t\tisLoading?: boolean;\n223\t\thasQueryError?: boolean;\n224\t}): boolean | undefined {\n225\t\tif (input.isTeamBooking) return false;\n226\t\tif (input.isLoading) return undefined;\n227\t\tif (input.hasQueryError) return true;\n228\t\treturn !!input.hasEventFields || !!input.selectedTicketTypesHaveFields;\n229\t}\n230\t\n231\texport function getVisibleBookingSteps(input: {\n232\t\tisAuthenticated: boolean;\n233\t\tneedsAttendees?: boolean;\n234\t}): BookingStep[] {\n235\t\treturn [\n236\t\t\t...(input.isAuthenticated ? [] : ([1] as BookingStep[])),\n237\t\t\t2,\n238\t\t\t...(input.needsAttendees !== false ? ([3] as BookingStep[]) : []),\n239\t\t\t4,\n240\t\t\t5,\n241\t\t];\n242\t}\n243\t\n244\texport function isRequiredFieldAnswered(value: string | undefined | null): boolean {\n245\t\treturn !!value?.trim();\n246\t}\n247\t\n248\texport function validateRequiredFieldAnswers(\n249\t\tfields: Pick<EventCustomField, \"fieldId\" | \"required\">[],\n250\t\tvalues: Record<string, string | undefined>,\n251\t): Record<string, string> {\n252\t\tconst errors: Record<string, string> = {};\n253\t\tfor (const field of fields) {\n254\t\t\tif (field.required && !isRequiredFieldAnswered(values[field.fieldId])) {\n255\t\t\t\terrors[field.fieldId] = \"Required\";\n256\t\t\t}\n257\t\t}\n258\t\treturn errors;\n259\t}\n260\t\n261\texport function buildCreateBookingRequest(input: {\n262\t\teventId: string;\n263\t\tlines: BookingLineDraft[];\n264\t\tcommonFieldResponses?: FieldAnswer[];\n265\t\treferrer?: string;\n266\t\tcity?: string;\n267\t\tstate?: string;\n268\t\tsupersedesBookingId?: string;\n269\t}): CreateBookingRequest {\n270\t\treturn {\n271\t\t\teventId: input.eventId,\n272\t\t\titems: input.lines.filter((line) => line.quantity > 0),\n273\t\t\tcommonFieldResponses: input.commonFieldResponses ?? [],\n274\t\t\treferrer: input.referrer,\n275\t\t\tcity: input.city,\n276\t\t\tstate: input.state,\n277\t\t\tsupersedesBookingId: input.supersedesBookingId,\n278\t\t};\n279\t}\n280\t\n281\texport function isActiveBookingStatus(status?: BookingStatus | string | null): boolean {\n282\t\treturn status === \"HELD\" || status === \"APPROVED_AWAITING_PAYMENT\";\n283\t}\n284\t\n285\texport function isTerminalBookingStatus(status?: BookingStatus | string | null): boolean {\n286\t\treturn status === \"EXPIRED\" || status === \"CANCELLED\" || status === \"FAILED\";\n287\t}\n288\t\n289\texport function isPaidBookingStatus(status?: BookingStatus | string | null): boolean {\n290\t\treturn status === \"PAID\";\n291\t}\n292\t\n293\texport function isBookingHoldActive(\n294\t\tinput?: {\n295\t\t\tstatus?: BookingStatus | string | null;\n296\t\t\tholdExpiresAt?: string | null;\n297\t\t} | null,\n298\t): boolean {\n299\t\tif (!input || input.status !== \"HELD\" || !input.holdExpiresAt) return false;\n300\t\treturn new Date(input.holdExpiresAt).getTime() > Date.now();\n301\t}\n302\t\n303\texport function bookingGoesToApprovalSubmitted(input: {\n304\t\tmode: BookingMode;\n305\t\tbooking: Pick<BookingResponse, \"status\" | \"total\">;\n306\t}): boolean {\n307\t\treturn input.mode === \"approval\" && input.booking.status === \"PENDING_APPROVAL\";\n308\t}\n309\t\n310\texport function getPostBookingStep(input: {\n311\t\tmode: BookingMode;\n312\t\tbooking: Pick<BookingResponse, \"status\" | \"total\">;\n313\t}): BookingStep {\n314\t\tif (bookingGoesToApprovalSubmitted(input)) return 8;\n315\t\treturn input.booking.total === 0 ? 7 : 4;\n316\t}\n317\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"ace7b99d-1ca1-4623-97c6-d8a6639853b0","timestamp":"2026-11-20T19:07:36.684Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/packages/tunyt-shared/src/booking.ts","content":"import type { EventCustomField, TicketType } from \"./types\";\n\nexport type FieldAnswer = { fieldId: string; value: string };\nexport type BookingMode = \"rsvp\" | \"free\" | \"paid\" | \"approval\";\nexport type BookingStep = 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9;\nexport type BookingStepName =\n\t| \"identify\"\n\t| \"select\"\n\t| \"attendees\"\n\t| \"review\"\n\t| \"payment\"\n\t| \"team_setup\"\n\t| \"confirm\"\n\t| \"approval_submitted\"\n\t| \"payment_success\";\nexport type BookingStatus =\n\t| \"HELD\"\n\t| \"PAID\"\n\t| \"EXPIRED\"\n\t| \"CANCELLED\"\n\t| \"FAILED\"\n\t| \"PENDING_APPROVAL\"\n\t| \"APPROVED_AWAITING_PAYMENT\";\n\nexport interface BookingLineDraft {\n\tticketTypeId: string;\n\tquantity: number;\n\tticketFieldResponses: FieldAnswer[][];\n\t// Reserved-seating events only. When present, length always matches\n\t// quantity — one physical seat per unit of this line. Populated by the\n\t// seat picker (never by the quantity stepper), and passed straight\n\t// through to POST /bookings so the server can bind each ticket to its\n\t// exact seat instead of just decrementing GA inventory.\n\tseatIds?: string[];\n}\n\nexport interface CreateBookingRequest {\n\teventId: string;\n\titems: BookingLineDraft[];\n\tcommonFieldResponses: FieldAnswer[];\n\treferrer?: string;\n\tcity?: string;\n\tstate?: string;\n\tsupersedesBookingId?: string;\n}\n\nexport interface BookingResponse {\n\tbookingId: string;\n\tuserId: string;\n\teventId: string;\n\tstatus: BookingStatus;\n\tsubtotal: number;\n\tdiscountAmount: number;\n\tplatformFee: number;\n\tgatewayFee?: number;\n\tgst?: number;\n\tfeesBornBy?: \"HOST\" | \"USER\" | \"MIXED\";\n\ttotal: number;\n\tholdExpiresAt: string;\n\ttickets: Array<{\n\t\tticketId: string;\n\t\tquantity: number;\n\t\tqrCode?: string;\n\t\tstatus: string;\n\t\ttotalPrice: number;\n\t\tfaceValue: number;\n\t\tticketType: {\n\t\t\tticketTypeId: string;\n\t\t\tname: string;\n\t\t\tprice: number;\n\t\t\tdiscountedPrice?: number | null;\n\t\t\tdiscountReason?: string | null;\n\t\t};\n\t}>;\n\tevent: {\n\t\teventId: string;\n\t\ttitle: string;\n\t\tdate: string;\n\t\tlocation?: string | null;\n\t};\n\tpayment?: { razorpayOrderId?: string | null; status: string } | null;\n\tdiscountCode?: {\n\t\tcodeId: string;\n\t\tcode: string;\n\t\tdescription?: string | null;\n\t} | null;\n}\n\nexport const BOOKING_STEP_NAMES: Record<BookingStep, BookingStepName> = {\n\t1: \"identify\",\n\t2: \"select\",\n\t3: \"attendees\",\n\t4: \"review\",\n\t5: \"payment\",\n\t6: \"team_setup\",\n\t7: \"confirm\",\n\t8: \"approval_submitted\",\n\t9: \"payment_success\",\n};\n\nexport function getInitialBookingStep(input: {\n\tisAuthenticated: boolean;\n\tmode?: BookingMode;\n\tautoSelectTicketTypeId?: string;\n\tskipTicketSelection?: boolean;\n}): BookingStep {\n\tconst { isAuthenticated, mode = \"paid\", autoSelectTicketTypeId, skipTicketSelection } = input;\n\tif (mode === \"rsvp\" || (mode === \"free\" && autoSelectTicketTypeId)) {\n\t\treturn isAuthenticated ? 3 : 1;\n\t}\n\tif (mode === \"approval\" && (autoSelectTicketTypeId || skipTicketSelection)) {\n\t\treturn isAuthenticated ? 3 : 1;\n\t}\n\treturn 2;\n}\n\nexport function createBookingLine(ticketTypeId: string, quantity: number): BookingLineDraft {\n\treturn {\n\t\tticketTypeId,\n\t\tquantity,\n\t\tticketFieldResponses: Array.from({ length: quantity }, () => []),\n\t};\n}\n\n/** Same shape as createBookingLine, but for reserved-seating picks — quantity\n * is derived from how many seats were selected for this ticket type. */\nexport function createSeatBookingLine(ticketTypeId: string, seatIds: string[]): BookingLineDraft {\n\treturn { ...createBookingLine(ticketTypeId, seatIds.length), seatIds };\n}\n\nexport function resizeTicketFieldResponses(\n\tprevious: FieldAnswer[][],\n\tquantity: number,\n): FieldAnswer[][] {\n\treturn Array.from({ length: quantity }, (_, index) => previous[index] ?? []);\n}\n\nexport function setBookingLineQuantity(\n\tlines: BookingLineDraft[],\n\tticketTypeId: string,\n\tquantity: number,\n): BookingLineDraft[] {\n\tif (quantity <= 0) return lines.filter((line) => line.ticketTypeId !== ticketTypeId);\n\tconst existing = lines.find((line) => line.ticketTypeId === ticketTypeId);\n\tif (!existing) return [...lines, createBookingLine(ticketTypeId, quantity)];\n\treturn lines.map((line) =>\n\t\tline.ticketTypeId === ticketTypeId\n\t\t\t? {\n\t\t\t\t\t...line,\n\t\t\t\t\tquantity,\n\t\t\t\t\tticketFieldResponses: resizeTicketFieldResponses(line.ticketFieldResponses, quantity),\n\t\t\t\t}\n\t\t\t: line,\n\t);\n}\n\nexport function getSelectedQuantity(lines: BookingLineDraft[], ticketTypeId: string): number {\n\treturn lines.find((line) => line.ticketTypeId === ticketTypeId)?.quantity ?? 0;\n}\n\nexport function hasSelectedTickets(lines: BookingLineDraft[]): boolean {\n\treturn lines.some((line) => line.quantity > 0);\n}\n\nexport function isDiscountAvailable(input: {\n\tdiscountQuantity?: number | null;\n\tdiscountSoldCount?: number;\n}): boolean {\n\treturn input.discountQuantity != null && (input.discountSoldCount ?? 0) < input.discountQuantity;\n}\n\nexport function hasTicketDiscount(input: {\n\tprice: number;\n\tdiscountedPrice?: number | null;\n\tdiscountQuantity?: number | null;\n\tdiscountSoldCount?: number;\n}): boolean {\n\treturn (\n\t\tinput.discountedPrice != null &&\n\t\tinput.discountedPrice < input.price &&\n\t\tisDiscountAvailable(input)\n\t);\n}\n\nexport function effectiveTicketPrice(input: {\n\tprice: number;\n\tdiscountedPrice?: number | null;\n\tdiscountQuantity?: number | null;\n\tdiscountSoldCount?: number;\n}): number {\n\treturn hasTicketDiscount(input) ? (input.discountedPrice as number) : input.price;\n}\n\nexport function formatINR(value: number): string {\n\treturn `₹${value.toLocaleString(\"en-IN\")}`;\n}\n\nexport function isTeamTicketType(ticketType?: Pick<TicketType, \"minTeamSize\"> | null): boolean {\n\treturn ticketType?.minTeamSize != null;\n}\n\nexport function clampTeamQuantity(\n\tquantity: number,\n\tminTeamSize: number,\n\tmaxTeamSize: number,\n): number {\n\treturn Math.min(Math.max(quantity, minTeamSize), maxTeamSize);\n}\n\nexport function validateTeamName(name: string): string {\n\tconst trimmed = name.trim();\n\tif (trimmed.length < 3 || trimmed.length > 100) {\n\t\treturn \"Team name must be 3–100 characters.\";\n\t}\n\treturn \"\";\n}\n\nexport function shouldCollectAttendees(input: {\n\tisTeamBooking?: boolean;\n\thasEventFields?: boolean;\n\tselectedTicketTypesHaveFields?: boolean;\n\tisLoading?: boolean;\n\thasQueryError?: boolean;\n}): boolean | undefined {\n\tif (input.isTeamBooking) return false;\n\tif (input.isLoading) return undefined;\n\tif (input.hasQueryError) return true;\n\treturn !!input.hasEventFields || !!input.selectedTicketTypesHaveFields;\n}\n\nexport function getVisibleBookingSteps(input: {\n\tisAuthenticated: boolean;\n\tneedsAttendees?: boolean;\n}): BookingStep[] {\n\treturn [\n\t\t...(input.isAuthenticated ? [] : ([1] as BookingStep[])),\n\t\t2,\n\t\t...(input.needsAttendees !== false ? ([3] as BookingStep[]) : []),\n\t\t4,\n\t\t5,\n\t];\n}\n\nexport function isRequiredFieldAnswered(value: string | undefined | null): boolean {\n\treturn !!value?.trim();\n}\n\nexport function validateRequiredFieldAnswers(\n\tfields: Pick<EventCustomField, \"fieldId\" | \"required\">[],\n\tvalues: Record<string, string | undefined>,\n): Record<string, string> {\n\tconst errors: Record<string, string> = {};\n\tfor (const field of fields) {\n\t\tif (field.required && !isRequiredFieldAnswered(values[field.fieldId])) {\n\t\t\terrors[field.fieldId] = \"Required\";\n\t\t}\n\t}\n\treturn errors;\n}\n\nexport function buildCreateBookingRequest(input: {\n\teventId: string;\n\tlines: BookingLineDraft[];\n\tcommonFieldResponses?: FieldAnswer[];\n\treferrer?: string;\n\tcity?: string;\n\tstate?: string;\n\tsupersedesBookingId?: string;\n}): CreateBookingRequest {\n\treturn {\n\t\teventId: input.eventId,\n\t\titems: input.lines.filter((line) => line.quantity > 0),\n\t\tcommonFieldResponses: input.commonFieldResponses ?? [],\n\t\treferrer: input.referrer,\n\t\tcity: input.city,\n\t\tstate: input.state,\n\t\tsupersedesBookingId: input.supersedesBookingId,\n\t};\n}\n\nexport function isActiveBookingStatus(status?: BookingStatus | string | null): boolean {\n\treturn status === \"HELD\" || status === \"APPROVED_AWAITING_PAYMENT\";\n}\n\nexport function isTerminalBookingStatus(status?: BookingStatus | string | null): boolean {\n\treturn status === \"EXPIRED\" || status === \"CANCELLED\" || status === \"FAILED\";\n}\n\nexport function isPaidBookingStatus(status?: BookingStatus | string | null): boolean {\n\treturn status === \"PAID\";\n}\n\nexport function isBookingHoldActive(\n\tinput?: {\n\t\tstatus?: BookingStatus | string | null;\n\t\tholdExpiresAt?: string | null;\n\t} | null,\n): boolean {\n\tif (!input || input.status !== \"HELD\" || !input.holdExpiresAt) return false;\n\treturn new Date(input.holdExpiresAt).getTime() > Date.now();\n}\n\nexport function bookingGoesToApprovalSubmitted(input: {\n\tmode: BookingMode;\n\tbooking: Pick<BookingResponse, \"status\" | \"total\">;\n}): boolean {\n\treturn input.mode === \"approval\" && input.booking.status === \"PENDING_APPROVAL\";\n}\n\nexport function getPostBookingStep(input: {\n\tmode: BookingMode;\n\tbooking: Pick<BookingResponse, \"status\" | \"total\">;\n}): BookingStep {\n\tif (bookingGoesToApprovalSubmitted(input)) return 8;\n\treturn input.booking.total === 0 ? 7 : 4;\n}\n","numLines":317,"startLine":1,"totalLines":317}},"tool_result_meta":[{"id":"call-0795af61-9509-4304-bb37-ab8040ea8c17","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
