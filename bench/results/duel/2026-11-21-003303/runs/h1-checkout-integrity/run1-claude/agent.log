{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-ac53d9d2-d18a-4522-9562-76d55e2e93b2","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport { BookingStatus } from \"../../generated/prisma/enums\";\n3\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n4\timport { generateTicketCode } from \"../../utils/qr-code.util\";\n5\t\n6\texport class BookingTeamRepository {\n7\t  /**\n8\t   * Create a minimal HELD Booking for a team payment (no inventory reservation —\n9\t   * team.service already called incrementSoldCount separately).\n10\t   */\n11\t  async createForTeam(data: {\n12\t    userId: string;\n13\t    eventId: string;\n14\t    subtotal: number;\n15\t    platformFee: number;\n16\t    gatewayFee: number;\n17\t    gst: number;\n18\t    total: number;\n19\t    feesBornBy: \"HOST\" | \"USER\";\n20\t    holdExpiresAt: Date;\n21\t  }): Promise<string> {\n22\t    return wrapDatabaseOperation(async () => {\n23\t      const qrCode = generateTicketCode();\n24\t      const booking = await prisma.booking.create({\n25\t        data: {\n26\t          userId: data.userId,\n27\t          eventId: data.eventId,\n28\t          status: BookingStatus.HELD,\n29\t          subtotal: data.subtotal,\n30\t          platformFee: data.platformFee,\n31\t          gatewayFee: data.gatewayFee,\n32\t          gst: data.gst,\n33\t          feesBornBy: data.feesBornBy as any,\n34\t          total: data.total,\n35\t          holdExpiresAt: data.holdExpiresAt,\n36\t          qrCode,\n37\t        },\n38\t        select: { bookingId: true },\n39\t      });\n40\t      return booking.bookingId;\n41\t    }, \"Create team booking\");\n42\t  }\n43\t\n44\t  /**\n45\t   * Link specific tickets to a booking (for existing team tickets that\n46\t   * predate the booking-creation logic). Scoped to `ticketIds` explicitly —\n47\t   * NOT a blanket `{ teamId, bookingId: null }` sweep — because a team can\n48\t   * have other null-bookingId tickets in flight from an unrelated attempt\n49\t   * (e.g. a split-pay ticket that hasn't settled yet). A blanket sweep would\n50\t   * silently attach those to this booking too, and once this booking gets\n51\t   * paid, `markPaidTx`'s own blanket `WHERE bookingId` update would flip them\n52\t   * to SUCCESS alongside the real ones — minting extra \"paid\" tickets for a\n53\t   * purchase that never happened. Callers must pass exactly the ticket IDs\n54\t   * they intend to link.\n55\t   */\n56\t  async linkTicketsToBooking(\n57\t    bookingId: string,\n58\t    ticketIds: string[],\n59\t  ): Promise<void> {\n60\t    if (ticketIds.length === 0) return;\n61\t    return wrapDatabaseOperation(async () => {\n62\t      await prisma.ticket.updateMany({\n63\t        where: { ticketId: { in: ticketIds }, bookingId: null },\n64\t        data: { bookingId },\n65\t      });\n66\t    }, \"Link team tickets to booking\");\n67\t  }\n68\t\n69\t  /**\n70\t   * Link previously-unlinked tickets onto a booking that ALREADY has other\n71\t   * tickets settled on it, growing the booking's money fields to include\n72\t   * them. Unlike linkTicketsToBooking (for a fresh booking whose total was\n73\t   * computed to match exactly the tickets about to be linked), this is for\n74\t   * extending an existing booking after the fact — e.g. a team-split\n75\t   * settlement where some members' tickets already carry the team's\n76\t   * bookingId and others (a self-healed replacement ticket, or a member\n77\t   * settled in a later pass) don't yet. Skipping the increment here is what\n78\t   * caused a real revenue undercount: Razorpay had fully captured every\n79\t   * member's payment, but the booking's total/fees only ever reflected the\n80\t   * first-linked ticket, silently shorting the host's payout balance.\n81\t   */\n82\t  async growBookingWithTickets(\n83\t    bookingId: string,\n84\t    ticketIds: string[],\n85\t    amounts: {\n86\t      subtotal: number;\n87\t      platformFee: number;\n88\t      gatewayFee: number;\n89\t      gst: number;\n90\t      total: number;\n91\t    },\n92\t  ): Promise<void> {\n93\t    if (ticketIds.length === 0) return;\n94\t    return wrapDatabaseOperation(async () => {\n95\t      await prisma.$transaction([\n96\t        prisma.ticket.updateMany({\n97\t          where: { ticketId: { in: ticketIds }, bookingId: null },\n98\t          data: { bookingId },\n99\t        }),\n100\t        prisma.booking.update({\n101\t          where: { bookingId },\n102\t          data: {\n103\t            subtotal: { increment: amounts.subtotal },\n104\t            platformFee: { increment: amounts.platformFee },\n105\t            gatewayFee: { increment: amounts.gatewayFee },\n106\t            gst: { increment: amounts.gst },\n107\t            total: { increment: amounts.total },\n108\t          },\n109\t        }),\n110\t      ]);\n111\t    }, \"Grow existing booking with newly-linked tickets\");\n112\t  }\n113\t\n114\t  /**\n115\t   * Cancel a HELD team booking without touching ticket status.\n116\t   * Used when the leader switches to split payment after having clicked\n117\t   * \"Pay for everyone\" — we need to kill the short-lived hold so the\n118\t   * expiry cleaner never runs releaseHoldTx and marks paid tickets FAILED.\n119\t   * Tickets are also unlinked (bookingId → null) so they're invisible to\n120\t   * any future hold queries.\n121\t   */\n122\t  async cancelTeamBookingHold(bookingId: string): Promise<void> {\n123\t    return wrapDatabaseOperation(async () => {\n124\t      await prisma.$transaction([\n125\t        prisma.booking.updateMany({\n126\t          where: { bookingId, status: BookingStatus.HELD },\n127\t          data: { status: BookingStatus.CANCELLED },\n128\t        }),\n129\t        prisma.ticket.updateMany({\n130\t          where: { bookingId },\n131\t          data: { bookingId: null },\n132\t        }),\n133\t      ]);\n134\t    }, \"Cancel team booking hold\");\n135\t  }\n136\t\n137\t  /**\n138\t   * Re-price a HELD team booking that's being reused across a \"Pay for\n139\t   * everyone\" retry. The owing-member count can drift between when the\n140\t   * booking was first created and when it's reused (a member paid via\n141\t   * merge, or a new member joined, while the 30-minute hold was open) —\n142\t   * this brings the booking's stored totals back in line with today's\n143\t   * owing set. Each existing ticket's own totalPrice doesn't need\n144\t   * touching here, because it's already the fee-inclusive per-seat amount\n145\t   * (seat.buyerPays from fee-pricing.util's computeSeatPricing, BEFORE\n146\t   * scaling by quantity) set at ticket-creation time — that per-seat value\n147\t   * doesn't change when the owing-member count changes, only the booking's\n148\t   * summed total does. Any ticket write elsewhere must use that same\n149\t   * fee-inclusive per-seat value, not the raw ticketType price/\n150\t   * discountedPrice — see team.service.ts's createTeamBooking /\n151\t   * prepareTeamForPayment.\n152\t   */\n153\t  async repriceTeamBooking(\n154\t    bookingId: string,\n155\t    patch: {\n156\t      subtotal: number;\n157\t      platformFee: number;\n158\t      gatewayFee: number;\n159\t      gst: number;\n160\t      total: number;\n161\t    },\n162\t  ) {\n163\t    return wrapDatabaseOperation(async () => {\n164\t      await prisma.booking.update({\n165\t        where: { bookingId },\n166\t        data: {\n167\t          subtotal: patch.subtotal,\n168\t          platformFee: patch.platformFee,\n169\t          gatewayFee: patch.gatewayFee,\n170\t          gst: patch.gst,\n171\t          total: patch.total,\n172\t        },\n173\t      });\n174\t    }, \"Reprice team booking on reuse\");\n175\t  }\n176\t\n177\t  /**\n178\t   * Reconcile which tickets are linked to a reused team booking after the\n179\t   * owing-member set may have changed since it was first created (someone\n180\t   * left or joined while the HELD hold was open). Links any currently-owing\n181\t   * member's ticket that isn't attached yet, and — the part that was\n182\t   * missing, see fix-team-codex-* repair scripts for the incident this\n183\t   * covers — unlinks any ticket still attached to this booking that no\n184\t   * longer belongs to a currently-owing member. Without the unlink half,\n185\t   * markPaidTx's blanket `WHERE bookingId` update at capture time flips a\n186\t   * departed member's stale ticket to SUCCESS alongside the real ones,\n187\t   * even though their seat was never priced into what actually got\n188\t   * captured. Always call this alongside repriceTeamBooking, not instead\n189\t   * of linkTicketsToBooking on a fresh booking (that path only ever grows).\n190\t   */\n191\t  async reconcileTeamBookingTickets(\n192\t    bookingId: string,\n193\t    keepTicketIds: string[],\n194\t  ): Promise<void> {\n195\t    return wrapDatabaseOperation(async () => {\n196\t      await prisma.$transaction([\n197\t        prisma.ticket.updateMany({\n198\t          where: { ticketId: { in: keepTicketIds }, bookingId: null },\n199\t          data: { bookingId },\n200\t        }),\n201\t        prisma.ticket.updateMany({\n202\t          where: { bookingId, ticketId: { notIn: keepTicketIds } },\n203\t          data: { bookingId: null },\n204\t        }),\n205\t      ]);\n206\t    }, \"Reconcile team booking tickets on reuse\");\n207\t  }\n208\t}\n209\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"fcdd56d3-48c5-4c17-848b-d814549d335a","timestamp":"2026-11-20T19:08:23.123Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/repositories/booking/booking-team.repository.ts","content":"import { prisma } from \"../../config/db\";\nimport { BookingStatus } from \"../../generated/prisma/enums\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\nimport { generateTicketCode } from \"../../utils/qr-code.util\";\n\nexport class BookingTeamRepository {\n  /**\n   * Create a minimal HELD Booking for a team payment (no inventory reservation —\n   * team.service already called incrementSoldCount separately).\n   */\n  async createForTeam(data: {\n    userId: string;\n    eventId: string;\n    subtotal: number;\n    platformFee: number;\n    gatewayFee: number;\n    gst: number;\n    total: number;\n    feesBornBy: \"HOST\" | \"USER\";\n    holdExpiresAt: Date;\n  }): Promise<string> {\n    return wrapDatabaseOperation(async () => {\n      const qrCode = generateTicketCode();\n      const booking = await prisma.booking.create({\n        data: {\n          userId: data.userId,\n          eventId: data.eventId,\n          status: BookingStatus.HELD,\n          subtotal: data.subtotal,\n          platformFee: data.platformFee,\n          gatewayFee: data.gatewayFee,\n          gst: data.gst,\n          feesBornBy: data.feesBornBy as any,\n          total: data.total,\n          holdExpiresAt: data.holdExpiresAt,\n          qrCode,\n        },\n        select: { bookingId: true },\n      });\n      return booking.bookingId;\n    }, \"Create team booking\");\n  }\n\n  /**\n   * Link specific tickets to a booking (for existing team tickets that\n   * predate the booking-creation logic). Scoped to `ticketIds` explicitly —\n   * NOT a blanket `{ teamId, bookingId: null }` sweep — because a team can\n   * have other null-bookingId tickets in flight from an unrelated attempt\n   * (e.g. a split-pay ticket that hasn't settled yet). A blanket sweep would\n   * silently attach those to this booking too, and once this booking gets\n   * paid, `markPaidTx`'s own blanket `WHERE bookingId` update would flip them\n   * to SUCCESS alongside the real ones — minting extra \"paid\" tickets for a\n   * purchase that never happened. Callers must pass exactly the ticket IDs\n   * they intend to link.\n   */\n  async linkTicketsToBooking(\n    bookingId: string,\n    ticketIds: string[],\n  ): Promise<void> {\n    if (ticketIds.length === 0) return;\n    return wrapDatabaseOperation(async () => {\n      await prisma.ticket.updateMany({\n        where: { ticketId: { in: ticketIds }, bookingId: null },\n        data: { bookingId },\n      });\n    }, \"Link team tickets to booking\");\n  }\n\n  /**\n   * Link previously-unlinked tickets onto a booking that ALREADY has other\n   * tickets settled on it, growing the booking's money fields to include\n   * them. Unlike linkTicketsToBooking (for a fresh booking whose total was\n   * computed to match exactly the tickets about to be linked), this is for\n   * extending an existing booking after the fact — e.g. a team-split\n   * settlement where some members' tickets already carry the team's\n   * bookingId and others (a self-healed replacement ticket, or a member\n   * settled in a later pass) don't yet. Skipping the increment here is what\n   * caused a real revenue undercount: Razorpay had fully captured every\n   * member's payment, but the booking's total/fees only ever reflected the\n   * first-linked ticket, silently shorting the host's payout balance.\n   */\n  async growBookingWithTickets(\n    bookingId: string,\n    ticketIds: string[],\n    amounts: {\n      subtotal: number;\n      platformFee: number;\n      gatewayFee: number;\n      gst: number;\n      total: number;\n    },\n  ): Promise<void> {\n    if (ticketIds.length === 0) return;\n    return wrapDatabaseOperation(async () => {\n      await prisma.$transaction([\n        prisma.ticket.updateMany({\n          where: { ticketId: { in: ticketIds }, bookingId: null },\n          data: { bookingId },\n        }),\n        prisma.booking.update({\n          where: { bookingId },\n          data: {\n            subtotal: { increment: amounts.subtotal },\n            platformFee: { increment: amounts.platformFee },\n            gatewayFee: { increment: amounts.gatewayFee },\n            gst: { increment: amounts.gst },\n            total: { increment: amounts.total },\n          },\n        }),\n      ]);\n    }, \"Grow existing booking with newly-linked tickets\");\n  }\n\n  /**\n   * Cancel a HELD team booking without touching ticket status.\n   * Used when the leader switches to split payment after having clicked\n   * \"Pay for everyone\" — we need to kill the short-lived hold so the\n   * expiry cleaner never runs releaseHoldTx and marks paid tickets FAILED.\n   * Tickets are also unlinked (bookingId → null) so they're invisible to\n   * any future hold queries.\n   */\n  async cancelTeamBookingHold(bookingId: string): Promise<void> {\n    return wrapDatabaseOperation(async () => {\n      await prisma.$transaction([\n        prisma.booking.updateMany({\n          where: { bookingId, status: BookingStatus.HELD },\n          data: { status: BookingStatus.CANCELLED },\n        }),\n        prisma.ticket.updateMany({\n          where: { bookingId },\n          data: { bookingId: null },\n        }),\n      ]);\n    }, \"Cancel team booking hold\");\n  }\n\n  /**\n   * Re-price a HELD team booking that's being reused across a \"Pay for\n   * everyone\" retry. The owing-member count can drift between when the\n   * booking was first created and when it's reused (a member paid via\n   * merge, or a new member joined, while the 30-minute hold was open) —\n   * this brings the booking's stored totals back in line with today's\n   * owing set. Each existing ticket's own totalPrice doesn't need\n   * touching here, because it's already the fee-inclusive per-seat amount\n   * (seat.buyerPays from fee-pricing.util's computeSeatPricing, BEFORE\n   * scaling by quantity) set at ticket-creation time — that per-seat value\n   * doesn't change when the owing-member count changes, only the booking's\n   * summed total does. Any ticket write elsewhere must use that same\n   * fee-inclusive per-seat value, not the raw ticketType price/\n   * discountedPrice — see team.service.ts's createTeamBooking /\n   * prepareTeamForPayment.\n   */\n  async repriceTeamBooking(\n    bookingId: string,\n    patch: {\n      subtotal: number;\n      platformFee: number;\n      gatewayFee: number;\n      gst: number;\n      total: number;\n    },\n  ) {\n    return wrapDatabaseOperation(async () => {\n      await prisma.booking.update({\n        where: { bookingId },\n        data: {\n          subtotal: patch.subtotal,\n          platformFee: patch.platformFee,\n          gatewayFee: patch.gatewayFee,\n          gst: patch.gst,\n          total: patch.total,\n        },\n      });\n    }, \"Reprice team booking on reuse\");\n  }\n\n  /**\n   * Reconcile which tickets are linked to a reused team booking after the\n   * owing-member set may have changed since it was first created (someone\n   * left or joined while the HELD hold was open). Links any currently-owing\n   * member's ticket that isn't attached yet, and — the part that was\n   * missing, see fix-team-codex-* repair scripts for the incident this\n   * covers — unlinks any ticket still attached to this booking that no\n   * longer belongs to a currently-owing member. Without the unlink half,\n   * markPaidTx's blanket `WHERE bookingId` update at capture time flips a\n   * departed member's stale ticket to SUCCESS alongside the real ones,\n   * even though their seat was never priced into what actually got\n   * captured. Always call this alongside repriceTeamBooking, not instead\n   * of linkTicketsToBooking on a fresh booking (that path only ever grows).\n   */\n  async reconcileTeamBookingTickets(\n    bookingId: string,\n    keepTicketIds: string[],\n  ): Promise<void> {\n    return wrapDatabaseOperation(async () => {\n      await prisma.$transaction([\n        prisma.ticket.updateMany({\n          where: { ticketId: { in: keepTicketIds }, bookingId: null },\n          data: { bookingId },\n        }),\n        prisma.ticket.updateMany({\n          where: { bookingId, ticketId: { notIn: keepTicketIds } },\n          data: { bookingId: null },\n        }),\n      ]);\n    }, \"Reconcile team booking tickets on reuse\");\n  }\n}\n","numLines":209,"startLine":1,"totalLines":209}},"tool_result_meta":[{"id":"call-ac53d9d2-d18a-4522-9562-76d55e2e93b2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"msg_0d9c9c20-f6bf-452a-8687-38e931c7a522","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call-b8c2af92-9434-4155-9246-a38d933f48a1","name":"Bash","input":{"command":"cat src/workers/refund.worker.ts | head -80 && echo \"=== razorpay factory ===\" && cat src/lib/razorpay-factory.ts | head -80","description":"Read refund worker and razorpay factory"}}],"model":"MiniMaxAI/MiniMax-M3","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"54761066-93f7-4bf7-b01d-fd4509c9f1f6","timestamp":"2026-11-20T19:08:23.275Z","wire_tool_inputs":{"call-b8c2af92-9434-4155-9246-a38d933f48a1":{"command":"cd /private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server && cat src/workers/refund.worker.ts | head -80 && echo \"=== razorpay factory ===\" && cat src/lib/razorpay-factory.ts | head -80","description":"Read refund worker and razorpay factory"}},"wire_ingest_context":{"call-b8c2af92-9434-4155-9246-a38d933f48a1":{"cwd":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-b8c2af92-9434-4155-9246-a38d933f48a1","type":"tool_result","content":"import { type Job, UnrecoverableError, Worker } from \"bullmq\";\nimport { redis } from \"../config/redis\";\nimport { getLogger } from \"../lib/logger\";\nimport { RefundService } from \"../services/refund.service\";\n\nconst logger: any = getLogger(\"Refund Worker\", \"debug\");\n\n/**\n * Refund Worker\n * Processes refund-related jobs asynchronously\n * Job types: 'process-refund', 'process-payout-batch', 'calculate-payouts'\n */\n\nconst refundService = new RefundService();\n\n/**\n * Process refund jobs\n */\nconst refundWorker = new Worker(\n  \"refunds\",\n  async (job: Job) => {\n    const { name } = job;\n\n    try {\n      switch (name) {\n        case \"process-refund\":\n          await handleProcessRefund(job);\n          break;\n\n        case \"process-payout-batch\":\n          await handleProcessPayoutBatch(job);\n          break;\n\n        case \"calculate-payouts\":\n          await handleCalculatePayouts(job);\n          break;\n\n        default:\n          logger.warn(\"Unknown refund job type\", { jobName: name });\n      }\n    } catch (error) {\n      logger.error(\"Refund worker job failed\", {\n        jobId: job.id,\n        jobName: name,\n        error: error instanceof Error ? error.message : \"Unknown error\",\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      throw error;\n    }\n  },\n  {\n    connection: redis,\n    concurrency: 3,\n    limiter: {\n      max: 10,\n      duration: 1000,\n    },\n  },\n);\n\n/**\n * Handle process refund job\n * Processes an approved refund via Razorpay\n */\nasync function handleProcessRefund(job: Job) {\n  const { refundId } = job.data;\n\n  try {\n    await refundService.processRefund(refundId);\n  } catch (err) {\n    // processRefund moves the refund to FAILED on any error, so a BullMQ\n    // retry would only hit \"must be approved\" and bury the real error.\n    // Example: a Razorpay 400 on attempt 1 -> stop here, admin uses Retry.\n    throw new UnrecoverableError(err instanceof Error ? err.message : String(err));\n  }\n\n  logger.debug(\"Refund processed via worker\", {\n    jobId: job.id,\n    refundId,\n  });\n=== razorpay factory ===\nimport Razorpay from \"razorpay\";\nimport { config } from \"../config\";\nimport logger from \"../config/logger\";\nimport { RazorpayConfigRepository } from \"../repositories/razorpay-config.repository\";\nimport { decrypt } from \"../utils/encryption.util\";\nimport { NotFoundError } from \"../utils/errors.util\";\nimport { razorpay as platformRazorpay } from \"./razorpay\";\n\nconst configRepo = new RazorpayConfigRepository();\n\n/**\n * Returns the correct Razorpay instance for a given lister.\n * If the lister has an active, verified config → returns their own client + decrypted keyId.\n * Otherwise → returns the platform client + null configId.\n *\n * Returns keyId alongside instance so callers don't need a second DB fetch.\n *\n * IMPORTANT: When a lister's own Razorpay account is used, the full payment\n * (including Tunyt's platform fee) settles directly to the lister's bank\n * account. The platform fee recorded in Payment.platformFee needs to be\n * collected separately (via payout deduction, invoice, or Razorpay route/split).\n * Payments processed through lister-owned accounts have listerRazorpayConfigId\n * set on the Payment row for downstream tracking.\n */\nexport async function getRazorpayInstance(listerId: string): Promise<{\n  instance: Razorpay;\n  configId: string | null;\n  razorpayKeyId: string;\n}> {\n  const listerConfig = await configRepo.findByListerId(listerId);\n\n  if (listerConfig?.isActive && listerConfig?.isVerified) {\n    const keyId = decrypt(listerConfig.encryptedKeyId);\n    const keySecret = decrypt(listerConfig.encryptedKeySecret);\n\n    logger.info(\"Using lister-owned Razorpay account for payment\", {\n      listerId,\n      listerRazorpayConfigId: listerConfig.id,\n      note: \"Platform fee will settle to lister's account — needs separate collection via payout deduction\",\n    });\n\n    return {\n      instance: new Razorpay({ key_id: keyId, key_secret: keySecret }),\n      configId: listerConfig.id,\n      razorpayKeyId: keyId,\n    };\n  }\n\n  return {\n    instance: platformRazorpay,\n    configId: null,\n    razorpayKeyId: config.RAZORPAY_KEY_ID,\n  };\n}\n\n/**\n * Decrypts and returns the key secret for a given listerRazorpayConfigId.\n * Used during payment signature verification when lister's own account was used.\n */\nexport async function getListerKeySecret(\n  listerRazorpayConfigId: string,\n): Promise<string> {\n  const listerConfig = await configRepo.findById(listerRazorpayConfigId);\n\n  if (!listerConfig) {\n    throw new NotFoundError(\"Lister Razorpay config not found\");\n  }\n\n  return decrypt(listerConfig.encryptedKeySecret);\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"9ffd427a-749e-4b5e-afeb-d34b8efb7564","timestamp":"2026-11-20T19:08:23.838Z","tool_use_result":{"stdout":"import { type Job, UnrecoverableError, Worker } from \"bullmq\";\nimport { redis } from \"../config/redis\";\nimport { getLogger } from \"../lib/logger\";\nimport { RefundService } from \"../services/refund.service\";\n\nconst logger: any = getLogger(\"Refund Worker\", \"debug\");\n\n/**\n * Refund Worker\n * Processes refund-related jobs asynchronously\n * Job types: 'process-refund', 'process-payout-batch', 'calculate-payouts'\n */\n\nconst refundService = new RefundService();\n\n/**\n * Process refund jobs\n */\nconst refundWorker = new Worker(\n  \"refunds\",\n  async (job: Job) => {\n    const { name } = job;\n\n    try {\n      switch (name) {\n        case \"process-refund\":\n          await handleProcessRefund(job);\n          break;\n\n        case \"process-payout-batch\":\n          await handleProcessPayoutBatch(job);\n          break;\n\n        case \"calculate-payouts\":\n          await handleCalculatePayouts(job);\n          break;\n\n        default:\n          logger.warn(\"Unknown refund job type\", { jobName: name });\n      }\n    } catch (error) {\n      logger.error(\"Refund worker job failed\", {\n        jobId: job.id,\n        jobName: name,\n        error: error instanceof Error ? error.message : \"Unknown error\",\n        stack: error instanceof Error ? error.stack : undefined,\n      });\n      throw error;\n    }\n  },\n  {\n    connection: redis,\n    concurrency: 3,\n    limiter: {\n      max: 10,\n      duration: 1000,\n    },\n  },\n);\n\n/**\n * Handle process refund job\n * Processes an approved refund via Razorpay\n */\nasync function handleProcessRefund(job: Job) {\n  const { refundId } = job.data;\n\n  try {\n    await refundService.processRefund(refundId);\n  } catch (err) {\n    // processRefund moves the refund to FAILED on any error, so a BullMQ\n    // retry would only hit \"must be approved\" and bury the real error.\n    // Example: a Razorpay 400 on attempt 1 -> stop here, admin uses Retry.\n    throw new UnrecoverableError(err instanceof Error ? err.message : String(err));\n  }\n\n  logger.debug(\"Refund processed via worker\", {\n    jobId: job.id,\n    refundId,\n  });\n=== razorpay factory ===\nimport Razorpay from \"razorpay\";\nimport { config } from \"../config\";\nimport logger from \"../config/logger\";\nimport { RazorpayConfigRepository } from \"../repositories/razorpay-config.repository\";\nimport { decrypt } from \"../utils/encryption.util\";\nimport { NotFoundError } from \"../utils/errors.util\";\nimport { razorpay as platformRazorpay } from \"./razorpay\";\n\nconst configRepo = new RazorpayConfigRepository();\n\n/**\n * Returns the correct Razorpay instance for a given lister.\n * If the lister has an active, verified config → returns their own client + decrypted keyId.\n * Otherwise → returns the platform client + null configId.\n *\n * Returns keyId alongside instance so callers don't need a second DB fetch.\n *\n * IMPORTANT: When a lister's own Razorpay account is used, the full payment\n * (including Tunyt's platform fee) settles directly to the lister's bank\n * account. The platform fee recorded in Payment.platformFee needs to be\n * collected separately (via payout deduction, invoice, or Razorpay route/split).\n * Payments processed through lister-owned accounts have listerRazorpayConfigId\n * set on the Payment row for downstream tracking.\n */\nexport async function getRazorpayInstance(listerId: string): Promise<{\n  instance: Razorpay;\n  configId: string | null;\n  razorpayKeyId: string;\n}> {\n  const listerConfig = await configRepo.findByListerId(listerId);\n\n  if (listerConfig?.isActive && listerConfig?.isVerified) {\n    const keyId = decrypt(listerConfig.encryptedKeyId);\n    const keySecret = decrypt(listerConfig.encryptedKeySecret);\n\n    logger.info(\"Using lister-owned Razorpay account for payment\", {\n      listerId,\n      listerRazorpayConfigId: listerConfig.id,\n      note: \"Platform fee will settle to lister's account — needs separate collection via payout deduction\",\n    });\n\n    return {\n      instance: new Razorpay({ key_id: keyId, key_secret: keySecret }),\n      configId: listerConfig.id,\n      razorpayKeyId: keyId,\n    };\n  }\n\n  return {\n    instance: platformRazorpay,\n    configId: null,\n    razorpayKeyId: config.RAZORPAY_KEY_ID,\n  };\n}\n\n/**\n * Decrypts and returns the key secret for a given listerRazorpayConfigId.\n * Used during payment signature verification when lister's own account was used.\n */\nexport async function getListerKeySecret(\n  listerRazorpayConfigId: string,\n): Promise<string> {\n  const listerConfig = await configRepo.findById(listerRazorpayConfigId);\n\n  if (!listerConfig) {\n    throw new NotFoundError(\"Lister Razorpay config not found\");\n  }\n\n  return decrypt(listerConfig.encryptedKeySecret);\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call-b8c2af92-9434-4155-9246-a38d933f48a1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
