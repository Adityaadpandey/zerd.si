{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-b4afa1c0-63c9-40ca-b77c-c478b171c2e8","type":"tool_result","content":"1\timport crypto from \"node:crypto\";\n2\timport { config } from \"../../config\";\n3\timport { prisma } from \"../../config/db\";\n4\timport logger from \"../../config/logger\";\n5\timport { PUSH_COPY } from \"../../lib/push-copy\";\n6\timport { BookingRepository } from \"../../repositories/booking.repository\";\n7\timport { PaymentRepository } from \"../../repositories/payment.repository\";\n8\timport { RazorpayConfigRepository } from \"../../repositories/razorpay-config.repository\";\n9\timport { SlotBookingRepository } from \"../../repositories/slot-booking.repository\";\n10\timport { TicketRepository } from \"../../repositories/ticket.repository\";\n11\timport type { RazorpayWebhook } from \"../../types/payment.types\";\n12\timport { PAYMENT_ERROR_MESSAGES } from \"../../types/payment.types\";\n13\timport { decrypt } from \"../../utils/encryption.util\";\n14\timport { BadRequestError } from \"../../utils/errors.util\";\n15\timport { toPaise } from \"../../utils/money.util\";\n16\timport { runWebhookOnce } from \"../../utils/webhook-dedup.util\";\n17\timport { PushService } from \"../push.service\";\n18\timport { SlotBookingService } from \"../slot-booking.service\";\n19\timport { SlotInventoryService } from \"../slot-inventory.service\";\n20\timport { SlotSplitService } from \"../slot-split.service\";\n21\timport { BookingPaymentFinalizerService } from \"./booking-payment-finalizer.service\";\n22\t\n23\t// Events that carry a payment-link ID, on either the platform or a\n24\t// lister's own connected Razorpay account.\n25\tconst PAYMENT_LINK_EVENTS = new Set([\n26\t  \"payment_link.paid\",\n27\t  \"payment.captured\",\n28\t  \"order.paid\",\n29\t]);\n30\t\n31\texport class PaymentWebhookService {\n32\t  private paymentRepository: PaymentRepository;\n33\t  private ticketRepository: TicketRepository;\n34\t  private bookingRepository: BookingRepository;\n35\t  private slotBookingRepository: SlotBookingRepository;\n36\t  private razorpayConfigRepository: RazorpayConfigRepository;\n37\t  private splitService: SlotSplitService;\n38\t  private finalizer: BookingPaymentFinalizerService;\n39\t\n40\t  constructor(\n41\t    paymentRepository?: PaymentRepository,\n42\t    ticketRepository?: TicketRepository,\n43\t    finalizer?: BookingPaymentFinalizerService,\n44\t  ) {\n45\t    this.paymentRepository = paymentRepository ?? new PaymentRepository();\n46\t    this.ticketRepository = ticketRepository ?? new TicketRepository();\n47\t    this.bookingRepository = new BookingRepository();\n48\t    this.slotBookingRepository = new SlotBookingRepository();\n49\t    this.razorpayConfigRepository = new RazorpayConfigRepository();\n50\t    this.splitService = new SlotSplitService();\n51\t    this.finalizer = finalizer ?? new BookingPaymentFinalizerService();\n52\t  }\n53\t\n54\t  /**\n55\t   * Handle Razorpay webhook\n56\t   */\n57\t  async handleWebhook(\n58\t    webhookBody: RazorpayWebhook,\n59\t    signature: string,\n60\t    rawBody: string,\n61\t  ) {\n62\t    // Verify webhook signature against the raw request body (avoids JSON canonicalization bypass)\n63\t    if (!config.RAZORPAY_WEBHOOK_SECRET) {\n64\t      logger.error(\n65\t        \"RAZORPAY_WEBHOOK_SECRET is not configured — refusing to verify webhook signature\",\n66\t      );\n67\t      throw new BadRequestError(\n68\t        PAYMENT_ERROR_MESSAGES.WEBHOOK_VERIFICATION_FAILED,\n69\t      );\n70\t    }\n71\t    const expectedSignature = crypto\n72\t      .createHmac(\"sha256\", config.RAZORPAY_WEBHOOK_SECRET)\n73\t      .update(rawBody)\n74\t      .digest(\"hex\");\n75\t\n76\t    const expectedBuf = Buffer.from(expectedSignature);\n77\t    const signatureBuf = Buffer.from(signature);\n78\t    if (\n79\t      expectedBuf.length !== signatureBuf.length ||\n80\t      !crypto.timingSafeEqual(expectedBuf, signatureBuf)\n81\t    ) {\n82\t      logger.error(\"Webhook signature verification failed\");\n83\t      throw new BadRequestError(\n84\t        PAYMENT_ERROR_MESSAGES.WEBHOOK_VERIFICATION_FAILED,\n85\t      );\n86\t    }\n87\t\n88\t    const { event, payload } = webhookBody;\n89\t\n90\t    // Resolve identifiers from either shape Razorpay sends:\n91\t    //   payment_link.paid → payload.payment_link.entity\n92\t    //   payment.captured/order.paid → payload.payment.entity\n93\t    // Payment-link notes are copied to the payment on some Razorpay flows and\n94\t    // remain only on the payment_link entity on others, so inspect both.\n95\t    const paymentLinkEntity = payload.payment_link?.entity;\n96\t    const paymentLinkId =\n97\t      paymentLinkEntity?.id ?? payload.payment?.entity?.payment_link_id;\n98\t\n99\t    const payment = payload.payment?.entity;\n100\t    const paymentNotes = payment?.notes ?? paymentLinkEntity?.notes;\n101\t    const shareId =\n102\t      typeof paymentNotes?.shareId === \"string\"\n103\t        ? paymentNotes.shareId\n104\t        : undefined;\n105\t    const splitId =\n106\t      typeof paymentNotes?.splitId === \"string\"\n107\t        ? paymentNotes.splitId\n108\t        : undefined;\n109\t    let slotBookingId =\n110\t      typeof paymentNotes?.slotBookingId === \"string\"\n111\t        ? paymentNotes.slotBookingId\n112\t        : undefined;\n113\t\n114\t    // A slot-booking order stores its Razorpay order ID locally. Use it when\n115\t    // Razorpay omits the custom notes from a payment.captured payload.\n116\t    if (!slotBookingId && payment?.order_id && event === \"payment.captured\") {\n117\t      const slotBooking =\n118\t        await this.slotBookingRepository.findByRazorpayOrderId(\n119\t          payment.order_id,\n120\t        );\n121\t      slotBookingId = slotBooking?.slotBookingId;\n122\t    }\n123\t\n124\t    const isPaymentCollection =\n125\t      paymentNotes?.kind === \"walk_in_upi\" ||\n126\t      paymentNotes?.kind === \"walk_in_collect_payment\";\n127\t\n128\t    logger.info(\"Webhook received\", {\n129\t      event,\n130\t      paymentId: payment?.id,\n131\t      orderId: payment?.order_id,\n132\t      paymentLinkId,\n133\t      shareId,\n134\t      splitId,\n135\t      slotBookingId,\n136\t    });\n137\t\n138\t    // Idempotency: dedupe concurrent retries by Razorpay's event id. On failure\n139\t    // the row is removed again so the retry is not swallowed (see runWebhookOnce).\n140\t    const webhookEventId = (webhookBody as any).id as string | undefined;\n141\t    await runWebhookOnce(\n142\t      {\n143\t        claim: async () => {\n144\t          if (!webhookEventId) return true;\n145\t          try {\n146\t            await prisma.processedWebhookEvent.create({\n147\t              data: { eventId: webhookEventId, eventType: event },\n148\t            });\n149\t            return true;\n150\t          } catch (err: any) {\n151\t            if (err?.code === \"P2002\") {\n152\t              logger.info(\"Webhook duplicate: already processed, skipping\", {\n153\t                webhookEventId,\n154\t                event,\n155\t              });\n156\t              return false;\n157\t            }\n158\t            throw err;\n159\t          }\n160\t        },\n161\t        release: async () => {\n162\t          if (!webhookEventId) return;\n163\t          await prisma.processedWebhookEvent.deleteMany({\n164\t            where: { eventId: webhookEventId },\n165\t          });\n166\t        },\n167\t      },\n168\t      async () => {\n169\t        // Razorpay QR Codes: `qr_code.credited` fires when a customer pays\n170\t        // against a QR generated via `qrCode.create`. We persist the QR id on\n171\t        // the slot booking at creation, so this branch confirms the walk-in\n172\t        // booking end-to-end (status → CONFIRMED, slots → BOOKED).\n173\t        if (event === \"qr_code.credited\") {\n174\t          const qrCodeId =\n175\t            (webhookBody.payload as any)?.qr_code?.entity?.id ?? null;\n176\t          if (\n177\t            await this.tryConfirmSlotBookingFromWebhook(event, {\n178\t              qrCodeId,\n179\t              paymentId: payment?.id,\n180\t            })\n181\t          ) {\n182\t            return;\n183\t          }\n184\t          // Fall through to default processing if no slot booking matched\n185\t          // (could be a QR for a non-walk-in flow handled elsewhere later).\n186\t          // A door-sale QR: we saved a Payment row keyed by the QR id when the QR was\n187\t          // made, so feed this payment through the normal \"captured\" handling (amount\n188\t          // check, mark completed, finalize booking, email) with the QR id as order id.\n189\t          const creditedPayment = (webhookBody.payload as any)?.payment?.entity;\n190\t          if (\n191\t            qrCodeId &&\n192\t            creditedPayment &&\n193\t            (await this.paymentRepository.findByRazorpayOrderId(qrCodeId))\n194\t          ) {\n195\t            await this.handlePaymentCaptured({\n196\t              ...creditedPayment,\n197\t              order_id: qrCodeId,\n198\t            });\n199\t            return;\n200\t          }\n201\t        }\n202\t\n203\t        // Payment-link events (split payments + walk-in UPI) — try the walk-in\n204\t        // slot booking first (more specific match by link ID), then fall through\n205\t        // to the split-share path.\n206\t        if (paymentLinkId && PAYMENT_LINK_EVENTS.has(event)) {\n207\t          if (\n208\t            await this.tryConfirmSlotBookingFromWebhook(event, {\n209\t              paymentLinkId,\n210\t              paymentId: payment?.id,\n211\t            })\n212\t          ) {\n213\t            return;\n214\t          }\n215\t          await this.splitService.onSharePaid(paymentLinkId);\n216\t          return;\n217\t        }\n218\t\n219\t        // Razorpay's payment.captured payload may omit payment_link_id even when\n220\t        // the payment came from a payment link. Team split links carry shareId in\n221\t        // their notes, so use that authenticated fallback before treating the\n222\t        // event as a regular order payment.\n223\t        if (shareId && PAYMENT_LINK_EVENTS.has(event)) {\n224\t          await this.splitService.onSharePaidByShareId(shareId, splitId);\n225\t          return;\n226\t        }\n227\t\n228\t        // Slot-booking orders and walk-in collection links do not create a row in\n229\t        // the regular Payment table. Their payment.captured webhook can therefore\n230\t        // not go through handlePaymentCaptured: that method would try to update a\n231\t        // nonexistent Payment by order_id and turn a successful capture into a\n232\t        // 500. Resolve them from the signed Razorpay notes instead.\n233\t        if (slotBookingId && PAYMENT_LINK_EVENTS.has(event)) {\n234\t          if (\n235\t            await this.tryConfirmSlotBookingFromWebhook(event, {\n236\t              slotBookingId,\n237\t              paymentId: payment?.id,\n238\t              isPaymentCollection,\n239\t            })\n240\t          ) {\n241\t            return;\n242\t          }\n243\t        }\n244\t\n245\t        // Razorpay also sends payment.captured for a QR payment, often with no\n246\t        // order id. The qr_code.credited event above is the one we act on, so\n247\t        // skip this one instead of failing on a null order id.\n248\t        if (event === \"payment.captured\" && payment && !payment.order_id) {\n249\t          logger.info(\n250\t            \"Webhook: payment.captured without order id, handled via qr_code.credited\",\n251\t            { paymentId: payment.id },\n252\t          );\n253\t          return;\n254\t        }\n255\t\n256\t        // Regular order-based payments.\n257\t        if (payment) {\n258\t          await this.processWebhookEvent(event, payment);\n259\t        }\n260\t      },\n261\t    );\n262\t  }\n263\t\n264\t  /**\n265\t   * Match a QR-code or payment-link webhook event to a walk-in slot booking\n266\t   * and confirm it. Shared by the platform webhook and per-lister webhook\n267\t   * paths — a venue on its own connected Razorpay account must get the same\n268\t   * auto-confirm behavior as one on the platform account.\n269\t   * Returns true if a slot booking was matched and confirmed.\n270\t   */\n271\t  private async tryConfirmSlotBookingFromWebhook(\n272\t    event: string,\n273\t    ids: {\n274\t      qrCodeId?: string | null;\n275\t      paymentLinkId?: string | null;\n276\t      slotBookingId?: string | null;\n277\t      paymentId?: string | null;\n278\t      isPaymentCollection?: boolean;\n279\t    },\n280\t  ): Promise<boolean> {\n281\t    if (event === \"qr_code.credited\" && ids.qrCodeId) {\n282\t      const slotBooking =\n283\t        await this.slotBookingRepository.findByRazorpayQrCodeId(ids.qrCodeId);\n284\t      if (!slotBooking) {\n285\t        logger.warn(\"Webhook: qr_code.credited with no matching slot booking\", {\n286\t          qrCodeId: ids.qrCodeId,\n287\t        });\n288\t        return false;\n289\t      }\n290\t      logger.info(\"Webhook: walk-in UPI QR payment confirmed\", {\n291\t        slotBookingId: slotBooking.slotBookingId,\n292\t        qrCodeId: ids.qrCodeId,\n293\t      });\n294\t      await new SlotBookingService().confirmFromPayment(\n295\t        slotBooking.slotBookingId,\n296\t        ids.paymentId ?? ids.qrCodeId,\n297\t      );\n298\t      return true;\n299\t    }\n300\t\n301\t    if (ids.paymentLinkId && PAYMENT_LINK_EVENTS.has(event)) {\n302\t      const slotBooking =\n303\t        await this.slotBookingRepository.findByRazorpayPaymentLinkId(\n304\t          ids.paymentLinkId,\n305\t        );\n306\t      if (!slotBooking) return false;\n307\t\n308\t      if (\n309\t        slotBooking.status === \"CONFIRMED\" ||\n310\t        slotBooking.status === \"COMPLETED\"\n311\t      ) {\n312\t        // Not the original creation-confirm link — this one was minted to\n313\t        // collect an outstanding balance on an already-live walk-in\n314\t        // (pay-later collection, or a settle-triggered overtime charge).\n315\t        // confirmFromPayment would no-op here (status is already CONFIRMED\n316\t        // or, for a settled booking, COMPLETED — settle flips status\n317\t        // synchronously while the UPI payment for it confirms\n318\t        // asynchronously afterward); what actually needs to happen is\n319\t        // flipping paymentCollected.\n320\t        if (!slotBooking.paymentCollected) {\n321\t          await this.slotBookingRepository.updateStatus(\n322\t            slotBooking.slotBookingId,\n323\t            slotBooking.status,\n324\t            { paymentCollected: true, paidVia: \"UPI\", paidAt: new Date() },\n325\t          );\n326\t          logger.info(\"Webhook: walk-in payment collection confirmed\", {\n327\t            slotBookingId: slotBooking.slotBookingId,\n328\t            paymentLinkId: ids.paymentLinkId,\n329\t          });\n330\t        }\n331\t        return true;\n332\t      }\n333\t\n334\t      logger.info(\"Webhook: walk-in UPI payment confirmed\", {\n335\t        slotBookingId: slotBooking.slotBookingId,\n336\t        paymentLinkId: ids.paymentLinkId,\n337\t      });\n338\t      await new SlotBookingService().confirmFromPayment(\n339\t        slotBooking.slotBookingId,\n340\t        ids.paymentId ?? ids.paymentLinkId,\n341\t      );\n342\t      return true;\n343\t    }\n344\t\n345\t    // Payment.captured for a slot-booking order or a walk-in collection link\n346\t    // may contain only notes.slotBookingId. Resolve that form without touching\n347\t    // the regular Payment table.\n348\t    if (ids.slotBookingId && PAYMENT_LINK_EVENTS.has(event)) {\n349\t      const slotBooking = await this.slotBookingRepository.findById(\n350\t        ids.slotBookingId,\n351\t      );\n352\t      if (!slotBooking) return false;\n353\t\n354\t      if (\n355\t        slotBooking.status === \"CONFIRMED\" ||\n356\t        slotBooking.status === \"COMPLETED\"\n357\t      ) {\n358\t        if (ids.isPaymentCollection && !slotBooking.paymentCollected) {\n359\t          await this.slotBookingRepository.updateStatus(\n360\t            slotBooking.slotBookingId,\n361\t            slotBooking.status,\n362\t            { paymentCollected: true, paidVia: \"UPI\", paidAt: new Date() },\n363\t          );\n364\t          logger.info(\"Webhook: walk-in payment collection confirmed\", {\n365\t            slotBookingId: slotBooking.slotBookingId,\n366\t            paymentId: ids.paymentId,\n367\t          });\n368\t        }\n369\t        return true;\n370\t      }\n371\t\n372\t      // A capture can race cancellation/expiry. Do not let a late payment\n373\t      // resurrect a dead booking; leave it for the existing refund/ops path.\n374\t      if (slotBooking.status !== \"HELD\") {\n375\t        logger.error(\"Webhook: payment captured for non-held slot booking\", {\n376\t          slotBookingId: slotBooking.slotBookingId,\n377\t          status: slotBooking.status,\n378\t          paymentId: ids.paymentId,\n379\t        });\n380\t        return true;\n381\t      }\n382\t\n383\t      if (slotBooking.splitPaymentId) {\n384\t        if (!slotBooking.userId || !ids.paymentId) {\n385\t          logger.warn(\"Webhook: split booker payment missing payer details\", {\n386\t            slotBookingId: slotBooking.slotBookingId,\n387\t            splitPaymentId: slotBooking.splitPaymentId,\n388\t            paymentId: ids.paymentId,\n389\t          });\n390\t          return true;\n391\t        }\n392\t\n393\t        const { allPaid } = await this.splitService.markBookerSharePaid(\n394\t          slotBooking.splitPaymentId,\n395\t          slotBooking.userId,\n396\t          ids.paymentId,\n397\t        );\n398\t\n399\t        if (allPaid) {\n400\t          await this.slotBookingRepository.updateStatus(\n401\t            slotBooking.slotBookingId,\n402\t            \"CONFIRMED\",\n403\t          );\n404\t          await SlotInventoryService.confirmSlots(slotBooking.slotBookingId);\n405\t        } else {\n406\t          // The client verify route normally activates these links. Doing it\n407\t          // here too covers webhook-first delivery and keeps the split from\n408\t          // waiting for a client request that may never arrive.\n409\t          await this.splitService.activateTeammateLinks(\n410\t            slotBooking.splitPaymentId,\n411\t          );\n412\t        }\n413\t        return true;\n414\t      }\n415\t\n416\t      if (!ids.paymentId) {\n417\t        logger.warn(\"Webhook: slot booking payment ID missing\", {\n418\t          slotBookingId: slotBooking.slotBookingId,\n419\t        });\n420\t        return true;\n421\t      }\n422\t\n423\t      await new SlotBookingService().confirmFromPayment(\n424\t        slotBooking.slotBookingId,\n425\t        ids.paymentId,\n426\t      );\n427\t      return true;\n428\t    }\n429\t\n430\t    return false;\n431\t  }\n432\t\n433\t  /**\n434\t   * Handle a webhook from a lister's own Razorpay account.\n435\t   * Verifies HMAC-SHA256 using per-lister webhook secret, then processes event.\n436\t   * Returns false if signature is invalid or config is not found/active.\n437\t   */\n438\t  async handleListerWebhook(\n439\t    listerId: string,\n440\t    signature: string,\n441\t    body: unknown,\n442\t    rawBody: string,\n443\t  ): Promise<{ authorized: boolean }> {\n444\t    const listerConfig =\n445\t      await this.razorpayConfigRepository.findByListerId(listerId);\n446\t\n447\t    if (!listerConfig?.isActive || !listerConfig?.encryptedWebhookSecret) {\n448\t      logger.warn(\"Lister webhook: config not found or inactive\", { listerId });\n449\t      return { authorized: false };\n450\t    }\n451\t\n452\t    const webhookSecret = decrypt(listerConfig.encryptedWebhookSecret);\n453\t    const expectedSignature = crypto\n454\t      .createHmac(\"sha256\", webhookSecret)\n455\t      .update(rawBody)\n456\t      .digest(\"hex\");\n457\t\n458\t    const expectedBuf = Buffer.from(expectedSignature);\n459\t    const signatureBuf = Buffer.from(signature);\n460\t    if (\n461\t      expectedBuf.length !== signatureBuf.length ||\n462\t      !crypto.timingSafeEqual(expectedBuf, signatureBuf)\n463\t    ) {\n464\t      logger.warn(\"Lister webhook signature mismatch\", { listerId });\n465\t      return { authorized: false };\n466\t    }\n467\t\n468\t    const webhookBody = body as {\n469\t      id?: string;\n470\t      event: string;\n471\t      payload: {\n472\t        payment?: {\n473\t          entity: {\n474\t            id?: string;\n475\t            order_id?: string;\n476\t            payment_link_id?: string;\n477\t            notes?: Record<string, unknown>;\n478\t          };\n479\t        };\n480\t        payment_link?: {\n481\t          entity?: { id?: string; notes?: Record<string, unknown> };\n482\t        };\n483\t      };\n484\t    };\n485\t\n486\t    // Idempotency: deduplicate concurrent webhook retries using Razorpay's event ID.\n487\t    // prisma.processedWebhookEvent.create throws P2002 (unique constraint) if another instance\n488\t    // already inserted this eventId — guaranteeing exactly-once processing.\n489\t    const listerWebhookEventId = webhookBody.id;\n490\t    if (listerWebhookEventId) {\n491\t      try {\n492\t        await prisma.processedWebhookEvent.create({\n493\t          data: {\n494\t            eventId: listerWebhookEventId,\n495\t            eventType: webhookBody.event,\n496\t          },\n497\t        });\n498\t      } catch (err: any) {\n499\t        if (err?.code === \"P2002\") {\n500\t          logger.info(\"Lister webhook duplicate: already processed, skipping\", {\n501\t            webhookEventId: listerWebhookEventId,\n502\t            event: webhookBody.event,\n503\t            listerId,\n504\t          });\n505\t          return { authorized: true };\n506\t        }\n507\t        throw err;\n508\t      }\n509\t    }\n510\t\n511\t    const listerPaymentLinkEntity = webhookBody.payload?.payment_link?.entity;\n512\t    const listerPayment = webhookBody?.payload?.payment?.entity;\n513\t    const listerPaymentLinkId =\n514\t      listerPaymentLinkEntity?.id ?? listerPayment?.payment_link_id;\n515\t    const listerQrCodeId =\n516\t      (webhookBody.payload as any)?.qr_code?.entity?.id ?? null;\n517\t    const listerPaymentNotes =\n518\t      listerPayment?.notes ?? listerPaymentLinkEntity?.notes;\n519\t    const listerShareId =\n520\t      typeof listerPaymentNotes?.shareId === \"string\"\n521\t        ? listerPaymentNotes.shareId\n522\t        : undefined;\n523\t    const listerSplitId =\n524\t      typeof listerPaymentNotes?.splitId === \"string\"\n525\t        ? listerPaymentNotes.splitId\n526\t        : undefined;\n527\t    let listerSlotBookingId =\n528\t      typeof listerPaymentNotes?.slotBookingId === \"string\"\n529\t        ? listerPaymentNotes.slotBookingId\n530\t        : undefined;\n531\t    if (\n532\t      !listerSlotBookingId &&\n533\t      listerPayment?.order_id &&\n534\t      webhookBody.event === \"payment.captured\"\n535\t    ) {\n536\t      const slotBooking =\n537\t        await this.slotBookingRepository.findByRazorpayOrderId(\n538\t          listerPayment.order_id,\n539\t        );\n540\t      listerSlotBookingId = slotBooking?.slotBookingId;\n541\t    }\n542\t\n543\t    const listerIsPaymentCollection =\n544\t      listerPaymentNotes?.kind === \"walk_in_upi\" ||\n545\t      listerPaymentNotes?.kind === \"walk_in_collect_payment\";\n546\t\n547\t    const confirmed = await this.tryConfirmSlotBookingFromWebhook(\n548\t      webhookBody.event,\n549\t      {\n550\t        qrCodeId: listerQrCodeId,\n551\t        paymentLinkId: listerPaymentLinkId,\n552\t        slotBookingId: listerSlotBookingId,\n553\t        paymentId: listerPayment?.id,\n554\t        isPaymentCollection: listerIsPaymentCollection,\n555\t      },\n556\t    );\n557\t\n558\t    if (!confirmed) {\n559\t      if (listerPaymentLinkId && PAYMENT_LINK_EVENTS.has(webhookBody.event)) {\n560\t        await this.splitService.onSharePaid(listerPaymentLinkId);\n561\t      } else if (listerShareId && PAYMENT_LINK_EVENTS.has(webhookBody.event)) {\n562\t        await this.splitService.onSharePaidByShareId(\n563\t          listerShareId,\n564\t          listerSplitId,\n565\t        );\n566\t      } else if (listerPayment) {\n567\t        await this.processWebhookEvent(webhookBody.event, listerPayment);\n568\t      }\n569\t    }\n570\t\n571\t    logger.info(\"Lister webhook processed\", {\n572\t      listerId,\n573\t      event: webhookBody.event,\n574\t    });\n575\t\n576\t    return { authorized: true };\n577\t  }\n578\t\n579\t  /**\n580\t   * Process a Razorpay webhook event.\n581\t   * Called by both the platform webhook and per-lister webhook controllers.\n582\t   */\n583\t  async processWebhookEvent(event: string, payment: any): Promise<void> {\n584\t    switch (event) {\n585\t      case \"payment.captured\":\n586\t        await this.handlePaymentCaptured(payment);\n587\t        break;\n588\t      case \"payment.failed\":\n589\t        await this.handlePaymentFailed(payment);\n590\t        break;\n591\t      default:\n592\t        logger.info(\"Unhandled webhook event\", { event });\n593\t    }\n594\t  }\n595\t\n596\t  /**\n597\t   * Handle successful payment capture\n598\t   */\n599\t  async handlePaymentCaptured(payment: any) {\n600\t    // Look up the Payment row by razorpayOrderId\n601\t    const existingPayment = await this.paymentRepository.findByRazorpayOrderId(\n602\t      payment.order_id,\n603\t    );\n604\t\n605\t    // Idempotency: skip if already completed\n606\t    if (existingPayment?.status === \"COMPLETED\") {\n607\t      logger.info(\"Webhook: payment already completed, skipping\", {\n608\t        orderId: payment.order_id,\n609\t      });\n610\t      return;\n611\t    }\n612\t\n613\t    // --- Booking-based payment path ---\n614\t    const bookingId =\n615\t      existingPayment?.bookingId ??\n616\t      (payment.notes?.bookingId as string | undefined);\n617\t\n618\t    let bookingForCheck: Awaited<\n619\t      ReturnType<BookingRepository[\"findByIdWithDetails\"]>\n620\t    > | null = null;\n621\t\n622\t    if (bookingId) {\n623\t      bookingForCheck =\n624\t        await this.bookingRepository.findByIdWithDetails(bookingId);\n625\t\n626\t      // Reconcile the captured amount against the live booking total before\n627\t      // trusting this webhook. A HELD booking's total can move after this\n628\t      // order was created (coupon applied/removed via applyDiscount reprices\n629\t      // Booking+Ticket rows but never touches the existing Payment/order —\n630\t      // see createPaymentOrderForBooking's idempotency guard). A\n631\t      // payment.captured event for the OLD amount must not confirm a booking\n632\t      // now priced differently. Mirrors the guard in verifyBookingPayment.\n633\t      if (bookingForCheck.status !== \"PAID\") {\n634\t        const capturedAmount = (payment.amount as number) / 100;\n635\t        if (toPaise(capturedAmount) !== toPaise(bookingForCheck.total)) {\n636\t          logger.error(\n637\t            \"Webhook: booking payment amount mismatch — refusing to finalize\",\n638\t            {\n639\t              bookingId,\n640\t              orderId: payment.order_id,\n641\t              paymentId: payment.id,\n642\t              capturedAmount,\n643\t              bookingTotal: bookingForCheck.total,\n644\t            },\n645\t          );\n646\t          await this.paymentRepository.markAsFailed(payment.order_id, {\n647\t            failureReason: `Captured amount ₹${capturedAmount} does not match booking total ₹${bookingForCheck.total}`,\n648\t          });\n649\t          return;\n650\t        }\n651\t      }\n652\t    }\n653\t\n654\t    // Update payment record first\n655\t    await this.paymentRepository.updatePaymentVerification(payment.order_id, {\n656\t      razorpayPaymentId: payment.id,\n657\t      razorpaySignature: \"\", // Signature not available in webhook\n658\t      status: \"COMPLETED\",\n659\t      method: payment.method,\n660\t    });\n661\t\n662\t    if (bookingId && bookingForCheck) {\n663\t      try {\n664\t        if (bookingForCheck.status === \"PAID\") {\n665\t          // Two payments for one sale: staff already took cash, then the guest's\n666\t          // UPI payment landed too. There's no second ticket to refund, so mark\n667\t          // the Payment for a person to refund from the Razorpay dashboard.\n668\t          if (bookingForCheck.paymentMode === \"CASH\") {\n669\t            logger.error(\n670\t              \"Door sale: UPI payment captured after the sale was settled in cash, needs manual refund\",\n671\t              { bookingId, paymentId: payment.id, orderId: payment.order_id },\n672\t            );\n673\t            await this.paymentRepository.flagForReconciliation(\n674\t              payment.order_id,\n675\t              \"PAID_AFTER_CASH\",\n676\t            );\n677\t          }\n678\t          // Booking already PAID — but the team may still be PENDING if the\n679\t          // verify path failed midway. Re-run team confirmation idempotently.\n680\t          await this.finalizer.confirmTeamFromBookingResult(\n681\t            bookingId,\n682\t            bookingForCheck,\n683\t          );\n684\t          logger.info(\"Webhook: booking already PAID, ensured team confirmed\", {\n685\t            bookingId,\n686\t          });\n687\t          return;\n688\t        }\n689\t        const finalised = await this.finalizer.finalizePaidBooking(bookingId);\n690\t        await this.finalizer.confirmTeamFromBookingResult(bookingId, finalised);\n691\t      } catch (error) {\n692\t        logger.error(\"Webhook: failed to finalize booking payment\", {\n693\t          bookingId,\n694\t          paymentId: payment.id,\n695\t          error,\n696\t        });\n697\t        // The payment row is already COMPLETED, so a webhook retry would be skipped.\n698\t        // Mark it so a person repairs the booking instead of it silently stranding the buyer.\n699\t        await this.paymentRepository\n700\t          .flagForReconciliation(payment.order_id, \"FINALIZE_FAILED\")\n701\t          .catch(() => undefined);\n702\t      }\n703\t      return;\n704\t    }\n705\t\n706\t    // --- Legacy ticket-based payment path ---\n707\t    const ticketIdsStr = payment.notes?.ticketIds;\n708\t    if (!ticketIdsStr) {\n709\t      logger.warn(\n710\t        \"Webhook: payment captured but no ticketIds or bookingId in notes\",\n711\t        {\n712\t          orderId: payment.order_id,\n713\t        },\n714\t      );\n715\t      return;\n716\t    }\n717\t\n718\t    const ticketIds = ticketIdsStr.split(\",\");\n719\t\n720\t    // Update tickets to SUCCESS\n721\t    await this.ticketRepository.bulkUpdateTicketStatus(ticketIds, \"SUCCESS\");\n722\t    await this.ticketRepository.markSeatsBookedForTicketIds(ticketIds);\n723\t\n724\t    // TODO: legacy webhook ticket path does not add the buyer to the Google\n725\t    // Calendar event attendee list. If this path is ever used for Google Meet\n726\t    // events, add an attendee-add call here (mirroring finalizePaidBooking).\n727\t\n728\t    logger.info(\"Payment captured - tickets updated\", {\n729\t      paymentId: payment.id,\n730\t      ticketCount: ticketIds.length,\n731\t    });\n732\t  }\n733\t\n734\t  /**\n735\t   * Handle failed payment\n736\t   */\n737\t  private async handlePaymentFailed(payment: any) {\n738\t    const existingPayment = await this.paymentRepository.findByRazorpayOrderId(\n739\t      payment.order_id,\n740\t    );\n741\t\n742\t    // A concurrent payment.captured webhook already completed this order —\n743\t    // don't overwrite the COMPLETED status or release the booking.\n744\t    if (existingPayment?.status === \"COMPLETED\") {\n745\t      logger.info(\"Webhook: payment.failed skipped — order already captured\", {\n746\t        orderId: payment.order_id,\n747\t      });\n748\t      return;\n749\t    }\n750\t\n751\t    if (existingPayment) {\n752\t      await this.paymentRepository.updatePaymentVerification(payment.order_id, {\n753\t        razorpayPaymentId: payment.id,\n754\t        razorpaySignature: \"\",\n755\t        status: \"FAILED\",\n756\t        failureReason: payment.error_description || \"Payment failed\",\n757\t      });\n758\t    }\n759\t\n760\t    // --- Booking-based payment path ---\n761\t    const bookingId =\n762\t      existingPayment?.bookingId ??\n763\t      (payment.notes?.bookingId as string | undefined);\n764\t\n765\t    if (bookingId) {\n766\t      // Do NOT release the hold — the user can retry within the same Razorpay\n767\t      // order. Releasing here would cancel a booking mid-retry and lose the\n768\t      // user's money if a concurrent payment.captured is in flight.\n769\t      // The hold expires naturally via the BullMQ/sweep worker.\n770\t      const failedUserId = existingPayment?.userId;\n771\t      if (failedUserId) {\n772\t        PushService.enqueue({\n773\t          userId: failedUserId,\n774\t          ...PUSH_COPY.payment_failed(),\n775\t        });\n776\t      }\n777\t      logger.info(\"Webhook: payment failed — booking released\", {\n778\t        paymentId: payment.id,\n779\t        bookingId,\n780\t        reason: payment.error_description,\n781\t      });\n782\t      return;\n783\t    }\n784\t\n785\t    // --- Legacy ticket-based payment path ---\n786\t    const ticketIdsStr = payment.notes?.ticketIds;\n787\t    if (!ticketIdsStr) {\n788\t      logger.warn(\n789\t        \"Webhook: payment failed but no bookingId or ticketIds in notes\",\n790\t        { orderId: payment.order_id },\n791\t      );\n792\t      return;\n793\t    }\n794\t\n795\t    const ticketIds = ticketIdsStr.split(\",\");\n796\t    await this.ticketRepository.bulkUpdateTicketStatus(ticketIds, \"FAILED\");\n797\t\n798\t    logger.info(\"Webhook: payment failed — tickets marked FAILED\", {\n799\t      paymentId: payment.id,\n800\t      ticketCount: ticketIds.length,\n801\t      reason: payment.error_description,\n802\t    });\n803\t  }\n804\t}\n805\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"8631450d-14af-4af4-ae8a-3977b194174e","timestamp":"2026-11-20T19:05:16.179Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/services/payment/payment-webhook.service.ts","content":"import crypto from \"node:crypto\";\nimport { config } from \"../../config\";\nimport { prisma } from \"../../config/db\";\nimport logger from \"../../config/logger\";\nimport { PUSH_COPY } from \"../../lib/push-copy\";\nimport { BookingRepository } from \"../../repositories/booking.repository\";\nimport { PaymentRepository } from \"../../repositories/payment.repository\";\nimport { RazorpayConfigRepository } from \"../../repositories/razorpay-config.repository\";\nimport { SlotBookingRepository } from \"../../repositories/slot-booking.repository\";\nimport { TicketRepository } from \"../../repositories/ticket.repository\";\nimport type { RazorpayWebhook } from \"../../types/payment.types\";\nimport { PAYMENT_ERROR_MESSAGES } from \"../../types/payment.types\";\nimport { decrypt } from \"../../utils/encryption.util\";\nimport { BadRequestError } from \"../../utils/errors.util\";\nimport { toPaise } from \"../../utils/money.util\";\nimport { runWebhookOnce } from \"../../utils/webhook-dedup.util\";\nimport { PushService } from \"../push.service\";\nimport { SlotBookingService } from \"../slot-booking.service\";\nimport { SlotInventoryService } from \"../slot-inventory.service\";\nimport { SlotSplitService } from \"../slot-split.service\";\nimport { BookingPaymentFinalizerService } from \"./booking-payment-finalizer.service\";\n\n// Events that carry a payment-link ID, on either the platform or a\n// lister's own connected Razorpay account.\nconst PAYMENT_LINK_EVENTS = new Set([\n  \"payment_link.paid\",\n  \"payment.captured\",\n  \"order.paid\",\n]);\n\nexport class PaymentWebhookService {\n  private paymentRepository: PaymentRepository;\n  private ticketRepository: TicketRepository;\n  private bookingRepository: BookingRepository;\n  private slotBookingRepository: SlotBookingRepository;\n  private razorpayConfigRepository: RazorpayConfigRepository;\n  private splitService: SlotSplitService;\n  private finalizer: BookingPaymentFinalizerService;\n\n  constructor(\n    paymentRepository?: PaymentRepository,\n    ticketRepository?: TicketRepository,\n    finalizer?: BookingPaymentFinalizerService,\n  ) {\n    this.paymentRepository = paymentRepository ?? new PaymentRepository();\n    this.ticketRepository = ticketRepository ?? new TicketRepository();\n    this.bookingRepository = new BookingRepository();\n    this.slotBookingRepository = new SlotBookingRepository();\n    this.razorpayConfigRepository = new RazorpayConfigRepository();\n    this.splitService = new SlotSplitService();\n    this.finalizer = finalizer ?? new BookingPaymentFinalizerService();\n  }\n\n  /**\n   * Handle Razorpay webhook\n   */\n  async handleWebhook(\n    webhookBody: RazorpayWebhook,\n    signature: string,\n    rawBody: string,\n  ) {\n    // Verify webhook signature against the raw request body (avoids JSON canonicalization bypass)\n    if (!config.RAZORPAY_WEBHOOK_SECRET) {\n      logger.error(\n        \"RAZORPAY_WEBHOOK_SECRET is not configured — refusing to verify webhook signature\",\n      );\n      throw new BadRequestError(\n        PAYMENT_ERROR_MESSAGES.WEBHOOK_VERIFICATION_FAILED,\n      );\n    }\n    const expectedSignature = crypto\n      .createHmac(\"sha256\", config.RAZORPAY_WEBHOOK_SECRET)\n      .update(rawBody)\n      .digest(\"hex\");\n\n    const expectedBuf = Buffer.from(expectedSignature);\n    const signatureBuf = Buffer.from(signature);\n    if (\n      expectedBuf.length !== signatureBuf.length ||\n      !crypto.timingSafeEqual(expectedBuf, signatureBuf)\n    ) {\n      logger.error(\"Webhook signature verification failed\");\n      throw new BadRequestError(\n        PAYMENT_ERROR_MESSAGES.WEBHOOK_VERIFICATION_FAILED,\n      );\n    }\n\n    const { event, payload } = webhookBody;\n\n    // Resolve identifiers from either shape Razorpay sends:\n    //   payment_link.paid → payload.payment_link.entity\n    //   payment.captured/order.paid → payload.payment.entity\n    // Payment-link notes are copied to the payment on some Razorpay flows and\n    // remain only on the payment_link entity on others, so inspect both.\n    const paymentLinkEntity = payload.payment_link?.entity;\n    const paymentLinkId =\n      paymentLinkEntity?.id ?? payload.payment?.entity?.payment_link_id;\n\n    const payment = payload.payment?.entity;\n    const paymentNotes = payment?.notes ?? paymentLinkEntity?.notes;\n    const shareId =\n      typeof paymentNotes?.shareId === \"string\"\n        ? paymentNotes.shareId\n        : undefined;\n    const splitId =\n      typeof paymentNotes?.splitId === \"string\"\n        ? paymentNotes.splitId\n        : undefined;\n    let slotBookingId =\n      typeof paymentNotes?.slotBookingId === \"string\"\n        ? paymentNotes.slotBookingId\n        : undefined;\n\n    // A slot-booking order stores its Razorpay order ID locally. Use it when\n    // Razorpay omits the custom notes from a payment.captured payload.\n    if (!slotBookingId && payment?.order_id && event === \"payment.captured\") {\n      const slotBooking =\n        await this.slotBookingRepository.findByRazorpayOrderId(\n          payment.order_id,\n        );\n      slotBookingId = slotBooking?.slotBookingId;\n    }\n\n    const isPaymentCollection =\n      paymentNotes?.kind === \"walk_in_upi\" ||\n      paymentNotes?.kind === \"walk_in_collect_payment\";\n\n    logger.info(\"Webhook received\", {\n      event,\n      paymentId: payment?.id,\n      orderId: payment?.order_id,\n      paymentLinkId,\n      shareId,\n      splitId,\n      slotBookingId,\n    });\n\n    // Idempotency: dedupe concurrent retries by Razorpay's event id. On failure\n    // the row is removed again so the retry is not swallowed (see runWebhookOnce).\n    const webhookEventId = (webhookBody as any).id as string | undefined;\n    await runWebhookOnce(\n      {\n        claim: async () => {\n          if (!webhookEventId) return true;\n          try {\n            await prisma.processedWebhookEvent.create({\n              data: { eventId: webhookEventId, eventType: event },\n            });\n            return true;\n          } catch (err: any) {\n            if (err?.code === \"P2002\") {\n              logger.info(\"Webhook duplicate: already processed, skipping\", {\n                webhookEventId,\n                event,\n              });\n              return false;\n            }\n            throw err;\n          }\n        },\n        release: async () => {\n          if (!webhookEventId) return;\n          await prisma.processedWebhookEvent.deleteMany({\n            where: { eventId: webhookEventId },\n          });\n        },\n      },\n      async () => {\n        // Razorpay QR Codes: `qr_code.credited` fires when a customer pays\n        // against a QR generated via `qrCode.create`. We persist the QR id on\n        // the slot booking at creation, so this branch confirms the walk-in\n        // booking end-to-end (status → CONFIRMED, slots → BOOKED).\n        if (event === \"qr_code.credited\") {\n          const qrCodeId =\n            (webhookBody.payload as any)?.qr_code?.entity?.id ?? null;\n          if (\n            await this.tryConfirmSlotBookingFromWebhook(event, {\n              qrCodeId,\n              paymentId: payment?.id,\n            })\n          ) {\n            return;\n          }\n          // Fall through to default processing if no slot booking matched\n          // (could be a QR for a non-walk-in flow handled elsewhere later).\n          // A door-sale QR: we saved a Payment row keyed by the QR id when the QR was\n          // made, so feed this payment through the normal \"captured\" handling (amount\n          // check, mark completed, finalize booking, email) with the QR id as order id.\n          const creditedPayment = (webhookBody.payload as any)?.payment?.entity;\n          if (\n            qrCodeId &&\n            creditedPayment &&\n            (await this.paymentRepository.findByRazorpayOrderId(qrCodeId))\n          ) {\n            await this.handlePaymentCaptured({\n              ...creditedPayment,\n              order_id: qrCodeId,\n            });\n            return;\n          }\n        }\n\n        // Payment-link events (split payments + walk-in UPI) — try the walk-in\n        // slot booking first (more specific match by link ID), then fall through\n        // to the split-share path.\n        if (paymentLinkId && PAYMENT_LINK_EVENTS.has(event)) {\n          if (\n            await this.tryConfirmSlotBookingFromWebhook(event, {\n              paymentLinkId,\n              paymentId: payment?.id,\n            })\n          ) {\n            return;\n          }\n          await this.splitService.onSharePaid(paymentLinkId);\n          return;\n        }\n\n        // Razorpay's payment.captured payload may omit payment_link_id even when\n        // the payment came from a payment link. Team split links carry shareId in\n        // their notes, so use that authenticated fallback before treating the\n        // event as a regular order payment.\n        if (shareId && PAYMENT_LINK_EVENTS.has(event)) {\n          await this.splitService.onSharePaidByShareId(shareId, splitId);\n          return;\n        }\n\n        // Slot-booking orders and walk-in collection links do not create a row in\n        // the regular Payment table. Their payment.captured webhook can therefore\n        // not go through handlePaymentCaptured: that method would try to update a\n        // nonexistent Payment by order_id and turn a successful capture into a\n        // 500. Resolve them from the signed Razorpay notes instead.\n        if (slotBookingId && PAYMENT_LINK_EVENTS.has(event)) {\n          if (\n            await this.tryConfirmSlotBookingFromWebhook(event, {\n              slotBookingId,\n              paymentId: payment?.id,\n              isPaymentCollection,\n            })\n          ) {\n            return;\n          }\n        }\n\n        // Razorpay also sends payment.captured for a QR payment, often with no\n        // order id. The qr_code.credited event above is the one we act on, so\n        // skip this one instead of failing on a null order id.\n        if (event === \"payment.captured\" && payment && !payment.order_id) {\n          logger.info(\n            \"Webhook: payment.captured without order id, handled via qr_code.credited\",\n            { paymentId: payment.id },\n          );\n          return;\n        }\n\n        // Regular order-based payments.\n        if (payment) {\n          await this.processWebhookEvent(event, payment);\n        }\n      },\n    );\n  }\n\n  /**\n   * Match a QR-code or payment-link webhook event to a walk-in slot booking\n   * and confirm it. Shared by the platform webhook and per-lister webhook\n   * paths — a venue on its own connected Razorpay account must get the same\n   * auto-confirm behavior as one on the platform account.\n   * Returns true if a slot booking was matched and confirmed.\n   */\n  private async tryConfirmSlotBookingFromWebhook(\n    event: string,\n    ids: {\n      qrCodeId?: string | null;\n      paymentLinkId?: string | null;\n      slotBookingId?: string | null;\n      paymentId?: string | null;\n      isPaymentCollection?: boolean;\n    },\n  ): Promise<boolean> {\n    if (event === \"qr_code.credited\" && ids.qrCodeId) {\n      const slotBooking =\n        await this.slotBookingRepository.findByRazorpayQrCodeId(ids.qrCodeId);\n      if (!slotBooking) {\n        logger.warn(\"Webhook: qr_code.credited with no matching slot booking\", {\n          qrCodeId: ids.qrCodeId,\n        });\n        return false;\n      }\n      logger.info(\"Webhook: walk-in UPI QR payment confirmed\", {\n        slotBookingId: slotBooking.slotBookingId,\n        qrCodeId: ids.qrCodeId,\n      });\n      await new SlotBookingService().confirmFromPayment(\n        slotBooking.slotBookingId,\n        ids.paymentId ?? ids.qrCodeId,\n      );\n      return true;\n    }\n\n    if (ids.paymentLinkId && PAYMENT_LINK_EVENTS.has(event)) {\n      const slotBooking =\n        await this.slotBookingRepository.findByRazorpayPaymentLinkId(\n          ids.paymentLinkId,\n        );\n      if (!slotBooking) return false;\n\n      if (\n        slotBooking.status === \"CONFIRMED\" ||\n        slotBooking.status === \"COMPLETED\"\n      ) {\n        // Not the original creation-confirm link — this one was minted to\n        // collect an outstanding balance on an already-live walk-in\n        // (pay-later collection, or a settle-triggered overtime charge).\n        // confirmFromPayment would no-op here (status is already CONFIRMED\n        // or, for a settled booking, COMPLETED — settle flips status\n        // synchronously while the UPI payment for it confirms\n        // asynchronously afterward); what actually needs to happen is\n        // flipping paymentCollected.\n        if (!slotBooking.paymentCollected) {\n          await this.slotBookingRepository.updateStatus(\n            slotBooking.slotBookingId,\n            slotBooking.status,\n            { paymentCollected: true, paidVia: \"UPI\", paidAt: new Date() },\n          );\n          logger.info(\"Webhook: walk-in payment collection confirmed\", {\n            slotBookingId: slotBooking.slotBookingId,\n            paymentLinkId: ids.paymentLinkId,\n          });\n        }\n        return true;\n      }\n\n      logger.info(\"Webhook: walk-in UPI payment confirmed\", {\n        slotBookingId: slotBooking.slotBookingId,\n        paymentLinkId: ids.paymentLinkId,\n      });\n      await new SlotBookingService().confirmFromPayment(\n        slotBooking.slotBookingId,\n        ids.paymentId ?? ids.paymentLinkId,\n      );\n      return true;\n    }\n\n    // Payment.captured for a slot-booking order or a walk-in collection link\n    // may contain only notes.slotBookingId. Resolve that form without touching\n    // the regular Payment table.\n    if (ids.slotBookingId && PAYMENT_LINK_EVENTS.has(event)) {\n      const slotBooking = await this.slotBookingRepository.findById(\n        ids.slotBookingId,\n      );\n      if (!slotBooking) return false;\n\n      if (\n        slotBooking.status === \"CONFIRMED\" ||\n        slotBooking.status === \"COMPLETED\"\n      ) {\n        if (ids.isPaymentCollection && !slotBooking.paymentCollected) {\n          await this.slotBookingRepository.updateStatus(\n            slotBooking.slotBookingId,\n            slotBooking.status,\n            { paymentCollected: true, paidVia: \"UPI\", paidAt: new Date() },\n          );\n          logger.info(\"Webhook: walk-in payment collection confirmed\", {\n            slotBookingId: slotBooking.slotBookingId,\n            paymentId: ids.paymentId,\n          });\n        }\n        return true;\n      }\n\n      // A capture can race cancellation/expiry. Do not let a late payment\n      // resurrect a dead booking; leave it for the existing refund/ops path.\n      if (slotBooking.status !== \"HELD\") {\n        logger.error(\"Webhook: payment captured for non-held slot booking\", {\n          slotBookingId: slotBooking.slotBookingId,\n          status: slotBooking.status,\n          paymentId: ids.paymentId,\n        });\n        return true;\n      }\n\n      if (slotBooking.splitPaymentId) {\n        if (!slotBooking.userId || !ids.paymentId) {\n          logger.warn(\"Webhook: split booker payment missing payer details\", {\n            slotBookingId: slotBooking.slotBookingId,\n            splitPaymentId: slotBooking.splitPaymentId,\n            paymentId: ids.paymentId,\n          });\n          return true;\n        }\n\n        const { allPaid } = await this.splitService.markBookerSharePaid(\n          slotBooking.splitPaymentId,\n          slotBooking.userId,\n          ids.paymentId,\n        );\n\n        if (allPaid) {\n          await this.slotBookingRepository.updateStatus(\n            slotBooking.slotBookingId,\n            \"CONFIRMED\",\n          );\n          await SlotInventoryService.confirmSlots(slotBooking.slotBookingId);\n        } else {\n          // The client verify route normally activates these links. Doing it\n          // here too covers webhook-first delivery and keeps the split from\n          // waiting for a client request that may never arrive.\n          await this.splitService.activateTeammateLinks(\n            slotBooking.splitPaymentId,\n          );\n        }\n        return true;\n      }\n\n      if (!ids.paymentId) {\n        logger.warn(\"Webhook: slot booking payment ID missing\", {\n          slotBookingId: slotBooking.slotBookingId,\n        });\n        return true;\n      }\n\n      await new SlotBookingService().confirmFromPayment(\n        slotBooking.slotBookingId,\n        ids.paymentId,\n      );\n      return true;\n    }\n\n    return false;\n  }\n\n  /**\n   * Handle a webhook from a lister's own Razorpay account.\n   * Verifies HMAC-SHA256 using per-lister webhook secret, then processes event.\n   * Returns false if signature is invalid or config is not found/active.\n   */\n  async handleListerWebhook(\n    listerId: string,\n    signature: string,\n    body: unknown,\n    rawBody: string,\n  ): Promise<{ authorized: boolean }> {\n    const listerConfig =\n      await this.razorpayConfigRepository.findByListerId(listerId);\n\n    if (!listerConfig?.isActive || !listerConfig?.encryptedWebhookSecret) {\n      logger.warn(\"Lister webhook: config not found or inactive\", { listerId });\n      return { authorized: false };\n    }\n\n    const webhookSecret = decrypt(listerConfig.encryptedWebhookSecret);\n    const expectedSignature = crypto\n      .createHmac(\"sha256\", webhookSecret)\n      .update(rawBody)\n      .digest(\"hex\");\n\n    const expectedBuf = Buffer.from(expectedSignature);\n    const signatureBuf = Buffer.from(signature);\n    if (\n      expectedBuf.length !== signatureBuf.length ||\n      !crypto.timingSafeEqual(expectedBuf, signatureBuf)\n    ) {\n      logger.warn(\"Lister webhook signature mismatch\", { listerId });\n      return { authorized: false };\n    }\n\n    const webhookBody = body as {\n      id?: string;\n      event: string;\n      payload: {\n        payment?: {\n          entity: {\n            id?: string;\n            order_id?: string;\n            payment_link_id?: string;\n            notes?: Record<string, unknown>;\n          };\n        };\n        payment_link?: {\n          entity?: { id?: string; notes?: Record<string, unknown> };\n        };\n      };\n    };\n\n    // Idempotency: deduplicate concurrent webhook retries using Razorpay's event ID.\n    // prisma.processedWebhookEvent.create throws P2002 (unique constraint) if another instance\n    // already inserted this eventId — guaranteeing exactly-once processing.\n    const listerWebhookEventId = webhookBody.id;\n    if (listerWebhookEventId) {\n      try {\n        await prisma.processedWebhookEvent.create({\n          data: {\n            eventId: listerWebhookEventId,\n            eventType: webhookBody.event,\n          },\n        });\n      } catch (err: any) {\n        if (err?.code === \"P2002\") {\n          logger.info(\"Lister webhook duplicate: already processed, skipping\", {\n            webhookEventId: listerWebhookEventId,\n            event: webhookBody.event,\n            listerId,\n          });\n          return { authorized: true };\n        }\n        throw err;\n      }\n    }\n\n    const listerPaymentLinkEntity = webhookBody.payload?.payment_link?.entity;\n    const listerPayment = webhookBody?.payload?.payment?.entity;\n    const listerPaymentLinkId =\n      listerPaymentLinkEntity?.id ?? listerPayment?.payment_link_id;\n    const listerQrCodeId =\n      (webhookBody.payload as any)?.qr_code?.entity?.id ?? null;\n    const listerPaymentNotes =\n      listerPayment?.notes ?? listerPaymentLinkEntity?.notes;\n    const listerShareId =\n      typeof listerPaymentNotes?.shareId === \"string\"\n        ? listerPaymentNotes.shareId\n        : undefined;\n    const listerSplitId =\n      typeof listerPaymentNotes?.splitId === \"string\"\n        ? listerPaymentNotes.splitId\n        : undefined;\n    let listerSlotBookingId =\n      typeof listerPaymentNotes?.slotBookingId === \"string\"\n        ? listerPaymentNotes.slotBookingId\n        : undefined;\n    if (\n      !listerSlotBookingId &&\n      listerPayment?.order_id &&\n      webhookBody.event === \"payment.captured\"\n    ) {\n      const slotBooking =\n        await this.slotBookingRepository.findByRazorpayOrderId(\n          listerPayment.order_id,\n        );\n      listerSlotBookingId = slotBooking?.slotBookingId;\n    }\n\n    const listerIsPaymentCollection =\n      listerPaymentNotes?.kind === \"walk_in_upi\" ||\n      listerPaymentNotes?.kind === \"walk_in_collect_payment\";\n\n    const confirmed = await this.tryConfirmSlotBookingFromWebhook(\n      webhookBody.event,\n      {\n        qrCodeId: listerQrCodeId,\n        paymentLinkId: listerPaymentLinkId,\n        slotBookingId: listerSlotBookingId,\n        paymentId: listerPayment?.id,\n        isPaymentCollection: listerIsPaymentCollection,\n      },\n    );\n\n    if (!confirmed) {\n      if (listerPaymentLinkId && PAYMENT_LINK_EVENTS.has(webhookBody.event)) {\n        await this.splitService.onSharePaid(listerPaymentLinkId);\n      } else if (listerShareId && PAYMENT_LINK_EVENTS.has(webhookBody.event)) {\n        await this.splitService.onSharePaidByShareId(\n          listerShareId,\n          listerSplitId,\n        );\n      } else if (listerPayment) {\n        await this.processWebhookEvent(webhookBody.event, listerPayment);\n      }\n    }\n\n    logger.info(\"Lister webhook processed\", {\n      listerId,\n      event: webhookBody.event,\n    });\n\n    return { authorized: true };\n  }\n\n  /**\n   * Process a Razorpay webhook event.\n   * Called by both the platform webhook and per-lister webhook controllers.\n   */\n  async processWebhookEvent(event: string, payment: any): Promise<void> {\n    switch (event) {\n      case \"payment.captured\":\n        await this.handlePaymentCaptured(payment);\n        break;\n      case \"payment.failed\":\n        await this.handlePaymentFailed(payment);\n        break;\n      default:\n        logger.info(\"Unhandled webhook event\", { event });\n    }\n  }\n\n  /**\n   * Handle successful payment capture\n   */\n  async handlePaymentCaptured(payment: any) {\n    // Look up the Payment row by razorpayOrderId\n    const existingPayment = await this.paymentRepository.findByRazorpayOrderId(\n      payment.order_id,\n    );\n\n    // Idempotency: skip if already completed\n    if (existingPayment?.status === \"COMPLETED\") {\n      logger.info(\"Webhook: payment already completed, skipping\", {\n        orderId: payment.order_id,\n      });\n      return;\n    }\n\n    // --- Booking-based payment path ---\n    const bookingId =\n      existingPayment?.bookingId ??\n      (payment.notes?.bookingId as string | undefined);\n\n    let bookingForCheck: Awaited<\n      ReturnType<BookingRepository[\"findByIdWithDetails\"]>\n    > | null = null;\n\n    if (bookingId) {\n      bookingForCheck =\n        await this.bookingRepository.findByIdWithDetails(bookingId);\n\n      // Reconcile the captured amount against the live booking total before\n      // trusting this webhook. A HELD booking's total can move after this\n      // order was created (coupon applied/removed via applyDiscount reprices\n      // Booking+Ticket rows but never touches the existing Payment/order —\n      // see createPaymentOrderForBooking's idempotency guard). A\n      // payment.captured event for the OLD amount must not confirm a booking\n      // now priced differently. Mirrors the guard in verifyBookingPayment.\n      if (bookingForCheck.status !== \"PAID\") {\n        const capturedAmount = (payment.amount as number) / 100;\n        if (toPaise(capturedAmount) !== toPaise(bookingForCheck.total)) {\n          logger.error(\n            \"Webhook: booking payment amount mismatch — refusing to finalize\",\n            {\n              bookingId,\n              orderId: payment.order_id,\n              paymentId: payment.id,\n              capturedAmount,\n              bookingTotal: bookingForCheck.total,\n            },\n          );\n          await this.paymentRepository.markAsFailed(payment.order_id, {\n            failureReason: `Captured amount ₹${capturedAmount} does not match booking total ₹${bookingForCheck.total}`,\n          });\n          return;\n        }\n      }\n    }\n\n    // Update payment record first\n    await this.paymentRepository.updatePaymentVerification(payment.order_id, {\n      razorpayPaymentId: payment.id,\n      razorpaySignature: \"\", // Signature not available in webhook\n      status: \"COMPLETED\",\n      method: payment.method,\n    });\n\n    if (bookingId && bookingForCheck) {\n      try {\n        if (bookingForCheck.status === \"PAID\") {\n          // Two payments for one sale: staff already took cash, then the guest's\n          // UPI payment landed too. There's no second ticket to refund, so mark\n          // the Payment for a person to refund from the Razorpay dashboard.\n          if (bookingForCheck.paymentMode === \"CASH\") {\n            logger.error(\n              \"Door sale: UPI payment captured after the sale was settled in cash, needs manual refund\",\n              { bookingId, paymentId: payment.id, orderId: payment.order_id },\n            );\n            await this.paymentRepository.flagForReconciliation(\n              payment.order_id,\n              \"PAID_AFTER_CASH\",\n            );\n          }\n          // Booking already PAID — but the team may still be PENDING if the\n          // verify path failed midway. Re-run team confirmation idempotently.\n          await this.finalizer.confirmTeamFromBookingResult(\n            bookingId,\n            bookingForCheck,\n          );\n          logger.info(\"Webhook: booking already PAID, ensured team confirmed\", {\n            bookingId,\n          });\n          return;\n        }\n        const finalised = await this.finalizer.finalizePaidBooking(bookingId);\n        await this.finalizer.confirmTeamFromBookingResult(bookingId, finalised);\n      } catch (error) {\n        logger.error(\"Webhook: failed to finalize booking payment\", {\n          bookingId,\n          paymentId: payment.id,\n          error,\n        });\n        // The payment row is already COMPLETED, so a webhook retry would be skipped.\n        // Mark it so a person repairs the booking instead of it silently stranding the buyer.\n        await this.paymentRepository\n          .flagForReconciliation(payment.order_id, \"FINALIZE_FAILED\")\n          .catch(() => undefined);\n      }\n      return;\n    }\n\n    // --- Legacy ticket-based payment path ---\n    const ticketIdsStr = payment.notes?.ticketIds;\n    if (!ticketIdsStr) {\n      logger.warn(\n        \"Webhook: payment captured but no ticketIds or bookingId in notes\",\n        {\n          orderId: payment.order_id,\n        },\n      );\n      return;\n    }\n\n    const ticketIds = ticketIdsStr.split(\",\");\n\n    // Update tickets to SUCCESS\n    await this.ticketRepository.bulkUpdateTicketStatus(ticketIds, \"SUCCESS\");\n    await this.ticketRepository.markSeatsBookedForTicketIds(ticketIds);\n\n    // TODO: legacy webhook ticket path does not add the buyer to the Google\n    // Calendar event attendee list. If this path is ever used for Google Meet\n    // events, add an attendee-add call here (mirroring finalizePaidBooking).\n\n    logger.info(\"Payment captured - tickets updated\", {\n      paymentId: payment.id,\n      ticketCount: ticketIds.length,\n    });\n  }\n\n  /**\n   * Handle failed payment\n   */\n  private async handlePaymentFailed(payment: any) {\n    const existingPayment = await this.paymentRepository.findByRazorpayOrderId(\n      payment.order_id,\n    );\n\n    // A concurrent payment.captured webhook already completed this order —\n    // don't overwrite the COMPLETED status or release the booking.\n    if (existingPayment?.status === \"COMPLETED\") {\n      logger.info(\"Webhook: payment.failed skipped — order already captured\", {\n        orderId: payment.order_id,\n      });\n      return;\n    }\n\n    if (existingPayment) {\n      await this.paymentRepository.updatePaymentVerification(payment.order_id, {\n        razorpayPaymentId: payment.id,\n        razorpaySignature: \"\",\n        status: \"FAILED\",\n        failureReason: payment.error_description || \"Payment failed\",\n      });\n    }\n\n    // --- Booking-based payment path ---\n    const bookingId =\n      existingPayment?.bookingId ??\n      (payment.notes?.bookingId as string | undefined);\n\n    if (bookingId) {\n      // Do NOT release the hold — the user can retry within the same Razorpay\n      // order. Releasing here would cancel a booking mid-retry and lose the\n      // user's money if a concurrent payment.captured is in flight.\n      // The hold expires naturally via the BullMQ/sweep worker.\n      const failedUserId = existingPayment?.userId;\n      if (failedUserId) {\n        PushService.enqueue({\n          userId: failedUserId,\n          ...PUSH_COPY.payment_failed(),\n        });\n      }\n      logger.info(\"Webhook: payment failed — booking released\", {\n        paymentId: payment.id,\n        bookingId,\n        reason: payment.error_description,\n      });\n      return;\n    }\n\n    // --- Legacy ticket-based payment path ---\n    const ticketIdsStr = payment.notes?.ticketIds;\n    if (!ticketIdsStr) {\n      logger.warn(\n        \"Webhook: payment failed but no bookingId or ticketIds in notes\",\n        { orderId: payment.order_id },\n      );\n      return;\n    }\n\n    const ticketIds = ticketIdsStr.split(\",\");\n    await this.ticketRepository.bulkUpdateTicketStatus(ticketIds, \"FAILED\");\n\n    logger.info(\"Webhook: payment failed — tickets marked FAILED\", {\n      paymentId: payment.id,\n      ticketCount: ticketIds.length,\n      reason: payment.error_description,\n    });\n  }\n}\n","numLines":805,"startLine":1,"totalLines":805}},"tool_result_meta":[{"id":"call-b4afa1c0-63c9-40ca-b77c-c478b171c2e8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
