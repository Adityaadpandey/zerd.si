{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-9b276da8-6d44-465a-9ca5-cb18c41d7e75","type":"tool_result","content":"1\timport { randomUUID } from \"node:crypto\";\n2\timport { prisma } from \"../../config/db\";\n3\timport { BookingStatus, TicketPaymentStatus } from \"../../generated/prisma/enums\";\n4\timport type { TransactionClient } from \"../../generated/prisma/internal/prismaNamespace\";\n5\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n6\timport { ConflictError } from \"../../utils/errors.util\";\n7\timport { generateTicketCode } from \"../../utils/qr-code.util\";\n8\timport type { BookingLifecycleRepository } from \"./booking-lifecycle.repository\";\n9\timport type { BookingLineInput, CreateBookingInput } from \"./types\";\n10\t\n11\texport class BookingCreationRepository {\n12\t  constructor(private readonly lifecycleRepo: BookingLifecycleRepository) {}\n13\t\n14\t  /**\n15\t   * Create a new booking with an inventory hold.\n16\t   *\n17\t   * Runs entirely inside a single Prisma interactive transaction:\n18\t   *  1. Atomically increments soldCount for each TicketType (fails on sold-out).\n19\t   *  2. Creates the Booking row (status HELD).\n20\t   *  3. Creates one Ticket row per seat.\n21\t   *  4. Bulk-inserts AttendeeFieldResponse rows for each ticket if provided.\n22\t   *\n23\t   * Returns the new bookingId.\n24\t   */\n25\t  async createWithHoldTx(input: CreateBookingInput): Promise<string> {\n26\t    return wrapDatabaseOperation(async () => {\n27\t      return await prisma.$transaction(async (tx) => {\n28\t        await this.reserveInventoryTx(tx, input.lines);\n29\t        return await this.insertBookingWithTicketsTx(tx, input);\n30\t      });\n31\t    }, \"Create booking with hold\");\n32\t  }\n33\t\n34\t  /**\n35\t   * Atomically supersede an existing HELD booking (release its inventory\n36\t   * hold, mark it CANCELLED) and create a new HELD booking in its place —\n37\t   * within ONE transaction, so the caller is never left holding two\n38\t   * concurrent active bookings for the same event, and never loses their\n39\t   * hold if the new one fails to reserve inventory.\n40\t   *\n41\t   * Used for in-place ticket-quantity edits (e.g. Review & Pay step) instead\n42\t   * of the client calling cancel() and create() as two separate requests,\n43\t   * which would let a buyer refresh a fresh hold window indefinitely by\n44\t   * cycling quantity, or lose their hold entirely if create() failed after\n45\t   * an already-committed cancel().\n46\t   *\n47\t   * Throws ConflictError(\"SUPERSEDE_TARGET_NOT_HELD\") if `supersede.bookingId`\n48\t   * is no longer a HELD booking owned by `supersede.userId` (already paid,\n49\t   * expired, or cancelled elsewhere) — the caller must reload booking state\n50\t   * rather than silently getting an extra, unrelated hold.\n51\t   */\n52\t  async createWithHoldSupersedingTx(\n53\t    input: CreateBookingInput,\n54\t    supersede: { bookingId: string; userId: string },\n55\t  ): Promise<string> {\n56\t    return wrapDatabaseOperation(async () => {\n57\t      return await prisma.$transaction(async (tx) => {\n58\t        const released = await this.lifecycleRepo.releaseHoldInTx(\n59\t          tx,\n60\t          supersede.bookingId,\n61\t          BookingStatus.CANCELLED,\n62\t          { userId: supersede.userId, statusIn: [BookingStatus.HELD] },\n63\t        );\n64\t        if (!released) {\n65\t          throw new ConflictError(\"SUPERSEDE_TARGET_NOT_HELD\");\n66\t        }\n67\t\n68\t        await this.reserveInventoryTx(tx, input.lines);\n69\t        return await this.insertBookingWithTicketsTx(tx, input);\n70\t      });\n71\t    }, \"Supersede and create booking with hold\");\n72\t  }\n73\t\n74\t  /**\n75\t   * Atomically increments soldCount/discountSoldCount for each ticket type\n76\t   * referenced by `lines`, failing with TICKET_SOLD_OUT if capacity (overall\n77\t   * or discount-slot) would be exceeded. Aggregates by ticketTypeId first —\n78\t   * the service emits two lines per type when a booking spans the\n79\t   * early-bird boundary (one discounted + one full-price).\n80\t   */\n81\t  private async reserveInventoryTx(\n82\t    tx: TransactionClient,\n83\t    lines: BookingLineInput[],\n84\t  ): Promise<void> {\n85\t    const aggByType = new Map<\n86\t      string,\n87\t      { totalQty: number; discountQty: number }\n88\t    >();\n89\t    for (const line of lines) {\n90\t      const agg = aggByType.get(line.ticketTypeId) ?? {\n91\t        totalQty: 0,\n92\t        discountQty: 0,\n93\t      };\n94\t      agg.totalQty += line.quantity;\n95\t      if (line.wasDiscounted) agg.discountQty += line.quantity;\n96\t      aggByType.set(line.ticketTypeId, agg);\n97\t    }\n98\t\n99\t    for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n100\t      const affected = await tx.$executeRaw`\n101\t\t\t\t\t\tUPDATE \"TicketType\"\n102\t\t\t\t\t\tSET \"soldCount\" = \"soldCount\" + ${totalQty},\n103\t\t\t\t\t\t    \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n104\t\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n105\t\t\t\t\t\t  AND \"soldCount\" + ${totalQty} <= \"quantity\"\n106\t\t\t\t\t\t  AND (\n107\t\t\t\t\t\t    ${discountQty}::int = 0\n108\t\t\t\t\t\t    OR (\n109\t\t\t\t\t\t      \"discountQuantity\" IS NOT NULL\n110\t\t\t\t\t\t      AND \"discountSoldCount\" + ${discountQty} <= \"discountQuantity\"\n111\t\t\t\t\t\t    )\n112\t\t\t\t\t\t  )\n113\t\t\t\t\t`;\n114\t\n115\t      if (affected === 0) {\n116\t        throw new ConflictError(`TICKET_SOLD_OUT:${ticketTypeId}`);\n117\t      }\n118\t    }\n119\t\n120\t    // Bundle-level early-bird slots consume TicketTypeGroup.discountSoldCount\n121\t    // instead of any member ticket type's own counter — member inventory\n122\t    // (soldCount) was already reserved above via totalQty regardless.\n123\t    // Every bundle member's line for the same bundle purchase carries the\n124\t    // IDENTICAL quantity (the number of bundle-units bought) — summing\n125\t    // across members would multi-count by the bundle's member count, so\n126\t    // take the quantity once per group instead of accumulating it.\n127\t    const groupDiscountAgg = new Map<string, number>();\n128\t    for (const line of lines) {\n129\t      if (!line.bundleGroupId || !line.bundleWasDiscounted) continue;\n130\t      groupDiscountAgg.set(\n131\t        line.bundleGroupId,\n132\t        Math.max(groupDiscountAgg.get(line.bundleGroupId) ?? 0, line.quantity),\n133\t      );\n134\t    }\n135\t    for (const [groupId, discountQty] of groupDiscountAgg) {\n136\t      const affected = await tx.$executeRaw`\n137\t\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n138\t\t\t\t\t\tSET \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n139\t\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n140\t\t\t\t\t\t  AND \"discountQuantity\" IS NOT NULL\n141\t\t\t\t\t\t  AND \"discountSoldCount\" + ${discountQty} <= \"discountQuantity\"\n142\t\t\t\t\t`;\n143\t      if (affected === 0) {\n144\t        throw new ConflictError(`TICKET_SOLD_OUT:${groupId}`);\n145\t      }\n146\t    }\n147\t  }\n148\t\n149\t  /**\n150\t   * Creates the Booking row (with a single booking-level QR code) plus one\n151\t   * Ticket row per line and any AttendeeFieldResponse rows. Assumes\n152\t   * inventory has already been reserved by `reserveInventoryTx` in the same\n153\t   * transaction. Returns the new bookingId.\n154\t   */\n155\t  private async insertBookingWithTicketsTx(\n156\t    tx: TransactionClient,\n157\t    input: CreateBookingInput,\n158\t  ): Promise<string> {\n159\t    const bookingQrCode = generateTicketCode();\n160\t    const booking = await tx.booking.create({\n161\t      data: {\n162\t        userId: input.userId,\n163\t        eventId: input.eventId,\n164\t        status: input.approvalRequest\n165\t          ? BookingStatus.PENDING_APPROVAL\n166\t          : BookingStatus.HELD,\n167\t        subtotal: input.subtotal,\n168\t        platformFee: input.platformFee,\n169\t        gatewayFee: input.gatewayFee,\n170\t        gst: input.gst,\n171\t        feesBornBy: input.feesBornBy,\n172\t        total: input.total,\n173\t        holdExpiresAt: input.holdExpiresAt,\n174\t        qrCode: bookingQrCode,\n175\t        commonFieldResponses: input.commonFieldResponses,\n176\t        ...(input.approvalRequest\n177\t          ? { approvalRequestedAt: input.approvalRequest.requestedAt }\n178\t          : {}),\n179\t        ...(input.referrer ? { referrer: input.referrer } : {}),\n180\t        ...(input.city ? { city: input.city } : {}),\n181\t        ...(input.state ? { state: input.state } : {}),\n182\t        ...(input.userAgent ? { userAgent: input.userAgent } : {}),\n183\t        ...(input.checkoutSessionId\n184\t          ? { checkoutSessionId: input.checkoutSessionId }\n185\t          : {}),\n186\t      },\n187\t      select: { bookingId: true },\n188\t    });\n189\t\n190\t    // Tickets no longer carry individual QR codes — the booking-level\n191\t    // qrCode is the single scannable for the entire purchase.\n192\t    type TicketRow = {\n193\t      ticketId: string;\n194\t      ticketTypeId: string | null;\n195\t      userId: string;\n196\t      eventId: string;\n197\t      bookingId: string;\n198\t      status: TicketPaymentStatus;\n199\t      quantity: number;\n200\t      totalPrice: number;\n201\t      faceValue: number;\n202\t      platformFee: number;\n203\t      gatewayFee: number;\n204\t      gst: number;\n205\t      feeBornBy: \"HOST\" | \"USER\";\n206\t      wasDiscounted: boolean;\n207\t      bundleGroupId: string | null;\n208\t      bundleWasDiscounted: boolean;\n209\t      checkedIn: boolean;\n210\t      seatId: string | null;\n211\t    };\n212\t    type AttendeeResponseRow = {\n213\t      ticketId: string;\n214\t      fieldId: string;\n215\t      value: string;\n216\t    };\n217\t\n218\t    const ticketRows: TicketRow[] = [];\n219\t    const responseRows: AttendeeResponseRow[] = [];\n220\t\n221\t    if (input.lines.length === 0) {\n222\t      ticketRows.push({\n223\t        ticketId: randomUUID(),\n224\t        ticketTypeId: null,\n225\t        userId: input.userId,\n226\t        eventId: input.eventId,\n227\t        bookingId: booking.bookingId,\n228\t        status: TicketPaymentStatus.PENDING,\n229\t        quantity: 1,\n230\t        totalPrice: 0,\n231\t        faceValue: 0,\n232\t        platformFee: 0,\n233\t        gatewayFee: 0,\n234\t        gst: 0,\n235\t        feeBornBy: \"HOST\",\n236\t        wasDiscounted: false,\n237\t        bundleGroupId: null,\n238\t        bundleWasDiscounted: false,\n239\t        checkedIn: false,\n240\t        seatId: null,\n241\t      });\n242\t    } else {\n243\t      for (const line of input.lines) {\n244\t        const {\n245\t          ticketTypeId,\n246\t          quantity,\n247\t          unitPrice,\n248\t          faceValue,\n249\t          platformFee,\n250\t          gatewayFee,\n251\t          gst,\n252\t          feeBornBy,\n253\t          wasDiscounted,\n254\t          bundleGroupId,\n255\t          bundleWasDiscounted,\n256\t          ticketFieldResponses,\n257\t          seatIds,\n258\t        } = line;\n259\t\n260\t        if (seatIds && seatIds.length > 0) {\n261\t          // Reserved seating: one row per seat (quantity 1 each), NOT the\n262\t          // aggregated row used below for GA lines — Ticket.seatId is a 1:1\n263\t          // link and each physical seat is checked in individually.\n264\t          for (let i = 0; i < seatIds.length; i++) {\n265\t            const ticketId = randomUUID();\n266\t            ticketRows.push({\n267\t              ticketId,\n268\t              ticketTypeId,\n269\t              userId: input.userId,\n270\t              eventId: input.eventId,\n271\t              bookingId: booking.bookingId,\n272\t              status: TicketPaymentStatus.PENDING,\n273\t              quantity: 1,\n274\t              totalPrice: unitPrice,\n275\t              faceValue,\n276\t              platformFee,\n277\t              gatewayFee,\n278\t              gst,\n279\t              feeBornBy,\n280\t              wasDiscounted,\n281\t              bundleGroupId,\n282\t              bundleWasDiscounted,\n283\t              checkedIn: false,\n284\t              seatId: seatIds[i],\n285\t            });\n286\t\n287\t            const seatResponses = ticketFieldResponses[i];\n288\t            if (seatResponses) {\n289\t              for (const r of seatResponses) {\n290\t                responseRows.push({ ticketId, fieldId: r.fieldId, value: r.value });\n291\t              }\n292\t            }\n293\t          }\n294\t          continue;\n295\t        }\n296\t\n297\t        // One row per line, not one per seat.\n298\t        // Prices are row totals (unitPrice × quantity) so SUM(totalPrice)\n299\t        // across all ticket rows still equals booking.total, keeping\n300\t        // analytics and payment-worker revenue calculations correct.\n301\t        const ticketId = randomUUID();\n302\t\n303\t        ticketRows.push({\n304\t          ticketId,\n305\t          ticketTypeId,\n306\t          userId: input.userId,\n307\t          eventId: input.eventId,\n308\t          bookingId: booking.bookingId,\n309\t          status: TicketPaymentStatus.PENDING,\n310\t          quantity,\n311\t          totalPrice: unitPrice * quantity,\n312\t          faceValue: faceValue * quantity, // row total: pre-coupon seatFace × qty\n313\t          platformFee: platformFee * quantity,\n314\t          gatewayFee: gatewayFee * quantity,\n315\t          gst: gst * quantity,\n316\t          feeBornBy,\n317\t          wasDiscounted,\n318\t          bundleGroupId,\n319\t          bundleWasDiscounted,\n320\t          checkedIn: false,\n321\t          seatId: null,\n322\t        });\n323\t\n324\t        // Flatten per-seat field responses under the single ticket row.\n325\t        for (const seatResponses of ticketFieldResponses) {\n326\t          if (seatResponses) {\n327\t            for (const r of seatResponses) {\n328\t              responseRows.push({\n329\t                ticketId,\n330\t                fieldId: r.fieldId,\n331\t                value: r.value,\n332\t              });\n333\t            }\n334\t          }\n335\t        }\n336\t      }\n337\t    }\n338\t\n339\t    // Reserved seating: atomically flip AVAILABLE -> HELD for every\n340\t    // requested seat, tied to this booking. If any seat was claimed by\n341\t    // someone else between validateSeatSelections() and this transaction,\n342\t    // the count mismatches and we abort — the whole transaction (including\n343\t    // the booking row just created above) rolls back.\n344\t    const allSeatIds = input.lines.flatMap((l) => l.seatIds ?? []);\n345\t    if (allSeatIds.length > 0) {\n346\t      const flipped = await tx.seat.updateMany({\n347\t        where: { seatId: { in: allSeatIds }, status: \"AVAILABLE\" },\n348\t        data: {\n349\t          status: \"HELD\",\n350\t          holdBookingId: booking.bookingId,\n351\t          holdExpiresAt: input.holdExpiresAt,\n352\t        },\n353\t      });\n354\t      if (flipped.count !== allSeatIds.length) {\n355\t        throw new ConflictError(\"SEAT_NO_LONGER_AVAILABLE\");\n356\t      }\n357\t    }\n358\t\n359\t    await tx.ticket.createMany({ data: ticketRows });\n360\t\n361\t    if (responseRows.length > 0) {\n362\t      await tx.attendeeFieldResponse.createMany({ data: responseRows });\n363\t    }\n364\t\n365\t    return booking.bookingId;\n366\t  }\n367\t}\n368\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"47c951f9-2727-4d88-b7fb-914dad2d84e9","timestamp":"2026-11-20T19:04:58.915Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/repositories/booking/booking-creation.repository.ts","content":"import { randomUUID } from \"node:crypto\";\nimport { prisma } from \"../../config/db\";\nimport { BookingStatus, TicketPaymentStatus } from \"../../generated/prisma/enums\";\nimport type { TransactionClient } from \"../../generated/prisma/internal/prismaNamespace\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\nimport { ConflictError } from \"../../utils/errors.util\";\nimport { generateTicketCode } from \"../../utils/qr-code.util\";\nimport type { BookingLifecycleRepository } from \"./booking-lifecycle.repository\";\nimport type { BookingLineInput, CreateBookingInput } from \"./types\";\n\nexport class BookingCreationRepository {\n  constructor(private readonly lifecycleRepo: BookingLifecycleRepository) {}\n\n  /**\n   * Create a new booking with an inventory hold.\n   *\n   * Runs entirely inside a single Prisma interactive transaction:\n   *  1. Atomically increments soldCount for each TicketType (fails on sold-out).\n   *  2. Creates the Booking row (status HELD).\n   *  3. Creates one Ticket row per seat.\n   *  4. Bulk-inserts AttendeeFieldResponse rows for each ticket if provided.\n   *\n   * Returns the new bookingId.\n   */\n  async createWithHoldTx(input: CreateBookingInput): Promise<string> {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        await this.reserveInventoryTx(tx, input.lines);\n        return await this.insertBookingWithTicketsTx(tx, input);\n      });\n    }, \"Create booking with hold\");\n  }\n\n  /**\n   * Atomically supersede an existing HELD booking (release its inventory\n   * hold, mark it CANCELLED) and create a new HELD booking in its place —\n   * within ONE transaction, so the caller is never left holding two\n   * concurrent active bookings for the same event, and never loses their\n   * hold if the new one fails to reserve inventory.\n   *\n   * Used for in-place ticket-quantity edits (e.g. Review & Pay step) instead\n   * of the client calling cancel() and create() as two separate requests,\n   * which would let a buyer refresh a fresh hold window indefinitely by\n   * cycling quantity, or lose their hold entirely if create() failed after\n   * an already-committed cancel().\n   *\n   * Throws ConflictError(\"SUPERSEDE_TARGET_NOT_HELD\") if `supersede.bookingId`\n   * is no longer a HELD booking owned by `supersede.userId` (already paid,\n   * expired, or cancelled elsewhere) — the caller must reload booking state\n   * rather than silently getting an extra, unrelated hold.\n   */\n  async createWithHoldSupersedingTx(\n    input: CreateBookingInput,\n    supersede: { bookingId: string; userId: string },\n  ): Promise<string> {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        const released = await this.lifecycleRepo.releaseHoldInTx(\n          tx,\n          supersede.bookingId,\n          BookingStatus.CANCELLED,\n          { userId: supersede.userId, statusIn: [BookingStatus.HELD] },\n        );\n        if (!released) {\n          throw new ConflictError(\"SUPERSEDE_TARGET_NOT_HELD\");\n        }\n\n        await this.reserveInventoryTx(tx, input.lines);\n        return await this.insertBookingWithTicketsTx(tx, input);\n      });\n    }, \"Supersede and create booking with hold\");\n  }\n\n  /**\n   * Atomically increments soldCount/discountSoldCount for each ticket type\n   * referenced by `lines`, failing with TICKET_SOLD_OUT if capacity (overall\n   * or discount-slot) would be exceeded. Aggregates by ticketTypeId first —\n   * the service emits two lines per type when a booking spans the\n   * early-bird boundary (one discounted + one full-price).\n   */\n  private async reserveInventoryTx(\n    tx: TransactionClient,\n    lines: BookingLineInput[],\n  ): Promise<void> {\n    const aggByType = new Map<\n      string,\n      { totalQty: number; discountQty: number }\n    >();\n    for (const line of lines) {\n      const agg = aggByType.get(line.ticketTypeId) ?? {\n        totalQty: 0,\n        discountQty: 0,\n      };\n      agg.totalQty += line.quantity;\n      if (line.wasDiscounted) agg.discountQty += line.quantity;\n      aggByType.set(line.ticketTypeId, agg);\n    }\n\n    for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n      const affected = await tx.$executeRaw`\n\t\t\t\t\tUPDATE \"TicketType\"\n\t\t\t\t\tSET \"soldCount\" = \"soldCount\" + ${totalQty},\n\t\t\t\t\t    \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n\t\t\t\t\t  AND \"soldCount\" + ${totalQty} <= \"quantity\"\n\t\t\t\t\t  AND (\n\t\t\t\t\t    ${discountQty}::int = 0\n\t\t\t\t\t    OR (\n\t\t\t\t\t      \"discountQuantity\" IS NOT NULL\n\t\t\t\t\t      AND \"discountSoldCount\" + ${discountQty} <= \"discountQuantity\"\n\t\t\t\t\t    )\n\t\t\t\t\t  )\n\t\t\t\t`;\n\n      if (affected === 0) {\n        throw new ConflictError(`TICKET_SOLD_OUT:${ticketTypeId}`);\n      }\n    }\n\n    // Bundle-level early-bird slots consume TicketTypeGroup.discountSoldCount\n    // instead of any member ticket type's own counter — member inventory\n    // (soldCount) was already reserved above via totalQty regardless.\n    // Every bundle member's line for the same bundle purchase carries the\n    // IDENTICAL quantity (the number of bundle-units bought) — summing\n    // across members would multi-count by the bundle's member count, so\n    // take the quantity once per group instead of accumulating it.\n    const groupDiscountAgg = new Map<string, number>();\n    for (const line of lines) {\n      if (!line.bundleGroupId || !line.bundleWasDiscounted) continue;\n      groupDiscountAgg.set(\n        line.bundleGroupId,\n        Math.max(groupDiscountAgg.get(line.bundleGroupId) ?? 0, line.quantity),\n      );\n    }\n    for (const [groupId, discountQty] of groupDiscountAgg) {\n      const affected = await tx.$executeRaw`\n\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n\t\t\t\t\tSET \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n\t\t\t\t\t  AND \"discountQuantity\" IS NOT NULL\n\t\t\t\t\t  AND \"discountSoldCount\" + ${discountQty} <= \"discountQuantity\"\n\t\t\t\t`;\n      if (affected === 0) {\n        throw new ConflictError(`TICKET_SOLD_OUT:${groupId}`);\n      }\n    }\n  }\n\n  /**\n   * Creates the Booking row (with a single booking-level QR code) plus one\n   * Ticket row per line and any AttendeeFieldResponse rows. Assumes\n   * inventory has already been reserved by `reserveInventoryTx` in the same\n   * transaction. Returns the new bookingId.\n   */\n  private async insertBookingWithTicketsTx(\n    tx: TransactionClient,\n    input: CreateBookingInput,\n  ): Promise<string> {\n    const bookingQrCode = generateTicketCode();\n    const booking = await tx.booking.create({\n      data: {\n        userId: input.userId,\n        eventId: input.eventId,\n        status: input.approvalRequest\n          ? BookingStatus.PENDING_APPROVAL\n          : BookingStatus.HELD,\n        subtotal: input.subtotal,\n        platformFee: input.platformFee,\n        gatewayFee: input.gatewayFee,\n        gst: input.gst,\n        feesBornBy: input.feesBornBy,\n        total: input.total,\n        holdExpiresAt: input.holdExpiresAt,\n        qrCode: bookingQrCode,\n        commonFieldResponses: input.commonFieldResponses,\n        ...(input.approvalRequest\n          ? { approvalRequestedAt: input.approvalRequest.requestedAt }\n          : {}),\n        ...(input.referrer ? { referrer: input.referrer } : {}),\n        ...(input.city ? { city: input.city } : {}),\n        ...(input.state ? { state: input.state } : {}),\n        ...(input.userAgent ? { userAgent: input.userAgent } : {}),\n        ...(input.checkoutSessionId\n          ? { checkoutSessionId: input.checkoutSessionId }\n          : {}),\n      },\n      select: { bookingId: true },\n    });\n\n    // Tickets no longer carry individual QR codes — the booking-level\n    // qrCode is the single scannable for the entire purchase.\n    type TicketRow = {\n      ticketId: string;\n      ticketTypeId: string | null;\n      userId: string;\n      eventId: string;\n      bookingId: string;\n      status: TicketPaymentStatus;\n      quantity: number;\n      totalPrice: number;\n      faceValue: number;\n      platformFee: number;\n      gatewayFee: number;\n      gst: number;\n      feeBornBy: \"HOST\" | \"USER\";\n      wasDiscounted: boolean;\n      bundleGroupId: string | null;\n      bundleWasDiscounted: boolean;\n      checkedIn: boolean;\n      seatId: string | null;\n    };\n    type AttendeeResponseRow = {\n      ticketId: string;\n      fieldId: string;\n      value: string;\n    };\n\n    const ticketRows: TicketRow[] = [];\n    const responseRows: AttendeeResponseRow[] = [];\n\n    if (input.lines.length === 0) {\n      ticketRows.push({\n        ticketId: randomUUID(),\n        ticketTypeId: null,\n        userId: input.userId,\n        eventId: input.eventId,\n        bookingId: booking.bookingId,\n        status: TicketPaymentStatus.PENDING,\n        quantity: 1,\n        totalPrice: 0,\n        faceValue: 0,\n        platformFee: 0,\n        gatewayFee: 0,\n        gst: 0,\n        feeBornBy: \"HOST\",\n        wasDiscounted: false,\n        bundleGroupId: null,\n        bundleWasDiscounted: false,\n        checkedIn: false,\n        seatId: null,\n      });\n    } else {\n      for (const line of input.lines) {\n        const {\n          ticketTypeId,\n          quantity,\n          unitPrice,\n          faceValue,\n          platformFee,\n          gatewayFee,\n          gst,\n          feeBornBy,\n          wasDiscounted,\n          bundleGroupId,\n          bundleWasDiscounted,\n          ticketFieldResponses,\n          seatIds,\n        } = line;\n\n        if (seatIds && seatIds.length > 0) {\n          // Reserved seating: one row per seat (quantity 1 each), NOT the\n          // aggregated row used below for GA lines — Ticket.seatId is a 1:1\n          // link and each physical seat is checked in individually.\n          for (let i = 0; i < seatIds.length; i++) {\n            const ticketId = randomUUID();\n            ticketRows.push({\n              ticketId,\n              ticketTypeId,\n              userId: input.userId,\n              eventId: input.eventId,\n              bookingId: booking.bookingId,\n              status: TicketPaymentStatus.PENDING,\n              quantity: 1,\n              totalPrice: unitPrice,\n              faceValue,\n              platformFee,\n              gatewayFee,\n              gst,\n              feeBornBy,\n              wasDiscounted,\n              bundleGroupId,\n              bundleWasDiscounted,\n              checkedIn: false,\n              seatId: seatIds[i],\n            });\n\n            const seatResponses = ticketFieldResponses[i];\n            if (seatResponses) {\n              for (const r of seatResponses) {\n                responseRows.push({ ticketId, fieldId: r.fieldId, value: r.value });\n              }\n            }\n          }\n          continue;\n        }\n\n        // One row per line, not one per seat.\n        // Prices are row totals (unitPrice × quantity) so SUM(totalPrice)\n        // across all ticket rows still equals booking.total, keeping\n        // analytics and payment-worker revenue calculations correct.\n        const ticketId = randomUUID();\n\n        ticketRows.push({\n          ticketId,\n          ticketTypeId,\n          userId: input.userId,\n          eventId: input.eventId,\n          bookingId: booking.bookingId,\n          status: TicketPaymentStatus.PENDING,\n          quantity,\n          totalPrice: unitPrice * quantity,\n          faceValue: faceValue * quantity, // row total: pre-coupon seatFace × qty\n          platformFee: platformFee * quantity,\n          gatewayFee: gatewayFee * quantity,\n          gst: gst * quantity,\n          feeBornBy,\n          wasDiscounted,\n          bundleGroupId,\n          bundleWasDiscounted,\n          checkedIn: false,\n          seatId: null,\n        });\n\n        // Flatten per-seat field responses under the single ticket row.\n        for (const seatResponses of ticketFieldResponses) {\n          if (seatResponses) {\n            for (const r of seatResponses) {\n              responseRows.push({\n                ticketId,\n                fieldId: r.fieldId,\n                value: r.value,\n              });\n            }\n          }\n        }\n      }\n    }\n\n    // Reserved seating: atomically flip AVAILABLE -> HELD for every\n    // requested seat, tied to this booking. If any seat was claimed by\n    // someone else between validateSeatSelections() and this transaction,\n    // the count mismatches and we abort — the whole transaction (including\n    // the booking row just created above) rolls back.\n    const allSeatIds = input.lines.flatMap((l) => l.seatIds ?? []);\n    if (allSeatIds.length > 0) {\n      const flipped = await tx.seat.updateMany({\n        where: { seatId: { in: allSeatIds }, status: \"AVAILABLE\" },\n        data: {\n          status: \"HELD\",\n          holdBookingId: booking.bookingId,\n          holdExpiresAt: input.holdExpiresAt,\n        },\n      });\n      if (flipped.count !== allSeatIds.length) {\n        throw new ConflictError(\"SEAT_NO_LONGER_AVAILABLE\");\n      }\n    }\n\n    await tx.ticket.createMany({ data: ticketRows });\n\n    if (responseRows.length > 0) {\n      await tx.attendeeFieldResponse.createMany({ data: responseRows });\n    }\n\n    return booking.bookingId;\n  }\n}\n","numLines":368,"startLine":1,"totalLines":368}},"tool_result_meta":[{"id":"call-9b276da8-6d44-465a-9ca5-cb18c41d7e75","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
