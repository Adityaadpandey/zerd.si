cketTypeId], references: [ticketTypeId])\n1651-\n1652-  rowLabel   String\n1653-  seatNumber String\n1654-  x          Float\n1655-  y          Float\n1656-  rotation   Float  @default(0)\n1657-\n1658-  status       SeatStatus @default(AVAILABLE)\n1659-  isAccessible Boolean    @default(false)\n1660-\n1661-  holdBookingId String?\n1662-  holdBooking   Booking?  @relation(fields: [holdBookingId], references: [bookingId], onDelete: SetNull)\n1663-  holdExpiresAt DateTime?\n1664-\n1665-  ticket Ticket?\n1666-\n1667-  createdAt DateTime @default(now())\n1668-  updatedAt DateTime @updatedAt\n1669-\n1670-  @@unique([eventSeatMapId, rowLabel, seatNumber])\n1671-  @@index([eventSeatMapId, status])\n1672-  @@index([ticketTypeId])\n1673-  @@index([holdBookingId])\n1674-  @@index([holdExpiresAt])\n1675-}\n1676-\n1677-model AttendeeFieldResponse {\n1678-  responseId String      @id @default(uuid(7))\n1679-  ticketId   String\n1680-  ticket     Ticket      @relation(fields: [ticketId], references: [ticketId])\n1681-  fieldId    String\n1682-  field      CustomField @relation(fields: [fieldId], references: [fieldId])\n1683-  value      String\n=== TicketPaymentStatus ===\n32:enum TicketPaymentStatus {\n33-  PENDING\n34-  SUCCESS\n35-  FAILED\n36-  REFUNDED\n37-}\n38-\n39-enum PaymentStatus {\n40-  PENDING\n41-  PROCESSING\n42-  COMPLETED\n43-  FAILED\n44-  REFUNDED","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"3a0bdb06-15aa-495d-a269-c34d1c0f539c","timestamp":"2026-11-20T19:35:10.926Z","tool_use_result":{"stdout":"=== Seat model ===\n1589:model SeatingTemplate {\n1590-  templateId String @id @default(uuid(7))\n1591-\n1592-  listerId String\n1593-  lister   Lister @relation(fields: [listerId], references: [listerId])\n1594-\n1595-  // Null = a host-generic template, reusable at any venue. Set = tied to the\n1596-  // physical venue it was drawn for.\n1597-  venueId String?\n1598-  venue   Venue?  @relation(fields: [venue