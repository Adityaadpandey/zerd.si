{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-a8696aab-48b4-47a2-8885-de27022ebe05","type":"tool_result","content":"import { randomUUID } from \"node:crypto\";\nimport { prisma } from \"../../config/db\";\nimport { TICKET_OG_SELECT, TICKET_SELECT } from \"../../types/ticket.types\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\nimport { ConflictError } from \"../../utils/errors.util\";\nimport { generateTicketCode } from \"../../utils/qr-code.util\";\n\nexport class TicketCoreRepository {\n  /**\n   * Create booking with tickets (atomic operation)\n   * This decrements inventory and creates tickets in a transaction\n   */\n  async createBookingWithTickets(\n    userId: string,\n    eventId: string,\n    ticketTypeId: string,\n    quantity: number,\n    totalPrice: number,\n    customFieldResponses?: Array<{ fieldId: string; value: string }>,\n  ) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        // 1. Check and decrement inventory atomically\n        const ticketType = await tx.ticketType.findUnique({\n          where: { ticketTypeId },\n          select: {\n            quantity: true,\n            soldCount: true,\n            capacityLimit: true,\n          },\n        });\n\n        if (!ticketType) {\n          throw new Error(\"Ticket type not found\");\n        }\n\n        const available = ticketType.quantity - ticketType.soldCount;\n        if (available < quantity) {\n          throw new Error(\"Insufficient tickets available\");\n        }\n\n        // Check capacity limit if set\n        if (\n          ticketType.capacityLimit &&\n          ticketType.soldCount + quantity > ticketType.capacityLimit\n        ) {\n          throw new Error(\"Capacity limit exceeded\");\n        }\n\n        // Increment soldCount atomically\n        await tx.ticketType.update({\n          where: { ticketTypeId },\n          data: {\n            soldCount: {\n              increment: quantity,\n            },\n          },\n        });\n\n        // 2. Create tickets in bulk (avoids N+1 for multi-ticket bookings)\n        const ticketRows = Array.from({ length: quantity }, () => {\n          const ticketId = randomUUID();\n          return {\n            ticketId,\n            ticketTypeId,\n            userId,\n            eventId,\n            status: \"PENDING\" as const,\n            quantity: 1,\n            totalPrice: totalPrice / quantity,\n            qrCode: generateTicketCode(),\n            checkedIn: false,\n          };\n        });\n\n        await tx.ticket.createMany({ data: ticketRows });\n\n        const tickets = await tx.ticket.findMany({\n          where: { ticketId: { in: ticketRows.map((t) => t.ticketId) } },\n          select: TICKET_SELECT,\n        });\n\n        // 3. Create custom field responses in bulk if provided\n        if (customFieldResponses && customFieldResponses.length > 0) {\n          const responseRows = tickets.flatMap((ticket) =>\n            customFieldResponses.map((response) => ({\n              ticketId: ticket.ticketId,\n              fieldId: response.fieldId,\n              value: response.value,\n            }))\n          );\n          await tx.attendeeFieldResponse.createMany({ data: responseRows });\n        }\n\n        return {\n          tickets,\n          totalPrice,\n          quantity,\n        };\n      });\n    }, \"Create booking with tickets\");\n  }\n\n  /**\n   * Find ticket by ID\n   */\n  async findTicketById(ticketId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.ticket.findUnique({\n        where: { ticketId },\n        select: TICKET_SELECT,\n      });\n    }, \"Find ticket by ID\");\n  }\n\n  /**\n   * Find ticket OG data by ID (public — no sensitive fields)\n   */\n  async findTicketOGById(ticketId: string) {\n    return wrapDatabaseOperation(async () => {","is_error":false}]},"parent_tool_us