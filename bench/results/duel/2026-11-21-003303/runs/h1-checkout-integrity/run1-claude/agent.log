{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-70aab4f4-aa92-41fb-8b9c-bc200d25cc7c","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport {\n3\t  BookingStatus,\n4\t  TicketPaymentStatus,\n5\t} from \"../../generated/prisma/enums\";\n6\timport type { TransactionClient } from \"../../generated/prisma/internal/prismaNamespace\";\n7\timport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n8\t\n9\texport class BookingLifecycleRepository {\n10\t  /**\n11\t   * Release a booking hold — reverses soldCount increments and marks\n12\t   * booking/tickets as EXPIRED or CANCELLED.\n13\t   *\n14\t   * Idempotent: returns null if the booking is not found or not in HELD state.\n15\t   */\n16\t  async releaseHoldTx(\n17\t    bookingId: string,\n18\t    reason: \"EXPIRED\" | \"CANCELLED\" | \"FAILED\",\n19\t  ): Promise<string | null> {\n20\t    return wrapDatabaseOperation(async () => {\n21\t      return await prisma.$transaction(async (tx) => {\n22\t        const newStatus =\n23\t          reason === \"EXPIRED\"\n24\t            ? BookingStatus.EXPIRED\n25\t            : reason === \"FAILED\"\n26\t              ? BookingStatus.FAILED\n27\t              : BookingStatus.CANCELLED;\n28\t\n29\t        const released = await this.releaseHoldInTx(tx, bookingId, newStatus);\n30\t        return released ? bookingId : null;\n31\t      });\n32\t    }, \"Release booking hold\");\n33\t  }\n34\t\n35\t  /**\n36\t   * Shared release logic used by both `releaseHoldTx` (expiry / user cancel)\n37\t   * and `BookingCreationRepository.createWithHoldSupersedingTx` (in-place\n38\t   * quantity edits). Atomically transitions the booking to `newStatus` (only\n39\t   * the first concurrent caller wins) then decrements the inventory + marks\n40\t   * tickets FAILED. Returns false if the booking wasn't found, wasn't owned\n41\t   * by `opts.userId` (when given), or wasn't in one of `opts.statusIn`\n42\t   * (defaults to the three hold-bearing statuses — HELD / PENDING_APPROVAL /\n43\t   * APPROVED_AWAITING_PAYMENT, preserving releaseHoldTx's existing behavior\n44\t   * for expiry + host-decline).\n45\t   *\n46\t   * Public (not private) so BookingCreationRepository can call it as part of\n47\t   * its own transaction when superseding a hold — see the facade's\n48\t   * constructor wiring.\n49\t   */\n50\t  async releaseHoldInTx(\n51\t    tx: TransactionClient,\n52\t    bookingId: string,\n53\t    newStatus: BookingStatus,\n54\t    opts?: { userId?: string; statusIn?: BookingStatus[] },\n55\t  ): Promise<boolean> {\n56\t    const statusIn = opts?.statusIn ?? [\n57\t      BookingStatus.HELD,\n58\t      BookingStatus.PENDING_APPROVAL,\n59\t      BookingStatus.APPROVED_AWAITING_PAYMENT,\n60\t    ];\n61\t\n62\t    // Atomic status transition: only the first concurrent caller wins.\n63\t    const transition = await tx.booking.updateMany({\n64\t      where: {\n65\t        bookingId,\n66\t        ...(opts?.userId ? { userId: opts.userId } : {}),\n67\t        status: { in: statusIn },\n68\t      },\n69\t      data: { status: newStatus },\n70\t    });\n71\t\n72\t    if (transition.count === 0) {\n73\t      // Missing booking, wrong owner, or already released by another worker.\n74\t      return false;\n75\t    }\n76\t\n77\t    // We own the release — load tickets for decrement + status update.\n78\t    const tickets = await tx.ticket.findMany({\n79\t      where: { bookingId },\n80\t      select: {\n81\t        ticketId: true,\n82\t        ticketTypeId: true,\n83\t        wasDiscounted: true,\n84\t        quantity: true,\n85\t        bundleGroupId: true,\n86\t        bundleWasDiscounted: true,\n87\t        teamId: true,\n88\t        userId: true,\n89\t        seatId: true,\n90\t      },\n91\t    });\n92\t\n93\t    // Aggregate counts per ticketType (skip RSVP tickets — null ticketTypeId).\n94\t    // Track total + discounted seats so we can decrement both counters.\n95\t    // Use ticket.quantity (not += 1) since each row now represents N seats.\n96\t    const aggByType = new Map<\n97\t      string,\n98\t      { totalQty: number; discountQty: number }\n99\t    >();\n100\t    const groupDiscountAgg = new Map<string, number>();\n101\t    for (const ticket of tickets) {\n102\t      if (!ticket.ticketTypeId) continue;\n103\t      const agg = aggByType.get(ticket.ticketTypeId) ?? {\n104\t        totalQty: 0,\n105\t        discountQty: 0,\n106\t      };\n107\t      agg.totalQty += ticket.quantity;\n108\t      if (ticket.wasDiscounted) agg.discountQty += ticket.quantity;\n109\t      aggByType.set(ticket.ticketTypeId, agg);\n110\t\n111\t      if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n112\t        // Every bundle member's ticket row for the same bundle purchase\n113\t        // carries the IDENTICAL quantity (the number of bundle-units\n114\t        // bought) — summing across members would multi-count by the\n115\t        // bundle's member count, so take the quantity once per group.\n116\t        groupDiscountAgg.set(\n117\t          ticket.bundleGroupId,\n118\t          Math.max(\n119\t            groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n120\t            ticket.quantity,\n121\t          ),\n122\t        );\n123\t      }\n124\t    }\n125\t\n126\t    for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n127\t      await tx.$executeRaw`\n128\t\t\t\t\t\tUPDATE \"TicketType\"\n129\t\t\t\t\t\tSET \"soldCount\" = \"soldCount\" - ${totalQty},\n130\t\t\t\t\t\t    \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n131\t\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n132\t\t\t\t\t\t  AND \"soldCount\" >= ${totalQty}\n133\t\t\t\t\t`;\n134\t    }\n135\t\n136\t    for (const [groupId, discountQty] of groupDiscountAgg) {\n137\t      await tx.$executeRaw`\n138\t\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n139\t\t\t\t\t\tSET \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n140\t\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n141\t\t\t\t\t`;\n142\t    }\n143\t\n144\t    const ticketIds = tickets.map((t) => t.ticketId);\n145\t    if (ticketIds.length > 0) {\n146\t      await tx.ticket.updateMany({\n147\t        where: { ticketId: { in: ticketIds } },\n148\t        data: { status: TicketPaymentStatus.FAILED },\n149\t      });\n150\t    }\n151\t\n152\t    // Reserved seating: give the physical seats back so other buyers can\n153\t    // select them again. Covers expiry, user cancellation, and supersede —\n154\t    // every release path in this codebase funnels through here.\n155\t    const releasedSeatIds = tickets\n156\t      .map((t) => t.seatId)\n157\t      .filter((id): id is string => id != null);\n158\t    if (releasedSeatIds.length > 0) {\n159\t      await tx.seat.updateMany({\n160\t        where: { seatId: { in: releasedSeatIds } },\n161\t        data: { status: \"AVAILABLE\", holdBookingId: null, holdExpiresAt: null },\n162\t      });\n163\t    }\n164\t\n165\t    // If a released ticket belonged to a CONFIRMED team's open-seat\n166\t    // reservation (§2 of the open-seats design), the buyer abandoned\n167\t    // checkout — undo the reservation: drop the awaiting `TeamMember` row\n168\t    // and give the seat back. Scoped narrowly to CONFIRMED teams because a\n169\t    // leader's original `createTeamBooking` PENDING tickets are created\n170\t    // while the team is still PENDING — those never hit this branch and\n171\t    // never had `currentSize` incremented for them in the first place.\n172\t    const teamTicketOwners = new Map<string, string>();\n173\t    for (const t of tickets) {\n174\t      if (t.teamId) teamTicketOwners.set(t.userId, t.teamId);\n175\t    }\n176\t    for (const [userId, teamId] of teamTicketOwners) {\n177\t      const team = await tx.team.findUnique({\n178\t        where: { teamId },\n179\t        select: { status: true },\n180\t      });\n181\t      if (team?.status !== \"CONFIRMED\") continue;\n182\t\n183\t      const removed = await tx.teamMember.deleteMany({\n184\t        where: { teamId, userId, ticketId: null },\n185\t      });\n186\t      if (removed.count > 0) {\n187\t        await tx.team.update({\n188\t          where: { teamId },\n189\t          data: { currentSize: { decrement: 1 } },\n190\t        });\n191\t      }\n192\t    }\n193\t\n194\t    return true;\n195\t  }\n196\t\n197\t  /**\n198\t   * Extend the hold window for a HELD or APPROVED_AWAITING_PAYMENT booking.\n199\t   * Used by the payment service when a Razorpay order is created so the\n200\t   * in-flight payment isn't expired before it can be verified.\n201\t   */\n202\t  async extendHold(bookingId: string, newExpiresAt: Date): Promise<void> {\n203\t    await wrapDatabaseOperation(async () => {\n204\t      await prisma.booking.updateMany({\n205\t        where: {\n206\t          bookingId,\n207\t          status: {\n208\t            in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n209\t          },\n210\t        },\n211\t        data: { holdExpiresAt: newExpiresAt },\n212\t      });\n213\t    }, \"Extend booking hold\");\n214\t  }\n215\t\n216\t  /**\n217\t   * Mark a booking and all its tickets as paid.\n218\t   * Returns the full booking including tickets and payment.\n219\t   */\n220\t  async markPaidTx(\n221\t    bookingId: string,\n222\t    cash?: { reason: string },\n223\t  ): Promise<boolean> {\n224\t    return wrapDatabaseOperation(async () => {\n225\t      return await prisma.$transaction(async (tx) => {\n226\t        // Atomic: only transitions from live hold states so concurrent callers\n227\t        // (verifyBookingPayment + webhook) don't double-fire side effects.\n228\t        // A cash sale is tagged in the SAME update, so \"paid in cash\" can never\n229\t        // be recorded for a booking that a UPI payment actually won.\n230\t        const transition = await tx.booking.updateMany({\n231\t          where: {\n232\t            bookingId,\n233\t            status: {\n234\t              in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n235\t            },\n236\t          },\n237\t          data: {\n238\t            status: BookingStatus.PAID,\n239\t            ...(cash\n240\t              ? {\n241\t                  paymentMode: \"CASH\" as const,\n242\t                  cashReason: cash.reason || null,\n243\t                }\n244\t              : {}),\n245\t          },\n246\t        });\n247\t\n248\t        if (transition.count === 0) return false;\n249\t\n250\t        await tx.ticket.updateMany({\n251\t          where: { bookingId },\n252\t          data: { status: TicketPaymentStatus.SUCCESS },\n253\t        });\n254\t\n255\t        return true;\n256\t      });\n257\t    }, \"Mark booking as paid\");\n258\t  }\n259\t\n260\t  /**\n261\t   * Forces a booking back to PAID when it lost the race against its own\n262\t   * hold-expiry sweep — Razorpay captured the payment a few seconds after\n263\t   * `releaseHoldInTx` already flipped it to EXPIRED/FAILED/CANCELLED and\n264\t   * marked its tickets FAILED (the 15-minute window from\n265\t   * `createPaymentOrderForBooking`'s `extendHold` can be tight for a slow\n266\t   * UPI collect approval). `markPaidTx` deliberately won't touch a booking\n267\t   * once it's left HELD/APPROVED_AWAITING_PAYMENT, so a captured payment that\n268\t   * loses this race needs an explicit override rather than silently getting\n269\t   * dropped. Re-adds exactly what `releaseHoldInTx` subtracted for this\n270\t   * booking's tickets — the inverse of that method. Does NOT cap the\n271\t   * soldCount add at TicketType.quantity: the seat was already sold and paid\n272\t   * for, so if the freed slot got resold to someone else in the race window,\n273\t   * that's a rare oversell for the host to handle manually, not a reason to\n274\t   * deny a paying buyer their ticket. Returns false if the booking isn't in\n275\t   * one of the released states (nothing to reconcile).\n276\t   */\n277\t  async forcePaidAfterRaceTx(bookingId: string): Promise<boolean> {\n278\t    return wrapDatabaseOperation(async () => {\n279\t      return await prisma.$transaction(async (tx) => {\n280\t        const transition = await tx.booking.updateMany({\n281\t          where: {\n282\t            bookingId,\n283\t            status: {\n284\t              in: [\n285\t                BookingStatus.EXPIRED,\n286\t                BookingStatus.FAILED,\n287\t                BookingStatus.CANCELLED,\n288\t              ],\n289\t            },\n290\t          },\n291\t          data: { status: BookingStatus.PAID },\n292\t        });\n293\t\n294\t        if (transition.count === 0) return false;\n295\t\n296\t        const tickets = await tx.ticket.findMany({\n297\t          where: { bookingId },\n298\t          select: {\n299\t            ticketTypeId: true,\n300\t            wasDiscounted: true,\n301\t            quantity: true,\n302\t            bundleGroupId: true,\n303\t            bundleWasDiscounted: true,\n304\t          },\n305\t        });\n306\t\n307\t        const aggByType = new Map<\n308\t          string,\n309\t          { totalQty: number; discountQty: number }\n310\t        >();\n311\t        const groupDiscountAgg = new Map<string, number>();\n312\t        for (const ticket of tickets) {\n313\t          if (!ticket.ticketTypeId) continue;\n314\t          const agg = aggByType.get(ticket.ticketTypeId) ?? {\n315\t            totalQty: 0,\n316\t            discountQty: 0,\n317\t          };\n318\t          agg.totalQty += ticket.quantity;\n319\t          if (ticket.wasDiscounted) agg.discountQty += ticket.quantity;\n320\t          aggByType.set(ticket.ticketTypeId, agg);\n321\t\n322\t          if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n323\t            groupDiscountAgg.set(\n324\t              ticket.bundleGroupId,\n325\t              Math.max(\n326\t                groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n327\t                ticket.quantity,\n328\t              ),\n329\t            );\n330\t          }\n331\t        }\n332\t\n333\t        for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n334\t          await tx.$executeRaw`\n335\t\t\t\t\t\t\tUPDATE \"TicketType\"\n336\t\t\t\t\t\t\tSET \"soldCount\" = \"soldCount\" + ${totalQty},\n337\t\t\t\t\t\t\t    \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n338\t\t\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n339\t\t\t\t\t\t`;\n340\t        }\n341\t\n342\t        for (const [groupId, discountQty] of groupDiscountAgg) {\n343\t          await tx.$executeRaw`\n344\t\t\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n345\t\t\t\t\t\t\tSET \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n346\t\t\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n347\t\t\t\t\t\t`;\n348\t        }\n349\t\n350\t        await tx.ticket.updateMany({\n351\t          where: { bookingId },\n352\t          data: { status: TicketPaymentStatus.SUCCESS },\n353\t        });\n354\t\n355\t        return true;\n356\t      });\n357\t    }, \"Force booking paid after expiry race\");\n358\t  }\n359\t\n360\t  /** True if any ticket type in this booking now has more sold than its quantity. */\n361\t  async hasOversoldTicketType(bookingId: string): Promise<boolean> {\n362\t    return wrapDatabaseOperation(async () => {\n363\t      const rows = await prisma.$queryRaw<{ one: number }[]>`\n364\t        SELECT 1 AS one FROM \"TicketType\" tt\n365\t        WHERE tt.\"ticketTypeId\" IN (SELECT \"ticketTypeId\" FROM \"Ticket\" WHERE \"bookingId\" = ${bookingId})\n366\t          AND tt.\"soldCount\" > tt.\"quantity\"\n367\t        LIMIT 1\n368\t      `;\n369\t      return rows.length > 0;\n370\t    }, \"Check oversold ticket types for booking\");\n371\t  }\n372\t\n373\t  /**\n374\t   * Cancel a confirmed free/RSVP booking (status PAID → CANCELLED).\n375\t   * Sets all child tickets to REFUNDED. Returns true if updated, false if\n376\t   * the booking was already in a terminal state (idempotent).\n377\t   */\n378\t  async cancelConfirmedFreeTx(bookingId: string): Promise<boolean> {\n379\t    return wrapDatabaseOperation(async () => {\n380\t      return await prisma.$transaction(async (tx) => {\n381\t        const result = await tx.booking.updateMany({\n382\t          where: { bookingId, status: BookingStatus.PAID },\n383\t          data: { status: BookingStatus.CANCELLED },\n384\t        });\n385\t        if (result.count === 0) return false;\n386\t        await tx.ticket.updateMany({\n387\t          where: { bookingId },\n388\t          data: { status: TicketPaymentStatus.REFUNDED },\n389\t        });\n390\t        return true;\n391\t      });\n392\t    }, \"Cancel confirmed free booking\");\n393\t  }\n394\t}\n395\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"41d43f30-7e8b-4386-84d5-1bf04f82822e","timestamp":"2026-11-20T19:05:07.195Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/repositories/booking/booking-lifecycle.repository.ts","content":"import { prisma } from \"../../config/db\";\nimport {\n  BookingStatus,\n  TicketPaymentStatus,\n} from \"../../generated/prisma/enums\";\nimport type { TransactionClient } from \"../../generated/prisma/internal/prismaNamespace\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n\nexport class BookingLifecycleRepository {\n  /**\n   * Release a booking hold — reverses soldCount increments and marks\n   * booking/tickets as EXPIRED or CANCELLED.\n   *\n   * Idempotent: returns null if the booking is not found or not in HELD state.\n   */\n  async releaseHoldTx(\n    bookingId: string,\n    reason: \"EXPIRED\" | \"CANCELLED\" | \"FAILED\",\n  ): Promise<string | null> {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        const newStatus =\n          reason === \"EXPIRED\"\n            ? BookingStatus.EXPIRED\n            : reason === \"FAILED\"\n              ? BookingStatus.FAILED\n              : BookingStatus.CANCELLED;\n\n        const released = await this.releaseHoldInTx(tx, bookingId, newStatus);\n        return released ? bookingId : null;\n      });\n    }, \"Release booking hold\");\n  }\n\n  /**\n   * Shared release logic used by both `releaseHoldTx` (expiry / user cancel)\n   * and `BookingCreationRepository.createWithHoldSupersedingTx` (in-place\n   * quantity edits). Atomically transitions the booking to `newStatus` (only\n   * the first concurrent caller wins) then decrements the inventory + marks\n   * tickets FAILED. Returns false if the booking wasn't found, wasn't owned\n   * by `opts.userId` (when given), or wasn't in one of `opts.statusIn`\n   * (defaults to the three hold-bearing statuses — HELD / PENDING_APPROVAL /\n   * APPROVED_AWAITING_PAYMENT, preserving releaseHoldTx's existing behavior\n   * for expiry + host-decline).\n   *\n   * Public (not private) so BookingCreationRepository can call it as part of\n   * its own transaction when superseding a hold — see the facade's\n   * constructor wiring.\n   */\n  async releaseHoldInTx(\n    tx: TransactionClient,\n    bookingId: string,\n    newStatus: BookingStatus,\n    opts?: { userId?: string; statusIn?: BookingStatus[] },\n  ): Promise<boolean> {\n    const statusIn = opts?.statusIn ?? [\n      BookingStatus.HELD,\n      BookingStatus.PENDING_APPROVAL,\n      BookingStatus.APPROVED_AWAITING_PAYMENT,\n    ];\n\n    // Atomic status transition: only the first concurrent caller wins.\n    const transition = await tx.booking.updateMany({\n      where: {\n        bookingId,\n        ...(opts?.userId ? { userId: opts.userId } : {}),\n        status: { in: statusIn },\n      },\n      data: { status: newStatus },\n    });\n\n    if (transition.count === 0) {\n      // Missing booking, wrong owner, or already released by another worker.\n      return false;\n    }\n\n    // We own the release — load tickets for decrement + status update.\n    const tickets = await tx.ticket.findMany({\n      where: { bookingId },\n      select: {\n        ticketId: true,\n        ticketTypeId: true,\n        wasDiscounted: true,\n        quantity: true,\n        bundleGroupId: true,\n        bundleWasDiscounted: true,\n        teamId: true,\n        userId: true,\n        seatId: true,\n      },\n    });\n\n    // Aggregate counts per ticketType (skip RSVP tickets — null ticketTypeId).\n    // Track total + discounted seats so we can decrement both counters.\n    // Use ticket.quantity (not += 1) since each row now represents N seats.\n    const aggByType = new Map<\n      string,\n      { totalQty: number; discountQty: number }\n    >();\n    const groupDiscountAgg = new Map<string, number>();\n    for (const ticket of tickets) {\n      if (!ticket.ticketTypeId) continue;\n      const agg = aggByType.get(ticket.ticketTypeId) ?? {\n        totalQty: 0,\n        discountQty: 0,\n      };\n      agg.totalQty += ticket.quantity;\n      if (ticket.wasDiscounted) agg.discountQty += ticket.quantity;\n      aggByType.set(ticket.ticketTypeId, agg);\n\n      if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n        // Every bundle member's ticket row for the same bundle purchase\n        // carries the IDENTICAL quantity (the number of bundle-units\n        // bought) — summing across members would multi-count by the\n        // bundle's member count, so take the quantity once per group.\n        groupDiscountAgg.set(\n          ticket.bundleGroupId,\n          Math.max(\n            groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n            ticket.quantity,\n          ),\n        );\n      }\n    }\n\n    for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n      await tx.$executeRaw`\n\t\t\t\t\tUPDATE \"TicketType\"\n\t\t\t\t\tSET \"soldCount\" = \"soldCount\" - ${totalQty},\n\t\t\t\t\t    \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n\t\t\t\t\t  AND \"soldCount\" >= ${totalQty}\n\t\t\t\t`;\n    }\n\n    for (const [groupId, discountQty] of groupDiscountAgg) {\n      await tx.$executeRaw`\n\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n\t\t\t\t\tSET \"discountSoldCount\" = GREATEST(\"discountSoldCount\" - ${discountQty}, 0)\n\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n\t\t\t\t`;\n    }\n\n    const ticketIds = tickets.map((t) => t.ticketId);\n    if (ticketIds.length > 0) {\n      await tx.ticket.updateMany({\n        where: { ticketId: { in: ticketIds } },\n        data: { status: TicketPaymentStatus.FAILED },\n      });\n    }\n\n    // Reserved seating: give the physical seats back so other buyers can\n    // select them again. Covers expiry, user cancellation, and supersede —\n    // every release path in this codebase funnels through here.\n    const releasedSeatIds = tickets\n      .map((t) => t.seatId)\n      .filter((id): id is string => id != null);\n    if (releasedSeatIds.length > 0) {\n      await tx.seat.updateMany({\n        where: { seatId: { in: releasedSeatIds } },\n        data: { status: \"AVAILABLE\", holdBookingId: null, holdExpiresAt: null },\n      });\n    }\n\n    // If a released ticket belonged to a CONFIRMED team's open-seat\n    // reservation (§2 of the open-seats design), the buyer abandoned\n    // checkout — undo the reservation: drop the awaiting `TeamMember` row\n    // and give the seat back. Scoped narrowly to CONFIRMED teams because a\n    // leader's original `createTeamBooking` PENDING tickets are created\n    // while the team is still PENDING — those never hit this branch and\n    // never had `currentSize` incremented for them in the first place.\n    const teamTicketOwners = new Map<string, string>();\n    for (const t of tickets) {\n      if (t.teamId) teamTicketOwners.set(t.userId, t.teamId);\n    }\n    for (const [userId, teamId] of teamTicketOwners) {\n      const team = await tx.team.findUnique({\n        where: { teamId },\n        select: { status: true },\n      });\n      if (team?.status !== \"CONFIRMED\") continue;\n\n      const removed = await tx.teamMember.deleteMany({\n        where: { teamId, userId, ticketId: null },\n      });\n      if (removed.count > 0) {\n        await tx.team.update({\n          where: { teamId },\n          data: { currentSize: { decrement: 1 } },\n        });\n      }\n    }\n\n    return true;\n  }\n\n  /**\n   * Extend the hold window for a HELD or APPROVED_AWAITING_PAYMENT booking.\n   * Used by the payment service when a Razorpay order is created so the\n   * in-flight payment isn't expired before it can be verified.\n   */\n  async extendHold(bookingId: string, newExpiresAt: Date): Promise<void> {\n    await wrapDatabaseOperation(async () => {\n      await prisma.booking.updateMany({\n        where: {\n          bookingId,\n          status: {\n            in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n          },\n        },\n        data: { holdExpiresAt: newExpiresAt },\n      });\n    }, \"Extend booking hold\");\n  }\n\n  /**\n   * Mark a booking and all its tickets as paid.\n   * Returns the full booking including tickets and payment.\n   */\n  async markPaidTx(\n    bookingId: string,\n    cash?: { reason: string },\n  ): Promise<boolean> {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        // Atomic: only transitions from live hold states so concurrent callers\n        // (verifyBookingPayment + webhook) don't double-fire side effects.\n        // A cash sale is tagged in the SAME update, so \"paid in cash\" can never\n        // be recorded for a booking that a UPI payment actually won.\n        const transition = await tx.booking.updateMany({\n          where: {\n            bookingId,\n            status: {\n              in: [BookingStatus.HELD, BookingStatus.APPROVED_AWAITING_PAYMENT],\n            },\n          },\n          data: {\n            status: BookingStatus.PAID,\n            ...(cash\n              ? {\n                  paymentMode: \"CASH\" as const,\n                  cashReason: cash.reason || null,\n                }\n              : {}),\n          },\n        });\n\n        if (transition.count === 0) return false;\n\n        await tx.ticket.updateMany({\n          where: { bookingId },\n          data: { status: TicketPaymentStatus.SUCCESS },\n        });\n\n        return true;\n      });\n    }, \"Mark booking as paid\");\n  }\n\n  /**\n   * Forces a booking back to PAID when it lost the race against its own\n   * hold-expiry sweep — Razorpay captured the payment a few seconds after\n   * `releaseHoldInTx` already flipped it to EXPIRED/FAILED/CANCELLED and\n   * marked its tickets FAILED (the 15-minute window from\n   * `createPaymentOrderForBooking`'s `extendHold` can be tight for a slow\n   * UPI collect approval). `markPaidTx` deliberately won't touch a booking\n   * once it's left HELD/APPROVED_AWAITING_PAYMENT, so a captured payment that\n   * loses this race needs an explicit override rather than silently getting\n   * dropped. Re-adds exactly what `releaseHoldInTx` subtracted for this\n   * booking's tickets — the inverse of that method. Does NOT cap the\n   * soldCount add at TicketType.quantity: the seat was already sold and paid\n   * for, so if the freed slot got resold to someone else in the race window,\n   * that's a rare oversell for the host to handle manually, not a reason to\n   * deny a paying buyer their ticket. Returns false if the booking isn't in\n   * one of the released states (nothing to reconcile).\n   */\n  async forcePaidAfterRaceTx(bookingId: string): Promise<boolean> {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        const transition = await tx.booking.updateMany({\n          where: {\n            bookingId,\n            status: {\n              in: [\n                BookingStatus.EXPIRED,\n                BookingStatus.FAILED,\n                BookingStatus.CANCELLED,\n              ],\n            },\n          },\n          data: { status: BookingStatus.PAID },\n        });\n\n        if (transition.count === 0) return false;\n\n        const tickets = await tx.ticket.findMany({\n          where: { bookingId },\n          select: {\n            ticketTypeId: true,\n            wasDiscounted: true,\n            quantity: true,\n            bundleGroupId: true,\n            bundleWasDiscounted: true,\n          },\n        });\n\n        const aggByType = new Map<\n          string,\n          { totalQty: number; discountQty: number }\n        >();\n        const groupDiscountAgg = new Map<string, number>();\n        for (const ticket of tickets) {\n          if (!ticket.ticketTypeId) continue;\n          const agg = aggByType.get(ticket.ticketTypeId) ?? {\n            totalQty: 0,\n            discountQty: 0,\n          };\n          agg.totalQty += ticket.quantity;\n          if (ticket.wasDiscounted) agg.discountQty += ticket.quantity;\n          aggByType.set(ticket.ticketTypeId, agg);\n\n          if (ticket.bundleGroupId && ticket.bundleWasDiscounted) {\n            groupDiscountAgg.set(\n              ticket.bundleGroupId,\n              Math.max(\n                groupDiscountAgg.get(ticket.bundleGroupId) ?? 0,\n                ticket.quantity,\n              ),\n            );\n          }\n        }\n\n        for (const [ticketTypeId, { totalQty, discountQty }] of aggByType) {\n          await tx.$executeRaw`\n\t\t\t\t\t\tUPDATE \"TicketType\"\n\t\t\t\t\t\tSET \"soldCount\" = \"soldCount\" + ${totalQty},\n\t\t\t\t\t\t    \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n\t\t\t\t\t\tWHERE \"ticketTypeId\" = ${ticketTypeId}\n\t\t\t\t\t`;\n        }\n\n        for (const [groupId, discountQty] of groupDiscountAgg) {\n          await tx.$executeRaw`\n\t\t\t\t\t\tUPDATE \"TicketTypeGroup\"\n\t\t\t\t\t\tSET \"discountSoldCount\" = \"discountSoldCount\" + ${discountQty}\n\t\t\t\t\t\tWHERE \"groupId\" = ${groupId}\n\t\t\t\t\t`;\n        }\n\n        await tx.ticket.updateMany({\n          where: { bookingId },\n          data: { status: TicketPaymentStatus.SUCCESS },\n        });\n\n        return true;\n      });\n    }, \"Force booking paid after expiry race\");\n  }\n\n  /** True if any ticket type in this booking now has more sold than its quantity. */\n  async hasOversoldTicketType(bookingId: string): Promise<boolean> {\n    return wrapDatabaseOperation(async () => {\n      const rows = await prisma.$queryRaw<{ one: number }[]>`\n        SELECT 1 AS one FROM \"TicketType\" tt\n        WHERE tt.\"ticketTypeId\" IN (SELECT \"ticketTypeId\" FROM \"Ticket\" WHERE \"bookingId\" = ${bookingId})\n          AND tt.\"soldCount\" > tt.\"quantity\"\n        LIMIT 1\n      `;\n      return rows.length > 0;\n    }, \"Check oversold ticket types for booking\");\n  }\n\n  /**\n   * Cancel a confirmed free/RSVP booking (status PAID → CANCELLED).\n   * Sets all child tickets to REFUNDED. Returns true if updated, false if\n   * the booking was already in a terminal state (idempotent).\n   */\n  async cancelConfirmedFreeTx(bookingId: string): Promise<boolean> {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.$transaction(async (tx) => {\n        const result = await tx.booking.updateMany({\n          where: { bookingId, status: BookingStatus.PAID },\n          data: { status: BookingStatus.CANCELLED },\n        });\n        if (result.count === 0) return false;\n        await tx.ticket.updateMany({\n          where: { bookingId },\n          data: { status: TicketPaymentStatus.REFUNDED },\n        });\n        return true;\n      });\n    }, \"Cancel confirmed free booking\");\n  }\n}\n","numLines":395,"startLine":1,"totalLines":395}},"tool_result_meta":[{"id":"call-70aab4f4-aa92-41fb-8b9c-bc200d25cc7c","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
