{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-53dd9e31-b7e3-41e9-bb18-6124ec12baf0","type":"tool_result","content":"1\timport { config } from \"../../config\";\n2\timport logger from \"../../config/logger\";\n3\timport { redis } from \"../../config/redis\";\n4\timport { PUSH_COPY } from \"../../lib/push-copy\";\n5\timport { teamQueue } from \"../../lib/queues\";\n6\timport { BookingRepository } from \"../../repositories/booking.repository\";\n7\timport { CheckoutSessionRepository } from \"../../repositories/checkout-session.repository\";\n8\timport { DashboardRepository } from \"../../repositories/Dashboard.repository\";\n9\timport { EventRepository } from \"../../repositories/event.repository\";\n10\timport { ListerRepository } from \"../../repositories/lister.repository\";\n11\timport { ListerSubscriptionRepository } from \"../../repositories/lister-subscription.repository\";\n12\timport { NotificationPrefsRepository } from \"../../repositories/NotificationPrefs.repository\";\n13\timport { PaymentRepository } from \"../../repositories/payment.repository\";\n14\timport { TeamRepository } from \"../../repositories/team.repository\";\n15\timport { UserRepository } from \"../../repositories/user.repository\";\n16\timport { BadRequestError, ConflictError } from \"../../utils/errors.util\";\n17\timport { AnalyticsService } from \"../analytics.service\";\n18\timport { DiscountService } from \"../discount.service\";\n19\timport { EmailService } from \"../email.service\";\n20\timport { MeetingIntegrationService } from \"../meeting-integration.service\";\n21\timport { enqueuePartnerWebhook } from \"../partner-webhook.service\";\n22\timport { PushService } from \"../push.service\";\n23\t\n24\t/**\n25\t * Finalizes a booking after payment is confirmed and handles the\n26\t * team-confirmation side effects. Shared between the client-side\n27\t * verify-payment path and the Razorpay webhook path — both call these\n28\t * so the booking/team flips to paid/confirmed whichever signal arrives first.\n29\t */\n30\texport class BookingPaymentFinalizerService {\n31\t  private bookingRepository: BookingRepository;\n32\t  private eventRepository: EventRepository;\n33\t  private userRepository: UserRepository;\n34\t  private teamRepository: TeamRepository;\n35\t  private analyticsService: AnalyticsService;\n36\t  private emailService: EmailService;\n37\t  private listerRepository: ListerRepository;\n38\t  private notificationPrefsRepository: NotificationPrefsRepository;\n39\t  private discountService: DiscountService;\n40\t  private meetingIntegrationService: MeetingIntegrationService;\n41\t  private dashboardRepository: DashboardRepository;\n42\t  private listerSubscriptionRepository: ListerSubscriptionRepository;\n43\t  private checkoutSessionRepository = new CheckoutSessionRepository();\n44\t  private paymentRepository = new PaymentRepository();\n45\t\n46\t  constructor(\n47\t    bookingRepository?: BookingRepository,\n48\t    eventRepository?: EventRepository,\n49\t    userRepository?: UserRepository,\n50\t    teamRepository?: TeamRepository,\n51\t    analyticsService?: AnalyticsService,\n52\t    emailService?: EmailService,\n53\t    listerRepository?: ListerRepository,\n54\t    notificationPrefsRepository?: NotificationPrefsRepository,\n55\t  ) {\n56\t    this.bookingRepository = bookingRepository ?? new BookingRepository();\n57\t    this.eventRepository = eventRepository ?? new EventRepository();\n58\t    this.userRepository = userRepository ?? new UserRepository();\n59\t    this.teamRepository = teamRepository ?? new TeamRepository();\n60\t    this.analyticsService = analyticsService ?? new AnalyticsService();\n61\t    this.emailService = emailService ?? new EmailService();\n62\t    this.listerRepository = listerRepository ?? new ListerRepository();\n63\t    this.notificationPrefsRepository =\n64\t      notificationPrefsRepository ?? new NotificationPrefsRepository();\n65\t    this.discountService = new DiscountService();\n66\t    this.meetingIntegrationService = new MeetingIntegrationService();\n67\t    this.dashboardRepository = new DashboardRepository();\n68\t    this.listerSubscriptionRepository = new ListerSubscriptionRepository();\n69\t  }\n70\t\n71\t  /**\n72\t   * Apply team-confirmation logic after a booking is finalised. Idempotent —\n73\t   * shared between the client-side verify path and the Razorpay webhook path,\n74\t   * so the team flips to CONFIRMED whichever finalization signal arrives first.\n75\t   */\n76\t  async confirmTeamFromBookingResult(\n77\t    bookingId: string,\n78\t    result: Awaited<ReturnType<BookingRepository[\"findByIdWithDetails\"]>>,\n79\t  ) {\n80\t    const teamId = result.tickets[0]?.teamId ?? null;\n81\t    if (!teamId) return;\n82\t\n83\t    try {\n84\t      const team = await this.teamRepository.findById(teamId);\n85\t      if (!team) return;\n86\t\n87\t      if (team.status === \"CONFIRMED\") {\n88\t        // Either a duplicate webhook delivery for an already-settled team, or\n89\t        // a §2 open-seat purchase finalizing: someone paid for a spare seat\n90\t        // on a team that was confirmed before they joined, so there's a\n91\t        // `TeamMember` row with `ticketId: null` awaiting this ticket. Link\n92\t        // it and stop — no team-status change, no re-running the whole-team\n93\t        // auto-confirm block below (it doesn't apply, the team was already\n94\t        // confirmed before this purchase started).\n95\t        const ticketUserId = result.tickets[0]?.userId;\n96\t        const awaitingMember = ticketUserId\n97\t          ? team.members.find((m) => m.userId === ticketUserId && !m.ticketId)\n98\t          : undefined;\n99\t        if (awaitingMember && result.tickets[0]) {\n100\t          await this.teamRepository.linkMemberTicket(\n101\t            awaitingMember.memberId,\n102\t            result.tickets[0].ticketId,\n103\t          );\n104\t          logger.info(\"Open-seat purchase finalized on confirmed team\", {\n105\t            teamId,\n106\t            bookingId,\n107\t            memberId: awaitingMember.memberId,\n108\t          });\n109\t        }\n110\t        return;\n111\t      }\n112\t\n113\t      const paidSeatCount = result.tickets.length;\n114\t      // Tickets created by prepareTeamForPayment are already owned by the\n115\t      // correct member (team.service.ts sets userId: member.userId at\n116\t      // creation) — match on that instead of zipping by array position.\n117\t      // Positional zipping breaks (undefined ticketId → crash) whenever a\n118\t      // member joins the team between prepare-payment and payment completion,\n119\t      // since team.members grows past the ticket count captured at prep time.\n120\t      const ticketByUserId = new Map(\n121\t        result.tickets.map((t) => [t.userId, t.ticketId]),\n122\t      );\n123\t      const memberTickets = team.members\n124\t        .filter((m) => ticketByUserId.has(m.userId))\n125\t        .map((m) => ({\n126\t          memberId: m.memberId,\n127\t          ticketId: ticketByUserId.get(m.userId) as string,\n128\t        }));\n129\t      const allSeatsFilledNow = memberTickets.length >= paidSeatCount;\n130\t\n131\t      if (allSeatsFilledNow) {\n132\t        await this.teamRepository.confirmTeamWithTickets(teamId, memberTickets);\n133\t        await Promise.all(\n134\t          team.members.map((member) =>\n135\t            teamQueue.add(\"team-confirmed\", {\n136\t              email: member.user.email,\n137\t              teamName: team.teamName,\n138\t              eventTitle: team.event.title,\n139\t              eventDate: team.event.date,\n140\t            }),\n141\t          ),\n142\t        );\n143\t        logger.info(\"Team confirmed after booking payment\", {\n144\t          teamId,\n145\t          bookingId,\n146\t          memberCount: team.members.length,\n147\t        });\n148\t      } else {\n149\t        const leaderMember = team.members.find((m) => m.isLeader);\n150\t        if (leaderMember && !leaderMember.ticketId) {\n151\t          // Must match by userId, not position — this function also runs\n152\t          // for a plain solo purchase that merely carries this team's\n153\t          // teamId tag (e.g. a join-code request paying for their own\n154\t          // single seat), where result.tickets contains only the payer's\n155\t          // own ticket. Grabbing \"the last ticket\" unconditionally used to\n156\t          // link a stranger's paid-for-themselves ticket onto the leader's\n157\t          // TeamMember row whenever the leader didn't have one linked yet.\n158\t          const leaderTicket = result.tickets.find(\n159\t            (t) => t.userId === leaderMember.userId,\n160\t          );\n161\t          if (leaderTicket) {\n162\t            await this.teamRepository.linkMemberTicket(\n163\t              leaderMember.memberId,\n164\t              leaderTicket.ticketId,\n165\t            );\n166\t          }\n167\t        }\n168\t        logger.info(\"Team booking paid, awaiting members via join code\", {\n169\t          teamId,\n170\t          bookingId,\n171\t          paidSeats: paidSeatCount,\n172\t          currentMembers: team.members.length,\n173\t        });\n174\t      }\n175\t    } catch (teamErr) {\n176\t      logger.warn(\"Team confirmation step failed after booking payment\", {\n177\t        teamId,\n178\t        bookingId,\n179\t        error: teamErr,\n180\t      });\n181\t    }\n182\t  }\n183\t\n184\t  private async sendBookingConfirmationEmail(\n185\t    bookingDetails: Awaited<\n186\t      ReturnType<BookingRepository[\"findByIdWithDetails\"]>\n187\t    >,\n188\t    resend = false,\n189\t  ): Promise<boolean> {\n190\t    const user = await this.userRepository.findById(bookingDetails.userId);\n191\t    if (!user?.email) return false;\n192\t\n193\t    return this.emailService.sendEmail({\n194\t      toEmail: user.email,\n195\t      // Keyed on the booking, not the Razorpay paymentId: cash sales have no\n196\t      // paymentId, so they all shared one job id and only the first was sent.\n197\t      // A resend gets a fresh key, otherwise the queue drops it as a duplicate.\n198\t      dedupeKey: resend\n199\t        ? `${bookingDetails.bookingId}__${Date.now()}`\n200\t        : bookingDetails.bookingId,\n201\t      name: user.name ?? undefined,\n202\t      payload: {\n203\t        type: \"payment-confirmation\",\n204\t        content: {\n205\t          userName: user.name ?? \"Guest\",\n206\t          eventName: bookingDetails.event.title,\n207\t          eventDate: bookingDetails.event.date.toISOString(),\n208\t          eventVenue: bookingDetails.event.location ?? \"\",\n209\t          ticketCount: bookingDetails.tickets.reduce(\n210\t            (sum, t) => sum + t.quantity,\n211\t            0,\n212\t          ),\n213\t          amount: bookingDetails.total,\n214\t          currency: \"INR\",\n215\t          paymentId: bookingDetails.payment?.razorpayPaymentId ?? \"\",\n216\t          orderId: bookingDetails.payment?.razorpayOrderId ?? \"\",\n217\t          paymentMethod:\n218\t            bookingDetails.paymentMode === \"CASH\"\n219\t              ? \"Cash\"\n220\t              : (bookingDetails.payment?.method ?? \"Razorpay\"),\n221\t          bookingDate: bookingDetails.createdAt.toISOString(),\n222\t          tickets: bookingDetails.tickets.map((t) => ({\n223\t            ticketId: t.ticketId,\n224\t            ticketType: t.ticketType?.name ?? \"Standard\",\n225\t            quantity: t.quantity,\n226\t            price: t.totalPrice || 0,\n227\t            qrCode: bookingDetails.qrCode ?? null,\n228\t          })),\n229\t        },\n230\t      },\n231\t    });\n232\t  }\n233\t\n234\t  /**\n235\t   * Door sales: staff tap \"resend\" when the guest says the email never came.\n236\t   * Safe to call any number of times, it only sends the same confirmation again.\n237\t   */\n238\t  async resendConfirmationEmail(bookingId: string): Promise<void> {\n239\t    const details = await this.bookingRepository.findByIdWithDetails(bookingId);\n240\t    if (details.status !== \"PAID\") {\n241\t      throw new ConflictError(\"Only a paid booking can be re-sent\");\n242\t    }\n243\t    const sent = await this.sendBookingConfirmationEmail(details, true);\n244\t    if (!sent)\n245\t      throw new BadRequestError(\"Could not send the email, please try again\");\n246\t  }\n247\t\n248\t  /**\n249\t   * Shared helper: atomically finalise a booking that has been paid.\n250\t   * Idempotent — safe to call multiple times (e.g. verify + webhook).\n251\t   * Returns the fully-loaded booking.\n252\t   */\n253\t  async finalizePaidBooking(\n254\t    bookingId: string,\n255\t    opts?: { cash?: { reason: string } },\n256\t  ) {\n257\t    // Atomic status transition — returns false if another caller already paid\n258\t    const transitioned = await this.bookingRepository.markPaidTx(\n259\t      bookingId,\n260\t      opts?.cash,\n261\t    );\n262\t\n263\t    // Cash must never use the force-paid recovery below. That path exists for\n264\t    // money Razorpay really captured. With cash nothing was captured, so if the\n265\t    // booking already left HELD (expired, or UPI won) we stop and tell staff.\n266\t    if (!transitioned && opts?.cash) {\n267\t      throw new ConflictError(\n268\t        \"This sale is already settled or has expired. Start a new sale.\",\n269\t      );\n270\t    }\n271\t\n272\t    if (!transitioned) {\n273\t      const current =\n274\t        await this.bookingRepository.findByIdWithDetails(bookingId);\n275\t\n276\t      if (current.status === \"PAID\") {\n277\t        // verifyBookingPayment and the webhook raced; the other caller owns\n278\t        // side effects. Return current state so the caller can still proceed.\n279\t        logger.info(\"finalizePaidBooking: already paid by concurrent caller\", {\n280\t          bookingId,\n281\t        });\n282\t        return current;\n283\t      }\n284\t\n285\t      // The booking left HELD via some path OTHER than a concurrent payment\n286\t      // finalize — almost always the hold-expiry sweep winning a race against\n287\t      // a slow-to-capture payment (createPaymentOrderForBooking's extendHold\n288\t      // window can be tight for a slow UPI collect approval). Whoever called\n289\t      // finalizePaidBooking only does so after Razorpay has already confirmed\n290\t      // the payment captured, so the captured money has to win over an\n291\t      // internal hold timer — silently treating this as \"someone else handled\n292\t      // it\" strands the buyer with no ticket and no refund, forever, since\n293\t      // the payment row is about to be marked COMPLETED and no retry will\n294\t      // ever fire again. Force it through and log loudly so this is never\n295\t      // silent.\n296\t      logger.error(\n297\t        \"finalizePaidBooking: booking left HELD via an expiry/cancel race with a captured payment — forcing to PAID\",\n298\t        { bookingId, statusFound: current.status },\n299\t      );\n300\t      const forced =\n301\t        await this.bookingRepository.forcePaidAfterRaceTx(bookingId);\n302\t      if (!forced) {\n303\t        logger.error(\n304\t          \"finalizePaidBooking: could not force booking to PAID — needs manual repair\",\n305\t          { bookingId, statusFound: current.status },\n306\t        );\n307\t        return current;\n308\t      }\n309\t\n310\t      // The paid seat won, but the freed slot may have been resold in the gap. Don't undo\n311\t      // the sale; mark the payment so ops sees it and can refund one buyer by hand.\n312\t      try {\n313\t        if (await this.bookingRepository.hasOversoldTicketType(bookingId)) {\n314\t          const orderId = current.payment?.razorpayOrderId;\n315\t          logger.error(\n316\t            \"finalizePaidBooking: late capture pushed a ticket type past its quantity, needs manual review\",\n317\t            { bookingId, orderId },\n318\t          );\n319\t          if (orderId)\n320\t            await this.paymentRepository.flagForReconciliation(\n321\t              orderId,\n322\t              \"OVERSOLD_AFTER_LATE_CAPTURE\",\n323\t            );\n324\t        }\n325\t      } catch (error) {\n326\t        logger.warn(\"Could not check oversell after late capture\", {\n327\t          bookingId,\n328\t          error,\n329\t        });\n330\t      }\n331\t    }\n332\t\n333\t    // Load full details (includes discountCodeId not returned by markPaidTx)\n334\t    const bookingDetails =\n335\t      await this.bookingRepository.findByIdWithDetails(bookingId);\n336\t\n337\t    // If a discount code was applied, increment its usage counter\n338\t    if (bookingDetails.discountCodeId) {\n339\t      try {\n340\t        await this.discountService.applyDiscountCode(\n341\t          bookingDetails.discountCodeId,\n342\t          bookingDetails.total,\n343\t        );\n344\t      } catch (error) {\n345\t        // Log but don't fail the payment — discount increment is best-effort\n346\t        logger.warn(\n347\t          \"Failed to increment discount usage after booking payment\",\n348\t          {\n349\t            bookingId,\n350\t            discountCodeId: bookingDetails.discountCodeId,\n351\t            error,\n352\t          },\n353\t        );\n354\t      }\n355\t    }\n356\t\n357\t    // Host API bookings point back at their checkout session; flip it to PAID.\n358\t    // Best-effort: the booking is already paid, a missed flip must not undo it.\n359\t    if (bookingDetails.checkoutSessionId) {\n360\t      try {\n361\t        const flipped = await this.checkoutSessionRepository.markPaid(\n362\t          bookingDetails.checkoutSessionId,\n363\t        );\n364\t        // verify-payment and the Razorpay webhook both land here; only the first flip notifies.\n365\t        if (flipped.count > 0) {\n366\t          const session = await this.checkoutSessionRepository.findById(\n367\t            bookingDetails.checkoutSessionId,\n368\t          );\n369\t          if (session) {\n370\t            await enqueuePartnerWebhook(\n371\t              session.listerId,\n372\t              session.mode,\n373\t              \"booking.confirmed\",\n374\t              {\n375\t                bookingId,\n376\t                sessionId: session.sessionId,\n377\t                eventId: session.eventId,\n378\t                clientReference: session.clientReference,\n379\t                amountPaise: session.amountPaise,\n380\t                currency: \"INR\",\n381\t              },\n382\t            );\n383\t          }\n384\t        }\n385\t      } catch (error) {\n386\t        logger.warn(\"Failed to mark checkout session paid\", {\n387\t          bookingId,\n388\t          checkoutSessionId: bookingDetails.checkoutSessionId,\n389\t          error,\n390\t        });\n391\t      }\n392\t    }\n393\t\n394\t    // Update analytics + subscription quota + bust dashboard caches so the\n395\t    // lister dashboard reflects this booking immediately. Mirrors what the\n396\t    // ticket-based verifyPayment path does — without these, team payments\n397\t    // would not appear in the dashboard until cache TTL (60s) expires.\n398\t    const eventId = bookingDetails.event.eventId;\n399\t    const totalQuantity = bookingDetails.tickets.reduce(\n400\t      (sum, t) => sum + (t.quantity ?? 0),\n401\t      0,\n402\t    );\n403\t    try {\n404\t      await this.analyticsService.updateAfterTicketPurchase(\n405\t        eventId,\n406\t        totalQuantity,\n407\t        bookingDetails.total,\n408\t        {\n409\t          userId: bookingDetails.userId,\n410\t          paymentId: bookingDetails.payment?.razorpayPaymentId ?? undefined,\n411\t          bookingId,\n412\t        },\n413\t      );\n414\t    } catch (analyticsError) {\n415\t      logger.error(\"Analytics update failed after booking payment\", {\n416\t        error: analyticsError,\n417\t        bookingId,\n418\t        eventId,\n419\t      });\n420\t    }\n421\t\n422\t    const event = await this.eventRepository.findByIdMinimal(eventId);\n423\t    if (event?.listerId) {\n424\t      try {\n425\t        await this.listerSubscriptionRepository.incrementTicketsUsed(\n426\t          event.listerId,\n427\t          totalQuantity,\n428\t        );\n429\t      } catch (subErr) {\n430\t        logger.warn(\n431\t          \"Subscription quota increment failed after booking payment\",\n432\t          {\n433\t            error: subErr,\n434\t            bookingId,\n435\t            listerId: event.listerId,\n436\t          },\n437\t        );\n438\t      }\n439\t      try {\n440\t        await this.dashboardRepository.invalidateOnBooking(\n441\t          event.listerId,\n442\t          eventId,\n443\t        );\n444\t      } catch (cacheErr) {\n445\t        logger.warn(\n446\t          \"Dashboard cache invalidation failed after booking payment\",\n447\t          {\n448\t            error: cacheErr,\n449\t            bookingId,\n450\t          },\n451\t        );\n452\t      }\n453\t    }\n454\t\n455\t    // Send booking confirmation email (best-effort — don't fail the payment)\n456\t    this.sendBookingConfirmationEmail(bookingDetails).catch((err) =>\n457\t      logger.warn(\"Failed to send booking confirmation email\", {\n458\t        bookingId,\n459\t        err,\n460\t      }),\n461\t    );\n462\t\n463\t    // Send push notification (fire-and-forget)\n464\t    PushService.enqueue({\n465\t      userId: bookingDetails.userId,\n466\t      ...PUSH_COPY.booking_paid(bookingDetails.event.title, bookingId),\n467\t    });\n468\t\n469\t    // Notify host of new booking (fire-and-forget)\n470\t    const listerId = bookingDetails.event.listerId;\n471\t    if (listerId) {\n472\t      this.notifyHostOfNewBooking(\n473\t        listerId,\n474\t        bookingDetails.event.title,\n475\t        bookingDetails.userId,\n476\t        totalQuantity,\n477\t        bookingDetails.total,\n478\t        eventId,\n479\t      ).catch((err) =>\n480\t        logger.warn(\"Failed to send host booking notification\", {\n481\t          bookingId,\n482\t          err,\n483\t        }),\n484\t      );\n485\t    }\n486\t\n487\t    // Add buyer to Google Calendar event's guest list so Google Meet grants\n488\t    // direct access. Fire-and-forget — payment must not fail if this fails.\n489\t    const ev = bookingDetails.event;\n490\t    if (\n491\t      ev.meetingProvider === \"GOOGLE_MEET\" &&\n492\t      ev.externalMeetingId &&\n493\t      ev.listerId\n494\t    ) {\n495\t      const buyer = await this.userRepository.findById(bookingDetails.userId);\n496\t      if (buyer?.email) {\n497\t        this.meetingIntegrationService\n498\t          .addAttendeeToCachedMeeting(\n499\t            ev.listerId,\n500\t            ev.externalMeetingId,\n501\t            buyer.email,\n502\t          )\n503\t          .catch((err) =>\n504\t            logger.warn(\"Meeting attendee enqueue failed (booking path)\", {\n505\t              bookingId,\n506\t              err,\n507\t            }),\n508\t          );\n509\t      }\n510\t    }\n511\t\n512\t    logger.info(\"Booking finalised as paid\", {\n513\t      bookingId,\n514\t      userId: bookingDetails.userId,\n515\t      total: bookingDetails.total,\n516\t    });\n517\t\n518\t    return bookingDetails;\n519\t  }\n520\t\n521\t  /**\n522\t   * Notify host of a new booking. Fire-and-forget.\n523\t   * Rate-limited per event: push at most once per 5 min, email at most once per hour.\n524\t   * Prevents notification spam on popular events with many rapid bookings.\n525\t   */\n526\t  private async notifyHostOfNewBooking(\n527\t    listerId: string,\n528\t    eventTitle: string,\n529\t    buyerUserId: string,\n530\t    ticketCount: number,\n531\t    amount: number,\n532\t    eventId: string,\n533\t  ) {\n534\t    const pushKey = `cache:host-booking-notify:${eventId}:push`;\n535\t    const emailKey = `cache:host-booking-notify:${eventId}:email`;\n536\t\n537\t    const [pushSent, emailSent] = await Promise.all([\n538\t      redis.get(pushKey),\n539\t      redis.get(emailKey),\n540\t    ]);\n541\t\n542\t    // Both channels are in cooldown — skip everything\n543\t    if (pushSent && emailSent) return;\n544\t\n545\t    // Fetch lister and buyer only when at least one channel will fire\n546\t    const [lister, buyer] = await Promise.all([\n547\t      this.listerRepository.findById(listerId),\n548\t      this.userRepository.findById(buyerUserId),\n549\t    ]);\n550\t    if (!lister?.userId) return;\n551\t\n552\t    const buyerName = buyer?.name || \"A guest\";\n553\t    const listerName = lister.companyName || \"Organizer\";\n554\t\n555\t    if (!pushSent) {\n556\t      PushService.enqueue({\n557\t        userId: lister.userId,\n558\t        ...PUSH_COPY.host_new_booking(\n559\t          buyerName,\n560\t          ticketCount,\n561\t          eventTitle,\n562\t          eventId,\n563\t        ),\n564\t      });\n565\t      await redis.set(pushKey, \"1\", \"EX\", 5 * 60); // 5-minute cooldown\n566\t    }\n567\t\n568\t    if (!emailSent) {\n569\t      // Check lister notification preferences before sending email\n570\t      let shouldSendEmail = true;\n571\t      try {\n572\t        const prefs = await this.notificationPrefsRepository.findOrCreate(\n573\t          lister.userId,\n574\t        );\n575\t        shouldSendEmail = prefs.newBookingEmail;\n576\t      } catch {\n577\t        // Default to sending if prefs lookup fails\n578\t      }\n579\t\n580\t      if (shouldSendEmail && lister.contactEmail) {\n581\t        this.emailService\n582\t          .sendEmail({\n583\t            toEmail: lister.contactEmail,\n584\t            payload: {\n585\t              type: \"new-booking-notification\",\n586\t              content: {\n587\t                listerName,\n588\t                eventName: eventTitle,\n589\t                buyerName,\n590\t                ticketCount,\n591\t                amount,\n592\t                bookingTime: new Date().toISOString(),\n593\t                dashboardUrl: `${config.WEB_BASE_URL}/dashboard/events/${eventId}/audience`,\n594\t              },\n595\t            },\n596\t          })\n597\t          .catch((err) =>\n598\t            logger.warn(\"Failed to send new booking email to host\", {\n599\t              listerId,\n600\t              eventId,\n601\t              err,\n602\t            }),\n603\t          );\n604\t      }\n605\t      await redis.set(emailKey, \"1\", \"EX\", 60 * 60); // 1-hour cooldown\n606\t    }\n607\t  }\n608\t}\n609\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"b191f58b-7864-481a-89b4-fa2d094b6ff6","timestamp":"2026-11-20T19:05:20.428Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/services/payment/booking-payment-finalizer.service.ts","content":"import { config } from \"../../config\";\nimport logger from \"../../config/logger\";\nimport { redis } from \"../../config/redis\";\nimport { PUSH_COPY } from \"../../lib/push-copy\";\nimport { teamQueue } from \"../../lib/queues\";\nimport { BookingRepository } from \"../../repositories/booking.repository\";\nimport { CheckoutSessionRepository } from \"../../repositories/checkout-session.repository\";\nimport { DashboardRepository } from \"../../repositories/Dashboard.repository\";\nimport { EventRepository } from \"../../repositories/event.repository\";\nimport { ListerRepository } from \"../../repositories/lister.repository\";\nimport { ListerSubscriptionRepository } from \"../../repositories/lister-subscription.repository\";\nimport { NotificationPrefsRepository } from \"../../repositories/NotificationPrefs.repository\";\nimport { PaymentRepository } from \"../../repositories/payment.repository\";\nimport { TeamRepository } from \"../../repositories/team.repository\";\nimport { UserRepository } from \"../../repositories/user.repository\";\nimport { BadRequestError, ConflictError } from \"../../utils/errors.util\";\nimport { AnalyticsService } from \"../analytics.service\";\nimport { DiscountService } from \"../discount.service\";\nimport { EmailService } from \"../email.service\";\nimport { MeetingIntegrationService } from \"../meeting-integration.service\";\nimport { enqueuePartnerWebhook } from \"../partner-webhook.service\";\nimport { PushService } from \"../push.service\";\n\n/**\n * Finalizes a booking after payment is confirmed and handles the\n * team-confirmation side effects. Shared between the client-side\n * verify-payment path and the Razorpay webhook path — both call these\n * so the booking/team flips to paid/confirmed whichever signal arrives first.\n */\nexport class BookingPaymentFinalizerService {\n  private bookingRepository: BookingRepository;\n  private eventRepository: EventRepository;\n  private userRepository: UserRepository;\n  private teamRepository: TeamRepository;\n  private analyticsService: AnalyticsService;\n  private emailService: EmailService;\n  private listerRepository: ListerRepository;\n  private notificationPrefsRepository: NotificationPrefsRepository;\n  private discountService: DiscountService;\n  private meetingIntegrationService: MeetingIntegrationService;\n  private dashboardRepository: DashboardRepository;\n  private listerSubscriptionRepository: ListerSubscriptionRepository;\n  private checkoutSessionRepository = new CheckoutSessionRepository();\n  private paymentRepository = new PaymentRepository();\n\n  constructor(\n    bookingRepository?: BookingRepository,\n    eventRepository?: EventRepository,\n    userRepository?: UserRepository,\n    teamRepository?: TeamRepository,\n    analyticsService?: AnalyticsService,\n    emailService?: EmailService,\n    listerRepository?: ListerRepository,\n    notificationPrefsRepository?: NotificationPrefsRepository,\n  ) {\n    this.bookingRepository = bookingRepository ?? new BookingRepository();\n    this.eventRepository = eventRepository ?? new EventRepository();\n    this.userRepository = userRepository ?? new UserRepository();\n    this.teamRepository = teamRepository ?? new TeamRepository();\n    this.analyticsService = analyticsService ?? new AnalyticsService();\n    this.emailService = emailService ?? new EmailService();\n    this.listerRepository = listerRepository ?? new ListerRepository();\n    this.notificationPrefsRepository =\n      notificationPrefsRepository ?? new NotificationPrefsRepository();\n    this.discountService = new DiscountService();\n    this.meetingIntegrationService = new MeetingIntegrationService();\n    this.dashboardRepository = new DashboardRepository();\n    this.listerSubscriptionRepository = new ListerSubscriptionRepository();\n  }\n\n  /**\n   * Apply team-confirmation logic after a booking is finalised. Idempotent —\n   * shared between the client-side verify path and the Razorpay webhook path,\n   * so the team flips to CONFIRMED whichever finalization signal arrives first.\n   */\n  async confirmTeamFromBookingResult(\n    bookingId: string,\n    result: Awaited<ReturnType<BookingRepository[\"findByIdWithDetails\"]>>,\n  ) {\n    const teamId = result.tickets[0]?.teamId ?? null;\n    if (!teamId) return;\n\n    try {\n      const team = await this.teamRepository.findById(teamId);\n      if (!team) return;\n\n      if (team.status === \"CONFIRMED\") {\n        // Either a duplicate webhook delivery for an already-settled team, or\n        // a §2 open-seat purchase finalizing: someone paid for a spare seat\n        // on a team that was confirmed before they joined, so there's a\n        // `TeamMember` row with `ticketId: null` awaiting this ticket. Link\n        // it and stop — no team-status change, no re-running the whole-team\n        // auto-confirm block below (it doesn't apply, the team was already\n        // confirmed before this purchase started).\n        const ticketUserId = result.tickets[0]?.userId;\n        const awaitingMember = ticketUserId\n          ? team.members.find((m) => m.userId === ticketUserId && !m.ticketId)\n          : undefined;\n        if (awaitingMember && result.tickets[0]) {\n          await this.teamRepository.linkMemberTicket(\n            awaitingMember.memberId,\n            result.tickets[0].ticketId,\n          );\n          logger.info(\"Open-seat purchase finalized on confirmed team\", {\n            teamId,\n            bookingId,\n            memberId: awaitingMember.memberId,\n          });\n        }\n        return;\n      }\n\n      const paidSeatCount = result.tickets.length;\n      // Tickets created by prepareTeamForPayment are already owned by the\n      // correct member (team.service.ts sets userId: member.userId at\n      // creation) — match on that instead of zipping by array position.\n      // Positional zipping breaks (undefined ticketId → crash) whenever a\n      // member joins the team between prepare-payment and payment completion,\n      // since team.members grows past the ticket count captured at prep time.\n      const ticketByUserId = new Map(\n        result.tickets.map((t) => [t.userId, t.ticketId]),\n      );\n      const memberTickets = team.members\n        .filter((m) => ticketByUserId.has(m.userId))\n        .map((m) => ({\n          memberId: m.memberId,\n          ticketId: ticketByUserId.get(m.userId) as string,\n        }));\n      const allSeatsFilledNow = memberTickets.length >= paidSeatCount;\n\n      if (allSeatsFilledNow) {\n        await this.teamRepository.confirmTeamWithTickets(teamId, memberTickets);\n        await Promise.all(\n          team.members.map((member) =>\n            teamQueue.add(\"team-confirmed\", {\n              email: member.user.email,\n              teamName: team.teamName,\n              eventTitle: team.event.title,\n              eventDate: team.event.date,\n            }),\n          ),\n        );\n        logger.info(\"Team confirmed after booking payment\", {\n          teamId,\n          bookingId,\n          memberCount: team.members.length,\n        });\n      } else {\n        const leaderMember = team.members.find((m) => m.isLeader);\n        if (leaderMember && !leaderMember.ticketId) {\n          // Must match by userId, not position — this function also runs\n          // for a plain solo purchase that merely carries this team's\n          // teamId tag (e.g. a join-code request paying for their own\n          // single seat), where result.tickets contains only the payer's\n          // own ticket. Grabbing \"the last ticket\" unconditionally used to\n          // link a stranger's paid-for-themselves ticket onto the leader's\n          // TeamMember row whenever the leader didn't have one linked yet.\n          const leaderTicket = result.tickets.find(\n            (t) => t.userId === leaderMember.userId,\n          );\n          if (leaderTicket) {\n            await this.teamRepository.linkMemberTicket(\n              leaderMember.memberId,\n              leaderTicket.ticketId,\n            );\n          }\n        }\n        logger.info(\"Team booking paid, awaiting members via join code\", {\n          teamId,\n          bookingId,\n          paidSeats: paidSeatCount,\n          currentMembers: team.members.length,\n        });\n      }\n    } catch (teamErr) {\n      logger.warn(\"Team confirmation step failed after booking payment\", {\n        teamId,\n        bookingId,\n        error: teamErr,\n      });\n    }\n  }\n\n  private async sendBookingConfirmationEmail(\n    bookingDetails: Awaited<\n      ReturnType<BookingRepository[\"findByIdWithDetails\"]>\n    >,\n    resend = false,\n  ): Promise<boolean> {\n    const user = await this.userRepository.findById(bookingDetails.userId);\n    if (!user?.email) return false;\n\n    return this.emailService.sendEmail({\n      toEmail: user.email,\n      // Keyed on the booking, not the Razorpay paymentId: cash sales have no\n      // paymentId, so they all shared one job id and only the first was sent.\n      // A resend gets a fresh key, otherwise the queue drops it as a duplicate.\n      dedupeKey: resend\n        ? `${bookingDetails.bookingId}__${Date.now()}`\n        : bookingDetails.bookingId,\n      name: user.name ?? undefined,\n      payload: {\n        type: \"payment-confirmation\",\n        content: {\n          userName: user.name ?? \"Guest\",\n          eventName: bookingDetails.event.title,\n          eventDate: bookingDetails.event.date.toISOString(),\n          eventVenue: bookingDetails.event.location ?? \"\",\n          ticketCount: bookingDetails.tickets.reduce(\n            (sum, t) => sum + t.quantity,\n            0,\n          ),\n          amount: bookingDetails.total,\n          currency: \"INR\",\n          paymentId: bookingDetails.payment?.razorpayPaymentId ?? \"\",\n          orderId: bookingDetails.payment?.razorpayOrderId ?? \"\",\n          paymentMethod:\n            bookingDetails.paymentMode === \"CASH\"\n              ? \"Cash\"\n              : (bookingDetails.payment?.method ?? \"Razorpay\"),\n          bookingDate: bookingDetails.createdAt.toISOString(),\n          tickets: bookingDetails.tickets.map((t) => ({\n            ticketId: t.ticketId,\n            ticketType: t.ticketType?.name ?? \"Standard\",\n            quantity: t.quantity,\n            price: t.totalPrice || 0,\n            qrCode: bookingDetails.qrCode ?? null,\n          })),\n        },\n      },\n    });\n  }\n\n  /**\n   * Door sales: staff tap \"resend\" when the guest says the email never came.\n   * Safe to call any number of times, it only sends the same confirmation again.\n   */\n  async resendConfirmationEmail(bookingId: string): Promise<void> {\n    const details = await this.bookingRepository.findByIdWithDetails(bookingId);\n    if (details.status !== \"PAID\") {\n      throw new ConflictError(\"Only a paid booking can be re-sent\");\n    }\n    const sent = await this.sendBookingConfirmationEmail(details, true);\n    if (!sent)\n      throw new BadRequestError(\"Could not send the email, please try again\");\n  }\n\n  /**\n   * Shared helper: atomically finalise a booking that has been paid.\n   * Idempotent — safe to call multiple times (e.g. verify + webhook).\n   * Returns the fully-loaded booking.\n   */\n  async finalizePaidBooking(\n    bookingId: string,\n    opts?: { cash?: { reason: string } },\n  ) {\n    // Atomic status transition — returns false if another caller already paid\n    const transitioned = await this.bookingRepository.markPaidTx(\n      bookingId,\n      opts?.cash,\n    );\n\n    // Cash must never use the force-paid recovery below. That path exists for\n    // money Razorpay really captured. With cash nothing was captured, so if the\n    // booking already left HELD (expired, or UPI won) we stop and tell staff.\n    if (!transitioned && opts?.cash) {\n      throw new ConflictError(\n        \"This sale is already settled or has expired. Start a new sale.\",\n      );\n    }\n\n    if (!transitioned) {\n      const current =\n        await this.bookingRepository.findByIdWithDetails(bookingId);\n\n      if (current.status === \"PAID\") {\n        // verifyBookingPayment and the webhook raced; the other caller owns\n        // side effects. Return current state so the caller can still proceed.\n        logger.info(\"finalizePaidBooking: already paid by concurrent caller\", {\n          bookingId,\n        });\n        return current;\n      }\n\n      // The booking left HELD via some path OTHER than a concurrent payment\n      // finalize — almost always the hold-expiry sweep winning a race against\n      // a slow-to-capture payment (createPaymentOrderForBooking's extendHold\n      // window can be tight for a slow UPI collect approval). Whoever called\n      // finalizePaidBooking only does so after Razorpay has already confirmed\n      // the payment captured, so the captured money has to win over an\n      // internal hold timer — silently treating this as \"someone else handled\n      // it\" strands the buyer with no ticket and no refund, forever, since\n      // the payment row is about to be marked COMPLETED and no retry will\n      // ever fire again. Force it through and log loudly so this is never\n      // silent.\n      logger.error(\n        \"finalizePaidBooking: booking left HELD via an expiry/cancel race with a captured payment — forcing to PAID\",\n        { bookingId, statusFound: current.status },\n      );\n      const forced =\n        await this.bookingRepository.forcePaidAfterRaceTx(bookingId);\n      if (!forced) {\n        logger.error(\n          \"finalizePaidBooking: could not force booking to PAID — needs manual repair\",\n          { bookingId, statusFound: current.status },\n        );\n        return current;\n      }\n\n      // The paid seat won, but the freed slot may have been resold in the gap. Don't undo\n      // the sale; mark the payment so ops sees it and can refund one buyer by hand.\n      try {\n        if (await this.bookingRepository.hasOversoldTicketType(bookingId)) {\n          const orderId = current.payment?.razorpayOrderId;\n          logger.error(\n            \"finalizePaidBooking: late capture pushed a ticket type past its quantity, needs manual review\",\n            { bookingId, orderId },\n          );\n          if (orderId)\n            await this.paymentRepository.flagForReconciliation(\n              orderId,\n              \"OVERSOLD_AFTER_LATE_CAPTURE\",\n            );\n        }\n      } catch (error) {\n        logger.warn(\"Could not check oversell after late capture\", {\n          bookingId,\n          error,\n        });\n      }\n    }\n\n    // Load full details (includes discountCodeId not returned by markPaidTx)\n    const bookingDetails =\n      await this.bookingRepository.findByIdWithDetails(bookingId);\n\n    // If a discount code was applied, increment its usage counter\n    if (bookingDetails.discountCodeId) {\n      try {\n        await this.discountService.applyDiscountCode(\n          bookingDetails.discountCodeId,\n          bookingDetails.total,\n        );\n      } catch (error) {\n        // Log but don't fail the payment — discount increment is best-effort\n        logger.warn(\n          \"Failed to increment discount usage after booking payment\",\n          {\n            bookingId,\n            discountCodeId: bookingDetails.discountCodeId,\n            error,\n          },\n        );\n      }\n    }\n\n    // Host API bookings point back at their checkout session; flip it to PAID.\n    // Best-effort: the booking is already paid, a missed flip must not undo it.\n    if (bookingDetails.checkoutSessionId) {\n      try {\n        const flipped = await this.checkoutSessionRepository.markPaid(\n          bookingDetails.checkoutSessionId,\n        );\n        // verify-payment and the Razorpay webhook both land here; only the first flip notifies.\n        if (flipped.count > 0) {\n          const session = await this.checkoutSessionRepository.findById(\n            bookingDetails.checkoutSessionId,\n          );\n          if (session) {\n            await enqueuePartnerWebhook(\n              session.listerId,\n              session.mode,\n              \"booking.confirmed\",\n              {\n                bookingId,\n                sessionId: session.sessionId,\n                eventId: session.eventId,\n                clientReference: session.clientReference,\n                amountPaise: session.amountPaise,\n                currency: \"INR\",\n              },\n            );\n          }\n        }\n      } catch (error) {\n        logger.warn(\"Failed to mark checkout session paid\", {\n          bookingId,\n          checkoutSessionId: bookingDetails.checkoutSessionId,\n          error,\n        });\n      }\n    }\n\n    // Update analytics + subscription quota + bust dashboard caches so the\n    // lister dashboard reflects this booking immediately. Mirrors what the\n    // ticket-based verifyPayment path does — without these, team payments\n    // would not appear in the dashboard until cache TTL (60s) expires.\n    const eventId = bookingDetails.event.eventId;\n    const totalQuantity = bookingDetails.tickets.reduce(\n      (sum, t) => sum + (t.quantity ?? 0),\n      0,\n    );\n    try {\n      await this.analyticsService.updateAfterTicketPurchase(\n        eventId,\n        totalQuantity,\n        bookingDetails.total,\n        {\n          userId: bookingDetails.userId,\n          paymentId: bookingDetails.payment?.razorpayPaymentId ?? undefined,\n          bookingId,\n        },\n      );\n    } catch (analyticsError) {\n      logger.error(\"Analytics update failed after booking payment\", {\n        error: analyticsError,\n        bookingId,\n        eventId,\n      });\n    }\n\n    const event = await this.eventRepository.findByIdMinimal(eventId);\n    if (event?.listerId) {\n      try {\n        await this.listerSubscriptionRepository.incrementTicketsUsed(\n          event.listerId,\n          totalQuantity,\n        );\n      } catch (subErr) {\n        logger.warn(\n          \"Subscription quota increment failed after booking payment\",\n          {\n            error: subErr,\n            bookingId,\n            listerId: event.listerId,\n          },\n        );\n      }\n      try {\n        await this.dashboardRepository.invalidateOnBooking(\n          event.listerId,\n          eventId,\n        );\n      } catch (cacheErr) {\n        logger.warn(\n          \"Dashboard cache invalidation failed after booking payment\",\n          {\n            error: cacheErr,\n            bookingId,\n          },\n        );\n      }\n    }\n\n    // Send booking confirmation email (best-effort — don't fail the payment)\n    this.sendBookingConfirmationEmail(bookingDetails).catch((err) =>\n      logger.warn(\"Failed to send booking confirmation email\", {\n        bookingId,\n        err,\n      }),\n    );\n\n    // Send push notification (fire-and-forget)\n    PushService.enqueue({\n      userId: bookingDetails.userId,\n      ...PUSH_COPY.booking_paid(bookingDetails.event.title, bookingId),\n    });\n\n    // Notify host of new booking (fire-and-forget)\n    const listerId = bookingDetails.event.listerId;\n    if (listerId) {\n      this.notifyHostOfNewBooking(\n        listerId,\n        bookingDetails.event.title,\n        bookingDetails.userId,\n        totalQuantity,\n        bookingDetails.total,\n        eventId,\n      ).catch((err) =>\n        logger.warn(\"Failed to send host booking notification\", {\n          bookingId,\n          err,\n        }),\n      );\n    }\n\n    // Add buyer to Google Calendar event's guest list so Google Meet grants\n    // direct access. Fire-and-forget — payment must not fail if this fails.\n    const ev = bookingDetails.event;\n    if (\n      ev.meetingProvider === \"GOOGLE_MEET\" &&\n      ev.externalMeetingId &&\n      ev.listerId\n    ) {\n      const buyer = await this.userRepository.findById(bookingDetails.userId);\n      if (buyer?.email) {\n        this.meetingIntegrationService\n          .addAttendeeToCachedMeeting(\n            ev.listerId,\n            ev.externalMeetingId,\n            buyer.email,\n          )\n          .catch((err) =>\n            logger.warn(\"Meeting attendee enqueue failed (booking path)\", {\n              bookingId,\n              err,\n            }),\n          );\n      }\n    }\n\n    logger.info(\"Booking finalised as paid\", {\n      bookingId,\n      userId: bookingDetails.userId,\n      total: bookingDetails.total,\n    });\n\n    return bookingDetails;\n  }\n\n  /**\n   * Notify host of a new booking. Fire-and-forget.\n   * Rate-limited per event: push at most once per 5 min, email at most once per hour.\n   * Prevents notification spam on popular events with many rapid bookings.\n   */\n  private async notifyHostOfNewBooking(\n    listerId: string,\n    eventTitle: string,\n    buyerUserId: string,\n    ticketCount: number,\n    amount: number,\n    eventId: string,\n  ) {\n    const pushKey = `cache:host-booking-notify:${eventId}:push`;\n    const emailKey = `cache:host-booking-notify:${eventId}:email`;\n\n    const [pushSent, emailSent] = await Promise.all([\n      redis.get(pushKey),\n      redis.get(emailKey),\n    ]);\n\n    // Both channels are in cooldown — skip everything\n    if (pushSent && emailSent) return;\n\n    // Fetch lister and buyer only when at least one channel will fire\n    const [lister, buyer] = await Promise.all([\n      this.listerRepository.findById(listerId),\n      this.userRepository.findById(buyerUserId),\n    ]);\n    if (!lister?.userId) return;\n\n    const buyerName = buyer?.name || \"A guest\";\n    const listerName = lister.companyName || \"Organizer\";\n\n    if (!pushSent) {\n      PushService.enqueue({\n        userId: lister.userId,\n        ...PUSH_COPY.host_new_booking(\n          buyerName,\n          ticketCount,\n          eventTitle,\n          eventId,\n        ),\n      });\n      await redis.set(pushKey, \"1\", \"EX\", 5 * 60); // 5-minute cooldown\n    }\n\n    if (!emailSent) {\n      // Check lister notification preferences before sending email\n      let shouldSendEmail = true;\n      try {\n        const prefs = await this.notificationPrefsRepository.findOrCreate(\n          lister.userId,\n        );\n        shouldSendEmail = prefs.newBookingEmail;\n      } catch {\n        // Default to sending if prefs lookup fails\n      }\n\n      if (shouldSendEmail && lister.contactEmail) {\n        this.emailService\n          .sendEmail({\n            toEmail: lister.contactEmail,\n            payload: {\n              type: \"new-booking-notification\",\n              content: {\n                listerName,\n                eventName: eventTitle,\n                buyerName,\n                ticketCount,\n                amount,\n                bookingTime: new Date().toISOString(),\n                dashboardUrl: `${config.WEB_BASE_URL}/dashboard/events/${eventId}/audience`,\n              },\n            },\n          })\n          .catch((err) =>\n            logger.warn(\"Failed to send new booking email to host\", {\n              listerId,\n              eventId,\n              err,\n            }),\n          );\n      }\n      await redis.set(emailKey, \"1\", \"EX\", 60 * 60); // 1-hour cooldown\n    }\n  }\n}\n","numLines":609,"startLine":1,"totalLines":609}},"tool_result_meta":[{"id":"call-53dd9e31-b7e3-41e9-bb18-6124ec12baf0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-5c5d5fb5-b1d4-4633-90f3-b6bc089bbf83","type":"tool_result","content":"1\timport { type Job, Worker } from \"bullmq\";\n2\timport { redis } from \"../config/redis\";\n3\timport { getLogger } from \"../lib/logger\";\n4\timport { BookingRepository } from \"../repositories/booking.repository\";\n5\timport { bookingService } from \"../services/booking.service\";\n6\timport { PushService } from \"../services/push.service\";\n7\t\n8\tconst logger = getLogger(\"Booking Expiry Worker\", \"debug\");\n9\t\n10\tconst bookingRepository = new BookingRepository();\n11\t\n12\tinterface ExpireJobData {\n13\t  bookingId: string;\n14\t}\n15\t\n16\texport const bookingExpiryWorker = new Worker(\n17\t  \"booking-expiry\",\n18\t  async (job: Job) => {\n19\t    if (job.name === \"sweep\") {\n20\t      const due = await bookingRepository.findExpiredHolds(100);\n21\t      for (const b of due) {\n22\t        try {\n23\t          await bookingService.expireIfDue(b.bookingId);\n24\t        } catch (err) {\n25\t          logger.error(\"Expire booking failed in sweep\", {\n26\t            bookingId: b.bookingId,\n27\t            err: String(err),\n28\t          });\n29\t        }\n30\t      }\n31\t      logger.info(\"Booking expiry sweep complete\", { swept: due.length });\n32\t      return { swept: due.length };\n33\t    }\n34\t\n35\t    if (job.name === \"expire\") {\n36\t      const { bookingId } = job.data as ExpireJobData;\n37\t      const result = await bookingService.expireIfDue(bookingId);\n38\t\n39\t      // Send \"tickets released\" notification if booking was actually expired\n40\t      if (result) {\n41\t        try {\n42\t          const booking = await bookingRepository.findUserAndEventById(bookingId);\n43\t          if (booking?.userId && booking?.eventId) {\n44\t            PushService.enqueue({\n45\t              userId: booking.userId,\n46\t              title: \"Your hold expired ⏳\",\n47\t              body: \"Spots are going fast — grab them while you can.\",\n48\t              url: `/events/${booking.eventId}`,\n49\t              category: \"engagement\" as const,\n50\t            });\n51\t          }\n52\t        } catch (err) {\n53\t          logger.warn(\"Failed to send expiry notification\", {\n54\t            bookingId,\n55\t            err: String(err),\n56\t          });\n57\t        }\n58\t      }\n59\t\n60\t      return { expired: bookingId };\n61\t    }\n62\t  },\n63\t  {\n64\t    connection: redis,\n65\t    concurrency: 5,\n66\t  },\n67\t);\n68\t\n69\tbookingExpiryWorker.on(\"failed\", (job: Job | undefined, err: Error) => {\n70\t  logger.error(\"Booking expiry job failed\", {\n71\t    jobId: job?.id,\n72\t    jobName: job?.name,\n73\t    err: err.message,\n74\t  });\n75\t});\n76\t\n77\t\n78\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"74cb306d-387e-4093-a16f-9e88fbed80c7","timestamp":"2026-11-20T19:05:20.820Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/workers/booking-expiry.worker.ts","content":"import { type Job, Worker } from \"bullmq\";\nimport { redis } from \"../config/redis\";\nimport { getLogger } from \"../lib/logger\";\nimport { BookingRepository } from \"../repositories/booking.repository\";\nimport { bookingService } from \"../services/booking.service\";\nimport { PushService } from \"../services/push.service\";\n\nconst logger = getLogger(\"Booking Expiry Worker\", \"debug\");\n\nconst bookingRepository = new BookingRepository();\n\ninterface ExpireJobData {\n  bookingId: string;\n}\n\nexport const bookingExpiryWorker = new Worker(\n  \"booking-expiry\",\n  async (job: Job) => {\n    if (job.name === \"sweep\") {\n      const due = await bookingRepository.findExpiredHolds(100);\n      for (const b of due) {\n        try {\n          await bookingService.expireIfDue(b.bookingId);\n        } catch (err) {\n          logger.error(\"Expire booking failed in sweep\", {\n            bookingId: b.bookingId,\n            err: String(err),\n          });\n        }\n      }\n      logger.info(\"Booking expiry sweep complete\", { swept: due.length });\n      return { swept: due.length };\n    }\n\n    if (job.name === \"expire\") {\n      const { bookingId } = job.data as ExpireJobData;\n      const result = await bookingService.expireIfDue(bookingId);\n\n      // Send \"tickets released\" notification if booking was actually expired\n      if (result) {\n        try {\n          const booking = await bookingRepository.findUserAndEventById(bookingId);\n          if (booking?.userId && booking?.eventId) {\n            PushService.enqueue({\n              userId: booking.userId,\n              title: \"Your hold expired ⏳\",\n              body: \"Spots are going fast — grab them while you can.\",\n              url: `/events/${booking.eventId}`,\n              category: \"engagement\" as const,\n            });\n          }\n        } catch (err) {\n          logger.warn(\"Failed to send expiry notification\", {\n            bookingId,\n            err: String(err),\n          });\n        }\n      }\n\n      return { expired: bookingId };\n    }\n  },\n  {\n    connection: redis,\n    concurrency: 5,\n  },\n);\n\nbookingExpiryWorker.on(\"failed\", (job: Job | undefined, err: Error) => {\n  logger.error(\"Booking expiry job failed\", {\n    jobId: job?.id,\n    jobName: job?.name,\n    err: err.message,\n  });\n});\n\n\n","numLines":78,"startLine":1,"totalLines":78}},"tool_result_meta":[{"id":"call-5c5d5fb5-b1d4-4633-90f3-b6bc089bbf83","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
