{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-ec6fd820-19ff-4ce2-b5b1-8db2d089d908","type":"tool_result","content":"=== db.ts ===\nimport \"dotenv/config\";\n\nimport cluster from \"node:cluster\";\nimport os from \"node:os\";\nimport { isMainThread, workerData } from \"node:worker_threads\";\nimport { PrismaPg } from \"@prisma/adapter-pg\";\nimport { Pool } from \"pg\";\nimport { PrismaClient } from \"../generated/prisma/client\";\nimport { config, getDbPoolRealmCount } from \".\";\nimport logger from \"./logger\";\n\nconst connectionString = config.DATABASE_URL;\n\ntype ServiceRole = \"api\" | \"worker\" | \"unknown\";\n\nconst resolveServiceRole = (): ServiceRole => {\n  const fromEnv = process.env.TUNYT_SERVICE_ROLE;\n  if (fromEnv === \"api\" || fromEnv === \"worker\") return fromEnv;\n  if (cluster.isWorker) return \"api\";\n\n  const entrypoint = process.argv[1] ?? \"\";\n  if (entrypoint.includes(\"/workers/\") || entrypoint.includes(\"\\\\workers\\\\\")) {\n    return \"worker\";\n  }\n  if (entrypoint.endsWith(\"/bin.js\") || entrypoint.endsWith(\"\\\\bin.js\")) {\n    return \"api\";\n  }\n\n  return \"unknown\";\n};\n\n// Pool sizing — env-driven so deployments can tune per Postgres tier.\n//\n// DB_POOL_MAX is the database-wide app connection budget, not a per-service\n// budget. API and worker services each get a smaller slice of it via\n// DB_POOL_API_MAX / DB_POOL_WORKER_MAX. This matters on small managed Postgres\n// plans where max_connections can be around 20: if API and worker both treat\n// DB_POOL_MAX=20 as their own budget, a steady deployment can request ~40 app\n// connections before admin sessions or rolling deploy overlap are counted.\nconst serviceRole = resolveServiceRole();\nconst poolMax =\n  serviceRole === \"api\"\n    ? config.DB_POOL_API_MAX\n    : serviceRole === \"worker\"\n      ? config.DB_POOL_WORKER_MAX\n      : config.DB_POOL_MAX;\nconst poolMin = config.DB_POOL_MIN;\n\n// Cap any single service slice so it cannot consume the whole database. Keep a\n// hard escape hatch below the common Postgres superuser reserve.\nconst POOL_HARD_CEILING = 90;\n\nconst cappedMax = Math.min(poolMax, POOL_HARD_CEILING);\n\n// The selected service budget above is still shared by every independent JS\n// realm in that service, and each realm builds its own `pg.Pool`:\n//   - tunyt-api forks one process per CPU core (see bin.ts's cluster.fork()\n//     loop) — each fork re-imports this file from scratch.\n//   - tunyt-worker spawns 14 worker_threads (see index.worker.ts) — each\n//     thread is a separate V8 realm and re-imports this file too.\n// Without dividing, N realms each asking for the full service slice can demand\n// N × serviceBudget total. Each realm shrinks its own `max` by the number of\n// sibling realms sharing the budget, so the total across all of them stays\n// within the selected API/worker slice regardless of core count or thread\n// count.\nconst resolvePoolDivisor = (): number => {\n  // Spawned worker_threads are separate V8 realms that can't share mutable\n  // module state with their parent — index.worker.ts passes the sibling\n  // count in explicitly via workerData at Worker construction time.\n  if (!isMainThread) {\n=== tests using prisma ===\ntests/slot-availability-overlap.spec.ts\ntests/holdslots-walkin-package.spec.ts\ntests/notification-unread-cache.spec.ts\ntests/short-link-e2e.spec.ts\ntests/venueslot-upsert-overlap.spec.ts\ntests/holdslots-walkin-offgrid.spec.ts\ntests/walkin-offgrid-booking.spec.ts\ntests/custom-field-validation.spec.ts\ntests/venue-package.repository.spec.ts\ntests/walkin-options.spec.ts\ntests/follow-consolidation.spec.ts\ntests/short-link-service.spec.ts\ntests/segment-service.spec.ts\ntests/helpers/seed-walkin.ts\ntests/venueslot-overlap-constraint.spec.ts\ntests/venue-walkin-qr-code.spec.ts\ntests/partner-checkout-recovery.spec.ts\ntests/holdslots-walkin-bounds.spec.ts\ntests/venue-walkin-qr-booking.spec.ts","is_error":