16-  // ============================================================================\n117-  // Platform Analytics\n118-  // ============================================================================","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"b32b42d6-b1b6-49a4-b42b-4270f2ec340a","timestamp":"2026-11-20T19:26:38.247Z","tool_use_result":{"stdout":"=== updateTicketSales ===\n72:  async updateTicketSales(eventId: string, quantity: number, amount: number) {\n73:    return this.eventAnalyticsRepository.updateTicketSales(eventId, quantity, amount);\n74-  }\n75-\n76-  async updateSocialStats(eventId: string, type: \"like\" | \"follow\", increment: boolean) {\n77-    return this.eventAnalyticsRepository.updateSocialStats(eventId, type, increment);\n78-  }\n79-\n80-  async getEventAnalytics(eventId: string) {\n81-    return this.eventAnalyticsRepository.getEventAnalytics(eventId);\n82-  }\n83-\n84-  async getTicketTypeAnalytics(eventId: string, from?: string, to?: string) {\n85-    return this.eventAnalyticsRepository.getTicketTypeAnalytics(eventId, from, to);\n86-  }\n87-\n88-  async incrementAbandonedCheckouts(eventId: string, count = 1) {\n89-    return this.eventAnalyticsRepository.incrementAbandonedCheckouts(eventId, count);\n90-  }\n91-\n92-  async getAbandonedCheckoutCount(eventId: string) {\n93-    return this.eventAnalyticsRepository.getAbandonedCheckoutCount(eventId);\n94-  }\n95-\n96-  async getEventFunnel(eventId: string) {\n97-    return this.eventAnalyticsRepository.getEventFunnel(eventId);\n98-  }\n99-\n100-  // ============================================================================\n101-  // Lister Analytics\n102-  // ============================================================================\n103-\n104-  async getOrCreateListerAnalytics(listerId: string) {\n105-    return this.listerAnalyticsRepository.getOrCreateListerAnalytics(listerId);\n106-  }\n107-\n108-  async getListerAnalytics(li