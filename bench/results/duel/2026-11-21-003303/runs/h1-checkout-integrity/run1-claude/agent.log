{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-968d7968-b579-4e90-abdd-1e94fc60983a","type":"tool_result","content":"1\timport type { Payments } from \"razorpay/dist/types/payments\";\n2\timport { config } from \"../../config\";\n3\timport logger from \"../../config/logger\";\n4\timport {\n5\t  getListerKeySecret,\n6\t  getRazorpayInstance,\n7\t} from \"../../lib/razorpay-factory\";\n8\timport { BookingRepository } from \"../../repositories/booking.repository\";\n9\timport { EventRepository } from \"../../repositories/event.repository\";\n10\timport { PaymentRepository } from \"../../repositories/payment.repository\";\n11\timport { RazorpayConfigRepository } from \"../../repositories/razorpay-config.repository\";\n12\timport {\n13\t  PAYMENT_CONSTANTS,\n14\t  PAYMENT_ERROR_MESSAGES,\n15\t} from \"../../types/payment.types\";\n16\timport { razorpayCircuitBreaker } from \"../../utils/circuit-breaker.util\";\n17\timport { decrypt } from \"../../utils/encryption.util\";\n18\timport {\n19\t  BadRequestError,\n20\t  ConflictError,\n21\t  ForbiddenError,\n22\t  NotFoundError,\n23\t  ValidationError,\n24\t} from \"../../utils/errors.util\";\n25\timport { toPaise } from \"../../utils/money.util\";\n26\timport { BookingPaymentFinalizerService } from \"./booking-payment-finalizer.service\";\n27\timport { verifyPaymentSignature } from \"./payment-signature.util\";\n28\t\n29\t/**\n30\t * Booking-flow payment methods (Razorpay order creation + verification for\n31\t * the Booking model — separate from the legacy ticket-based flow).\n32\t */\n33\texport class BookingPaymentService {\n34\t  private paymentRepository: PaymentRepository;\n35\t  private eventRepository: EventRepository;\n36\t  private bookingRepository: BookingRepository;\n37\t  private razorpayConfigRepository: RazorpayConfigRepository;\n38\t  private finalizer: BookingPaymentFinalizerService;\n39\t\n40\t  constructor(\n41\t    paymentRepository?: PaymentRepository,\n42\t    eventRepository?: EventRepository,\n43\t    finalizer?: BookingPaymentFinalizerService,\n44\t  ) {\n45\t    this.paymentRepository = paymentRepository ?? new PaymentRepository();\n46\t    this.eventRepository = eventRepository ?? new EventRepository();\n47\t    this.bookingRepository = new BookingRepository();\n48\t    this.razorpayConfigRepository = new RazorpayConfigRepository();\n49\t    this.finalizer = finalizer ?? new BookingPaymentFinalizerService();\n50\t  }\n51\t\n52\t  /**\n53\t   * Confirm a zero-total (free/RSVP) booking without touching Razorpay.\n54\t   * Throws BadRequestError if the booking has a non-zero total.\n55\t   */\n56\t  async confirmFreeBooking(userId: string, bookingId: string) {\n57\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n58\t\n59\t    if (booking.userId !== userId) {\n60\t      throw new ForbiddenError(\"Not your booking\");\n61\t    }\n62\t\n63\t    if (\n64\t      booking.status !== \"HELD\" &&\n65\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n66\t    ) {\n67\t      throw new ConflictError(\"Booking is not in HELD state\");\n68\t    }\n69\t\n70\t    if (booking.holdExpiresAt.getTime() < Date.now()) {\n71\t      throw new ConflictError(\"Hold expired\");\n72\t    }\n73\t\n74\t    if (booking.total !== 0) {\n75\t      throw new BadRequestError(\"Booking is not free\");\n76\t    }\n77\t\n78\t    await this.finalizer.finalizePaidBooking(bookingId);\n79\t\n80\t    logger.info(\"Free booking confirmed\", { bookingId, userId });\n81\t\n82\t    return { confirmed: true };\n83\t  }\n84\t\n85\t  async createPaymentOrderForBooking(\n86\t    userId: string,\n87\t    bookingId: string,\n88\t  ): Promise<{\n89\t    razorpayOrderId: string;\n90\t    keyId: string;\n91\t    amount: number;\n92\t    isFree?: boolean;\n93\t  }> {\n94\t    // Load booking with payment and event\n95\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n96\t\n97\t    // Ownership check\n98\t    if (booking.userId !== userId) {\n99\t      throw new ForbiddenError(\"Not your booking\");\n100\t    }\n101\t\n102\t    // Status check\n103\t    if (\n104\t      booking.status !== \"HELD\" &&\n105\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n106\t    ) {\n107\t      throw new ConflictError(\"Booking is not in HELD state\");\n108\t    }\n109\t\n110\t    // Hold expiry check\n111\t    if (booking.holdExpiresAt.getTime() < Date.now()) {\n112\t      throw new ConflictError(\"Hold expired\");\n113\t    }\n114\t\n115\t    // Free / RSVP booking — skip Razorpay, confirm immediately\n116\t    if (booking.total === 0) {\n117\t      await this.finalizer.finalizePaidBooking(bookingId);\n118\t      logger.info(\"Free booking confirmed without Razorpay\", {\n119\t        bookingId,\n120\t        userId,\n121\t      });\n122\t      return {\n123\t        razorpayOrderId: \"\",\n124\t        keyId: \"\",\n125\t        amount: 0,\n126\t        isFree: true,\n127\t      };\n128\t    }\n129\t\n130\t    // Idempotency: if a PENDING order already exists AND its amount still\n131\t    // matches the live booking total, return it as-is. If the booking was\n132\t    // repriced since the order was created (coupon applied/removed via\n133\t    // applyDiscount, which reprices Booking+Ticket rows but never touches\n134\t    // Payment — booking.repository.ts repriceWithDiscount), the old Razorpay\n135\t    // order is stale: reusing it would let the buyer pay the OLD amount while\n136\t    // the booking confirms at the NEW (possibly higher) total. Fall through\n137\t    // and mint a fresh order instead.\n138\t    if (\n139\t      booking.payment?.razorpayOrderId &&\n140\t      booking.payment.status === \"PENDING\" &&\n141\t      toPaise(booking.payment.amount) === toPaise(booking.total)\n142\t    ) {\n143\t      // Determine keyId: use listerRazorpayConfigId if present, else platform key\n144\t      let keyId = config.RAZORPAY_KEY_ID;\n145\t      if (booking.payment.listerRazorpayConfigId) {\n146\t        try {\n147\t          const listerConfig = await this.razorpayConfigRepository.findById(\n148\t            booking.payment.listerRazorpayConfigId,\n149\t          );\n150\t          if (listerConfig?.encryptedKeyId) {\n151\t            keyId = decrypt(listerConfig.encryptedKeyId);\n152\t          }\n153\t        } catch {\n154\t          // fall back to platform key\n155\t        }\n156\t      }\n157\t\n158\t      // Extend the hold even on retry — the original 15-min window may have\n159\t      // shrunk if the user dismissed and reopened payment near expiry.\n160\t      await this.bookingRepository.extendHold(\n161\t        bookingId,\n162\t        new Date(Date.now() + 15 * 60 * 1000),\n163\t      );\n164\t\n165\t      return {\n166\t        razorpayOrderId: booking.payment.razorpayOrderId,\n167\t        keyId,\n168\t        amount: Math.round(booking.total * 100), // paise\n169\t      };\n170\t    }\n171\t\n172\t    // Get event's listerId to route to correct Razorpay account\n173\t    const event = await this.eventRepository.findByIdMinimal(\n174\t      booking.event.eventId,\n175\t    );\n176\t    if (!event) {\n177\t      throw new NotFoundError(\"Event not found\");\n178\t    }\n179\t\n180\t    const {\n181\t      instance: razorpayInstance,\n182\t      configId,\n183\t      razorpayKeyId,\n184\t    } = await getRazorpayInstance(event.listerId);\n185\t\n186\t    // Create Razorpay order\n187\t    let razorpayOrder: { id: string };\n188\t    try {\n189\t      razorpayOrder = await razorpayCircuitBreaker.execute(() =>\n190\t        razorpayInstance.orders.create({\n191\t          amount: Math.round(booking.total * 100), // paise\n192\t          currency: PAYMENT_CONSTANTS.DEFAULT_CURRENCY,\n193\t          receipt: bookingId,\n194\t          notes: {\n195\t            bookingId,\n196\t            userId,\n197\t          },\n198\t        }),\n199\t      );\n200\t    } catch (error) {\n201\t      logger.error(\"Razorpay order creation failed for booking\", {\n202\t        error,\n203\t        bookingId,\n204\t        userId,\n205\t      });\n206\t      throw new BadRequestError(\n207\t        PAYMENT_ERROR_MESSAGES.RAZORPAY_ORDER_CREATION_FAILED,\n208\t      );\n209\t    }\n210\t\n211\t    // Upsert the Payment row keyed on bookingId\n212\t    await this.paymentRepository.upsertForBooking({\n213\t      userId,\n214\t      eventId: booking.event.eventId,\n215\t      bookingId,\n216\t      razorpayOrderId: razorpayOrder.id,\n217\t      amount: booking.total,\n218\t      platformFee: booking.platformFee,\n219\t      // HOST: lister nets face − platformFee − gatewayFee\n220\t      // USER: lister nets full face (buyer paid fees)\n221\t      // MIXED: conservatively deduct all fees\n222\t      listerRevenue:\n223\t        booking.feesBornBy === \"USER\"\n224\t          ? booking.subtotal\n225\t          : booking.subtotal - booking.platformFee - booking.gatewayFee,\n226\t      receiptId: bookingId,\n227\t      currency: PAYMENT_CONSTANTS.DEFAULT_CURRENCY,\n228\t      listerRazorpayConfigId: configId ?? undefined,\n229\t    });\n230\t\n231\t    // Extend the hold window so an in-flight Razorpay payment isn't expired\n232\t    // before verifyBookingPayment can run. 15 minutes covers even slow 3DS\n233\t    // flows; the booking expiry worker checks holdExpiresAt before expiring.\n234\t    await this.bookingRepository.extendHold(\n235\t      bookingId,\n236\t      new Date(Date.now() + 15 * 60 * 1000),\n237\t    );\n238\t\n239\t    logger.info(\"Razorpay order created for booking\", {\n240\t      orderId: razorpayOrder.id,\n241\t      bookingId,\n242\t      userId,\n243\t      amount: booking.total,\n244\t    });\n245\t\n246\t    return {\n247\t      razorpayOrderId: razorpayOrder.id,\n248\t      keyId: razorpayKeyId,\n249\t      amount: Math.round(booking.total * 100), // paise\n250\t    };\n251\t  }\n252\t\n253\t  /**\n254\t   * Verify Razorpay payment signature and confirm a booking.\n255\t   */\n256\t  async verifyBookingPayment(\n257\t    userId: string,\n258\t    bookingId: string,\n259\t    signed: {\n260\t      razorpay_order_id: string;\n261\t      razorpay_payment_id: string;\n262\t      razorpay_signature: string;\n263\t    },\n264\t  ): Promise<unknown> {\n265\t    const { razorpay_order_id, razorpay_payment_id, razorpay_signature } =\n266\t      signed;\n267\t\n268\t    // Load booking + payment\n269\t    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n270\t\n271\t    // Ownership check\n272\t    if (booking.userId !== userId) {\n273\t      throw new ForbiddenError(\"Not your booking\");\n274\t    }\n275\t\n276\t    // Status check. The Razorpay webhook (handlePaymentCaptured) can race\n277\t    // this client-initiated verify call and finalize the booking first —\n278\t    // Razorpay fires the webhook independently of the checkout success\n279\t    // callback, and the webhook is often faster. If that happened, the\n280\t    // booking is already correctly PAID for *this* order; treat it as an\n281\t    // idempotent success instead of erroring, mirroring the webhook's own\n282\t    // already-PAID short-circuit (handlePaymentCaptured above). Only do this\n283\t    // when the completed payment matches the order this call is verifying —\n284\t    // otherwise fall through to the ConflictError below.\n285\t    if (\n286\t      booking.status === \"PAID\" &&\n287\t      booking.payment?.razorpayOrderId === razorpay_order_id\n288\t    ) {\n289\t      await this.finalizer.confirmTeamFromBookingResult(bookingId, booking);\n290\t      return booking;\n291\t    }\n292\t\n293\t    if (\n294\t      booking.status !== \"HELD\" &&\n295\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n296\t    ) {\n297\t      throw new ConflictError(\"Booking is not in HELD state\");\n298\t    }\n299\t\n300\t    // Hold expiry check\n301\t    if (booking.holdExpiresAt.getTime() < Date.now()) {\n302\t      throw new ConflictError(\"Hold expired\");\n303\t    }\n304\t\n305\t    // The signed order must be THIS booking's own order. Without it, one captured payment\n306\t    // (say a Rs 500 order for booking A) could be replayed against booking B of the same\n307\t    // total, and both would finalise for a single payment.\n308\t    if (booking.payment?.razorpayOrderId !== razorpay_order_id) {\n309\t      logger.error(\"Booking payment order does not belong to this booking\", {\n310\t        bookingId,\n311\t        userId,\n312\t        orderId: razorpay_order_id,\n313\t      });\n314\t      throw new ValidationError(\"Payment does not belong to this booking\");\n315\t    }\n316\t\n317\t    // Determine which key secret to use\n318\t    let keySecret = config.RAZORPAY_KEY_SECRET;\n319\t    if (booking.payment?.listerRazorpayConfigId) {\n320\t      keySecret = await getListerKeySecret(\n321\t        booking.payment.listerRazorpayConfigId,\n322\t      );\n323\t    }\n324\t\n325\t    // Verify Razorpay signature\n326\t    const isValid = verifyPaymentSignature(\n327\t      razorpay_order_id,\n328\t      razorpay_payment_id,\n329\t      razorpay_signature,\n330\t      keySecret,\n331\t    );\n332\t\n333\t    if (!isValid) {\n334\t      logger.error(\"Booking payment signature verification failed\", {\n335\t        orderId: razorpay_order_id,\n336\t        bookingId,\n337\t        userId,\n338\t      });\n339\t      throw new ValidationError(\"Signature mismatch\");\n340\t    }\n341\t\n342\t    // Reconcile the actually-captured amount against the live booking total.\n343\t    // A HELD booking's total can move after the Razorpay order was created\n344\t    // (coupon applied/removed via applyDiscount reprices Booking+Ticket rows\n345\t    // but never touches the existing Payment/order — see\n346\t    // createPaymentOrderForBooking's idempotency guard for the other half of\n347\t    // this fix). Verifying only the HMAC signature proves the payment belongs\n348\t    // to this order, not that its amount still matches what's owed now.\n349\t    const { instance: razorpayInstance } = await getRazorpayInstance(\n350\t      booking.event.listerId,\n351\t    );\n352\t\n353\t    let razorpayPayment: Payments.RazorpayPayment;\n354\t    try {\n355\t      razorpayPayment = await razorpayCircuitBreaker.execute(() =>\n356\t        razorpayInstance.payments.fetch(razorpay_payment_id),\n357\t      );\n358\t    } catch (error) {\n359\t      logger.error(\"Failed to fetch Razorpay payment for booking verification\", {\n360\t        error,\n361\t        bookingId,\n362\t        paymentId: razorpay_payment_id,\n363\t      });\n364\t      throw new BadRequestError(\n365\t        PAYMENT_ERROR_MESSAGES.RAZORPAY_PAYMENT_VERIFICATION_FAILED,\n366\t      );\n367\t    }\n368\t\n369\t    if (razorpayPayment.status !== \"captured\") {\n370\t      throw new BadRequestError(PAYMENT_ERROR_MESSAGES.PAYMENT_FAILED);\n371\t    }\n372\t\n373\t    const capturedAmount = (razorpayPayment.amount as number) / 100;\n374\t    if (toPaise(capturedAmount) !== toPaise(booking.total)) {\n375\t      logger.error(\"Booking payment amount mismatch — refusing to finalize\", {\n376\t        bookingId,\n377\t        orderId: razorpay_order_id,\n378\t        paymentId: razorpay_payment_id,\n379\t        capturedAmount,\n380\t        bookingTotal: booking.total,\n381\t      });\n382\t      await this.paymentRepository.markAsFailed(razorpay_order_id, {\n383\t        failureReason: `Captured amount ₹${capturedAmount} does not match booking total ₹${booking.total}`,\n384\t      });\n385\t      throw new ConflictError(\n386\t        \"Payment amount does not match the current booking total — the price may have changed since checkout started. Please retry payment.\",\n387\t      );\n388\t    }\n389\t\n390\t    // Update Payment row with Razorpay payment details\n391\t    await this.paymentRepository.updatePaymentVerification(razorpay_order_id, {\n392\t      razorpayPaymentId: razorpay_payment_id,\n393\t      razorpaySignature: razorpay_signature,\n394\t      status: \"COMPLETED\",\n395\t    });\n396\t\n397\t    // Finalize the booking (atomic tickets → SUCCESS + booking → PAID + discount + email)\n398\t    const result = await this.finalizer.finalizePaidBooking(bookingId);\n399\t\n400\t    // Team confirmation: if any tickets in this booking belong to a team,\n401\t    // mirror the team-confirmation logic from the ticket-based verify path.\n402\t    await this.finalizer.confirmTeamFromBookingResult(bookingId, result);\n403\t\n404\t    return result;\n405\t  }\n406\t}\n407\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"56fd7d4e-82c7-4d5f-a377-a81f57a32b19","timestamp":"2026-11-20T19:05:12.215Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/services/payment/booking-payment.service.ts","content":"import type { Payments } from \"razorpay/dist/types/payments\";\nimport { config } from \"../../config\";\nimport logger from \"../../config/logger\";\nimport {\n  getListerKeySecret,\n  getRazorpayInstance,\n} from \"../../lib/razorpay-factory\";\nimport { BookingRepository } from \"../../repositories/booking.repository\";\nimport { EventRepository } from \"../../repositories/event.repository\";\nimport { PaymentRepository } from \"../../repositories/payment.repository\";\nimport { RazorpayConfigRepository } from \"../../repositories/razorpay-config.repository\";\nimport {\n  PAYMENT_CONSTANTS,\n  PAYMENT_ERROR_MESSAGES,\n} from \"../../types/payment.types\";\nimport { razorpayCircuitBreaker } from \"../../utils/circuit-breaker.util\";\nimport { decrypt } from \"../../utils/encryption.util\";\nimport {\n  BadRequestError,\n  ConflictError,\n  ForbiddenError,\n  NotFoundError,\n  ValidationError,\n} from \"../../utils/errors.util\";\nimport { toPaise } from \"../../utils/money.util\";\nimport { BookingPaymentFinalizerService } from \"./booking-payment-finalizer.service\";\nimport { verifyPaymentSignature } from \"./payment-signature.util\";\n\n/**\n * Booking-flow payment methods (Razorpay order creation + verification for\n * the Booking model — separate from the legacy ticket-based flow).\n */\nexport class BookingPaymentService {\n  private paymentRepository: PaymentRepository;\n  private eventRepository: EventRepository;\n  private bookingRepository: BookingRepository;\n  private razorpayConfigRepository: RazorpayConfigRepository;\n  private finalizer: BookingPaymentFinalizerService;\n\n  constructor(\n    paymentRepository?: PaymentRepository,\n    eventRepository?: EventRepository,\n    finalizer?: BookingPaymentFinalizerService,\n  ) {\n    this.paymentRepository = paymentRepository ?? new PaymentRepository();\n    this.eventRepository = eventRepository ?? new EventRepository();\n    this.bookingRepository = new BookingRepository();\n    this.razorpayConfigRepository = new RazorpayConfigRepository();\n    this.finalizer = finalizer ?? new BookingPaymentFinalizerService();\n  }\n\n  /**\n   * Confirm a zero-total (free/RSVP) booking without touching Razorpay.\n   * Throws BadRequestError if the booking has a non-zero total.\n   */\n  async confirmFreeBooking(userId: string, bookingId: string) {\n    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n\n    if (booking.userId !== userId) {\n      throw new ForbiddenError(\"Not your booking\");\n    }\n\n    if (\n      booking.status !== \"HELD\" &&\n      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n    ) {\n      throw new ConflictError(\"Booking is not in HELD state\");\n    }\n\n    if (booking.holdExpiresAt.getTime() < Date.now()) {\n      throw new ConflictError(\"Hold expired\");\n    }\n\n    if (booking.total !== 0) {\n      throw new BadRequestError(\"Booking is not free\");\n    }\n\n    await this.finalizer.finalizePaidBooking(bookingId);\n\n    logger.info(\"Free booking confirmed\", { bookingId, userId });\n\n    return { confirmed: true };\n  }\n\n  async createPaymentOrderForBooking(\n    userId: string,\n    bookingId: string,\n  ): Promise<{\n    razorpayOrderId: string;\n    keyId: string;\n    amount: number;\n    isFree?: boolean;\n  }> {\n    // Load booking with payment and event\n    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n\n    // Ownership check\n    if (booking.userId !== userId) {\n      throw new ForbiddenError(\"Not your booking\");\n    }\n\n    // Status check\n    if (\n      booking.status !== \"HELD\" &&\n      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n    ) {\n      throw new ConflictError(\"Booking is not in HELD state\");\n    }\n\n    // Hold expiry check\n    if (booking.holdExpiresAt.getTime() < Date.now()) {\n      throw new ConflictError(\"Hold expired\");\n    }\n\n    // Free / RSVP booking — skip Razorpay, confirm immediately\n    if (booking.total === 0) {\n      await this.finalizer.finalizePaidBooking(bookingId);\n      logger.info(\"Free booking confirmed without Razorpay\", {\n        bookingId,\n        userId,\n      });\n      return {\n        razorpayOrderId: \"\",\n        keyId: \"\",\n        amount: 0,\n        isFree: true,\n      };\n    }\n\n    // Idempotency: if a PENDING order already exists AND its amount still\n    // matches the live booking total, return it as-is. If the booking was\n    // repriced since the order was created (coupon applied/removed via\n    // applyDiscount, which reprices Booking+Ticket rows but never touches\n    // Payment — booking.repository.ts repriceWithDiscount), the old Razorpay\n    // order is stale: reusing it would let the buyer pay the OLD amount while\n    // the booking confirms at the NEW (possibly higher) total. Fall through\n    // and mint a fresh order instead.\n    if (\n      booking.payment?.razorpayOrderId &&\n      booking.payment.status === \"PENDING\" &&\n      toPaise(booking.payment.amount) === toPaise(booking.total)\n    ) {\n      // Determine keyId: use listerRazorpayConfigId if present, else platform key\n      let keyId = config.RAZORPAY_KEY_ID;\n      if (booking.payment.listerRazorpayConfigId) {\n        try {\n          const listerConfig = await this.razorpayConfigRepository.findById(\n            booking.payment.listerRazorpayConfigId,\n          );\n          if (listerConfig?.encryptedKeyId) {\n            keyId = decrypt(listerConfig.encryptedKeyId);\n          }\n        } catch {\n          // fall back to platform key\n        }\n      }\n\n      // Extend the hold even on retry — the original 15-min window may have\n      // shrunk if the user dismissed and reopened payment near expiry.\n      await this.bookingRepository.extendHold(\n        bookingId,\n        new Date(Date.now() + 15 * 60 * 1000),\n      );\n\n      return {\n        razorpayOrderId: booking.payment.razorpayOrderId,\n        keyId,\n        amount: Math.round(booking.total * 100), // paise\n      };\n    }\n\n    // Get event's listerId to route to correct Razorpay account\n    const event = await this.eventRepository.findByIdMinimal(\n      booking.event.eventId,\n    );\n    if (!event) {\n      throw new NotFoundError(\"Event not found\");\n    }\n\n    const {\n      instance: razorpayInstance,\n      configId,\n      razorpayKeyId,\n    } = await getRazorpayInstance(event.listerId);\n\n    // Create Razorpay order\n    let razorpayOrder: { id: string };\n    try {\n      razorpayOrder = await razorpayCircuitBreaker.execute(() =>\n        razorpayInstance.orders.create({\n          amount: Math.round(booking.total * 100), // paise\n          currency: PAYMENT_CONSTANTS.DEFAULT_CURRENCY,\n          receipt: bookingId,\n          notes: {\n            bookingId,\n            userId,\n          },\n        }),\n      );\n    } catch (error) {\n      logger.error(\"Razorpay order creation failed for booking\", {\n        error,\n        bookingId,\n        userId,\n      });\n      throw new BadRequestError(\n        PAYMENT_ERROR_MESSAGES.RAZORPAY_ORDER_CREATION_FAILED,\n      );\n    }\n\n    // Upsert the Payment row keyed on bookingId\n    await this.paymentRepository.upsertForBooking({\n      userId,\n      eventId: booking.event.eventId,\n      bookingId,\n      razorpayOrderId: razorpayOrder.id,\n      amount: booking.total,\n      platformFee: booking.platformFee,\n      // HOST: lister nets face − platformFee − gatewayFee\n      // USER: lister nets full face (buyer paid fees)\n      // MIXED: conservatively deduct all fees\n      listerRevenue:\n        booking.feesBornBy === \"USER\"\n          ? booking.subtotal\n          : booking.subtotal - booking.platformFee - booking.gatewayFee,\n      receiptId: bookingId,\n      currency: PAYMENT_CONSTANTS.DEFAULT_CURRENCY,\n      listerRazorpayConfigId: configId ?? undefined,\n    });\n\n    // Extend the hold window so an in-flight Razorpay payment isn't expired\n    // before verifyBookingPayment can run. 15 minutes covers even slow 3DS\n    // flows; the booking expiry worker checks holdExpiresAt before expiring.\n    await this.bookingRepository.extendHold(\n      bookingId,\n      new Date(Date.now() + 15 * 60 * 1000),\n    );\n\n    logger.info(\"Razorpay order created for booking\", {\n      orderId: razorpayOrder.id,\n      bookingId,\n      userId,\n      amount: booking.total,\n    });\n\n    return {\n      razorpayOrderId: razorpayOrder.id,\n      keyId: razorpayKeyId,\n      amount: Math.round(booking.total * 100), // paise\n    };\n  }\n\n  /**\n   * Verify Razorpay payment signature and confirm a booking.\n   */\n  async verifyBookingPayment(\n    userId: string,\n    bookingId: string,\n    signed: {\n      razorpay_order_id: string;\n      razorpay_payment_id: string;\n      razorpay_signature: string;\n    },\n  ): Promise<unknown> {\n    const { razorpay_order_id, razorpay_payment_id, razorpay_signature } =\n      signed;\n\n    // Load booking + payment\n    const booking = await this.bookingRepository.findByIdWithDetails(bookingId);\n\n    // Ownership check\n    if (booking.userId !== userId) {\n      throw new ForbiddenError(\"Not your booking\");\n    }\n\n    // Status check. The Razorpay webhook (handlePaymentCaptured) can race\n    // this client-initiated verify call and finalize the booking first —\n    // Razorpay fires the webhook independently of the checkout success\n    // callback, and the webhook is often faster. If that happened, the\n    // booking is already correctly PAID for *this* order; treat it as an\n    // idempotent success instead of erroring, mirroring the webhook's own\n    // already-PAID short-circuit (handlePaymentCaptured above). Only do this\n    // when the completed payment matches the order this call is verifying —\n    // otherwise fall through to the ConflictError below.\n    if (\n      booking.status === \"PAID\" &&\n      booking.payment?.razorpayOrderId === razorpay_order_id\n    ) {\n      await this.finalizer.confirmTeamFromBookingResult(bookingId, booking);\n      return booking;\n    }\n\n    if (\n      booking.status !== \"HELD\" &&\n      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n    ) {\n      throw new ConflictError(\"Booking is not in HELD state\");\n    }\n\n    // Hold expiry check\n    if (booking.holdExpiresAt.getTime() < Date.now()) {\n      throw new ConflictError(\"Hold expired\");\n    }\n\n    // The signed order must be THIS booking's own order. Without it, one captured payment\n    // (say a Rs 500 order for booking A) could be replayed against booking B of the same\n    // total, and both would finalise for a single payment.\n    if (booking.payment?.razorpayOrderId !== razorpay_order_id) {\n      logger.error(\"Booking payment order does not belong to this booking\", {\n        bookingId,\n        userId,\n        orderId: razorpay_order_id,\n      });\n      throw new ValidationError(\"Payment does not belong to this booking\");\n    }\n\n    // Determine which key secret to use\n    let keySecret = config.RAZORPAY_KEY_SECRET;\n    if (booking.payment?.listerRazorpayConfigId) {\n      keySecret = await getListerKeySecret(\n        booking.payment.listerRazorpayConfigId,\n      );\n    }\n\n    // Verify Razorpay signature\n    const isValid = verifyPaymentSignature(\n      razorpay_order_id,\n      razorpay_payment_id,\n      razorpay_signature,\n      keySecret,\n    );\n\n    if (!isValid) {\n      logger.error(\"Booking payment signature verification failed\", {\n        orderId: razorpay_order_id,\n        bookingId,\n        userId,\n      });\n      throw new ValidationError(\"Signature mismatch\");\n    }\n\n    // Reconcile the actually-captured amount against the live booking total.\n    // A HELD booking's total can move after the Razorpay order was created\n    // (coupon applied/removed via applyDiscount reprices Booking+Ticket rows\n    // but never touches the existing Payment/order — see\n    // createPaymentOrderForBooking's idempotency guard for the other half of\n    // this fix). Verifying only the HMAC signature proves the payment belongs\n    // to this order, not that its amount still matches what's owed now.\n    const { instance: razorpayInstance } = await getRazorpayInstance(\n      booking.event.listerId,\n    );\n\n    let razorpayPayment: Payments.RazorpayPayment;\n    try {\n      razorpayPayment = await razorpayCircuitBreaker.execute(() =>\n        razorpayInstance.payments.fetch(razorpay_payment_id),\n      );\n    } catch (error) {\n      logger.error(\"Failed to fetch Razorpay payment for booking verification\", {\n        error,\n        bookingId,\n        paymentId: razorpay_payment_id,\n      });\n      throw new BadRequestError(\n        PAYMENT_ERROR_MESSAGES.RAZORPAY_PAYMENT_VERIFICATION_FAILED,\n      );\n    }\n\n    if (razorpayPayment.status !== \"captured\") {\n      throw new BadRequestError(PAYMENT_ERROR_MESSAGES.PAYMENT_FAILED);\n    }\n\n    const capturedAmount = (razorpayPayment.amount as number) / 100;\n    if (toPaise(capturedAmount) !== toPaise(booking.total)) {\n      logger.error(\"Booking payment amount mismatch — refusing to finalize\", {\n        bookingId,\n        orderId: razorpay_order_id,\n        paymentId: razorpay_payment_id,\n        capturedAmount,\n        bookingTotal: booking.total,\n      });\n      await this.paymentRepository.markAsFailed(razorpay_order_id, {\n        failureReason: `Captured amount ₹${capturedAmount} does not match booking total ₹${booking.total}`,\n      });\n      throw new ConflictError(\n        \"Payment amount does not match the current booking total — the price may have changed since checkout started. Please retry payment.\",\n      );\n    }\n\n    // Update Payment row with Razorpay payment details\n    await this.paymentRepository.updatePaymentVerification(razorpay_order_id, {\n      razorpayPaymentId: razorpay_payment_id,\n      razorpaySignature: razorpay_signature,\n      status: \"COMPLETED\",\n    });\n\n    // Finalize the booking (atomic tickets → SUCCESS + booking → PAID + discount + email)\n    const result = await this.finalizer.finalizePaidBooking(bookingId);\n\n    // Team confirmation: if any tickets in this booking belong to a team,\n    // mirror the team-confirmation logic from the ticket-based verify path.\n    await this.finalizer.confirmTeamFromBookingResult(bookingId, result);\n\n    return result;\n  }\n}\n","numLines":407,"startLine":1,"totalLines":407}},"tool_result_meta":[{"id":"call-968d7968-b579-4e90-abdd-1e94fc60983a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
