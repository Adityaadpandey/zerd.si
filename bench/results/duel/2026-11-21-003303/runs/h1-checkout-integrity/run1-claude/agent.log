{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-4d7381ed-6a06-4da4-b5b7-18d264abdd65","type":"tool_result","content":"=== revenue.util ===\n/**\n * Revenue utilities — canonical read-side helpers.\n *\n * Single source of truth for all analytics and payout reads.\n * Pure functions; take aggregated numbers as arguments (callers\n * are responsible for querying/summing from DB).\n *\n * Spec §4 Layer 1: net refunds via Refund table columns.\n * Coupon discounts are already baked into the stored hostNet / fee snapshots.\n *\n * Invariant: for any paid booking\n *   hostNet + platformFee + gst + gatewayFee == buyerPaid (±0.01)\n */\n\nimport { fromPaise, toPaise } from \"./money.util\";\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/**\n * Aggregated booking-level money fields for a cohort of PAID bookings.\n * These are sums of the snapshot columns, not recomputed from face values.\n */\nexport interface BookingAggregate {\n  /** Σ Ticket.hostNet (or derived: booking.total - platformFee - gst - gatewayFee) */\n  totalHostNet: number;\n  /** Σ Booking.platformFee (Tunyt's cut) */\n  totalPlatformFee: number;\n  /** Σ Booking.gst (GST on platform fee) */\n  totalGst: number;\n  /** Σ Booking.gatewayFee (Razorpay's cut) */\n  totalGatewayFee: number;\n}\n\n/**\n * Aggregated refund columns from the Refund table.\n * Only APPROVED/PROCESSED refunds should be included.\n */\nexport interface RefundAggregate {\n  /** Σ Refund.amount (total rupees returned to buyer) */\n  amount: number;\n  /** Σ Refund.platformFeeRefund (fee portion added back to host's share) */\n  platformFeeRefund: number;\n  /** Σ Refund.gatewayFeeRefund (fee portion added back to host's share) */\n  gatewayFeeRefund: number;\n}\n\n// ---------------------------------------------------------------------------\n// netHostRevenue\n// ---------------------------------------------------------------------------\n\n/**\n * Net revenue the host actually earned after refunds.\n *\n * Formula (spec §4):\n *   netRevenue = paidHostNet − Σ refund.amount\n *                            + Σ refund.platformFeeRefund\n *                            + Σ refund.gatewayFeeRefund\n *\n * Fee-refund add-backs: when Tunyt/Razorpay refund their fees back to the\n * host (as part of a partial refund) those amounts increase host's net.\n */\nexport function netHostRevenue(\n  booking: BookingAggregate,\n  refund: RefundAggregate,\n): number {\n  return fromPaise(\n    toPaise(booking.totalHostNet) -\n      toPaise(refund.amount) +\n      toPaise(refund.platformFeeRefund) +\n      toPaise(refund.gatewayFeeRefund),\n  );\n}\n\n// ---------------------------------------------------------------------------\n// platformEarnings\n// ---------------------------------------------------------------------------\n\n/**\n * Tunyt's net platform earnings after fee refunds.\n *\n * Uses platformFee snapshots, never totalPrice or subtotal.\n */\nexport function platformEarnings(\n  booking: BookingAggregate,\n  refund: RefundAggregate,\n): number {\n  return fromPaise(\n    toPaise(booking.totalPlatformFee) - toPaise(refund.platformFeeRefund),\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Convenience: hostNetFromBookingRow\n// ---------------------------------------------------------------------------\n\n/**\n * Derive per-booking hostNet from stored snapshot columns.\n * Useful when the Ticket.hostNet column is not yet present (pre-migration bookings).\n *\n * HOST mode: buyerPaid − platformFee − gst − gatewayFee\n * USER mode: buyerPaid − platformFee − gst − gatewayFee  (same formula; hostNet == netFace)\n */\nexport function hostNetFromBookingRow(booking: {\n  total: number;\n  platformFee: number;\n  gst: number;\n  gatewayFee: number;\n}): number {\n  return fromPaise(\n    toPaise(booking.total) -\n      toPaise(booking.platformFee) -\n      toPaise(booking.gst) -\n      toPaise(booking.gatewayFee),\n  );\n}\n=== approval service expiry ===\n35:   *  - Booking is persisted in PENDING_APPROVAL status with no payment record.\n39:   *    via the existing Guests dashboard (PENDING_APPROVAL bookings surface\n110:    const holdExpiresAt = new Date(\n123:      holdExpiresAt,\n176:      holdExpiresAt: found.holdExpiresAt,","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"e783eb6e-20f6-4460-a35f-4300b199289c","timestamp":"2026-11-20T19:23:39.319Z","tool_use_result":{"stdout":"=== revenue.util ===\n/**\n * Revenue utilities — canonical read-side helpers.\n *\n * Single source of truth for all analytics and payout reads.\n * Pure functions; take aggregated numbers as arguments (callers\n * are responsible for querying/summing from DB).\n *\n * Spec §4 Layer 1: net refunds via Refund table columns.\n * Coupon discounts are already baked into the stored hostNet / fee snapshots.\n *\n * Invariant: for any paid booking\n *   hostNet + platformFee + gst + gatewayFee == buyerPaid (±0.01)\n */\n\nimport { fromPaise, toPaise } from \"./money.util\";\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/**\n * Aggregated booking-level money fields for a cohort of PAID bookings.\n * These are sums of the snapshot columns, not recomputed from face values.\n */\nexport interface BookingAggregate {\n  /** Σ Ticket.hostNet (or derived: booking.total - platformFee - gst - gatewayFee) */\n  totalHostNet: number;\n  /** Σ Booking.platformFee (Tunyt's cut) */\n  totalPlatformFee: number;\n  /** Σ Booking.gst (GST on platform fee) */\n  totalGst: number;\n  /** Σ Booking.gatewayFee (Razorpay's cut) */\n  totalGatewayFee: number;\n}\n\n/**\n * Aggregated refund columns from the Refund table.\n * Only APPROVED/PROCESSED refunds should be included.\n */\nexport interface RefundAggregate {\n  /** Σ Refund.amount (total rupees returned to buyer) */\n  amount: number;\n  /** Σ Refund.platformFeeRefund (fee portion added back to host's share) */\n  platformFeeRefund: number;\n  /** Σ Refund.gatewayFeeRefund (fee portion added back to host's share) */\n  gatewayFeeRefund: number;\n}\n\n// ---------------------------------------------------------------------------\n// netHostRevenue\n// ---------------------------------------------------------------------------\n\n/**\n * Net revenue the host actually earned after refunds.\n *\n * Formula (spec §4):\n *   netRevenue = paidHostNet − Σ refund.amount\n *                            + Σ refund.platformFeeRefund\n *                            + Σ refund.gatewayFeeRefund\n *\n * Fee-refund add-backs: when Tunyt/Razorpay refund their fees back to the\n * host (as part of a partial refund) those amounts increase host's net.\n */\nexport function netHostRevenue(\n  booking: BookingAggregate,\n  refund: RefundAggregate,\n): number {\n  return fromPaise(\n    toPaise(booking.totalHostNet) -\n      toPaise(refund.amount) +\n      toPaise(refund.platformFeeRefund) +\n      toPaise(refund.gatewayFeeRefund),\n  );\n}\n\n// ---------------------------------------------------------------------------\n// platformEarnings\n// ---------------------------------------------------------------------------\n\n/**\n * Tunyt's net platform earnings after fee refunds.\n *\n * Uses platformFee snapshots, never totalPrice or subtotal.\n */\nexport function platformEarnings(\n  booking: BookingAggregate,\n  refund: RefundAggregate,\n): number {\n  return fromPaise(\n    toPaise(booking.totalPlatformFee) - toPaise(refund.platformFeeRefund),\n  );\n}\n\n// ---------------------------------------------------------------------------\n// Convenience: hostNetFromBookingRow\n// ---------------------------------------------------------------------------\n\n/**\n * Derive per-booking hostNet from stored snapshot columns.\n * Useful when the Ticket.hostNet column is not yet present (pre-migration bookings).\n *\n * HOST mode: buyerPaid − platformFee − gst − gatewayFee\n * USER mode: buyerPaid − platformFee − gst − gatewayFee  (same formula; hostNet == netFace)\n */\nexport function hostNetFromBookingRow(booking: {\n  total: number;\n  platformFee: number;\n  gst: number;\n  gatewayFee: number;\n}): number {\n  return fromPaise(\n    toPaise(booking.total) -\n      toPaise(booking.platformFee) -\n      toPaise(booking.gst) -\n      toPaise(booking.gatewayFee),\n  );\n}\n=== approval service expiry ===\n35:   *  - Booking is persisted in PENDING_APPROVAL status with no payment record.\n39:   *    via the existing Guests dashboard (PENDING_APPROVAL bookings surface\n110:    const holdExpiresAt = new Date(\n123:      holdExpiresAt,\n176:      holdExpiresAt: found.holdExpiresAt,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call-4d7381ed-6a06-4da4-b5b7-18d264abdd65","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
