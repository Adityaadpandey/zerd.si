enue.venueId, name: \"Court\", activityType: \"TENNIS\",\n      maxPlayers: 4, baseRatePerHour: 100, pricingMatrix: {}, operatingHours: {},\n    },\n  });\n  const unit = await prisma.resourceUnit.create({\n    data: { resourceId: resource.resourceId, label: \"Unit 1\" },\n  });\n  return { venueId: venue.venueId, resourceId: resource.resourceId, unitId: unit.unitId };\n}\n\nconst at = (h: number, m: number) => new Date(Date.UTC(2030, 0, 1, h, m, 0, 0));\n\ntest(\"exclusion constraint rejects an overlapping HELD row on the same unit\", async () => {\n  const s = await seedUnit();\n  await prisma.venueSlot.create({\n    data: {\n      resourceId: s.resourceId, unitId: s.unitId, venueId: s.venueId,\n      startTime: at(1, 20), endTime: at(2, 30), status: \"HELD\",\n    },\n  });\n  // Overlaps [1:20,2:30) — different startTime, so unique passes but exclusion must reject.\n  await expect(\n    prisma.venueSlot.create({\n      data: {\n        resourceId: s.resourceId, unitId: s.unitId, venueId: s.venueId,\n        startTime: at(2, 0), endTime: at(3, 0), status: \"HELD\",\n      },\n    }),\n  ).rejects.toThrow();\n});\n\ntest(\"exclusion constraint allows a touching, non-overlapping row\", async () => {\n  const s = await seedUnit();\n  await prisma.venueSlot.create({\n    data: {\n      resourceId: s.resourceId, unitId: s.unitId, venueId: s.venueId,\n      startTime: at(1, 20), endTime: at(2, 30), status: \"HELD\",\n    },\n  });\n  const ok = await prisma.venueSlot.create({\n    data: {","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"e4b986b0-b9f9-4f69-84f4-f4245674c9a5","timestamp":"2026-11-20T19:36:07.463Z","tool_use_result":{"stdout":"=== how specs handle prisma ===\n/**\n * Regression coverage for Task 8: a walk-in hold with an off-grid end must\n * consume PACKAGE minutes against the raw CHARGED span (rawEndTime -\n * startTime), never the rounded occupancy span (VenueSlot/SlotBooking\n * `endTime`) that