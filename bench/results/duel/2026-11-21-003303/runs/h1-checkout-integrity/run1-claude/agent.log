{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-29491ac5-8381-4fd9-995f-e9e405364173","type":"tool_result","content":"1\t/**\n2\t * Money utilities — integer-paise arithmetic.\n3\t *\n4\t * Money is computed in INTEGER PAISE (1 rupee = 100 paise) to eliminate\n5\t * floating-point drift. Rupee `number`s only ever appear at the boundary\n6\t * (input from the DB/UI, output for storage/display). Rounding happens once,\n7\t * at the conversion to paise, because paise is the smallest unit money can\n8\t * actually move in (gateways settle in integer paise).\n9\t *\n10\t * Rules:\n11\t *  - Never do `a + b` / `a * pct` on rupee floats in money paths — convert to\n12\t *    paise first with toPaise(), compute with integers, convert back with\n13\t *    fromPaise() at the very end.\n14\t *  - Percentages stay as fractions (e.g. 0.025) and are applied to a paise\n15\t *    integer, then rounded to the nearest paise with roundPaise().\n16\t */\n17\t\n18\t/** Rupees (float) → integer paise. Single, deterministic rounding point. */\n19\texport function toPaise(rupees: number): number {\n20\t  return Math.round(rupees * 100);\n21\t}\n22\t\n23\t/** Integer paise → rupees (exact 2-dp value). */\n24\texport function fromPaise(paise: number): number {\n25\t  return paise / 100;\n26\t}\n27\t\n28\t/**\n29\t * Apply a fractional rate to a paise amount and round to the nearest paise.\n30\t * e.g. paiseTimesRate(90000, 0.025) === 2250  (₹900 × 2.5% = ₹22.50)\n31\t */\n32\texport function paiseTimesRate(paise: number, rate: number): number {\n33\t  return Math.round(paise * rate);\n34\t}\n35\t\n36\t/** Add two rupee floats via the paise grid (no float drift). */\n37\texport function addRupees(a: number, b: number): number {\n38\t  return fromPaise(toPaise(a) + toPaise(b));\n39\t}\n40\t\n41\t/** Subtract two rupee floats via the paise grid (no float drift). */\n42\texport function subtractRupees(a: number, b: number): number {\n43\t  return fromPaise(toPaise(a) - toPaise(b));\n44\t}\n45\t\n46\t/** Clamp a rupee float to ≥ 0 via the paise grid. */\n47\texport function clampNonNegativeRupees(n: number): number {\n48\t  return fromPaise(Math.max(toPaise(n), 0));\n49\t}\n50\t\n51\t/** Round a rupee float to 2 dp via the paise grid (legacy-compatible). */\n52\texport const round2 = (n: number): number => fromPaise(toPaise(n));\n53\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"002870d4-b129-4e7b-b5a4-952ae09281b1","timestamp":"2026-11-20T19:06:12.489Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/utils/money.util.ts","content":"/**\n * Money utilities — integer-paise arithmetic.\n *\n * Money is computed in INTEGER PAISE (1 rupee = 100 paise) to eliminate\n * floating-point drift. Rupee `number`s only ever appear at the boundary\n * (input from the DB/UI, output for storage/display). Rounding happens once,\n * at the conversion to paise, because paise is the smallest unit money can\n * actually move in (gateways settle in integer paise).\n *\n * Rules:\n *  - Never do `a + b` / `a * pct` on rupee floats in money paths — convert to\n *    paise first with toPaise(), compute with integers, convert back with\n *    fromPaise() at the very end.\n *  - Percentages stay as fractions (e.g. 0.025) and are applied to a paise\n *    integer, then rounded to the nearest paise with roundPaise().\n */\n\n/** Rupees (float) → integer paise. Single, deterministic rounding point. */\nexport function toPaise(rupees: number): number {\n  return Math.round(rupees * 100);\n}\n\n/** Integer paise → rupees (exact 2-dp value). */\nexport function fromPaise(paise: number): number {\n  return paise / 100;\n}\n\n/**\n * Apply a fractional rate to a paise amount and round to the nearest paise.\n * e.g. paiseTimesRate(90000, 0.025) === 2250  (₹900 × 2.5% = ₹22.50)\n */\nexport function paiseTimesRate(paise: number, rate: number): number {\n  return Math.round(paise * rate);\n}\n\n/** Add two rupee floats via the paise grid (no float drift). */\nexport function addRupees(a: number, b: number): number {\n  return fromPaise(toPaise(a) + toPaise(b));\n}\n\n/** Subtract two rupee floats via the paise grid (no float drift). */\nexport function subtractRupees(a: number, b: number): number {\n  return fromPaise(toPaise(a) - toPaise(b));\n}\n\n/** Clamp a rupee float to ≥ 0 via the paise grid. */\nexport function clampNonNegativeRupees(n: number): number {\n  return fromPaise(Math.max(toPaise(n), 0));\n}\n\n/** Round a rupee float to 2 dp via the paise grid (legacy-compatible). */\nexport const round2 = (n: number): number => fromPaise(toPaise(n));\n","numLines":53,"startLine":1,"totalLines":53}},"tool_result_meta":[{"id":"call-29491ac5-8381-4fd9-995f-e9e405364173","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-7985c638-4a2e-46da-93de-d81b56c648dc","type":"tool_result","content":"1\timport { prisma } from \"../config/db\";\n2\timport type { PaymentStatus } from \"../types/payment.types\";\n3\timport { PAYMENT_SELECT } from \"../types/payment.types\";\n4\timport { applyCashClawback } from \"../utils/cash-clawback.util\";\n5\timport { wrapDatabaseOperation } from \"../utils/database-error-handler.util\";\n6\timport {\n7\t  type BookingAggregate,\n8\t  netHostRevenue,\n9\t  platformEarnings,\n10\t  type RefundAggregate,\n11\t} from \"../utils/revenue.util\";\n12\timport { sumCashFeesOwed } from \"./cash-sale.repository\";\n13\t\n14\t/**\n15\t * Payment Repository\n16\t * Handles database operations for payments\n17\t */\n18\texport class PaymentRepository {\n19\t  /**\n20\t   * Create payment record\n21\t   */\n22\t  async create(data: {\n23\t    userId: string;\n24\t    eventId: string;\n25\t    razorpayOrderId: string;\n26\t    amount: number;\n27\t    platformFee: number;\n28\t    /** 18% GST on platform fee */\n29\t    gst?: number;\n30\t    listerRevenue: number;\n31\t    receiptId: string;\n32\t    currency?: string;\n33\t    listerRazorpayConfigId?: string;\n34\t    ticketIds?: string[];\n35\t  }) {\n36\t    return wrapDatabaseOperation(async () => {\n37\t      return await prisma.payment.create({\n38\t        data: {\n39\t          userId: data.userId,\n40\t          eventId: data.eventId,\n41\t          razorpayOrderId: data.razorpayOrderId,\n42\t          amount: data.amount,\n43\t          platformFee: data.platformFee,\n44\t          gst: data.gst ?? 0,\n45\t          listerRevenue: data.listerRevenue,\n46\t          receiptId: data.receiptId,\n47\t          currency: data.currency || \"INR\",\n48\t          status: \"PENDING\",\n49\t          listerRazorpayConfigId: data.listerRazorpayConfigId ?? null,\n50\t          notes: data.ticketIds\n51\t            ? { ticketIds: data.ticketIds.join(\",\") }\n52\t            : undefined,\n53\t        },\n54\t        select: PAYMENT_SELECT,\n55\t      });\n56\t    }, \"Create payment record\");\n57\t  }\n58\t\n59\t  /**\n60\t   * Find payment by Razorpay order ID\n61\t   */\n62\t  async findByRazorpayOrderId(razorpayOrderId: string) {\n63\t    return wrapDatabaseOperation(async () => {\n64\t      return await prisma.payment.findUnique({\n65\t        where: { razorpayOrderId },\n66\t        select: PAYMENT_SELECT,\n67\t      });\n68\t    }, \"Find payment by Razorpay order ID\");\n69\t  }\n70\t\n71\t  /** Leave a note on a Payment that needs a human to look at it (for example a refund by hand). */\n72\t  async flagForReconciliation(razorpayOrderId: string, reason: string) {\n73\t    return wrapDatabaseOperation(\n74\t      () =>\n75\t        prisma.payment.update({\n76\t          where: { razorpayOrderId },\n77\t          data: { notes: { reconcile: reason } },\n78\t          select: { paymentId: true },\n79\t        }),\n80\t      \"Flag payment for reconciliation\",\n81\t    );\n82\t  }\n83\t\n84\t  /**\n85\t   * Update payment with verification details\n86\t   */\n87\t  async updatePaymentVerification(\n88\t    razorpayOrderId: string,\n89\t    data: {\n90\t      razorpayPaymentId: string;\n91\t      razorpaySignature: string;\n92\t      status: PaymentStatus;\n93\t      method?: string;\n94\t      failureReason?: string;\n95\t    },\n96\t  ) {\n97\t    return wrapDatabaseOperation(async () => {\n98\t      return await prisma.payment.update({\n99\t        where: { razorpayOrderId },\n100\t        data: {\n101\t          razorpayPaymentId: data.razorpayPaymentId,\n102\t          razorpaySignature: data.razorpaySignature,\n103\t          status: data.status,\n104\t          method: data.method,\n105\t          failureReason: data.failureReason,\n106\t          completedAt: data.status === \"COMPLETED\" ? new Date() : null,\n107\t          failedAt: data.status === \"FAILED\" ? new Date() : null,\n108\t        },\n109\t        select: PAYMENT_SELECT,\n110\t      });\n111\t    }, \"Update payment verification\");\n112\t  }\n113\t\n114\t  /**\n115\t   * Get payment by ID\n116\t   */\n117\t  async findById(paymentId: string) {\n118\t    return wrapDatabaseOperation(async () => {\n119\t      return await prisma.payment.findUnique({\n120\t        where: { paymentId },\n121\t        select: PAYMENT_SELECT,\n122\t      });\n123\t    }, \"Find payment by ID\");\n124\t  }\n125\t\n126\t  /**\n127\t   * Lightweight booking lookup for fee math (refunds, breakdowns).\n128\t   * Returns the stored money fields only.\n129\t   */\n130\t  async findBookingById(bookingId: string) {\n131\t    return wrapDatabaseOperation(async () => {\n132\t      return await prisma.booking.findUnique({\n133\t        where: { bookingId },\n134\t        select: {\n135\t          bookingId: true,\n136\t          eventId: true,\n137\t          subtotal: true,\n138\t          platformFee: true,\n139\t          gatewayFee: true,\n140\t          feesBornBy: true,\n141\t          total: true,\n142\t          status: true,\n143\t        },\n144\t      });\n145\t    }, \"Find booking by ID (lite)\");\n146\t  }\n147\t\n148\t  /**\n149\t   * Get payments by user\n150\t   */\n151\t  async findByUserId(userId: string, page: number = 1, limit: number = 20) {\n152\t    return wrapDatabaseOperation(async () => {\n153\t      const where = { userId };\n154\t      const [items, total] = await Promise.all([\n155\t        prisma.payment.findMany({\n156\t          where,\n157\t          select: PAYMENT_SELECT,\n158\t          orderBy: { createdAt: \"desc\" },\n159\t          skip: (page - 1) * limit,\n160\t          take: limit,\n161\t        }),\n162\t        prisma.payment.count({ where }),\n163\t      ]);\n164\t      return {\n165\t        items,\n166\t        total,\n167\t        page,\n168\t        limit,\n169\t        totalPages: Math.ceil(total / limit),\n170\t      };\n171\t    }, \"Find payments by user ID\");\n172\t  }\n173\t\n174\t  /**\n175\t   * Get payments by event (for lister/admin)\n176\t   */\n177\t  async findByEventId(eventId: string, page: number = 1, limit: number = 50) {\n178\t    return wrapDatabaseOperation(async () => {\n179\t      const where = { eventId };\n180\t      const [items, total] = await Promise.all([\n181\t        prisma.payment.findMany({\n182\t          where,\n183\t          select: PAYMENT_SELECT,\n184\t          orderBy: { createdAt: \"desc\" },\n185\t          skip: (page - 1) * limit,\n186\t          take: limit,\n187\t        }),\n188\t        prisma.payment.count({ where }),\n189\t      ]);\n190\t      return {\n191\t        items,\n192\t        total,\n193\t        page,\n194\t        limit,\n195\t        totalPages: Math.ceil(total / limit),\n196\t      };\n197\t    }, \"Find payments by event ID\");\n198\t  }\n199\t\n200\t  /**\n201\t   * Find the most recent payment for a given event+user pair.\n202\t   * Used by the refund service to locate the razorpay payment ID for a ticket.\n203\t   */\n204\t  async findByEventAndUser(eventId: string, userId: string) {\n205\t    return wrapDatabaseOperation(async () => {\n206\t      return await prisma.payment.findFirst({\n207\t        where: { eventId, userId },\n208\t        select: PAYMENT_SELECT,\n209\t        orderBy: { createdAt: \"desc\" },\n210\t      });\n211\t    }, \"Find payment by event and user\");\n212\t  }\n213\t\n214\t  /**\n215\t   * Update payment with comprehensive Razorpay data\n216\t   */\n217\t  async updateWithRazorpayData(\n218\t    razorpayOrderId: string,\n219\t    razorpayPayment: any,\n220\t    razorpaySignature: string,\n221\t  ) {\n222\t    return wrapDatabaseOperation(async () => {\n223\t      return await prisma.payment.update({\n224\t        where: { razorpayOrderId },\n225\t        data: {\n226\t          razorpayPaymentId: razorpayPayment.id,\n227\t          razorpaySignature,\n228\t          status: \"COMPLETED\",\n229\t          method: razorpayPayment.method,\n230\t          methodType: razorpayPayment.method,\n231\t          // Card details\n232\t          cardLast4: razorpayPayment.card?.last4,\n233\t          cardNetwork: razorpayPayment.card?.network,\n234\t          cardType: razorpayPayment.card?.type,\n235\t          // Bank/Wallet details\n236\t          bank: razorpayPayment.bank || null,\n237\t          wallet: razorpayPayment.wallet || null,\n238\t          vpa: razorpayPayment.vpa || null,\n239\t          // Contact info\n240\t          email: razorpayPayment.email,\n241\t          contact: razorpayPayment.contact,\n242\t          // Full Razorpay response\n243\t          razorpayData: razorpayPayment,\n244\t          // Timestamps\n245\t          completedAt: new Date(),\n246\t        },\n247\t        select: PAYMENT_SELECT,\n248\t      });\n249\t    }, \"Update payment with Razorpay data\");\n250\t  }\n251\t\n252\t  /**\n253\t   * Update payment as failed\n254\t   */\n255\t  async markAsFailed(\n256\t    razorpayOrderId: string,\n257\t    failureData: {\n258\t      failureReason?: string;\n259\t      errorCode?: string;\n260\t      errorSource?: string;\n261\t      errorStep?: string;\n262\t    },\n263\t  ) {\n264\t    return wrapDatabaseOperation(async () => {\n265\t      return await prisma.payment.update({\n266\t        where: { razorpayOrderId },\n267\t        data: {\n268\t          status: \"FAILED\",\n269\t          failureReason: failureData.failureReason,\n270\t          errorCode: failureData.errorCode,\n271\t          errorSource: failureData.errorSource,\n272\t          errorStep: failureData.errorStep,\n273\t          failedAt: new Date(),\n274\t          attempts: { increment: 1 },\n275\t        },\n276\t        select: PAYMENT_SELECT,\n277\t      });\n278\t    }, \"Mark payment as failed\");\n279\t  }\n280\t\n281\t  /**\n282\t   * Find payment by bookingId\n283\t   */\n284\t  async findByBookingId(bookingId: string) {\n285\t    return wrapDatabaseOperation(async () => {\n286\t      return await prisma.payment.findUnique({\n287\t        where: { bookingId },\n288\t        select: PAYMENT_SELECT,\n289\t      });\n290\t    }, \"Find payment by booking ID\");\n291\t  }\n292\t\n293\t  /**\n294\t   * Upsert a Payment row keyed on bookingId.\n295\t   * Creates if none exists; updates razorpayOrderId + amount + fee breakdown if one does.\n296\t   */\n297\t  async upsertForBooking(data: {\n298\t    userId: string;\n299\t    eventId: string;\n300\t    bookingId: string;\n301\t    razorpayOrderId: string;\n302\t    amount: number;\n303\t    platformFee: number;\n304\t    listerRevenue: number;\n305\t    receiptId: string;\n306\t    currency?: string;\n307\t    listerRazorpayConfigId?: string;\n308\t  }) {\n309\t    return wrapDatabaseOperation(async () => {\n310\t      return await prisma.payment.upsert({\n311\t        where: { bookingId: data.bookingId },\n312\t        create: {\n313\t          userId: data.userId,\n314\t          eventId: data.eventId,\n315\t          bookingId: data.bookingId,\n316\t          razorpayOrderId: data.razorpayOrderId,\n317\t          amount: data.amount,\n318\t          platformFee: data.platformFee,\n319\t          listerRevenue: data.listerRevenue,\n320\t          receiptId: data.receiptId,\n321\t          currency: data.currency ?? \"INR\",\n322\t          status: \"PENDING\",\n323\t          listerRazorpayConfigId: data.listerRazorpayConfigId ?? null,\n324\t        },\n325\t        update: {\n326\t          razorpayOrderId: data.razorpayOrderId,\n327\t          amount: data.amount,\n328\t          platformFee: data.platformFee,\n329\t          listerRevenue: data.listerRevenue,\n330\t          status: \"PENDING\",\n331\t        },\n332\t        select: PAYMENT_SELECT,\n333\t      });\n334\t    }, \"Upsert payment for booking\");\n335\t  }\n336\t\n337\t  /**\n338\t   * Calculate revenue split for an event.\n339\t   *\n340\t   * Basis: stored Booking snapshot columns (platformFee, gst, gatewayFee, total).\n341\t   * Coupon is already baked in at booking time — do NOT recompute from TicketType\n342\t   * config (which ignores discountAmount and uses stale fee config).\n343\t   * Refunds are netted via the Refund table (spec §2 decision 9).\n344\t   */\n345\t  async calculateEventRevenue(eventId: string) {\n346\t    return wrapDatabaseOperation(async () => {\n347\t      const [bookingAgg, refundAgg, ticketsSoldAgg] = await Promise.all([\n348\t        // Sum of stored snapshots for PAID bookings.\n349\t        // hostNet = total − platformFee − gst − gatewayFee.\n350\t        prisma.booking.aggregate({\n351\t          _sum: { total: true, platformFee: true, gst: true, gatewayFee: true },\n352\t          where: { eventId, status: \"PAID\", paymentMode: \"ONLINE\" },\n353\t        }),\n354\t        // Refund netting: APPROVED + PROCESSING + COMPLETED refunds.\n355\t        prisma.refund.aggregate({\n356\t          _sum: { amount: true, platformFeeRefund: true, gatewayFeeRefund: true },\n357\t          where: {\n358\t            eventId,\n359\t            // FAILED included: an approved refund whose gateway attempt broke\n360\t            // is still owed to the buyer, not money the host can be paid on.\n361\t            status: { in: [\"APPROVED\", \"PROCESSING\", \"COMPLETED\", \"FAILED\"] },\n362\t            // Online bookings only: orphaned tickets and cash-sale refunds were\n363\t            // never part of the booking aggregate above.\n364\t            ticket: { booking: { is: { paymentMode: \"ONLINE\" } } },\n365\t          },\n366\t        }),\n367\t        prisma.ticket.aggregate({\n368\t          _sum: { quantity: true },\n369\t          where: { eventId, status: \"SUCCESS\" },\n370\t        }),\n371\t      ]);\n372\t\n373\t      const total = bookingAgg._sum.total ?? 0;\n374\t      const totalPlatformFee = bookingAgg._sum.platformFee ?? 0;\n375\t      const totalGst = bookingAgg._sum.gst ?? 0;\n376\t      const totalGatewayFee = bookingAgg._sum.gatewayFee ?? 0;\n377\t\n378\t      // Build canonical aggregates for revenue.util (spec §4 Layer 1).\n379\t      // totalHostNet = Σ (total − platformFee − gst − gatewayFee): universal for HOST + USER.\n380\t      let bookingAggregate: BookingAggregate = {\n381\t        totalHostNet: total - totalPlatformFee - totalGst - totalGatewayFee,\n382\t        totalPlatformFee,\n383\t        totalGst,\n384\t        totalGatewayFee,\n385\t      };\n386\t      bookingAggregate = applyCashClawback(bookingAggregate, await sumCashFeesOwed({ eventId }));\n387\t      const refundAggregate: RefundAggregate = {\n388\t        amount: refundAgg._sum.amount ?? 0,\n389\t        platformFeeRefund: refundAgg._sum.platformFeeRefund ?? 0,\n390\t        gatewayFeeRefund: refundAgg._sum.gatewayFeeRefund ?? 0,\n391\t      };\n392\t\n393\t      // Canonical helper calls — single source of truth (spec §4 Layer 2).\n394\t      const listerRevenue = netHostRevenue(bookingAggregate, refundAggregate);\n395\t      const netPlatformFee = platformEarnings(bookingAggregate, refundAggregate);\n396\t\n397\t      return {\n398\t        eventId,\n399\t        totalRevenue: bookingAggregate.totalHostNet, // host gross before refunds\n400\t        platformFee: netPlatformFee,                 // net platform earnings (after fee refunds)\n401\t        gatewayFee: totalGatewayFee,\n402\t        listerRevenue,                               // host net after refunds\n403\t        ticketsSold: Number(ticketsSoldAgg._sum.quantity ?? 0),\n404\t      };\n405\t    }, \"Calculate event revenue\");\n406\t  }\n407\t\n408\t  /**\n409\t   * Calculate revenue split for a lister.\n410\t   *\n411\t   * Basis: stored Ticket snapshot columns (totalPrice, platformFee, gst, gatewayFee).\n412\t   * hostNet per seat = totalPrice − platformFee − gst − gatewayFee (spec §4 Layer 1).\n413\t   * Coupon is baked into the fee snapshots at booking time — never recompute from\n414\t   * TicketType config (which ignores discountAmount and may have stale rates).\n415\t   * Refunds are netted from the Refund table (spec §2 decision 9).\n416\t   */\n417\t  async calculateListerRevenue(listerId: string) {\n418\t    return wrapDatabaseOperation(async () => {\n419\t      const [result, refundResult, eventCount] = await Promise.all([\n420\t        // Stored Ticket snapshots — correct for coupon + early-bird + HOST/USER mode.\n421\t        // hostNet = totalPrice − platformFee − gst − gatewayFee per seat.\n422\t        prisma.$queryRaw<\n423\t          Array<{\n424\t            totalRevenue: number;\n425\t            platformFee: number;\n426\t            gst: number;\n427\t            gatewayFee: number;\n428\t            ticketsSold: bigint;\n429\t          }>\n430\t        >`\n431\t          SELECT\n432\t            COALESCE(SUM(t.\"totalPrice\" - t.\"platformFee\" - t.\"gst\" - t.\"gatewayFee\"), 0)::float AS \"totalRevenue\",\n433\t            COALESCE(SUM(t.\"platformFee\"), 0)::float AS \"platformFee\",\n434\t            COALESCE(SUM(t.\"gst\"), 0)::float AS \"gst\",\n435\t            COALESCE(SUM(t.\"gatewayFee\"), 0)::float AS \"gatewayFee\",\n436\t            COALESCE(SUM(t.\"quantity\"), 0) AS \"ticketsSold\"\n437\t          FROM \"Ticket\" t\n438\t          JOIN \"Event\" e ON e.\"eventId\" = t.\"eventId\"\n439\t          WHERE e.\"listerId\" = ${listerId}::uuid\n440\t            AND t.\"status\" = 'SUCCESS'\n441\t        `,\n442\t        // Refund netting: APPROVED + PROCESSING + COMPLETED refunds for this lister.\n443\t        prisma.$queryRaw<\n444\t          Array<{\n445\t            refundAmount: number;\n446\t            platformFeeRefund: number;\n447\t            gatewayFeeRefund: number;\n448\t          }>\n449\t        >`\n450\t          SELECT\n451\t            COALESCE(SUM(r.\"amount\"), 0)::float AS \"refundAmount\",\n452\t            COALESCE(SUM(r.\"platformFeeRefund\"), 0)::float AS \"platformFeeRefund\",\n453\t            COALESCE(SUM(r.\"gatewayFeeRefund\"), 0)::float AS \"gatewayFeeRefund\"\n454\t          FROM \"Refund\" r\n455\t          JOIN \"Event\" e ON e.\"eventId\" = r.\"eventId\"\n456\t          WHERE e.\"listerId\" = ${listerId}::uuid\n457\t            AND r.\"status\" IN ('APPROVED', 'PROCESSING', 'COMPLETED')\n458\t        `,\n459\t        prisma.event.count({ where: { listerId } }),\n460\t      ]);\n461\t\n462\t      const row = result[0] ?? {\n463\t        totalRevenue: 0,\n464\t        platformFee: 0,\n465\t        gst: 0,\n466\t        gatewayFee: 0,\n467\t        ticketsSold: 0n,\n468\t      };\n469\t      const refRow = refundResult[0] ?? {\n470\t        refundAmount: 0,\n471\t        platformFeeRefund: 0,\n472\t        gatewayFeeRefund: 0,\n473\t      };\n474\t\n475\t      // Build canonical aggregates for revenue.util (spec §4 Layer 2).\n476\t      // SQL already derived totalRevenue = Σ (totalPrice − platformFee − gst − gatewayFee).\n477\t      const bookingAggregate: BookingAggregate = {\n478\t        totalHostNet: Number(row.totalRevenue),\n479\t        totalPlatformFee: Number(row.platformFee),\n480\t        totalGst: 0, // gst already baked into totalRevenue derivation above\n481\t        totalGatewayFee: Number(row.gatewayFee ?? 0),\n482\t      };\n483\t      const refundAggregate: RefundAggregate = {\n484\t        amount: Number(refRow.refundAmount),\n485\t        platformFeeRefund: Number(refRow.platformFeeRefund),\n486\t        gatewayFeeRefund: Number(refRow.gatewayFeeRefund),\n487\t      };\n488\t\n489\t      // Canonical helper calls — single source of truth (spec §4 Layer 2).\n490\t      const listerRevenue = netHostRevenue(bookingAggregate, refundAggregate);\n491\t      const netPlatformFee = platformEarnings(bookingAggregate, refundAggregate);\n492\t\n493\t      return {\n494\t        listerId,\n495\t        totalRevenue: bookingAggregate.totalHostNet, // host gross before refunds\n496\t        platformFee: netPlatformFee,                 // net platform earnings (after fee refunds)\n497\t        gatewayFee: bookingAggregate.totalGatewayFee,\n498\t        listerRevenue,\n499\t        ticketsSold: Number(row.ticketsSold),\n500\t        eventCount,\n501\t      };\n502\t    }, \"Calculate lister revenue\");\n503\t  }\n504\t}\n505\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"ee636500-a597-4fb9-9c1c-393a1f0f49ab","timestamp":"2026-11-20T19:06:12.723Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/repositories/payment.repository.ts","content":"import { prisma } from \"../config/db\";\nimport type { PaymentStatus } from \"../types/payment.types\";\nimport { PAYMENT_SELECT } from \"../types/payment.types\";\nimport { applyCashClawback } from \"../utils/cash-clawback.util\";\nimport { wrapDatabaseOperation } from \"../utils/database-error-handler.util\";\nimport {\n  type BookingAggregate,\n  netHostRevenue,\n  platformEarnings,\n  type RefundAggregate,\n} from \"../utils/revenue.util\";\nimport { sumCashFeesOwed } from \"./cash-sale.repository\";\n\n/**\n * Payment Repository\n * Handles database operations for payments\n */\nexport class PaymentRepository {\n  /**\n   * Create payment record\n   */\n  async create(data: {\n    userId: string;\n    eventId: string;\n    razorpayOrderId: string;\n    amount: number;\n    platformFee: number;\n    /** 18% GST on platform fee */\n    gst?: number;\n    listerRevenue: number;\n    receiptId: string;\n    currency?: string;\n    listerRazorpayConfigId?: string;\n    ticketIds?: string[];\n  }) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.create({\n        data: {\n          userId: data.userId,\n          eventId: data.eventId,\n          razorpayOrderId: data.razorpayOrderId,\n          amount: data.amount,\n          platformFee: data.platformFee,\n          gst: data.gst ?? 0,\n          listerRevenue: data.listerRevenue,\n          receiptId: data.receiptId,\n          currency: data.currency || \"INR\",\n          status: \"PENDING\",\n          listerRazorpayConfigId: data.listerRazorpayConfigId ?? null,\n          notes: data.ticketIds\n            ? { ticketIds: data.ticketIds.join(\",\") }\n            : undefined,\n        },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Create payment record\");\n  }\n\n  /**\n   * Find payment by Razorpay order ID\n   */\n  async findByRazorpayOrderId(razorpayOrderId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.findUnique({\n        where: { razorpayOrderId },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Find payment by Razorpay order ID\");\n  }\n\n  /** Leave a note on a Payment that needs a human to look at it (for example a refund by hand). */\n  async flagForReconciliation(razorpayOrderId: string, reason: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.payment.update({\n          where: { razorpayOrderId },\n          data: { notes: { reconcile: reason } },\n          select: { paymentId: true },\n        }),\n      \"Flag payment for reconciliation\",\n    );\n  }\n\n  /**\n   * Update payment with verification details\n   */\n  async updatePaymentVerification(\n    razorpayOrderId: string,\n    data: {\n      razorpayPaymentId: string;\n      razorpaySignature: string;\n      status: PaymentStatus;\n      method?: string;\n      failureReason?: string;\n    },\n  ) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.update({\n        where: { razorpayOrderId },\n        data: {\n          razorpayPaymentId: data.razorpayPaymentId,\n          razorpaySignature: data.razorpaySignature,\n          status: data.status,\n          method: data.method,\n          failureReason: data.failureReason,\n          completedAt: data.status === \"COMPLETED\" ? new Date() : null,\n          failedAt: data.status === \"FAILED\" ? new Date() : null,\n        },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Update payment verification\");\n  }\n\n  /**\n   * Get payment by ID\n   */\n  async findById(paymentId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.findUnique({\n        where: { paymentId },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Find payment by ID\");\n  }\n\n  /**\n   * Lightweight booking lookup for fee math (refunds, breakdowns).\n   * Returns the stored money fields only.\n   */\n  async findBookingById(bookingId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.booking.findUnique({\n        where: { bookingId },\n        select: {\n          bookingId: true,\n          eventId: true,\n          subtotal: true,\n          platformFee: true,\n          gatewayFee: true,\n          feesBornBy: true,\n          total: true,\n          status: true,\n        },\n      });\n    }, \"Find booking by ID (lite)\");\n  }\n\n  /**\n   * Get payments by user\n   */\n  async findByUserId(userId: string, page: number = 1, limit: number = 20) {\n    return wrapDatabaseOperation(async () => {\n      const where = { userId };\n      const [items, total] = await Promise.all([\n        prisma.payment.findMany({\n          where,\n          select: PAYMENT_SELECT,\n          orderBy: { createdAt: \"desc\" },\n          skip: (page - 1) * limit,\n          take: limit,\n        }),\n        prisma.payment.count({ where }),\n      ]);\n      return {\n        items,\n        total,\n        page,\n        limit,\n        totalPages: Math.ceil(total / limit),\n      };\n    }, \"Find payments by user ID\");\n  }\n\n  /**\n   * Get payments by event (for lister/admin)\n   */\n  async findByEventId(eventId: string, page: number = 1, limit: number = 50) {\n    return wrapDatabaseOperation(async () => {\n      const where = { eventId };\n      const [items, total] = await Promise.all([\n        prisma.payment.findMany({\n          where,\n          select: PAYMENT_SELECT,\n          orderBy: { createdAt: \"desc\" },\n          skip: (page - 1) * limit,\n          take: limit,\n        }),\n        prisma.payment.count({ where }),\n      ]);\n      return {\n        items,\n        total,\n        page,\n        limit,\n        totalPages: Math.ceil(total / limit),\n      };\n    }, \"Find payments by event ID\");\n  }\n\n  /**\n   * Find the most recent payment for a given event+user pair.\n   * Used by the refund service to locate the razorpay payment ID for a ticket.\n   */\n  async findByEventAndUser(eventId: string, userId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.findFirst({\n        where: { eventId, userId },\n        select: PAYMENT_SELECT,\n        orderBy: { createdAt: \"desc\" },\n      });\n    }, \"Find payment by event and user\");\n  }\n\n  /**\n   * Update payment with comprehensive Razorpay data\n   */\n  async updateWithRazorpayData(\n    razorpayOrderId: string,\n    razorpayPayment: any,\n    razorpaySignature: string,\n  ) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.update({\n        where: { razorpayOrderId },\n        data: {\n          razorpayPaymentId: razorpayPayment.id,\n          razorpaySignature,\n          status: \"COMPLETED\",\n          method: razorpayPayment.method,\n          methodType: razorpayPayment.method,\n          // Card details\n          cardLast4: razorpayPayment.card?.last4,\n          cardNetwork: razorpayPayment.card?.network,\n          cardType: razorpayPayment.card?.type,\n          // Bank/Wallet details\n          bank: razorpayPayment.bank || null,\n          wallet: razorpayPayment.wallet || null,\n          vpa: razorpayPayment.vpa || null,\n          // Contact info\n          email: razorpayPayment.email,\n          contact: razorpayPayment.contact,\n          // Full Razorpay response\n          razorpayData: razorpayPayment,\n          // Timestamps\n          completedAt: new Date(),\n        },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Update payment with Razorpay data\");\n  }\n\n  /**\n   * Update payment as failed\n   */\n  async markAsFailed(\n    razorpayOrderId: string,\n    failureData: {\n      failureReason?: string;\n      errorCode?: string;\n      errorSource?: string;\n      errorStep?: string;\n    },\n  ) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.update({\n        where: { razorpayOrderId },\n        data: {\n          status: \"FAILED\",\n          failureReason: failureData.failureReason,\n          errorCode: failureData.errorCode,\n          errorSource: failureData.errorSource,\n          errorStep: failureData.errorStep,\n          failedAt: new Date(),\n          attempts: { increment: 1 },\n        },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Mark payment as failed\");\n  }\n\n  /**\n   * Find payment by bookingId\n   */\n  async findByBookingId(bookingId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.findUnique({\n        where: { bookingId },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Find payment by booking ID\");\n  }\n\n  /**\n   * Upsert a Payment row keyed on bookingId.\n   * Creates if none exists; updates razorpayOrderId + amount + fee breakdown if one does.\n   */\n  async upsertForBooking(data: {\n    userId: string;\n    eventId: string;\n    bookingId: string;\n    razorpayOrderId: string;\n    amount: number;\n    platformFee: number;\n    listerRevenue: number;\n    receiptId: string;\n    currency?: string;\n    listerRazorpayConfigId?: string;\n  }) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.payment.upsert({\n        where: { bookingId: data.bookingId },\n        create: {\n          userId: data.userId,\n          eventId: data.eventId,\n          bookingId: data.bookingId,\n          razorpayOrderId: data.razorpayOrderId,\n          amount: data.amount,\n          platformFee: data.platformFee,\n          listerRevenue: data.listerRevenue,\n          receiptId: data.receiptId,\n          currency: data.currency ?? \"INR\",\n          status: \"PENDING\",\n          listerRazorpayConfigId: data.listerRazorpayConfigId ?? null,\n        },\n        update: {\n          razorpayOrderId: data.razorpayOrderId,\n          amount: data.amount,\n          platformFee: data.platformFee,\n          listerRevenue: data.listerRevenue,\n          status: \"PENDING\",\n        },\n        select: PAYMENT_SELECT,\n      });\n    }, \"Upsert payment for booking\");\n  }\n\n  /**\n   * Calculate revenue split for an event.\n   *\n   * Basis: stored Booking snapshot columns (platformFee, gst, gatewayFee, total).\n   * Coupon is already baked in at booking time — do NOT recompute from TicketType\n   * config (which ignores discountAmount and uses stale fee config).\n   * Refunds are netted via the Refund table (spec §2 decision 9).\n   */\n  async calculateEventRevenue(eventId: string) {\n    return wrapDatabaseOperation(async () => {\n      const [bookingAgg, refundAgg, ticketsSoldAgg] = await Promise.all([\n        // Sum of stored snapshots for PAID bookings.\n        // hostNet = total − platformFee − gst − gatewayFee.\n        prisma.booking.aggregate({\n          _sum: { total: true, platformFee: true, gst: true, gatewayFee: true },\n          where: { eventId, status: \"PAID\", paymentMode: \"ONLINE\" },\n        }),\n        // Refund netting: APPROVED + PROCESSING + COMPLETED refunds.\n        prisma.refund.aggregate({\n          _sum: { amount: true, platformFeeRefund: true, gatewayFeeRefund: true },\n          where: {\n            eventId,\n            // FAILED included: an approved refund whose gateway attempt broke\n            // is still owed to the buyer, not money the host can be paid on.\n            status: { in: [\"APPROVED\", \"PROCESSING\", \"COMPLETED\", \"FAILED\"] },\n            // Online bookings only: orphaned tickets and cash-sale refunds were\n            // never part of the booking aggregate above.\n            ticket: { booking: { is: { paymentMode: \"ONLINE\" } } },\n          },\n        }),\n        prisma.ticket.aggregate({\n          _sum: { quantity: true },\n          where: { eventId, status: \"SUCCESS\" },\n        }),\n      ]);\n\n      const total = bookingAgg._sum.total ?? 0;\n      const totalPlatformFee = bookingAgg._sum.platformFee ?? 0;\n      const totalGst = bookingAgg._sum.gst ?? 0;\n      const totalGatewayFee = bookingAgg._sum.gatewayFee ?? 0;\n\n      // Build canonical aggregates for revenue.util (spec §4 Layer 1).\n      // totalHostNet = Σ (total − platformFee − gst − gatewayFee): universal for HOST + USER.\n      let bookingAggregate: BookingAggregate = {\n        totalHostNet: total - totalPlatformFee - totalGst - totalGatewayFee,\n        totalPlatformFee,\n        totalGst,\n        totalGatewayFee,\n      };\n      bookingAggregate = applyCashClawback(bookingAggregate, await sumCashFeesOwed({ eventId }));\n      const refundAggregate: RefundAggregate = {\n        amount: refundAgg._sum.amount ?? 0,\n        platformFeeRefund: refundAgg._sum.platformFeeRefund ?? 0,\n        gatewayFeeRefund: refundAgg._sum.gatewayFeeRefund ?? 0,\n      };\n\n      // Canonical helper calls — single source of truth (spec §4 Layer 2).\n      const listerRevenue = netHostRevenue(bookingAggregate, refundAggregate);\n      const netPlatformFee = platformEarnings(bookingAggregate, refundAggregate);\n\n      return {\n        eventId,\n        totalRevenue: bookingAggregate.totalHostNet, // host gross before refunds\n        platformFee: netPlatformFee,                 // net platform earnings (after fee refunds)\n        gatewayFee: totalGatewayFee,\n        listerRevenue,                               // host net after refunds\n        ticketsSold: Number(ticketsSoldAgg._sum.quantity ?? 0),\n      };\n    }, \"Calculate event revenue\");\n  }\n\n  /**\n   * Calculate revenue split for a lister.\n   *\n   * Basis: stored Ticket snapshot columns (totalPrice, platformFee, gst, gatewayFee).\n   * hostNet per seat = totalPrice − platformFee − gst − gatewayFee (spec §4 Layer 1).\n   * Coupon is baked into the fee snapshots at booking time — never recompute from\n   * TicketType config (which ignores discountAmount and may have stale rates).\n   * Refunds are netted from the Refund table (spec §2 decision 9).\n   */\n  async calculateListerRevenue(listerId: string) {\n    return wrapDatabaseOperation(async () => {\n      const [result, refundResult, eventCount] = await Promise.all([\n        // Stored Ticket snapshots — correct for coupon + early-bird + HOST/USER mode.\n        // hostNet = totalPrice − platformFee − gst − gatewayFee per seat.\n        prisma.$queryRaw<\n          Array<{\n            totalRevenue: number;\n            platformFee: number;\n            gst: number;\n            gatewayFee: number;\n            ticketsSold: bigint;\n          }>\n        >`\n          SELECT\n            COALESCE(SUM(t.\"totalPrice\" - t.\"platformFee\" - t.\"gst\" - t.\"gatewayFee\"), 0)::float AS \"totalRevenue\",\n            COALESCE(SUM(t.\"platformFee\"), 0)::float AS \"platformFee\",\n            COALESCE(SUM(t.\"gst\"), 0)::float AS \"gst\",\n            COALESCE(SUM(t.\"gatewayFee\"), 0)::float AS \"gatewayFee\",\n            COALESCE(SUM(t.\"quantity\"), 0) AS \"ticketsSold\"\n          FROM \"Ticket\" t\n          JOIN \"Event\" e ON e.\"eventId\" = t.\"eventId\"\n          WHERE e.\"listerId\" = ${listerId}::uuid\n            AND t.\"status\" = 'SUCCESS'\n        `,\n        // Refund netting: APPROVED + PROCESSING + COMPLETED refunds for this lister.\n        prisma.$queryRaw<\n          Array<{\n            refundAmount: number;\n            platformFeeRefund: number;\n            gatewayFeeRefund: number;\n          }>\n        >`\n          SELECT\n            COALESCE(SUM(r.\"amount\"), 0)::float AS \"refundAmount\",\n            COALESCE(SUM(r.\"platformFeeRefund\"), 0)::float AS \"platformFeeRefund\",\n            COALESCE(SUM(r.\"gatewayFeeRefund\"), 0)::float AS \"gatewayFeeRefund\"\n          FROM \"Refund\" r\n          JOIN \"Event\" e ON e.\"eventId\" = r.\"eventId\"\n          WHERE e.\"listerId\" = ${listerId}::uuid\n            AND r.\"status\" IN ('APPROVED', 'PROCESSING', 'COMPLETED')\n        `,\n        prisma.event.count({ where: { listerId } }),\n      ]);\n\n      const row = result[0] ?? {\n        totalRevenue: 0,\n        platformFee: 0,\n        gst: 0,\n        gatewayFee: 0,\n        ticketsSold: 0n,\n      };\n      const refRow = refundResult[0] ?? {\n        refundAmount: 0,\n        platformFeeRefund: 0,\n        gatewayFeeRefund: 0,\n      };\n\n      // Build canonical aggregates for revenue.util (spec §4 Layer 2).\n      // SQL already derived totalRevenue = Σ (totalPrice − platformFee − gst − gatewayFee).\n      const bookingAggregate: BookingAggregate = {\n        totalHostNet: Number(row.totalRevenue),\n        totalPlatformFee: Number(row.platformFee),\n        totalGst: 0, // gst already baked into totalRevenue derivation above\n        totalGatewayFee: Number(row.gatewayFee ?? 0),\n      };\n      const refundAggregate: RefundAggregate = {\n        amount: Number(refRow.refundAmount),\n        platformFeeRefund: Number(refRow.platformFeeRefund),\n        gatewayFeeRefund: Number(refRow.gatewayFeeRefund),\n      };\n\n      // Canonical helper calls — single source of truth (spec §4 Layer 2).\n      const listerRevenue = netHostRevenue(bookingAggregate, refundAggregate);\n      const netPlatformFee = platformEarnings(bookingAggregate, refundAggregate);\n\n      return {\n        listerId,\n        totalRevenue: bookingAggregate.totalHostNet, // host gross before refunds\n        platformFee: netPlatformFee,                 // net platform earnings (after fee refunds)\n        gatewayFee: bookingAggregate.totalGatewayFee,\n        listerRevenue,\n        ticketsSold: Number(row.ticketsSold),\n        eventCount,\n      };\n    }, \"Calculate lister revenue\");\n  }\n}\n","numLines":505,"startLine":1,"totalLines":505}},"tool_result_meta":[{"id":"call-7985c638-4a2e-46da-93de-d81b56c648dc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
