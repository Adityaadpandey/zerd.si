{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-6f7b1feb-5d2b-46f8-a388-4e6e0c20c158","type":"tool_result","content":"1\timport { prisma } from \"../config/db\";\n2\timport type { PartnerKeyMode, Prisma } from \"../generated/prisma/client\";\n3\timport { wrapDatabaseOperation } from \"../utils/database-error-handler.util\";\n4\t\n5\texport class CheckoutSessionRepository {\n6\t  async create(data: {\n7\t    listerId: string;\n8\t    eventId: string;\n9\t    mode: PartnerKeyMode;\n10\t    items: Prisma.InputJsonValue;\n11\t    amountPaise: number;\n12\t    successUrl: string;\n13\t    cancelUrl: string;\n14\t    clientReference?: string;\n15\t    expiresAt: Date;\n16\t  }) {\n17\t    return wrapDatabaseOperation(\n18\t      () => prisma.checkoutSession.create({ data }),\n19\t      \"Create checkout session\",\n20\t    );\n21\t  }\n22\t\n23\t  /** Host-facing read. listerId is in the WHERE so another host's id is simply \"not found\". */\n24\t  async findForLister(sessionId: string, listerId: string) {\n25\t    return wrapDatabaseOperation(\n26\t      () =>\n27\t        prisma.checkoutSession.findFirst({ where: { sessionId, listerId } }),\n28\t      \"Find checkout session for lister\",\n29\t    );\n30\t  }\n31\t\n32\t  /** Buyer-facing read: the session id itself is the capability. */\n33\t  async findById(sessionId: string) {\n34\t    return wrapDatabaseOperation(\n35\t      () => prisma.checkoutSession.findUnique({ where: { sessionId } }),\n36\t      \"Find checkout session\",\n37\t    );\n38\t  }\n39\t\n40\t  /** Event fields the session rules need: ownership, published, sale window, flow flags. */\n41\t  async findEventForCheckout(eventId: string) {\n42\t    return wrapDatabaseOperation(\n43\t      () =>\n44\t        prisma.event.findUnique({\n45\t          where: { eventId },\n46\t          select: {\n47\t            eventId: true,\n48\t            title: true,\n49\t            listerId: true,\n50\t            status: true,\n51\t            salesPaused: true,\n52\t            saleStartsAt: true,\n53\t            saleEndsAt: true,\n54\t            ticketingEnabled: true,\n55\t            requiresApproval: true,\n56\t            seatingMode: true,\n57\t          },\n58\t        }),\n59\t      \"Find event for checkout session\",\n60\t    );\n61\t  }\n62\t\n63\t  /** OPEN -> EXPIRED. Returns how many rows moved (0 means someone else already closed it). */\n64\t  async expireOpen(sessionId: string, reason: string, listerId?: string) {\n65\t    return wrapDatabaseOperation(\n66\t      () =>\n67\t        prisma.checkoutSession.updateMany({\n68\t          where: {\n69\t            sessionId,\n70\t            status: \"OPEN\",\n71\t            ...(listerId ? { listerId } : {}),\n72\t          },\n73\t          data: { status: \"EXPIRED\", expireReason: reason },\n74\t        }),\n75\t      \"Expire checkout session\",\n76\t    );\n77\t  }\n78\t\n79\t  /**\n80\t   * Remembers which booking and buyer the session turned into. Only an OPEN session\n81\t   * with no booking yet can be claimed, so two tabs cannot both start the same session.\n82\t   */\n83\t  async claimForBooking(sessionId: string, userId: string) {\n84\t    return wrapDatabaseOperation(\n85\t      () =>\n86\t        prisma.checkoutSession.updateMany({\n87\t          where: {\n88\t            sessionId,\n89\t            status: \"OPEN\",\n90\t            expiresAt: { gt: new Date() },\n91\t            OR: [{ userId: null }, { userId }],\n92\t          },\n93\t          data: { userId },\n94\t        }),\n95\t      \"Claim checkout session for buyer\",\n96\t    );\n97\t  }\n98\t\n99\t  /**\n100\t   * Undoes a claim that never turned into a booking. Only an OPEN session with the\n101\t   * given buyer and no booking yet can be released, so a failed start does not\n102\t   * leave the session owned by a buyer who never got a checkout.\n103\t   */\n104\t  async releaseClaim(sessionId: string, userId: string) {\n105\t    return wrapDatabaseOperation(\n106\t      () =>\n107\t        prisma.checkoutSession.updateMany({\n108\t          where: {\n109\t            sessionId,\n110\t            status: \"OPEN\",\n111\t            userId,\n112\t            bookingId: null,\n113\t          },\n114\t          data: { userId: null },\n115\t        }),\n116\t      \"Release checkout session claim\",\n117\t    );\n118\t  }\n119\t\n120\t  async attachBooking(sessionId: string, bookingId: string) {\n121\t    return wrapDatabaseOperation(\n122\t      () =>\n123\t        prisma.checkoutSession.update({\n124\t          where: { sessionId },\n125\t          data: { bookingId },\n126\t        }),\n127\t      \"Attach booking to checkout session\",\n128\t    );\n129\t  }\n130\t\n131\t  /**\n132\t   * Called when a booking is finalised as paid. A late capture (session already\n133\t   * EXPIRED but the money landed) still ends as PAID, because the booking was honoured.\n134\t   */\n135\t  async markPaid(sessionId: string) {\n136\t    return wrapDatabaseOperation(\n137\t      () =>\n138\t        prisma.checkoutSession.updateMany({\n139\t          where: { sessionId, status: { in: [\"OPEN\", \"EXPIRED\"] } },\n140\t          data: { status: \"PAID\", expireReason: null },\n141\t        }),\n142\t      \"Mark checkout session paid\",\n143\t    );\n144\t  }\n145\t\n146\t  /** Sweep: OPEN sessions past expiresAt become EXPIRED(\"timed_out\"). */\n147\t  async expireDue(now: Date) {\n148\t    return wrapDatabaseOperation(\n149\t      () =>\n150\t        prisma.checkoutSession.updateMany({\n151\t          where: { status: \"OPEN\", expiresAt: { lt: now } },\n152\t          data: { status: \"EXPIRED\", expireReason: \"timed_out\" },\n153\t        }),\n154\t      \"Expire due checkout sessions\",\n155\t    );\n156\t  }\n157\t}\n158\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"20ece385-9781-4689-804c-c62beb5347b7","timestamp":"2026-11-20T19:18:11.985Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/repositories/checkout-session.repository.ts","content":"import { prisma } from \"../config/db\";\nimport type { PartnerKeyMode, Prisma } from \"../generated/prisma/client\";\nimport { wrapDatabaseOperation } from \"../utils/database-error-handler.util\";\n\nexport class CheckoutSessionRepository {\n  async create(data: {\n    listerId: string;\n    eventId: string;\n    mode: PartnerKeyMode;\n    items: Prisma.InputJsonValue;\n    amountPaise: number;\n    successUrl: string;\n    cancelUrl: string;\n    clientReference?: string;\n    expiresAt: Date;\n  }) {\n    return wrapDatabaseOperation(\n      () => prisma.checkoutSession.create({ data }),\n      \"Create checkout session\",\n    );\n  }\n\n  /** Host-facing read. listerId is in the WHERE so another host's id is simply \"not found\". */\n  async findForLister(sessionId: string, listerId: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.findFirst({ where: { sessionId, listerId } }),\n      \"Find checkout session for lister\",\n    );\n  }\n\n  /** Buyer-facing read: the session id itself is the capability. */\n  async findById(sessionId: string) {\n    return wrapDatabaseOperation(\n      () => prisma.checkoutSession.findUnique({ where: { sessionId } }),\n      \"Find checkout session\",\n    );\n  }\n\n  /** Event fields the session rules need: ownership, published, sale window, flow flags. */\n  async findEventForCheckout(eventId: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.event.findUnique({\n          where: { eventId },\n          select: {\n            eventId: true,\n            title: true,\n            listerId: true,\n            status: true,\n            salesPaused: true,\n            saleStartsAt: true,\n            saleEndsAt: true,\n            ticketingEnabled: true,\n            requiresApproval: true,\n            seatingMode: true,\n          },\n        }),\n      \"Find event for checkout session\",\n    );\n  }\n\n  /** OPEN -> EXPIRED. Returns how many rows moved (0 means someone else already closed it). */\n  async expireOpen(sessionId: string, reason: string, listerId?: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.updateMany({\n          where: {\n            sessionId,\n            status: \"OPEN\",\n            ...(listerId ? { listerId } : {}),\n          },\n          data: { status: \"EXPIRED\", expireReason: reason },\n        }),\n      \"Expire checkout session\",\n    );\n  }\n\n  /**\n   * Remembers which booking and buyer the session turned into. Only an OPEN session\n   * with no booking yet can be claimed, so two tabs cannot both start the same session.\n   */\n  async claimForBooking(sessionId: string, userId: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.updateMany({\n          where: {\n            sessionId,\n            status: \"OPEN\",\n            expiresAt: { gt: new Date() },\n            OR: [{ userId: null }, { userId }],\n          },\n          data: { userId },\n        }),\n      \"Claim checkout session for buyer\",\n    );\n  }\n\n  /**\n   * Undoes a claim that never turned into a booking. Only an OPEN session with the\n   * given buyer and no booking yet can be released, so a failed start does not\n   * leave the session owned by a buyer who never got a checkout.\n   */\n  async releaseClaim(sessionId: string, userId: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.updateMany({\n          where: {\n            sessionId,\n            status: \"OPEN\",\n            userId,\n            bookingId: null,\n          },\n          data: { userId: null },\n        }),\n      \"Release checkout session claim\",\n    );\n  }\n\n  async attachBooking(sessionId: string, bookingId: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.update({\n          where: { sessionId },\n          data: { bookingId },\n        }),\n      \"Attach booking to checkout session\",\n    );\n  }\n\n  /**\n   * Called when a booking is finalised as paid. A late capture (session already\n   * EXPIRED but the money landed) still ends as PAID, because the booking was honoured.\n   */\n  async markPaid(sessionId: string) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.updateMany({\n          where: { sessionId, status: { in: [\"OPEN\", \"EXPIRED\"] } },\n          data: { status: \"PAID\", expireReason: null },\n        }),\n      \"Mark checkout session paid\",\n    );\n  }\n\n  /** Sweep: OPEN sessions past expiresAt become EXPIRED(\"timed_out\"). */\n  async expireDue(now: Date) {\n    return wrapDatabaseOperation(\n      () =>\n        prisma.checkoutSession.updateMany({\n          where: { status: \"OPEN\", expiresAt: { lt: now } },\n          data: { status: \"EXPIRED\", expireReason: \"timed_out\" },\n        }),\n      \"Expire due checkout sessions\",\n    );\n  }\n}\n","numLines":158,"startLine":1,"totalLines":158}},"tool_result_meta":[{"id":"call-6f7b1feb-5d2b-46f8-a388-4e6e0c20c158","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-e4b2c0e3-9a7e-41ea-9b27-4a866af7bc7e","type":"tool_result","content":"=== slot-payment refund block ===\n\n    let paymentId: string;\n    if (booking.razorpayPaymentId) {\n      paymentId = booking.razorpayPaymentId;\n    } else {\n      const paymentsResponse = (await razorpayCircuitBreaker.execute(() =>\n        rzpInstance.orders.fetchPayments(booking.razorpayOrderId),\n      )) as unknown as { items?: Array<{ id: string; status: string }> };\n\n      const captured = paymentsResponse.items?.find(\n        (p) => p.status === \"captured\",\n      );\n      if (!captured) {\n        logger.warn(\"refundSlotBookingPayment: no captured payment on order\", {\n          orderId: booking.razorpayOrderId,\n          slotBookingId: booking.slotBookingId,\n        });\n        return;\n      }\n      paymentId = captured.id;\n    }\n\n    // Razorpay refund: charge back the buyer the gross refund amount. The\n    // gateway fee is NOT reversed — Razorpay keeps what it took at capture\n    // (see https://razorpay.com/docs/payments/refunds/faqs/). The host\n    // therefore loses their full `hostNet` portion of the booking, plus\n    // the gateway fee on the refunded portion stays with Razorpay.\n    const refundAmountPaise = Math.round(\n      booking.total * (refundPercent / 100) * 100,\n    );\n    const refundAmountRs = refundAmountPaise / 100;\n\n    const refundResult = (await razorpayCircuitBreaker.execute(() =>\n      rzpInstance.payments.refund(paymentId, {\n        amount: refundAmountPaise,\n        speed: \"normal\",\n        notes: {\n          slotBookingId: booking.slotBookingId,\n          reason: \"user-cancellation\",\n          refundPercent: String(refundPercent),\n        },\n      } as any),\n    )) as unknown as { id: string };\n\n    await this.slotBookingRepository.updateStatus(\n      booking.slotBookingId,\n      \"REFUNDED\",\n      {\n        razorpayRefundId: refundResult.id,\n        refundAmount: refundAmountRs,\n        refundedAt: new Date(),\n      },\n    );\n\n    // Per-fee refund accounting for ops audit. The actual money is\n    // returned to the buyer in one Razorpay call above; this just records\n    // which fee buckets the host is absorbing on the cancellation.\n    const feeBreakdownPaise = {\n      subtotal: Math.round((booking.subtotal ?? 0) * (refundPercent / 100) * 100),\n      platformFee: Math.round((booking.platformFee ?? 0) * (refundPercent / 100) * 100),\n      gstAmount: Math.round((booking.gstAmount ?? 0) * (refundPercent / 100) * 100),\n      // gateway fee is sunk — Razorpay keeps it\n      gatewayFeeSunk: Math.round((booking.gatewayFee ?? 0) * (refundPercent / 100) * 100),\n      feeBornBy: booking.feeBornBy ?? \"HOST\",\n    };\n\n    // TODO: refunded buyers are not removed from the Google Calendar event\n    // attendee list. Google Calendar has no native revoke-guest API; mitigation\n    // would require deleting and recreating the event, which risks losing\n    // existing confirmed attendees. Accept as a known limitation for now.\n\n    logger.info(\"Refunded slot booking payment on cancellation\", {\n      slotBookingId: booking.slotBookingId,\n      orderId: booking.razorpayOrderId,\n      refundPercent,\n      refundAmountRs,\n      refundId: refundResult.id,\n      feeBreakdownPaise,\n    });\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"6cd0707b-1705-47b2-a150-8bb30b88a399","timestamp":"2026-11-20T19:18:12.414Z","tool_use_result":{"stdout":"=== slot-payment refund block ===\n\n    let paymentId: string;\n    if (booking.razorpayPaymentId) {\n      paymentId = booking.razorpayPaymentId;\n    } else {\n      const paymentsResponse = (await razorpayCircuitBreaker.execute(() =>\n        rzpInstance.orders.fetchPayments(booking.razorpayOrderId),\n      )) as unknown as { items?: Array<{ id: string; status: string }> };\n\n      const captured = paymentsResponse.items?.find(\n        (p) => p.status === \"captured\",\n      );\n      if (!captured) {\n        logger.warn(\"refundSlotBookingPayment: no captured payment on order\", {\n          orderId: booking.razorpayOrderId,\n          slotBookingId: booking.slotBookingId,\n        });\n        return;\n      }\n      paymentId = captured.id;\n    }\n\n    // Razorpay refund: charge back the buyer the gross refund amount. The\n    // gateway fee is NOT reversed — Razorpay keeps what it took at capture\n    // (see https://razorpay.com/docs/payments/refunds/faqs/). The host\n    // therefore loses their full `hostNet` portion of the booking, plus\n    // the gateway fee on the refunded portion stays with Razorpay.\n    const refundAmountPaise = Math.round(\n      booking.total * (refundPercent / 100) * 100,\n    );\n    const refundAmountRs = refundAmountPaise / 100;\n\n    const refundResult = (await razorpayCircuitBreaker.execute(() =>\n      rzpInstance.payments.refund(paymentId, {\n        amount: refundAmountPaise,\n        speed: \"normal\",\n        notes: {\n          slotBookingId: booking.slotBookingId,\n          reason: \"user-cancellation\",\n          refundPercent: String(refundPercent),\n        },\n      } as any),\n    )) as unknown as { id: string };\n\n    await this.slotBookingRepository.updateStatus(\n      booking.slotBookingId,\n      \"REFUNDED\",\n      {\n        razorpayRefundId: refundResult.id,\n        refundAmount: refundAmountRs,\n        refundedAt: new Date(),\n      },\n    );\n\n    // Per-fee refund accounting for ops audit. The actual money is\n    // returned to the buyer in one Razorpay call above; this just records\n    // which fee buckets the host is absorbing on the cancellation.\n    const feeBreakdownPaise = {\n      subtotal: Math.round((booking.subtotal ?? 0) * (refundPercent / 100) * 100),\n      platformFee: Math.round((booking.platformFee ?? 0) * (refundPercent / 100) * 100),\n      gstAmount: Math.round((booking.gstAmount ?? 0) * (refundPercent / 100) * 100),\n      // gateway fee is sunk — Razorpay keeps it\n      gatewayFeeSunk: Math.round((booking.gatewayFee ?? 0) * (refundPercent / 100) * 100),\n      feeBornBy: booking.feeBornBy ?? \"HOST\",\n    };\n\n    // TODO: refunded buyers are not removed from the Google Calendar event\n    // attendee list. Google Calendar has no native revoke-guest API; mitigation\n    // would require deleting and recreating the event, which risks losing\n    // existing confirmed attendees. Accept as a known limitation for now.\n\n    logger.info(\"Refunded slot booking payment on cancellation\", {\n      slotBookingId: booking.slotBookingId,\n      orderId: booking.razorpayOrderId,\n      refundPercent,\n      refundAmountRs,\n      refundId: refundResult.id,\n      feeBreakdownPaise,\n    });\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call-e4b2c0e3-9a7e-41ea-9b27-4a866af7bc7e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
