{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-a6d5cffc-2a5c-43eb-95d7-ab90eba691b7","type":"tool_result","content":"1\t/**\n2\t * Runs a webhook handler at most once per event id, but lets the provider's\n3\t * retry through when the first attempt fails.\n4\t *\n5\t * Why: we save a \"processed\" row BEFORE doing the work, so two servers can't\n6\t * handle the same event at once. If the work then throws (say the database\n7\t * blinks), that row would still be there and Razorpay's retry would be skipped\n8\t * as a duplicate. The payment would be lost for good. So on failure we remove\n9\t * the row again and rethrow, and the retry gets a clean run.\n10\t */\n11\texport async function runWebhookOnce(\n12\t  ops: { claim: () => Promise<boolean>; release: () => Promise<void> },\n13\t  work: () => Promise<void>,\n14\t): Promise<void> {\n15\t  const claimed = await ops.claim();\n16\t  if (!claimed) return;\n17\t\n18\t  try {\n19\t    await work();\n20\t  } catch (err) {\n21\t    // Best effort. If releasing also fails we still want the original error.\n22\t    await ops.release().catch(() => undefined);\n23\t    throw err;\n24\t  }\n25\t}\n26\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"a1fdfc7f-3097-40c0-a46c-35754f3eabf2","timestamp":"2026-11-20T19:06:54.868Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/utils/webhook-dedup.util.ts","content":"/**\n * Runs a webhook handler at most once per event id, but lets the provider's\n * retry through when the first attempt fails.\n *\n * Why: we save a \"processed\" row BEFORE doing the work, so two servers can't\n * handle the same event at once. If the work then throws (say the database\n * blinks), that row would still be there and Razorpay's retry would be skipped\n * as a duplicate. The payment would be lost for good. So on failure we remove\n * the row again and rethrow, and the retry gets a clean run.\n */\nexport async function runWebhookOnce(\n  ops: { claim: () => Promise<boolean>; release: () => Promise<void> },\n  work: () => Promise<void>,\n): Promise<void> {\n  const claimed = await ops.claim();\n  if (!claimed) return;\n\n  try {\n    await work();\n  } catch (err) {\n    // Best effort. If releasing also fails we still want the original error.\n    await ops.release().catch(() => undefined);\n    throw err;\n  }\n}\n","numLines":26,"startLine":1,"totalLines":26}},"tool_result_meta":[{"id":"call-a6d5cffc-2a5c-43eb-95d7-ab90eba691b7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
