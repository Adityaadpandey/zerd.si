{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-ec53b01f-6a8f-4d4e-892b-c8296797f59b","type":"tool_result","content":"1\timport { prisma } from \"../../config/db\";\n2\timport logger from \"../../config/logger\";\n3\timport { DEFAULT_WEB_BASE_URL } from \"../../constants/public-urls\";\n4\timport { delTicketTypeCache } from \"../../lib/cache/ticket\";\n5\timport type { BookingRepository } from \"../../repositories/booking.repository\";\n6\timport type { ListerRepository } from \"../../repositories/lister.repository\";\n7\timport type { UserRepository } from \"../../repositories/user.repository\";\n8\timport { emailCircuitBreaker } from \"../../utils/circuit-breaker.util\";\n9\timport { ConflictError, ValidationError } from \"../../utils/errors.util\";\n10\timport { emailService } from \"../email.service\";\n11\timport { uploadService } from \"../upload.service\";\n12\timport type { BookingLifecycleService } from \"./booking-lifecycle.service\";\n13\timport type { BookingPricingService } from \"./booking-pricing.service\";\n14\timport type { BookingDetails, CreateBookingDto } from \"./types\";\n15\t\n16\t// Approval-request inventory hold: kept generous so the seat doesn't slip\n17\t// out from under the buyer while the host is deciding. Hosts (or the\n18\t// claim-expiry sweeper) release the hold via decline if they sit on it.\n19\tconst APPROVAL_REQUEST_HOLD_MS = 30 * 24 * 60 * 60 * 1000; // 30 days\n20\t\n21\texport class BookingApprovalService {\n22\t  constructor(\n23\t    private readonly bookingRepository: BookingRepository,\n24\t    private readonly listerRepository: ListerRepository,\n25\t    private readonly userRepository: UserRepository,\n26\t    private readonly pricingService: BookingPricingService,\n27\t    private readonly lifecycleService: BookingLifecycleService,\n28\t  ) {}\n29\t\n30\t  /**\n31\t   * Buyer-initiated approval request for an event with requiresApproval=true.\n32\t   *\n33\t   * Behaves like `create` (validates ticket types, prices the booking,\n34\t   * holds inventory atomically, persists custom-field answers) except:\n35\t   *  - Booking is persisted in PENDING_APPROVAL status with no payment record.\n36\t   *  - Inventory hold uses a long window so the seat can't be sold while the\n37\t   *    host is deciding; the standard 10-minute expiry job is NOT enqueued.\n38\t   *  - The host receives a notification email asking them to approve/decline\n39\t   *    via the existing Guests dashboard (PENDING_APPROVAL bookings surface\n40\t   *    there alongside invited guests).\n41\t   */\n42\t  async requestApproval(\n43\t    userId: string,\n44\t    dto: CreateBookingDto,\n45\t    requestId: string,\n46\t  ): Promise<BookingDetails> {\n47\t    this.pricingService.validateDtoShape(dto);\n48\t    uploadService.assertOwnUploads(userId, [\n49\t      ...dto.commonFieldResponses,\n50\t      ...dto.items.flatMap((i) => i.ticketFieldResponses.flat()),\n51\t    ]);\n52\t\n53\t    const event = await prisma.event.findUnique({\n54\t      where: { eventId: dto.eventId },\n55\t      select: {\n56\t        eventId: true,\n57\t        listerId: true,\n58\t        title: true,\n59\t        date: true,\n60\t        salesPaused: true,\n61\t\n62\t        waitlistUntil: true,\n63\t        ticketingEnabled: true,\n64\t        requiresApproval: true,\n65\t      },\n66\t    });\n67\t\n68\t    if (!event) throw new ValidationError(\"Event not found\");\n69\t    if (!event.requiresApproval) {\n70\t      throw new ValidationError(\"This event does not require approval\");\n71\t    }\n72\t\n73\t    if (event.salesPaused) {\n74\t      throw new ValidationError(\"Sales are currently paused for this event\");\n75\t    }\n76\t    if (event.ticketingEnabled && dto.items.length === 0) {\n77\t      throw new ValidationError(\n78\t        \"Approval request must include at least one ticket\",\n79\t      );\n80\t    }\n81\t\n82\t    // Block duplicate approval requests — buyer already has a live pending or\n83\t    // approved-awaiting-payment booking for this event.\n84\t    const existing =\n85\t      await this.bookingRepository.findActiveApprovalByUserAndEvent(\n86\t        userId,\n87\t        dto.eventId,\n88\t      );\n89\t    if (existing) {\n90\t      throw new ConflictError(\n91\t        existing.status === \"APPROVED_AWAITING_PAYMENT\"\n92\t          ? \"Your request was already approved — please complete your payment.\"\n93\t          : \"You already have a pending approval request for this event.\",\n94\t      );\n95\t    }\n96\t\n97\t    // Re-use the same validation+pricing pipeline so the snapshotted prices\n98\t    // on the booking match what the buyer will see at the payment step.\n99\t    const {\n100\t      subtotal,\n101\t      platformFee,\n102\t      gatewayFee,\n103\t      gst,\n104\t      total,\n105\t      feesBornBy,\n106\t      lines,\n107\t    } = await this.pricingService.validateAndPrice(dto);\n108\t\n109\t    const requestedAt = new Date();\n110\t    const holdExpiresAt = new Date(\n111\t      requestedAt.getTime() + APPROVAL_REQUEST_HOLD_MS,\n112\t    );\n113\t\n114\t    const bookingId = await this.bookingRepository.createWithHoldTx({\n115\t      userId,\n116\t      eventId: dto.eventId,\n117\t      subtotal,\n118\t      platformFee,\n119\t      gatewayFee,\n120\t      gst,\n121\t      feesBornBy,\n122\t      total,\n123\t      holdExpiresAt,\n124\t      commonFieldResponses: dto.commonFieldResponses,\n125\t      lines,\n126\t      referrer: dto.referrer,\n127\t      city: dto.city,\n128\t      state: dto.state,\n129\t      userAgent: dto.userAgent,\n130\t      approvalRequest: { requestedAt },\n131\t    });\n132\t\n133\t    await delTicketTypeCache(dto.eventId);\n134\t\n135\t    logger.info(\"Approval request created\", {\n136\t      bookingId,\n137\t      userId,\n138\t      eventId: dto.eventId,\n139\t      requestId,\n140\t    });\n141\t\n142\t    // Notify the host (best-effort; email failure does not invalidate the\n143\t    // request — host can still see it in the Guests dashboard).\n144\t    try {\n145\t      await this.notifyHostOfApprovalRequest({\n146\t        eventId: event.eventId,\n147\t        eventTitle: event.title ?? \"your event\",\n148\t        eventDate: event.date,\n149\t        listerId: event.listerId,\n150\t        bookingId,\n151\t      });\n152\t    } catch (err) {\n153\t      logger.error(\"Failed to notify host of approval request\", {\n154\t        bookingId,\n155\t        err: String(err),\n156\t      });\n157\t    }\n158\t\n159\t    return this.lifecycleService.getForOwner(userId, bookingId);\n160\t  }\n161\t\n162\t  /**\n163\t   * Validate an approval-claim token from the buyer's email link and return\n164\t   * the bookingId so the web client can resume at the payment step.\n165\t   *\n166\t   * Returns null if the token is unknown, expired, or the booking has left\n167\t   * APPROVED_AWAITING_PAYMENT (already paid, declined, or hold expired).\n168\t   */\n169\t  async resolveApprovalClaim(token: string) {\n170\t    const found = await this.bookingRepository.findByApprovalClaimToken(token);\n171\t    if (!found) return null;\n172\t    return {\n173\t      bookingId: found.bookingId,\n174\t      eventId: found.eventId,\n175\t      userId: found.userId,\n176\t      holdExpiresAt: found.holdExpiresAt,\n177\t    };\n178\t  }\n179\t\n180\t  /**\n181\t   * Return the most-recent APPROVED_AWAITING_PAYMENT booking owned by `userId`\n182\t   * for `eventId` whose hold has not expired — or null if none.\n183\t   * Used by the event page to surface a \"Complete your booking\" CTA without\n184\t   * requiring the email-link claim token.\n185\t   */\n186\t  async getMyApprovedBookingForEvent(userId: string, eventId: string) {\n187\t    return this.bookingRepository.findApprovedAwaitingPaymentByUserAndEvent(\n188\t      userId,\n189\t      eventId,\n190\t    );\n191\t  }\n192\t\n193\t  private async notifyHostOfApprovalRequest(input: {\n194\t    eventId: string;\n195\t    eventTitle: string;\n196\t    eventDate: Date | null;\n197\t    listerId: string;\n198\t    bookingId: string;\n199\t  }) {\n200\t    const lister = await this.listerRepository.findById(input.listerId);\n201\t    if (!lister?.userId) return;\n202\t\n203\t    const hostUser = await this.userRepository.findEmailAndNameByUserId(\n204\t      lister.userId,\n205\t    );\n206\t    if (!hostUser?.email) return;\n207\t    const hostEmail = hostUser.email;\n208\t\n209\t    const webBase = process.env.WEB_BASE_URL ?? DEFAULT_WEB_BASE_URL;\n210\t\n211\t    await emailCircuitBreaker.execute(async () => {\n212\t      await emailService.sendEmail({\n213\t        toEmail: hostEmail,\n214\t        name: hostUser.name ?? \"there\",\n215\t        payload: {\n216\t          type: \"guest-notification\",\n217\t          content: {\n218\t            userName: hostUser.name ?? \"there\",\n219\t            eventName: input.eventTitle,\n220\t            eventDate: input.eventDate?.toISOString() ?? \"\",\n221\t            message: `You have a new approval request for ${input.eventTitle}. Review and approve or decline from your dashboard.`,\n222\t            ctaText: \"Review request\",\n223\t            ctaUrl: `${webBase}/dashboard/events/${input.eventId}/audience`,\n224\t          },\n225\t        },\n226\t      });\n227\t    });\n228\t  }\n229\t}\n230\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"5c10cb0b-4f91-4ccb-aa09-1aa0f0d84cd6","timestamp":"2026-11-20T19:29:07.145Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server/src/services/booking/booking-approval.service.ts","content":"import { prisma } from \"../../config/db\";\nimport logger from \"../../config/logger\";\nimport { DEFAULT_WEB_BASE_URL } from \"../../constants/public-urls\";\nimport { delTicketTypeCache } from \"../../lib/cache/ticket\";\nimport type { BookingRepository } from \"../../repositories/booking.repository\";\nimport type { ListerRepository } from \"../../repositories/lister.repository\";\nimport type { UserRepository } from \"../../repositories/user.repository\";\nimport { emailCircuitBreaker } from \"../../utils/circuit-breaker.util\";\nimport { ConflictError, ValidationError } from \"../../utils/errors.util\";\nimport { emailService } from \"../email.service\";\nimport { uploadService } from \"../upload.service\";\nimport type { BookingLifecycleService } from \"./booking-lifecycle.service\";\nimport type { BookingPricingService } from \"./booking-pricing.service\";\nimport type { BookingDetails, CreateBookingDto } from \"./types\";\n\n// Approval-request inventory hold: kept generous so the seat doesn't slip\n// out from under the buyer while the host is deciding. Hosts (or the\n// claim-expiry sweeper) release the hold via decline if they sit on it.\nconst APPROVAL_REQUEST_HOLD_MS = 30 * 24 * 60 * 60 * 1000; // 30 days\n\nexport class BookingApprovalService {\n  constructor(\n    private readonly bookingRepository: BookingRepository,\n    private readonly listerRepository: ListerRepository,\n    private readonly userRepository: UserRepository,\n    private readonly pricingService: BookingPricingService,\n    private readonly lifecycleService: BookingLifecycleService,\n  ) {}\n\n  /**\n   * Buyer-initiated approval request for an event with requiresApproval=true.\n   *\n   * Behaves like `create` (validates ticket types, prices the booking,\n   * holds inventory atomically, persists custom-field answers) except:\n   *  - Booking is persisted in PENDING_APPROVAL status with no payment record.\n   *  - Inventory hold uses a long window so the seat can't be sold while the\n   *    host is deciding; the standard 10-minute expiry job is NOT enqueued.\n   *  - The host receives a notification email asking them to approve/decline\n   *    via the existing Guests dashboard (PENDING_APPROVAL bookings surface\n   *    there alongside invited guests).\n   */\n  async requestApproval(\n    userId: string,\n    dto: CreateBookingDto,\n    requestId: string,\n  ): Promise<BookingDetails> {\n    this.pricingService.validateDtoShape(dto);\n    uploadService.assertOwnUploads(userId, [\n      ...dto.commonFieldResponses,\n      ...dto.items.flatMap((i) => i.ticketFieldResponses.flat()),\n    ]);\n\n    const event = await prisma.event.findUnique({\n      where: { eventId: dto.eventId },\n      select: {\n        eventId: true,\n        listerId: true,\n        title: true,\n        date: true,\n        salesPaused: true,\n\n        waitlistUntil: true,\n        ticketingEnabled: true,\n        requiresApproval: true,\n      },\n    });\n\n    if (!event) throw new ValidationError(\"Event not found\");\n    if (!event.requiresApproval) {\n      throw new ValidationError(\"This event does not require approval\");\n    }\n\n    if (event.salesPaused) {\n      throw new ValidationError(\"Sales are currently paused for this event\");\n    }\n    if (event.ticketingEnabled && dto.items.length === 0) {\n      throw new ValidationError(\n        \"Approval request must include at least one ticket\",\n      );\n    }\n\n    // Block duplicate approval requests — buyer already has a live pending or\n    // approved-awaiting-payment booking for this event.\n    const existing =\n      await this.bookingRepository.findActiveApprovalByUserAndEvent(\n        userId,\n        dto.eventId,\n      );\n    if (existing) {\n      throw new ConflictError(\n        existing.status === \"APPROVED_AWAITING_PAYMENT\"\n          ? \"Your request was already approved — please complete your payment.\"\n          : \"You already have a pending approval request for this event.\",\n      );\n    }\n\n    // Re-use the same validation+pricing pipeline so the snapshotted prices\n    // on the booking match what the buyer will see at the payment step.\n    const {\n      subtotal,\n      platformFee,\n      gatewayFee,\n      gst,\n      total,\n      feesBornBy,\n      lines,\n    } = await this.pricingService.validateAndPrice(dto);\n\n    const requestedAt = new Date();\n    const holdExpiresAt = new Date(\n      requestedAt.getTime() + APPROVAL_REQUEST_HOLD_MS,\n    );\n\n    const bookingId = await this.bookingRepository.createWithHoldTx({\n      userId,\n      eventId: dto.eventId,\n      subtotal,\n      platformFee,\n      gatewayFee,\n      gst,\n      feesBornBy,\n      total,\n      holdExpiresAt,\n      commonFieldResponses: dto.commonFieldResponses,\n      lines,\n      referrer: dto.referrer,\n      city: dto.city,\n      state: dto.state,\n      userAgent: dto.userAgent,\n      approvalRequest: { requestedAt },\n    });\n\n    await delTicketTypeCache(dto.eventId);\n\n    logger.info(\"Approval request created\", {\n      bookingId,\n      userId,\n      eventId: dto.eventId,\n      requestId,\n    });\n\n    // Notify the host (best-effort; email failure does not invalidate the\n    // request — host can still see it in the Guests dashboard).\n    try {\n      await this.notifyHostOfApprovalRequest({\n        eventId: event.eventId,\n        eventTitle: event.title ?? \"your event\",\n        eventDate: event.date,\n        listerId: event.listerId,\n        bookingId,\n      });\n    } catch (err) {\n      logger.error(\"Failed to notify host of approval request\", {\n        bookingId,\n        err: String(err),\n      });\n    }\n\n    return this.lifecycleService.getForOwner(userId, bookingId);\n  }\n\n  /**\n   * Validate an approval-claim token from the buyer's email link and return\n   * the bookingId so the web client can resume at the payment step.\n   *\n   * Returns null if the token is unknown, expired, or the booking has left\n   * APPROVED_AWAITING_PAYMENT (already paid, declined, or hold expired).\n   */\n  async resolveApprovalClaim(token: string) {\n    const found = await this.bookingRepository.findByApprovalClaimToken(token);\n    if (!found) return null;\n    return {\n      bookingId: found.bookingId,\n      eventId: found.eventId,\n      userId: found.userId,\n      holdExpiresAt: found.holdExpiresAt,\n    };\n  }\n\n  /**\n   * Return the most-recent APPROVED_AWAITING_PAYMENT booking owned by `userId`\n   * for `eventId` whose hold has not expired — or null if none.\n   * Used by the event page to surface a \"Complete your booking\" CTA without\n   * requiring the email-link claim token.\n   */\n  async getMyApprovedBookingForEvent(userId: string, eventId: string) {\n    return this.bookingRepository.findApprovedAwaitingPaymentByUserAndEvent(\n      userId,\n      eventId,\n    );\n  }\n\n  private async notifyHostOfApprovalRequest(input: {\n    eventId: string;\n    eventTitle: string;\n    eventDate: Date | null;\n    listerId: string;\n    bookingId: string;\n  }) {\n    const lister = await this.listerRepository.findById(input.listerId);\n    if (!lister?.userId) return;\n\n    const hostUser = await this.userRepository.findEmailAndNameByUserId(\n      lister.userId,\n    );\n    if (!hostUser?.email) return;\n    const hostEmail = hostUser.email;\n\n    const webBase = process.env.WEB_BASE_URL ?? DEFAULT_WEB_BASE_URL;\n\n    await emailCircuitBreaker.execute(async () => {\n      await emailService.sendEmail({\n        toEmail: hostEmail,\n        name: hostUser.name ?? \"there\",\n        payload: {\n          type: \"guest-notification\",\n          content: {\n            userName: hostUser.name ?? \"there\",\n            eventName: input.eventTitle,\n            eventDate: input.eventDate?.toISOString() ?? \"\",\n            message: `You have a new approval request for ${input.eventTitle}. Review and approve or decline from your dashboard.`,\n            ctaText: \"Review request\",\n            ctaUrl: `${webBase}/dashboard/events/${input.eventId}/audience`,\n          },\n        },\n      });\n    });\n  }\n}\n","numLines":230,"startLine":1,"totalLines":230}},"tool_result_meta":[{"id":"call-ec53b01f-6a8f-4d4e-892b-c8296797f59b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
