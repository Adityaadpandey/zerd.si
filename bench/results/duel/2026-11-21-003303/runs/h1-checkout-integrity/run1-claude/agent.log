{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-6ec13c3a-a55c-4193-98a5-dd297ec22123","type":"tool_result","content":"1\t\"use client\";\n2\t\n3\timport { useRouter } from \"next/navigation\";\n4\timport { useCallback, useEffect, useRef, useState } from \"react\";\n5\timport { Button } from \"@/components/ui/primitives\";\n6\timport { usePushSubscription } from \"@/hooks/usePushSubscription\";\n7\timport { activityTracker } from \"@/lib/analytics/activity-tracker\";\n8\timport { clearActiveBookingId } from \"@/lib/booking/session-storage\";\n9\timport { openRazorpay } from \"@/lib/razorpay/loader\";\n10\timport { addToast } from \"@/lib/redux\";\n11\timport {\n12\t  useCreateBookingPaymentOrderMutation,\n13\t  useGetBookingQuery,\n14\t  useVerifyBookingPaymentMutation,\n15\t} from \"@/lib/redux/api/bookingsApi\";\n16\timport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\n17\timport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n18\t\n19\t// ─── Types ─────────────────────────────────────────────────────────────────────\n20\t\n21\ttype PaymentStatus = \"idle\" | \"opening\" | \"verifying\" | \"error\";\n22\t\n23\tinterface PaymentStepProps {\n24\t  onDone: () => void;\n25\t}\n26\t\n27\t// ─── Helpers ───────────────────────────────────────────────────────────────────\n28\t\n29\tconst GENERIC_PAYMENT_ERROR =\n30\t  \"Payment could not be processed. Please try again.\";\n31\t\n32\tfunction humanError(e: unknown): string {\n33\t  if (e && typeof e === \"object\") {\n34\t    const err = e as {\n35\t      data?: { message?: unknown };\n36\t      error?: unknown;\n37\t    };\n38\t    const candidate =\n39\t      typeof err.data?.message === \"string\" && err.data.message.length < 200\n40\t        ? err.data.message\n41\t        : typeof err.error === \"string\" && err.error.length < 200\n42\t          ? err.error\n43\t          : null;\n44\t    return candidate ?? GENERIC_PAYMENT_ERROR;\n45\t  }\n46\t  return GENERIC_PAYMENT_ERROR;\n47\t}\n48\t\n49\t// ─── Spinner ───────────────────────────────────────────────────────────────────\n50\t\n51\tfunction Spinner() {\n52\t  return (\n53\t    <div\n54\t      className=\"size-6 rounded-full border-2 border-white/20 border-t-white animate-spin\"\n55\t      aria-hidden=\"true\"\n56\t    />\n57\t  );\n58\t}\n59\t\n60\t// ─── PaymentStep ───────────────────────────────────────────────────────────────\n61\t\n62\texport default function PaymentStep({ onDone }: PaymentStepProps) {\n63\t  const router = useRouter();\n64\t  const dispatch = useAppDispatch();\n65\t\n66\t  const bookingId = useAppSelector((s) => s.booking.bookingId);\n67\t  const user = useAppSelector((s) => s.auth.user);\n68\t  const token = useAppSelector((s) => s.auth.token);\n69\t  const push = usePushSubscription();\n70\t\n71\t  const { data: booking } = useGetBookingQuery(bookingId ?? \"\", {\n72\t    skip: !bookingId,\n73\t  });\n74\t\n75\t  const [createOrder] = useCreateBookingPaymentOrderMutation();\n76\t  const [verifyPayment] = useVerifyBookingPaymentMutation();\n77\t\n78\t  const [status, setStatus] = useState<PaymentStatus>(\"idle\");\n79\t  const [errorMsg, setErrorMsg] = useState<string>(\"\");\n80\t  // true after the first auto-start attempt so \"idle\" shows a retry button\n81\t  const [hasTried, setHasTried] = useState(false);\n82\t\n83\t  // Guard against double-invocation (React Strict Mode)\n84\t  const didAutoStartRef = useRef(false);\n85\t  // Prevent duplicate payment processing\n86\t  const isProcessingRef = useRef(false);\n87\t  // Prevent multiple Razorpay instances\n88\t  const razorpayOpenRef = useRef(false);\n89\t  // Keep bookingId stable across async operations\n90\t  const bookingIdRef = useRef<string | null>(null);\n91\t  // Tracks true component mount lifecycle. Re-set to true on every effect\n92\t  // run so React Strict Mode's synthetic unmount/remount doesn't permanently\n93\t  // mark us as unmounted while async work is mid-flight.\n94\t  const mountedRef = useRef(true);\n95\t\n96\t  // Sync bookingId ref\n97\t  useEffect(() => {\n98\t    bookingIdRef.current = bookingId ?? null;\n99\t  }, [bookingId]);\n100\t\n101\t  // Track real mount lifecycle\n102\t  useEffect(() => {\n103\t    mountedRef.current = true;\n104\t    return () => {\n105\t      mountedRef.current = false;\n106\t    };\n107\t  }, []);\n108\t\n109\t  // ── Edge-case: booking already paid or definitively dead ──────────────────\n110\t\n111\t  useEffect(() => {\n112\t    if (!booking || !bookingId) return;\n113\t\n114\t    if (booking.status === \"PAID\") {\n115\t      clearActiveBookingId();\n116\t      dispatch(bookingActions.reset());\n117\t      onDone();\n118\t      router.push(\n119\t        bookingId\n120\t          ? `/booking/success?ticketId=${bookingId}`\n121\t          : \"/booking/success\",\n122\t      );\n123\t      return;\n124\t    }\n125\t\n126\t    if (\n127\t      booking.status === \"EXPIRED\" ||\n128\t      booking.status === \"CANCELLED\" ||\n129\t      booking.status === \"FAILED\"\n130\t    ) {\n131\t      dispatch(\n132\t        addToast({\n133\t          message: \"Your booking has expired. Please start over.\",\n134\t          variant: \"error\",\n135\t        }),\n136\t      );\n137\t    }\n138\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n139\t  }, [booking, bookingId, dispatch, onDone, router.push]);\n140\t\n141\t  // ── Payment start handler ─────────────────────────────────────────────────\n142\t\n143\t  const startPayment = useCallback(async () => {\n144\t    const currentBookingId = bookingIdRef.current;\n145\t\n146\t    // Guard: prevent duplicate payment initiation\n147\t    if (isProcessingRef.current) return;\n148\t    // Guard: prevent multiple Razorpay instances\n149\t    if (razorpayOpenRef.current) return;\n150\t    // Guard: require valid bookingId\n151\t    if (!currentBookingId) return;\n152\t\n153\t    if (token) {\n154\t      void push.requestPermissionAndSubscribe(token).catch(() => {});\n155\t    }\n156\t\n157\t    isProcessingRef.current = true;\n158\t    setStatus(\"opening\");\n159\t    setHasTried(true);\n160\t\n161\t    try {\n162\t      const order = await createOrder(currentBookingId).unwrap();\n163\t\n164\t      // Component truly unmounted — bail out\n165\t      if (!mountedRef.current) return;\n166\t\n167\t      // Free booking — already confirmed server-side, go straight to success\n168\t      if (order.isFree) {\n169\t        activityTracker.track(\"payment_complete\", {\n170\t          bookingId: currentBookingId,\n171\t          eventId: booking?.event?.eventId,\n172\t          total: 0,\n173\t          totalUnit: \"INR\",\n174\t          isFree: true,\n175\t        });\n176\t        clearActiveBookingId();\n177\t        dispatch(bookingActions.reset());\n178\t        onDone();\n179\t        router.push(\n180\t          currentBookingId\n181\t            ? `/booking/success?ticketId=${currentBookingId}`\n182\t            : \"/booking/success\",\n183\t        );\n184\t        return;\n185\t      }\n186\t\n187\t      razorpayOpenRef.current = true;\n188\t\n189\t      // Signal that the user is actively going through payment\n190\t      activityTracker.track(\"payment_initiate\", {\n191\t        bookingId: currentBookingId,\n192\t        eventId: booking?.event?.eventId,\n193\t        // order.amount is paise — rupees, to match payment_complete below.\n194\t        total: order.amount / 100,\n195\t      });\n196\t\n197\t      await openRazorpay({\n198\t        key: order.keyId,\n199\t        amount: order.amount,\n200\t        orderId: order.razorpayOrderId,\n201\t        name: booking?.event.title ?? \"\",\n202\t        description: `Booking ${currentBookingId}`,\n203\t        prefill: {\n204\t          name: user?.name,\n205\t          email: user?.email,\n206\t          contact: user?.phone,\n207\t        },\n208\t        theme: { color: \"#ffffff\" },\n209\t        onSuccess: async (r) => {\n210\t          // Guard: component truly unmounted\n211\t          if (!mountedRef.current) return;\n212\t\n213\t          setStatus(\"verifying\");\n214\t          try {\n215\t            await verifyPayment({\n216\t              id: currentBookingId,\n217\t              ...r,\n218\t            }).unwrap();\n219\t\n220\t            // Component truly unmounted while verifying\n221\t            if (!mountedRef.current) return;\n222\t\n223\t            activityTracker.track(\"payment_complete\", {\n224\t              bookingId: currentBookingId,\n225\t              eventId: booking?.event?.eventId,\n226\t              // order.amount is the Razorpay order value in paise — convert\n227\t              // to rupees so it matches every other revenue figure this event\n228\t              // feeds (campaign funnels, dashboards), same as the venue\n229\t              // booking funnel's venue_payment_complete tracking already does.\n230\t              total: order.amount / 100,\n231\t              totalUnit: \"INR\",\n232\t              isFree: false,\n233\t            });\n234\t\n235\t            clearActiveBookingId();\n236\t            dispatch(bookingActions.reset());\n237\t            onDone();\n238\t            router.push(\n239\t              currentBookingId\n240\t                ? `/booking/success?ticketId=${currentBookingId}`\n241\t                : \"/booking/success\",\n242\t            );\n243\t          } catch (e) {\n244\t            const msg = humanError(e);\n245\t            setErrorMsg(msg);\n246\t            setStatus(\"error\");\n247\t            dispatch(addToast({ message: msg, variant: \"error\" }));\n248\t          } finally {\n249\t            razorpayOpenRef.current = false;\n250\t            isProcessingRef.current = false;\n251\t          }\n252\t        },\n253\t        onDismiss: () => {\n254\t          razorpayOpenRef.current = false;\n255\t          isProcessingRef.current = false;\n256\t          setStatus(\"idle\");\n257\t          dispatch(\n258\t            addToast({ message: \"Payment was cancelled\", variant: \"info\" }),\n259\t          );\n260\t        },\n261\t      });\n262\t    } catch (e) {\n263\t      // Don't update state if component truly unmounted\n264\t      if (!mountedRef.current) return;\n265\t\n266\t      const msg = humanError(e);\n267\t      setErrorMsg(msg);\n268\t      setStatus(\"error\");\n269\t      dispatch(addToast({ message: msg, variant: \"error\" }));\n270\t      isProcessingRef.current = false;\n271\t      razorpayOpenRef.current = false;\n272\t    }\n273\t  }, [\n274\t    booking,\n275\t    dispatch,\n276\t    onDone,\n277\t    router,\n278\t    createOrder,\n279\t    verifyPayment,\n280\t    user,\n281\t    token,\n282\t    push,\n283\t  ]);\n284\t\n285\t  // ── Auto-start flow ────────────────────────────────────────────────────────\n286\t\n287\t  useEffect(() => {\n288\t    if (!booking || !bookingId) return;\n289\t    if (\n290\t      booking.status !== \"HELD\" &&\n291\t      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n292\t    )\n293\t      return;\n294\t    if (status !== \"idle\") return;\n295\t    if (didAutoStartRef.current) return;\n296\t\n297\t    didAutoStartRef.current = true;\n298\t    startPayment();\n299\t  }, [booking, bookingId, status, startPayment]);\n300\t\n301\t  // ── Retry handler ─────────────────────────────────────────────────────────\n302\t  // Must call startPayment() directly — after Razorpay dismiss, status is\n303\t  // already \"idle\" so setStatus(\"idle\") is a no-op and the auto-start effect\n304\t  // never re-fires. Calling startPayment() directly bypasses that race.\n305\t\n306\t  const handleRetry = useCallback(() => {\n307\t    isProcessingRef.current = false;\n308\t    razorpayOpenRef.current = false;\n309\t    didAutoStartRef.current = false;\n310\t    setErrorMsg(\"\");\n311\t    setStatus(\"idle\");\n312\t    startPayment();\n313\t  }, [startPayment]);\n314\t\n315\t  // ── Render: booking not yet loaded ────────────────────────────────────────\n316\t\n317\t  if (!booking) {\n318\t    return (\n319\t      <div\n320\t        role=\"status\"\n321\t        className=\"flex flex-col items-center gap-4 py-12\"\n322\t        aria-busy=\"true\"\n323\t        aria-label=\"Loading booking\"\n324\t      >\n325\t        <Spinner />\n326\t        <p className=\"text-p2 text-white/80\">Preparing payment…</p>\n327\t      </div>\n328\t    );\n329\t  }\n330\t\n331\t  // ── Render: booking is definitively dead ──────────────────────────────────\n332\t\n333\t  if (\n334\t    booking.status === \"EXPIRED\" ||\n335\t    booking.status === \"CANCELLED\" ||\n336\t    booking.status === \"FAILED\"\n337\t  ) {\n338\t    return (\n339\t      <div className=\"flex flex-col gap-4\">\n340\t        <div className=\"rounded-xl bg-red-500/10 border border-red-500/30 p-4 flex flex-col gap-3\">\n341\t          {/* Replace with PiWarning from pika-icons */}\n342\t          <svg\n343\t            className=\"size-6 text-red-400\"\n344\t            viewBox=\"0 0 24 24\"\n345\t            fill=\"none\"\n346\t            aria-hidden=\"true\"\n347\t          >\n348\t            <path\n349\t              d=\"M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z\"\n350\t              stroke=\"currentColor\"\n351\t              strokeWidth=\"1.75\"\n352\t              strokeLinecap=\"round\"\n353\t              strokeLinejoin=\"round\"\n354\t            />\n355\t          </svg>\n356\t          <p className=\"text-p3 text-red-200\">This booking has expired.</p>\n357\t        </div>\n358\t        <Button\n359\t          variant=\"primary\"\n360\t          fullWidth\n361\t          onClick={() => {\n362\t            clearActiveBookingId();\n363\t            dispatch(bookingActions.reset());\n364\t            dispatch(bookingActions.setStep(2));\n365\t          }}\n366\t        >\n367\t          Start over\n368\t        </Button>\n369\t      </div>\n370\t    );\n371\t  }\n372\t\n373\t  // ── Render: error state ───────────────────────────────────────────────────\n374\t\n375\t  if (status === \"error\") {\n376\t    return (\n377\t      <div className=\"flex flex-col items-center gap-4 py-12\">\n378\t        <div className=\"w-full rounded-xl bg-red-500/10 border border-red-500/30 p-4\">\n379\t          <p className=\"text-p3 text-red-200\">{errorMsg}</p>\n380\t        </div>\n381\t        <div className=\"flex flex-col gap-3 w-full\">\n382\t          <Button variant=\"primary\" fullWidth onClick={handleRetry}>\n383\t            Retry\n384\t          </Button>\n385\t          <Button\n386\t            variant=\"secondary\"\n387\t            fullWidth\n388\t            onClick={() => dispatch(bookingActions.setStep(4))}\n389\t          >\n390\t            Back to review\n391\t          </Button>\n392\t        </div>\n393\t      </div>\n394\t    );\n395\t  }\n396\t\n397\t  // ── Render: opening state ─────────────────────────────────────────────────\n398\t\n399\t  if (status === \"opening\") {\n400\t    const isFree = (booking?.total ?? 1) === 0;\n401\t    return (\n402\t      <div\n403\t        role=\"status\"\n404\t        className=\"flex flex-col items-center gap-4 py-12\"\n405\t        aria-busy=\"true\"\n406\t        aria-label={isFree ? \"Confirming booking\" : \"Opening Razorpay checkout\"}\n407\t      >\n408\t        <Spinner />\n409\t        <p className=\"text-p2 text-white/80\">\n410\t          {isFree ? \"Confirming your booking…\" : \"Opening Razorpay…\"}\n411\t        </p>\n412\t      </div>\n413\t    );\n414\t  }\n415\t\n416\t  // ── Render: verifying state ───────────────────────────────────────────────\n417\t\n418\t  if (status === \"verifying\") {\n419\t    return (\n420\t      <div\n421\t        role=\"status\"\n422\t        className=\"flex flex-col items-center gap-4 py-12\"\n423\t        aria-busy=\"true\"\n424\t        aria-label=\"Verifying payment\"\n425\t      >\n426\t        <Spinner />\n427\t        <p className=\"text-p2 text-white/80\">Verifying payment…</p>\n428\t      </div>\n429\t    );\n430\t  }\n431\t\n432\t  // ── Render: idle (initial or after dismiss) ───────────────────────────────\n433\t\n434\t  const isFreeBooking = (booking?.total ?? 1) === 0;\n435\t\n436\t  return (\n437\t    <div className=\"flex flex-col items-center gap-4 py-12\">\n438\t      <Spinner />\n439\t      <p className=\"text-p2 text-white/80\">\n440\t        {isFreeBooking ? \"Confirming your booking…\" : \"Preparing payment…\"}\n441\t      </p>\n442\t      {hasTried && (\n443\t        <div className=\"flex flex-col gap-3 w-full mt-4\">\n444\t          <Button variant=\"primary\" fullWidth onClick={handleRetry}>\n445\t            Try again\n446\t          </Button>\n447\t          <Button\n448\t            variant=\"secondary\"\n449\t            fullWidth\n450\t            onClick={() => dispatch(bookingActions.setStep(4))}\n451\t          >\n452\t            Back to review\n453\t          </Button>\n454\t        </div>\n455\t      )}\n456\t    </div>\n457\t  );\n458\t}\n459\t"}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"ed1029ba-9bbf-4e76-b2d6-250aa71fc68a","timestamp":"2026-11-20T19:07:06.397Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/web/src/components/booking/steps/PaymentStep.tsx","content":"\"use client\";\n\nimport { useRouter } from \"next/navigation\";\nimport { useCallback, useEffect, useRef, useState } from \"react\";\nimport { Button } from \"@/components/ui/primitives\";\nimport { usePushSubscription } from \"@/hooks/usePushSubscription\";\nimport { activityTracker } from \"@/lib/analytics/activity-tracker\";\nimport { clearActiveBookingId } from \"@/lib/booking/session-storage\";\nimport { openRazorpay } from \"@/lib/razorpay/loader\";\nimport { addToast } from \"@/lib/redux\";\nimport {\n  useCreateBookingPaymentOrderMutation,\n  useGetBookingQuery,\n  useVerifyBookingPaymentMutation,\n} from \"@/lib/redux/api/bookingsApi\";\nimport { useAppDispatch, useAppSelector } from \"@/lib/redux/hooks\";\nimport { bookingActions } from \"@/lib/redux/slices/bookingSlice\";\n\n// ─── Types ─────────────────────────────────────────────────────────────────────\n\ntype PaymentStatus = \"idle\" | \"opening\" | \"verifying\" | \"error\";\n\ninterface PaymentStepProps {\n  onDone: () => void;\n}\n\n// ─── Helpers ───────────────────────────────────────────────────────────────────\n\nconst GENERIC_PAYMENT_ERROR =\n  \"Payment could not be processed. Please try again.\";\n\nfunction humanError(e: unknown): string {\n  if (e && typeof e === \"object\") {\n    const err = e as {\n      data?: { message?: unknown };\n      error?: unknown;\n    };\n    const candidate =\n      typeof err.data?.message === \"string\" && err.data.message.length < 200\n        ? err.data.message\n        : typeof err.error === \"string\" && err.error.length < 200\n          ? err.error\n          : null;\n    return candidate ?? GENERIC_PAYMENT_ERROR;\n  }\n  return GENERIC_PAYMENT_ERROR;\n}\n\n// ─── Spinner ───────────────────────────────────────────────────────────────────\n\nfunction Spinner() {\n  return (\n    <div\n      className=\"size-6 rounded-full border-2 border-white/20 border-t-white animate-spin\"\n      aria-hidden=\"true\"\n    />\n  );\n}\n\n// ─── PaymentStep ───────────────────────────────────────────────────────────────\n\nexport default function PaymentStep({ onDone }: PaymentStepProps) {\n  const router = useRouter();\n  const dispatch = useAppDispatch();\n\n  const bookingId = useAppSelector((s) => s.booking.bookingId);\n  const user = useAppSelector((s) => s.auth.user);\n  const token = useAppSelector((s) => s.auth.token);\n  const push = usePushSubscription();\n\n  const { data: booking } = useGetBookingQuery(bookingId ?? \"\", {\n    skip: !bookingId,\n  });\n\n  const [createOrder] = useCreateBookingPaymentOrderMutation();\n  const [verifyPayment] = useVerifyBookingPaymentMutation();\n\n  const [status, setStatus] = useState<PaymentStatus>(\"idle\");\n  const [errorMsg, setErrorMsg] = useState<string>(\"\");\n  // true after the first auto-start attempt so \"idle\" shows a retry button\n  const [hasTried, setHasTried] = useState(false);\n\n  // Guard against double-invocation (React Strict Mode)\n  const didAutoStartRef = useRef(false);\n  // Prevent duplicate payment processing\n  const isProcessingRef = useRef(false);\n  // Prevent multiple Razorpay instances\n  const razorpayOpenRef = useRef(false);\n  // Keep bookingId stable across async operations\n  const bookingIdRef = useRef<string | null>(null);\n  // Tracks true component mount lifecycle. Re-set to true on every effect\n  // run so React Strict Mode's synthetic unmount/remount doesn't permanently\n  // mark us as unmounted while async work is mid-flight.\n  const mountedRef = useRef(true);\n\n  // Sync bookingId ref\n  useEffect(() => {\n    bookingIdRef.current = bookingId ?? null;\n  }, [bookingId]);\n\n  // Track real mount lifecycle\n  useEffect(() => {\n    mountedRef.current = true;\n    return () => {\n      mountedRef.current = false;\n    };\n  }, []);\n\n  // ── Edge-case: booking already paid or definitively dead ──────────────────\n\n  useEffect(() => {\n    if (!booking || !bookingId) return;\n\n    if (booking.status === \"PAID\") {\n      clearActiveBookingId();\n      dispatch(bookingActions.reset());\n      onDone();\n      router.push(\n        bookingId\n          ? `/booking/success?ticketId=${bookingId}`\n          : \"/booking/success\",\n      );\n      return;\n    }\n\n    if (\n      booking.status === \"EXPIRED\" ||\n      booking.status === \"CANCELLED\" ||\n      booking.status === \"FAILED\"\n    ) {\n      dispatch(\n        addToast({\n          message: \"Your booking has expired. Please start over.\",\n          variant: \"error\",\n        }),\n      );\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [booking, bookingId, dispatch, onDone, router.push]);\n\n  // ── Payment start handler ─────────────────────────────────────────────────\n\n  const startPayment = useCallback(async () => {\n    const currentBookingId = bookingIdRef.current;\n\n    // Guard: prevent duplicate payment initiation\n    if (isProcessingRef.current) return;\n    // Guard: prevent multiple Razorpay instances\n    if (razorpayOpenRef.current) return;\n    // Guard: require valid bookingId\n    if (!currentBookingId) return;\n\n    if (token) {\n      void push.requestPermissionAndSubscribe(token).catch(() => {});\n    }\n\n    isProcessingRef.current = true;\n    setStatus(\"opening\");\n    setHasTried(true);\n\n    try {\n      const order = await createOrder(currentBookingId).unwrap();\n\n      // Component truly unmounted — bail out\n      if (!mountedRef.current) return;\n\n      // Free booking — already confirmed server-side, go straight to success\n      if (order.isFree) {\n        activityTracker.track(\"payment_complete\", {\n          bookingId: currentBookingId,\n          eventId: booking?.event?.eventId,\n          total: 0,\n          totalUnit: \"INR\",\n          isFree: true,\n        });\n        clearActiveBookingId();\n        dispatch(bookingActions.reset());\n        onDone();\n        router.push(\n          currentBookingId\n            ? `/booking/success?ticketId=${currentBookingId}`\n            : \"/booking/success\",\n        );\n        return;\n      }\n\n      razorpayOpenRef.current = true;\n\n      // Signal that the user is actively going through payment\n      activityTracker.track(\"payment_initiate\", {\n        bookingId: currentBookingId,\n        eventId: booking?.event?.eventId,\n        // order.amount is paise — rupees, to match payment_complete below.\n        total: order.amount / 100,\n      });\n\n      await openRazorpay({\n        key: order.keyId,\n        amount: order.amount,\n        orderId: order.razorpayOrderId,\n        name: booking?.event.title ?? \"\",\n        description: `Booking ${currentBookingId}`,\n        prefill: {\n          name: user?.name,\n          email: user?.email,\n          contact: user?.phone,\n        },\n        theme: { color: \"#ffffff\" },\n        onSuccess: async (r) => {\n          // Guard: component truly unmounted\n          if (!mountedRef.current) return;\n\n          setStatus(\"verifying\");\n          try {\n            await verifyPayment({\n              id: currentBookingId,\n              ...r,\n            }).unwrap();\n\n            // Component truly unmounted while verifying\n            if (!mountedRef.current) return;\n\n            activityTracker.track(\"payment_complete\", {\n              bookingId: currentBookingId,\n              eventId: booking?.event?.eventId,\n              // order.amount is the Razorpay order value in paise — convert\n              // to rupees so it matches every other revenue figure this event\n              // feeds (campaign funnels, dashboards), same as the venue\n              // booking funnel's venue_payment_complete tracking already does.\n              total: order.amount / 100,\n              totalUnit: \"INR\",\n              isFree: false,\n            });\n\n            clearActiveBookingId();\n            dispatch(bookingActions.reset());\n            onDone();\n            router.push(\n              currentBookingId\n                ? `/booking/success?ticketId=${currentBookingId}`\n                : \"/booking/success\",\n            );\n          } catch (e) {\n            const msg = humanError(e);\n            setErrorMsg(msg);\n            setStatus(\"error\");\n            dispatch(addToast({ message: msg, variant: \"error\" }));\n          } finally {\n            razorpayOpenRef.current = false;\n            isProcessingRef.current = false;\n          }\n        },\n        onDismiss: () => {\n          razorpayOpenRef.current = false;\n          isProcessingRef.current = false;\n          setStatus(\"idle\");\n          dispatch(\n            addToast({ message: \"Payment was cancelled\", variant: \"info\" }),\n          );\n        },\n      });\n    } catch (e) {\n      // Don't update state if component truly unmounted\n      if (!mountedRef.current) return;\n\n      const msg = humanError(e);\n      setErrorMsg(msg);\n      setStatus(\"error\");\n      dispatch(addToast({ message: msg, variant: \"error\" }));\n      isProcessingRef.current = false;\n      razorpayOpenRef.current = false;\n    }\n  }, [\n    booking,\n    dispatch,\n    onDone,\n    router,\n    createOrder,\n    verifyPayment,\n    user,\n    token,\n    push,\n  ]);\n\n  // ── Auto-start flow ────────────────────────────────────────────────────────\n\n  useEffect(() => {\n    if (!booking || !bookingId) return;\n    if (\n      booking.status !== \"HELD\" &&\n      booking.status !== \"APPROVED_AWAITING_PAYMENT\"\n    )\n      return;\n    if (status !== \"idle\") return;\n    if (didAutoStartRef.current) return;\n\n    didAutoStartRef.current = true;\n    startPayment();\n  }, [booking, bookingId, status, startPayment]);\n\n  // ── Retry handler ─────────────────────────────────────────────────────────\n  // Must call startPayment() directly — after Razorpay dismiss, status is\n  // already \"idle\" so setStatus(\"idle\") is a no-op and the auto-start effect\n  // never re-fires. Calling startPayment() directly bypasses that race.\n\n  const handleRetry = useCallback(() => {\n    isProcessingRef.current = false;\n    razorpayOpenRef.current = false;\n    didAutoStartRef.current = false;\n    setErrorMsg(\"\");\n    setStatus(\"idle\");\n    startPayment();\n  }, [startPayment]);\n\n  // ── Render: booking not yet loaded ────────────────────────────────────────\n\n  if (!booking) {\n    return (\n      <div\n        role=\"status\"\n        className=\"flex flex-col items-center gap-4 py-12\"\n        aria-busy=\"true\"\n        aria-label=\"Loading booking\"\n      >\n        <Spinner />\n        <p className=\"text-p2 text-white/80\">Preparing payment…</p>\n      </div>\n    );\n  }\n\n  // ── Render: booking is definitively dead ──────────────────────────────────\n\n  if (\n    booking.status === \"EXPIRED\" ||\n    booking.status === \"CANCELLED\" ||\n    booking.status === \"FAILED\"\n  ) {\n    return (\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"rounded-xl bg-red-500/10 border border-red-500/30 p-4 flex flex-col gap-3\">\n          {/* Replace with PiWarning from pika-icons */}\n          <svg\n            className=\"size-6 text-red-400\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            aria-hidden=\"true\"\n          >\n            <path\n              d=\"M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.75\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            />\n          </svg>\n          <p className=\"text-p3 text-red-200\">This booking has expired.</p>\n        </div>\n        <Button\n          variant=\"primary\"\n          fullWidth\n          onClick={() => {\n            clearActiveBookingId();\n            dispatch(bookingActions.reset());\n            dispatch(bookingActions.setStep(2));\n          }}\n        >\n          Start over\n        </Button>\n      </div>\n    );\n  }\n\n  // ── Render: error state ───────────────────────────────────────────────────\n\n  if (status === \"error\") {\n    return (\n      <div className=\"flex flex-col items-center gap-4 py-12\">\n        <div className=\"w-full rounded-xl bg-red-500/10 border border-red-500/30 p-4\">\n          <p className=\"text-p3 text-red-200\">{errorMsg}</p>\n        </div>\n        <div className=\"flex flex-col gap-3 w-full\">\n          <Button variant=\"primary\" fullWidth onClick={handleRetry}>\n            Retry\n          </Button>\n          <Button\n            variant=\"secondary\"\n            fullWidth\n            onClick={() => dispatch(bookingActions.setStep(4))}\n          >\n            Back to review\n          </Button>\n        </div>\n      </div>\n    );\n  }\n\n  // ── Render: opening state ─────────────────────────────────────────────────\n\n  if (status === \"opening\") {\n    const isFree = (booking?.total ?? 1) === 0;\n    return (\n      <div\n        role=\"status\"\n        className=\"flex flex-col items-center gap-4 py-12\"\n        aria-busy=\"true\"\n        aria-label={isFree ? \"Confirming booking\" : \"Opening Razorpay checkout\"}\n      >\n        <Spinner />\n        <p className=\"text-p2 text-white/80\">\n          {isFree ? \"Confirming your booking…\" : \"Opening Razorpay…\"}\n        </p>\n      </div>\n    );\n  }\n\n  // ── Render: verifying state ───────────────────────────────────────────────\n\n  if (status === \"verifying\") {\n    return (\n      <div\n        role=\"status\"\n        className=\"flex flex-col items-center gap-4 py-12\"\n        aria-busy=\"true\"\n        aria-label=\"Verifying payment\"\n      >\n        <Spinner />\n        <p className=\"text-p2 text-white/80\">Verifying payment…</p>\n      </div>\n    );\n  }\n\n  // ── Render: idle (initial or after dismiss) ───────────────────────────────\n\n  const isFreeBooking = (booking?.total ?? 1) === 0;\n\n  return (\n    <div className=\"flex flex-col items-center gap-4 py-12\">\n      <Spinner />\n      <p className=\"text-p2 text-white/80\">\n        {isFreeBooking ? \"Confirming your booking…\" : \"Preparing payment…\"}\n      </p>\n      {hasTried && (\n        <div className=\"flex flex-col gap-3 w-full mt-4\">\n          <Button variant=\"primary\" fullWidth onClick={handleRetry}>\n            Try again\n          </Button>\n          <Button\n            variant=\"secondary\"\n            fullWidth\n            onClick={() => dispatch(bookingActions.setStep(4))}\n          >\n            Back to review\n          </Button>\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":459,"startLine":1,"totalLines":459}},"tool_result_meta":[{"id":"call-6ec13c3a-a55c-4193-98a5-dd297ec22123","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
