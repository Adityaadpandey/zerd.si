{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-5255704a-f4c8-42c3-b107-9d7552b2ec27","type":"tool_result","content":"import logger from \"../config/logger\";\nimport { DatabaseError, ServiceUnavailableError } from \"./errors.util\";\n\n/**\n * Check if error is a Prisma/database error\n */\nexport const isDatabaseError = (error: any): boolean => {\n  return (\n    error?.code?.startsWith(\"P\") || // Prisma error codes\n    error?.message?.includes(\"prisma\") ||\n    error?.message?.includes(\"database\") ||\n    error?.message?.includes(\"Authentication failed\") ||\n    error?.message?.includes(\"connection\") ||\n    error?.name === \"PrismaClientKnownRequestError\" ||\n    error?.name === \"PrismaClientUnknownRequestError\" ||\n    error?.name === \"PrismaClientRustPanicError\" ||\n    error?.name === \"PrismaClientInitializationError\" ||\n    error?.name === \"PrismaClientValidationError\"\n  );\n};\n\n/**\n * Wrap database operations to catch and sanitize errors\n */\nexport const wrapDatabaseOperation = async <T>(\n  operation: () => Promise<T>,\n  operationName: string = \"Database operation\",\n): Promise<T> => {\n  try {\n    return await operation();\n  } catch (error: any) {\n    // Log the actual error for debugging\n    logger.error(`${operationName} failed`, {\n      error: error.message,\n      code: error.code,\n      meta: error.meta,\n      stack: error.stack,\n    });\n\n    // Check for specific Prisma error codes\n    if (error.code) {\n      switch (error.code) {\n        case \"P1001\": // Can't reach database server\n        case \"P1002\": // Database server timeout\n        case \"P1008\": // Operations timed out\n        case \"P1017\": // Server closed connection\n        case \"P2024\": // Timed out fetching a connection from the pool\n        case \"P2037\": // Postgres refused: too many connections open\n          throw new ServiceUnavailableError(\n            \"Database is temporarily unavailable. Please try again later.\",\n          );\n\n        case \"P2002\": {\n          // Unique constraint violation\n          const target = error.meta?.target || \"field\";\n          throw new DatabaseError(`Duplicate ${target} already exists`);\n        }\n\n        case \"P2003\": // Foreign key constraint violation\n          throw new DatabaseError(\"Related record not found\");\n\n        case \"P2025\": // Record not found\n          throw new DatabaseError(\"Record not found\");\n\n        default:\n          // Generic database error - don't expose details\n          throw new DatabaseError(\n            \"A database error occurred. Please try again later.\",\n          );\n      }\n    }\n\n    // If it's a database error but no specific code\n    if (isDatabaseError(error)) {\n      throw new ServiceUnavailableError(\n        \"Service temporarily unavailable. Please try again later.\",\n      );\n    }\n\n    // Re-throw if it's not a database error\n    throw error;\n  }\n};\n\n/**\n * Sanitize database error message for client response\n */\nexport const sanitizeDatabaseError = (error: any): string => {\n  // Never expose actual database error messages to clients\n  if (isDatabaseError(error)) {\n    // Check for connection errors\n    if (\n      error.code === \"P1001\" ||\n      error.code === \"P1002\" ||\n      error.code === \"P1008\" ||\n      error.code === \"P1017\" ||\n      error.code === \"P2024\" ||\n      error.code === \"P2037\" ||\n      error.message?.includes(\"Authentication failed\") ||\n      error.message?.includes(\"connection\")\n    ) {\n      return \"Service temporarily unavailable. Please try again later.\";\n    }\n\n    // Generic database error\n    return \"A database error occurred. Please try again later.\";\n  }\n\n  // Return original message if not a database error\n  return error.message || \"An error occurred\";\n};\n=== approval repo ===\nimport { prisma } from \"../../config/db\";\nimport { BookingStatus } from \"../../generated/prisma/enums\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n\nexport class BookingApprovalRepository {\n  /**\n   * Approve a buyer-initiated approval request.\n   *\n   * Atomic transition PENDING_APPROVAL → APPROVED_AWAITING_PAYMENT, stamping\n   * the host decision metadata, the claim token + expiry, and a fresh\n   * holdExpiresAt that gives the buyer a payment window. Inventory was\n   * already reserved at request time so no soldCount work happens here.\n   *\n   * Returns null if the booking isn't in PENDING_APPROVAL anymore (race or\n   * already-decided), letting the caller respond idempotently.\n   */\n  async approveRequestTx(input: {\n    bookingId: string;\n    decidedBy: string;\n    claimToken: string;\n    claimExpiresAt: Date;\n    paymentHoldExpiresAt: Date;\n  }): Promise<string | null> {\n    return wrapDatabaseOperation(async () => {\n      const transition = await prisma.booking.updateMany({\n        where: {\n          bookingId: input.bookingId,\n          status: BookingStatus.PENDING_APPROVAL,\n        },\n        data: {\n          status: BookingStatus.APPROVED_AWAITING_PAYMENT,\n          approvalDecidedAt: new Date(),\n          approvalDecidedBy: input.decidedBy,\n          approvalClaimToken: input.claimToken,\n          approvalClaimExpiry: input.claimExpiresAt,\n          holdExpiresAt: input.paymentHoldExpiresAt,\n        },\n      });\n\n      return transition.count === 0 ? null : input.bookingId;\n    }, \"Approve booking request\");\n  }\n\n  /**\n   * Stamp decline metadata on an already-released approval-request booking.\n   * Inventory release is handled separately via releaseHoldTx(\"CANCELLED\").\n   */\n  async stampDeclineMetadata(input: {\n    bookingId: string;\n    decidedBy: string;\n    reason?: string;\n  }): Promise<void> {\n    return wrapDatabaseOperation(async () => {\n      await prisma.booking.update({\n        where: { bookingId: input.bookingId },\n        data: {\n          approvalDecidedAt: new Date(),\n          approvalDecidedBy: input.decidedBy,\n          ...(input.reason ? { approvalDeclineReason: input.reason } : {}),\n        },\n      });\n    }, \"Stamp decline metadata\");\n  }\n\n  /**\n   * Look up an approved-awaiting-payment booking by its single-use claim\n   * token. Used by the email-link landing flow on the web client.\n   * Returns null when the token is unknown, expired, or already consumed\n   * (i.e. booking left APPROVED_AWAITING_PAYMENT).\n   */\n  async findByApprovalClaimToken(token: string) {\n    return wrapDatabaseOperation(async () => {\n      const booking = await prisma.booking.findUnique({\n        where: { approvalClaimToken: token },\n        select: {\n          bookingId: true,\n          eventId: true,\n          userId: true,\n          status: true,\n          approvalClaimExpiry: true,\n          holdExpiresAt: true,\n        },\n      });\n      if (!booking) return null;\n      if (booking.status !== BookingStatus.APPROVED_AWAITING_PAYMENT) {\n        return null;\n      }\n      if (\n        booking.approvalClaimExpiry &&\n        booking.approvalClaimExpiry < new Date()\n      ) {\n        return null;\n      }\n      return booking;\n    }, \"Find booking by approval claim token\");\n  }\n\n  /**\n   * Return any live approval-flow booking (PENDING_APPROVAL or\n   * APPROVED_AWAITING_PAYMENT) for a user+event whose hold has not expired.\n   * Used to block duplicate approval requests.\n   */\n  async findActiveApprovalByUserAndEvent(userId: string, eventId: string) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.booking.findFirst({\n        where: {\n          userId,\n          eventId,\n          status: {\n            in: [\n              BookingStatus.PENDING_APPROVAL,\n              BookingStatus.APPROVED_AWAITING_PAYMENT,\n            ],\n          },\n          holdExpiresAt: { gt: new Date() },\n        },\n        select: { bookingId: true, status: true },\n      });\n    }, \"Find active approval booking by user and event\");\n  }\n\n  /**\n   * Return the most-recent APPROVED_AWAITING_PAYMENT booking for a user+event\n   * whose hold has not yet expired. Used by the event page to surface a\n   * \"Complete your booking\" banner without requiring the email-link token.\n   */\n  async findApprovedAwaitingPaymentByUserAndEvent(\n    userId: string,\n    eventId: string,\n  ) {\n    return wrapDatabaseOperation(async () => {\n      return await prisma.booking.findFirst({\n        where: {\n          userId,\n          eventId,\n          status: BookingStatus.APPROVED_AWAITING_PAYMENT,\n          holdExpiresAt: { gt: new Date() },\n        },\n        orderBy: { createdAt: \"desc\" },\n        select: {\n          bookingId: true,\n          eventId: true,\n          holdExpiresAt: true,\n          total: true,\n        },\n      });\n    }, \"Find approved-awaiting-payment booking by user and event\");\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"84e6b8d1-1ade-4457-87a5-5d7b3fb9fceb","timestamp":"2026-11-20T19:33:10.126Z","tool_use_result":{"stdout":"import logger from \"../config/logger\";\nimport { DatabaseError, ServiceUnavailableError } from \"./errors.util\";\n\n/**\n * Check if error is a Prisma/database error\n */\nexport const isDatabaseError = (error: any): boolean => {\n  return (\n    error?.code?.startsWith(\"P\") || // Prisma error codes\n    error?.message?.includes(\"prisma\") ||\n    error?.message?.includes(\"database\") ||\n    error?.message?.includes(\"Authentication failed\") ||\n    error?.message?.includes(\"connection\") ||\n    error?.name === \"PrismaClientKnownRequestError\" ||\n    error?.name === \"PrismaClientUnknownRequestError\" ||\n    error?.name === \"PrismaClientRustPanicError\" ||\n    error?.name === \"PrismaClientInitializationError\" ||\n    error?.name === \"PrismaClientValidationError\