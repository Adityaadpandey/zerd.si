{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-26e25564-01e5-4374-815d-f78bfb0f770c","type":"tool_result","content":"import { expect, test } from \"@playwright/test\";\nimport { runWebhookOnce } from \"../src/utils/webhook-dedup.util\";\n\ntest(\"skips the work when the event was already claimed\", async () => {\n  let ran = false;\n  await runWebhookOnce(\n    { claim: async () => false, release: async () => {} },\n    async () => {\n      ran = true;\n    },\n  );\n  expect(ran).toBe(false);\n});\n\ntest(\"runs the work once when the claim succeeds\", async () => {\n  let runs = 0;\n  let released = false;\n  await runWebhookOnce(\n    {\n      claim: async () => true,\n      release: async () => {\n        released = true;\n      },\n    },\n    async () => {\n      runs++;\n    },\n  );\n  expect(runs).toBe(1);\n  expect(released).toBe(false);\n});\n\ntest(\"releases the claim and rethrows when the work fails, so Razorpay's retry can run\", async () => {\n  let released = false;\n  await expect(\n    runWebhookOnce(\n      {\n        claim: async () => true,\n        release: async () => {\n          released = true;\n        },\n      },\n      async () => {\n        throw new Error(\"db down\");\n      },\n    ),\n  ).rejects.toThrow(\"db down\");\n  expect(released).toBe(true);\n});\n\ntest(\"a failing release never hides the original error\", async () => {\n  await expect(\n    runWebhookOnce(\n      {\n        claim: async () => true,\n        release: async () => {\n          throw new Error(\"release failed\");\n        },\n      },\n      async () => {\n        throw new Error(\"original\");\n      },\n    ),\n  ).rejects.toThrow(\"original\");\n});\n=== payment-api-contract ===\nimport { test, expect } from \"@playwright/test\";\nimport { PaymentController } from \"../src/controllers/payment.controller\";\nimport { PaymentService } from \"../src/services/payment.service\";\nimport { config } from \"../src/config\";\nimport {\n  