{"type":"assistant","message":{"id":"msg_1fe44fe4-bd15-4c41-a973-bd8b549c0fce","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call-50e17cca-5a27-4a70-b7b3-a1eca7837f34","name":"Bash","input":{"command":"echo \"=== inventory reconciler ===\" && cat src/workers/inventory-reconciler.worker.ts && echo \"=== inventory reconciliation repo ===\" && cat src/repositories/ticket/inventory-reconciliation.repository.ts","description":"Read inventory reconciler"}}],"model":"MiniMaxAI/MiniMax-M3","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"9d06b065-40f6-4202-b409-e3ae7970a431","timestamp":"2026-11-20T19:26:44.004Z","wire_tool_inputs":{"call-50e17cca-5a27-4a70-b7b3-a1eca7837f34":{"command":"cd /private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server && echo \"=== inventory reconciler ===\" && cat src/workers/inventory-reconciler.worker.ts && echo \"=== inventory reconciliation repo ===\" && cat src/repositories/ticket/inventory-reconciliation.repository.ts","description":"Read inventory reconciler"}},"wire_ingest_context":{"call-50e17cca-5a27-4a70-b7b3-a1eca7837f34":{"cwd":"/private/var/folders/l9/28lkl3090p9dzbh6jvml0kkr0000gn/T/zerd-duel-zpf_oqz9/tunyt/apps/server"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-50e17cca-5a27-4a70-b7b3-a1eca7837f34","type":"tool_result","content":"=== inventory reconciler ===\nimport { type Job, Worker } from \"bullmq\";\nimport { redis } from \"../config/redis\";\nimport { delTicketTypeCache } from \"../lib/cache/ticket\";\nimport { getLogger } from \"../lib/logger\";\nimport { TicketRepository } from \"../repositories/ticket.repository\";\n\nconst logger = getLogger(\"Inventory Reconciler Worker\", \"debug\");\nconst ticketRepository = new TicketRepository();\n\n/**\n * Periodically re-derives TicketType.soldCount and discountSoldCount from\n * the live Ticket + Booking state. Self-heals any drift introduced by paths\n * that mutate booking status without going through releaseHoldTx (e.g. the\n * historical guests.decline raw status flip).\n *\n * Runs after booking-expiry has had a chance to clean up stale HELD rows,\n * so the truth set (HELD ∪ PAID) reflects only live inventory.\n */\nexport const inventoryReconcilerWorker = new Worker(\n  \"inventory-reconciler\",\n  async (job: Job) => {\n    if (job.name !== \"sweep\") return;\n\n    const { updatedTypes, affectedEventIds } =\n      await ticketRepository.reconcileInventoryCounters();\n\n    if (updatedTypes > 0) {\n      logger.warn(\"Inventory drift corrected\", {\n        updatedTypes,\n        affectedEvents: affectedEventIds.length,\n      });\n\n      // Drop the 10-min ticket-type cache for every affected event so the\n      // public event page surfaces the corrected counters on the next fetch.\n      await Promise.all(affectedEventIds.map((id) => delTicketTypeCache(id)));\n    } else {\n      logger.debug(\"Inventory reconciler: no drift\");\n    }\n\n    return { updatedTypes, affectedEvents: affectedEventIds.length };\n  },\n  {\n    connection: redis,\n    concurrency: 1,\n  },\n);\n\ninventoryReconcilerWorker.on(\"failed\", (job: Job | undefined, err: Error) => {\n  logger.error(\"Inventory reconciler job failed\", {\n    jobId: job?.id,\n    err: err.message,\n  });\n});\n\n=== inventory reconciliation repo ===\nimport { prisma } from \"../../config/db\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n\nexport class InventoryReconciliationRepository {\n  /**\n   * Re-derive `soldCount` and `discountSoldCount` for every TicketType from\n   * the actual Ticket + Booking state.\n   *\n   * Truth: a seat counts toward inventory iff its booking is HELD or PAID\n   * AND the ticket itself hasn't been individually refunded or FAILED — a\n   * booking can stay PAID overall while one of its tickets was refunded (or\n   * failed independently, e.g. a hold-expiry race that only hit one ticket\n   * on a multi-ticket booking), and that seat must not keep counting as\n   * sold. (HELD bookings whose hold has expired get released by\n   * booking-expiry — which runs more frequently than this reconciler, so by\n   * the time we fire those have already transitioned to EXPIRED.)\n   *\n   * Sums `t.quantity`, not row count — a single GA Ticket row can bundle\n   * multiple seats under one QR (reserved-seating rows are always quantity 1,\n   * but GA rows aren't), so COUNT(*) would undercount those.\n   *\n   * Side effect: returns the list of eventIds whose ticket types changed,\n   * so the caller can drop their Redis caches.\n   */\n  async reconcileInventoryCounters(): Promise<{\n    updatedTypes: number;\n    affectedEventIds: string[];\n  }> {\n    return wrapDatabaseOperation(async () => {\n      // Single round-trip: derive correct values, update only the rows that\n      // drift, return their eventIds via RETURNING.\n      const rows = await prisma.$queryRaw<Array<{ eventId: string }>>`\n        WITH live_bookings AS MATERIALIZED (\n          SELECT \"bookingId\"\n          FROM \"Booking\"\n          WHERE \"status\" IN ('HELD', 'PAID')\n        ),\n        live AS (\n          SELECT\n            t.\"ticketTypeId\",\n            COALESCE(SUM(t.quantity), 0)                                  AS total,\n            COALESCE(SUM(t.quantity) FILTER (WHERE t.\"wasDiscounted\"), 0) AS discounted\n          FROM \"Ticket\" t\n          JOIN live_bookings b ON b.\"bookingId\" = t.\"bookingId\"\n          WHERE t.\"ticketTypeId\" IS NOT NULL\n            AND t.\"status\" NOT IN ('REFUNDED', 'FAILED')\n          GROUP BY t.\"ticketTypeId\"\n        ),\n        target AS (\n          SELECT\n            tt.\"ticketTypeId\",\n            COALESCE(live.total, 0)::int AS new_sold,\n            LEAST(\n              COALESCE(live.discounted, 0),\n              COALESCE(tt.\"discountQuantity\", COALESCE(live.discounted, 0))\n            )::int AS new_discount_sold\n          FROM \"TicketType\" tt\n          LEFT JOIN live ON live.\"ticketTypeId\" = tt.\"ticketTypeId\"\n        )\n        UPDATE \"TicketType\" tt\n        SET \"soldCount\" = target.new_sold,\n            \"discountSoldCount\" = target.new_discount_sold\n        FROM target\n        WHERE tt.\"ticketTypeId\" = target.\"ticketTypeId\"\n          AND (\n            tt.\"soldCount\" IS DISTINCT FROM target.new_sold\n            OR tt.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\n          )\n        RETURNING tt.\"eventId\"\n      `;\n\n      // Bundle-level discount slots: TicketTypeGroup.discountSoldCount.\n      // A single bundle-unit purchase produces one Ticket row per member\n      // ticket type in the group, all sharing the same bookingId,\n      // bundleGroupId, and (per Task 5) an identical quantity. Counting\n      // those rows with COUNT(*) would multiply the true consumed count by\n      // the group's member count, so instead: first collapse each\n      // booking's member rows down to a single quantity via MAX (mirrors\n      // the Math.max done in booking.repository.ts's reserveInventoryTx/\n      // release path), then SUM across bookings to get the true total\n      // consumed for the group.\n      const groupRows = await prisma.$queryRaw<Array<{ eventId: string }>>`\n        WITH live_bookings AS MATERIALIZED (\n          SELECT \"bookingId\"\n          FROM \"Booking\"\n          WHERE \"status\" IN ('HELD', 'PAID')\n        ),\n        per_booking AS (\n          SELECT\n            t.\"bundleGroupId\",\n            t.\"bookingId\",\n            MAX(t.\"quantity\") AS booking_qty\n          FROM \"Ticket\" t\n          JOIN live_bookings b ON b.\"bookingId\" = t.\"bookingId\"\n          WHERE t.\"bundleGroupId\" IS NOT NULL\n            AND t.\"bundleWasDiscounted\"\n          GROUP BY t.\"bundleGroupId\", t.\"bookingId\"\n        ),\n        live AS (\n          SELECT\n            \"bundleGroupId\",\n            SUM(booking_qty)::int AS discounted\n          FROM per_booking\n          GROUP BY \"bundleGroupId\"\n        ),\n        target AS (\n          SELECT\n            g.\"groupId\",\n            g.\"eventId\",\n            LEAST(\n              COALESCE(live.discounted, 0),\n              COALESCE(g.\"discountQuantity\", COALESCE(live.discounted, 0))\n            )::int AS new_discount_sold\n          FROM \"TicketTypeGroup\" g\n          LEFT JOIN live ON live.\"bundleGroupId\" = g.\"groupId\"\n        )\n        UPDATE \"TicketTypeGroup\" g\n        SET \"discountSoldCount\" = target.new_discount_sold\n        FROM target\n        WHERE g.\"groupId\" = target.\"groupId\"\n          AND g.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\n        RETURNING target.\"eventId\"\n      `;\n\n      const affectedEventIds = [\n        ...new Set([\n          ...rows.map((r) => r.eventId),\n          ...groupRows.map((r) => r.eventId),\n        ]),\n      ];\n      return {\n        updatedTypes: rows.length + groupRows.length,\n        affectedEventIds,\n      };\n    }, \"Reconcile inventory counters\");\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"d8d07a5e-69a0-4a74-a632-e087c951dc8a","timestamp":"2026-11-20T19:26:44.600Z","tool_use_result":{"stdout":"=== inventory reconciler ===\nimport { type Job, Worker } from \"bullmq\";\nimport { redis } from \"../config/redis\";\nimport { delTicketTypeCache } from \"../lib/cache/ticket\";\nimport { getLogger } from \"../lib/logger\";\nimport { TicketRepository } from \"../repositories/ticket.repository\";\n\nconst logger = getLogger(\"Inventory Reconciler Worker\", \"debug\");\nconst ticketRepository = new TicketRepository();\n\n/**\n * Periodically re-derives TicketType.soldCount and discountSoldCount from\n * the live Ticket + Booking state. Self-heals any drift introduced by paths\n * that mutate booking status without going through releaseHoldTx (e.g. the\n * historical guests.decline raw status flip).\n *\n * Runs after booking-expiry has had a chance to clean up stale HELD rows,\n * so the truth set (HELD ∪ PAID) reflects only live inventory.\n */\nexport const inventoryReconcilerWorker = new Worker(\n  \"inventory-reconciler\",\n  async (job: Job) => {\n    if (job.name !== \"sweep\") return;\n\n    const { updatedTypes, affectedEventIds } =\n      await ticketRepository.reconcileInventoryCounters();\n\n    if (updatedTypes > 0) {\n      logger.warn(\"Inventory drift corrected\", {\n        updatedTypes,\n        affectedEvents: affectedEventIds.length,\n      });\n\n      // Drop the 10-min ticket-type cache for every affected event so the\n      // public event page surfaces the corrected counters on the next fetch.\n      await Promise.all(affectedEventIds.map((id) => delTicketTypeCache(id)));\n    } else {\n      logger.debug(\"Inventory reconciler: no drift\");\n    }\n\n    return { updatedTypes, affectedEvents: affectedEventIds.length };\n  },\n  {\n    connection: redis,\n    concurrency: 1,\n  },\n);\n\ninventoryReconcilerWorker.on(\"failed\", (job: Job | undefined, err: Error) => {\n  logger.error(\"Inventory reconciler job failed\", {\n    jobId: job?.id,\n    err: err.message,\n  });\n});\n\n=== inventory reconciliation repo ===\nimport { prisma } from \"../../config/db\";\nimport { wrapDatabaseOperation } from \"../../utils/database-error-handler.util\";\n\nexport class InventoryReconciliationRepository {\n  /**\n   * Re-derive `soldCount` and `discountSoldCount` for every TicketType from\n   * the actual Ticket + Booking state.\n   *\n   * Truth: a seat counts toward inventory iff its booking is HELD or PAID\n   * AND the ticket itself hasn't been individually refunded or FAILED — a\n   * booking can stay PAID overall while one of its tickets was refunded (or\n   * failed independently, e.g. a hold-expiry race that only hit one ticket\n   * on a multi-ticket booking), and that seat must not keep counting as\n   * sold. (HELD bookings whose hold has expired get released by\n   * booking-expiry — which runs more frequently than this reconciler, so by\n   * the time we fire those have already transitioned to EXPIRED.)\n   *\n   * Sums `t.quantity`, not row count — a single GA Ticket row can bundle\n   * multiple seats under one QR (reserved-seating rows are always quantity 1,\n   * but GA rows aren't), so COUNT(*) would undercount those.\n   *\n   * Side effect: returns the list of eventIds whose ticket types changed,\n   * so the caller can drop their Redis caches.\n   */\n  async reconcileInventoryCounters(): Promise<{\n    updatedTypes: number;\n    affectedEventIds: string[];\n  }> {\n    return wrapDatabaseOperation(async () => {\n      // Single round-trip: derive correct values, update only the rows that\n      // drift, return their eventIds via RETURNING.\n      const rows = await prisma.$queryRaw<Array<{ eventId: string }>>`\n        WITH live_bookings AS MATERIALIZED (\n          SELECT \"bookingId\"\n          FROM \"Booking\"\n          WHERE \"status\" IN ('HELD', 'PAID')\n        ),\n        live AS (\n          SELECT\n            t.\"ticketTypeId\",\n            COALESCE(SUM(t.quantity), 0)                                  AS total,\n            COALESCE(SUM(t.quantity) FILTER (WHERE t.\"wasDiscounted\"), 0) AS discounted\n          FROM \"Ticket\" t\n          JOIN live_bookings b ON b.\"bookingId\" = t.\"bookingId\"\n          WHERE t.\"ticketTypeId\" IS NOT NULL\n            AND t.\"status\" NOT IN ('REFUNDED', 'FAILED')\n          GROUP BY t.\"ticketTypeId\"\n        ),\n        target AS (\n          SELECT\n            tt.\"ticketTypeId\",\n            COALESCE(live.total, 0)::int AS new_sold,\n            LEAST(\n              COALESCE(live.discounted, 0),\n              COALESCE(tt.\"discountQuantity\", COALESCE(live.discounted, 0))\n            )::int AS new_discount_sold\n          FROM \"TicketType\" tt\n          LEFT JOIN live ON live.\"ticketTypeId\" = tt.\"ticketTypeId\"\n        )\n        UPDATE \"TicketType\" tt\n        SET \"soldCount\" = target.new_sold,\n            \"discountSoldCount\" = target.new_discount_sold\n        FROM target\n        WHERE tt.\"ticketTypeId\" = target.\"ticketTypeId\"\n          AND (\n            tt.\"soldCount\" IS DISTINCT FROM target.new_sold\n            OR tt.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\n          )\n        RETURNING tt.\"eventId\"\n      `;\n\n      // Bundle-level discount slots: TicketTypeGroup.discountSoldCount.\n      // A single bundle-unit purchase produces one Ticket row per member\n      // ticket type in the group, all sharing the same bookingId,\n      // bundleGroupId, and (per Task 5) an identical quantity. Counting\n      // those rows with COUNT(*) would multiply the true consumed count by\n      // the group's member count, so instead: first collapse each\n      // booking's member rows down to a single quantity via MAX (mirrors\n      // the Math.max done in booking.repository.ts's reserveInventoryTx/\n      // release path), then SUM across bookings to get the true total\n      // consumed for the group.\n      const groupRows = await prisma.$queryRaw<Array<{ eventId: string }>>`\n        WITH live_bookings AS MATERIALIZED (\n          SELECT \"bookingId\"\n          FROM \"Booking\"\n          WHERE \"status\" IN ('HELD', 'PAID')\n        ),\n        per_booking AS (\n          SELECT\n            t.\"bundleGroupId\",\n            t.\"bookingId\",\n            MAX(t.\"quantity\") AS booking_qty\n          FROM \"Ticket\" t\n          JOIN live_bookings b ON b.\"bookingId\" = t.\"bookingId\"\n          WHERE t.\"bundleGroupId\" IS NOT NULL\n            AND t.\"bundleWasDiscounted\"\n          GROUP BY t.\"bundleGroupId\", t.\"bookingId\"\n        ),\n        live AS (\n          SELECT\n            \"bundleGroupId\",\n            SUM(booking_qty)::int AS discounted\n          FROM per_booking\n          GROUP BY \"bundleGroupId\"\n        ),\n        target AS (\n          SELECT\n            g.\"groupId\",\n            g.\"eventId\",\n            LEAST(\n              COALESCE(live.discounted, 0),\n              COALESCE(g.\"discountQuantity\", COALESCE(live.discounted, 0))\n            )::int AS new_discount_sold\n          FROM \"TicketTypeGroup\" g\n          LEFT JOIN live ON live.\"bundleGroupId\" = g.\"groupId\"\n        )\n        UPDATE \"TicketTypeGroup\" g\n        SET \"discountSoldCount\" = target.new_discount_sold\n        FROM target\n        WHERE g.\"groupId\" = target.\"groupId\"\n          AND g.\"discountSoldCount\" IS DISTINCT FROM target.new_discount_sold\n        RETURNING target.\"eventId\"\n      `;\n\n      const affectedEventIds = [\n        ...new Set([\n          ...rows.map((r) => r.eventId),\n          ...groupRows.map((r) => r.eventId),\n        ]),\n      ];\n      return {\n        updatedTypes: rows.length + groupRows.length,\n        affectedEventIds,\n      };\n    }, \"Reconcile inventory counters\");\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call-50e17cca-5a27-4a70-b7b3-a1eca7837f34","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
