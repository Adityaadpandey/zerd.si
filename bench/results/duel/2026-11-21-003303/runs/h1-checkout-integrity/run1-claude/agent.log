{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call-1de90821-671c-4d62-87e8-cdab101ecac3","type":"tool_result","content":"3321:model Booking {\n3322-  bookingId            String            @id @default(cuid())\n3323-  userId               String\n3324-  eventId              String\n3325-  status               BookingStatus     @default(HELD)\n3326-  subtotal             Float // rupees (matches Payment/TicketType convention; Razorpay paise conversion happens at boundary)\n3327-  discountCodeId       String?\n3328-  discountAmount       Float             @default(0)\n3329-  // Tunyt's cut (sum of per-ticket platformFee snapshots).\n3330-  platformFee          Float             @default(0)\n3331-  // Razorpay's cut (sum of per-ticket gatewayFee snapshots).\n3332-  gatewayFee           Float             @default(0)\n3333-  // 18% GST on platform fee (sum of per-ticket gst snapshots).\n3334-  gst                  Float             @default(0)\n3335-  // Who paid platform + gateway fees on this booking. MIXED if the booking\n3336-  // spans ticket types with different feeBornBy settings.\n3337-  feesBornBy           BookingFeesBornBy @default(HOST)\n3338-  total                Float\n3339-  holdExpiresAt        DateTime\n3340-  qrCode               String?           @unique\n3341-  city                 String?\n3342-  state                String?\n3343-  userAgent            String?\n3344-  referrer             String?\n3345-  commonFieldResponses Json              @default(\"[]\")\n3346-  registrationAnswers  Json              @default(\"{}\")\n3347-\n3348-  // Door sales. doorStaffId is set only for bookings made at the counter, so\n3349-  // \"is this a door sale\" is simply doorStaffId != null.\n3350-  paymentMode      BookingPaymentMode @default(ONLINE)\n3351-  doorStaffId      String?\n3352-  doorStaff        DoorSalesStaff?    @relation(fields: [doorStaffId], references: [doorStaffId])\n3353-  cashReason       String? // required whenever paymentMode is CASH\n3354-  guestPhone       String? // optional, for support only. Nothing is sent to it.\n3355-  razorpayQrCodeId String?            @unique // the single-use UPI QR shown at the counter\n3356-\n3357-  // Set when the booking was started from a Host API checkout session.\n3358-  checkoutSessionId String? @unique\n3359-\n3360-  // Approval-based events: buyer-initiated request flow.\n3361-  // When status is PENDING_APPROVAL the booking holds inventory but has no\n3362-  // payment record. On approve, host transitions to APPROVED_AWAITING_PAYMENT\n3363-  // and a claim token is generated so the buyer can resume at the payment step.\n3364-  approvalClaimToken    String?   @unique\n3365-  approvalClaimExpiry   DateTime?\n3366-  approvalRequestedAt   DateTime?\n3367-  approvalDecidedAt     DateTime?\n3368-  approvalDecidedBy     String? // userId of the host (or co-host) who approved/declined\n3369-  approvalDeclineReason String?\n3370-\n3371-  createdAt DateTime @default(now())\n3372-  updatedAt DateTime @updatedAt\n3373-\n3374-  user         User            @relation(fields: [userId], references: [userId])\n3375-  event        Event           @relation(fields: [eventId], references: [eventId])\n3376-  discountCode DiscountCode?   @relation(fields: [discountCodeId], references: [codeId])\n3377-  tickets      Ticket[]\n3378-  payment      Payment?\n3379-  feedbacks    EventFeedback[]\n3380-  slotBookings SlotBooking[]   @relation(\"SlotBookingToBooking\")\n3381-  heldSeats    Seat[]\n3382-\n3383-  @@index([holdExpiresAt, status])\n3384-  @@index([status, holdExpiresAt]) // expiry worker: equality-then-range\n3385-  @@index([userId, createdAt])\n3386-  @@index([userId, status, createdAt(sort: Desc)]) // paginated my-tickets\n3387-  @@index([eventId, status])\n3388-  @@index([eventId, status, createdAt(sort: Desc)])\n3389-  @@index([eventId, createdAt(sort: Desc)]) // event activity feed\n3390-  @@index([eventId, city])\n3391-  @@index([approvalClaimToken])\n3392-  @@index([eventId, status, approvalRequestedAt(sort: Desc)])\n3393-  @@index([doorStaffId])\n3394-}\n3395-\n3396-// How a booking was actually paid. Only door sales can be CASH today.\n3397-enum BookingPaymentMode {\n3398-  ONLINE\n3399-  CASH\n3400-}\n3401-\n3402-// Counter staff for ONE event. Separate from TicketChecker on purpose: one\n3403-// scans tickets, this one moves money, and a bug in one should not reach the other.\n3404-model DoorSalesStaff {\n3405-  doorStaffId  String    @id @default(uuid(7))\n3406-  eventId      String\n3407-  event        Event     @relation(fields: [eventId], references: [eventId])\n3408-  name         String?\n3409-  username     String\n3410-  passwordHash String\n3411-  active       Boolean   @default(true)","is_error":false}]},"parent_tool_use_id":null,"session_id":"dd825012-52aa-4f5b-b0f6-761df9f383e4","uuid":"3ffca927-9c88-4ee7-8211-a794266a51a2","timestamp":"2026-11-20T19:04:50.474Z","tool_use_result":{"stdout":"3321:model Booking {\n3322-  bookingId            String            @id @default(cuid())\n3323-  userId               String\n3324-  eventId              String\n3325-  status               BookingStatus     @default(HELD)\n3326-  subtotal             Float // rupees (matches Payment/TicketType convention; Razorpay paise conversion happens at boundary)\n3327-  discountCodeId       String?\n3328-  discountAmount       Float             @default(0)\n3329-  // Tunyt's cut (sum of per-ticket platformFee snapshots).\n3330-  platformFee          Float             @default(0)\n3331-  // Razorpay's cut (sum of per-ticket gatewayFee snapshots).\n3332-  gatewayFee           Float             @default(0)\n3333-  // 18% GST on platform fee (sum of per-ticket gst snapshots).\n3334-  gst                  Float             @default(0)\n3335-  // Who paid platform + gateway fees on this booking. MIXED if the booking\n3336-  // spans ticket types with different feeBornBy settings.\n3337-  feesBornBy           BookingFeesBornB