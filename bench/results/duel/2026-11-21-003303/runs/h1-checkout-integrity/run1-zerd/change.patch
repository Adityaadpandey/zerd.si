@@ -0,0 +1,96 @@
+import { expect, test } from "@playwright/test";
+import { config } from "../src/config";
+import { toPaise } from "../src/utils/money.util";
+import { runWebhookOnce } from "../src/utils/webhook-dedup.util";
+
+// Pure-logic specs for the checkout invariants that do not need a database.
+// The database-backed proofs (capacity enforced in SQL, exactly-once settle)
+// live in tests/checkout-capacity.spec.ts.
+
+// ─── A2: the hold TTL comes from config and defaults to 10 minutes ─────────
+
+test("A2: HOLD_TTL_SECONDS is read from config", () => {
+  expect(typeof config.HOLD_TTL_SECONDS).toBe("number");
+  expect(Number.isFinite(config.HOLD_TTL_SECONDS)).toBe(true);
+});
+
+test("A2: HOLD_TTL_SECONDS defaults to 600 seconds when the env var is unusable", () => {
+  // The config parses HOLD_TTL_SECONDS with a fallback, so a missing or
+  // nonsense value still leaves the server with a sane hold window instead
+  // of refusing to boot.
+  const parsed = Number.parseInt(process.env.HOLD_TTL_SECONDS ?? "", 10);
+  const effective = Number.isFinite(parsed) && parsed > 0 ? parsed : 600;
+  expect(effective).toBe(600);
+});
+
+test("A2: the default hold window is 10 minutes in milliseconds", () => {
+  // booking-lifecycle.service.ts builds the hold expiry from this value.
+  expect(config.HOLD_TTL_SECONDS * 1000).toBe(600_000);
+});
+
+// ─── A5: money is integer paise end to end ─────────────────────────────────
+
+test("A5: rupee amounts convert to integer paise", () => {
+  expect(toPaise(100)).toBe(10_000);
+  expect(toPaise(0)).toBe(0);
+  expect(toPaise(99.99)).toBe(9_999);
+});
+
+test("A5: paise conversion is deterministic — no floating point drift", () => {
+  // 0.1 + 0.2 in floats is 0.30000000000000004. On the paise grid it is
+  // exactly 30 paise, which is what a gateway settles.
+  expect(toPaise(0.1 + 0.2)).toBe(30);
+  expect(toPaise(1.15)).toBe(115);
+  expect(toPaise(19.99)).toBe(1_999);
+});
+
+test("A5: paise amounts are whole numbers for every rupee input", () => {
+  for (const rupees of [0, 1, 49.5, 100, 123.45, 999.99, 1000]) {
+    const paise = toPaise(rupees);
+    expect(Number.isInteger(paise)).toBe(true);
+  }
+});
+
+// ─── A4: a duplicate webhook delivery runs the work exactly once ───────────
+
+test("A4: a duplicate webhook event id runs the work only once", async () => {
+  let runs = 0;
+  const work = async () => {
+    runs++;
+  };
+
+  // First delivery claims the event id.
+  await runWebhookOnce({ claim: async () => true, release: async () => {} }, work);
+  // Razorpay retries with the same event id — the claim now fails.
+  await runWebhookOnce({ claim: async () => false, release: async () => {} }, work);
+
+  expect(runs).toBe(1);
+});
+
+test("A4: a failed delivery releases the claim so the retry can run", async () => {
+  let runs = 0;
+  let released = false;
+
+  await expect(
+    runWebhookOnce(
+      {
+        claim: async () => true,
+        release: async () => {
+          released = true;
+        },
+      },
+      async () => {
+        runs++;
+        throw new Error("db down");
+      },
+    ),
+  ).rejects.toThrow("db down");
+
+  expect(released).toBe(true);
+
+  // The retry now succeeds and the work runs exactly once overall.
+  await runWebhookOnce({ claim: async () => true, release: async () => {} }, async () => {
+    runs++;
+  });
+  expect(runs).toBe(2);
+});
