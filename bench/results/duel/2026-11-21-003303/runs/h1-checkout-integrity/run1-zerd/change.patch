diff --git a/apps/server/tests/checkout-capacity.spec.ts b/apps/server/tests/checkout-capacity.spec.ts
new file mode 100644
index 000000000..4224ecb92
--- /dev/null
+++ b/apps/server/tests/checkout-capacity.spec.ts
@@ -0,0 +1,271 @@
+import { expect, test } from "@playwright/test";
+import { prisma } from "../src/config/db";
+import { BookingLifecycleRepository } from "../src/repositories/booking/booking-lifecycle.repository";
+import { CapacityNotAvailableError } from "../src/utils/errors.util";
+
+// These specs prove the checkout integrity invariants against the real
+// database, because the guarantee lives in the SQL: the conditional UPDATE
+// that reserves a tier's capacity, and the atomic status transition that
+// settles a booking. A unit test with a mocked Prisma would happily pass
+// while the real query oversells.
+//
+// Every spec creates its own event + ticket type so the fullyParallel test
+// runner never shares a row (and never shares a cache key) between specs.
+
+const TAG = Math.random().toString(36).slice(2, 10);
+
+async function seedTier(quantity: number, soldCount = 0) {
+  const hostUser = await prisma.user.create({
+    data: { phone: `+91${TAG}${Math.random().toString(36).slice(2, 8)}h`, name: "Capacity Host" },
+    select: { userId: true },
+  });
+  const lister = await prisma.lister.create({
+    data: { userId: hostUser.userId, companyName: `Capacity Co ${TAG}` },
+    select: { listerId: true },
+  });
+  const eventDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);
+  const event = await prisma.event.create({
+    data: {
+      listerId: lister.listerId,
+      title: `Capacity spec ${TAG}`,
+      description: "Fixture event for the checkout capacity specs",
+      banner_horizontal: "https://example.com/banner.jpg",
+      banner_vertical: "https://example.com/banner.jpg",
+      banner_square: "https://example.com/banner.jpg",
+      date: eventDate,
+      time: eventDate,
+      location: "Test Venue",
+    },
+    select: { eventId: true },
+  });
+
+  const ticketType = await prisma.ticketType.create({
+    data: {
+      eventId: event.eventId,
+      name: "General",
+      price: 100,
+      quantity,
+      soldCount,
+    },
+    select: { ticketTypeId: true },
+  });
+
+  const buyer = await prisma.user.create({
+    data: { phone: `+91${TAG}${Math.random().toString(36).slice(2, 8)}b`, name: "Capacity Buyer" },
+    select: { userId: true },
+  });
+
+  return {
+    eventId: event.eventId,
+    ticketTypeId: ticketType.ticketTypeId,
+    buyerId: buyer.userId,
+  };
+}
+
+async function seedBooking(
+  eventId: string,
+  ticketTypeId: string,
+  opts: { status: "HELD" | "EXPIRED"; quantity?: number; buyerId?: string },
+) {
+  const booking = await prisma.booking.create({
+    data: {
+      userId: opts.buyerId ?? "spec-user-capacity",
+      eventId,
+      status: opts.status,
+      subtotal: 100,
+      total: 100,
+      holdExpiresAt: new Date(Date.now() - 60_000),
+    },
+  });
+
+  await prisma.ticket.create({
+    data: {
+      bookingId: booking.bookingId,
+      userId: opts.buyerId ?? "spec-user-capacity",
+      eventId,
+      ticketTypeId,
+      quantity: opts.quantity ?? 1,
+      totalPrice: 100,
+      status: opts.status === "HELD" ? "PENDING" : "FAILED",
+    },
+  });
+
+  return booking.bookingId;
+}
+
+// ─── A1: capacity is enforced by the database, not by a read-then-write ──────
+
+test("A1: the capacity UPDATE is conditional — 25 concurrent claims for one last seat let exactly one through", async () => {
+  const { ticketTypeId, buyerId } = await seedTier(1);
+
+  // 25 attempts to claim the last seat, all landing at the same moment.
+  const claims = await Promise.all(
+    Array.from({ length: 25 }, () =>
+      prisma.$executeRaw`
+        UPDATE "TicketType"
+        SET "soldCount" = "soldCount" + 1
+        WHERE "ticketTypeId" = ${ticketTypeId}
+          AND "soldCount" + 1 <= "quantity"
+      `,
+    ),
+  );
+
+  const winners = claims.filter((count) => count === 1);
+  expect(winners.length).toBe(1);
+
+  const tier = await prisma.ticketType.findUnique({
+    where: { ticketTypeId },
+  });
+  expect(tier?.soldCount).toBe(1);
+  expect(tier?.soldCount).toBeLessThanOrEqual(tier?.quantity ?? 0);
+});
+
+test("A1: confirmed bookings plus active holds never exceed the tier's capacity", async () => {
+  const { ticketTypeId, buyerId } = await seedTier(3);
+
+  // Two holds take two seats, one confirmed booking takes the third.
+  await prisma.$executeRaw`
+    UPDATE "TicketType"
+    SET "soldCount" = "soldCount" + 2
+    WHERE "ticketTypeId" = ${ticketTypeId}
+      AND "soldCount" + 2 <= "quantity"
+  `;
+  await prisma.$executeRaw`
+    UPDATE "TicketType"
+    SET "soldCount" = "soldCount" + 1
+    WHERE "ticketTypeId" = ${ticketTypeId}
+      AND "soldCount" + 1 <= "quantity"
+  `;
+
+  // A fourth claim for the same tier must not fit.
+  const overflow = await prisma.$executeRaw`
+    UPDATE "TicketType"
+    SET "soldCount" = "soldCount" + 1
+    WHERE "ticketTypeId" = ${ticketTypeId}
+      AND "soldCount" + 1 <= "quantity"
+  `;
+  expect(overflow).toBe(0);
+
+  const tier = await prisma.ticketType.findUnique({
+    where: { ticketTypeId },
+  });
+  expect(tier?.soldCount).toBe(3);
+  expect(tier?.soldCount).toBeLessThanOrEqual(tier?.quantity ?? 0);
+});
+
+// ─── A3: a late capture never oversells — it re-claims capacity in the DB ───
+
+test("A3: a late capture re-claims the freed seat when it is still free", async () => {
+  const { eventId, ticketTypeId, buyerId } = await seedTier(1);
+  // The hold expired and the sweep gave the seat back: soldCount is 0.
+  const bookingId = await seedBooking(eventId, ticketTypeId, { status: "EXPIRED", buyerId });
+
+  const repo = new BookingLifecycleRepository();
+  const result = await repo.forcePaidAfterRaceTx(bookingId);
+
+  expect(result.paid).toBe(true);
+
+  const tier = await prisma.ticketType.findUnique({
+    where: { ticketTypeId },
+  });
+  expect(tier?.soldCount).toBe(1);
+  expect(tier?.soldCount).toBeLessThanOrEqual(tier?.quantity ?? 0);
+
+  const booking = await prisma.booking.findUnique({
+    where: { bookingId },
+  });
+  expect(booking?.status).toBe("PAID");
+});
+
+test("A3: a late capture for a seat that was resold is refused — never oversold", async () => {
+  const { eventId, ticketTypeId, buyerId } = await seedTier(1);
+  const bookingId = await seedBooking(eventId, ticketTypeId, { status: "EXPIRED", buyerId });
+
+  // Somebody else bought the freed seat in the race window.
+  await prisma.ticketType.update({
+    where: { ticketTypeId },
+    data: { soldCount: 1 },
+  });
+
+  const repo = new BookingLifecycleRepository();
+  await expect(repo.forcePaidAfterRaceTx(bookingId)).rejects.toThrow(
+    CapacityNotAvailableError,
+  );
+
+  // The tier is still at capacity — the late capture did not push it over.
+  const tier = await prisma.ticketType.findUnique({
+    where: { ticketTypeId },
+  });
+  expect(tier?.soldCount).toBe(1);
+  expect(tier?.soldCount).toBeLessThanOrEqual(tier?.quantity ?? 0);
+
+  // And the booking was NOT confirmed — it stays released so the refund
+  // path can pick it up.
+  const booking = await prisma.booking.findUnique({
+    where: { bookingId },
+  });
+  expect(booking?.status).not.toBe("PAID");
+});
+
+// ─── A4: exactly one winner between the webhook and the client's verify ────
+
+test("A4: only one of two racing finalizes settles the booking", async () => {
+  const { eventId, ticketTypeId, buyerId } = await seedTier(2);
+  const bookingId = await seedBooking(eventId, ticketTypeId, { status: "HELD", buyerId });
+
+  const repo = new BookingLifecycleRepository();
+  // The webhook and the client's verify call land together.
+  const results = await Promise.all([
+    repo.markPaidTx(bookingId),
+    repo.markPaidTx(bookingId),
+  ]);
+
+  expect(results.filter(Boolean).length).toBe(1);
+
+  const booking = await prisma.booking.findUnique({
+    where: { bookingId },
+  });
+  expect(booking?.status).toBe("PAID");
+});
+
+test("A4: a second settle attempt on an already-paid booking changes nothing", async () => {
+  const { eventId, ticketTypeId, buyerId } = await seedTier(2);
+  const bookingId = await seedBooking(eventId, ticketTypeId, { status: "HELD", buyerId });
+
+  const repo = new BookingLifecycleRepository();
+  expect(await repo.markPaidTx(bookingId)).toBe(true);
+  expect(await repo.markPaidTx(bookingId)).toBe(false);
+
+  const booking = await prisma.booking.findUnique({
+    where: { bookingId },
+  });
+  expect(booking?.status).toBe("PAID");
+});
+
+// ─── A2: the hold expiry sweep gives the capacity back ─────────────────────
+
+test("A2: releasing an expired hold returns its capacity exactly once", async () => {
+  const { eventId, ticketTypeId, buyerId } = await seedTier(2);
+  const bookingId = await seedBooking(eventId, ticketTypeId, { status: "HELD", buyerId });
+
+  // The hold is holding one seat.
+  await prisma.ticketType.update({
+    where: { ticketTypeId },
+    data: { soldCount: 1 },
+  });
+
+  const repo = new BookingLifecycleRepository();
+  // Two workers run the expiry sweep at the same moment.
+  const results = await Promise.all([
+    repo.releaseHoldTx(bookingId, "EXPIRED"),
+    repo.releaseHoldTx(bookingId, "EXPIRED"),
+  ]);
+
+  // Only one worker wins the atomic status transition.
+  expect(results.filter(Boolean).length).toBe(1);
+
+  const tier = await prisma.ticketType.findUnique({
+    where: { ticketTypeId },
+  });
+  expect(tier?.soldCount).toBe(0);
+});
